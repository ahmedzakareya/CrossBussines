# CrossBuy AI Service — environment template.
# Copy to ".env" and fill real values. NEVER commit the real .env.

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=

# --- Shared secret between the .NET backend and this service ---
# The .NET AiService must send this exact value in the "X-AI-Secret" header.
AI_SHARED_SECRET=change-me-to-a-long-random-string

# --- .NET backend (source of truth; tools call back into it) ---
DOTNET_BASE_URL=http://localhost:5000

# --- Model routing (see docs: smart for Copilot/extraction, fast for classify/summary) ---
# Use current Claude model ids (verify via the claude-api reference before relying on these).
DEFAULT_MODEL=claude-opus-4-8
FAST_MODEL=claude-haiku-4-5-20251001

# --- Service ---
AI_SERVICE_PORT=8000
