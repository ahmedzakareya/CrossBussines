<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Stage 1 Batch B: the TestRun configuration is DECLARED, and defines DEBUG.

       TestRun exists for one reason — Visual Studio and IIS Express hold a lock on bin\Debug, so a build for a test
       run needs its own output folder. It was previously used as a bare `-c TestRun` with no declaration anywhere,
       which meant MSBuild treated it as a non-Debug configuration and did NOT define DEBUG.

       That silently compiled a DIFFERENT program than the one developers run. It broke the build the moment a
       `#if DEBUG` member was referenced from unconditional code: StockService._testBypassLandedLockRead is declared
       inside `#if DEBUG`, DevSeedController references it without one, so the TestRun build failed while Debug
       succeeded. Before that reference existed, the difference was invisible — which is worse, because every
       previous "-c TestRun" acceptance ran against code paths that Debug does not have.

       Declaring it makes TestRun mean "Debug, in a different folder", which is what every use of it assumed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'TestRun'">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid.EntityFrameworkAdapter" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.23" />
  </ItemGroup>

  <!-- ===========================================================================================================
       Stage 2A Batch 00-A — the authorization guardrail runs in the build.

       OutputItemType="Analyzer" is what makes the compiler LOAD it; ReferenceOutputAssembly="false" keeps
       CrossBuy.dll from taking a compile-time reference on it. Omitting either is the classic mistake: without the
       first the analyzer is a silent no-op, without the second it becomes a runtime dependency of the application.

       No PackageReference changes: the analyzer's two Roslyn packages are PrivateAssets="all", so nothing flows here.
       =========================================================================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\CrossBuy.Analyzers\CrossBuy.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- The frozen debt baseline is a DECLARED INPUT. An analyzer may not open files — the compiler sandboxes it so a
       build stays reproducible from its declared inputs — so the baseline is passed in as an AdditionalFile. Without
       this line CBA001 and CBA004 degrade to silent by design, and the guardrail would measure without enforcing. -->
  <ItemGroup>
    <AdditionalFiles Include="..\engineering\authorization-baseline.json" />
  </ItemGroup>

  <!-- DOCUMENTED ADJUSTMENT, forced by entry-gate PROOF C.
       CBA004 (stale baseline entry) can have NO source location — a baseline entry naming a controller that no longer
       exists points at nothing. `.editorconfig` sections are matched by PATH, so they cannot apply a severity to a
       location-less diagnostic: the configured `error` was ignored, CBA004 stayed a Warning, and the build PASSED with
       a stale allowance. A global analyzer config applies compilation-wide, location or not. -->
  <!-- No explicit GlobalAnalyzerConfigFiles item: the SDK already discovers the repository-root .globalconfig by
       walking up from the project directory, exactly as it does for .editorconfig. Adding one produced a DUPLICATE
       entry (the same file by two paths), and Roslyn treats two global configs that set the same key as a conflict and
       drops the option — so the explicit item silently disabled the very severities it was added to apply. -->


  <!-- DOCUMENTED ADJUSTMENT to the reviewed plan, and the reason for it.
       A missing AdditionalFiles glob does not fail an MSBuild build — it silently matches nothing. Combined with the
       analyzer's deliberate "no baseline -> CBA001/CBA004 stay silent" degradation, a checkout without
       engineering/authorization-baseline.json would build GREEN while enforcing nothing. That is the one failure mode
       of this integration that looks identical to success, so it is made loud here instead. -->
  <Target Name="CrossBuyVerifyAuthorizationBaseline" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\engineering\authorization-baseline.json')" Code="CBA000" Text="engineering/authorization-baseline.json is missing, so the authorization analyzer would build green while enforcing nothing (CBA001 and CBA004 degrade to silent without a baseline). Restore the file, or remove the AdditionalFiles entry deliberately." />
  </Target>

  <ItemGroup>
    <Compile Update="Resources\SharedResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SharedResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\SharedResources.ar.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.en.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>SharedResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
    <Folder Include="wwwroot\Files\" />
  </ItemGroup>

  <!--
    REPORT TYPEFACES TRAVEL INSIDE THE DOCUMENT, so they travel inside the assembly first.

    A report used to name a font and depend on the viewing machine having it; embedding the file lets
    ReportFontLibrary write it into the document as a data: URI, which is what already makes a PDF look
    the same everywhere. A manifest resource is used rather than a wwwroot path because a renderer has
    no content root — a path that resolves in development and not under IIS fails only after deployment.

    Cairo is SIL OFL 1.1; OFL.txt ships beside the file as that licence requires.
  -->
  <ItemGroup>
    <EmbeddedResource Include="BL\Reporting\Fonts\*.ttf" />
  </ItemGroup>

</Project>
