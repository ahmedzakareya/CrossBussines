@using CrossBuy.BL.Workspace
@using System.Globalization
@model WorkspacePanel<WorkspaceNotification>
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    // Inventory shell = THE visual authority. Its module menu is NOT this screen's navigation:
    // _MainMenu prepends the Platform category, so an empty list yields a Platform-only sidebar.
    ViewBag.SidebarMenu = new List<CrossBuy.Models.Menu.MenuCategory>();
    var arabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = arabic ? "الإشعارات" : "Notifications";

    var unreadOnly = (bool?)ViewBag.UnreadOnly ?? false;
    var unread = Model.Items.Count(n => !n.IsRead);
    ViewBag.UnreadNotifications = unread;

    string ToneColor(WorkspaceTone t) => t switch
    {
        WorkspaceTone.Ok => "success",
        WorkspaceTone.Warn => "warning",
        WorkspaceTone.Critical => "danger",
        _ => "primary",
    };

    string Ago(DateTime? at)
    {
        if (at is null) return "";
        var span = CrossBuy.BL.Platform.ConformanceClock.Now - at.Value;
        if (span.TotalMinutes < 1) return arabic ? "الآن" : "now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d";
        return at.Value.ToString("yyyy-MM-dd");
    }
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
    <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">
                @(arabic ? "الإشعارات" : "Notifications")
            </h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-gray-700">
                    <a href="@Url.Action("Index","Workspace")" class="text-gray-700 text-hover-primary">@(arabic ? "مساحة العمل" : "Workspace")</a>
                </li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-gray-700">
                    @(arabic ? "كل ما وصلك، الأحدث أولًا." : "Everything addressed to you, newest first.")
                </li>
            </ul>
        </div>
        @* Filter as links, not JavaScript: the state is in the URL, so it is bookmarkable,
           back-button-correct and works before any script loads. *@
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Notifications", "Workspace", new { unreadOnly = false })"
               class="btn btn-sm btn-flex fw-semibold @(unreadOnly ? "btn-light" : "btn-primary")">
                <i class="ki-outline ki-abstract-14 fs-6"></i>@(arabic ? "الكل" : "All")
            </a>
            <a href="@Url.Action("Notifications", "Workspace", new { unreadOnly = true })"
               class="btn btn-sm btn-flex fw-semibold @(unreadOnly ? "btn-primary" : "btn-light")">
                <i class="ki-outline ki-notification-bing fs-6"></i>@(arabic ? "غير المقروء" : "Unread")
                @if (unread > 0)
                {
                    <span class="badge badge-light-danger fs-8 ms-1 text-gray-800">@unread</span>
                }
            </a>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-900">
                        <i class="ki-outline ki-notification-bing fs-3 text-primary me-2"></i>@(arabic ? "الإشعارات" : "Notifications")
                    </span>
                </h3>
            </div>
            <div class="card-body pt-2">
                @if (Model.HasItems)
                {
                    <div class="table-responsive">
                        <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                            <thead>
                                <tr class="fw-bold fs-7 text-uppercase text-gray-700">
                                    <th>@(arabic ? "الإشعار" : "Notification")</th>
                                    <th class="w-150px">@(arabic ? "التصنيف" : "Category")</th>
                                    <th class="text-end w-125px">@(arabic ? "متى" : "When")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var n in Model.Items)
                                {
                                    <tr data-cbw-notification="@n.Id" class="@(n.IsRead ? "" : "fw-bold")">
                                        <td class="min-w-250px">
                                            <div class="d-flex align-items-center">
                                                <div class="symbol symbol-35px me-3">
                                                    <span class="symbol-label bg-light-@ToneColor(n.Tone)">
                                                        <i class="ki-outline ki-notification-status fs-5 text-@ToneColor(n.Tone)"></i>
                                                    </span>
                                                </div>
                                                <div class="d-flex flex-column">
                                                    @if (!string.IsNullOrWhiteSpace(n.Url))
                                                    {
                                                        <a class="fw-bold text-gray-900 text-hover-primary" href="@n.Url">@n.Title</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-bold text-gray-900">@n.Title</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(n.Body))
                                                    {
                                                        <span class="text-gray-700 fs-7 fw-normal">@n.Body</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(n.Category))
                                            {
                                                <span class="badge badge-light fs-8">@n.Category</span>
                                            }
                                        </td>
                                        <td class="text-end text-gray-700 fw-semibold">
                                            @if (!n.IsRead)
                                            {
                                                @* Unread is shown as STATE, not as an action. The mark-as-read
                                                   write was withdrawn - see WorkspaceController for why (CBA001). *@
                                                <span class="badge badge-light-primary fs-8 me-1">@(arabic ? "جديد" : "new")</span>
                                            }
                                            @Ago(n.At)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (Model.State is WorkspacePanelState.Ready or WorkspacePanelState.Empty)
                {
                    <div class="d-flex flex-column align-items-center text-center py-15">
                        <i class="ki-outline ki-notification-bing fs-3x text-gray-400 mb-3"></i>
                        <span class="text-gray-700 fw-semibold fs-6">
                            @(unreadOnly
                                ? (arabic ? "لا يوجد غير مقروء" : "Nothing unread")
                                : (arabic ? "لا توجد إشعارات" : "No notifications"))
                        </span>
                    </div>
                }
                else
                {
                    var colour = Model.State switch
                    {
                        WorkspacePanelState.Unavailable => "secondary",
                        WorkspacePanelState.AccessDenied => "dark",
                        WorkspacePanelState.TemporaryFailure => "warning",
                        _ => "info",
                    };
                    var icon = Model.State switch
                    {
                        WorkspacePanelState.AccessDenied => "ki-lock-2",
                        WorkspacePanelState.TemporaryFailure => "ki-abstract-26",
                        _ => "ki-information-5",
                    };
                    var title = Model.State switch
                    {
                        WorkspacePanelState.Unavailable => arabic ? "غير متاح في هذه البيئة" : "Not available in this environment",
                        WorkspacePanelState.AccessDenied => arabic ? "لا تملك صلاحية عرض هذا" : "You don't have access to this",
                        WorkspacePanelState.TemporaryFailure => arabic ? "تعذّر التحميل مؤقتًا" : "Could not load right now",
                        _ => arabic ? "بيانات جزئية" : "Partial data",
                    };
                    <div class="alert alert-@colour d-flex align-items-center p-5 mb-0 text-gray-800">
                        <i class="ki-outline @icon fs-2hx me-4"></i>
                        <div class="d-flex flex-column">
                            <h5 class="mb-1">@title</h5>
                            <span>@Model.Reason</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!--end::Content-->
