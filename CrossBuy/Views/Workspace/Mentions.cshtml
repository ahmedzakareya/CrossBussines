@using CrossBuy.BL.Workspace
@using System.Globalization
@model WorkspacePanel<WorkspaceMention>
@functions {
    // Up to two initials from the display name, so a row with no photo still gets a stable,
    // person-shaped mark. Works the same for Arabic and Latin names.
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) { return "؟"; }
        var parts = name.Trim().Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) { return parts[0].Substring(0, 1); }
        return parts[0].Substring(0, 1) + parts[1].Substring(0, 1);
    }

    // THE "@" MUST NOT REACH THE READER. It is authoring syntax, and the owner's rule is that it
    // never shows on this screen.
    //
    // It does NOT arrive as raw markup. CommBodyPolicy.Excerpt has already flattened
    // `@[Ahmed Zakareya](employee:5)` down to `@Ahmed Zakareya` before the row gets here
    // (CommBodyPolicy.cs, LabelledMention.Replace), so by this point the brackets and the
    // employee id are gone and only the sign is left. That is why this strips a sign rather than
    // parsing a token.
    //
    // The fix is NOT made in Excerpt itself: that same string also feeds notification templates
    // and the comment timeline, where the sign is not this screen's to remove.
    //
    // WHAT IS LOST, HONESTLY: with the id already stripped upstream, the view cannot tell where the
    // name ends, so the mention cannot be drawn as a chip here - only as plain text. Carrying the
    // stored label (CommMentions.LabelAr/LabelEn) through WorkspaceMention would restore it.
    private static readonly System.Text.RegularExpressions.Regex AtSign =
        new System.Text.RegularExpressions.Regex(@"@(?=[^\s@])",
            System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string MentionText(string? raw)
        => string.IsNullOrEmpty(raw) ? "" : AtSign.Replace(raw, "");
}
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    // Inventory shell = THE visual authority. Its module menu is NOT this screen's navigation:
    // _MainMenu prepends the Platform category, so an empty list yields a Platform-only sidebar.
    ViewBag.SidebarMenu = new List<CrossBuy.Models.Menu.MenuCategory>();
    var arabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = arabic ? "الإشارات إليّ" : "Mentions";

    string Ago(DateTime? at)
    {
        if (at is null) return "";
        var span = CrossBuy.BL.Platform.ConformanceClock.Now - at.Value;
        if (span.TotalMinutes < 1) return arabic ? "الآن" : "now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d";
        return at.Value.ToString("yyyy-MM-dd");
    }

    // How the caller was reached. A team or department mention is a materially different thing from being
    // named personally - it tells the reader why this landed in front of them.
    string ViaLabel(string? via) => via switch
    {
        "Team" => arabic ? "عبر الفريق" : "via team",
        "Department" => arabic ? "عبر الإدارة" : "via department",
        "Role" => arabic ? "عبر الدور" : "via role",
        _ => arabic ? "مباشرة" : "direct",
    };
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
    <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">
                @(arabic ? "الإشارات إليّ" : "Mentions")
            </h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-gray-700">
                    <a href="@Url.Action("Index","Workspace")" class="text-gray-700 text-hover-primary">@(arabic ? "مساحة العمل" : "Workspace")</a>
                </li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-gray-700">
                    @(arabic ? "أين ذُكرت — مباشرة أو عبر فريقك أو إدارتك." : "Where you were mentioned — directly, or through your team or department.")
                </li>
            </ul>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-900">
                        <i class="ki-outline ki-messages fs-3 text-primary me-2"></i>@(arabic ? "الإشارات" : "Mentions")
                    </span>
                </h3>
            </div>
            <div class="card-body pt-2">
                @if (Model.HasItems)
                {
                    <div class="table-responsive">
                        <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                            <thead>
                                <tr class="fw-bold fs-7 text-uppercase text-gray-700 cb-thead-rule">
                                    <th>@(arabic ? "الإشارة" : "Mention")</th>
                                    <th class="w-150px">@(arabic ? "الكيان" : "Entity")</th>
                                    <th class="w-125px">@(arabic ? "الطريقة" : "Via")</th>
                                    <th class="text-end w-100px">@(arabic ? "متى" : "When")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.Items)
                                {
                                    var unread = !m.IsRead;
                                    var who = string.IsNullOrWhiteSpace(m.MentionedBy)
                                        ? "#" + m.MentionedByEmployeeId
                                        : m.MentionedBy!;
                                    var photo = string.IsNullOrWhiteSpace(m.MentionedByAvatarUrl)
                                        ? null
                                        : Url.Content("~" + m.MentionedByAvatarUrl!.Replace("\\", "/"));
                                    <tr>
                                        <td class="min-w-250px">
                                            @* UNREAD IS MARKED THREE WAYS - a rule on the leading edge, a
                                               heavier body, and a dot by the time. One mark is not enough:
                                               colour alone fails anyone who cannot separate two blues, and
                                               weight alone disappears in a column scan. *@
                                            <div class="d-flex align-items-center @(unread ? "cb-unread-row" : "")">
                                                <div class="symbol symbol-40px me-3 flex-shrink-0">
                                                    @if (photo != null)
                                                    {
                                                        <img src="@photo" alt="@who" class="rounded-circle" />
                                                    }
                                                    else
                                                    {
                                                        @* NO PHOTO IS THE NORMAL CASE. Initials on the brand tint,
                                                           never a broken-image frame. *@
                                                        <span class="symbol-label bg-light-primary text-primary fw-bold">@Initials(who)</span>
                                                    }
                                                </div>
                                                <div class="d-flex flex-column min-w-0">
                                                    <span class="fw-bold text-gray-900 fs-6">@who</span>
                                                    <a class="text-gray-700 text-hover-primary @(unread ? "fw-semibold" : "")"
                                                       href="@(m.Url ?? "#")">@(m.Excerpt == null ? m.EntityLabel : MentionText(m.Excerpt))</a>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-light-primary fs-8">@m.EntityLabel</span></td>
                                        <td>
                                            @* SILENT WHEN THERE IS NOTHING TO SAY. This printed "direct" on
                                               every row; a column that repeats one value is not a column. It
                                               speaks only for a mention that arrived through a team or a
                                               department, which is the case worth flagging. *@
                                            @if (!string.Equals(m.ViaKind, "Employee", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge badge-light-info fs-8">@ViaLabel(m.ViaKind)</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <span class="text-gray-700 fw-semibold" dir="ltr"
                                                  style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">@Ago(m.At)</span>
                                            @if (unread)
                                            {
                                                <span class="cb-unread-dot ms-2" title="@(arabic ? "غير مقروءة" : "Unread")"></span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (Model.State is WorkspacePanelState.Ready or WorkspacePanelState.Empty)
                {
                    <div class="d-flex flex-column align-items-center text-center py-15">
                        <i class="ki-outline ki-messages fs-3x text-gray-400 mb-3"></i>
                        <span class="text-gray-700 fw-semibold fs-6">
                            @(arabic ? "لم يشر إليك أحد بعد" : "No one has mentioned you yet")
                        </span>
                    </div>
                }
                else
                {
                    @* When the Communication Platform is not registered this renders the UNAVAILABLE state with
                       its reason - not an empty list. The distinction matters here more than anywhere else in
                       the product: "nobody mentioned you" and "mentions are not switched on" would otherwise
                       look identical. *@
                    var colour = Model.State switch
                    {
                        WorkspacePanelState.Unavailable => "secondary",
                        WorkspacePanelState.AccessDenied => "dark",
                        WorkspacePanelState.TemporaryFailure => "warning",
                        _ => "info",
                    };
                    var icon = Model.State switch
                    {
                        WorkspacePanelState.AccessDenied => "ki-lock-2",
                        WorkspacePanelState.TemporaryFailure => "ki-abstract-26",
                        _ => "ki-information-5",
                    };
                    var title = Model.State switch
                    {
                        WorkspacePanelState.Unavailable => arabic ? "غير متاح في هذه البيئة" : "Not available in this environment",
                        WorkspacePanelState.AccessDenied => arabic ? "لا تملك صلاحية عرض هذا" : "You don't have access to this",
                        WorkspacePanelState.TemporaryFailure => arabic ? "تعذّر التحميل مؤقتًا" : "Could not load right now",
                        _ => arabic ? "بيانات جزئية" : "Partial data",
                    };
                    <div class="alert alert-@colour d-flex align-items-center p-5 mb-0 text-gray-800">
                        <i class="ki-outline @icon fs-2hx me-4"></i>
                        <div class="d-flex flex-column">
                            <h5 class="mb-1">@title</h5>
                            <span>@Model.Reason</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!--end::Content-->
