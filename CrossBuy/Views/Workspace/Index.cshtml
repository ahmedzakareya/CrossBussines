@using CrossBuy.BL.Workspace
@using CrossBuy.BL.Approvals
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Html
@inject IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<CrossBuy.SharedResources> Shared
@model WorkspaceDashboard
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    // Inventory shell = THE visual authority. Its module menu is NOT this screen's navigation:
    // _MainMenu prepends the Platform category, so an empty list yields a Platform-only sidebar.
    ViewBag.SidebarMenu = new List<CrossBuy.Models.Menu.MenuCategory>();
    var arabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = Localizer["Workspace"];

    ViewBag.UnreadNotifications = Model.UnreadNotifications;
    ViewBag.UnreadMentions = Model.UnreadMentions;
    ViewBag.OpenWork = Model.MyWork.Items.Count;
    ViewBag.CompanyName = Model.CompanyName;
    ViewBag.Capabilities = Model.Capabilities;

    // ---------------------------------------------------------------------------------------------
    // This screen is built from Metronic components only - the same vocabulary Accounting/Index uses:
    // app-toolbar, card card-flush, card-header/card-title/card-toolbar, row g-5, symbol, badge,
    // btn btn-sm btn-light, table table-row-dashed, ki-outline icons, alert alert-*.
    //
    // The previous cbw-* design and its stylesheet are NOT used here. The data, the panels and the
    // five panel states are unchanged - only the markup that presents them.
    // ---------------------------------------------------------------------------------------------

    // The silo's own display name, from SharedResources - the same strings the Approvals screen uses, so
    // "Leave" reads identically on both surfaces. The row carries the silo KEY; only the label is
    // presentation, which is why the read platform does not carry one.
    string SiloLabel(string silo) => silo switch
    {
        ApprovalSilos.Leave => Shared["Leave"].Value,
        ApprovalSilos.Request => Shared["Employee request"].Value,
        ApprovalSilos.Inventory => Shared["Inventory"].Value,
        _ => silo,
    };

    // The module's own type discriminator, localized where SharedResources knows the term and passed
    // through untouched where it does not. No term is invented here.
    string ApprovalTypeLabel(WorkspaceApprovalItem item) => item.ApprovalType switch
    {
        "PurchaseOrder" => Shared["Purchase order"].Value,
        "StockTransfer" => Shared["Transfer"].Value,
        "StockCount" => Shared["Stock count"].Value,
        "WriteOff" => Shared["Write-off"].Value,
        "Permission" => Shared["Permission"].Value,
        "Letter" => Shared["Letter"].Value,
        _ => item.Title,
    };

    string MetricColor(WorkspaceTone tone) => tone switch
    {
        WorkspaceTone.Ok => "success",
        WorkspaceTone.Warn => "warning-strong",   @* not the pale yellow - see crossbuy-brand.css *@
        WorkspaceTone.Critical => "danger",
        _ => "primary",
    };

    @* A PRIORITY IS A RAMP, not one grey. Urgent, High and Low all rendered as plain
       `badge-light`, so three levels came out in one identical colour. Same rule as the rest of
       the app: danger = attention, warning = approaching, secondary = normal. *@
    @* THE FIVE REAL STATES. The service collapses tone - overdue becomes Critical and everything
       else becomes Warn - so "waiting on your approval", "due today" and "flagged urgent" arrived
       here already indistinguishable. WorkspaceAttentionItem carries the Reason enum itself, so
       the row reads that instead of the flattened tone. *@
    @* SEVERITY, NOT CATEGORY. Colouring by reason alone painted the whole column one red, because
       every row on this screen genuinely IS overdue - the reason was constant, so the colour was
       too, and a stripe that never varies tells the reader nothing.

       What DOES vary among eight overdue rows is the priority the business put on them. So the bar
       answers "how bad is this one", combining both facts:

         danger          missed AND flagged urgent/high - deal with these first
         warning-strong  missed at normal priority, or flagged urgent but not yet late
         info            somebody else is blocked waiting on this person
         secondary       a mention: normal until it is read

       An overdue row is never grey, whatever its priority - being late is the fact that put it on
       this card, and demoting it to neutral would hide the thing the card exists to show. *@
    string SeverityColor(WorkspaceAttentionReason r, string? priority) => r switch
    {
        WorkspaceAttentionReason.OverdueTask =>
            priority == "Urgent" || priority == "High" ? "danger" : "warning-strong",
        WorkspaceAttentionReason.UrgentTask => "warning-strong",
        WorkspaceAttentionReason.DueToday => "warning-strong",
        WorkspaceAttentionReason.ApprovalWaiting => "info",
        _ => "secondary",
    };

    string PriorityColor(string? p) => p switch
    {
        "Urgent" => "danger",
        "High" => "warning-strong",
        _ => "secondary",
    };

    @* THE "@" NEVER REACHES THE READER. CommBodyPolicy.Excerpt has already flattened
       `@[Ahmed Zakareya](employee:5)` to `@Ahmed Zakareya` upstream, so what is left here is the
       bare sign - authoring syntax with nothing behind it. Stripped at render, NOT in Excerpt
       itself, because that string also feeds notification templates and the comment timeline. *@
    string NoAt(string? s) => string.IsNullOrEmpty(s)
        ? ""
        : System.Text.RegularExpressions.Regex.Replace(s, @"@(?=[^\s@])", "");
    string MetricIcon(WorkspaceTone tone) => tone switch
    {
        WorkspaceTone.Ok => "ki-check-circle",
        WorkspaceTone.Warn => "ki-information-5",
        WorkspaceTone.Critical => "ki-shield-cross",
        _ => "ki-abstract-26",
    };

    string Ago(DateTime? at)
    {
        if (at is null) return "";
        var span = CrossBuy.BL.Platform.ConformanceClock.Now - at.Value;
        if (span.TotalMinutes < 1) return Localizer["Now"].Value;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d";
        return at.Value.ToString("MMM d", CultureInfo.CurrentCulture);
    }

    var favouriteReports = Model.Reports.Items
        .Where(report => report.Kind == WorkspaceReportKind.Favorite)
        .ToList();
    var recentReports = Model.Reports.Items
        .Where(report => report.Kind == WorkspaceReportKind.Recent)
        .ToList();

    // Metric tile width is derived from the COUNT so the row always fills. A fixed col-xl-2 assumes
    // six tiles (6x2=12); the dashboard emits as few as four, which left a third of the row blank.
    var metricCol = Model.Metrics.Count switch
    {
        1 => "col-xl-12", 2 => "col-xl-6", 3 => "col-xl-4",
        4 => "col-xl-3", 5 => "col-xl-4", _ => "col-xl-2",
    };
}

@*
    The five non-data states stay visually DISTINCT, as they were - collapsing "unavailable" into
    "empty" is how a broken deployment looks like a quiet week. Here each maps onto a Metronic alert
    variant instead of a bespoke cbw-state stripe.
*@
@functions {
    private (string Colour, string Icon, string Title) StateChrome(WorkspacePanelState state, bool ar) => state switch
    {
        WorkspacePanelState.Unavailable      => ("secondary", "ki-information-5", ar ? "غير متاح في هذه البيئة" : "Not available in this environment"),
        WorkspacePanelState.AccessDenied     => ("dark",      "ki-lock-2",        ar ? "لا تملك صلاحية عرض هذا" : "You don't have access to this"),
        WorkspacePanelState.TemporaryFailure => ("warning",   "ki-abstract-26",   ar ? "تعذّر التحميل مؤقتًا"   : "Could not load right now"),
        WorkspacePanelState.PartiallyAvailable => ("info",    "ki-information-5", ar ? "بيانات جزئية"          : "Partial data"),
        _                                    => ("light",     "ki-check-circle",  ""),
    };
}

@{
    Func<WorkspacePanelState, string, string, IHtmlContent> PanelNotice = (state, emptyText, emptyIcon) =>
    {
        var (colour, icon, title) = StateChrome(state, arabic);
        var sb = new System.Text.StringBuilder();
        if (state == WorkspacePanelState.Empty || state == WorkspacePanelState.Ready)
        {
            sb.Append($@"<div class=""d-flex flex-column align-items-center text-center py-10"">
                            <i class=""{System.Net.WebUtility.HtmlEncode(emptyIcon)} fs-3x text-gray-400 mb-3""></i>
                            <span class=""text-gray-700 fw-semibold fs-6"">{System.Net.WebUtility.HtmlEncode(emptyText)}</span>
                         </div>");
        }
        else
        {
            sb.Append($@"<div class=""alert alert-{colour} d-flex align-items-center p-4 mb-0 text-gray-800"">
                            <i class=""ki-outline {icon} fs-2hx me-3""></i>
                            <div class=""d-flex flex-column"">
                                <span class=""fw-bold"">{System.Net.WebUtility.HtmlEncode(title)}</span>
                            </div>
                         </div>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    };
}

@if (Model.IsUnresolved)
{
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            <div class="card card-flush">
                <div class="card-body">
                    <div class="alert alert-dark d-flex align-items-center p-5 text-gray-800">
                        <i class="ki-outline ki-lock-2 fs-2hx text-dark me-4"></i>
                        <div class="d-flex flex-column">
                            <h4 class="mb-1 text-dark">@Localizer["Session not resolved"]</h4>
                            <span>@Localizer["No company is resolved for this session, so the workspace cannot be shown."]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    return;
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
    <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Workspace"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-gray-700">@Localizer["Home"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-gray-700">@Localizer["Workspace Home"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3">
            @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
            {
                <span class="badge badge-light-primary fs-7 py-2 px-3">
                    <i class="ki-outline ki-briefcase fs-6 me-1"></i>@Model.CompanyName
                </span>
            }
            @if (Model.Capabilities.Reporting)
            {
                <a href="@Url.Action("Index","Reports")" class="btn btn-sm btn-flex btn-light fw-bold">@Localizer["Reports center"]</a>
            }
            @if (Model.Capabilities.Agenda)
            {
                <a href="@Url.Action("Agenda","Workspace")" class="btn btn-sm btn-flex btn-primary fw-bold">
                    <i class="ki-outline ki-calendar fs-6"></i>@Localizer["Unified Agenda"]
                </a>
            }
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-fluid">

        @if (Model.UnavailablePanels.Count > 0)
        {
            <div class="alert alert-secondary d-flex align-items-center p-5 mb-5 text-gray-800">
                <i class="ki-outline ki-information-5 fs-2hx text-gray-700 me-4"></i>
                <div class="d-flex flex-column">
                    <h5 class="mb-1">@Localizer["Panels unavailable"]</h5>
                    <span class="text-gray-700">@string.Join(" · ", Model.UnavailablePanels.Select(p => Localizer[p].Value))</span>
                </div>
            </div>
        }

        @* ================================================================================================
           WHAT REQUIRES MY ATTENTION?

           The first card on the screen, above the metric tiles, because it is the one answer a person
           opens this page for. Every row is already on the dashboard further down - this card only says
           which of them comes first.

           Metronic vocabulary only, and the SAME card/table/badge components the panels below already
           use. No new design language, no new stylesheet, no bespoke class.
           ================================================================================================ *@
        <div class="row g-5 g-xl-10 mb-5 mb-xl-10">
        <div class="col-xl-8">
        <!--begin::Attention-->
        <div class="card card-flush h-lg-100" id="attention" aria-busy="false">
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-900">@Localizer["What requires my attention?"]
                    </span>
                    @if (Model.Attention.HasItems)
                    {
                        <span class="text-gray-700 fw-semibold fs-7 mt-1">
                            @Localizer["Ranked by urgency across your work, approvals and mentions."]
                        </span>
                    }
                </h3>
                @if (Model.Attention.Total is > 0 && Model.Attention.Total > Model.Attention.Items.Count)
                {
                    <div class="card-toolbar">
                        <span class="badge badge-light-danger fs-8 fw-bold text-gray-800">
                            @Localizer["Showing {0} of {1}", Model.Attention.Items.Count, Model.Attention.Total!]
                        </span>
                    </div>
                }
            </div>
            <div class="card-body pt-2">
                @if (Model.Attention.HasItems)
                {
                    <div class="table-responsive">
                        <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                            <thead>
                                <tr class="fw-bold fs-7 text-uppercase text-gray-700" style="border-bottom:2px solid #0E4A9E;">
                                    <th class="w-150px">@Localizer["Reason"]</th>
                                    <th>@Localizer["Item"]</th>

                                    <th class="text-end w-125px">@Localizer["When"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Attention.Items)
                                {
                                    var tone = SeverityColor(item.Reason, item.Priority);
                                    <tr>
                                        <td>
                                            <span class="badge badge-light-@tone fs-8 fw-bold text-gray-800">@item.ReasonLabel(arabic)</span>
                                        </td>
                                        <td class="min-w-200px">
                                            @* ACCOUNTING'S ROW SHAPE: a 4px bar on the leading edge carrying
                                               the row's tone, the title bold, and the source as a grey
                                               sub-line - so the row reads as one object instead of four
                                               separate cells. `ps-5` and `start-0` are logical, so the bar
                                               moves to the right-hand edge under RTL on its own. *@
                                            <div class="position-relative ps-5">
                                                <div class="position-absolute start-0 top-0 w-4px h-100 rounded-2 bg-@tone"></div>
                                                @* The destination comes from the panel the row was composed
                                                   from, which got it from the owning module. *@
                                                <a class="d-block fw-bold text-gray-900 text-hover-primary"
                                                   href="@(item.Url ?? Url.Action("Index", "Workspace"))">@item.Title</a>
                                                <span class="fs-7 text-muted fw-semibold d-block">
                                                    @item.Source(arabic)
                                                    @if (!string.IsNullOrWhiteSpace(item.Priority) && item.Priority != "Normal")
                                                    {
                                                        <span class="badge badge-light-@PriorityColor(item.Priority) fs-8 ms-2 fw-bold text-gray-800">@item.Priority</span>
                                                    }
                                                </span>
                                            </div>
                                        </td>

                                        <td class="text-end text-gray-700 fw-semibold">
                                            @if (item.AgeDays is > 0)
                                            {
                                                <span class="text-@tone">@Localizer["{0}d", item.AgeDays!]</span>
                                            }
                                            else if (item.Due.HasValue)
                                            {
                                                @item.Due.Value.ToString("yyyy-MM-dd")
                                            }
                                            else
                                            {
                                                <span class="text-gray-700">&mdash;</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    @* Empty says "nothing needs you"; the other three states say why we cannot tell. The
                       shared helper keeps them visually distinct, as everywhere else on this screen. *@
                    @PanelNotice(Model.Attention.State,
                        Localizer["Nothing needs your attention right now."].Value, "ki-outline ki-check-circle")
                }
            </div>
        </div>
        <!--end::Attention-->
        </div>

        @* THE SAME FIGURES, A DIFFERENT VESSEL. This was a solid blue card that restated the four
           numbers the KPI tiles print directly underneath it. Accounting carries figures like these
           in plain label/value rows with dashed separators and one emphasised line (its VAT and
           Fixed Assets cards) - which holds the same content without competing with the tiles and
           without needing a sparkline to stop it reading as hollow. *@
        <div class="col-xl-4">
            <div class="card card-flush h-lg-100">
                <div class="card-header pt-7">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-900">@Localizer["My workload"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@Model.CompanyName</span>
                    </h3>
                    <div class="card-toolbar">
                        <a href="@Url.Action("Agenda","Workspace")" class="btn btn-sm btn-light">@Localizer["View all"]</a>
                    </div>
                </div>
                <div class="card-body pt-2 d-flex flex-column">
                    @foreach (var m in Model.Metrics)
                    {
                        <div class="d-flex flex-stack py-2">
                            <span class="text-gray-600 fw-semibold">@m.Label(arabic)</span>
                            @* Isolated and tabular: a figure on an Arabic line reorders around its
                               neighbours without it, and the column twitches as digits change. *@
                            <span class="fw-bold text-@(MetricColor(m.Tone) == "secondary" ? "gray-900" : MetricColor(m.Tone))"
                                  dir="ltr" style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">@m.Value</span>
                        </div>
                        <div class="separator separator-dashed my-1"></div>
                    }
                    <div class="d-flex flex-stack py-2">
                        <span class="text-gray-800 fw-bold">@Shared["Approvals"]</span>
                        <span class="fw-bold fs-4 text-@(Model.PendingApprovals > 0 ? "danger" : "gray-900")"
                              dir="ltr" style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">@Model.PendingApprovals</span>
                    </div>

                    @* ACCOUNTING'S "EXPENSE DISTRIBUTION" SHAPE, answering something this page could
                       not answer before: WHERE the work demanding attention comes from. Computed from
                       the rows on screen - and the sub-line says exactly that, because this panel is
                       capped like every other one here and a percentage of a capped list would
                       otherwise read as a percentage of everything. *@
                    @if (Model.Attention.Items.Count > 0)
                    {
                        var bySource = Model.Attention.Items
                            .GroupBy(i => i.Source(arabic))
                            .Select(g => new { Name = g.Key, Count = g.Count() })
                            .OrderByDescending(g => g.Count)
                            .ToList();
                        var shown = Model.Attention.Items.Count;

                        <div class="separator separator-dashed my-4"></div>
                        <div class="fw-bold text-gray-800 fs-7 mb-1">@Localizer["By source"]</div>
                        <div class="text-gray-500 fw-semibold fs-8 mb-3">
                            @Localizer["Of the {0} rows shown", shown]
                        </div>
                        @foreach (var s in bySource)
                        {
                            var pct = (int)Math.Round(100m * s.Count / shown);
                            <div class="d-flex flex-stack mb-2">
                                <span class="text-gray-700 fw-semibold flex-grow-1 text-truncate me-3">@s.Name</span>
                                <span class="text-gray-900 fw-bold me-3" dir="ltr"
                                      style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">@s.Count</span>
                            </div>
                            <div class="d-flex align-items-center w-100 mb-4">
                                @* ONE FILL. A source is a name, not a state - rotating colours here would
                                   spend a semantic family per module and say nothing. The LENGTH carries
                                   the share. *@
                                <div class="progress h-6px w-100 me-2 bg-light-primary">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width:@(pct)%"
                                         aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="@s.Name"></div>
                                </div>
                                <span class="text-gray-500 fw-semibold fs-8" dir="ltr"
                                      style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">@pct%</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        </div>

        @if (Model.Metrics.Count > 0)
        {
            <!--begin::Metrics-->
            <div class="row g-5 g-xl-10 mb-5 mb-xl-10">
                @foreach (var metric in Model.Metrics)
                {
                    var metricColor = MetricColor(metric.Tone);
                    <div class="col-6 col-md-4 @metricCol">
                        <a href="@(metric.Url ?? Url.Action("Index", "Workspace"))" class="card h-100 text-decoration-none">
                            <div class="card-body d-flex justify-content-between align-items-start flex-column p-5">
                                <div class="d-flex flex-stack w-100 mb-4">
                                    <div class="symbol symbol-40px">
                                        <span class="symbol-label bg-light-@metricColor">
                                            <i class="ki-outline @MetricIcon(metric.Tone) fs-2x text-@metricColor"></i>
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(metric.Hint(arabic)))
                                    {
                                        <span class="badge badge-light-@metricColor fs-8 fw-bold text-gray-800">@metric.Hint(arabic)</span>
                                    }
                                </div>
                                <span class="fw-bold fs-2x text-gray-900 lh-1 ls-n2">@metric.Value</span>
                                <span class="fw-semibold fs-7 text-gray-700 mt-2">@metric.Label(arabic)</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
            <!--end::Metrics-->
        }

        @if (Model.QuickActions.Count > 0)
        {
            <div class="row g-5 g-xl-10 mb-5 mb-xl-10">
                <div class="col-12">
                    <div class="card card-flush" id="quick-actions" aria-busy="false">
                        <div class="card-header pt-7">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-900">@Localizer["Quick Actions"]</span>
                            </h3>
                        </div>
                        <div class="card-body pt-2">
                            <div class="row g-3">
                                @foreach (var action in Model.QuickActions)
                                {
                                    <div class="col-6 col-md-4 col-xl-3">
                                        <a href="@action.Url" class="d-flex flex-column flex-center bg-hover-light rounded h-100 py-5 border border-gray-200 text-decoration-none">
                                            <i class="@action.Icon fs-2x text-primary mb-2"></i>
                                            <span class="fs-8 fw-semibold text-gray-800 text-center px-1">@action.Label(arabic)</span>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-5 g-xl-10 mb-5 mb-xl-10">

            <!--begin::Primary column-->
            <main class="col-xl-8" aria-label="My workspace">

                <!--begin::My Work-->
                <div class="card card-flush mb-5 mb-xl-10" id="my-work" aria-busy="false">
                    <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["My Work"]
                            </span>
                        </h3>
                        @if (Model.Capabilities.Tasks)
                        {
                            <div class="card-toolbar">
                                <a href="@Url.Action("Index", "Tasks")" class="btn btn-sm btn-light">@Localizer["View all"]</a>
                            </div>
                        }
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.MyWork.State == WorkspacePanelState.PartiallyAvailable)
                        {
                            <div class="mb-4">@PanelNotice(WorkspacePanelState.PartiallyAvailable, "", "")</div>
                        }
                        @if (Model.MyWork.HasItems)
                        {
                            <div class="table-responsive">
                                <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                    <thead>
                                        <tr class="fw-bold fs-7 text-uppercase text-gray-700" style="border-bottom:2px solid #0E4A9E;">
                                            <th>@Localizer["Work item"]</th>
                                            <th>@Localizer["Status"]</th>
                                            <th class="text-end">@Localizer["Due"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var work in Model.MyWork.Items)
                                        {
                                            <tr>
                                                <td class="min-w-200px">
                                                    <a class="fw-bold text-gray-900 text-hover-primary" href="@(work.Url ?? Url.Action("Index", "Tasks"))">@work.Title</a>
                                                    @if (!string.IsNullOrWhiteSpace(work.Priority) && work.Priority != "Normal")
                                                    {
                                                        <span class="badge badge-light-@MetricColor(work.Tone) fs-8 ms-2 text-gray-800">@work.Priority</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(work.Status))
                                                    {
                                                        <span class="badge badge-light fs-8">@work.Status</span>
                                                    }
                                                </td>
                                                <td class="text-end text-gray-700 fw-semibold">@work.DueHint</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @PanelNotice(Model.MyWork.State, Localizer["No open work"].Value, "ki-outline ki-check-circle")
                        }
                    </div>
                </div>
                <!--end::My Work-->

                <!--begin::Approvals-->
                @*
                    READ ONLY, BY DESIGN. Every row links to the owning module's own screen to act; there
                    is no approve/reject control anywhere in this panel, and no POST. The rows come from
                    the already-company-safe path (module readers -> ApprovalInboxService ->
                    WorkspaceService -> this model), so this markup contains no security logic of its own
                    and no module route: each link uses the navigation the MODULE supplied.
                *@
                <div class="card card-flush mb-5 mb-xl-10" id="approvals" aria-busy="false">
                    <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Shared["Approvals"]
                                @if (Model.PendingApprovals > 0)
                                {
                                    <span class="badge badge-light-primary fs-8 ms-2">@Model.PendingApprovals</span>
                                }
                            </span>
                        </h3>
                        @if (Model.Approvals.IsShowable && Model.PendingApprovals > 0)
                        {
                            <div class="card-toolbar">
                                <a href="@Url.Action("Index", "Approvals")" class="btn btn-sm btn-light">@Localizer["View all"]</a>
                            </div>
                        }
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Approvals.HasItems)
                        {
                            <div class="table-responsive">
                                <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                    <thead>
                                        <tr class="fw-bold fs-7 text-uppercase text-gray-700" style="border-bottom:2px solid #0E4A9E;">
                                            <th>@Localizer["Type"]</th>
                                            <th>@Localizer["Details"]</th>
                                            <th class="text-end">@Localizer["When"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var approval in Model.Approvals.Items)
                                        {
                                            <tr>
                                                @* The silo is named in TEXT, not by colour alone. *@
                                                <td class="min-w-100px">
                                                    <span class="badge badge-light fs-8 text-gray-800">@SiloLabel(approval.Silo)</span>
                                                </td>
                                                <td class="min-w-200px">
                                                    <a class="fw-bold text-gray-900 text-hover-primary"
                                                       href="@approval.Url"
                                                       aria-label="@($"{SiloLabel(approval.Silo)} — {ApprovalTypeLabel(approval)}")">@ApprovalTypeLabel(approval)</a>
                                                    @if (!string.IsNullOrWhiteSpace(approval.Requester))
                                                    {
                                                        <span class="d-block text-gray-600 fs-7">@approval.Requester</span>
                                                    }
                                                </td>
                                                <td class="text-end text-gray-700 fw-semibold">
                                                    @if (approval.AgeDays is > 0)
                                                    {
                                                        <span>@approval.AgeDays.Value @Shared["days"]</span>
                                                    }
                                                    else if (approval.Submitted.HasValue)
                                                    {
                                                        <span>@Localizer["Now"]</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @PanelNotice(Model.Approvals.State, Shared["No pending approvals"].Value, "ki-outline ki-check-circle")
                        }
                    </div>
                </div>
                <!--end::Approvals-->

                <!--begin::Agenda-->
                <div class="card card-flush mb-5 mb-xl-10" id="agenda" aria-busy="false">
                    <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Unified Agenda"]
                            </span>
                        </h3>
                        @if (Model.Capabilities.Agenda)
                        {
                            <div class="card-toolbar">
                                <a href="@Url.Action("Agenda", "Workspace")" class="btn btn-sm btn-light">@Localizer["View all"]</a>
                            </div>
                        }
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Agenda.State == WorkspacePanelState.PartiallyAvailable)
                        {
                            <div class="mb-4">@PanelNotice(WorkspacePanelState.PartiallyAvailable, "", "")</div>
                        }
                        @if (Model.Agenda.HasItems)
                        {
                            <div class="table-responsive">
                                <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                    <thead>
                                        <tr class="fw-bold fs-7 text-uppercase text-gray-700" style="border-bottom:2px solid #0E4A9E;">
                                            <th>@Localizer["Agenda item"]</th>
                                            <th>@Localizer["Type"]</th>
                                            <th class="text-end">@Localizer["When"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Agenda.Items)
                                        {
                                            <tr class="@(item.Completed ? "text-decoration-line-through" : "")">
                                                <td class="min-w-200px">
                                                    <a class="fw-bold text-gray-900 text-hover-primary" href="@(item.DeepLink ?? Url.Action("Agenda", "Workspace"))">@item.Title</a>
                                                    @if (item.Overdue)
                                                    {
                                                        <span class="badge badge-light-danger fs-8 ms-2 text-gray-800">@Localizer["Overdue"]</span>
                                                    }
                                                </td>
                                                <td><span class="badge badge-light fs-8">@item.TypeLabel(arabic)</span></td>
                                                <td class="text-end text-gray-700 fw-semibold">
                                                    @(item.AllDay ? Localizer["All day"].Value : item.LocalAt.ToString("MMM d · HH:mm", CultureInfo.CurrentCulture))
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @PanelNotice(Model.Agenda.State, Localizer["Nothing in the next few days"].Value, "ki-outline ki-calendar")
                        }
                    </div>
                </div>
                <!--end::Agenda-->

                <!--begin::Recent Activity-->
                <div class="card card-flush" id="activity" aria-busy="false">
                    <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Recent Activity"]
                            </span>
                        </h3>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Activity.State == WorkspacePanelState.PartiallyAvailable)
                        {
                            <div class="mb-4">@PanelNotice(WorkspacePanelState.PartiallyAvailable, "", "")</div>
                        }
                        @if (Model.Activity.HasItems)
                        {
                            <div class="table-responsive">
                                <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                    <thead>
                                        <tr class="fw-bold fs-7 text-uppercase text-gray-700" style="border-bottom:2px solid #0E4A9E;">
                                            <th>@Localizer["Activity"]</th>
                                            <th>@Localizer["Details"]</th>
                                            <th class="text-end">@Localizer["When"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var activity in Model.Activity.Items)
                                        {
                                            <tr>
                                                <td>
                                                    <a class="fw-bold text-gray-900 text-hover-primary" href="@(activity.Url ?? Url.Action("Index", "Workspace"))">
                                                        <i class="@activity.Icon text-@MetricColor(activity.Tone) me-2"></i>@activity.Title
                                                    </a>
                                                </td>
                                                <td class="text-gray-700 fw-semibold">@activity.Detail</td>
                                                <td class="text-end text-gray-700 fw-semibold">@Ago(activity.At)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @PanelNotice(Model.Activity.State, Localizer["No activity yet"].Value, "ki-outline ki-time")
                        }
                    </div>
                </div>
                <!--end::Recent Activity-->

            </main>
            <!--end::Primary column-->

            <!--begin::Side column-->
            <aside class="col-xl-4" aria-label="Updates and reports">

                <!--begin::Notifications-->
                <div class="card card-flush mb-5 mb-xl-10" id="notifications" aria-busy="false">
                    <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Notifications"]
                                @if (Model.UnreadNotifications > 0)
                                {
                                    <span class="badge badge-light-danger fs-8 ms-2 text-gray-800">@Model.UnreadNotifications</span>
                                }
                            </span>
                        </h3>
                        @if (Model.Capabilities.Notifications)
                        {
                            <div class="card-toolbar">
                                <a href="@Url.Action("Notifications", "Workspace")" class="btn btn-sm btn-light">@Localizer["View all"]</a>
                            </div>
                        }
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Notifications.HasItems)
                        {
                            <div class="table-responsive">
                                <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                    <tbody>
                                        @foreach (var notification in Model.Notifications.Items)
                                        {
                                            <tr class="@(notification.IsRead ? "" : "fw-bold")">
                                                <td>
                                                    <a class="text-gray-900 text-hover-primary" href="@(notification.Url ?? Url.Action("Notifications", "Workspace"))">@notification.Title</a>
                                                    @if (!string.IsNullOrWhiteSpace(notification.Category))
                                                    {
                                                        <span class="badge badge-light fs-8 ms-2">@notification.Category</span>
                                                    }
                                                </td>
                                                <td class="text-end text-gray-700 fw-semibold">@Ago(notification.At)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @PanelNotice(Model.Notifications.State, Localizer["No notifications"].Value, "ki-outline ki-notification-bing")
                        }
                    </div>
                </div>
                <!--end::Notifications-->

                <!--begin::Mentions-->
                <div class="card card-flush mb-5 mb-xl-10" id="mentions" aria-busy="false">
                    <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Mentions"]
                                @if (Model.UnreadMentions > 0)
                                {
                                    <span class="badge badge-light-danger fs-8 ms-2 text-gray-800">@Model.UnreadMentions</span>
                                }
                            </span>
                        </h3>
                        @if (Model.Capabilities.Communication)
                        {
                            <div class="card-toolbar">
                                <a href="@Url.Action("Mentions", "Workspace")" class="btn btn-sm btn-light">@Localizer["View all"]</a>
                            </div>
                        }
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Mentions.HasItems)
                        {
                            <div class="table-responsive">
                                <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                    <tbody>
                                        @foreach (var mention in Model.Mentions.Items)
                                        {
                                            <tr>
                                                <td>
                                                    <a class="fw-bold text-gray-900 text-hover-primary" href="@(mention.Url ?? Url.Action("Mentions", "Workspace"))">@(mention.Excerpt == null ? mention.EntityLabel : NoAt(mention.Excerpt))</a>
                                                    <div class="text-gray-700 fs-7">@mention.MentionedBy · <span class="badge badge-light-primary fs-8">@mention.EntityLabel</span></div>
                                                </td>
                                                <td class="text-end text-gray-700 fw-semibold">@Ago(mention.At)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @PanelNotice(Model.Mentions.State, Localizer["No mentions"].Value, "ki-outline ki-messages")
                        }
                    </div>
                </div>
                <!--end::Mentions-->

                <!--begin::Favourite Reports-->
                <div class="card card-flush mb-5 mb-xl-10" id="favourite-reports" aria-busy="false">
                    <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Favourite Reports"]
                            </span>
                        </h3>
                        @if (Model.Capabilities.Reporting)
                        {
                            <div class="card-toolbar">
                                <a href="@Url.Action("Reports", "Workspace")" class="btn btn-sm btn-light">@Localizer["View all"]</a>
                            </div>
                        }
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Reports.State is not WorkspacePanelState.Ready and not WorkspacePanelState.Empty)
                        {
                            @PanelNotice(Model.Reports.State, "", "")
                        }
                        else if (favouriteReports.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                    <tbody>
                                        @foreach (var report in favouriteReports)
                                        {
                                            <tr>
                                                <td>
                                                    <a class="fw-bold text-gray-900 text-hover-primary" href="@(report.Url ?? Url.Action("Reports", "Workspace"))">
                                                        <i class="@report.Icon text-warning me-2"></i>@report.Label
                                                    </a>
                                                    @if (!string.IsNullOrWhiteSpace(report.Sub))
                                                    {
                                                        <div class="text-gray-700 fs-7">@report.Sub</div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @PanelNotice(WorkspacePanelState.Empty, Localizer["No favourite reports yet"].Value, "ki-outline ki-star")
                        }
                    </div>
                </div>
                <!--end::Favourite Reports-->

                <!--begin::Recent Reports-->
                <div class="card card-flush" id="recent-reports" aria-busy="false">
                    <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Recent Reports"]
                            </span>
                        </h3>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Reports.State is not WorkspacePanelState.Ready and not WorkspacePanelState.Empty)
                        {
                            @PanelNotice(Model.Reports.State, "", "")
                        }
                        else if (recentReports.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                    <tbody>
                                        @foreach (var report in recentReports)
                                        {
                                            <tr>
                                                <td>
                                                    <a class="fw-bold text-gray-900 text-hover-primary" href="@(report.Url ?? Url.Action("Reports", "Workspace"))">
                                                        <i class="@report.Icon text-primary me-2"></i>@report.Label
                                                    </a>
                                                    @if (!string.IsNullOrWhiteSpace(report.Sub))
                                                    {
                                                        <div class="text-gray-700 fs-7">@report.Sub</div>
                                                    }
                                                </td>
                                                <td class="text-end text-gray-700 fw-semibold">@Ago(report.At)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            @PanelNotice(WorkspacePanelState.Empty, Localizer["No recent reports yet"].Value, "ki-outline ki-chart-simple")
                        }
                    </div>
                </div>
                <!--end::Recent Reports-->

            </aside>
            <!--end::Side column-->

        </div>
    </div>
</div>
<!--end::Content-->
