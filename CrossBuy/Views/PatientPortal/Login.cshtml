@using System.Globalization
@using CrossBuy.BL.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    PATIENT PORTAL SIGN-IN (H25) — the client portal's sign-in page (Metronic demo30, the product token layer) with
    the patient's words. ONE refusal message for every failure, printed as the server says it.
    H46 — "forgot password" lives on this same page (the design the owner approved; no second page to keep in step):
    ViewBag.Mode is signin (default) / forgot / reset / expired; "sent" and "done" follow in place.
    H48 — the earlier-slot offer's emailed link opens here too (owner ruling 2026-11-08: like the reset link, no new
    page): offer / offer-gone; "taken" and "declined" follow in place. Every answer is confirmed first.
*@
@{
    Layout = null;
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    int? company = ViewBag.Company as int?;
    var mode = ViewBag.Mode as string ?? "signin";
    var offer = ViewBag.Offer as HospitalWaitlistOfferView;
    string When(DateTime d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) + "  " + d.ToString("HH:mm", CultureInfo.InvariantCulture);
}
<!DOCTYPE html>
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <title>@T["Patient portal"] — @CrossBuy.BL.Platform.ProductIdentity.Name</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.FaviconIco)" asp-append-version="true" />
    <link rel="stylesheet" href="~/Backend-assets/fonts/inter/inter.css" />
    <link href="/portal-assets/plugins/global/plugins.bundle@(isAr ? ".rtl" : "").css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="/portal-assets/css/style.bundle@(isAr ? ".rtl" : "").css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="/Backend-assets/css/crossbusiness-portal.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    @if (isAr)
    {
        <link href="/Backend-assets/fonts/cairo/cairo.css" rel="stylesheet" asp-append-version="true">
        <style>html[lang="ar"] body, html[lang="ar"] .btn, html[lang="ar"] input, html[lang="ar"] h1 { font-family: 'Cairo', sans-serif; }</style>
    }
</head>
<body id="kt_body" class="app-blank">
    <script>document.documentElement.setAttribute("data-bs-theme", "light");</script>
    <div class="d-flex flex-column flex-root" id="kt_app_root">
        <div class="d-flex flex-column flex-lg-row flex-column-fluid">
            <div class="d-flex flex-column flex-lg-row-fluid w-lg-50 p-10 order-2 order-lg-1">
                <div class="d-flex flex-center flex-column flex-lg-row-fluid">
                    <div class="w-lg-500px p-10">
                        @if (mode == "signin")
                        {
                        <form id="ppLoginForm" method="post" action="@Url.Action("Login")" data-pp-form>
                            @Html.AntiForgeryToken()
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["Patient sign in"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@T["Your appointments, your family's, in one place"]</div>
                            </div>
                            <div class="alert alert-danger d-none" role="alert" data-pp-error></div>
                            <div class="fv-row mb-8"><input type="text" name="userName" autocomplete="username" class="form-control bg-transparent" placeholder="@T["User name"]" /></div>
                            <div class="fv-row mb-3"><input type="password" name="password" autocomplete="current-password" class="form-control bg-transparent" placeholder="@T["Password"]" /></div>
                            <div class="d-flex flex-stack flex-wrap gap-3 fs-base fw-semibold mb-8">
                                <label class="form-check form-check-custom form-check-sm"><input class="form-check-input" type="checkbox" name="rememberMe" value="true" /><span class="form-check-label text-gray-600">@T["Remember me"]</span></label>
                                <a href="@Url.Action("SetLanguage", "Account", new { culture = isAr ? "en" : "ar", returnUrl = Context.Request.Path + Context.Request.QueryString })" class="link-primary">@(isAr ? "English" : "العربية")</a>
                            </div>
                            <div class="d-grid mb-10"><button type="submit" class="btn btn-primary" data-pp-submit><span class="indicator-label">@T["Sign in"]</span></button></div>
                            <div class="text-gray-500 text-center fw-semibold fs-6 mb-4"><a href="@Url.Action("Forgot")" class="link-primary">@T["Forgot your password?"]</a></div>
                            @if (company != null)
                            {
                                <div class="text-gray-500 text-center fw-semibold fs-6">@T["New to the hospital?"] <a href="@Url.Action("Register", new { c = company })" class="link-primary">@T["Create an account"]</a></div>
                            }
                        </form>
                        }
                        else if (mode == "forgot")
                        {
                        <form method="post" action="@Url.Action("Forgot")" data-pp-form data-pp-then="ppSent">
                            @Html.AntiForgeryToken()
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["Forgot your password?"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@T["Type your user name or your email, and we will email you a link to set a new password"]</div>
                            </div>
                            <div class="fv-row mb-8"><input type="text" name="who" autocomplete="username" class="form-control bg-transparent" placeholder="@T["User name or email"]" required /></div>
                            <div class="d-grid mb-10"><button type="submit" class="btn btn-primary" data-pp-submit><span class="indicator-label">@T["Send the link"]</span></button></div>
                            <div class="text-gray-500 text-center fw-semibold fs-6"><a href="@Url.Action("Login")" class="link-primary">@T["Back to sign in"]</a></div>
                        </form>
                        <div id="ppSent" class="d-none">
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["Check your email"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@string.Format(T["If an account matches that name or email, we have emailed it a link to set a new password. The link works for {0} minutes, once."].Value, HospitalPortalPasswordRules.LinkMinutes)</div>
                            </div>
                            <div class="text-gray-500 text-center fw-semibold fs-6"><a href="@Url.Action("Login")" class="link-primary">@T["Back to sign in"]</a></div>
                        </div>
                        }
                        else if (mode == "reset")
                        {
                        <form method="post" action="@Url.Action("Reset")" data-pp-form data-pp-then="ppDone">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="t" value="@ViewBag.Token" />
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["Set a new password"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@T["At least 6 characters with a capital letter, a small letter, a digit and a symbol"]</div>
                            </div>
                            <div class="alert alert-danger d-none" role="alert" data-pp-error></div>
                            <div class="fv-row mb-8"><input type="password" name="password" autocomplete="new-password" class="form-control bg-transparent" placeholder="@T["New password"]" /></div>
                            <div class="fv-row mb-8"><input type="password" name="again" autocomplete="new-password" class="form-control bg-transparent" placeholder="@T["Type it again"]" /></div>
                            <div class="d-grid mb-10"><button type="submit" class="btn btn-primary" data-pp-submit><span class="indicator-label">@T["Save the password"]</span></button></div>
                            <div class="text-gray-500 text-center fw-semibold fs-6"><a href="@Url.Action("Login")" class="link-primary">@T["Back to sign in"]</a></div>
                        </form>
                        <div id="ppDone" class="d-none">
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["Your password is changed"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@T["You are signed out on your other devices, and a notice is in your email"]</div>
                            </div>
                            <div class="d-grid mb-10"><a href="@Url.Action("Login")" class="btn btn-primary"><span class="indicator-label">@T["Sign in"]</span></a></div>
                        </div>
                        }
                        else if (mode == "offer" && offer != null)
                        {
                        <div id="ppOffer">
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["An earlier appointment is free"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@string.Format(T["Held for you for {0} more minutes"].Value, offer.MinutesLeft)</div>
                            </div>
                            <div class="alert alert-danger d-none" role="alert" data-pp-error></div>
                            <table class="table table-row-dashed align-middle fs-6 gy-4 mb-10"><tbody>
                                <tr><td class="text-muted fw-semibold w-150px">@T["Patient"]</td><td class="text-gray-900 fw-semibold">@offer.PatientName</td></tr>
                                <tr><td class="text-muted fw-semibold">@T["Doctor"]</td><td class="text-gray-900"><div class="fw-semibold">@offer.DoctorName</div>@if (!string.IsNullOrWhiteSpace(offer.DoctorTitle)) { <div class="text-muted fs-7">@offer.DoctorTitle</div> }</td></tr>
                                <tr><td class="text-muted fw-semibold">@T["The earlier time"]</td><td class="text-success fw-bold"><bdi dir="ltr">@When(offer.NewStart)</bdi></td></tr>
                                <tr><td class="text-muted fw-semibold">@T["Your appointment now"]</td><td class="text-gray-700"><bdi dir="ltr">@When(offer.OldStart)</bdi></td></tr>
                            </tbody></table>
                            <form method="post" action="@Url.Action("OfferPost")" data-pp-form data-pp-confirm="@T["Take the earlier time? Your appointment on {0} is released.", When(offer.OldStart)]">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="t" value="@ViewBag.Token" /><input type="hidden" name="answer" value="take" />
                                <div class="d-grid mb-5"><button type="submit" class="btn btn-primary" data-pp-submit><span class="indicator-label">@T["Take the earlier time"]</span></button></div>
                            </form>
                            <form method="post" action="@Url.Action("OfferPost")" data-pp-form data-pp-confirm="@T["Keep your appointment and let the earlier time go to the next patient?"]">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="t" value="@ViewBag.Token" /><input type="hidden" name="answer" value="decline" />
                                <div class="d-grid mb-10"><button type="submit" class="btn btn-light" data-pp-submit><span class="indicator-label">@T["No, keep my appointment"]</span></button></div>
                            </form>
                        </div>
                        <div id="ppTaken" class="d-none">
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["Your appointment is moved"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@string.Format(T["You are now booked on {0}, and your later appointment is released."].Value, When(offer.NewStart))</div>
                            </div>
                            <div class="d-grid mb-10"><a href="@Url.Action("Appointments")" class="btn btn-primary"><span class="indicator-label">@T["My appointments"]</span></a></div>
                        </div>
                        <div id="ppDeclined" class="d-none">
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["You kept your appointment"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@T["You stay on the waitlist: if another earlier time frees up, we will email you."]</div>
                            </div>
                            <div class="d-grid mb-10"><a href="@Url.Action("Login")" class="btn btn-primary"><span class="indicator-label">@T["Sign in"]</span></a></div>
                        </div>
                        }
                        else if (mode == "offer" || mode == "offer-gone")
                        {
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["This offer is no longer open"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@T["It was answered, or its time ran out and it went to the next patient waiting. Your appointment stays as it is."]</div>
                            </div>
                            <div class="d-grid mb-10"><a href="@Url.Action("Login")" class="btn btn-primary"><span class="indicator-label">@T["Sign in"]</span></a></div>
                        }
                        else
                        {
                            <div class="text-center mb-11">
                                <img alt="" class="h-40px mb-6" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" asp-append-version="true" />
                                <h1 class="text-gray-900 fw-bolder mb-3">@T["This link has expired"]</h1>
                                <div class="text-gray-500 fw-semibold fs-6">@string.Format(T["A link works for {0} minutes and only once"].Value, HospitalPortalPasswordRules.LinkMinutes)</div>
                            </div>
                            <div class="d-grid mb-10"><a href="@Url.Action("Forgot")" class="btn btn-primary"><span class="indicator-label">@T["Ask for a new link"]</span></a></div>
                            <div class="text-gray-500 text-center fw-semibold fs-6"><a href="@Url.Action("Login")" class="link-primary">@T["Back to sign in"]</a></div>
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex flex-lg-row-fluid w-lg-50 bgi-size-cover bgi-position-center order-1 order-lg-2" style="background-color: @CrossBuy.BL.Platform.ProductIdentity.Palette.Primary;">
                <div class="d-flex flex-column flex-center py-15 px-5 px-md-15 w-100">
                    <img alt="" class="h-60px mb-8" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnDark)" asp-append-version="true" />
                    <h1 class="text-white fs-2qx fw-bolder text-center mb-7">@T["Patient portal"]</h1>
                    <div class="text-white fs-base text-center opacity-75">@T["Book and follow your visits, and your family's."]</div>
                </div>
            </div>
        </div>
    </div>
    <script>var hostUrl = "/portal-assets/";</script>
    <script src="/portal-assets/plugins/global/plugins.bundle.js"></script>
    <script src="/portal-assets/js/scripts.bundle.js"></script>
    <script>
        (function () {
            // every form on the page: posted in place; the server's one message shown as it says it; then the next step
            document.querySelectorAll('[data-pp-form]').forEach(function (form) {
                var box = form.querySelector('[data-pp-error]') || (form.parentElement && form.parentElement.querySelector('[data-pp-error]')), btn = form.querySelector('[data-pp-submit]'), then = form.getAttribute('data-pp-then');
                var ask = form.getAttribute('data-pp-confirm');
                form.addEventListener('submit', function (e) {
                    e.preventDefault(); if (box) box.classList.add('d-none');
                    var go = function () { btn.disabled = true; send(); };
                    if (!ask) { go(); return; }
                    // every answer is confirmed first (the portal's own confirmation, as on "My appointments")
                    Swal.fire({ text: ask, icon: 'question', showCancelButton: true, buttonsStyling: false, confirmButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Yes"].Value)), cancelButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["No"].Value)),
                        customClass: { confirmButton: 'btn btn-primary', cancelButton: 'btn btn-light' } }).then(function (r) { if (r.isConfirmed) go(); });
                });
                function send() {
                    fetch(form.action, { method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form) })
                        .then(function (r) { return r.json(); })
                        .then(function (res) {
                            if (res && res.success && res.redirectUrl) { window.location.href = res.redirectUrl; return; }
                            var next = (res && res.then) || then, block = form.closest('#ppOffer') || form;
                            if (res && res.success && next) { block.classList.add('d-none'); document.getElementById(next).classList.remove('d-none'); return; }
                            if (res && res.expired) { window.location.reload(); return; }
                            if (box) { box.textContent = (res && res.message) ? res.message : ''; box.classList.remove('d-none'); }
                            btn.disabled = false;
                        })
                        .catch(function () { if (box) box.classList.remove('d-none'); btn.disabled = false; });
                }
            });
        })();
    </script>
</body>
</html>
