@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPortalMedicine>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "_Layout";
    var acc = (HospitalPortalAccount)ViewBag.Account;
    ViewData["Title"] = T["My medicines"].Value;
    ViewData["BandTitle"] = T["My medicines"].Value;
    ViewData["BandDesc"] = T["What your doctors prescribed, and asking for a medicine again"].Value;
    string Kind(string s) => s switch { HospitalPortalRefillStatus.Approved => "success", HospitalPortalRefillStatus.Declined => "danger", _ => "primary" };
}
@section Figures {
    <div class="d-flex flex-column"><span class="text-white fw-bold fs-3 mb-1 pp-num">@Model.Count</span><div class="text-white opacity-50 fw-bold">@T["Medicines"]</div></div>
    <div class="d-flex flex-column"><span class="text-white fw-bold fs-3 mb-1 pp-num">@Model.Count(m => m.Refill?.Status == HospitalPortalRefillStatus.Open)</span><div class="text-white opacity-50 fw-bold">@T["Refill requests"]</div></div>
}

<div class="card card-flush">
    <div class="card-header pt-7"><h3 class="card-title"><span class="card-label fw-bold text-gray-900">@T["Prescribed medicines"]</span></h3></div>
    <div class="card-body pt-2">
        @if (acc.Status != HospitalPortalAccountStatus.Verified) { <div class="text-center text-muted py-10">@T["Your medicines show here once the front desk has verified your account."]</div> }
        else if (Model.Count == 0) { <div class="text-center text-muted py-10">@T["None."]</div> }
        @foreach (var m in Model)
        {
            <div class="row g-4 align-items-center py-6 border-bottom border-gray-200 border-bottom-dashed">
                <div class="col-md-5 d-flex align-items-center gap-4">
                    <div class="symbol symbol-50px flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-capsule fs-2x text-primary"></i></span></div>
                    <div class="min-w-0"><div class="fs-5 fw-bold text-gray-900">@m.Drug</div>
                        <div class="text-muted fw-semibold fs-7">@m.Instructions@if (!string.IsNullOrEmpty(m.Instructions)) {<text> · </text>}@T["Quantity"] <span class="pp-num">@m.Quantity</span></div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <div class="symbol symbol-25px symbol-circle flex-shrink-0">@if (m.Person.Photo != null) {<img src="@Url.Action("PatientPhoto", new { id = m.Person.PatientId })" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(m.Person.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold fs-9">@HospitalUi.Initials(m.Person.NameEn)</span>}</div>
                            <span class="text-muted fs-8">@DisplayName.Of(m.Person.Name, m.Person.NameEn)</span></div></div>
                </div>
                <div class="col-md-3">@if (m.Doctor is { } d)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="symbol symbol-40px symbol-circle flex-shrink-0">@if (d.Photo != null) {<img src="@Url.Action("DoctorPhoto", new { id = d.Id })" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(d.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold">@HospitalUi.Initials(d.NameEn)</span>}</div>
                            <div><div class="fw-bold text-gray-900 fs-7">@DisplayName.Of(d.Name, d.NameEn)</div><div class="text-muted fs-8 pp-num">@m.PrescribedAt.ToLocalTime().ToString("yyyy-MM-dd")</div></div>
                        </div>
                    }</div>
                <div class="col-md-4 text-md-end">
                    @* the latest answer stays visible (where to collect it, or why not) *@
                    @if (m.Refill is { } r && r.Status != HospitalPortalRefillStatus.Withdrawn)
                    {
                        <span class="badge badge-light-@Kind(r.Status) fs-7">@T["rfl:" + r.Status]</span>
                        @if (!string.IsNullOrWhiteSpace(r.Answer) || !string.IsNullOrWhiteSpace(r.AnswerEn)) {<div class="text-gray-700 fs-8 mt-2" dir="auto">@DisplayName.Of(r.Answer ?? "", r.AnswerEn ?? "")</div>}
                        @if (r.Status == HospitalPortalRefillStatus.Open) {<div class="mt-2"><button type="button" class="btn btn-sm btn-light" data-refill-withdraw="@r.ID">@T["Withdraw"]</button></div>}
                    }
                    @if (m.CannotRefill == null)
                    {
                        <div class="mt-2"><button type="button" class="btn btn-sm btn-light-primary" data-refill="@m.LineId" data-drug="@m.Drug"><i class="ki-outline ki-arrows-circle fs-4"></i>@T["Request a refill"]</button></div>
                    }
                    else if (m.Refill?.Status != HospitalPortalRefillStatus.Open)
                    {
                        <span class="text-muted fs-8">@T[m.CannotRefill]</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var W = { ask: @Json.Serialize(T["Ask your doctor to renew {0}? You can add a note."].Value), withdraw: @Json.Serialize(T["Withdraw this refill request?"].Value),
                send: @Json.Serialize(T["Send the request"].Value), yes: @Json.Serialize(T["Yes"].Value), no: @Json.Serialize(T["No"].Value), note: @Json.Serialize(T["A note for your doctor (optional)"].Value),
                failed: @Json.Serialize(T["The change could not be saved"].Value), sent: @Json.Serialize(T["Refill request sent to your doctor"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            var urls = { refill: @Json.Serialize(Url.Action("Refill")), withdraw: @Json.Serialize(Url.Action("WithdrawRefill", new { id = 0 })) };
            // In place, never a reload.
            function swap() {
                return fetch(location.pathname, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    ['kt_app_content', 'kt_app_toolbar'].forEach(function (id) { var f = doc.getElementById(id); if (f) document.getElementById(id).innerHTML = f.innerHTML; });
                });
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-refill],[data-refill-withdraw]'); if (!t) return;
                if (t.hasAttribute('data-refill-withdraw')) {
                    Swal.fire({ text: W.withdraw, icon: 'question', showCancelButton: true, buttonsStyling: false, confirmButtonText: W.yes, cancelButtonText: W.no, customClass: { confirmButton: 'btn btn-danger', cancelButton: 'btn btn-light' } })
                        .then(function (r) {
                            if (!r.isConfirmed) return; t.disabled = true;
                            pp.post(urls.withdraw.replace(/0\/Withdraw$/, t.getAttribute('data-refill-withdraw') + '/Withdraw')).then(function (res) { t.disabled = false; if (!res.ok) { pp.toast('error', res.error || W.failed); return; } pp.toast('success', W.saved); swap(); });
                        });
                    return;
                }
                Swal.fire({ text: W.ask.replace('{0}', t.getAttribute('data-drug')), icon: 'question', input: 'textarea', inputPlaceholder: W.note, showCancelButton: true, buttonsStyling: false,
                    confirmButtonText: W.send, cancelButtonText: W.no, customClass: { input: 'form-control form-control-solid', confirmButton: 'btn btn-primary', cancelButton: 'btn btn-light' } })
                    .then(function (r) {
                        if (!r.isConfirmed) return; t.disabled = true;
                        pp.post(urls.refill, { lineId: +t.getAttribute('data-refill'), note: r.value || '' }).then(function (res) { t.disabled = false; if (!res.ok) { pp.toast('error', res.error || W.failed); return; } pp.toast('success', W.sent); swap(); });
                    });
            });
        })();
    </script>
}
