@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPortalResult>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "_Layout";
    var acc = (HospitalPortalAccount)ViewBag.Account;
    ViewData["Title"] = T["Results"].Value;
    ViewData["BandTitle"] = T["Results"].Value;
    ViewData["BandDesc"] = T["A result shows here once your doctor has reviewed it"].Value;
    int released = Model.Count(r => r.Released), review = Model.Count - released;
    bool ar = DisplayName.IsArabic;
    string Month(DateTime d) => ar ? new[] { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" }[d.Month - 1] : d.ToString("MMM", System.Globalization.CultureInfo.InvariantCulture);
    string Up(string s) => s.ToUpperInvariant();
    // H30: the dental tab — the dentist's own record, for one of the account's people
    var people = (ViewBag.People as IReadOnlyList<HospitalPortalPerson>) ?? Array.Empty<HospitalPortalPerson>();
    var dentalWho = ViewBag.DentalWho as HospitalPortalPerson;
    var dental = ViewBag.Dental as HospitalDentalChartView;
    var dentist = ViewBag.Dentist as HospitalDentist;
    var dentalVisits = (ViewBag.DentalVisits as List<(DateTime Date, int Start, int PractitionerId)>) ?? new();
    bool dentalTab = (ViewBag.Tab as string) == "dental";
    var dentalReleased = (ViewBag.DentalReleased as HashSet<int>) ?? new();
    var dentalPictures = ViewBag.DentalPictures as Dictionary<int, IReadOnlyList<HospitalRadImageRow>>;
    var resultPictures = (ViewBag.ResultPictures as Dictionary<int, IReadOnlyList<HospitalRadImageRow>>) ?? new();
}
@section Figures {
    <div class="d-flex flex-column"><span class="text-white fw-bold fs-3 mb-1 pp-num">@released</span><div class="text-white opacity-50 fw-bold">@T["Available"]</div></div>
    <div class="d-flex flex-column"><span class="text-white fw-bold fs-3 mb-1 pp-num">@review</span><div class="text-white opacity-50 fw-bold">@T["Under review"]</div></div>
}

<link href="~/css/hospital-dental-chart.css" rel="stylesheet" asp-append-version="true" />
<div class="card card-flush">
    <div class="card-header pt-7">
        <div class="card-title"><ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
            <li class="nav-item"><a class="nav-link text-active-primary pb-4 @(dentalTab ? "" : "active")" data-bs-toggle="tab" href="#pp_lab">@T["Lab & imaging"] <span class="badge badge-light-primary ms-1 pp-num">@Model.Count</span></a></li>
            <li class="nav-item"><a class="nav-link text-active-primary pb-4 @(dentalTab ? "active" : "")" data-bs-toggle="tab" href="#pp_dental">@T["Dentistry"]</a></li>
        </ul></div>
    </div>
    <div class="card-body pt-2"><div class="tab-content">
    <div class="tab-pane fade @(dentalTab ? "" : "show active")" id="pp_lab">
        @if (acc.Status != HospitalPortalAccountStatus.Verified)
        {
            <div class="text-center text-muted py-10">@T["Your results show here once the front desk has verified your account."]</div>
        }
        else if (Model.Count == 0)
        {
            <div class="text-center text-muted py-10">@T["None."]</div>
        }
        @foreach (var r in Model)
        {
            var local = r.At.ToLocalTime();
            <div class="py-6 border-bottom border-gray-200 border-bottom-dashed">
                <div class="row g-4 align-items-center">
                    <div class="col-md-5 d-flex align-items-center gap-4">
                        <div class="d-flex flex-column flex-center rounded bg-light-@(r.Released ? (r.Abnormal ? "danger" : "success") : "primary") w-60px h-60px flex-shrink-0">
                            <span class="fs-3 fw-bolder text-@(r.Released ? (r.Abnormal ? "danger" : "success") : "primary") lh-1 pp-num">@local.Day</span>
                            <span class="fs-8 fw-bold text-@(r.Released ? (r.Abnormal ? "danger" : "success") : "primary") mt-1">@Month(local)</span></div>
                        <div class="min-w-0">
                            <div class="fs-5 fw-bold text-gray-900"><i class="ki-outline @(r.Source == HospitalPortalResultSource.Lab ? "ki-test-tubes" : "ki-scan-barcode") fs-4 text-gray-500 me-1"></i>@DisplayName.Of(r.Name, r.NameEn)</div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <div class="symbol symbol-25px symbol-circle flex-shrink-0">@if (r.Person.Photo != null) {<img src="@Url.Action("PatientPhoto", new { id = r.Person.PatientId })" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.Person.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold fs-9">@HospitalUi.Initials(r.Person.NameEn)</span>}</div>
                                <span class="text-muted fw-semibold fs-7">@DisplayName.Of(r.Person.Name, r.Person.NameEn) · <span class="pp-num">@r.AccessionNo</span></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">@if (r.Doctor is { } d)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <div class="symbol symbol-40px symbol-circle flex-shrink-0">@if (d.Photo != null) {<img src="@Url.Action("DoctorPhoto", new { id = d.Id })" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(d.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold">@HospitalUi.Initials(d.NameEn)</span>}</div>
                                <div><div class="fw-bold text-gray-900 fs-7">@DisplayName.Of(d.Name, d.NameEn)</div><div class="text-muted fs-8">@T["Requested by your doctor"]</div></div>
                            </div>
                        }</div>
                    <div class="col-md-3 text-md-end">
                        @if (!r.Released) { <span class="badge badge-light fs-7">@T["Awaiting the doctor's review"]</span> }
                        else if (r.Abnormal) { <span class="badge badge-light-danger fs-7">@T["Outside the normal range"]</span> }
                        else { <span class="badge badge-light-success fs-7">@T["Normal"]</span> }
                    </div>
                </div>
                @if (r.Released)
                {
                    @if (!string.IsNullOrWhiteSpace(r.Note))
                    {
                        <div class="d-flex align-items-start gap-3 rounded bg-light-primary px-5 py-4 mt-5"><i class="ki-outline ki-message-text-2 fs-2 text-primary"></i>
                            <div><div class="fw-bold text-gray-900 fs-7">@T["Your doctor's note"]</div><div class="text-gray-700 fs-7" dir="auto">@r.Note</div></div></div>
                    }
                    @if (r.Values.Count > 0)
                    {
                        <div class="table-responsive mt-4"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                            <thead><tr class="text-start text-gray-500 fw-bold fs-8 gs-0"><th>@Up(T["Test"].Value)</th><th class="text-end">@Up(T["Result"].Value)</th><th>@Up(T["Normal range"].Value)</th></tr></thead>
                            <tbody class="fw-semibold text-gray-700">
                                @foreach (var v in r.Values)
                                {
                                    var shown = v.Value != null ? HospitalUi.LabNum(v.Value, v.Decimals) : v.TextValue;
                                    <tr>
                                        <td>@DisplayName.Of(v.Name, v.NameEn)</td>
                                        <td class="text-end text-nowrap"><bdi dir="ltr" class="pp-num fw-bold @(v.Flag != HospitalLabFlag.Normal ? "text-danger" : "text-gray-900")">@shown</bdi> @if (v.Unit != null) {<span class="text-muted fs-8" dir="ltr">@v.Unit</span>}
                                            @if (v.Flag is HospitalLabFlag.High or HospitalLabFlag.CriticalHigh) {<i class="ki-outline ki-arrow-up fs-6 text-danger" title="@T["Above range"]"></i>} else if (v.Flag is HospitalLabFlag.Low or HospitalLabFlag.CriticalLow) {<i class="ki-outline ki-arrow-down fs-6 text-danger" title="@T["Below range"]"></i>}</td>
                                        <td class="text-muted text-nowrap"><bdi dir="ltr" class="pp-num">@HospitalUi.LabRange(v.RefLow, v.RefHigh, v.Decimals)</bdi></td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(r.Impression))
                    {
                        <div class="mt-4"><div class="fw-bold text-gray-900 fs-7 mb-1">@T["Impression"]</div><div class="text-gray-700 fs-7" style="white-space:pre-line" dir="auto">@r.Impression</div></div>
                    }
                    @if (r.Source == HospitalPortalResultSource.Radiology && resultPictures.GetValueOrDefault(r.OrderId) is { Count: > 0 } pics)
                    {
                        <div class="row g-3 mt-2">
                            @foreach (var p in pics)
                            {
                                <div class="col-6 col-md-3"><a href="@Url.Action("Image", new { id = p.Id })" target="_blank" rel="noopener" class="d-block">
                                    <div class="rounded overflow-hidden bg-dark" style="height:140px"><img src="@Url.Action("Image", new { id = p.Id })" alt="" style="width:100%;height:100%;object-fit:cover" loading="lazy" /></div>
                                    <div class="text-gray-700 fs-8 mt-1 text-truncate">@(p.Caption ?? p.FileName)</div></a></div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(r.Findings))
                    {
                        <details class="mt-3"><summary class="fw-bold text-primary fs-7 cursor-pointer">@T["Full report"]</summary><div class="text-gray-700 fs-7 mt-2" style="white-space:pre-line" dir="auto">@r.Findings</div></details>
                    }
                }
            </div>
        }
    </div>
    <div class="tab-pane fade @(dentalTab ? "show active" : "")" id="pp_dental">
        @if (people.Count > 1)
        {
            <div class="d-flex flex-wrap gap-3 mb-6">
                @foreach (var p in people)
                {
                    <a href="@Url.Action("Results", new { patientId = p.PatientId, tab = "dental" })" class="btn btn-sm @(p.PatientId == dentalWho?.PatientId ? "btn-primary" : "btn-light") d-flex align-items-center gap-2">
                        <span class="symbol symbol-25px symbol-circle">@if (p.Photo != null) {<img src="@Url.Action("PatientPhoto", new { id = p.PatientId })" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold fs-9">@HospitalUi.Initials(p.NameEn)</span>}</span>
                        @DisplayName.Of(p.Name, p.NameEn)</a>
                }
            </div>
        }
        @if (dental == null)
        {
            <div class="text-center py-12">
                <div class="symbol symbol-60px mb-5"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-emoji-happy fs-2x text-primary"></i></span></div>
                <div class="text-gray-800 fw-bold fs-5">@T["No dental report yet"]</div>
                <div class="text-muted fs-7 mt-1">@T["The report shows here after your first finished visit at the dental clinic."]</div>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-6 mb-6">
                @if (dentist != null)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="symbol symbol-45px symbol-circle flex-shrink-0">@if (dentist.Photo != null) {<img src="@Url.Action("DoctorPhoto", new { id = dentist.Id })" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(dentist.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold">@HospitalUi.Initials(dentist.NameEn)</span>}</div>
                        <div><div class="fw-bold text-gray-900">@DisplayName.Of(dentist.Name, dentist.NameEn)</div><div class="text-muted fs-8">@T["Your dentist"]</div></div>
                    </div>
                }
                @if (dentalVisits.Count > 0)
                {
                    <div><div class="text-muted fs-8">@T["Last dental visit"]</div><div class="fw-bold text-gray-900 pp-num">@dentalVisits[0].Date.ToString("yyyy-MM-dd")</div></div>
                }
            </div>
            @* the dentist's own four tabs — the same drawing, data and words (Views/Shared/_HospitalDentalTabs) *@
            <partial name="_HospitalDentalTabs" model="@(new HospitalDentalTabsModel(dental, Staff: false, Edit: false, Photo: d => d.Photo == null ? null : Url.Action("DoctorPhoto", new { id = d.Id }), ImageLink: x => null,
                Pictures: dentalPictures, PictureSrc: i => Url.Action("Image", new { id = i }), ShowOrder: x => dentalReleased.Contains(x.Id)))" />
        }
    </div>
    </div></div>
</div>

@section Scripts {
    @if (dental != null)
    {
        <script src="~/js/hospital/hospital-dental.js" asp-append-version="true"></script>
        <partial name="_HospitalDentalText" />
        <script>
            (function () {
                var HD = window.HospitalDental, W = window.HospitalDentalText, el = document.getElementById('dn_data'); if (!HD || !el) return;
                var d = JSON.parse(el.textContent), teeth = d.teeth || {}, marks = d.marks || [], procs = @Json.Serialize(ViewBag.DentalProcs ?? new Dictionary<string, object>());
                // the dentist's drawing and panel, without the dentist's buttons
                function drawChart() {
                    var box = document.getElementById('dn_chart_box'); if (!box) return;
                    box.innerHTML = HD.DEFS + HD.chart(teeth, d.dentition, W);
                    box.querySelectorAll('.dn-tooth').forEach(function (t) { t.addEventListener('click', function () {
                        box.querySelectorAll('.dn-tooth.sel').forEach(function (x) { x.classList.remove('sel'); }); t.classList.add('sel');
                        document.getElementById('dn_tooth_panel').innerHTML = HD.toothPanel(+t.getAttribute('data-tooth'), teeth, marks, procs, W, { edit: false });
                    }); });
                }
                function drawPerio() {
                    var up = document.getElementById('dn_perio_up'), lo = document.getElementById('dn_perio_lo');
                    if (up) up.innerHTML = HD.perioArch(d.perio || {}, d.mob || {}, d.furc || {}, HD.UPPER, true, W);
                    if (lo) lo.innerHTML = HD.perioArch(d.perio || {}, d.mob || {}, d.furc || {}, HD.LOWER, false, W);
                }
                drawChart(); drawPerio();
            })();
        </script>
    }
}
