@using System.Globalization
@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    PATIENT PORTAL SHELL (H25) — Metronic demo30, the client portal's theme, with the same product token layer:
    the header menu (no sidebar), the gradient toolbar band carrying the breadcrumb, the title and the headline
    figures in white, and the content card pulled up into it. A page fills the band through ViewData
    (BandTitle, BandDesc) and the "Figures" section, and the card through its body.
*@
@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var acc = ViewBag.Account as HospitalPortalAccount;
    string page = (ViewBag.Page as string) ?? "home";
    // through the portal's own photo endpoint (PrivateFileGate keeps the files for the staff sign-in)
    string? photo = ViewBag.Photo is string && acc?.PatientId is int me ? Url.Action("PatientPhoto", new { id = me }) : null;
    string name = acc == null ? "" : DisplayName.Of(acc.Name, acc.NameEn ?? acc.Name);
    string initials = acc == null ? "" : HospitalUi.Initials(acc.NameEn ?? acc.Name);
    var pages = new (string Key, string Action, string Label)[] {
        ("home", "Index", T["Home"].Value), ("book", "Book", T["Book an appointment"].Value), ("appointments", "Appointments", T["My appointments"].Value),
        ("results", "Results", T["Results"].Value), ("bills", "Bills", T["Bills"].Value), ("meds", "Medicines", T["My medicines"].Value), ("messages", "Messages", T["Messages"].Value), ("questionnaires", "Questionnaires", T["Questionnaires"].Value) };
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <title>@ViewData["Title"] — @T["Patient portal"]</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.FaviconIco)" asp-append-version="true" />
    <link rel="stylesheet" href="~/Backend-assets/fonts/inter/inter.css" />
    <link href="/portal-assets/plugins/global/plugins.bundle@(isAr ? ".rtl" : "").css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="/portal-assets/css/style.bundle@(isAr ? ".rtl" : "").css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="/Backend-assets/css/crossbusiness-portal.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    @if (isAr)
    {
        <link href="/Backend-assets/fonts/cairo/cairo.css" rel="stylesheet" asp-append-version="true">
        <style>html[lang="ar"] body, html[lang="ar"] .btn, html[lang="ar"] input, html[lang="ar"] h1, html[lang="ar"] h2, html[lang="ar"] h3 { font-family: 'Cairo', sans-serif; }</style>
    }
    <style>.pp-num, .hp-num { direction: ltr; unicode-bidi: isolate; font-variant-numeric: tabular-nums; }</style>
</head>
<body id="kt_app_body" data-kt-app-header-fixed-mobile="true" data-kt-app-toolbar-enabled="true" class="app-default">
    <script>document.documentElement.setAttribute("data-bs-theme", "light");</script>
    <div class="d-flex flex-column flex-root app-root" id="kt_app_root">
        <div class="app-page flex-column flex-column-fluid" id="kt_app_page">
            <div id="kt_app_header" class="app-header" data-kt-sticky="true" data-kt-sticky-activate="{default: false, lg: true}" data-kt-sticky-name="app-header-sticky" data-kt-sticky-offset="{default: false, lg: '300px'}">
                <div class="app-container container-xxl d-flex align-items-stretch justify-content-between" id="kt_app_header_container">
                    <div class="d-flex align-items-center d-lg-none ms-n3 me-2">
                        <div class="btn btn-icon btn-color-gray-600 btn-active-color-primary w-35px h-35px" id="kt_app_header_menu_toggle"><i class="ki-outline ki-abstract-14 fs-2"></i></div>
                    </div>
                    <div class="d-flex align-items-center flex-grow-1 flex-lg-grow-0 me-lg-15">
                        <a href="@Url.Action("Index")"><img alt="" src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" class="h-25px" asp-append-version="true" /></a>
                    </div>
                    <div class="d-flex align-items-stretch justify-content-between flex-lg-grow-1" id="kt_app_header_wrapper">
                        <div class="app-header-menu app-header-mobile-drawer align-items-stretch" data-kt-drawer="true" data-kt-drawer-name="app-header-menu" data-kt-drawer-activate="{default: true, lg: false}" data-kt-drawer-overlay="true" data-kt-drawer-width="250px" data-kt-drawer-direction="start" data-kt-drawer-toggle="#kt_app_header_menu_toggle" data-kt-swapper="true" data-kt-swapper-mode="{default: 'append', lg: 'prepend'}" data-kt-swapper-parent="{default: '#kt_app_body', lg: '#kt_app_header_wrapper'}">
                            <div class="menu menu-rounded menu-active-bg menu-state-primary menu-column menu-lg-row menu-title-gray-700 menu-icon-gray-500 menu-arrow-gray-500 menu-bullet-gray-500 my-5 my-lg-0 align-items-stretch fw-semibold px-2 px-lg-0" id="kt_app_header_menu" data-kt-menu="true">
                                @foreach (var p in pages)
                                {
                                    <div class="menu-item me-0 me-lg-2 @(p.Key == page ? "here show" : "")"><a class="menu-link @(p.Key == page ? "active" : "")" href="@Url.Action(p.Action)"><span class="menu-title">@p.Label</span></a></div>
                                }
                            </div>
                        </div>
                        <div class="app-navbar flex-shrink-0">
                            <div class="app-navbar-item ms-3 ms-lg-5">
                                <a class="btn btn-sm btn-light fw-bold" href="@Url.Action("SetLanguage", "Account", new { culture = isAr ? "en" : "ar", returnUrl })">@(isAr ? "English" : "العربية")</a>
                            </div>
                            <div class="app-navbar-item ms-3 ms-lg-5" id="kt_header_user_menu_toggle">
                                <div class="cursor-pointer symbol symbol-35px symbol-md-45px symbol-circle" data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                                    @if (photo != null) {<img src="@photo" alt="" style="object-fit:cover" data-initials="@initials" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold">@initials</span>}
                                </div>
                                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-4 fs-6 w-275px" data-kt-menu="true">
                                    <div class="menu-item px-3"><div class="menu-content d-flex align-items-center px-3">
                                        <div class="symbol symbol-50px symbol-circle me-5">@if (photo != null) {<img src="@photo" alt="" style="object-fit:cover" data-initials="@initials" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold">@initials</span>}</div>
                                        <div class="d-flex flex-column"><div class="fw-bold fs-5">@name</div>
                                            @if (acc?.Status == HospitalPortalAccountStatus.Verified) {<span class="badge badge-light-success fs-8 mt-1">@T["Verified"]</span>} else {<span class="badge badge-light-danger fs-8 mt-1">@T["Not verified"]</span>}</div>
                                    </div></div>
                                    <div class="separator my-2"></div>
                                    <div class="menu-item px-5">
                                        <form method="post" action="@Url.Action("Logout")">@Html.AntiForgeryToken()<button type="submit" class="menu-link px-5 btn btn-link w-100 text-start">@T["Sign out"]</button></form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
                <div id="kt_app_toolbar" class="app-toolbar py-6">
                    <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex align-items-start">
                        <div class="d-flex flex-column flex-row-fluid">
                            <div class="d-flex align-items-center pt-1">
                                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                                    <li class="breadcrumb-item text-white fw-bold lh-1"><a href="@Url.Action("Index")" class="text-white text-hover-primary"><i class="ki-outline ki-home text-white fs-3"></i></a></li>
                                    <li class="breadcrumb-item"><i class="ki-outline @(isAr ? "ki-left" : "ki-right") fs-4 text-white mx-n1"></i></li>
                                    <li class="breadcrumb-item text-white fw-bold lh-1">@ViewData["Title"]</li>
                                </ul>
                            </div>
                            <div class="d-flex flex-stack flex-wrap flex-lg-nowrap gap-4 gap-lg-10 pt-6 pb-18 py-lg-13">
                                <div class="page-title d-flex align-items-center me-3">
                                    <div class="symbol symbol-60px symbol-circle me-5">@if (photo != null) {<img src="@photo" alt="" style="object-fit:cover" data-initials="@initials" />} else {<span class="symbol-label bg-white text-primary fw-bolder fs-3">@initials</span>}</div>
                                    <h1 class="page-heading d-flex text-white fw-bolder fs-2 flex-column justify-content-center my-0">@ViewData["BandTitle"]
                                        <span class="page-desc text-white opacity-50 fs-6 fw-bold pt-4">@ViewData["BandDesc"]</span></h1>
                                </div>
                                <div class="d-flex gap-4 gap-lg-13">@await RenderSectionAsync("Figures", required: false)</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="app-container container-xxl">
                    <div class="app-main flex-column flex-row-fluid" id="kt_app_main">
                        <div class="d-flex flex-column flex-column-fluid">
                            <div id="kt_app_content" class="app-content">@RenderBody()</div>
                        </div>
                        <div id="kt_app_footer" class="app-footer d-flex flex-column flex-md-row align-items-center flex-center flex-md-stack py-2 py-lg-4">
                            <div class="text-gray-900 order-2 order-md-1"><span class="text-muted fw-semibold me-1">@DateTime.Now.Year&copy;</span><span class="text-gray-800">@CrossBuy.BL.Platform.ProductIdentity.Name</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.AntiForgeryToken()
    <script>var hostUrl = "/portal-assets/";</script>
    <script src="/portal-assets/plugins/global/plugins.bundle.js"></script>
    <script src="/portal-assets/js/scripts.bundle.js"></script>
    <script>
        window.pp = {
            token: function () { return document.querySelector('input[name="__RequestVerificationToken"]').value; },
            post: function (url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': pp.token() }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            },
            get: function (url) { return fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }); },
            toast: function (k, m) { if (window.toastr) toastr[k](m); },
            esc: function (v) { var d = document.createElement('div'); d.textContent = v == null ? '' : String(v); return d.innerHTML; }
        };
    </script>
    <script>
        // A photograph that cannot be served (no file, or not this person's) becomes the initials, never a broken image.
        document.addEventListener('error', function (e) {
            var img = e.target; if (!img || img.tagName !== 'IMG' || !img.hasAttribute('data-initials')) return;
            var span = document.createElement('span'); span.className = 'symbol-label bg-light-primary text-primary fw-bold'; span.textContent = img.getAttribute('data-initials');
            img.replaceWith(span);
        }, true);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
