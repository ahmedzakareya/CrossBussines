@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalQuestionnaire>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H250 — the questionnaires the clinic sent to the account's people: answer a waiting one item by item; the answered
    ones show their date (the score is the clinician's to discuss).
*@
@{
    Layout = "_Layout";
    var people = (IReadOnlyList<HospitalPortalPerson>)ViewBag.People;
    var open = ViewBag.Open as HospitalQuestionnaire;
    ViewData["Title"] = T["Questionnaires"].Value;
    ViewData["BandTitle"] = T["Questionnaires"].Value;
    ViewData["BandDesc"] = T["Short questionnaires your clinic asked you to fill before your visit"].Value;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
}
@section Figures {
    <div class="d-flex flex-column"><span class="text-white fw-bold fs-3 mb-1 pp-num">@Model.Count(q => q.Status == HospitalQuestionnaireStatus.Pending)</span><div class="text-white opacity-50 fw-bold">@T["Waiting"]</div></div>
}

@if (open != null && HospitalQuestionnaireRules.Find(open.Instrument) is { } ins)
{
    var who = people.FirstOrDefault(p => p.PatientId == open.PatientId);
    <div class="card card-flush mb-5" data-qn="@open.ID" data-n="@ins.Items.Count">
        <div class="card-header pt-7"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-900">@L(ins.Ar, ins.En)</span>
            <span class="text-muted mt-1 fw-semibold fs-7">@(who == null ? "" : DisplayName.Of(who.Name, who.NameEn)) · @L(ins.StemAr, ins.StemEn)</span></h3></div>
        <div class="card-body pt-2">
            @for (int i = 0; i < ins.Items.Count; i++)
            {
                <div class="py-5 border-bottom border-gray-200 border-bottom-dashed">
                    <div class="fw-bold text-gray-900 fs-6 mb-3"><span class="pp-num me-2">@(i + 1).</span>@L(ins.Items[i].Ar, ins.Items[i].En)</div>
                    <div class="d-flex flex-wrap gap-5">
                        @for (int o = 0; o < ins.Options.Count; o++)
                        {
                            <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="radio" name="qi@(i)" value="@o" /><span class="form-check-label fw-semibold text-gray-700">@L(ins.Options[o].Ar, ins.Options[o].En)</span></label>
                        }
                    </div>
                </div>
            }
            <div class="text-end pt-6"><button type="button" class="btn btn-primary" data-qn-send>@T["Send my answers"]</button></div>
        </div>
    </div>
}

<div class="card card-flush">
    <div class="card-header pt-7"><h3 class="card-title"><span class="card-label fw-bold text-gray-900">@T["Questionnaires"]</span></h3></div>
    <div class="card-body pt-2">
        @if (Model.Count == 0) {<div class="text-center text-muted py-10">@T["None."]</div>}
        @foreach (var q in Model)
        {
            var ins2 = HospitalQuestionnaireRules.Find(q.Instrument); var who = people.FirstOrDefault(p => p.PatientId == q.PatientId);
            <div class="d-flex align-items-center gap-4 py-5 border-bottom border-gray-200 border-bottom-dashed">
                <div class="symbol symbol-45px flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-questionnaire-tablet fs-2x text-primary"></i></span></div>
                <div class="flex-grow-1 min-w-0"><div class="fw-bold text-gray-900">@(ins2 == null ? q.Instrument : L(ins2.Ar, ins2.En))</div>
                    <div class="text-muted fs-7">@(who == null ? "" : DisplayName.Of(who.Name, who.NameEn)) · <span class="pp-num">@((q.CompletedAt ?? q.SentAt).ToLocalTime().ToString("yyyy-MM-dd"))</span></div></div>
                @if (q.Status == HospitalQuestionnaireStatus.Pending) {<a href="@Url.Action("Questionnaires", new { id = q.ID })" class="btn btn-sm btn-primary">@T["Answer"]</a>}
                else {<span class="badge badge-light-primary fs-7">@T["Answered"]</span>}
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        (function () {
            var c = document.querySelector('[data-qn]'); if (!c) return;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), all: @Json.Serialize(T["Answer every question"].Value), thanks: @Json.Serialize(T["Thank you: your clinic will see your answers"].Value) };
            c.querySelector('[data-qn-send]').addEventListener('click', function () {
                var n = +c.getAttribute('data-n'), a = [];
                for (var i = 0; i < n; i++) { var r = c.querySelector('input[name=qi' + i + ']:checked'); if (!r) { pp.toast('error', W.all); return; } a.push(+r.value); }
                pp.post(@Json.Serialize(Url.Content("~/PatientPortal/Questionnaires/")) + c.getAttribute('data-qn'), { answers: a }).then(function (res) {
                    if (!res.ok) { pp.toast('error', res.error || W.failed); return; } pp.toast('success', W.thanks); setTimeout(function () { location.href = @Json.Serialize(Url.Action("Questionnaires")); }, 900); });
            });
        })();
    </script>
}
