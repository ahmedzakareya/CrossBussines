@using CrossBuy.Models.Context.Admin
@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<Branch>
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var currencies = (ViewBag.Currencies as List<Currency>) ?? new List<Currency>();
    bool hasPostings = (bool)(ViewBag.HasPostings ?? false);
    var company = ViewBag.Company;
    int? companyCur = company?.DefaultCurrencyId;
    string CurName(int? id) { var c = currencies.FirstOrDefault(x => x.ID == id); return c == null ? "—" : (c.Code + " — " + (isAr ? c.Name : (c.NameEn ?? c.Name))); }
    var curCode = currencies.FirstOrDefault(x => x.ID == companyCur)?.Code ?? "—";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Functional Currency Setup"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Functional currency"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Notice-->
        @if (hasPostings)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mb-5">
                <span class="symbol symbol-45px me-5"><span class="symbol-label bg-danger"><i class="ki-outline ki-lock-2 fs-2x text-white"></i></span></span>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap"><div class="fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@Localizer["Functional currency"]</h4>
                    <div class="fs-6 text-gray-700">@Localizer["Postings already exist — the functional currency is now stable and cannot be changed (changing it would require re-translating all balances)."]</div>
                </div></div>
            </div>
        }
        else
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5">
                <span class="symbol symbol-45px me-5"><span class="symbol-label bg-primary"><i class="ki-outline ki-dollar fs-2x text-white"></i></span></span>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap"><div class="fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@Localizer["Functional currency"]</h4>
                    <div class="fs-6 text-gray-700">@Localizer["The functional currency is the currency of the books and financial statements. Set it now — it locks automatically after the first transaction."]</div>
                </div></div>
            </div>
        }
        <!--end::Notice-->

        <!--begin::Company default currency-->
        <div class="card card-bordered mb-5 mb-xl-10 ribbon ribbon-end ribbon-clip">
            <div class="ribbon-label" style="top:16px;background:#13433a;color:#fff;">
                @if (hasPostings) { <i class="ki-outline ki-lock-2 fs-7 me-1 text-white"></i> }
                @curCode
                <span class="ribbon-inner" style="background:#1f6253;"></span>
            </div>
            <div class="card-header">
                <div class="card-title"><h3>@Localizer["Company default currency"]</h3></div>
            </div>
            <div class="card-body py-8">
                <div class="d-flex flex-wrap align-items-center gap-6">
                    <span class="symbol symbol-60px"><span class="symbol-label" style="background:#eaf3ef;"><i class="ki-outline ki-bank fs-2x" style="color:#13433a;"></i></span></span>
                    <div>
                        <div class="fw-bold fs-4 text-gray-900">@company?.CompanyName</div>
                        <div class="text-muted fw-semibold fs-7">@Localizer["Company"] · @Localizer["Functional currency"]</div>
                    </div>
                    <form asp-action="SetCompanyCurrency" method="post" class="d-flex align-items-end gap-3 flex-wrap ms-auto"
                          data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Set company default currency?"]">@Html.AntiForgeryToken()
                        <div style="min-width:280px">
                            <label class="fw-semibold fs-8 text-muted mb-1 d-block">@Localizer["Company default currency"]</label>
                            <select name="currencyId" class="form-select form-select-solid" @(hasPostings ? "disabled" : "")>
                                @foreach (var c in currencies) { <option value="@c.ID" selected="@(c.ID == companyCur)">@c.Code — @(isAr ? c.Name : (c.NameEn ?? c.Name))</option> }
                            </select>
                        </div>
                        @if (!hasPostings) { <button class="btn btn-primary"><i class="ki-outline ki-check fs-3"></i>@SR["Save"]</button> }
                    </form>
                </div>
            </div>
        </div>
        <!--end::Company default currency-->

        <!--begin::Branches-->
        <div class="card">
            <div class="card-header card-header-stretch">
                <div class="card-title"><h3>@Localizer["Functional currency per branch"]</h3></div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-row-bordered align-middle gy-5 mb-0">
                        <thead class="border-bottom border-gray-200 fs-7 fw-bold text-uppercase text-muted bg-lighten">
                            <tr>
                                <th class="ps-9">@SR["Branch"]</th>
                                <th>@Localizer["Current currency"]</th>
                                <th class="text-end pe-9" style="min-width:320px">@Localizer["Set"]</th>
                            </tr>
                        </thead>
                        <tbody class="fs-6 fw-semibold text-gray-700">
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="ps-9"><span class="symbol symbol-35px me-3"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-shop fs-5 text-primary"></i></span></span><span class="fw-bold text-gray-900">@(isAr ? (b.NameAr ?? b.Name) : (b.Name ?? b.NameAr))</span></td>
                                <td><span class="badge badge-light-primary fw-bold">@CurName(b.FunctionalCurrencyId)</span></td>
                                <td class="text-end pe-9">
                                    @if (b.CurrencyLockedAt != null)
                                    {
                                        <span class="badge badge-light-danger fs-7 py-2 px-3"><i class="ki-outline ki-lock-2 fs-6 me-1"></i>@Localizer["Locked after first transaction"]</span>
                                    }
                                    else
                                    {
                                        <form asp-action="SetBranchCurrency" method="post" class="d-flex align-items-center justify-content-end gap-2"
                                              data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Set branch functional currency?"]">@Html.AntiForgeryToken()
                                            <input type="hidden" name="branchId" value="@b.ID" />
                                            <select name="currencyId" class="form-select form-select-solid form-select-sm w-auto">
                                                @foreach (var c in currencies) { <option value="@c.ID" selected="@(c.ID == b.FunctionalCurrencyId)">@c.Code</option> }
                                            </select>
                                            <button class="btn btn-sm btn-light-primary"><i class="ki-outline ki-check fs-5"></i>@SR["Save"]</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-10">@Localizer["No branches — the company default currency is used."]</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!--end::Branches-->
    </div></div>
</div>
