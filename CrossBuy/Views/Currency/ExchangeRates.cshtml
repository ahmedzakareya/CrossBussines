@using CrossBuy.Controllers
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<CurrencyController.ExchangeRateRow>
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var currencies = (ViewBag.Currencies as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    string TypeName(string t) => t switch { "Buy" => Localizer["Buy"].Value, "Sell" => Localizer["Sell"].Value, "Central" => Localizer["Central"].Value, _ => t };
    string TypeColor(string t) => t switch { "Buy" => "info", "Sell" => "success", "Central" => "primary", _ => "secondary" };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Exchange Rates"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Exchange Rates"]</li>
            </ul>
        </div>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#mNew"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New rate"]</button>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Notice-->
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5">
            <span class="symbol symbol-45px me-5"><span class="symbol-label bg-primary"><i class="ki-outline ki-dollar fs-2x text-white"></i></span></span>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@Localizer["Exchange Rates"]</h4>
                    <div class="fs-6 text-gray-700">@Localizer["Rate = value of one currency unit in EGP. Type: Buy (vendor payments), Sell (customer collection), Central (mid). The latest rate on/before the transaction date is used."]</div>
                </div>
            </div>
        </div>
        <!--end::Notice-->

        <!--begin::List card-->
        <div class="card">
            <div class="card-header card-header-stretch">
                <div class="card-title"><h3>@Localizer["Exchange Rates"]</h3></div>
                <div class="card-toolbar">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                        <input type="text" id="s" class="form-control form-control-solid form-control-sm w-250px ps-11" placeholder="@Localizer["Search..."]" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-row-bordered align-middle gy-5 mb-0" id="t">
                        <thead class="border-bottom border-gray-200 fs-7 fw-bold text-uppercase text-muted bg-lighten">
                            <tr>
                                <th class="ps-9">@SR["Currency"]</th>
                                <th class="text-center">@SR["Type"]</th>
                                <th>@SR["Date"]</th>
                                <th class="text-end pe-9">@Localizer["Rate (EGP)"]</th>
                            </tr>
                        </thead>
                        <tbody class="fs-6 fw-semibold text-gray-700">
                        @foreach (var r in Model)
                        {
                            <tr class="r" data-s="@r.Code @r.Name @r.NameEn @r.RateType">
                                <td class="ps-9"><span class="badge badge-light fs-8 fw-semibold me-2">@r.Code</span><span class="text-gray-900 fw-bold">@(isAr ? r.Name : (r.NameEn ?? r.Name))</span></td>
                                <td class="text-center"><span class="badge badge-light-@TypeColor(r.RateType)">@TypeName(r.RateType)</span></td>
                                <td class="text-muted fw-semibold">@r.RateDate.ToString("yyyy/MM/dd")</td>
                                <td class="text-end pe-9 fw-bold text-gray-900">@r.Rate.ToString("0.####")</td>
                            </tr>
                        }
                        @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-10">@Localizer["No exchange rates"]</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!--end::List card-->
    </div></div>
</div>

<div class="modal fade" id="mNew" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="SaveExchangeRate" method="post" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Save exchange rate?"]">@Html.AntiForgeryToken()
        <div class="modal-header"><h2 class="fw-bold">@Localizer["New exchange rate"]</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8"><div class="row">
            <div class="col-12 mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Currency"]</label>
                <select name="currencyId" class="form-select form-select-solid" required>
                    <option value="">@Localizer["Select…"]</option>
                    @foreach (var c in currencies) { <option value="@c.ID">@c.Code — @(isAr ? c.Name : (c.NameEn ?? c.Name))</option> }
                </select></div>
            <div class="col-6 mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Type"]</label>
                <select name="rateType" class="form-select form-select-solid">
                    <option value="Central">@Localizer["Central"]</option>
                    <option value="Buy">@Localizer["Buy"]</option>
                    <option value="Sell">@Localizer["Sell"]</option>
                </select></div>
            <div class="col-6 mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label><input name="rateDate" type="date" class="form-control form-control-solid" required /></div>
            <div class="col-12 mb-2"><label class="required fw-semibold fs-6 mb-2">@Localizer["Rate (EGP per unit)"]</label><input name="rate" type="number" step="0.0001" min="0" class="form-control form-control-solid" required /></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@SR["Save"]</button></div>
    </form>
</div></div></div>

