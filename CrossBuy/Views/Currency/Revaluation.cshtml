@using CrossBuy.BL
@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model FxRevalPreview
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    string Money(decimal v) => v.ToString("N2");
    var asOf = (DateTime)(ViewBag.AsOf);
    var rateType = (string)(ViewBag.RateType ?? "Central");
    var history = ViewBag.History as List<FxRevaluationRun> ?? new();
    string TypeName(string t) => t == "AR" ? Localizer["Receivable"].Value : Localizer["Payable"].Value;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["FX Revaluation"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Unrealized FX"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <!--begin::Notice-->
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5">
            <span class="symbol symbol-45px me-5"><span class="symbol-label bg-primary"><i class="ki-outline ki-information-5 fs-2x text-white"></i></span></span>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@Localizer["FX Revaluation"]</h4>
                    <div class="fs-6 text-gray-700">@Localizer["Open foreign AR/AP balances are revalued at the closing rate; the unrealized difference (4903 gain / 5903 loss) is posted with an automatic reversal the next day — so the control-account balance is not permanently affected."]</div>
                </div>
            </div>
        </div>
        <!--end::Notice-->

        <!--begin::Filter + run-->
        <div class="card card-flush mb-5 d-print-none"><div class="card-body py-5">
            <form method="get" class="row g-4 align-items-end">
                <div class="col-md-3"><label class="fw-semibold fs-8 text-muted mb-1 d-block">@Localizer["As-of (period end)"]</label>
                    <input type="date" name="asOf" value="@asOf.ToString("yyyy-MM-dd")" class="form-control form-control-solid" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-8 text-muted mb-1 d-block">@Localizer["Rate type"]</label>
                    <select name="rateType" class="form-select form-select-solid">
                        <option value="Central" selected="@(rateType=="Central")">@Localizer["Central"]</option>
                        <option value="Buy" selected="@(rateType=="Buy")">@Localizer["Buy"]</option>
                        <option value="Sell" selected="@(rateType=="Sell")">@Localizer["Sell"]</option>
                    </select></div>
                <div class="col-md-2"><button class="btn btn-primary w-100"><i class="ki-outline ki-magnifier fs-3"></i>@Localizer["Preview"]</button></div>
            </form>
        </div></div>
        <!--end::Filter-->

        <!--begin::Preview-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-header border-0 pt-6">
                <div class="card-title"><h3>@Localizer["Revaluation preview"]</h3></div>
                <div class="card-toolbar">
                    @if (Model.HasAny)
                    {
                        <form asp-action="PostRevaluation" method="post" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Post revaluation + auto-reversal?"]">@Html.AntiForgeryToken()
                            <input type="hidden" name="asOf" value="@asOf.ToString("yyyy-MM-dd")" /><input type="hidden" name="rateType" value="@rateType" />
                            <button class="btn btn-sm btn-primary"><i class="ki-outline ki-check fs-3"></i>@SR["Post"]</button>
                        </form>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-row-bordered align-middle gy-5 mb-0">
                        <thead class="border-bottom border-gray-200 fs-7 fw-bold text-uppercase text-muted bg-lighten">
                            <tr>
                                <th class="ps-9">@SR["Type"]</th><th>@Localizer["Party"]</th><th class="text-center">@Localizer["Cur"]</th>
                                <th class="text-end">@Localizer["Foreign bal."]</th><th class="text-end">@Localizer["Book base"]</th>
                                <th class="text-center">@Localizer["Closing rate"]</th><th class="text-end">@Localizer["Revalued"]</th><th class="text-end pe-9">@Localizer["Diff"]</th>
                            </tr>
                        </thead>
                        <tbody class="fs-6 fw-semibold text-gray-700">
                        @foreach (var l in Model.Lines)
                        {
                            <tr>
                                <td class="ps-9"><span class="badge badge-light-@(l.PartyType=="AR"?"success":"danger")">@TypeName(l.PartyType)</span></td>
                                <td class="fw-bold text-gray-900">@l.Party</td>
                                <td class="text-center"><span class="badge badge-light fs-8 fw-semibold">@l.CurrencyCode</span></td>
                                <td class="text-end text-gray-800">@Money(l.ForeignOutstanding)</td>
                                <td class="text-end text-muted">@Money(l.BookBase)</td>
                                <td class="text-center">@l.ClosingRate.ToString("0.####")</td>
                                <td class="text-end text-gray-800">@Money(l.RevaluedBase)</td>
                                <td class="text-end pe-9 fw-bold @(l.Diff>=0?"":"text-danger")" style="@(l.Diff>=0?"color:#13433a":"")">@Money(l.Diff)</td>
                            </tr>
                        }
                        @if (!Model.HasAny) { <tr><td colspan="8" class="text-center text-muted py-10">@Localizer["No open foreign balances at this date"]</td></tr> }
                        </tbody>
                        @if (Model.HasAny)
                        {
                            <tfoot><tr class="fw-bolder fs-6 bg-light-primary"><td colspan="7" class="text-end">@Localizer["Net AR / AP diff"]</td>
                                <td class="text-end pe-9 text-primary">@Money(Model.TotalArDiff) / @Money(Model.TotalApDiff)</td></tr></tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
        <!--end::Preview-->

        <!--begin::History-->
        <div class="card">
            <div class="card-header card-header-stretch">
                <div class="card-title"><h3>@Localizer["Past runs"]</h3></div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-row-bordered align-middle gy-5 mb-0">
                        <thead class="border-bottom border-gray-200 fs-7 fw-bold text-uppercase text-muted bg-lighten">
                            <tr><th class="ps-9">#</th><th>@Localizer["As-of"]</th><th class="text-center">@Localizer["Rate"]</th><th class="text-end">@Localizer["AR diff"]</th><th class="text-end">@Localizer["AP diff"]</th><th class="text-center pe-9">@Localizer["JE / Reversal"]</th></tr>
                        </thead>
                        <tbody class="fs-6 fw-semibold text-gray-700">
                        @foreach (var h in history)
                        {
                            <tr><td class="ps-9 fw-bold text-gray-900">@h.ID</td><td class="text-muted fw-semibold">@h.AsOfDate.ToString("yyyy/MM/dd")</td><td class="text-center"><span class="badge badge-light-primary">@h.RateType</span></td>
                                <td class="text-end text-gray-800">@Money(h.TotalArDiff)</td><td class="text-end text-gray-800">@Money(h.TotalApDiff)</td>
                                <td class="text-center pe-9 text-muted fs-7">#@h.JournalEntryId · #@h.ReversalEntryId</td></tr>
                        }
                        @if (history.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10">@Localizer["No runs yet"]</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!--end::History-->
    </div></div>
</div>
