@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("مسارات المندوبين", "Sales-rep routes")</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@L("المخزون", "Inventory")</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@L("المبيعات الميدانية", "Field sales")</li></ul></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Visits","SalesRep")" class="btn btn-light-primary"><i class="ki-outline ki-calendar-tick fs-2"></i>@L("زيارات اليوم", "Today's visits")</a>
            <a href="@Url.Action("RouteEditor","SalesRep")" class="btn btn-primary"><i class="ki-outline ki-plus fs-2"></i>@L("مسار جديد", "New route")</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-7"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@L("بحث (اسم المسار / المندوب)", "Search (route / rep)")</label>
                <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@L("أضف كلمات البحث…", "Add search terms…")" /></div>
            <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@L("الحالة", "Status")</label>
                <select id="f_status" class="form-select form-select-solid cb-filter" data-control="select2" data-hide-search="true"><option value="">@L("الكل", "All")</option><option value="active">@L("نشط", "Active")</option><option value="inactive">@L("موقوف", "Inactive")</option></select></div>
            <div class="col-md-2"><button type="button" id="f_reset" class="btn btn-light w-100"><i class="ki-outline ki-arrows-circle fs-3"></i> @L("مسح", "Reset")</button></div>
        </div></div></div>

        <div class="card card-flush">
            <div class="card-header align-items-center py-4"><div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
                <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap"><select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
            </div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table table-row-bordered align-middle gy-3" id="t">
                <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                    <th>@L("المسار", "Route")</th><th>@L("المندوب", "Rep")</th><th class="text-center">@L("العملاء", "Customers")</th><th class="text-end">@L("الهدف اليومي", "Daily target")</th><th class="text-center">@L("الحالة", "Status")</th><th class="text-end">@L("إجراءات", "Actions")</th>
                </tr></thead>
                <tbody id="rows"></tbody>
            </table></div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ التحميل…", "Loading…")</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@L("لا مسارات مطابقة", "No matching routes")</div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
cbServerList({ url:'@Url.Action("RoutesData","SalesRep")', isAr:@(isAr ? "true" : "false"),
  addParams:function(p){ var s=document.getElementById('f_status'); if(s&&s.value)p.set('active',s.value==='active'?'true':'false'); } });
</script>
}
