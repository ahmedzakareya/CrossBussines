@using CrossBuy.Models.Context.Tasks
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    @* GLOBAL UI RULE: the Inventory module is the only visual authority. Inventory shell, Inventory
       card, Inventory table treatment, Metronic modal. No view-local stylesheet, no invented colour. *@
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    Func<string, string, string> T = (ar, en) => isAr ? ar : en;

    var templates = ViewBag.Templates as List<TaskTemplate> ?? new();
    var employees = ViewBag.Employees as List<(int Id, string Name)> ?? new();
    ViewData["Title"] = T("قوالب المهام", "Task templates");
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
    <div class="page-title d-flex flex-column justify-content-center gap-1">
        <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T("قوالب المهام", "Task templates")</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
            <li class="breadcrumb-item text-muted">@SR["Tasks"]</li>
            <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
            <li class="breadcrumb-item text-muted">@T("القوالب", "Templates")</li>
        </ul>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Tasks/Board" class="btn btn-sm btn-light"><i class="ki-outline ki-element-11 fs-2"></i>@T("اللوحة", "Board")</a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#cbTemplateModal" onclick="cbTemplateNew()">
            <i class="ki-outline ki-plus fs-2"></i>@T("قالب جديد", "New template")
        </button>
    </div>
</div></div>
<!--end::Toolbar-->

<div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

    @* The house notice shape, same as /Tasks/MatchSuggestions and /Accounting/IncomeStatement, built
       from Metronic utilities so there is no hex in this file. The one sentence carried both a fact and
       its consequence, which is exactly the headline/detail split the shape asks for. *@
    <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5">
        <span class="symbol symbol-45px me-5">
            <span class="symbol-label bg-primary"><i class="ki-outline ki-information-5 fs-2x text-white"></i></span>
        </span>
        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                <h4 class="text-gray-900 fw-bold mb-1">@T("مواعيد بنود القالب نسبية", "Template due dates are relative")</h4>
                <div class="fs-6 text-gray-700">@T("كل بند يحمل عدد أيام من تاريخ البدء الذي تختاره، ويتحوّل إلى تاريخ حقيقي عند التطبيق.", "Each item carries a number of days from the start date you choose, and becomes a real date when the template is applied.")</div>
            </div>
            @if (templates.Count > 0)
            {
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0">
                    <i class="ki-outline ki-element-11 fs-6 text-white me-1"></i>@templates.Count @T("قالب", "template(s)")
                </span>
            }
        </div>
    </div>

    @* The house table: a plain card, a titled header, a body with no side padding so the table runs
       edge to edge, ps-9/pe-9 on the outer columns, tabular numerals, and one 2px rule under a muted
       small-caps header row. The count moved into the notice above, where it has a label. *@
    <div class="card">
        <div class="card-header align-items-center">
            <div class="card-title"><h3 class="m-0">@T("القوالب", "Templates")</h3></div>
        </div>
        <div class="card-body px-0 pt-0 pb-4">
            <div class="table-responsive">
                <table class="table table-row-dashed align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                    <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                        <tr class="text-start text-nowrap gs-0" style="border-bottom:2px solid #0E4A9E;">
                            <th class="min-w-200px ps-9">@T("الاسم", "Name")</th>
                            <th class="min-w-80px text-center">@T("البنود", "Items")</th>
                            <th class="min-w-90px text-center">@T("الحالة", "Status")</th>
                            <th class="min-w-400px text-end pe-9">@T("إجراءات", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-700">
                        @if (templates.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-12"><i class="ki-outline ki-element-11 fs-3x mb-3 d-block"></i>@T("لا توجد قوالب بعد", "No templates yet")</td></tr>
                        }
                        @foreach (var tpl in templates)
                        {
                            @* ONE display name per row, used by the cell, by the Apply dialog's title and by
                               the toggle's dialog. Computed here so the three can never disagree - the first
                               version resolved it in the cell only, and the confirmation dialog went on
                               naming the template in Arabic inside an English UI. *@
                            var tplName = (!isAr && !string.IsNullOrWhiteSpace(tpl.NameEn)) ? tpl.NameEn! : tpl.Name;
                            var tplDesc = (!isAr && !string.IsNullOrWhiteSpace(tpl.DescriptionEn)) ? tpl.DescriptionEn! : tpl.Description;
                            <tr>
                                <td class="ps-9">
                                    @* TaskTemplate.NameEn is saved by the service and was never read: the list
                                       printed tpl.Name raw, so an English UI showed Arabic template names under
                                       an English header. Same rule the rest of the module uses - the twin when
                                       there is one, the primary name otherwise. *@
                                    <span class="fw-bold text-gray-900">@tplName</span>
                                    @* The description gets the same treatment as the name. It was the last raw
                                       field on this screen: English names with Arabic descriptions under them. *@
                                    @if (!string.IsNullOrWhiteSpace(tplDesc))
                                    {
                                        <div class="text-muted fs-8">@tplDesc</div>
                                    }
                                </td>
                                @* badge-light-primary, not badge-light-info: info is a Metronic accent that is
                                   not in this product's palette, and it was the loudest thing in the row. *@
                                <td class="text-center"><span class="badge badge-light-primary fs-8 fw-bold">@tpl.Items.Count</span></td>
                                <td class="text-center">
                                    <span class="badge badge-light-@(tpl.IsActive ? "primary" : "secondary") fs-8 fw-bold">
                                        @(tpl.IsActive ? T("نشط", "Active") : T("موقوف", "Inactive"))
                                    </span>
                                </td>
                                @* ONE NOWRAP GROUP, and the two buttons given the same footing.
                                   The row held a date box, a select and two buttons in a 250px column, so
                                   the Apply button was squeezed until its own icon and label wrapped onto
                                   two lines - a different height and width on every row - while the
                                   Deactivate button next to it had no icon at all. The column is wide
                                   enough now, both buttons carry an icon, both are text-nowrap with a
                                   minimum width, and neither may shrink. *@
                                <td class="text-end pe-9">
                                    <div class="d-flex align-items-center justify-content-end gap-2 flex-nowrap">
                                    <form asp-action="TemplateApply" method="post" class="d-flex align-items-center gap-2"
                                          data-cb-confirm data-cb-action="save"
                                          data-cb-title="@T($"تطبيق القالب «{tplName}»؟", $"Apply the template “{tplName}”?")"
                                          data-cb-text="@T("ستُنشأ مهمة لكل بند في القالب، بتواريخ محسوبة من تاريخ البدء المختار.", "One task will be created for every item in the template, with dates counted from the start date you picked.")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tpl.ID" />
                                        @* ACCESSIBLE NAMES, not visible labels. This is a compact per-row
                                           apply form: a <label> above each control would break the inline
                                           layout, and the same visible word would repeat on every row
                                           anyway. aria-label NAMES THE ROW as well as the field, so a
                                           screen-reader user hears "start date for <template>" rather than
                                           the fifth identical "start date" on the page. Appearance is
                                           unchanged — aria-label renders nothing. *@
                                        <input type="date" name="anchorDate" required
                                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                               aria-label="@T($"تاريخ البدء للقالب {tplName}", $"Start date for template {tplName}")"
                                               class="form-control form-control-sm form-control-solid w-140px" />
                                        <select name="assigneeOverride" class="form-select form-select-sm form-select-solid w-160px"
                                                aria-label="@T($"المسؤول للقالب {tplName}", $"Assignee for template {tplName}")">
                                            <option value="">@T("المسؤول الافتراضي", "Default assignee")</option>
                                            @foreach (var e in employees)
                                            {
                                                <option value="@e.Id">@e.Name</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary text-nowrap flex-shrink-0 min-w-100px" @(tpl.IsActive ? "" : "disabled")>
                                            <i class="ki-outline ki-rocket fs-4"></i>@T("تطبيق", "Apply")
                                        </button>
                                    </form>
                                    @* Deactivating is the destructive direction and activating is not, so the two
                                       do not share a colour: light-danger for the one that takes a template out of
                                       use, light-primary for the one that puts it back. *@
                                    @* THE NAME TRAVELS AS A DATA ATTRIBUTE, not as an onclick argument. Passing
                                       it as a JSON string put double quotes inside a double-quoted onclick
                                       attribute, so the attribute ended at the first one: the browser received
                                       `cbTemplateToggle(28, false, ` and reported "Unexpected end of input",
                                       and the button silently did nothing at all. Razor escapes an attribute
                                       value properly, so the name can carry any character. *@
                                    <button type="button" class="btn btn-sm text-nowrap flex-shrink-0 min-w-125px @(tpl.IsActive ? "btn-light-danger" : "btn-light-primary")"
                                            data-tpl-id="@tpl.ID" data-tpl-active="@(tpl.IsActive ? "false" : "true")" data-tpl-name="@tplName"
                                            onclick="cbTemplateToggle(this)">
                                        <i class="ki-outline @(tpl.IsActive ? "ki-cross-circle" : "ki-check-circle") fs-4"></i>@(tpl.IsActive ? T("إيقاف", "Deactivate") : T("تنشيط", "Activate"))
                                    </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div></div>

<div class="modal fade" id="cbTemplateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header py-4">
                <h5 class="modal-title fw-bold">@T("قالب جديد", "New template")</h5>
                <button type="button" class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-2"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-4">
                    @* `for` ATTRIBUTES ADDED. These labels already looked right and were associated with
                       nothing: a label that neither wraps its control nor names it by id is decoration.
                       axe did not report them only because the modal is display:none while closed and
                       hidden nodes are skipped — the defect was real the moment a user opened it. *@
                    @* THREE FIELDS, because the service already stores an English name and nothing could
                       supply one. TaskTemplateService.SaveAsync reads input.NameEn and item.TitleEn, and the
                       modal posted neither - so both columns were dead on arrival and every applied task
                       inherited an Arabic-only title. Optional: no twin means the primary name is used in
                       both languages, which is the documented fallback. *@
                    <div class="col-md-4">
                        <label for="cbTplName" class="form-label required fs-7">@T("اسم القالب", "Template name") <span class="text-muted fs-8">(@T("عربي", "Arabic"))</span></label>
                        <input type="text" id="cbTplName" class="form-control form-control-sm form-control-solid" />
                    </div>
                    <div class="col-md-4">
                        <label for="cbTplNameEn" class="form-label fs-7">@T("الاسم (إنجليزي)", "Name (English)")</label>
                        <input type="text" id="cbTplNameEn" dir="ltr" class="form-control form-control-sm form-control-solid"
                               placeholder="@T("اختياري", "Optional")" />
                    </div>
                    <div class="col-md-4">
                        <label for="cbTplDesc" class="form-label fs-7">@T("الوصف", "Description") <span class="text-muted fs-8">(@T("عربي", "Arabic"))</span></label>
                        <input type="text" id="cbTplDesc" class="form-control form-control-sm form-control-solid" />
                    </div>
                    <div class="col-md-4">
                        <label for="cbTplDescEn" class="form-label fs-7">@T("الوصف (إنجليزي)", "Description (English)")</label>
                        <input type="text" id="cbTplDescEn" dir="ltr" class="form-control form-control-sm form-control-solid"
                               placeholder="@T("اختياري", "Optional")" />
                    </div>
                </div>

                <div class="d-flex flex-stack mb-2">
                    <span class="fw-semibold text-gray-900 fs-7">@T("بنود القالب", "Template items")</span>
                    <button type="button" class="btn btn-sm btn-light-primary" onclick="cbTplAddRow()">
                        <i class="ki-outline ki-plus fs-4"></i>@T("إضافة بند", "Add item")
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-2">
                        <thead>
                            <tr class="fw-bold text-muted fs-8 text-uppercase" style="border-bottom:2px solid #0E4A9E;">
                                <th class="w-40px">#</th>
                                <th class="min-w-180px">@T("العنوان", "Title")</th>
                                <th class="min-w-180px">@T("العنوان (إنجليزي)", "Title (English)")</th>
                                <th class="w-110px">@T("أيام", "Days")</th>
                                <th class="w-120px">@T("الأولوية", "Priority")</th>
                                <th class="w-110px">@T("يعتمد على", "Depends on")</th>
                                <th class="min-w-140px">@T("قائمة تحقق", "Checklist")</th>
                                <th class="w-40px"></th>
                            </tr>
                        </thead>
                        <tbody id="cbTplRows"></tbody>
                    </table>
                </div>
                <div class="text-muted fs-8 mt-2">
                    @T("«يعتمد على» يشير إلى رقم بند آخر في نفس القالب. الحلقات المغلقة مرفوضة.",
                       "\"Depends on\" points at another item number in this same template. Closed loops are refused.")
                </div>
                <div id="cbTplError" class="alert alert-danger py-3 mt-3 d-none fs-7"></div>
            </div>
            <div class="modal-footer py-3">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">@T("إلغاء", "Cancel")</button>
                <button type="button" class="btn btn-sm btn-primary" onclick="cbTemplateSave()">@T("حفظ", "Save")</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        var cbTplSeq = 0;

        function cbTplToken() {
            var t = document.querySelector('input[name="__RequestVerificationToken"]');
            return t ? t.value : '';
        }

        function cbTemplateNew() {
            document.getElementById('cbTplName').value = '';
            document.getElementById('cbTplNameEn').value = '';
            document.getElementById('cbTplDesc').value = '';
            document.getElementById('cbTplDescEn').value = '';
            document.getElementById('cbTplRows').innerHTML = '';
            document.getElementById('cbTplError').classList.add('d-none');
            cbTplSeq = 0;
            cbTplAddRow();
        }

        function cbTplAddRow() {
            cbTplSeq++;
            var n = document.getElementById('cbTplRows').children.length + 1;
            var tr = document.createElement('tr');
            tr.setAttribute('data-cb-row', '1');
            tr.innerHTML =
                // Each generated control is NAMED, and named with its row number, because the visible
                // column header is not associated with a cell's input and every row would otherwise be
                // an identical anonymous textbox. Rows are built here rather than in Razor, so axe never
                // saw them on a static page load - they were unlabelled all the same.
                '<td class="fw-bold text-muted" data-cb-num>' + n + '</td>' +
                '<td><input type="text" class="form-control form-control-sm form-control-solid" data-cb-title aria-label="@T("عنوان البند", "Item title") ' + n + '" /></td>' +
                '<td><input type="text" dir="ltr" class="form-control form-control-sm form-control-solid" data-cb-titleen placeholder="@T("اختياري", "Optional")" aria-label="@T("عنوان البند بالإنجليزية", "Item title in English") ' + n + '" /></td>' +
                '<td><input type="number" class="form-control form-control-sm form-control-solid" data-cb-days value="0" aria-label="@T("أيام الإزاحة للبند", "Offset days for item") ' + n + '" /></td>' +
                '<td><select class="form-select form-select-sm form-select-solid" data-cb-prio aria-label="@T("أولوية البند", "Priority for item") ' + n + '">' +
                    '<option value="Urgent">@T("عاجلة", "Urgent")</option>' +
                    '<option value="High">@T("عالية", "High")</option>' +
                    '<option value="Normal" selected>@T("متوسطة", "Medium")</option>' +
                    '<option value="Low">@T("منخفضة", "Low")</option>' +
                '</select></td>' +
                '<td><input type="number" class="form-control form-control-sm form-control-solid" data-cb-pred placeholder="—" aria-label="@T("يعتمد على البند", "Depends on item") ' + n + '" /></td>' +
                '<td><input type="text" class="form-control form-control-sm form-control-solid" data-cb-check placeholder="@T("افصل بفاصلة", "comma separated")" aria-label="@T("قائمة تحقّق البند", "Checklist for item") ' + n + '" /></td>' +
                // An icon-only button has no text node, so it has no accessible name at all - a screen
                // reader announces "button". The icon is decorative and stays exactly as it is.
                '<td><button type="button" class="btn btn-icon btn-sm btn-light-danger" onclick="cbTplDelRow(this)" aria-label="@T("حذف البند", "Delete item") ' + n + '"><i class="ki-outline ki-trash fs-5" aria-hidden="true"></i></button></td>';
            document.getElementById('cbTplRows').appendChild(tr);
        }

        function cbTplDelRow(btn) {
            btn.closest('tr').remove();
            // Renumber, because "depends on" points at the number the user can SEE. A stale number
            // would silently link the wrong pair.
            var rows = document.querySelectorAll('#cbTplRows tr[data-cb-row]');
            for (var i = 0; i < rows.length; i++) { rows[i].querySelector('[data-cb-num]').textContent = (i + 1); }
        }

        function cbTemplateSave() {
            var err = document.getElementById('cbTplError');
            err.classList.add('d-none');

            var items = [];
            var rows = document.querySelectorAll('#cbTplRows tr[data-cb-row]');
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var title = r.querySelector('[data-cb-title]').value.trim();
                if (!title) { continue; }
                var pred = r.querySelector('[data-cb-pred]').value.trim();
                var check = r.querySelector('[data-cb-check]').value.trim();
                var titleEn = r.querySelector('[data-cb-titleen]').value.trim();
                items.push({
                    Title: title,
                    TitleEn: titleEn === '' ? null : titleEn,
                    SortOrder: i + 1,
                    DueOffsetDays: parseInt(r.querySelector('[data-cb-days]').value || '0', 10),
                    Priority: r.querySelector('[data-cb-prio]').value,
                    PredecessorSortOrder: pred === '' ? null : parseInt(pred, 10),
                    // The service expects one line per checklist entry; the user types them comma-separated.
                    ChecklistLines: check === '' ? null : check.split(',').map(function (s) { return s.trim(); })
                                                               .filter(function (s) { return s.length > 0; }).join('\n')
                });
            }

            var nameEn = document.getElementById('cbTplNameEn').value.trim();
            var descEn = document.getElementById('cbTplDescEn').value.trim();
            var payload = JSON.stringify({
                Name: document.getElementById('cbTplName').value.trim(),
                NameEn: nameEn === '' ? null : nameEn,
                Description: document.getElementById('cbTplDesc').value.trim(),
                DescriptionEn: descEn === '' ? null : descEn,
                IsActive: true,
                Items: items
            });

            var body = new FormData();
            body.append('payload', payload);
            body.append('__RequestVerificationToken', cbTplToken());

            fetch('/Tasks/TemplateSave', { method: 'POST', body: body })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res && res.ok) { location.reload(); }
                    else { err.textContent = (res && res.error) || '@T("تعذّر الحفظ", "Could not save")'; err.classList.remove('d-none'); }
                })
                .catch(function () { err.textContent = '@T("تعذّر الاتصال بالخادم", "Could not reach the server")'; err.classList.remove('d-none'); });
        }

        // ASKS FIRST. This one flipped a template's state on a single click with no confirmation, unlike
        // every other state-changing control in the module.
        //
        // It goes through CB.confirm rather than the declarative data-cb-url route on purpose: that route
        // posts through the helper's own AJAX, which does not attach the anti-forgery token, and
        // TemplateSetActive carries [ValidateAntiForgeryToken]. The dialog is the shared one either way;
        // only the send stays here, where the token already works.
        // REPORTED THROUGH THE DIALOG, not through a toast.
        //
        // CB.toast.error IS reached - traced: `TOAST.error: You do not have permission to perform this
        // action` - and nothing appears on screen: toastr answers `typeof !== 'undefined'` on this layout
        // but never creates its #toast-container, so the message goes nowhere and the button looks dead
        // all over again. Swal is the mechanism this page has already been shown to render (it draws the
        // confirmation a moment earlier), so the refusal is reported with that, and alert() covers the
        // case where neither is loaded. A message the user cannot see is not a message.
        function cbTplShowError(msg) {
            if (window.Swal && Swal.fire) {
                Swal.fire({
                    icon: 'error',
                    title: '@T("لم يتم التنفيذ", "Not done")',
                    text: msg,
                    buttonsStyling: false,
                    confirmButtonText: '@T("حسنًا", "OK")',
                    customClass: { confirmButton: 'btn btn-light', popup: 'cb-swal' }
                });
                return;
            }
            if (window.CB && CB.toast) { CB.toast.error(msg); return; }
            window.alert(msg);
        }

        function cbTemplateToggle(el) {
            var id = el.getAttribute('data-tpl-id');
            var active = el.getAttribute('data-tpl-active');
            var name = el.getAttribute('data-tpl-name') || '';
            var goingActive = (active === 'true');
            // IT REPORTS THE ANSWER. This posted and then reloaded unconditionally, ignoring the {ok,error}
            // the endpoint returns - so when the server REFUSED, the dialog closed, the page reloaded, and
            // the row was unchanged with nothing said. The button looked broken while working exactly as
            // written. Measured: POST /Tasks/TemplateSetActive -> 200
            // {"ok":false,"error":"You do not have permission to perform this action"}.
            var send = function () {
                var body = new FormData();
                body.append('id', id);
                body.append('active', active);
                body.append('__RequestVerificationToken', cbTplToken());
                return fetch('/Tasks/TemplateSetActive', { method: 'POST', body: body })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) {
                        if (res && res.ok) { location.reload(); return; }
                        cbTplShowError((res && res.error) || '@T("تعذّر تغيير حالة القالب", "The template state could not be changed")');
                    })
                    .catch(function () {
                        cbTplShowError('@T("تعذّر الاتصال بالخادم", "Could not reach the server")');
                    });
            };

            var title = goingActive
                ? '@T("تنشيط القالب؟", "Activate the template?")'
                : '@T("إيقاف القالب؟", "Deactivate the template?")';
            var text = (name ? '\u00ab' + name + '\u00bb — ' : '') + (goingActive
                ? '@T("سيصبح القالب متاحًا للتطبيق مرة أخرى.", "The template becomes available to apply again.")'
                : '@T("لن يظهر القالب للتطبيق حتى تنشّطه مرة أخرى. البنود والمهام المنشأة منه لا تتأثر.", "It will not be offered for applying until you activate it again. Its items and any tasks already created from it are untouched.")');

            if (window.CB && CB.confirm) {
                CB.confirm({ type: goingActive ? 'save' : 'reject', title: title, text: text }).then(function (ok) { if (ok) { send(); } });
            }
            else if (window.confirm(title + '\n\n' + text)) { send(); }
        }
    </script>
}
