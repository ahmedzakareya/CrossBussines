@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    @* GLOBAL UI RULE: the Inventory module is the only visual authority. This page lives in the
       Inventory shell and reuses Inventory's cards, filters, toolbar and table — no second design
       language, no bespoke CSS. Reference: Views/Inventory/Items.cshtml. *@
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    Func<string, string, string> T = (ar, en) => isAr ? ar : en;
    var tasks = ViewBag.Tasks as List<TaskRowDto> ?? new();
    var employees = ViewBag.Employees as List<(int Id, string Name)> ?? new();
    var scope = (string)(ViewBag.Scope ?? "mine");
    var running = ViewBag.Running as CrossBuy.BL.RunningTimerDto;
    string curStatus = ViewBag.Status as string; string curPriority = ViewBag.Priority as string; string q = ViewBag.Q as string;
    int? curAssignee = ViewBag.Assignee as int?; string curSort = (ViewBag.Sort as string) ?? "";
    int total = (int)(ViewBag.Total ?? tasks.Count); int pg = (int)(ViewBag.Page ?? 1); int pageSize = (int)(ViewBag.PageSize ?? 25); int pages = (int)(ViewBag.Pages ?? 1);
    ViewData["Title"] = T("إدارة المهام", "Tasks");
    var listAction = scope == "all" ? "All" : "Index";
    var view = (string)(ViewBag.View ?? "all");
    var kpis = ViewBag.Kpis as CrossBuy.BL.TaskKpiDto ?? new();
    var qenc = System.Net.WebUtility.UrlEncode(q ?? "");
    var asg = curAssignee?.ToString() ?? "";
    string Filters() => $"status={curStatus}&priority={curPriority}&q={qenc}&assignee={asg}";
    string PageHref(int p) => $"/Tasks/{listAction}?{Filters()}&view={view}&sort={curSort}&page={p}&pageSize={pageSize}";
    string ViewHref(string v) => $"/Tasks/{listAction}?{Filters()}&view={v}&sort={curSort}";
    string SortHref(string col) { var next = curSort == col ? col + "_desc" : (curSort == col + "_desc" ? "" : col); return $"/Tasks/{listAction}?{Filters()}&view={view}&sort={next}"; }
    string SortMark(string col)
    {
        bool asc = curSort == col; bool desc = curSort == col + "_desc";
        // Inventory language: a single Metronic chevron tinted with a Metronic text utility.
        // No bespoke .sort-ico class, no invented colour.
        if (asc) { return "<i class='ki-outline ki-arrow-up fs-8 text-primary ms-1'></i>"; }
        if (desc) { return "<i class='ki-outline ki-arrow-down fs-8 text-primary ms-1'></i>"; }
        return "<i class='ki-outline ki-arrow-up-down fs-8 text-muted ms-1'></i>";
    }
    var pageNums = new List<int>();   // -1 = ellipsis
    if (pages > 1)
    {
        int win = 2, lo = Math.Max(1, pg - win), hi = Math.Min(pages, pg + win);
        if (lo > 1) { pageNums.Add(1); if (lo > 2) { pageNums.Add(-1); } }
        for (int p = lo; p <= hi; p++) { pageNums.Add(p); }
        if (hi < pages) { if (hi < pages - 1) { pageNums.Add(-1); } pageNums.Add(pages); }
    }

    Func<string, string> pl = p => p switch { "Low" => T("منخفضة", "Low"), "High" => T("عالية", "High"), "Urgent" => T("عاجلة", "Urgent"), _ => T("متوسطة", "Medium") };
    @* PRIORITY IS A RISK RAMP, so it keeps colour - but only where there is risk. Medium is the
       DEFAULT priority and Low is below it: neither is something to flag, and colouring them
       spent the palette on the two values that mean "nothing special". Medium was info, which
       also collided with the In-progress status one column over. *@
    Func<string, string> pc = p => p switch { "Urgent" => "danger", "High" => "warning", _ => "secondary" };
    // The marker rides a solid dot of its family so the mark itself can be white - see the
    // .cb-glyph block in crossbuy-brand.css for the measurements. Urgent keeps its filled
    // triangle; it is a text glyph, and the dot carries it exactly as it carries an icon.
    Func<string, string> priMark = p => p switch
    {
        "Urgent" => "<span class='cb-glyph me-2'></span>",
        "High" => "<span class='cb-glyph me-2'></span>",
        "Low" => "<span class='cb-glyph me-2'></span>",
        _ => "<span class='cb-glyph me-2'></span>"
    };
    Func<string, string> sl = s => s switch { "InProgress" => T("جارية", "In progress"), "Done" => T("مكتملة", "Done"), _ => T("جديدة", "New") };
    @* STATUS: Done is the one positive terminal state, so it keeps success. In progress keeps
       info, which now means ONLY "work in flight". New goes neutral - a task nobody has started
       is the definition of normal, and it was wearing the BRAND colour, which is identity and
       not a state. Overdue overrides all of this with danger, further down. *@
    Func<string, string> sc = s => s switch { "InProgress" => "info", "Done" => "success", _ => "secondary" };
    Func<int, string> progColor = pct => pct >= 100 ? "success" : pct >= 60 ? "primary" : pct >= 30 ? "info" : pct > 0 ? "warning" : "secondary";
    // Metronic design tokens, not invented hex: the ring inherits whatever the brand stylesheet
    // defines for these semantic roles, so it can never drift from the Inventory palette.
    Func<DateTime, string> tfmt = d => isAr ? d.ToString("hh:mm tt", System.Globalization.CultureInfo.GetCultureInfo("ar")) : d.ToString("hh:mm tt");
    (string text, string color) Rem(CrossBuy.BL.TaskRowDto x)
    {
        // correct Arabic number agreement: 3-10 → "أيام/ساعات"، غير كده → "يوم/ساعة"، والمثنى "ساعتان"
        string DayTxt(int n) => $"{n} " + ((n >= 3 && n <= 10) ? "أيام" : "يوم");
        string HourTxt(int n) => n == 1 ? "ساعة" : n == 2 ? "ساعتان" : $"{n} " + ((n >= 3 && n <= 10) ? "ساعات" : "ساعة");
        // FINISHED IS NOT A DANGER. This returned "danger", so the best possible outcome was
        // painted red in every completed row. A finished task has no time left to watch, which
        // is neutral - and its Done badge one column over already carries the good news.
        if (x.Status == "Done") return (T("منتهي", "Finished"), "secondary");
        if (!x.DueDate.HasValue) return ("—", "muted");
        @* The "x hours late / in y days" label is RELATIVE TO NOW, so it changes as wall-clock time
           passes and made this screen the last non-deterministic capture in the certification matrix
           (tasks.ar.desktop drifted 0.77% -> 0.80% between two otherwise identical runs).

           Same fix, and the same reasoning, as the Workspace views already use: the reference instant
           comes from ConformanceClock, which returns DateTime.Now in production and the frozen
           certification instant only on a Development host running with UI_CONFORMANCE=1. The label
           itself is untouched — no dynamic information is removed from the product. *@
        var now2 = CrossBuy.BL.Platform.ConformanceClock.Now; var due = x.DueDate.Value;
        if (due < now2)
        {
            var late = now2 - due;
            if (late.TotalHours < 24) { int h = Math.Max(1, (int)Math.Ceiling(late.TotalHours)); return (T($"{HourTxt(h)} late", $"{h}h late"), "danger"); }
            int d = (int)Math.Ceiling(late.TotalDays); return (T($"{DayTxt(d)} late", $"-{d}d late"), "danger");
        }
        var hrs = (due - now2).TotalHours;
        if (hrs < 24) { int h = (int)Math.Ceiling(hrs); return (T(HourTxt(h), $"{h}h"), "warning"); }
        int days = (int)Math.Ceiling(hrs / 24);
        return (T(DayTxt(days), $"{days}d"), days <= 3 ? "warning" : "success");
    }
    Func<string, string> initials = n => { n = (n ?? "").Trim(); if (n.Length == 0) return "—"; var parts = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : n.Substring(0, Math.Min(2, n.Length)); };
    Func<string, string> photoSrc = p => string.IsNullOrWhiteSpace(p) ? Url.Content("~/Backend-assets/media/svg/avatars/blank.svg") : Url.Content("~" + p.Replace("\\", "/"));

    // KPI cards, listed end→start (RTL) so «الإجمالي» sits far-left and «مكتملة» sits next to the search — matches the mockup.
    // Inventory language: Metronic SEMANTIC colours (success/info/warning/danger/primary) via
    // bg-light-* / text-* utilities. No invented hex, no bespoke .kpi-* classes.
    var kpiCards = new[] {
        (key: "done",       cls: "success", label: T("مكتملة", "Done"),         val: kpis.Done,       icon: "ki-check-circle"),
        (key: "inprogress", cls: "info",    label: T("جارية", "In progress"),   val: kpis.InProgress, icon: "ki-timer"),
        @* DANGER, to match the ROW. An overdue row is painted danger in the table below; this card
           called the same fact warning, so one screen gave one fact two colours. Two danger cards
           is the honest result - overdue and urgent both demand attention - and agreeing with the
           table matters more than spreading the palette around. *@
        (key: "overdue",    cls: "danger",  label: T("متأخرة", "Overdue"),      val: kpis.Overdue,    icon: "ki-time"),
        (key: "urgent",     cls: "danger",  label: T("عاجلة", "Urgent"),        val: kpis.Urgent,     icon: "ki-information-5"),
        (key: "all",        cls: "primary", label: T("إجمالي المهام", "Total"), val: kpis.Total,      icon: "ki-calendar"),
    };
    Func<CrossBuy.BL.TaskRowDto, string> dotColor = x => (x.IsOverdue && x.Status != "Done") ? "danger" : x.Status == "Done" ? "success" : x.Status == "InProgress" ? "info" : "primary";
}



<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
    <div class="page-title d-flex flex-column justify-content-center gap-1">
        <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T("إدارة المهام", "Tasks")</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
            <li class="breadcrumb-item text-muted">@SR["Tasks"]</li>
            <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
            <li class="breadcrumb-item text-muted">@(scope == "all" ? T("كل المهام", "All tasks") : T("مهامي", "My tasks"))</li>
        </ul>
    </div>
    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#taskModal" onclick="cbTaskNew()">
        <i class="ki-outline ki-plus fs-2"></i>@T("مهمة جديدة", "New task")
    </button>
</div></div>
<!--end::Toolbar-->

<div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
    @* The instant is pinned to UTC before any conversion. The column holds UTC (StartAsync writes
       DateTime.UtcNow) but EF hands it back Kind=Unspecified, so ToUniversalTime() used to add the
       local offset a second time - the bar read 6h for a timer that had run 3h11m. SpecifyKind on a
       value that is already Utc is a no-op, so this and the service fix cannot compound. *@
    @if (running != null)
    {
        @* THE HOUSE NOTICE, in brand. Same shape as Blocked and Escalated on /Tasks/Detail:
           dashed border, icon tile, heading, body. A running timer is a state of this screen,
           not an alert, and it is an ACTIVE state - so brand, not danger. *@
        <div class="notice d-flex align-items-center bg-light-primary rounded border-primary border border-dashed p-4 mb-5">
            <span class="symbol symbol-40px me-4"><span class="symbol-label bg-primary">
                <i class="ki-outline ki-time fs-2 text-white"></i></span></span>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-4">
                <div class="fw-semibold pe-5 min-w-0">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="text-gray-900 fw-bold m-0">@T("المؤقّت شغّال", "Timer running")</h4>
                        @* THE LIVE CUE. Without it a running timer and a stopped one differ only by a
                           seconds field nobody is watching. Reduced motion turns it into a fade. *@
                        <span class="cb-live-dot bg-primary rounded-circle"></span>
                    </div>
                    <div class="fs-6 text-gray-700 text-truncate" title="@running.TaskTitle">@running.TaskTitle</div>
                </div>
                @* A hairline groups the right-hand side. Logical border, so it lands on the reading
                   edge in both directions. *@
                <div class="d-flex align-items-center gap-5 flex-shrink-0 ps-5 cb-timer-sep">
                    @* ELAPSED, AND IT SAYS SO. "3:01:14" reads as easily as a wall clock; written
                       units cannot. The units live HERE so they are localised - the ticker writes
                       digits only, which is also why it needs to know nothing about the language.

                       The instant is emitted as ISO-8601 UTC ("o") and the browser counts from it,
                       so this needs no polling and cannot drift with the server clock.

                       dir + isolate on every digit run: they sit inside Arabic text, which is the
                       shape that reorders. tabular-nums so the row does not shift on each tick. *@
                    <div class="d-flex flex-column align-items-start">
                        <div class="cb-elapsed d-flex align-items-baseline gap-1"
                             data-since="@DateTime.SpecifyKind(running.StartedAt, DateTimeKind.Utc).ToString("o")">
                            @* The hours pair is hidden below an hour - "0 h" is noise for the first
                               hour of every timer. Hidden as a PAIR so a unit never sits alone. *@
                            <span class="cb-el-hpair align-items-baseline gap-1">
                                <span class="cb-el-h fs-2hx fw-bold text-primary" dir="ltr"
                                      style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">0</span>
                                <span class="fs-4 fw-semibold text-primary opacity-75">@T("س", "h")</span>
                            </span>
                            <span class="cb-el-m fs-2hx fw-bold text-primary ms-3" dir="ltr"
                                  style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">00</span>
                            <span class="fs-4 fw-semibold text-primary opacity-75">@T("د", "m")</span>
                            @* The seconds ride along small: nobody logs work to the second, and a
                               ticking 32px field is the loudest thing on the screen. *@
                            <span class="cb-el-s fs-6 fw-semibold text-primary opacity-75 ms-2" dir="ltr"
                                  style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">00</span>
                            <span class="fs-8 fw-semibold text-primary opacity-75">@T("ث", "s")</span>
                        </div>
                        @* SINCE WHEN, on the page. It was on a title attribute - invisible on a touch
                           device and to anyone scanning - and it is what names the big number. *@
                        <div class="fs-8 text-muted" title="@DateTime.SpecifyKind(running.StartedAt, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm")">
                            @T("منقضي منذ", "elapsed since")
                            <span dir="ltr" style="unicode-bidi:isolate">@DateTime.SpecifyKind(running.StartedAt, DateTimeKind.Utc).ToLocalTime().ToString("HH:mm")</span>
                        </div>
                    </div>
                    <form asp-action="StopTimer" method="post" class="m-0">@Html.AntiForgeryToken()<input type="hidden" name="scope" value="@scope" />
                        @* RED AND FLAT, as asked. btn-danger is already the brand red with a measured
                           white label (white on #DC2626, 4.83 PASS), so no new colour enters here -
                           cb-btn-flat only removes the lift. *@
                        <button type="submit" class="btn btn-sm btn-danger cb-btn-flat text-nowrap">
                            <i class="ki-outline ki-cross-circle fs-5"></i>@T("إيقاف وتسجيل", "Stop & log")</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @* The clock turns once every two seconds - slow enough not to pull the eye away from the
   list, fast enough to read as "running". prefers-reduced-motion switches it to a quiet
   pulse, because a permanently spinning element is exactly what that setting exists for. *@
<style>
    /* Every declaration below either consumes a token through var() or sets a non-colour
       property - nothing here DEFINES a colour, a typeface or a custom property, which is what
       the conformance gate on inline <style> actually forbids. */
    .cb-timer-sep { border-inline-start: 1px solid var(--bs-primary); }
    .cb-btn-flat { box-shadow: none !important; }
    .cb-el-hpair { display: none; }
    .cb-el-hpair.is-on { display: inline-flex; }
    .cb-live-dot { width: 8px; height: 8px; animation: cbLiveDot 1.6s ease-in-out infinite; }
    @@keyframes cbLiveDot { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
    @@keyframes cbTimerSpin { to { transform: rotate(360deg); } }
    .cb-timer-spin { display: inline-block; animation: cbTimerSpin 2s linear infinite; }
    @@media (prefers-reduced-motion: reduce) {
        @@keyframes cbTimerPulse { 50% { opacity: .35; } }
        .cb-timer-spin { animation: cbTimerPulse 1.6s ease-in-out infinite; }
        /* The dot stops moving but stays visible: it is the only thing that says "running". */
        .cb-live-dot { animation: none; opacity: .85; }
    }
</style>
<script>
(function () {
    // One interval for the page, however many badges there are - so this already works
    // unchanged if several timers are ever allowed to run at once.
    function paint() {
        var now = Date.now();
        document.querySelectorAll(".cb-elapsed").forEach(function (el) {
            // DIGITS ONLY. The units are markup, written by the view in the reader's language, so
            // this function carries no strings to translate and cannot disagree with the labels.
            var put = function (sel, v) { var x = el.querySelector(sel); if (x) x.textContent = v; };
            var t0 = Date.parse(el.getAttribute("data-since"));
            if (isNaN(t0)) { put(".cb-el-h", "--"); put(".cb-el-m", "--"); put(".cb-el-s", "--"); return; }
            var s = Math.floor((now - t0) / 1000);
            if (s < 0) s = 0;                      // clock skew reads as zero, never negative
            var p = function (n) { return (n < 10 ? "0" : "") + n; };
            // Hours are NOT folded into days: "51 h 20 m" is unambiguous, and a fourth unit slot
            // would sit empty almost always.
            var h = Math.floor(s / 3600);
            put(".cb-el-h", h);
            // Show the hours only once there are any. The unit is markup, so this toggles a class
            // and never has to know the language.
            var hp = el.querySelector(".cb-el-hpair");
            if (hp) hp.classList.toggle("is-on", h > 0);
            put(".cb-el-m", p(Math.floor((s % 3600) / 60)));
            put(".cb-el-s", p(s % 60));
        });
    }
    paint();
    setInterval(paint, 1000);
})();
</script>

<form method="get" asp-action="@listAction" id="taskFilterForm">
        <input type="hidden" name="view" value="@view" />
        <input type="hidden" name="sort" value="@curSort" />

        <!--begin::KPI + search row-->
        <div class="d-flex flex-stack flex-wrap gap-4 mb-5">
            <!--search + quick-filter (appears on the right in RTL)-->
            <div class="d-flex align-items-center gap-3 order-1">
                <div class="position-relative">
                    <i class="ki-outline ki-magnifier fs-3 text-gray-500 position-absolute top-50 translate-middle-y ms-4"></i>
                    <input type="text" name="q" value="@q" class="form-control form-control-solid w-250px ps-12 rounded-pill" placeholder="@T("بحث عن مهمة...", "Search tasks...")" />
                </div>
                <button type="submit" class="btn btn-icon btn-light border" title="@T("تطبيق الفلاتر", "Apply filters")"><i class="ki-outline ki-filter fs-2"></i></button>
            </div>
            <!--KPI stat cards (fill the left)-->
            <div class="d-flex flex-wrap gap-3 order-2">
                @foreach (var k in kpiCards)
                {
                    <a href="@ViewHref(k.key)" class="card card-flush text-decoration-none @(view == k.key ? "border border-2 border-" + k.cls : "")" style="min-width:165px">
                        <div class="card-body d-flex align-items-center justify-content-between py-3 px-4">
                            <span class="symbol symbol-40px me-3"><span class="symbol-label bg-light-@k.cls"><i class="ki-outline @k.icon fs-2 text-@k.cls"></i></span></span>
                            <span class="d-flex flex-column text-end">
                                <span class="fs-2 fw-bold text-gray-900">@k.val</span>
                                <span class="fs-7 fw-semibold text-muted">@k.label</span>
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>
        <!--end::KPI + search row-->

        <!--begin::Filter dropdowns + tabs row-->
        <div class="d-flex flex-stack flex-wrap gap-3 mb-4">
            <!--tabs (right in RTL)-->
            <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-6 fw-semibold flex-nowrap order-1">
                <li class="nav-item"><a class="nav-link @(view == "all" ? "active" : "") text-nowrap px-4" href="@ViewHref("all")">@T("الكل", "All")</a></li>
                <li class="nav-item"><a class="nav-link @(view == "urgent" ? "active" : "") text-nowrap px-4" href="@ViewHref("urgent")">@T("عاجلة", "Urgent")</a></li>
                <li class="nav-item"><a class="nav-link @(view == "overdue" ? "active" : "") text-nowrap px-4" href="@ViewHref("overdue")">@T("متأخرة", "Overdue")</a></li>
                <li class="nav-item"><a class="nav-link @(view == "inprogress" ? "active" : "") text-nowrap px-4" href="@ViewHref("inprogress")">@T("جارية", "In progress")</a></li>
                <li class="nav-item"><a class="nav-link @(view == "done" ? "active" : "") text-nowrap px-4" href="@ViewHref("done")">@T("مكتملة", "Done")</a></li>
            </ul>
            <!--dropdowns + advanced (left in RTL)-->
            <div class="d-flex flex-wrap align-items-center gap-2 order-2">
                @* Each select sits in a fixed-width box: the Inventory shell auto-applies select2, which renders at
                   width:100% and would otherwise stack these filters vertically (overlapping the KPI cards). The
                   wrapper pins the width so they stay on one row. *@
                <div class="w-160px">
                    <select name="assignee" onchange="this.form.submit()" class="form-select form-select-sm text-gray-700 bg-white">
                        <option value="">@T("كل المسؤولين", "All assignees")</option>
                        @foreach (var e in employees)
                        {
                            <option value="@e.Id" selected="@(curAssignee == e.Id)">@e.Name</option>
                        }
                    </select>
                </div>
                <div class="w-140px">
                    <select name="status" onchange="this.form.submit()" class="form-select form-select-sm text-gray-700 bg-white">
                        <option value="">@T("كل الحالات", "All statuses")</option>
                        <option value="New" selected="@(curStatus == "New")">@sl("New")</option>
                        <option value="InProgress" selected="@(curStatus == "InProgress")">@sl("InProgress")</option>
                        <option value="Done" selected="@(curStatus == "Done")">@sl("Done")</option>
                    </select>
                </div>
                <div class="w-140px">
                    <select name="priority" onchange="this.form.submit()" class="form-select form-select-sm text-gray-700 bg-white">
                        <option value="">@T("كل الأولويات", "All priorities")</option>
                        <option value="Urgent" selected="@(curPriority == "Urgent")">@pl("Urgent")</option>
                        <option value="High" selected="@(curPriority == "High")">@pl("High")</option>
                        <option value="Normal" selected="@(curPriority == "Normal")">@pl("Normal")</option>
                        <option value="Low" selected="@(curPriority == "Low")">@pl("Low")</option>
                    </select>
                </div>
                <a asp-action="@listAction" class="btn btn-sm bg-white border text-gray-700 d-flex align-items-center text-nowrap"><i class="ki-outline ki-setting-4 fs-4 me-1"></i>@T("تصفية متقدمة", "Advanced")</a>
            </div>
        </div>
        <!--end::Filter dropdowns + tabs row-->
    </form>

    <!--begin::Results card-->
    @* ---- THE RESULTS TABLE ---------------------------------------------------------------------
       Brought into line with /Accounting/IncomeStatement, which is the house pattern for a data table:
       a plain `card` with a titled `card-header card-header-stretch`, a `card-body px-0` so the table
       runs edge to edge instead of floating inside 2rem of padding, `ps-9`/`pe-9` on the outer columns,
       tabular numerals so dates and percentages line up down their columns, and the header row carrying
       ONE 2px rule underneath it.

       THE HEADER ROW WAS A CAGE. `border-bottom border-2 border-primary` reads as "a 2px primary bottom
       border" and is not: `border-bottom` sets only the bottom WIDTH, while `border-2` sets the width on
       all four sides and `border-primary` the colour on all four. Every th came out boxed in 2px of brand
       green - measured 2px solid rgb(14,74,158) on top, bottom, inline-start and inline-end - so the whole
       thead rendered as a caged strip floating inside the card. The reference states the rule once, on
       the thead itself, which is what is used here.
    *@
    <div class="card">
        <div class="card-header card-header-stretch">
            <div class="card-title">
                <h3 class="m-0">@(scope == "all" ? T("كل المهام", "All tasks") : T("مهامي", "My tasks"))</h3>
            </div>
            @* THE BARE COUNT IS GONE FROM HERE ON PURPOSE. It was a naked "51" with no label, and
               card-header-stretch aligns a toolbar to the TOP of the header rather than to the title's
               line, so it floated above "My tasks" in the corner. The same number is already stated
               properly under the table - "Page 1 / 3 . 51 task(s)" - where it has a label and the page
               context that makes it mean something. Repeating it unlabelled here added nothing. *@
        </div>
        <div class="card-body px-0 pt-0 pb-4">
            <div class="table-responsive">
                <table class="table table-row-dashed align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                    <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                        <tr class="text-start text-nowrap gs-0" style="border-bottom:2px solid #0E4A9E;">
                            <th class="min-w-100px ps-9">@T("المسؤول", "Assignee")</th>
                            <th class="min-w-175px">@T("المهمة", "Task")</th>
                            <th class="min-w-70px"><a href="@SortHref("priority")" class="text-muted text-hover-primary text-nowrap">@T("الأولوية", "Priority") @Html.Raw(SortMark("priority"))</a></th>
                            <th class="min-w-70px"><a href="@SortHref("status")" class="text-muted text-hover-primary text-nowrap">@T("الحالة", "Status") @Html.Raw(SortMark("status"))</a></th>
                            <th class="min-w-100px"><a href="@SortHref("progress")" class="text-muted text-hover-primary text-nowrap">@T("التقدم", "Progress") @Html.Raw(SortMark("progress"))</a></th>
                            <th class="min-w-75px"><a href="@SortHref("due")" class="text-muted text-hover-primary text-nowrap">@T("الموعد النهائي", "Due date") @Html.Raw(SortMark("due"))</a></th>
                            <th class="min-w-75px"><a href="@SortHref("due")" class="text-muted text-hover-primary text-nowrap">@T("الوقت المتبقي", "Time left") @Html.Raw(SortMark("due"))</a></th>
                            <th class="text-end min-w-50px pe-9">@T("إجراءات", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-700">
                        @if (!tasks.Any())
                        {
                            <tr><td colspan="8" class="text-center text-muted py-12"><i class="ki-outline ki-abstract-26 fs-3x mb-3 d-block"></i>@T("لا توجد مهام.", "No tasks yet.")</td></tr>
                        }
                        @foreach (var t in tasks)
                        {
                            var links = ViewBag.Links as Dictionary<int, CrossBuy.BL.TaskLinkDto>;
                            CrossBuy.BL.TaskLinkDto link = null; links?.TryGetValue(t.Id, out link);
                            var stColor = (t.IsOverdue && t.Status != "Done") ? "danger" : sc(t.Status);
                            var stText = (t.IsOverdue && t.Status != "Done") ? T("متأخرة", "Overdue") : sl(t.Status);
                            var rem = Rem(t);
                            <tr>
                                <td class="ps-9">
                                    <div class="d-flex align-items-center">
                                        <div class="symbol symbol-35px symbol-circle me-2 position-relative">
                                            @if (!string.IsNullOrWhiteSpace(t.AssigneePhoto))
                                            { <img src="@photoSrc(t.AssigneePhoto)" alt="@t.AssigneeName" /> }
                                            else
                                            { <span class="symbol-label bg-light-primary text-primary fw-bold">@initials(t.AssigneeName)</span> }
                                        </div>
                                        @* NO max-width HERE. These two were clamped to 80px inside a column
                                           measuring 134px, so every name was cut with an ellipsis while a
                                           third of the column stood empty. text-truncate with min-width:0 on
                                           the flex parent already ellipsizes at the COLUMN's edge, which is
                                           the width the header reserved for it. *@
                                        <div class="d-flex flex-column" style="min-width:0;">
                                            <span class="text-gray-900 fw-bold fs-7 text-truncate d-block">@t.AssigneeName</span>
                                            @if (!string.IsNullOrWhiteSpace(t.AssigneeJobTitle)) { <span class="text-muted fw-semibold fs-8 text-truncate d-block">@t.AssigneeJobTitle</span> }
                                        </div>
                                    </div>
                                </td>
                                @* max-width:0 IS THE CONSTRAINT, and it is not a typo. In an auto-layout
                                   table a cell grows to fit its content, so lifting the 105px cap off the
                                   title made this column 890px wide and pushed the table 300px past its
                                   own scroll box. max-width:0 tells the layout this column may be as narrow
                                   as it likes: the other seven take their content width, this one absorbs
                                   whatever is left of the 100% table, and the title ellipsizes exactly at
                                   that edge. The width is decided by the table, not by a magic number. *@
                                <td style="max-width:0;">
                                    @* THE WORST OF IT: the title was capped at 105px inside a column 455px
                                       wide, so every row read as an ellipsis while two thirds of the column
                                       sat empty. The cap is gone; min-width:0 on the row and flex-grow on
                                       the link let the title use the column and ellipsize at ITS edge. *@
                                    <div class="d-flex align-items-center mb-2" style="min-width:0;">
                                        @* THE LIST SAYS WHICH TASK IS BEING TIMED. Before, only the bar at the
                                           top did, so a row gave no sign its timer was running. The clock spins
                                           while the entry is open and stops existing when it is stopped. *@
                                        @if (running != null && running.TaskId == t.Id)
                                        {
                                            <i class="ki-outline ki-timer fs-5 text-primary me-1 cb-timer-spin"
                                               title="@T("المؤقّت شغّال", "Timer running")"></i>
                                        }
                                        @* OPENS THE TASK. This was href="javascript:;" with no handler bound to it,
                                           so the list had no route to /Tasks/Detail - and Detail is where the Activity
                                           tab (the platform timeline for this task) and the comments live. The Board
                                           view already linked it; the list simply never did. *@
                                        <a href="@Url.Action("Detail", "Tasks", new { id = t.Id })"
                                           class="text-gray-900 fw-bold text-hover-primary fs-7 text-truncate flex-grow-1"
                                           title="@T("فتح المهمة والنشاط", "Open task and activity")">@t.Title</a>
                                    </div>
                                    <div class="d-flex align-items-center flex-wrap gap-2 ms-4">
                                        @if (t.IsScheduled && !t.MatchedAt.HasValue)
                                        {
                                            <span class="badge badge-light-primary fw-semibold"><i class="ki-outline ki-calendar fs-8 me-1"></i>@T("مجدولة", "Scheduled"): @(t.ExpectedEntityType == "PurchaseInvoice" ? T("مشتريات", "Purchase") : T("مبيعات", "Sales"))@(string.IsNullOrEmpty(t.ExpectedPartyName) ? "" : " — " + t.ExpectedPartyName)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(t.Category))
                                        {
                                            <span class="badge badge-light text-gray-600 fw-semibold"><i class="ki-outline ki-tag fs-8 me-1"></i>@t.Category</span>
                                        }
                                        @if (link != null)
                                        {
                                            if (!string.IsNullOrEmpty(link.Url))
                                            {
                                                <a href="@link.Url" target="_blank" class="badge badge-light-primary text-hover-primary"><i class="@link.Icon fs-8 me-1"></i>@link.Label <i class="ki-outline ki-exit-right-corner fs-8 ms-1"></i></a>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light-primary"><i class="@link.Icon fs-8 me-1"></i>@link.Label</span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td><span class="badge badge-light-@pc(t.Priority) fs-7 fw-bold py-2 d-inline-flex align-items-center">@Html.Raw(priMark(t.Priority))@pl(t.Priority)</span></td>
                                <td><span class="badge badge-light-@stColor fs-7 fw-bold py-2 d-inline-flex align-items-center"><span class="cb-glyph me-2"></span>@stText</span></td>
                                <td>
                                    @* A BAR, NOT A RING. This is a column, and a column is for comparing
                                       rows - a fixed-width bar starting on the same edge every time can be
                                       scanned, twelve rings cannot. Colour says FINISHED or not; the length
                                       already says how much, so it does not need saying twice. *@
                                    @{ var _tone = t.ProgressPct >= 100 ? "success" : "primary"; }
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress h-6px bg-light-@_tone flex-shrink-0" style="width:64px"
                                             role="progressbar" aria-valuenow="@t.ProgressPct"
                                             aria-valuemin="0" aria-valuemax="100"
                                             aria-label="@T("التقدم", "Progress")">
                                            <div class="progress-bar bg-@_tone" style="width:@t.ProgressPct%"></div>
                                        </div>
                                        @* dir + isolate because "40%" is a numeric run inside an RTL row, and
                                           tabular figures so the column does not shift as the digits change. *@
                                        <span class="fs-8 fw-semibold @(t.ProgressPct > 0 ? "text-gray-800" : "text-muted")"
                                              dir="ltr" style="unicode-bidi:isolate;font-variant-numeric:tabular-nums">@(t.ProgressPct)%</span>
                                    </div>
                                </td>
                                <td>
                                    @if (t.DueDate.HasValue)
                                    {
                                        <div class="d-flex flex-column">
                                            <span class="text-gray-800 fw-semibold fs-7">@t.DueDate.Value.ToString("yyyy-MM-dd")</span>
                                            <span class="text-muted fs-8">@tfmt(t.DueDate.Value)</span>
                                        </div>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td>
                                    @if (rem.color == "muted") { <span class="text-muted">@rem.text</span> }
                                    else { <span class="badge badge-light-@rem.color fw-bold py-2 d-inline-flex align-items-center"><span class="cb-glyph me-2"></span>@rem.text</span> }
                                </td>
                                <td class="text-end pe-9">
                                    <!--begin::Actions kebab-->
                                    @* ACCESSIBLE NAME, NAMED BY ROW. The trigger is icon-only, so it had no
                                       accessible name at all — a screen reader announced "button" twenty-five
                                       times per page. `@SR["Actions"]` is the EXISTING shared vocabulary
                                       (ar "Actions", en "Actions", fr "Actions"), not a new string, and the
                                       task title is appended so the twenty-five triggers are distinguishable
                                       from one another rather than being twenty-five identical "Actions".
                                       aria-haspopup states what the control actually does — it opens a menu —
                                       which is true of the Metronic trigger already; it changes no behaviour.
                                       The glyph is decorative and is hidden from the accessibility tree so it
                                       cannot be read out as stray characters. No visible text added. *@
                                    <button type="button" class="btn btn-sm btn-icon btn-light btn-active-light-primary border"
                                            data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end"
                                            aria-haspopup="true"
                                            aria-label="@SR["Actions"] — @t.Title">
                                        <i class="ki-outline ki-dots-vertical fs-2" aria-hidden="true"></i>
                                    </button>
                                    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-700 menu-state-bg-light-primary fw-semibold fs-7 w-200px py-3" data-kt-menu="true">
                                        @* THE READ VIEW COMES FIRST, and above the separator that starts the
                                           actions: everything below this writes something. It was the one
                                           entry missing, which is why a page with every fact on it could not
                                           be reached from the list at all. *@
                                        <div class="menu-item px-3">
                                            <a class="menu-link px-3" href="/Tasks/Summary/@t.Id">
                                                <i class="ki-outline ki-clipboard fs-6 me-2"></i>@T("الملخّص", "Summary")</a>
                                        </div>
                                        <div class="separator my-2"></div>
                                        <form asp-action="ChangeStatus" method="post">
                                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><input type="hidden" name="scope" value="@scope" />
                                            @if (t.Status == "New")
                                            {
                                                <div class="menu-item px-3"><button name="status" value="InProgress" class="menu-link px-3 w-100 text-start bg-transparent border-0" data-cb-confirm data-cb-action="generic" data-cb-title="@T("بدء المهمة؟", "Start task?")"><i class="ki-outline ki-arrow-right fs-6 me-2"></i>@T("ابدأ", "Start")</button></div>
                                                <div class="menu-item px-3"><button name="status" value="Done" class="menu-link px-3 w-100 text-start bg-transparent border-0" data-cb-confirm data-cb-action="approve" data-cb-title="@T("إنهاء المهمة؟", "Finish task?")"><i class="ki-outline ki-check fs-6 me-2"></i>@T("إنهاء", "Finish")</button></div>
                                            }
                                            else if (t.Status == "InProgress")
                                            {
                                                <div class="menu-item px-3"><button name="status" value="Done" class="menu-link px-3 w-100 text-start bg-transparent border-0" data-cb-confirm data-cb-action="approve" data-cb-title="@T("إنهاء المهمة؟", "Finish task?")"><i class="ki-outline ki-check fs-6 me-2"></i>@T("إنهاء", "Finish")</button></div>
                                            }
                                            else
                                            {
                                                <div class="menu-item px-3"><button name="status" value="InProgress" class="menu-link px-3 w-100 text-start bg-transparent border-0" data-cb-confirm data-cb-action="generic" data-cb-title="@T("إعادة فتح المهمة؟", "Reopen task?")"><i class="ki-outline ki-arrow-circle-left fs-6 me-2"></i>@T("إعادة فتح", "Reopen")</button></div>
                                            }
                                        </form>
                                        @if (running != null && running.TaskId == t.Id)
                                        {
                                            <form asp-action="StopTimer" method="post">@Html.AntiForgeryToken()<input type="hidden" name="scope" value="@scope" />
                                                <div class="menu-item px-3"><button type="submit" class="menu-link px-3 w-100 text-start bg-transparent border-0 text-danger"><i class="ki-outline ki-cross-circle fs-6 me-2"></i>@T("إيقاف المؤقّت", "Stop timer")</button></div>
                                            </form>
                                        }
                                        else if (t.Status != "Done")
                                        {
                                            <form asp-action="StartTimer" method="post">@Html.AntiForgeryToken()<input type="hidden" name="taskId" value="@t.Id" /><input type="hidden" name="scope" value="@scope" />
                                                <div class="menu-item px-3"><button type="submit" class="menu-link px-3 w-100 text-start bg-transparent border-0"><i class="ki-outline ki-time fs-6 me-2"></i>@T("تشغيل المؤقّت", "Start timer")</button></div>
                                            </form>
                                        }
                                        <div class="menu-item px-3"><a class="menu-link px-3" href="javascript:;" onclick='cbOpenTimesheet(@t.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(t.Title)))'><i class="ki-outline ki-timer fs-6 me-2"></i>@T("سجل الوقت", "Timesheet")</a></div>
                                        <div class="menu-item px-3"><a class="menu-link px-3" href="javascript:;" data-bs-toggle="modal" data-bs-target="#taskModal" onclick='cbTaskEdit(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { id = t.Id, title = t.TitleAr, titleEn = t.TitleEn, description = t.Description, assignee = t.AssigneeEmployeeId, priority = t.Priority, due = t.DueDate?.ToString("yyyy-MM-dd"), est = t.EstimatedHours, progress = t.ProgressPct, category = t.Category, entityType = t.EntityType, entityId = t.EntityId, entityLabel = (link?.Label), isBillable = t.IsBillable, billRate = t.BillRate, customerId = t.CustomerId, customerName = t.CustomerName, isScheduled = t.IsScheduled, expType = t.ExpectedEntityType, expPartyId = t.ExpectedPartyId, expPartyName = t.ExpectedPartyName, expFrom = t.ExpectedFrom?.ToString("yyyy-MM-dd"), expTo = t.ExpectedTo?.ToString("yyyy-MM-dd") })))'><i class="ki-outline ki-pencil fs-6 me-2"></i>@T("تعديل", "Edit")</a></div>
                                        <div class="separator my-2"></div>
                                        <form asp-action="Delete" method="post" data-cb-confirm data-cb-action="delete">
                                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><input type="hidden" name="scope" value="@scope" />
                                            <div class="menu-item px-3"><button type="submit" class="menu-link px-3 w-100 text-start bg-transparent border-0 text-danger"><i class="ki-outline ki-trash fs-6 me-2"></i>@T("حذف", "Delete")</button></div>
                                        </form>
                                    </div>
                                    <!--end::Actions kebab-->
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-stack flex-wrap pt-5">
                <div class="fs-7 text-muted">@T("صفحة", "Page") @pg / @pages · @total @T("مهمة", "task(s)")</div>
                @if (pages > 1)
                {
                    @* PAGINATION ACCESSIBLE NAMES. Both arrows were glyph-only anchors, so their entire
                       accessible name was empty. `@SR["Previous"]`/`@SR["Next"]` are the EXISTING shared
                       vocabulary (ar "Previous"/"Next", en, fr) — no new strings.

                       The ARROW DIRECTION FLIPS in RTL and the NAME MUST NOT: in Arabic "previous" is the
                       right-pointing glyph, so naming by glyph would tell an Arabic screen-reader user the
                       opposite of what the link does. The name is bound to the ACTION (pg-1 / pg+1), which
                       is direction-independent; only the icon mirrors.

                       The "…" gap is a real anchor with visible text but no destination — it is marked
                       aria-hidden and removed from the tab order so it is not offered as a link that goes
                       nowhere. href, classes, disabled state and behaviour are untouched. *@
                    <ul class="pagination">
                        <li class="page-item @(pg == 1 ? "disabled" : "")"><a class="page-link" href="@PageHref(pg - 1)" aria-label="@SR["Previous"]"><i class="ki-outline ki-@(isAr ? "right" : "left")" aria-hidden="true"></i></a></li>
                        @foreach (var n in pageNums)
                        {
                            <li class="page-item @(n == pg ? "active" : "") @(n == -1 ? "disabled" : "")">
                                @if (n == -1)
                                {
                                    <a class="page-link" href="#" aria-hidden="true" tabindex="-1">…</a>
                                }
                                else
                                {
                                    <a class="page-link" href="@PageHref(n)" aria-label="@T($"صفحة {n}", $"Page {n}")" aria-current="@(n == pg ? "page" : null)">@n</a>
                                }
                            </li>
                        }
                        <li class="page-item @(pg == pages ? "disabled" : "")"><a class="page-link" href="@PageHref(pg + 1)" aria-label="@SR["Next"]"><i class="ki-outline ki-@(isAr ? "left" : "right")" aria-hidden="true"></i></a></li>
                    </ul>
                }
            </div>
        </div>
    </div>
    <!--end::Results card-->
</div></div>
<!--end::Content-->

<style>
    /* DATE FIELDS IN THIS MODAL SIT ON THEIR LABEL'S LINE AND ARE 220px WIDE, unlike every other control
       in the same grid. flatpickr wraps each date input in `<div class="flatpickr-wrapper">`, and that
       wrapper is display:inline-block with an intrinsic 220px - so the inline <label> before it stays on
       the same line and the field stops short of the column edge. Invisible while the dialog was narrow
       and one field per row; obvious the moment the form became a 3-up grid. Scoped to #taskModal so the
       shared flatpickr styling is untouched. */
    #taskModal .flatpickr-wrapper { display: block; width: 100%; }
    #taskModal .flatpickr-wrapper > .flatpickr-input { width: 100%; }
</style>

<!--begin::Task modal-->
<div class="modal fade" id="taskModal" tabindex="-1" aria-hidden="true">
    @* modal-xl + a 3-COLUMN body. Fourteen fields in a 500px dialog stacked into eleven rows and ran off
       the bottom of the screen: the form had to be scrolled to reach Save, and the two optional sections
       at the end were invisible until you did. Widened to modal-xl and every field placed on a 3-up grid,
       which fits the whole form in one screen at 1080p. modal-dialog-scrollable keeps the header and the
       footer - the Save button - pinned if the viewport really is too short, instead of pushing them out
       of reach. *@
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <form asp-action="Save" method="post" data-cb-confirm data-cb-action="save" data-cb-confirm-if="#tId">
                @Html.AntiForgeryToken()
                <input type="hidden" id="tId" name="Id" value="0" />
                <input type="hidden" name="scope" value="@scope" />
                <div class="modal-header">
                    <h3 class="modal-title" id="taskModalTitle">@T("مهمة جديدة", "New task")</h3>
                    <button type="button" class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-2"></i></button>
                </div>
                <div class="modal-body">
                    @* TWO TITLES, one row. TaskItems.TitleEn existed in the entity and in the database with
                       no way to fill it from anywhere in the product, so it was null on every row and an
                       English UI had nothing to fall back to but the Arabic title. Optional on purpose: a
                       task with no English twin still displays its Arabic title in either language, which is
                       the documented fallback, not a blank cell. *@
                    <div class="row g-4 mb-2">
                        <div class="col-md-4">
                            <label class="form-label required">@T("العنوان", "Title") <span class="text-muted fs-8">(@T("عربي", "Arabic"))</span></label>
                            <input type="text" id="tTitle" name="Title" class="form-control form-control-solid" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@T("العنوان (إنجليزي)", "Title (English)")</label>
                            <input type="text" id="tTitleEn" name="TitleEn" class="form-control form-control-solid" dir="ltr"
                                   placeholder="@T("اختياري", "Optional")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@T("الوصف", "Description")</label>
                            <textarea id="tDesc" name="Description" rows="1" class="form-control form-control-solid"></textarea>
                        </div>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label required">@T("المسؤول", "Assignee")</label>
                            <select id="tAssignee" name="AssigneeEmployeeId" class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#taskModal" required>
                                <option value="">@T("اختر الموظف", "Select employee")</option>
                                @foreach (var e in employees)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@T("الأولوية", "Priority")</label>
                            <select id="tPriority" name="Priority" class="form-select form-select-solid">
                                <option value="Low">@pl("Low")</option>
                                <option value="Normal" selected>@pl("Normal")</option>
                                <option value="High">@pl("High")</option>
                                <option value="Urgent">@pl("Urgent")</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@T("ميعاد التسليم", "Due date")</label>
                            <input type="date" id="tDue" name="DueDate" class="form-control form-control-solid" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@T("الوقت المقدّر (ساعات)", "Estimated hours")</label>
                            <input type="number" step="0.5" min="0" id="tEst" name="EstimatedHours" class="form-control form-control-solid" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label d-flex justify-content-between">@T("نسبة الإنجاز", "Progress") <span id="tProgLbl" class="text-muted fw-bold">0%</span></label>
                            <input type="range" min="0" max="100" step="5" id="tProgress" name="ProgressPct" value="0" class="form-range mt-2" oninput="document.getElementById('tProgLbl').textContent=this.value+'%'" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@T("الوسم / التصنيف", "Tag / Category")</label>
                            <input type="text" id="tCategory" name="Category" class="form-control form-control-solid" placeholder="@T("مثال: اختبار الأداء", "e.g. Performance")" />
                        </div>
                    </div>
                    <!--begin::Linked record (TM-2, optional)-->
                    <div class="separator separator-dashed my-4"></div>
                    <div class="row g-4">
                        <div class="col-12"><label class="form-label text-muted fs-7">@T("السجل المرتبط (اختياري)", "Linked record (optional)")</label></div>
                        <div class="col-md-4">
                            <select id="tEntityType" name="EntityType" class="form-select form-select-solid">
                                <option value="">@T("— بلا ربط —", "— No link —")</option>
                                @foreach (var lt in (ViewBag.LinkTypes as List<CrossBuy.BL.TaskLinkTypeDto> ?? new()))
                                {
                                    <option value="@lt.Key">@(isAr ? lt.LabelAr : DisplayName.Or(lt.LabelEn, lt.LabelAr))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-8">
                            @* data-no-select2 IS THE FIX, and an empty <option> is what makes the placeholder appear.

                               _LayoutInventory.cshtml runs a global enhance() that select2-ifies EVERY
                               select.form-select inside #kt_app_content or a .modal - at DOMContentLoaded,
                               so before this modal is ever opened - with a PLAIN, non-ajax config. These
                               three pickers are ajax pickers, and their own initialisers all start with
                               `if ($x.data('select2')) return;`. The layout got there first every time, so
                               that guard fired on the FIRST call: no ajax source was ever attached and the
                               #tEntityType change handler was never bound. Measured before this change:
                               bound=true, hasAjax=false on all three, and the record box stayed
                               disabled with opacity .5 no matter which type was chosen - three dead
                               dropdowns. The layout already publishes the opt-out attribute; using it
                               leaves that shared file untouched. *@
                            <select id="tEntityId" name="EntityId" class="form-select form-select-solid" data-no-select2
                                    data-dropdown-parent="#taskModal"><option></option></select>
                        </div>
                    </div>
                    <!--end::Linked record-->
                    <!--begin::Billing (TM-5, optional)-->
                    <div class="separator separator-dashed my-4"></div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="tBillable" name="IsBillable" value="true" onchange="cbToggleBill()" />
                        <label class="form-check-label fw-semibold" for="tBillable">@T("قابلة للفوترة لعميل", "Billable to a customer")</label>
                    </div>
                    <div id="tBillBox" class="row g-4 d-none">
                        <div class="col-md-4">
                            <label class="form-label fs-8 text-muted mb-1">@T("العميل", "Customer")</label>
                            <select id="tCustomer" name="CustomerId" class="form-select form-select-solid" data-no-select2
                                    data-dropdown-parent="#taskModal"><option></option></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fs-8 text-muted mb-1">@T("سعر ساعة الفوترة", "Bill rate / hour")</label>
                            <input type="number" step="0.01" min="0" id="tBillRate" name="BillRate" class="form-control form-control-solid" />
                        </div>
                    </div>
                    <!--end::Billing-->
                    <!--begin::Scheduled (TM-9, optional)-->
                    <div class="separator separator-dashed my-4"></div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="tScheduled" name="IsScheduled" value="true" onchange="cbToggleSched()" />
                        <label class="form-check-label fw-semibold" for="tScheduled">@T("مهمة مجدولة (تنتظر حركة)", "Scheduled (awaiting a movement)")</label>
                    </div>
                    <div id="tSchedBox" class="row g-4 d-none">
                        <div class="col-12"><span class="text-muted fs-8">@T("عند إنشاء الحركة المطابقة، النظام يربطها بالمهمة تلقائيًّا (المطابقة في مرحلة تالية).", "When a matching movement is created, it will be auto-linked (matching comes later).")</span></div>
                        <div class="col-md-3">
                            <label class="form-label fs-8 text-muted mb-1">@T("نوع الحركة المتوقّع", "Expected movement")</label>
                            <select id="tExpType" name="ExpectedEntityType" class="form-select form-select-solid" onchange="cbSchedTypeChanged()">
                                <option value="PurchaseInvoice">@T("فاتورة مشتريات", "Purchase invoice")</option>
                                <option value="SalesInvoice">@T("فاتورة مبيعات", "Sales invoice")</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fs-8 text-muted mb-1"><span id="tExpPartyLbl">@T("المورّد", "Supplier")</span></label>
                            <select id="tExpParty" name="ExpectedPartyId" class="form-select form-select-solid" data-no-select2
                                    data-dropdown-parent="#taskModal"><option></option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fs-8 text-muted mb-1">@T("النافذة الزمنية من", "Expected window from")</label>
                            <input type="date" id="tExpFrom" name="ExpectedFrom" class="form-control form-control-solid" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fs-8 text-muted mb-1">@T("إلى", "to")</label>
                            <input type="date" id="tExpTo" name="ExpectedTo" class="form-control form-control-solid" />
                        </div>
                    </div>
                    <!--end::Scheduled-->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">@T("إلغاء", "Cancel")</button>
                    <button type="submit" class="btn btn-primary">@T("حفظ", "Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!--end::Task modal-->

<!--begin::Timesheet modal (TM-3)-->
<div class="modal fade" id="tsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">@T("سجل الوقت", "Timesheet") — <span id="tsTaskTitle" class="text-muted fs-5"></span></h3>
                <button type="button" class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-2"></i></button>
            </div>
            <div class="modal-body">
                <!--begin::Manual add-->
                <form asp-action="AddTime" method="post" class="row g-3 align-items-end mb-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="tsTaskId" name="taskId" value="0" />
                    <input type="hidden" name="scope" value="@scope" />
                    <div class="col-md-3"><label class="form-label fs-8 text-muted mb-1">@T("التاريخ", "Date")</label><input type="date" name="workDate" id="tsDate" class="form-control form-control-solid form-control-sm" required /></div>
                    <div class="col-md-2"><label class="form-label fs-8 text-muted mb-1">@T("ساعات", "Hours")</label><input type="number" step="0.25" min="0.25" max="24" name="hours" class="form-control form-control-solid form-control-sm" required /></div>
                    <div class="col-md-5"><label class="form-label fs-8 text-muted mb-1">@T("الوصف", "Description")</label><input type="text" name="description" class="form-control form-control-solid form-control-sm" /></div>
                    <div class="col-md-2"><button type="submit" class="btn btn-sm btn-primary w-100"><i class="ki-outline ki-plus fs-5"></i>@T("سجّل", "Log")</button></div>
                </form>
                <!--end::Manual add-->
                <div class="separator separator-dashed mb-4"></div>
                <div class="table-responsive">
                    <table class="table table-row-dashed align-middle fs-7 mb-0">
                        <thead><tr class="text-gray-500 fw-bold fs-8 text-uppercase" style="border-bottom:2px solid #0E4A9E;">
                            <th>@T("الموظف", "Employee")</th><th class="w-110px">@T("التاريخ", "Date")</th><th class="w-90px">@T("ساعات", "Hours")</th><th>@T("الوصف", "Description")</th><th class="w-90px">@T("المصدر", "Source")</th><th class="w-50px"></th>
                        </tr></thead>
                        <tbody id="tsLines"><tr><td colspan="6" class="text-center text-muted py-6">…</td></tr></tbody>
                    </table>
                </div>
                <!--begin::Cost (TM-4, informational) + WO posting-->
                <div id="tsCostBox" class="d-flex flex-stack bg-light-primary rounded p-4 mt-4 d-none">
                    <div>
                        <span class="text-muted fs-8 d-block">@T("التكلفة التقريرية (عرض فقط)", "Estimated cost (display only)")</span>
                        <span class="fs-4 fw-bold text-gray-900"><span id="tsCostTotal">0</span> <span class="fs-8 text-muted">@T("(ساعات × تكلفة الساعة)", "(hours × hourly cost)")</span></span>
                    </div>
                    <div id="tsWoBox"></div>
                </div>
                <!--end::Cost-->
                <!--begin::Billing (TM-5)-->
                <div id="tsBillBox" class="d-flex flex-stack bg-light-success rounded p-4 mt-3 d-none">
                    <div>
                        <span class="text-muted fs-8 d-block">@T("ساعات قابلة للفوترة (غير مفوترة)", "Billable hours (uninvoiced)")</span>
                        <span class="fs-4 fw-bold text-gray-900"><span id="tsBillHours">0</span> @T("ساعة", "h") · <span id="tsBillAmount">0</span></span>
                        <span id="tsBillCust" class="text-muted fs-8 d-block"></span>
                    </div>
                    <div id="tsBillAction"></div>
                </div>
                <!--end::Billing-->
            </div>
        </div>
    </div>
</div>
<!--end::Timesheet modal-->

@section Scripts {
<script>
    // TM-2: record picker (select2 ajax reading the chosen type at query time)
    function initLinkPicker() {
        if (!window.jQuery || !jQuery.fn.select2) return;
        var $rec = jQuery('#tEntityId');
        if ($rec.data('select2')) return; // once
        $rec.select2({
            dropdownParent: jQuery('#taskModal'),
            placeholder: '@T("اختر السجل", "Choose the record")',
            allowClear: true, minimumInputLength: 0, language: { inputTooShort: function () { return ''; } },
            ajax: {
                url: '/Tasks/LinkSearch', dataType: 'json', delay: 250,
                data: function (params) { return { entityType: jQuery('#tEntityType').val(), term: params.term || '' }; },
                processResults: function (d) { return { results: (d && d.results) || [] }; }
            }
        });
        jQuery('#tEntityType').on('change', function () { $rec.val(null).trigger('change'); toggleRec(); });
        toggleRec();
    }
    function toggleRec() {
        var has = !!jQuery('#tEntityType').val();
        // .col-md-8 since the linked-record row was regridded; a stale selector here silently stops
        // dimming the disabled picker (closest() returns nothing and the chain is a no-op).
        jQuery('#tEntityId').prop('disabled', !has).closest('.col-md-8').css('opacity', has ? 1 : .5);
    }
    function preselectRec(id, label) {
        var $rec = jQuery('#tEntityId');
        $rec.find('option').remove();
        // The empty option goes back first: select2 renders its placeholder for a single select ONLY when
        // the underlying select has one, and without it the closed control is a blank grey box with no
        // hint that it is a picker at all.
        $rec.append(new Option('', '', false, false));
        if (id && label) { var o = new Option(label, id, true, true); $rec.append(o); }
        $rec.trigger('change');
    }

    // TM-5: customer picker (select2 ajax) + billing toggle
    function initCustomerPicker() {
        if (!window.jQuery || !jQuery.fn.select2) return;
        var $c = jQuery('#tCustomer'); if ($c.data('select2')) return;
        $c.select2({
            dropdownParent: jQuery('#taskModal'), placeholder: '@T("اختر العميل", "Choose customer")', allowClear: true, minimumInputLength: 0,
            ajax: { url: '/Tasks/LinkSearch', dataType: 'json', delay: 250, data: function (p) { return { entityType: 'Customer', term: p.term || '' }; }, processResults: function (d) { return { results: (d && d.results) || [] }; } }
        });
    }
    function preselectCust(id, label) { var $c = jQuery('#tCustomer'); $c.find('option').remove(); $c.append(new Option('', '', false, false)); if (id && label) $c.append(new Option(label, id, true, true)); $c.trigger('change'); }
    function cbToggleBill() { document.getElementById('tBillBox').classList.toggle('d-none', !document.getElementById('tBillable').checked); }

    // TM-9: scheduled task — party picker (Supplier for purchase, Customer for sales)
    function schedPartyType() { return document.getElementById('tExpType').value === 'SalesInvoice' ? 'Customer' : 'Supplier'; }
    function initSchedParty() {
        if (!window.jQuery || !jQuery.fn.select2) return;
        var $p = jQuery('#tExpParty'); if ($p.data('select2')) return;
        $p.select2({
            dropdownParent: jQuery('#taskModal'), placeholder: '@T("اختر الطرف", "Choose party")', allowClear: true, minimumInputLength: 0,
            ajax: { url: '/Tasks/LinkSearch', dataType: 'json', delay: 250, data: function (pr) { return { entityType: schedPartyType(), term: pr.term || '' }; }, processResults: function (d) { return { results: (d && d.results) || [] }; } }
        });
    }
    function preselectSchedParty(id, label) { var $p = jQuery('#tExpParty'); $p.find('option').remove(); $p.append(new Option('', '', false, false)); if (id && label) $p.append(new Option(label, id, true, true)); $p.trigger('change'); }
    function cbToggleSched() {
        var on = document.getElementById('tScheduled').checked;
        document.getElementById('tSchedBox').classList.toggle('d-none', !on);
        if (on) { initSchedParty(); }
    }
    function cbSchedTypeChanged() {
        document.getElementById('tExpPartyLbl').textContent = (document.getElementById('tExpType').value === 'SalesInvoice') ? '@T("العميل", "Customer")' : '@T("المورّد", "Supplier")';
        initSchedParty();
        preselectSchedParty(null, null);   // party depends on the type → reset when the type flips
    }

    function cbTaskNew() {
        document.getElementById('tId').value = '0';
        document.getElementById('tTitle').value = '';
        document.getElementById('tTitleEn').value = '';
        document.getElementById('tDesc').value = '';
        document.getElementById('tDue').value = '';
        document.getElementById('tEst').value = '';
        document.getElementById('tProgress').value = '0'; document.getElementById('tProgLbl').textContent = '0%';
        document.getElementById('tCategory').value = '';
        setSel('tAssignee', '');
        setSel('tPriority', 'Normal');
        initLinkPicker(); setSel('tEntityType', ''); preselectRec(null, null); toggleRec();
        initCustomerPicker(); document.getElementById('tBillable').checked = false; document.getElementById('tBillRate').value = ''; preselectCust(null, null); cbToggleBill();
        document.getElementById('tScheduled').checked = false; setSel('tExpType', 'PurchaseInvoice'); document.getElementById('tExpFrom').value = ''; document.getElementById('tExpTo').value = ''; initSchedParty(); preselectSchedParty(null, null); document.getElementById('tExpPartyLbl').textContent = '@T("المورّد", "Supplier")'; cbToggleSched();
        document.getElementById('taskModalTitle').textContent = '@T("مهمة جديدة", "New task")';
    }
    function cbTaskEdit(t) {
        document.getElementById('tId').value = t.id;
        document.getElementById('tTitle').value = t.title || '';
        document.getElementById('tTitleEn').value = t.titleEn || '';
        document.getElementById('tDesc').value = t.description || '';
        document.getElementById('tDue').value = t.due || '';
        document.getElementById('tEst').value = (t.est != null ? t.est : '');
        var pv = (t.progress != null ? t.progress : 0); document.getElementById('tProgress').value = pv; document.getElementById('tProgLbl').textContent = pv + '%';
        document.getElementById('tCategory').value = t.category || '';
        setSel('tAssignee', t.assignee || '');
        setSel('tPriority', t.priority || 'Normal');
        initLinkPicker();
        setSel('tEntityType', t.entityType || '');
        preselectRec(t.entityId, t.entityLabel);
        toggleRec();
        initCustomerPicker();
        document.getElementById('tBillable').checked = !!t.isBillable;
        document.getElementById('tBillRate').value = (t.billRate != null ? t.billRate : '');
        preselectCust(t.customerId, t.customerName);
        cbToggleBill();
        document.getElementById('tScheduled').checked = !!t.isScheduled;
        setSel('tExpType', t.expType || 'PurchaseInvoice');
        document.getElementById('tExpFrom').value = t.expFrom || '';
        document.getElementById('tExpTo').value = t.expTo || '';
        initSchedParty();
        document.getElementById('tExpPartyLbl').textContent = (t.expType === 'SalesInvoice') ? '@T("العميل", "Customer")' : '@T("المورّد", "Supplier")';
        preselectSchedParty(t.expPartyId, t.expPartyName);
        document.getElementById('tSchedBox').classList.toggle('d-none', !t.isScheduled);
        document.getElementById('taskModalTitle').textContent = '@T("تعديل المهمة", "Edit task")';
    }
    function setSel(id, val) {
        var el = document.getElementById(id); if (!el) return;
        el.value = (val == null ? '' : val);
        if (window.jQuery && jQuery(el).hasClass('select2-hidden-accessible')) jQuery(el).val(String(val == null ? '' : val)).trigger('change');
    }

    // TM-3: timesheet modal — set task + load lines via JSON
    var CB_SCOPE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(scope));
    var CB_AF = document.querySelector('#taskModal input[name="__RequestVerificationToken"]');
    function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
    function cbOpenTimesheet(taskId, title) {
        document.getElementById('tsTaskId').value = taskId;
        document.getElementById('tsTaskTitle').textContent = title || '';
        var d = new Date(); document.getElementById('tsDate').value = d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);
        var body = document.getElementById('tsLines');
        body.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-6">…</td></tr>';
        if (window.bootstrap) new bootstrap.Modal(document.getElementById('tsModal')).show();
        var costBox = document.getElementById('tsCostBox'); costBox.classList.add('d-none');
        fetch('/Tasks/TimesheetLines?taskId=' + taskId, { headers: { 'X-Requested-With': 'fetch' } })
            .then(r => r.json()).then(function (data) {
                var rows = (data && data.lines) || [];
                var cost = (data && data.cost) || null;
                renderCost(cost, taskId);
                renderBilling((data && data.billing) || null, taskId);
                if (!rows.length) { body.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-6">@T("لا سطور وقت بعد.", "No time entries yet.")</td></tr>'; return; }
                var tok = CB_AF ? CB_AF.value : '';
                body.innerHTML = rows.map(function (l) {
                    var run = l.running ? ' <span class="badge badge-light-primary">@T("شغّال", "running")</span>' : '';
                    var src = l.source === 'Timer' ? '@T("مؤقّت", "Timer")' : '@T("يدوي", "Manual")';
                    var del = l.running ? '' : '<form action="/Tasks/DeleteTime" method="post" class="d-inline" data-cb-confirm data-cb-action="delete">'
                        + '<input type="hidden" name="__RequestVerificationToken" value="' + tok + '">'
                        + '<input type="hidden" name="id" value="' + l.id + '"><input type="hidden" name="scope" value="' + CB_SCOPE + '">'
                        + '<button type="submit" class="btn btn-sm btn-icon btn-light-danger"><i class="ki-outline ki-trash fs-7"></i></button></form>';
                    return '<tr><td>' + esc(l.employeeName) + '</td><td>' + esc(l.workDate) + '</td><td class="fw-bold">' + l.hours + run
                        + '</td><td class="text-muted">' + esc(l.description) + '</td><td><span class="badge badge-light">' + src + '</span></td><td class="text-end">' + del + '</td></tr>';
                }).join('');
            }).catch(function () { body.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-6">@T("تعذّر التحميل", "Failed to load")</td></tr>'; });
    }
    function renderCost(cost, taskId) {
        var box = document.getElementById('tsCostBox'); if (!cost) { box.classList.add('d-none'); return; }
        box.classList.remove('d-none');
        document.getElementById('tsCostTotal').textContent = (cost.total != null ? cost.total : 0);
        var wo = document.getElementById('tsWoBox'); var tok = CB_AF ? CB_AF.value : '';
        if (cost.linkedToWorkOrder && !cost.laborPosted) {
            wo.innerHTML = '<form action="/Tasks/PostLaborToWO" method="post" data-cb-confirm data-cb-action="approve" data-cb-confirm-text="@T("ترحيل", "Post")" data-cb-title="@T("ترحيل العمالة إلى أمر التشغيل؟", "Post labor to the work order?")">'
                + '<input type="hidden" name="__RequestVerificationToken" value="' + tok + '">'
                + '<input type="hidden" name="taskId" value="' + taskId + '"><input type="hidden" name="scope" value="' + CB_SCOPE + '">'
                + '<button type="submit" class="btn btn-sm btn-primary"><i class="ki-outline ki-gear fs-5"></i>@T("ترحيل العمالة لأمر التشغيل", "Post labor to WO")</button></form>';
        } else if (cost.laborPosted) {
            wo.innerHTML = '<span class="badge badge-light-primary"><i class="ki-outline ki-check fs-7 me-1"></i>@T("رُحّلت العمالة", "Labor posted")</span>';
        } else { wo.innerHTML = ''; }
    }
    function renderBilling(b, taskId) {
        var box = document.getElementById('tsBillBox'); if (!b || !b.isBillable) { box.classList.add('d-none'); return; }
        box.classList.remove('d-none');
        document.getElementById('tsBillHours').textContent = (b.billableHours != null ? b.billableHours : 0);
        document.getElementById('tsBillAmount').textContent = (b.amount != null ? b.amount : 0);
        document.getElementById('tsBillCust').textContent = b.customerName ? ('@T("العميل", "Customer"): ' + b.customerName) : '';
        var act = document.getElementById('tsBillAction'); var tok = CB_AF ? CB_AF.value : '';
        if (b.canInvoice) {
            act.innerHTML = '<form action="/Tasks/GenerateInvoice" method="post" data-cb-confirm data-cb-action="approve" data-cb-confirm-text="@T("توليد", "Generate")" data-cb-title="@T("توليد فاتورة خدمة بالساعة؟", "Generate an hourly service invoice?")">'
                + '<input type="hidden" name="__RequestVerificationToken" value="' + tok + '">'
                + '<input type="hidden" name="taskId" value="' + taskId + '"><input type="hidden" name="scope" value="' + CB_SCOPE + '">'
                + '<button type="submit" class="btn btn-sm btn-success"><i class="ki-outline ki-bill fs-5"></i>@T("توليد فاتورة", "Generate invoice")</button></form>';
        } else { act.innerHTML = '<span class="text-muted fs-8">' + (b.reason || '') + '</span>'; }
    }
</script>
}
