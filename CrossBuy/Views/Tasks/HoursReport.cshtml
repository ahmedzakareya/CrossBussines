@using CrossBuy.BL
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    Func<string, string, string> T = (ar, en) => isAr ? ar : en;
    var rep = ViewBag.Report as HoursReportDto ?? new HoursReportDto();
    var employees = ViewBag.Employees as List<(int Id, string Name)> ?? new();
    var from = ((DateTime)ViewBag.From).ToString("yyyy-MM-dd");
    var to = ((DateTime)ViewBag.To).ToString("yyyy-MM-dd");
    int? empId = ViewBag.EmployeeId as int?;
    ViewData["Title"] = T("تقرير الساعات", "Hours report");
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
    <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading fw-bold fs-3 m-0">@T("تقرير ساعات العمل", "Work hours report")</h1>
            <span class="text-muted fs-7">@T("إجمالي ساعات كل موظف ضمن فترة — لاستخدام HR في المرتبات. قراءة فقط، لا أثر محاسبي.", "Each employee's hours within a period — for HR payroll. Read-only, no accounting effect.")</span>
        </div>
        <button type="button" class="btn btn-sm btn-light-primary" onclick="window.print()"><i class="ki-outline ki-printer fs-4"></i>@T("طباعة", "Print")</button>
    </div>
</div>
<!--end::Toolbar-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6">
                <form method="get" asp-action="HoursReport" class="d-flex flex-wrap align-items-end gap-3 w-100">
                    <div><label class="form-label fs-8 text-muted mb-1">@T("من", "From")</label>
                        <div class="position-relative">
                            <i class="ki-outline ki-calendar-8 fs-3 position-absolute top-50 translate-middle-y ms-3" style="color:#13433a !important;"></i>
                            <input type="text" name="from" id="hr_from" value="@from" class="form-control form-control-solid ps-10 w-160px" autocomplete="off" placeholder="@T("من", "From")" />
                        </div>
                    </div>
                    <div><label class="form-label fs-8 text-muted mb-1">@T("إلى", "To")</label>
                        <div class="position-relative">
                            <i class="ki-outline ki-calendar-8 fs-3 position-absolute top-50 translate-middle-y ms-3" style="color:#13433a !important;"></i>
                            <input type="text" name="to" id="hr_to" value="@to" class="form-control form-control-solid ps-10 w-160px" autocomplete="off" placeholder="@T("إلى", "To")" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label fs-8 text-muted mb-1">@T("الموظف", "Employee")</label>
                        <select name="employeeId" class="form-select form-select-solid w-225px" data-control="select2" data-placeholder="@T("كل الموظفين", "All employees")">
                            <option value="">@T("كل الموظفين", "All employees")</option>
                            @foreach (var e in employees)
                            {
                                <option value="@e.Id" selected="@(empId == e.Id)">@e.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn" style="background:#13433a;color:#fff;"><i class="ki-outline ki-magnifier fs-5" style="color:#fff !important;"></i>@T("عرض", "Show")</button>
                </form>
            </div>
            <div class="card-body pt-4">
                <div class="notice d-flex align-items-center rounded border border-dashed p-6 mb-6" style="background:#eaf3ef;border-color:#13433a !important;">
                    <span class="symbol symbol-45px me-4">
                        <span class="symbol-label" style="background:#13433a;"><i class="ki-outline ki-time fs-2 text-white"></i></span>
                    </span>
                    <div class="d-flex flex-stack flex-grow-1 flex-wrap gap-2">
                        <div>
                            <h4 class="fw-bold mb-1" style="color:#1f6253;">@T("إجمالي الساعات", "Total hours"): @rep.GrandTotal.ToString("0.##")</h4>
                            <div class="fs-7 text-gray-700">@T("الفترة", "Period"): @from → @to</div>
                        </div>
                    </div>
                </div>
                @if (!rep.Employees.Any())
                {
                    <div class="text-center text-muted py-12"><i class="ki-outline ki-time fs-3x mb-3 d-block"></i>@T("لا ساعات مسجّلة في هذه الفترة.", "No hours logged in this period.")</div>
                }
                else
                {
                    var empImgs = ViewBag.EmpImages as Dictionary<int, string> ?? new Dictionary<int, string>();
                    var empNames = ViewBag.EmpNames as Dictionary<int, string> ?? new Dictionary<int, string>();
                    Func<int, string, string> dispName = (id, fallback) => empNames.TryGetValue(id, out var n) && !string.IsNullOrWhiteSpace(n) ? n : fallback;
                    <div class="d-flex flex-stack mb-5">
                        <h3 class="text-gray-800 fw-bold m-0">@T("الموظفون", "Employees") <span class="fs-6 text-muted fw-semibold ms-1">(@rep.Employees.Count)</span></h3>
                    </div>
                    <div class="row g-6 g-xl-9">
                        @foreach (var emp in rep.Employees)
                        {
                            var name = dispName(emp.EmployeeId, emp.EmployeeName);
                            var nm = (name ?? "").Trim();
                            var init = string.IsNullOrEmpty(nm) ? "?" : nm.Substring(0, 1);
                            var days = emp.Lines.Select(l => l.WorkDate.Date).Distinct().Count();
                            var tasks = emp.Lines.Select(l => l.TaskId).Distinct().Count();
                            empImgs.TryGetValue(emp.EmployeeId, out var imgPath);
                            <div class="col-md-6 col-xxl-4">
                                <div class="card h-100">
                                    <div class="card-body d-flex flex-center flex-column py-9 px-5">
                                        <div class="symbol symbol-65px symbol-circle mb-5">
                                            @if (!string.IsNullOrEmpty(imgPath))
                                            {
                                                <img src="@imgPath" alt="@name" />
                                            }
                                            else
                                            {
                                                <span class="symbol-label fs-2x fw-bold" style="background:#eaf3ef;color:#13433a;">@init</span>
                                            }
                                        </div>
                                        <span class="fs-4 text-gray-800 fw-bold mb-0">@name</span>
                                        <div class="fw-semibold text-muted mb-6">@tasks @T("مهمة", "tasks") · @days @T("يوم", "days")</div>
                                        <div class="d-flex flex-center flex-wrap mb-5">
                                            <div class="border border-gray-300 border-dashed rounded min-w-90px py-3 px-4 mx-2 mb-3 text-center">
                                                <div class="fs-3 fw-bold" style="color:#13433a;">@emp.TotalHours.ToString("0.##")</div>
                                                <div class="fw-semibold text-muted fs-8">@T("ساعة", "Hours")</div>
                                            </div>
                                            <div class="border border-gray-300 border-dashed rounded min-w-90px py-3 px-4 mx-2 mb-3 text-center">
                                                <div class="fs-3 fw-bold text-gray-700">@emp.Lines.Count</div>
                                                <div class="fw-semibold text-muted fs-8">@T("حركة", "entries")</div>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-flex btn-center" data-bs-toggle="modal" data-bs-target="#emp_@emp.EmployeeId" style="background:#eaf3ef;color:#13433a;">
                                            <i class="ki-outline ki-eye fs-5"></i>@T("التفاصيل", "Details")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @foreach (var emp in rep.Employees)
                    {
                        var mDays = emp.Lines.Select(l => l.WorkDate.Date).Distinct().Count();
                        var mTasks = emp.Lines.Select(l => l.TaskId).Distinct().Count();
                        var mName = dispName(emp.EmployeeId, emp.EmployeeName);
                        <div class="modal fade" id="emp_@emp.EmployeeId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered mw-650px">
                                <div class="modal-content">
                                    <div class="modal-header pb-0 border-0 justify-content-end">
                                        <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div>
                                    </div>
                                    <div class="modal-body scroll-y mx-5 mx-xl-15 pt-0 pb-15">
                                        <div class="text-center mb-10">
                                            <div class="symbol symbol-80px symbol-circle mb-4">
                                                @if (empImgs.TryGetValue(emp.EmployeeId, out var mImg) && !string.IsNullOrEmpty(mImg))
                                                {
                                                    <img src="@mImg" alt="@mName" />
                                                }
                                                else
                                                {
                                                    <span class="symbol-label fs-2x fw-bold" style="background:#eaf3ef;color:#13433a;">@(string.IsNullOrWhiteSpace(mName) ? "?" : mName.Trim().Substring(0, 1))</span>
                                                }
                                            </div>
                                            <h1 class="mb-3">@mName</h1>
                                            <div class="text-muted fw-semibold fs-5">
                                                <span class="fw-bold" style="color:#13433a;">@emp.TotalHours.ToString("0.##")</span> @T("ساعة", "hours") · @mTasks @T("مهمة", "tasks") · @mDays @T("يوم", "days")
                                            </div>
                                        </div>
                                        <div class="mh-450px scroll-y me-n7 pe-7">
                                            @foreach (var l in emp.Lines.OrderByDescending(x => x.WorkDate).ThenByDescending(x => x.TaskId))
                                            {
                                                <div class="d-flex flex-stack py-4 border-bottom border-gray-300 border-bottom-dashed">
                                                    <div class="d-flex align-items-center">
                                                        <div class="symbol symbol-40px me-4">
                                                            <span class="symbol-label" style="background:#eaf3ef;"><i class="ki-outline ki-abstract-26 fs-4" style="color:#13433a;"></i></span>
                                                        </div>
                                                        <div>
                                                            <span class="fs-6 fw-bold text-gray-900">@l.TaskTitle</span>
                                                            <div class="fw-semibold text-muted fs-7">@l.WorkDate.ToString("yyyy-MM-dd")@(string.IsNullOrWhiteSpace(l.Description) ? "" : " · " + l.Description)</div>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="fs-5 fw-bold" style="color:#13433a;">@l.Hours.ToString("0.##")</div>
                                                        <div class="fs-8 text-muted">@T("ساعة", "Hours")</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!window.flatpickr) return;
            var o = { dateFormat: "Y-m-d", allowInput: true, disableMobile: true };
            flatpickr("#hr_from", o); flatpickr("#hr_to", o);
        })();
    </script>
}
