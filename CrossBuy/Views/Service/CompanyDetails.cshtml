											<!--end::Input-->
										</div>
										<!--end::Input group-->
									</div>
									<!--end::Col-->
								</div>
								
								<!--end::Row-->
								<!--begin::Row-->
								<div class="row row-cols-1 row-cols-sm-2 rol-cols-md-1 row-cols-lg-2">
									<!--begin::Col-->
									<div class="col">
										<!--begin::Input group-->
										<div class="fv-row mb-7">
											<!--begin::Label-->
											<label class="fs-6 fw-semibold form-label mt-3">
												<span class="required">@CrossBuy.Resources.SharedResources.Email</span>
											
											</label>
											<!--end::Label-->
											<!--begin::Input-->
											<input type="email" placeholder="@CrossBuy.Resources.SharedResources.Email" asp-for="Email" class="form-control" />

											<!--end::Input-->
										</div>
										<!--end::Input group-->
									</div>
									<!--end::Col-->
									<!--begin::Col-->
									<div class="col">
										<!--begin::Input group-->
										<div class="fv-row mb-7">
											<!--begin::Label-->
											<label class="fs-6 fw-semibold form-label mt-3">
												<span class="required"> @CrossBuy.Resources.SharedResources.Phone</span>
											
											</label>
											<!--end::Label-->
											<!--begin::Input-->
											<input type="text" placeholder="@CrossBuy.Resources.SharedResources.Phone" asp-for="PhoneNumber" class="form-control" />

											<!--end::Input-->
										</div>
										<!--end::Input group-->
									</div>
									<!--end::Col-->
								</div>
								<!--end::Row-->
								<!--begin::Notice-->
								<div class="row row-cols-1 row-cols-sm-2 rol-cols-md-1 row-cols-lg-2">
									<div class="col">
										<div class="fv-row mb-7">
											<div class="d-flex justify-content-between">
												<!--begin::Label-->
												<div class="fw-semibold">
													<label class="fs-6">@CrossBuy.Resources.SharedResources.SubsidiaryCompany</label>
													<div class="fs-7 text-muted">@CrossBuy.Resources.SharedResources.companySub</div>
												</div>
												<!--end::Label-->
												<!--begin::Switch-->
												<label class="form-check form-switch form-check-custom form-check-solid">
													<input id="toggleCheckbox" class="form-check-input" type="checkbox"
													@(Model.ParentCompany > 0 ? "checked" : "") />
													<span class="form-check-label fw-semibold text-muted">@CrossBuy.Resources.SharedResources.YesNo</span>
												</label>
												<!--end::Switch-->
											</div>
										</div>
									</div>

									<!--begin::Col-->
									<div id="toggleElement" class="col" style="display: @(Model.ParentCompany > 0 ? "block" : "none");">
										<!--begin::Input group-->
										<div class="fv-row mb-7">
											<!--begin::Label-->
											<label class="fs-6 fw-semibold form-label mt-3">
												<span class="required">@CrossBuy.Resources.SharedResources.Companies</span>
											</label>
											<!--end::Label-->
											<!--begin::Input-->
											<select class="form-select form-select" id="ParentCompany" data-control="select2" data-placeholder="@CrossBuy.Resources.SharedResources.ChooseItem">
												<option></option>
												@foreach (var item in Model.ChildCompanies)
												{
													<option value="@item.CompanyID">
														@if (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar")
														{
															@item.ComoanyNameAr
														}
														else
														{
															@item.CompanyName
														}
													</option>
												}
											</select>
											<!--end::Input-->
										</div>
										<!--end::Input group-->
									</div>
									<!--end::Col-->
									<script>
										document.addEventListener('DOMContentLoaded', function () {
											// Set the selected option after the page loads
											var parentCompanyId = @Model.ParentCompany;
											var selectElement = document.getElementById('ParentCompany');
											if (parentCompanyId) {
												selectElement.value = parentCompanyId;
											}
										});
									</script>
									<script>
										document.getElementById('toggleCheckbox').addEventListener('change', function () {
											var toggleElement = document.getElementById('toggleElement');
											if (this.checked) {
												toggleElement.style.display = 'block';
											} else {
												toggleElement.style.display = 'none';
											}
										});
									</script>
								</div>
								<!--end::Notice-->
