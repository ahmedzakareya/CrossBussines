															<input type="text" placeholder="@CrossBuy.Resources.SharedResources.TaxNumber" asp-for="TaxNumber" class="form-control" />

															<!--end::Input-->
														</div>
														<!--end::Input group-->
													</div>
													<!--end::Col-->
												</div>
												<!--end::Row-->
											</div>
											<!--end::Body-->
										</div>
										<!--end::Earnings-->
									</div>
									<!--end::Col-->
								</div>

