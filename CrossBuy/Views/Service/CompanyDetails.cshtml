<script src="~/assets/js/form-validation.js"></script>



<script>
	$(document).ready(function () {
		$("#companyForm").on("submit", function (e) {
			e.preventDefault();

			var isValid = true;

			// Validate required fields (PhoneNumber, Address, CompanyNameAr, etc.)
			// التحقق من الحقول الإلزامية (رقم الهاتف، العنوان، اسم الشركة بالعربية، إلخ)
			$("#PhoneNumber, #Address, #CompanyNameAr, #CompanyName, #Email").each(function () {
				if ($(this).val() === "") {
					isValid = false;
					$(this).addClass("is-invalid"); // Highlight invalid fields
					// تمييز الحقول غير الصالحة
				} else {
					$(this).removeClass("is-invalid"); // Remove invalid highlight if valid
					// إزالة التمييز إذا كانت القيمة صحيحة
				}
			});

			// Validate dropdowns (CompanyTypeId, CountryID)
			// التحقق من القوائم المنسدلة (نوع الشركة، الدولة)
			$("#CompanyTypeId, #CountryID").each(function () {
				if ($(this).val() === "" || $(this).val() === "0") {
					isValid = false;
					$(this).addClass("is-invalid");
				} else {
					$(this).removeClass("is-invalid");
				}
			});

			// Check if ParentCompany is required when checkbox is checked
			// التحقق إذا كانت الشركة الأم مطلوبة عند تفعيل مربع الاختيار
			if ($("#toggleCheckbox").is(":checked")) {
				if ($("#ParentCompany").val() === "" || $("#ParentCompany").val() === "0") {
					isValid = false;
					Swal.fire({
						icon: 'warning',
						title: '@CrossBuy.Resources.SharedResources.Error',
						text: '@Html.Raw(CrossBuy.Resources.SharedResources.FillRequiredFieldsForParentCompany)',
					});
				}
			}

			// Ensure an image is attached when adding a new company
			// التأكد من اختيار صورة عند إضافة شركة جديدة
			var companyId = $("#CompanyID").val(); // Get CompanyID from the form
			var fileInput = $("input[name='avatar']");
			var file = fileInput[0].files[0];
			if (!file && (!companyId || companyId === "0")) { // Check only for new entries
				isValid = false;
				Swal.fire({
					icon: 'warning',
					title: '@SR["Error"]',
					text: '@Localizer["Please choose an image."]',
				});
			}

			// If editing, display a confirmation dialog before submitting
			// عند التعديل، عرض رسالة تأكيد قبل الإرسال
			if (companyId && companyId !== "0") {
				CB.confirm({
					type: 'edit',
					text: '@Html.Raw(@CrossBuy.Resources.SharedResources.ConfirmMSG)'
				}).then((confirmed) => {
					if (confirmed) {
						if (isValid) {
							submitForm();
						}
					}
				});
			} else { // Handle adding a new company
				// التعامل مع إضافة شركة جديدة
				if (isValid) {
					submitForm();
				} else {
					Swal.fire({
						icon: 'warning',
						title: '@CrossBuy.Resources.SharedResources.Warning',
						text: '@Html.Raw(CrossBuy.Resources.SharedResources.FillRequiredFields)',
					});
				}
			}

			// Function to handle form submission via AJAX
			// دالة لإرسال النموذج عبر AJAX
			function submitForm() {
				var formData = new FormData();

				// Add form data fields
				// إضافة بيانات الحقول من النموذج
				formData.append("CompanyID", companyId);
				formData.append("PhoneNumber", $("#PhoneNumber").val());
				formData.append("Address", $("#Address").val());
				formData.append("CompanyNameAr", $("#CompanyNameAr").val());
				formData.append("CompanyName", $("#CompanyName").val());
				formData.append("Email", $("#Email").val());
				formData.append("CountryID", $("#CountryID").val());
				formData.append("ParentCompany", $("#ParentCompany").val());
				formData.append("CompanyTypeId", $("#CompanyTypeId").val());
				formData.append("Website", $("#Website").val());
				formData.append("PostalCode", $("#PostalCode").val());
				formData.append("RegistrationNumber", $("#RegistrationNumber").val());
				formData.append("TaxNumber", $("#TaxNumber").val());
				formData.append("Description", $("#Description").val());

				// Add image file if present
				// إضافة ملف الصورة إذا وُجد
				if (file) {
					formData.append("CompanyImage", file);
				}

				// Collect attachment data
				// جمع بيانات المرفقات
				var attachmentsFiles = [];
				$(".dropzone-item").each(function () {
					var attachName = $(this).find(".attachment-name").val();
					var attachPath = $(this).find(".dropzone-filename").text();

					attachmentsFiles.push({
						AttachName: attachName,
						AttachPath: attachPath
					});
				});

				// Add attachments data as JSON
				// إضافة بيانات المرفقات بصيغة JSON
				formData.append("AttachmentsFiles", JSON.stringify(attachmentsFiles));

				// Add Dropzone files
				// إضافة ملفات Dropzone
				myDropzone.files.forEach(function (file) {
					formData.append("Attachments", file);
				});

				// Send form data via AJAX
				// إرسال البيانات عبر AJAX
				$.ajax({
					url: "/Service/CompanyDetails",
					type: "POST",
					data: formData,
					processData: false,
					contentType: false,
					success: function (response) {
						if (response.success) {
							CB.toast.success(response.message);
							setTimeout(function () {
								window.location.href = "/Service/CompaniesList";
							}, 800);
						} else {
							CB.toast.error(response.message);
						}
					},
					error: function () {
						CB.toast.error('@Html.Raw(CrossBuy.Resources.SharedResources.SaveFailed)');
					}
				});
			}
		});
	});



</script>



<script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/min/dropzone.min.js"></script>

<script>
	// set the dropzone container id
	const id = "#kt_dropzonejs_example_2";
	const dropzone = document.querySelector(id);

	// set the preview element template
	var previewNode = dropzone.querySelector(".dropzone-item");
	previewNode.id = "";
	var previewTemplate = previewNode.parentNode.innerHTML;
	previewNode.parentNode.removeChild(previewNode);

	var myDropzone = new Dropzone(id, { // Make the whole body a dropzone
		url: "https://keenthemes.com/scripts/void.php", // Set the url for your upload script location
		parallelUploads: 20,
		previewTemplate: previewTemplate,
		maxFilesize: 1, // Max filesize in MB
		maxFiles: 5, // Maximum number of files
		autoQueue: false, // Make sure the files aren't queued until manually added
		previewsContainer: id + " .dropzone-items", // Define the container to display the previews
		clickable: id + " .dropzone-select", // Define the element that should be used as click trigger to select files.
		acceptedFiles: ".pdf" // Allow only PDF files
	});

	myDropzone.on("addedfile", function (file) {
		// Check file size
		if (file.size > 1 * 1024 * 1024) { // 1 MB in bytes
			// Use SweetAlert for notification
			Swal.fire({
				title: '@CrossBuy.Resources.SharedResources.Error',
				title: '@CrossBuy.Resources.SharedResources.File_size',
				icon: "error",
				confirmButtonText: "@CrossBuy.Resources.SharedResources.Ok"
			});
			myDropzone.removeFile(file); // Remove file if size exceeds limit
			return;
		}

		// Hookup the start button
		file.previewElement.querySelector(id + " .dropzone-start").onclick = function () { myDropzone.enqueueFile(file); };

		const dropzoneItems = dropzone.querySelectorAll('.dropzone-item');
		dropzoneItems.forEach(dropzoneItem => {
			dropzoneItem.style.display = '';
		});

		// dropzone.querySelector('.dropzone-upload').style.display = "inline-block";
		dropzone.querySelector('.dropzone-remove-all').style.display = "inline-block";

		// Disable add files button if maxFiles limit is reached
		if (myDropzone.files.length >= 5) {
			dropzone.querySelector(".dropzone-select").style.pointerEvents = "none";
			dropzone.querySelector(".dropzone-select").style.opacity = "0.5";
		}
	});

	// Update the total progress bar
	myDropzone.on("totaluploadprogress", function (progress) {
		const progressBars = dropzone.querySelectorAll('.progress-bar');
		progressBars.forEach(progressBar => {
			progressBar.style.width = progress + "%";
		});
	});

	myDropzone.on("sending", function (file) {
		// Show the total progress bar when upload starts
		const progressBars = dropzone.querySelectorAll('.progress-bar');
		progressBars.forEach(progressBar => {
			progressBar.style.opacity = "1";
		});
		// And disable the start button
		file.previewElement.querySelector(id + " .dropzone-start").setAttribute("disabled", "disabled");
	});

	// Hide the total progress bar when nothing's uploading anymore
	myDropzone.on("complete", function (progress) {
		const progressBars = dropzone.querySelectorAll('.dz-complete');

		setTimeout(function () {
			progressBars.forEach(progressBar => {
				progressBar.querySelector('.progress-bar').style.opacity = "0";
				progressBar.querySelector('.progress').style.opacity = "0";
				progressBar.querySelector('.dropzone-start').style.opacity = "0";
			});
		}, 300);
	});

	// // Setup the buttons for all transfers
	// dropzone.querySelector(".dropzone-upload").addEventListener('click', function () {
	// 	myDropzone.enqueueFiles(myDropzone.getFilesWithStatus(Dropzone.ADDED));
	// });

	// Setup the button for remove all files
	dropzone.querySelector(".dropzone-remove-all").addEventListener('click', function () {
		dropzone.querySelector('.dropzone-upload').style.display = "none";
		dropzone.querySelector('.dropzone-remove-all').style.display = "none";
		myDropzone.removeAllFiles(true);

		// Enable add files button
		dropzone.querySelector(".dropzone-select").style.pointerEvents = "auto";
		dropzone.querySelector(".dropzone-select").style.opacity = "1";
	});

	// On all files completed upload
	myDropzone.on("queuecomplete", function (progress) {
		const uploadIcons = dropzone.querySelectorAll('.dropzone-upload');
		uploadIcons.forEach(uploadIcon => {
			uploadIcon.style.display = "none";
		});
	});

	// On all files removed
	myDropzone.on("removedfile", function (file) {
		if (myDropzone.files.length < 1) {
			dropzone.querySelector('.dropzone-upload').style.display = "none";
			dropzone.querySelector('.dropzone-remove-all').style.display = "none";
		}

		// Enable add files button if maxFiles limit is not reached
		if (myDropzone.files.length < 5) {
			dropzone.querySelector(".dropzone-select").style.pointerEvents = "auto";
			dropzone.querySelector(".dropzone-select").style.opacity = "1";
		}
	});
</script>






