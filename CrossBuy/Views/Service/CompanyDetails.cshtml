							<a href="apps/contacts/add-contact.html" class="btn btn-primary w-100">
								<i class="ki-outline ki-badge fs-2"></i>@Localizer["Add new contact"]
							</a>
							<!--end::Add new contact-->
						</div>
						<!--end::Card body-->
					</div>
					
					<!--end::Contact group wrapper-->
				</div>
			
				<!--end::Contact groups-->
		
				<!--begin::Content-->
				<div class="col-xl-9">
					<!--begin::Contacts-->
					<div class="card card-flush h-lg-100" id="kt_contacts_main">
						<!--begin::Card header-->
						<div class="card-header pt-7" id="kt_chat_contacts_header">
							<!--begin::Card title-->
							<div class="card-title">
								<i class="ki-outline ki-book-square fs-1 me-2"></i>
								<h2>@CrossBuy.Resources.SharedResources.CompanyData</h2>
							</div>
							<!--end::Card title-->
						</div>
						<!--end::Card header-->
						<!--begin::Card body-->
						<div class="card-body pt-5">
							<!--begin::Form-->
							<form id="companyForm" class="form" action="#">
								<input type="hidden" asp-for="CompanyID" id="CompanyID" />

								<!--begin::Input group-->
								<div class="mb-7">
									<!--begin::Label-->
									<label class="fs-6 fw-semibold mb-3">
										<span>@CrossBuy.Resources.SharedResources.CompanyLogo</span>
										<span class="ms-1" data-bs-toggle="tooltip" title="@Localizer["Allowed file types: png, jpg, jpeg."]">
											<i class="ki-outline ki-information fs-7"></i>
										</span>
									</label>
									<!--end::Label-->
									<!--begin::Image input wrapper-->
									<div class="mt-1">
										<!--begin::Image placeholder-->
										<style>
											.image-input-placeholder {
												background-image: url('../Backend-assets/media/svg/files/blank-image.svg');
											}

											[data-bs-theme="dark"] .image-input-placeholder {
												background-image: url('../Backend-assets/media/svg/files/blank-image-dark.svg');
											}</style>

										
										<!--end::Image placeholder-->
										<!--begin::Image input-->
										<div class="image-input image-input-outline @((Model.CompanyImageUrl != null) ? "" : "image-input-placeholder")"
											 data-kt-image-input="true">
											<!--begin::Preview existing avatar-->
											<div class="image-input-wrapper w-100px h-100px"
												 style="background-image: url('@(Model.CompanyImageUrl != null ? "/"+Url.Content(Model.CompanyImageUrl.Replace("\\", "/")) : Url.Content("~/Backend-assets/media/svg/files/blank-image.svg"))')">
											</div>
											<!--end::Preview existing avatar-->
											<!--begin::Edit-->
											<label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow"
												   data-kt-image-input-action="change" data-bs-toggle="tooltip" title="@Localizer["Change avatar"]">
												<i class="ki-outline ki-pencil fs-7"></i>
												<!--begin::Inputs-->
												<input type="file" name="avatar" accept=".png, .jpg, .jpeg" />
												<input type="hidden" name="avatar_remove" />
												<!--end::Inputs-->
											</label>
											<!--end::Edit-->
											<!--begin::Cancel-->
											<span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow"
												  data-kt-image-input-action="cancel" data-bs-toggle="tooltip" title="@Localizer["Cancel avatar"]">
												<i class="ki-outline ki-cross fs-2"></i>
											</span>
											<!--end::Cancel-->
											<!--begin::Remove-->
											<span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow"
												  data-kt-image-input-action="remove" data-bs-toggle="tooltip" title="@Localizer["Remove avatar"]">
												<i class="ki-outline ki-cross fs-2"></i>
											</span>
											<!--end::Remove-->
										</div>
										<!--end::Image input-->

									</div>
									<!--end::Image input wrapper-->
								</div>
								<!--end::Input group-->
								<!--begin::Row-->
								<div class="row row-cols-1 row-cols-sm-2 rol-cols-md-1 row-cols-lg-2">
									<!--begin::Col-->
									<div class="col">
										<!--begin::Input group-->
										<div class="fv-row mb-7">
											<!--begin::Label-->
											<label class="fs-6 fw-semibold form-label mt-3">
												<span class="required">@CrossBuy.Resources.SharedResources.CompanyNameAr</span>

											</label>
											<!--end::Label-->
											<!--begin::Input-->
											<input type="text" placeholder="@CrossBuy.Resources.SharedResources.CompanyNameAr" asp-for="CompanyNameAr"  class="form-control" />

											<!--end::Input-->
										</div>
										<!--end::Input group-->
									</div>
									<!--end::Col-->
									<!--begin::Col-->
									<div class="col">
										<!--begin::Input group-->
										<div class="fv-row mb-7">
											<!--begin::Label-->
											<label class="fs-6 fw-semibold form-label mt-3">
												<span class="required">@CrossBuy.Resources.SharedResources.CompanyNameEn</span>
												
											</label>
											<!--end::Label-->
											<!--begin::Input-->
											<input type="text" placeholder="@CrossBuy.Resources.SharedResources.CompanyNameEn" asp-for="CompanyName" class="form-control" />
											
											<!--end::Input-->
										</div>
										<!--end::Input group-->
									</div>
									<!--end::Col-->
								</div>
								<!--end::Row-->
								<!--begin::Row-->
								<div class="row row-cols-1 row-cols-sm-2 rol-cols-md-1 row-cols-lg-2">
									<!--begin::Col-->
									<div class="col">
										<!--begin::Input group-->
										<div class="fv-row mb-7">
											<!--begin::Label-->
											<label class="fs-6 fw-semibold form-label mt-3">
												<span class="required">@CrossBuy.Resources.SharedResources.CompanyType</span>

											</label>
											<!--end::Label-->
											<!--begin::Input-->
											<select class="form-select form-select" data-control="select2" id="CompanyTypeId" name="CompanyTypeId" data-placeholder="@CrossBuy.Resources.SharedResources.ChooseItem">
												@foreach (var item in Model.companyTypes)
												{
													if ((System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"))
													{
														<option value="@item.Id">@item.NameAr</option>
													}
													else
													{
														<option value="@item.Id">@item.NameEn</option>
													}
												}
											</select>
											<!--end::Input-->

											<script>
												document.addEventListener('DOMContentLoaded', function () {
													var selectedCompanyTypeId = '@Model.CompanyTypeId';

													var selectElement = document.getElementById('CompanyTypeId');

													if (selectedCompanyTypeId) {
														selectElement.value = selectedCompanyTypeId;
													}
												});
											</script>

										</div>
										<!--end::Input group-->
									</div>
									<!--end::Col-->
									<!--begin::Col-->
									<div class="col">
										<!--begin::Input group-->
										<div class="fv-row mb-7">
											<!--begin::Label-->
											<label class="fs-6 fw-semibold form-label mt-3">
												<span class="required">@CrossBuy.Resources.SharedResources.Country</span>

											</label>
											<select class="form-select form-select" id="CountryID" name="SelectedCountryID" data-control="select2" data-placeholder="@CrossBuy.Resources.SharedResources.ChooseItem">
												@foreach (var item in Model.countriesLookups)
												{
													if (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar")
													{
														<option value="@item.ID">@item.CountryNameAr</option>
													}
													else
													{
														<option value="@item.ID">@item.CountryName</option>
													}
												}
											</select>

											<script>
												document.addEventListener('DOMContentLoaded', function () {
													// Get the selected country ID from the model
													var selectedCountryId = '@Model.CountryID';

													// Get the select element
													var selectElement = document.getElementById('CountryID');

													// Set the selected option
													if (selectedCountryId) {
														selectElement.value = selectedCountryId;
													}
												});
											</script>




										</div>
										<!--end::Input group-->
									</div>
									<!--end::Col-->
								</div>
								<!--end::Row-->
								<!--begin::Row-->
								<div class="row ">
									
									<!--begin::Col-->
									<div class="col-12">
										<!--begin::Input group-->
										<div class="fv-row mb-7">
											<!--begin::Label-->
											<label class="fs-6 fw-semibold form-label mt-3">
												<span class="required">@CrossBuy.Resources.SharedResources.Address</span>

