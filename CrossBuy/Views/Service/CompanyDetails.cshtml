													<!--begin::Col-->
													<div class="col">
														<!--begin::Input group-->
														<div class="fv-row mb-7">
															<!--begin::Label-->
															<label class="fs-6 fw-semibold form-label mt-3">
																<span >@CrossBuy.Resources.SharedResources.RegistrationNumber</span>
																
															</label>
															<!--end::Label-->
															<!--begin::Input-->
															<input type="text" placeholder="@CrossBuy.Resources.SharedResources.RegistrationNumber" asp-for="RegistrationNumber" class="form-control" />

															<!--end::Input-->
														</div>
														<!--end::Input group-->
													</div>
													<!--end::Col-->
													<!--begin::Col-->
													<div class="col">
														<!--begin::Input group-->
														<div class="fv-row mb-7">
															<!--begin::Label-->
															<label class="fs-6 fw-semibold form-label mt-3">
																<span>@CrossBuy.Resources.SharedResources.TaxNumber</span>
																
															</label>
															<!--end::Label-->
