@model CrossBuy.ViewModel.LoginViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
	Layout = null;
}


<html lang="@Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName" dir="@(Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<!--begin::Head-->
<head>
	<base href="/" />
	<title>@CrossBuy.Resources.SharedResources.SignInTitle — @CrossBuy.BL.Platform.ProductIdentity.Name</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	@* A SIGN-IN PAGE IS NOT A LANDING PAGE. It has nothing to rank for and every reason not to be
	   indexed, so the description, keywords, og: tags and canonical link that used to live here -
	   all of them Metronic's own demo metadata, pointing a search engine at keenthemes.com - are
	   replaced by the one directive that is actually true of this page. *@
	<meta name="robots" content="noindex, nofollow" />
	<link rel="shortcut icon" href="@CrossBuy.BL.Platform.ProductIdentity.Assets.FaviconIco" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="@CrossBuy.BL.Platform.ProductIdentity.Assets.Icon" asp-append-version="true" />
	<!--begin::Fonts(mandatory for all pages)-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
	<!--end::Fonts-->
	<!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
	@if ((System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"))
	{
		<link href="~/Backend-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
		<link href="~/Backend-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="~/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />
		<style>
			/* Served from this application, not fetched from Google: the sign-in screen is the one
			   page that must render correctly with no route to the internet. */
			@@font-face {
				font-family: 'Cairo';
				src: url('@Url.Content("~/Backend-assets/fonts/cairo/Cairo-Regular.ttf")') format('truetype');
				font-weight: 400;
				font-display: swap;
			}

			@@font-face {
				font-family: 'Cairo';
				src: url('@Url.Content("~/Backend-assets/fonts/cairo/Cairo-SemiBold.ttf")') format('truetype');
				font-weight: 600;
				font-display: swap;
			}

			@@font-face {
				font-family: 'Cairo';
				src: url('@Url.Content("~/Backend-assets/fonts/cairo/Cairo-Bold.ttf")') format('truetype');
				font-weight: 700;
				font-display: swap;
			}

			/* 600 AND 800 ARE REAL FACES, NOT SYNTHESISED ONES. The page asks for both; with only 400
			   and 700 served the browser smeared the 700 outline to fake them, which on a connected
			   script reads as blurred rather than as a heavier cut. */
			@@font-face {
				font-family: 'Cairo';
				src: url('@Url.Content("~/Backend-assets/fonts/cairo/Cairo-ExtraBold.ttf")') format('truetype');
				font-weight: 800;
				font-display: swap;
			}

			/* A real fallback chain rather than bare Arial: if the face somehow fails, the next
			   name is a system Arabic face, not a Latin one. */
			html[lang="ar"] body {
				font-family: 'Cairo', 'Segoe UI', Tahoma, sans-serif;
				direction: rtl;
				text-align: right;
			}
		</style>

	}
	else
	{
		<link href="~/Backend-assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
		<link href="~/Backend-assets/css/style.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="~/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	}


	<style>
		/* ==========================================================================================
		   THE SIGN-IN PAGE (2026-11-22) — the mobile prototype's sign-in, carried to the web.

		   ONE PICTURE, ONE FORM. The brand's own login scene (login-scene.png) under a FLAT navy veil
		   carries the white logo and the promise; beside it — or, on a phone, rising over it as a sheet
		   with rounded shoulders — the form sits on the page colour with nothing around it.
		   Navy #1F2D4D, blue #3A5795, support #637BAD, page #F5F7FB, line #E8ECF3, one thin gold rule.
		   No gradient anywhere: the owner rejected gradient heroes.

		   EVERY DIRECTIONAL RULE IS LOGICAL (inset-inline-*, margin-inline-*), so one stylesheet serves
		   Arabic and English with no mirrored copy. Sizes are pixels: Metronic sets the root to 13px.
		   ========================================================================================== */
		:root {
			--cb-navy:    @CrossBuy.BL.Platform.ProductIdentity.Palette.Dark;
			--cb-blue:    @CrossBuy.BL.Platform.ProductIdentity.Palette.Primary;
			--cb-support: #637BAD;
			--cb-gold:    #D4AF37;
			--cb-page:    #F5F7FB;
			--cb-line:    #E8ECF3;
			--cb-ink:     #1F2D4D;
			--cb-muted:   #738098;
		}
		html, body { height: 100%; }
		body { background: var(--cb-page); }

		.cb-page { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(480px, 44%); }

		/* ---------- the picture ------------------------------------------------------------------ */
		.cb-hero {
			position: relative; overflow: hidden; color: #fff;
			background: var(--cb-navy) url('@Url.Content("~/Backend-assets/media/brand/login-scene.png")') 70% 40% / cover no-repeat;
		}
		.cb-hero::before { content: ""; position: absolute; inset: 0; background: rgba(31,45,77,.62); }
		.cb-hero-inner {
			position: relative; height: 100%; min-height: 100vh; display: flex; flex-direction: column;
			padding: 56px 64px 40px; max-width: 760px;
		}
		.cb-hero-logo { width: 300px; max-width: 70%; height: auto; display: block; }
		.cb-motto { margin-top: 18px; font-size: 14px; color: #C9D4EA; letter-spacing: .02em; }
		.cb-motto::after { content: ""; display: block; width: 34px; height: 2px; border-radius: 2px; background: var(--cb-gold); margin-top: 16px; }
		.cb-hero-copy { margin-top: auto; margin-bottom: auto; padding: 40px 0; }
		.cb-headline { color: #fff; font-weight: 800; font-size: 46px; line-height: 1.2; margin: 0; letter-spacing: -.02em; }
		html[lang="ar"] .cb-headline { letter-spacing: normal; line-height: 1.4; }
		.cb-headline .cb-accent { color: #AFC3EA; }
		.cb-sub { margin: 18px 0 0; font-size: 17px; line-height: 1.7; color: #D4DFF5; }
		.cb-hero-foot { font-size: 12px; color: #BDC9E0; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
		.cb-hero-foot .sep { opacity: .5; }

		/* ---------- the form side ---------------------------------------------------------------- */
		.cb-side { background: var(--cb-page); display: flex; flex-direction: column; padding: 32px 56px 24px; }
		.cb-side-top { display: flex; justify-content: flex-end; }
		.cb-form-wrap { margin: auto 0; width: 100%; max-width: 420px; margin-inline: auto; padding: 32px 0; }
		.cb-card-title { color: var(--cb-ink); font-weight: 700; font-size: 30px; line-height: 1.3; margin: 0; }
		.cb-card-sub { color: var(--cb-muted); font-size: 14px; margin: 6px 0 26px; }

		/* the language menu — a tinted trigger and a sheet anchored to it */
		.cb-lang { position: relative; }
		.cb-lang-btn {
			height: 34px; padding: 0 8px 0 12px; border: 1px solid var(--cb-line); border-radius: 10px;
			background: #fff; color: var(--cb-ink); display: inline-flex; align-items: center; gap: 6px;
			font-size: 13px; font-weight: 600;
		}
		.cb-lang-btn:hover, .cb-lang-btn[aria-expanded="true"] { border-color: #C9D3E6; }
		.cb-lang-caret { width: 15px; height: 15px; flex: 0 0 15px; transition: transform .15s ease; }
		.cb-lang-btn[aria-expanded="true"] .cb-lang-caret { transform: rotate(180deg); }
		.cb-lang-menu {
			position: absolute; top: calc(100% + 7px); inset-inline-end: 0; z-index: 20; min-width: 186px;
			background: #fff; border: 1px solid var(--cb-line); border-radius: 14px; box-shadow: 0 16px 38px rgba(31,45,77,.12); padding: 6px;
		}
		.cb-lang-item { display: flex; align-items: center; gap: 10px; padding: 9px 11px; border-radius: 10px; color: var(--cb-ink); font-size: 14px; font-weight: 600; text-decoration: none; }
		.cb-lang-item img { width: 20px; height: 20px; border-radius: 4px; flex: 0 0 20px; }
		.cb-lang-item:hover { background: #F4F7FC; color: var(--cb-blue); }
		.cb-lang-item.on { background: #EDF1F8; color: var(--cb-blue); }

		/* fields: white, a 1px line, radius 14, the icon at the start edge and the eye at the end */
		.cb-field { position: relative; margin-bottom: 12px; }
		.cb-field .form-control {
			height: 56px; border-radius: 14px; background: #fff; border: 1px solid var(--cb-line);
			font-size: 15px; color: var(--cb-ink); padding-inline-start: 48px; padding-inline-end: 16px;
		}
		.cb-field .form-control:focus { border-color: var(--cb-blue); box-shadow: 0 0 0 3px rgba(58,87,149,.10); }
		.cb-field .form-control::placeholder { color: #8A96AD; }
		.cb-field-icon { position: absolute; inset-inline-start: 16px; top: 50%; transform: translateY(-50%); color: var(--cb-support); font-size: 20px; pointer-events: none; }
		.cb-pass-wrap .form-control { padding-inline-end: 52px; }
		.cb-pass-wrap .form-control::-ms-reveal, .cb-pass-wrap .form-control::-ms-clear { display: none; width: 0; height: 0; }
		.cb-pass-wrap .form-control::-webkit-credentials-auto-fill-button,
		.cb-pass-wrap .form-control::-webkit-strong-password-auto-fill-button { visibility: hidden; pointer-events: none; width: 0; margin: 0; }
		.cb-pass-toggle {
			position: absolute; inset-inline-end: 8px; top: 50%; transform: translateY(-50%); width: 38px; height: 38px;
			display: flex; align-items: center; justify-content: center; border: 0; background: transparent; color: var(--cb-muted); border-radius: 10px;
		}
		.cb-pass-toggle svg { width: 19px; height: 19px; display: block; }
		.cb-pass-toggle:hover, .cb-pass-toggle:focus { color: var(--cb-blue); background: #EDF1F8; }

		.cb-remember-row { margin: 4px 0 22px; }
		.cb-check { padding-inline-start: 0; padding-left: 0; margin: 0; min-height: 0; }
		.cb-check .form-check-input { width: 19px; height: 19px; border-radius: 5px; border: 1.5px solid #C3CEE0; margin: 0; float: none; }
		.cb-check .form-check-input:checked { background-color: var(--cb-blue); border-color: var(--cb-blue); }
		.cb-check .form-check-label { color: var(--cb-ink); font-size: 14px; }
		.cb-link { color: var(--cb-blue); font-size: 14px; font-weight: 600; text-decoration: none; cursor: help; }

		/* the button: flat navy, never a gradient */
		.cb-submit {
			height: 54px; width: 100%; border: 0; border-radius: 14px; color: #fff; background: var(--cb-navy);
			font-size: 16px; font-weight: 600; display: flex; align-items: center; justify-content: center;
		}
		.cb-submit:hover { background: #16213A; color: #fff; }
		.cb-submit:disabled { opacity: .75; }
		.cb-submit-label { display: inline-flex; align-items: center; gap: 10px; }
		.cb-submit .cb-go { font-size: 18px; color: #fff; transition: transform .15s ease; }
		html[dir="rtl"] .cb-submit .cb-go { transform: scaleX(-1); }

		/* single sign-on (Views/Shared/Components/ExternalSignIn) */
		.cb-or { display: flex; align-items: center; gap: 12px; color: var(--cb-muted); font-size: 12px; margin: 22px 0 16px; }
		.cb-or::before, .cb-or::after { content: ""; height: 1px; background: var(--cb-line); flex: 1 1 auto; }
		.cb-sso {
			height: 50px; border: 1px solid var(--cb-line); border-radius: 14px; background: #fff; width: 100%;
			display: flex; align-items: center; justify-content: center; gap: 10px; font-weight: 500; font-size: 14px; color: var(--cb-ink); text-decoration: none;
		}
		.cb-sso:hover { border-color: #C9D3E6; color: var(--cb-ink); }
		.cb-sso svg { width: 20px; height: 20px; flex: 0 0 20px; }
		.cb-card-foot { margin-top: 26px; text-align: center; font-size: 13px; color: var(--cb-muted); }

		.cb-side-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 12px; color: var(--cb-muted); }
		.cb-side-foot span { display: inline-flex; align-items: center; gap: 6px; }

		.cb-error { border: 1px dashed #E3A7A5; background: #FBECEC; color: #B4322E; border-radius: 12px; padding: 12px 14px; font-size: 14px; }
		.cb-caps { color: var(--cb-blue); font-size: 13px; font-weight: 600; }

		/* ==========================================================================================
		   PHONES AND NARROW WINDOWS — exactly the mobile prototype: the picture becomes a band at the
		   top with the logo, and the form rises over it as a sheet with rounded shoulders.
		   ========================================================================================== */
		@@media (max-width: 991.98px) {
			.cb-page { display: flex; flex-direction: column; }
			.cb-hero-inner { min-height: 0; height: 270px; padding: 40px 24px 0; align-items: center; text-align: center; max-width: none; }
			.cb-hero-logo { width: 220px; }
			.cb-motto::after { margin-inline: auto; }
			.cb-hero-copy, .cb-hero-foot { display: none; }
			.cb-side { flex: 1; margin-top: -32px; position: relative; border-radius: 28px 28px 0 0; padding: 22px 22px 18px; }
			.cb-form-wrap { margin-top: 0; padding: 4px 0 24px; }
			.cb-card-title { font-size: 24px; }
		}
		@@media (max-width: 1399.98px) and (min-width: 992px) {
			.cb-hero-inner { padding: 44px 48px 32px; }
			.cb-headline { font-size: 38px; }
			.cb-side { padding: 28px 40px 22px; }
		}
	</style>
	<!--end::Global Stylesheets Bundle-->
	<script>
		// Frame-busting: refuse to render inside someone else's frame (click-jacking).
		// This whole block used to be one line BEHIND this comment, so it never executed once.
		// It is a fallback: the real defence is an X-Frame-Options / CSP frame-ancestors response
		// header, which does not depend on the framing page allowing this script to run.
		if (window.top != window.self) { window.top.location.replace(window.self.location.href); }
	</script>
</head>
<body id="kt_body" class="app-blank">
	<script>var defaultThemeMode = "light"; var themeMode; if (document.documentElement) { if (document.documentElement.hasAttribute("data-bs-theme-mode")) { themeMode = document.documentElement.getAttribute("data-bs-theme-mode"); } else { if (localStorage.getItem("data-bs-theme") !== null) { themeMode = localStorage.getItem("data-bs-theme"); } else { themeMode = defaultThemeMode; } } if (themeMode === "system") { themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; } document.documentElement.setAttribute("data-bs-theme", themeMode); }</script>

	@{
		var arabic = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
		var langCode = arabic ? "AR" : (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr" ? "FR" : "EN");
	}

	<div class="cb-page" id="kt_app_root">

		@* ================================ THE PICTURE ================================ *@
		<aside class="cb-hero">
			<div class="cb-hero-inner">
				<img alt="@CrossBuy.BL.Platform.ProductIdentity.Name" src="@CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnDark"
					 class="cb-hero-logo" asp-append-version="true" />
				<div class="cb-motto">@CrossBuy.Resources.SharedResources.BrandTagline</div>

				<div class="cb-hero-copy">
					<h1 class="cb-headline">
						@CrossBuy.Resources.SharedResources.BrandHeadlineLead
						<br /><span class="cb-accent">@CrossBuy.Resources.SharedResources.BrandHeadlineAccent</span>
					</h1>
					<p class="cb-sub">
						@CrossBuy.Resources.SharedResources.BrandSubLine1
						<br />@CrossBuy.Resources.SharedResources.BrandSubLine2
					</p>
				</div>

				<div class="cb-hero-foot">
					<span>&copy; @DateTime.Now.Year @(CrossBuy.BL.Platform.ProductIdentity.Name). @CrossBuy.Resources.SharedResources.AllRightsReserved</span>
					<span class="sep">·</span><span>@CrossBuy.Resources.SharedResources.BrandFootline</span>
				</div>
			</div>
		</aside>

		@* ================================ THE FORM ================================ *@
		<main class="cb-side">
			@* ---- THE LANGUAGE CONTROL: a menu (takes any number of languages), anchored to its own
			   button; the list is a collection, so adding a language is one entry. *@
			@{
				var languages = new (string Code, string Culture, string Name, string Flag)[]
				{
					("EN", "en", CrossBuy.Resources.SharedResources.LanguageNameEn, "united-states"),
					("AR", "ar", CrossBuy.Resources.SharedResources.LanguageNameAr, "saudi-arabia"),
					("FR", "fr", CrossBuy.Resources.SharedResources.LanguageNameFr, "france"),
				};
			}
			<div class="cb-side-top">
				<div class="cb-lang">
					<button type="button" class="cb-lang-btn" id="cb-lang-toggle"
							aria-haspopup="true" aria-expanded="false"
							aria-label="@CrossBuy.Resources.SharedResources.Language">
						<span>@langCode</span>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="cb-lang-caret">
							<path d="M6 9.5 12 15l6-5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</button>
					<div class="cb-lang-menu" id="cb-lang-menu" hidden role="menu">
						@foreach (var lang in languages)
						{
							<a asp-controller="Account" asp-action="SetLanguage" asp-route-culture="@lang.Culture"
							   asp-route-returnUrl="@Context.Request.Path" role="menuitem"
							   class="cb-lang-item @(langCode == lang.Code ? "on" : "")">
								<img src="~/Backend-assets/media/flags/@(lang.Flag).svg" alt="" />
								<span>@lang.Name</span>
							</a>
						}
					</div>
				</div>
			</div>

			<div class="cb-form-wrap">
				<h2 class="cb-card-title">@CrossBuy.Resources.SharedResources.WelcomeBackLead @CrossBuy.Resources.SharedResources.WelcomeBackAccent</h2>
				<div class="cb-card-sub">@CrossBuy.Resources.SharedResources.SignInToYourAccount</div>

				@* A refusal lands here, with the caret returned to the field that has to change. *@
				@{ var ssoError = TempData["ExternalSignInError"] as string; }
				<div id="cb-login-error" class="cb-error @(string.IsNullOrEmpty(ssoError) ? "d-none" : "") mb-5" role="alert" aria-live="assertive">@ssoError</div>

				<form id="loginForm" method="post">
					<input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"])" />

					@* "USER NAME", NOT "USERNAME OR EMAIL": AccountController looks the user up with
					   FindUserByNameAsync, so an e-mail typed here would be refused. *@
					<div class="cb-field">
						<i class="ki-outline ki-user cb-field-icon"></i>
						<input type="text" asp-for="UserName" autocomplete="username" autofocus
							   class="form-control" placeholder="@CrossBuy.Resources.SharedResources.UserName"
							   aria-label="@CrossBuy.Resources.SharedResources.UserName" />
					</div>

					<div class="cb-field cb-pass-wrap">
						<i class="ki-outline ki-lock-2 cb-field-icon"></i>
						<input type="password" asp-for="Password" autocomplete="current-password"
							   class="form-control" placeholder="@CrossBuy.Resources.SharedResources.Password"
							   aria-label="@CrossBuy.Resources.SharedResources.Password" />
						<button type="button" id="cb-pass-toggle" class="cb-pass-toggle"
								aria-controls="Password" aria-pressed="false"
								title="@CrossBuy.Resources.SharedResources.ShowPassword"
								aria-label="@CrossBuy.Resources.SharedResources.ShowPassword">
							@Html.Raw(CrossBuy.Views.Account.LoginIcons.EyeOff)
						</button>
					</div>

					<div id="cb-caps" class="cb-caps d-none mb-2">
						<i class="ki-outline ki-information-5 fs-6 me-1"></i>@CrossBuy.Resources.SharedResources.CapsLockOn
					</div>

					<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 cb-remember-row">
						<label class="form-check cb-check d-flex align-items-center gap-2 m-0 cursor-pointer">
							<input class="form-check-input m-0" type="checkbox" asp-for="RememberMe" checked />
							<span class="form-check-label cursor-pointer">@CrossBuy.Resources.SharedResources.RememberMeShort</span>
						</label>
						<span class="cb-link" role="note" title="@CrossBuy.Resources.SharedResources.ForgotPasswordHelp">@CrossBuy.Resources.SharedResources.ForgotPasswordQ</span>
					</div>

					<button type="submit" id="cb-login-submit" class="cb-submit" data-kt-indicator="off">
						<span class="indicator-label cb-submit-label">
							<span>@CrossBuy.Resources.SharedResources.SignInAction</span>
							<i class="ki-outline ki-arrow-right cb-go"></i>
						</span>
						<span class="indicator-progress">
							@CrossBuy.Resources.SharedResources.SigningIn
							<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
						</span>
					</button>
				</form>

				@* Single sign-on, rendered from the schemes this installation has configured. *@
				@await Component.InvokeAsync("ExternalSignIn")

				<div class="cb-card-foot">
					@CrossBuy.Resources.SharedResources.NewToCrossBuy
					<span class="cb-link" title="@CrossBuy.Resources.SharedResources.ForgotPasswordHelp">@CrossBuy.Resources.SharedResources.ContactYourAdministrator</span>
				</div>
			</div>

			<div class="cb-side-foot">
				<span><i class="ki-outline ki-shield-tick fs-5"></i>@CrossBuy.Resources.SharedResources.TrustSecure · @CrossBuy.Resources.SharedResources.TrustReliable · @CrossBuy.Resources.SharedResources.TrustScalable</span>
				<span>&copy; @DateTime.Now.Year @(CrossBuy.BL.Platform.ProductIdentity.Name)</span>
			</div>
		</main>
	</div>
	<!--end::Root-->
	<!--begin::Javascript-->
	<script>var hostUrl = "~/Backend-assets/";</script>
	<!--begin::Global Javascript Bundle(mandatory for all pages)-->
	<script src="~/Backend-assets/plugins/global/plugins.bundle.js" asp-append-version="true"></script>
	<script src="~/Backend-assets/js/scripts.bundle.js" asp-append-version="true"></script>
	<!--end::Global Javascript Bundle-->
	<!--begin::Custom Javascript(used for this page only)-->
	<script src="~/Backend-assets/js/custom/authentication/sign-in/general.js" asp-append-version="true"></script>
	<!--end::Custom Javascript-->
	<!--end::Javascript-->
</body>
<!--end::Body-->
</html>

<script>
	document.querySelectorAll('[data-kt-lang]').forEach(link => {
		link.addEventListener('click', function (e) {
			e.preventDefault();
			window.location.href = this.href;
		});
	});
</script>

<script>
	(function () {
		"use strict";

		var form = document.getElementById("loginForm");
		if (!form) { return; }

		var pass = document.getElementById("Password");
		var user = document.getElementById("UserName");
		var box = document.getElementById("cb-login-error");
		var submit = document.getElementById("cb-login-submit");

		var SHOW = "@CrossBuy.Resources.SharedResources.ShowPassword";
		var HIDE = "@CrossBuy.Resources.SharedResources.HidePassword";
		var FAILED = "@CrossBuy.Resources.SharedResources.SignInFailed";
		var GENERIC = "@CrossBuy.Resources.SharedResources.SignInErrorGeneric";

		// ---- THE LANGUAGE MENU -----------------------------------------------------------------
		// Escape and a click outside both close it: a menu that can only be dismissed by choosing
		// from it is a trap for anyone who opened it by accident.
		var langBtn = document.getElementById("cb-lang-toggle");
		var langMenu = document.getElementById("cb-lang-menu");
		if (langBtn && langMenu) {
			var setLangOpen = function (open) {
				langMenu.hidden = !open;
				langBtn.setAttribute("aria-expanded", open ? "true" : "false");
			};
			langBtn.addEventListener("click", function (e) { e.stopPropagation(); setLangOpen(langMenu.hidden); });
			document.addEventListener("click", function (e) {
				if (!langMenu.hidden && !langMenu.contains(e.target)) { setLangOpen(false); }
			});
			document.addEventListener("keydown", function (e) { if (e.key === "Escape") { setLangOpen(false); } });
		}

		// ---- SHOW WHAT I TYPED -----------------------------------------------------------------
		// The two shapes the reveal control swaps between. Drawn rather than taken from the icon
		// font: it ships one eye and one eye-slash, both a decade old in shape, and neither matches
		// anything else on this card.
		var EYE_ON = @Html.Raw(Json.Serialize(CrossBuy.Views.Account.LoginIcons.EyeOn));
		var EYE_OFF = @Html.Raw(Json.Serialize(CrossBuy.Views.Account.LoginIcons.EyeOff));

		var toggle = document.getElementById("cb-pass-toggle");
		if (toggle && pass) {
			toggle.addEventListener("click", function () {
				// The state the field ENDS in — which is what the icon, the label and aria-pressed all
				// have to describe. Reading the state it is leaving is what made the icon look stuck.
				var visible = pass.type !== "text";
				pass.type = visible ? "text" : "password";
				toggle.setAttribute("aria-pressed", visible ? "true" : "false");
				toggle.setAttribute("aria-label", visible ? HIDE : SHOW);
				toggle.title = visible ? HIDE : SHOW;
				toggle.innerHTML = visible ? EYE_ON : EYE_OFF;
				// The caret goes back where it was, or revealing the password costs the user their place.
				pass.focus();
			});
		}

		// ---- CAPS LOCK -------------------------------------------------------------------------
		// getModifierState is the only honest source: inferring it from which case arrives is wrong
		// for every keyboard layout that is not Latin, and this product's users type Arabic.
		var caps = document.getElementById("cb-caps");
		if (caps && pass) {
			var readCaps = function (ev) {
				if (!ev.getModifierState) { return; }
				caps.classList.toggle("d-none", !ev.getModifierState("CapsLock"));
			};
			pass.addEventListener("keydown", readCaps);
			pass.addEventListener("keyup", readCaps);
			pass.addEventListener("blur", function () { caps.classList.add("d-none"); });
		}

		// ---- A REFUSAL YOU CAN READ ------------------------------------------------------------
		// The modal is gone. A wrong password is an ordinary event on a sign-in form, and answering it
		// with a dialog that must be dismissed puts a click between the user and the field they have to
		// correct. This says what happened where it happened, and puts the caret back in the password.
		function clearError() {
			if (!box) { return; }
			box.classList.add("d-none");
			box.textContent = "";
		}

		function showError(message) {
			if (!box) { return; }
			box.textContent = message || GENERIC;
			box.classList.remove("d-none");
			if (pass) { pass.focus(); pass.select(); }
		}

		[user, pass].forEach(function (el) {
			if (el) { el.addEventListener("input", clearError); }
		});

		// ---- ONE SUBMIT AT A TIME --------------------------------------------------------------
		var busy = false;
		function setBusy(on) {
			busy = on;
			if (!submit) { return; }
			submit.setAttribute("data-kt-indicator", on ? "on" : "off");
			submit.disabled = on;
		}

		form.addEventListener("submit", function (e) {
			e.preventDefault();
			if (busy) { return; }        // a slow network used to mean two sign-in attempts
			clearError();
			setBusy(true);

			fetch("/Account/Login", {
				method: "POST",
				credentials: "same-origin",
				headers: { "X-Requested-With": "XMLHttpRequest" },
				body: new FormData(form)
			})
				.then(function (r) {
					// r.text() THEN parse, never r.json() straight: a 500 or a login-page redirect answers
					// with HTML, r.json() rejects, and the screen reports nothing at all.
					return r.text().then(function (body) {
						try { return { ok: r.ok, data: JSON.parse(body) }; }
						catch (ignored) { return { ok: false, data: null }; }
					});
				})
				.then(function (res) {
					var d = res.data;
					if (d && d.success && d.redirectUrl) { window.location.href = d.redirectUrl; return; }

					setBusy(false);
					// `d.errors.join(...)` threw here whenever the server sent neither a message nor an
					// errors array — so the one case that most needed a message showed none.
					var message = (d && d.message)
						|| (d && d.errors && d.errors.length ? d.errors.join(" · ") : "")
						|| (FAILED + " — " + GENERIC);
					showError(message);
				})
				.catch(function () {
					setBusy(false);
					showError(GENERIC);
				});
		});
	})();
</script>




