@using CrossBuy.ViewModel
@model EmployeeViewModel
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = isAr ? "اشتراكي" : "My Subscription";
    var modules = new (string ar, string en, string icon)[]
    {
        ("النظام المحاسبي", "Accounting", "ki-bank"),
        ("المخزون والمستودعات", "Inventory & Warehouses", "ki-handcart"),
        ("المبيعات وإدارة العلاقات", "Sales & CRM", "ki-basket"),
        ("المشتريات والموردين", "Procurement", "ki-purchase"),
        ("الموارد البشرية والرواتب", "HR & Payroll", "ki-people"),
        ("التصنيع", "Manufacturing", "ki-gear"),
        ("نقاط البيع", "Point of Sale", "ki-scan-barcode"),
        ("الرؤى الذكية (AI)", "AI Insights", "ki-abstract-26"),
    };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isAr ? "اشتراكي" : "My Subscription")</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Profile","Account")" class="text-muted">@(isAr ? "حسابي" : "My Account")</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@(isAr ? "الاشتراك" : "Subscription")</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <div class="card mb-5" style="background:linear-gradient(90deg,#13433a,#1f6253);">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between p-9">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <span class="text-white fw-bold fs-1">CrossBuy</span>
                        <span class="badge fw-bold fs-7 px-3 py-2" style="background:rgba(255,255,255,.18);color:#fff;">@(isAr ? "احترافي" : "Professional")</span>
                    </div>
                    <div class="text-white opacity-75 fw-semibold fs-6">@(isAr ? "خطة الأعمال الكاملة — كل الوحدات مفعّلة" : "Full business plan — all modules enabled")</div>
                </div>
                <div class="text-end">
                    <span class="badge fw-bold fs-6 px-4 py-2" style="background:#ffffff;color:#13433a;"><i class="ki-outline ki-check-circle fs-4 me-1" style="color:#13433a;"></i>@(isAr ? "نشط" : "Active")</span>
                </div>
            </div>
        </div>

        <div class="row g-5 mb-5">
            <div class="col-md-4"><div class="card card-flush h-100"><div class="card-body py-6"><div class="text-muted fs-7">@(isAr ? "الخطة" : "Plan")</div><div class="fw-bold fs-3 text-gray-900">@(isAr ? "احترافي" : "Professional")</div></div></div></div>
            <div class="col-md-4"><div class="card card-flush h-100"><div class="card-body py-6"><div class="text-muted fs-7">@(isAr ? "الوحدات المفعّلة" : "Enabled modules")</div><div class="fw-bold fs-3" style="color:#13433a;">@modules.Length</div></div></div></div>
            <div class="col-md-4"><div class="card card-flush h-100"><div class="card-body py-6"><div class="text-muted fs-7">@(isAr ? "الحالة" : "Status")</div><div class="fw-bold fs-3" style="color:#13433a;">@(isAr ? "نشط" : "Active")</div></div></div></div>
        </div>

        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><h3 class="fw-bold">@(isAr ? "الوحدات المتاحة في خطتك" : "Modules included in your plan")</h3></div></div>
            <div class="card-body pt-2 pb-6"><div class="row g-4">
                @foreach (var m in modules)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="d-flex align-items-center rounded p-4 h-100" style="background:#f8faf9;">
                            <span class="symbol symbol-45px me-3"><span class="symbol-label" style="background:#e9f1ee;"><i class="ki-outline @m.icon fs-2" style="color:#13433a;"></i></span></span>
                            <span class="fw-bold text-gray-900 flex-grow-1">@(isAr ? m.ar : m.en)</span>
                            <i class="ki-outline ki-check-circle fs-3" style="color:#13433a;"></i>
                        </div>
                    </div>
                }
            </div></div>
        </div>
    </div></div>
</div>
