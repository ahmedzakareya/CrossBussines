@using CrossBuy.Models.Context.Pos
@using CrossBuy.Controllers
@using CrossBuy.Models.Context.Admin
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    ViewData["Title"] = isAr ? "لوحة الهايبر ماركت" : "Hypermarket dashboard";

    var branches = ViewBag.HyperBranches as List<HyperController.HyperBranchItem> ?? new();
    var noBranch = ViewBag.NoBranch as bool? ?? false;
    var branch = ViewBag.Branch as Branch;
    var caps = ViewBag.Caps as List<HyperController.HyperCapRow> ?? new();
    var hasCapConfig = ViewBag.HasCapConfig as bool? ?? true;
    var setting = ViewBag.Setting as BranchPosSetting;
    var terminals = ViewBag.Terminals as List<PosTerminal> ?? new();
    var open = ViewBag.OpenShifts as Dictionary<int, PosShift?> ?? new();
    var openCount = open.Values.Count(s => s != null);
    var onCount = caps.Count(c => c.On);
    string bName = branch == null ? "" : (isAr ? (branch.NameAr ?? branch.Name) : (branch.Name ?? branch.NameAr)) ?? "";
    string T(string ar, string en) => isAr ? ar : en;
}

<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@ViewData["Title"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">@T("الرئيسية", "Home")</li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@T("حالة النظام", "System status")</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                @if (branches.Count > 1)
                {
                    <form method="get" class="d-flex align-items-center gap-2">
                        <label class="fs-7 text-muted fw-semibold">@T("الفرع", "Branch")</label>
                        <select name="branchId" class="form-select form-select-sm form-select-solid w-200px" onchange="this.form.submit()">
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id" selected="@(branch != null && branch.ID == b.Id)">@(isAr ? (b.NameAr ?? b.Name) : (b.Name ?? b.NameAr))</option>
                            }
                        </select>
                    </form>
                }
                <a href="/hyper/pos/login" class="btn btn-sm btn-primary fw-bold"><i class="ki-outline ki-entrance-right fs-3"></i>@T("ممرّ الكاشير", "Cashier lane")</a>
            </div>
        </div>
    </div>
    <!--end::Toolbar-->

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

        @if (noBranch)
        {
            <div class="notice d-flex bg-light-success rounded border-success border border-dashed p-6">
                <i class="ki-outline ki-basket fs-2tx me-4" style="color:#1f7d57"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                    <div class="mb-3 mb-md-0">
                        <h4 class="text-gray-900 fw-bold">@T("لا يوجد فرع هايبر بعد", "No hypermarket branch yet")</h4>
                        <div class="fs-6 text-gray-700">@T("شغّل بيانات التأسيس التطويرية: GET /api/dev/hyper-hm0-seed?key=seed123", "Run the dev seed: GET /api/dev/hyper-hm0-seed?key=seed123")</div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!--begin::Row 1 — capabilities readiness + branch status card-->
            <div class="row g-5 gx-xl-10 mb-5 mb-xl-10">
                <div class="col-xl-8">
                    <div class="card card-flush h-lg-100">
                        <div class="card-header pt-6">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-900">@T("القدرات المفعَّلة", "Enabled capabilities")</span>
                                <span class="text-gray-500 pt-2 fw-semibold fs-7">@T("تُقرأ عبر IsCapabilityEnabledAsync — الافتراضي عند غياب الصف: معطّل", "Read via IsCapabilityEnabledAsync — default when no row: disabled")</span>
                            </h3>
                            <div class="card-toolbar"><span class="badge badge-light-success fs-7 fw-bold">@onCount / @caps.Count</span></div>
                        </div>
                        <div class="card-body pt-2">
                            @if (!hasCapConfig)
                            {
                                <div class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-4 mb-4">
                                    <i class="ki-outline ki-information-5 fs-2x text-warning me-3"></i>
                                    <div class="fs-7 text-gray-700">@T("لم تُطبَّق قدرات على هذا الفرع بعد (لا نشاط preset مُطبَّق) — القائمة كلها معطَّلة افتراضيًّا، لا لأنها أوقِفت.", "No capabilities configured for this branch yet (no preset applied) — everything is off by default, not because it was disabled.")</div>
                                </div>
                            }
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var c in caps)
                                {
                                    if (c.On)
                                    {
                                        <span class="badge badge-light-success fs-7 py-2 px-3"><i class="ki-outline ki-check-circle fs-7 text-success me-1"></i>@(isAr ? c.Ar : c.En)</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light fs-7 py-2 px-3 text-muted"><i class="ki-outline ki-cross-circle fs-7 text-muted me-1"></i>@(isAr ? c.Ar : c.En)</span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <!--begin::Branch status card (brand green)-->
                <div class="col-xl-4">
                    <div class="card card-flush border-0 h-lg-100" data-bs-theme="light" style="background-color:#1f6253">
                        <div class="card-header pt-5">
                            <h3 class="card-title"><span class="text-white fs-3 fw-bold me-2">@T("حالة الفرع", "Branch status")</span></h3>
                        </div>
                        <div class="card-body d-flex justify-content-between flex-column pt-1 px-0 pb-5">
                            <div class="px-9 mb-4">
                                <div class="text-white fs-2 fw-bold lh-1">@bName</div>
                                <div class="fw-semibold fs-7 text-white opacity-75 mt-2"><span class="badge bg-white bg-opacity-10 text-white fs-8">@(branch?.ActivityPresetCode ?? "—")</span></div>
                            </div>
                            <div class="px-9">
                                <div class="d-flex flex-stack text-white opacity-75 mb-2"><span class="fw-semibold fs-7">@T("الترمينالات", "Terminals")</span><span class="fw-bold fs-7">@terminals.Count</span></div>
                                <div class="d-flex flex-stack text-white opacity-75 mb-2"><span class="fw-semibold fs-7">@T("ورديات مفتوحة", "Open shifts")</span><span class="fw-bold fs-7">@openCount</span></div>
                                <div class="d-flex flex-stack text-white opacity-75 mb-2"><span class="fw-semibold fs-7">@T("قدرات مفعّلة", "Enabled capabilities")</span><span class="fw-bold fs-7">@onCount</span></div>
                                <div class="separator separator-dashed border-white opacity-25 my-3"></div>
                                <div class="d-flex align-items-center text-white"><i class="ki-outline ki-information-5 fs-5 text-white me-2"></i><span class="fw-semibold fs-8">@T("للعرض فقط — لا بيع في هذه المرحلة", "Read-only — no selling at this stage")</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end::Branch status card-->
            </div>
            <!--end::Row 1-->

            <!--begin::Row 2 — status KPI tiles-->
            <div class="row g-5 g-xl-10 mb-5 mb-xl-10">
                @{
                    var tiles = new (string label, string value, bool count, string icon, string color, string badge)[] {
                        (T("الترمينالات","Terminals"), terminals.Count.ToString(), true, "ki-screen", "warning", T("مُهيّأة","Configured")),
                        (T("ورديات مفتوحة","Open shifts"), openCount.ToString(), true, "ki-time", "info", T("الآن","Now")),
                        (T("قدرات مفعّلة","Enabled capabilities"), onCount.ToString(), true, "ki-check-circle", "success", $"/ {caps.Count}"),
                        (T("النشاط","Activity"), branch?.ActivityPresetCode ?? "—", false, "ki-basket", "primary", T("preset","preset")),
                    };
                }
                @foreach (var s in tiles)
                {
                    <div class="col-6 col-xl-3">
                        <div class="card h-100">
                            <div class="card-body d-flex justify-content-between align-items-start flex-column p-5">
                                <div class="d-flex flex-stack w-100 mb-4">
                                    <div class="symbol symbol-40px"><span class="symbol-label bg-light-@s.color"><i class="ki-outline @s.icon fs-2x text-@s.color"></i></span></div>
                                    <span class="badge badge-light-@s.color fs-8 fw-bold">@s.badge</span>
                                </div>
                                @if (s.count)
                                {
                                    <span class="fw-bold fs-2x text-gray-900 lh-1 ls-n2" data-kt-countup="true" data-kt-countup-value="@s.value">@s.value</span>
                                }
                                else
                                {
                                    <span class="fw-bold fs-2x text-gray-900 lh-1 ls-n2">@s.value</span>
                                }
                                <div class="m-0 mt-2"><span class="fw-semibold fs-7 text-gray-500">@s.label</span></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!--end::Row 2-->

            <!--begin::Row 3 — terminals & receipt series-->
            <div class="row g-5 g-xl-10 mb-5 mb-xl-10">
                <div class="col-12">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-6">
                            <h3 class="card-title fw-bold text-gray-900">@T("الترمينالات وسلاسل الفواتير", "Terminals & receipt series")</h3>
                        </div>
                        <div class="card-body pt-2">
                            @if (!terminals.Any())
                            {
                                <div class="text-muted fs-6 py-6 text-center">@T("لا ترمينالات لهذا الفرع.", "No terminals for this branch.")</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-row-dashed align-middle gy-3">
                                        <thead><tr class="fw-bold text-muted fs-7 text-uppercase">
                                            <th>@T("الكود","Code")</th>
                                            <th>@T("الاسم","Name")</th>
                                            <th>@T("سلسلة الفاتورة","Receipt series")</th>
                                            <th>@T("الرقم التالي","Next no.")</th>
                                            <th>@T("الوردية","Shift")</th>
                                        </tr></thead>
                                        <tbody>
                                        @foreach (var t in terminals)
                                        {
                                            open.TryGetValue(t.ID, out var sh);
                                            <tr>
                                                <td><span class="fw-bold text-gray-900">@t.Code</span></td>
                                                <td class="text-gray-700">@t.Name</td>
                                                <td><span class="badge badge-light-primary fs-7">@t.ReceiptPrefix</span></td>
                                                <td><span class="fw-semibold text-gray-800" style="font-variant-numeric:tabular-nums">@t.NextReceiptNo.ToString("D6")</span></td>
                                                <td>
                                                    @if (sh != null)
                                                    {
                                                        <span class="badge badge-light-success fs-8"><i class="ki-outline ki-time fs-8 text-success me-1"></i>@T("مفتوحة","Open") #@sh.ID</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-light fs-8 text-muted">@T("مغلقة","Closed")</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                                @if (setting != null)
                                {
                                    <div class="separator separator-dashed my-4"></div>
                                    <div class="d-flex flex-wrap gap-6 fs-7">
                                        <div><span class="text-muted">@T("مستودع البيع","Sales warehouse")</span>: <span class="fw-semibold text-gray-800">@(setting.DefaultSalesWarehouseId?.ToString() ?? "—")</span></div>
                                        <div><span class="text-muted">@T("قائمة الأسعار","Price list")</span>: <span class="fw-semibold text-gray-800">@(setting.DefaultPriceListId?.ToString() ?? "—")</span></div>
                                        <div><span class="text-muted">@T("العملة","Currency")</span>: <span class="fw-semibold text-gray-800">@(setting.DefaultCurrencyId?.ToString() ?? "—")</span></div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Row 3-->
        }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var Ctor = (window.countUp && window.countUp.CountUp) ? window.countUp.CountUp : (window.CountUp || null);
            if (!Ctor) return;
            document.querySelectorAll('#kt_app_content [data-kt-countup="true"]').forEach(function (el) {
                if (el.getAttribute('data-kt-initialized') === '1') return;
                var val = parseFloat(el.getAttribute('data-kt-countup-value')) || 0;
                var c = new Ctor(el, val, { duration: 1.2 });
                if (!c.error) { c.start(); el.setAttribute('data-kt-initialized', '1'); }
            });
        })();
    </script>
}