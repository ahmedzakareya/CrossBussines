@using CrossBuy.Controllers
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutHyperPos.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var rows = ViewBag.Rows as List<object[]> ?? new List<object[]>();
    var canReverse = ViewBag.CanReverse as bool? ?? false;
    int dp = ViewBag.Dp ?? 2;
    var fmt = dp > 0 ? "0." + new string('0', dp) : "0";
    ViewData["Title"] = isAr ? "الإيصالات" : "Receipts";
}
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-xxl">
        <div class="card card-flush mx-auto shadow-sm" style="max-width:760px;">
            <div class="card-header pt-6">
                <div class="card-title"><h2 class="fs-2 fw-bold">@SR["Recent receipts (this terminal)"]</h2></div>
                <div class="card-toolbar"><a href="/hyper/pos/lane" class="btn btn-sm btn-light">@SR["Back to the lane"]</a></div>
            </div>
            <div class="card-body">
                <div class="text-muted fs-7 mb-4">@SR["Confirm whether a sale went through, and reprint its receipt. Read-only."]</div>
                @if (rows.Count == 0)
                {
                    <div class="text-muted fs-6 text-center py-8">—</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-row-dashed align-middle gs-0 gy-3 mb-0">
                            <thead>
                                <tr class="fw-semibold text-muted fs-7 text-uppercase" style="border-bottom:2px solid #0E4A9E;">
                                    <th>@SR["Receipt no"]</th>
                                    <th class="text-end">@SR["Total"]</th>
                                    <th>@SR["Time"]</th>
                                    <th class="w-100px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in rows)
                                {
                                    var invId = (int)r[0];
                                    var receiptNo = (string)r[1];
                                    var total = (decimal)r[2];
                                    var closedAt = (DateTime?)r[3];
                                    var orderId = (int)r[4];
                                    <tr>
                                        <td class="fw-semibold text-gray-900">@(string.IsNullOrEmpty(receiptNo) ? ("#" + invId) : receiptNo)</td>
                                        <td class="text-end fw-bold" style="font-variant-numeric:tabular-nums">@total.ToString(fmt)</td>
                                        <td class="text-muted fs-7">@(closedAt?.ToString("yyyy/MM/dd HH:mm"))</td>
                                        <td class="text-nowrap">
                                            <a href="/hyper/pos/invoice/print/@invId" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-printer fs-6"></i>@SR["Reprint"]</a>
                                            @* HM-RET: a PART of the sale, which is what a customer usually brings back.
                                               It sits before the full reversal and is an ordinary cashier action, because
                                               a return policy that needs a manager for one yoghurt is not a return policy.
                                               Reversal stays a manager's right and keeps its own button. *@
                                            <a href="/hyper/pos/return?orderId=@orderId" class="btn btn-sm btn-light-primary ms-1"><i class="ki-outline ki-handcart fs-6"></i>@(isAr ? "إرجاع جزئي" : "Return items")</a>
                                            @if (canReverse)
                                            {
                                                @* HM-14: a FULL reversal, named as one. The confirmation is the house dialog,
                                                   never the browser's confirm(), and the button is neutral-danger rather than
                                                   amber — an amber control on a till reads as "you have done something wrong". *@
                                                <form method="post" action="/hyper/pos/receipt/void" class="d-inline ms-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="orderId" value="@orderId" />
                                                    <button type="submit" class="btn btn-sm btn-light-danger" data-cb-confirm="@(isAr ? "إرجاع البيعة كاملة وعكس المخزون والقيود؟" : "Reverse the whole sale, stock and entries?")"><i class="ki-outline ki-arrow-circle-left fs-6"></i>@(isAr ? "إرجاع" : "Reverse")</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
