@using CrossBuy.Controllers
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var branches = ViewBag.HyperBranches as List<HyperController.HyperBranchItem> ?? new();
    var branch = ViewBag.Branch as CrossBuy.Models.Context.Admin.Branch;
    var hits = ViewBag.Hits as List<CrossBuy.Models.Context.Inventory.Item> ?? new List<CrossBuy.Models.Context.Inventory.Item>();
    var item = ViewBag.Item as CrossBuy.Models.Context.Inventory.Item;
    var codes = ViewBag.Codes as List<CrossBuy.BL.ItemBarcodeRow> ?? new List<CrossBuy.BL.ItemBarcodeRow>();
    var units = ViewBag.Units as List<CrossBuy.Models.Context.Inventory.UnitOfMeasure> ?? new List<CrossBuy.Models.Context.Inventory.UnitOfMeasure>();
    var setting = ViewBag.Setting as CrossBuy.Models.Context.Pos.BranchPosSetting;
    var multiOn = ViewBag.MultiOn as bool? ?? false;
    var q = ViewBag.Q as string;
    ViewData["Title"] = isAr ? "الباركودات" : "Barcodes";

    var msgMap = new Dictionary<string, string> {
        ["barcode-added"] = isAr ? "أُضيف الباركود." : "The barcode was added.",
        ["barcode-removed"] = isAr ? "حُذف الباركود." : "The barcode was removed.",
        ["no-permission"] = isAr ? "لا تملك صلاحية تعديل بيانات هذا الفرع." : "You may not change this branch’s data."
    };
    Func<object, string> say = c => { var k = c as string ?? ""; return msgMap.TryGetValue(k, out var v) ? v : k; };
    Func<int?, string> unitOf = id => units.FirstOrDefault(u => u.ID == id)?.Code ?? "—";
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-xxl">

        @if (TempData["HyperMsg"] != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-6"><i class="ki-outline ki-check-circle fs-2 me-3"></i>@say(TempData["HyperMsg"])</div>
        }
        @if (TempData["HyperErr"] != null)
        {
            <div class="alert alert-danger d-flex align-items-start mb-6"><i class="ki-outline ki-information-5 fs-2 me-3 mt-1"></i><div>@say(TempData["HyperErr"])</div></div>
        }

        @if (ViewBag.NoBranch == true)
        {
            <div class="card"><div class="card-body p-10 text-center">
                <i class="ki-outline ki-shop fs-3tx text-muted mb-4 d-block"></i>
                <div class="fs-5 fw-bold text-gray-800">@(isAr ? "لا يوجد فرع هايبر ماركت بعد" : "No hypermarket branch yet")</div>
            </div></div>
            return;
        }

        @if (branches.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2 mb-5">
                @foreach (var b in branches)
                {
                    var on = branch != null && b.Id == branch.ID;
                    <a href="/hyper/setup/barcodes?branchId=@b.Id" class="btn btn-sm @(on ? "btn-primary" : "btn-light")">@(isAr ? (b.NameAr ?? b.Name) : (b.Name ?? b.NameAr))</a>
                }
            </div>
        }

        @if (!multiOn)
        {
            <div class="alert alert-warning d-flex align-items-start mb-6">
                <i class="ki-outline ki-information-5 fs-2tx me-4 mt-1"></i>
                <div>
                    <div class="fw-bold fs-6 mb-1">@(isAr ? "الباركود المتعدّد متوقف على هذا الفرع" : "Multi-barcode is off for this branch")</div>
                    <div class="fs-7 text-gray-700">
                        @(isAr ? "يمكنك تسجيل الباركودات هنا، لكن الصندوق لن يحلّ إلا الباركود الأساسي حتى تُفعَّل القدرة." : "You can register barcodes here, but the till resolves only the primary one until the capability is on.")
                        <a href="/hyper/setup/capabilities?branchId=@(branch?.ID)" class="fw-bold">@(isAr ? "قدرات الفرع" : "Branch capabilities")</a>
                    </div>
                </div>
            </div>
        }

        <div class="row g-5 g-xl-8">
            <div class="col-xl-5">
                <div class="card">
                    <div class="card-header min-h-50px align-items-center">
                        <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? "اختر صنفاً" : "Pick an item")</h3>
                    </div>
                    <div class="card-body pt-4">
                        <form method="get" action="/hyper/setup/barcodes" class="d-flex gap-2 mb-4">
                            <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                            <input name="q" value="@q" class="form-control form-control-solid" placeholder="@(isAr ? "ابحث بالاسم أو الكود…" : "Search by name or code…")" autocomplete="off" />
                            <button type="submit" class="btn btn-light-primary"><i class="ki-outline ki-magnifier fs-4"></i></button>
                        </form>

                        @if (!string.IsNullOrWhiteSpace(q))
                        {
                            @if (hits.Count == 0)
                            {
                                <div class="text-muted fs-7 py-2">@(isAr ? "لا نتائج" : "No matches")</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-1">
                                    @foreach (var h in hits)
                                    {
                                        <a href="/hyper/setup/barcodes?branchId=@(branch?.ID)&amp;q=@q&amp;itemId=@h.ID"
                                           class="d-flex flex-stack bg-light rounded px-3 py-2 text-decoration-none @(item != null && item.ID == h.ID ? "bg-light-primary" : "")">
                                            <span class="min-w-0">
                                                <span class="fw-bold text-gray-900 d-block text-truncate">@(isAr ? h.Name : (h.NameEn ?? h.Name))</span>
                                                <span class="fs-8 text-muted" style="font-variant-numeric:tabular-nums">@h.ItemCode</span>
                                            </span>
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-7">
                @if (item == null)
                {
                    <div class="card"><div class="card-body p-10 text-center text-muted fs-7">
                        @(isAr ? "ابحث عن صنف واخترْه لعرض باركوداته." : "Find an item and pick it to see its barcodes.")
                    </div></div>
                }
                else
                {
                    <div class="card">
                        <div class="card-header min-h-50px align-items-center">
                            <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? item.Name : (item.NameEn ?? item.Name))</h3>
                            <div class="card-toolbar"><span class="badge badge-light" style="font-variant-numeric:tabular-nums">@item.ItemCode</span></div>
                        </div>
                        <div class="card-body pt-4">
                            <div class="mb-4 fs-7">
                                <span class="text-muted">@(isAr ? "الباركود الأساسي:" : "Primary barcode:")</span>
                                @if (string.IsNullOrWhiteSpace(item.Barcode))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="badge badge-light-primary fw-bold ms-1" style="font-variant-numeric:tabular-nums">@item.Barcode</span>
                                }
                            </div>

                            @if (codes.Count == 0)
                            {
                                <div class="text-muted fs-7 py-4">@(isAr ? "لا باركودات إضافية لهذا الصنف." : "No extra barcodes for this item.")</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table align-middle gy-3 mb-0">
                                        <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                            <th class="ps-4">@(isAr ? "الباركود" : "Barcode")</th>
                                            <th style="width:140px">@(isAr ? "الوحدة" : "Unit")</th>
                                            <th class="pe-4" style="width:90px"></th>
                                        </tr></thead>
                                        <tbody class="fs-6">
                                            @foreach (var c in codes)
                                            {
                                                <tr>
                                                    <td class="ps-4"><span class="fw-bold text-gray-800" style="font-variant-numeric:tabular-nums">@c.Barcode</span></td>
                                                    <td><span class="badge badge-light">@unitOf(c.UoMId)</span></td>
                                                    <td class="pe-4">
                                                        <form method="post" action="/hyper/setup/barcodes/delete" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                                                            <input type="hidden" name="itemId" value="@item.ID" />
                                                            <input type="hidden" name="id" value="@c.Id" />
                                                            <button type="submit" class="btn btn-icon btn-sm btn-light-danger" data-cb-confirm="@(isAr ? "حذف هذا الباركود؟" : "Remove this barcode?")"><i class="ki-outline ki-trash fs-5"></i></button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <div class="separator separator-dashed my-5"></div>
                            <form method="post" action="/hyper/setup/barcodes/add" class="row g-3 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                                <input type="hidden" name="itemId" value="@item.ID" />
                                <div class="col-md-6 fv-row">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "باركود جديد" : "New barcode")</label>
                                    <input name="barcode" class="form-control form-control-solid" style="font-variant-numeric:tabular-nums" required autocomplete="off" />
                                </div>
                                <div class="col-md-4 fv-row">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "الوحدة" : "Unit")</label>
                                    <select name="uomId" class="form-select form-select-solid" required>
                                        <option value="">@(isAr ? "اختر…" : "Choose…")</option>
                                        @foreach (var u in units)
                                        {
                                            <option value="@u.ID">@u.Code — @(isAr ? u.Name : (u.NameEn ?? u.Name))</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary w-100"><i class="ki-outline ki-plus fs-4"></i></button>
                                </div>
                            </form>

                            @* The two rules the till enforces at sell time, said here where they can still be
                               acted on cheaply rather than at a queue. *@
                            <div class="fs-8 text-muted mt-4" style="line-height:1.9">
                                <div>• @(isAr ? "الباركود فريد داخل الشركة — الصندوق يرفض باركوداً يجده على صنفين." : "A barcode is unique per company — the till refuses one it finds on two items.")</div>
                                @if (!string.IsNullOrWhiteSpace(setting?.ScaleBarcodePrefix))
                                {
                                    <div>• @(isAr ? "لا يبدأ بـ" : "Must not start with") <span class="fw-bold" style="font-variant-numeric:tabular-nums">@setting!.ScaleBarcodePrefix</span> — @(isAr ? "هذا مدى الموازين، والصندوق يحلّله كوزن بدل أن يبحث عنه." : "that is the scale range; the till parses it as a weight instead of looking it up.")</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
