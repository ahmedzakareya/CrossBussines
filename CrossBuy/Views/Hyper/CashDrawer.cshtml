@using CrossBuy.Controllers
@using CrossBuy.BL
@using CrossBuy.Models.Context.Accounting
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var branches = ViewBag.HyperBranches as List<HyperController.HyperBranchItem> ?? new();
    var branch = ViewBag.Branch as CrossBuy.Models.Context.Admin.Branch;
    var shifts = ViewBag.Shifts as List<HyperController.HyperShiftRow> ?? new();
    var terminals = ViewBag.Terminals as List<CrossBuy.Models.Context.Pos.PosTerminal> ?? new();
    var shift = ViewBag.Shift as HyperController.HyperShiftRow;
    var moves = ViewBag.Movements as List<ShiftCashMovementRow> ?? new();
    var accounts = ViewBag.Accounts as List<Account> ?? new();
    var expected = ViewBag.Expected as decimal?;
    var dp = (int)(ViewBag.Dp ?? 2);
    var fmt = dp > 0 ? "0." + new string('0', dp) : "0";
    ViewData["Title"] = isAr ? "درج النقد" : "Cash drawer";

    Func<int, string> termOf = id => terminals.FirstOrDefault(t => t.ID == id)?.Code ?? ("#" + id);

    var msgMap = new Dictionary<string, string> {
        ["cash-movement-saved"] = isAr ? "سُجِّلت حركة النقد وقُيِّدت." : "The cash movement was recorded and posted.",
        ["shift-not-open-here"] = isAr ? "لا توجد وردية مفتوحة بهذا الرقم على هذا الفرع." : "There is no open shift with that number on this branch.",
        ["not-hyper-branch"] = isAr ? "هذا الفرع ليس فرع هايبر ماركت." : "This branch is not a hypermarket branch.",
        ["no-permission"] = isAr ? "تسجيل حركة نقد يحتاج صلاحية مدير." : "Recording a cash movement needs manager permission."
    };
    Func<object, string> say = c => { var k = c as string ?? ""; return msgMap.TryGetValue(k, out var v) ? v : k; };

    decimal movedIn = moves.Where(m => m.Kind == "In").Sum(m => m.Amount);
    decimal movedOut = moves.Where(m => m.Kind == "Out").Sum(m => m.Amount);
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-xxl">

        @if (TempData["HyperMsg"] != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-6"><i class="ki-outline ki-check-circle fs-2 me-3"></i>@say(TempData["HyperMsg"])</div>
        }
        @if (TempData["HyperErr"] != null)
        {
            <div class="alert alert-danger d-flex align-items-start mb-6"><i class="ki-outline ki-information-5 fs-2 me-3 mt-1"></i><div>@say(TempData["HyperErr"])</div></div>
        }

        @if (ViewBag.NoBranch == true)
        {
            <div class="card"><div class="card-body p-10 text-center">
                <i class="ki-outline ki-shop fs-3tx text-muted mb-4 d-block"></i>
                <div class="fs-5 fw-bold text-gray-800">@(isAr ? "لا يوجد فرع هايبر ماركت بعد" : "No hypermarket branch yet")</div>
            </div></div>
            return;
        }

        @if (branches.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2 mb-5">
                @foreach (var b in branches)
                {
                    var on = branch != null && b.Id == branch.ID;
                    <a href="/hyper/cash?branchId=@b.Id" class="btn btn-sm @(on ? "btn-primary" : "btn-light")">@(isAr ? (b.NameAr ?? b.Name) : (b.Name ?? b.NameAr))</a>
                }
            </div>
        }

        @* WHAT THIS SCREEN IS FOR, said once. The money a manager takes out of a till mid-shift was invisible
           to the close, which charged it to the shop as a cash loss. Recording it here is what stops that. *@
        <div class="alert alert-primary d-flex align-items-start mb-6">
            <i class="ki-outline ki-wallet fs-2tx me-4 mt-1"></i>
            <div class="min-w-0">
                <div class="fw-bold fs-6 mb-1">@(isAr ? "النقد الذي يدخل الدرج أو يخرج منه أثناء الوردية" : "Cash that enters or leaves the drawer during a shift")</div>
                <div class="fs-7 text-gray-700" style="line-height:1.9">
                    @(isAr
                        ? "التوريد إلى الخزنة، أو دفعة نقدية لمورّد، أو فكّة تُرسَل إلى صندوق آخر. تُقيَّد كلها في دفتر الأستاذ لحظة تسجيلها، ويقرؤها إقفال الوردية فيحسب المتوقَّع بعدها. قبل ذلك كان التوريد إلى الخزنة يظهر عجزاً في الدرج ويُحمَّل على حساب «عجز وزيادة النقدية» خسارةً وهمية."
                        : "A drop to the safe, a supplier paid in cash, change sent to another till. Each posts to the general ledger the moment it is recorded, and the shift close reads them back when it works out what the drawer should hold. Before this, a drop to the safe showed up as a drawer shortage and was charged to the cash over/short account as a loss that never happened.")
                </div>
            </div>
        </div>

        @if (shifts.Count == 0)
        {
            <div class="card"><div class="card-body p-10 text-center">
                <i class="ki-outline ki-time fs-3tx text-muted mb-4 d-block"></i>
                <div class="fs-5 fw-bold text-gray-800 mb-2">@(isAr ? "لا وردية مفتوحة على هذا الفرع" : "No open shift on this branch")</div>
                <div class="fs-7 text-muted" style="line-height:1.9">
                    @(isAr
                        ? "حركة النقد تُسجَّل على وردية مفتوحة فقط. الوردية المغلقة سُوِّيت بالفعل وقُيِّد فرقها، وتعديل متوقَّعها بعد ذلك يُبطل رقماً اعتُمد."
                        : "A cash movement is recorded against an open shift only. A closed shift is already reconciled and its difference posted; changing its expectation afterwards would invalidate a figure that has been signed off.")
                </div>
                <a href="/hyper/reports/zreport?branchId=@(branch?.ID)" class="btn btn-sm btn-light-primary mt-5">@(isAr ? "تقارير الورديات" : "Shift reports")</a>
            </div></div>
            return;
        }

        <div class="row g-5 g-xl-8">
            <div class="col-xl-5">
                @if (shifts.Count > 1)
                {
                    <div class="card mb-5">
                        <div class="card-header min-h-45px align-items-center"><h3 class="card-title fs-6 fw-bold">@(isAr ? "الورديات المفتوحة" : "Open shifts")</h3></div>
                        <div class="card-body pt-3">
                            <div class="d-flex flex-column gap-1">
                                @foreach (var sh in shifts)
                                {
                                    var sel = shift != null && sh.Id == shift.Id;
                                    <a href="/hyper/cash?branchId=@(branch?.ID)&amp;shiftId=@sh.Id"
                                       class="d-flex flex-stack rounded px-3 py-2 text-decoration-none @(sel ? "bg-light-primary" : "bg-light")">
                                        <span class="fw-bold text-gray-900">@termOf(sh.TerminalId) · @sh.ShiftType</span>
                                        <span class="fs-8 text-muted" style="font-variant-numeric:tabular-nums">@sh.OpenedAt.ToString("HH:mm")</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (shift != null)
                {
                    <div class="card mb-5">
                        <div class="card-header min-h-50px align-items-center">
                            <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? "ما ينبغي أن يحويه الدرج الآن" : "What the drawer should hold now")</h3>
                        </div>
                        <div class="card-body pt-4">
                            <div class="fs-2hx fw-bolder text-gray-900" style="font-variant-numeric:tabular-nums">@((expected ?? 0m).ToString(fmt))</div>
                            <div class="fs-8 text-muted mt-1">@termOf(shift.TerminalId) · @shift.ShiftType · @(isAr ? "فُتحت" : "opened") @shift.OpenedAt.ToString("HH:mm")</div>

                            <div class="separator separator-dashed my-5"></div>
                            <div class="fs-7">
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-muted">@(isAr ? "رصيد الافتتاح" : "Opening float")</span>
                                    <span style="font-variant-numeric:tabular-nums">@shift.OpeningFloat.ToString(fmt)</span>
                                </div>
                                @if (movedIn != 0)
                                {
                                    <div class="d-flex justify-content-between py-1">
                                        <span class="text-muted">@(isAr ? "نقد أُدخل" : "Cash put in")</span>
                                        <span class="text-success" style="font-variant-numeric:tabular-nums">+@movedIn.ToString(fmt)</span>
                                    </div>
                                }
                                @if (movedOut != 0)
                                {
                                    <div class="d-flex justify-content-between py-1">
                                        <span class="text-muted">@(isAr ? "نقد أُخرج" : "Cash taken out")</span>
                                        <span class="text-danger" style="font-variant-numeric:tabular-nums">−@movedOut.ToString(fmt)</span>
                                    </div>
                                }
                            </div>
                            <div class="fs-8 text-muted mt-3" style="line-height:1.8">
                                @(isAr
                                    ? "المبيعات النقدية والإكراميات النقدية داخلة في الرقم أعلاه أيضاً."
                                    : "Cash sales and cash tips are in the figure above as well.")
                            </div>
                        </div>
                    </div>

                    <form method="post" action="/hyper/cash">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                        <input type="hidden" name="shiftId" value="@shift.Id" />
                        <div class="card">
                            <div class="card-header min-h-50px align-items-center">
                                <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? "تسجيل حركة" : "Record a movement")</h3>
                            </div>
                            <div class="card-body pt-4">
                                <div class="fv-row mb-4">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "الاتجاه" : "Direction")</label>
                                    <select name="kind" class="form-select form-select-solid">
                                        <option value="Out">@(isAr ? "خروج من الدرج (توريد للخزنة، دفعة نقدية)" : "Out of the drawer (safe drop, cash payout)")</option>
                                        <option value="In">@(isAr ? "دخول إلى الدرج (تدعيم فكّة)" : "Into the drawer (float top-up)")</option>
                                    </select>
                                </div>

                                <div class="fv-row mb-4">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "المبلغ" : "Amount")</label>
                                    <input name="amount" type="number" step="any" min="0" required class="form-control form-control-solid" style="font-variant-numeric:tabular-nums" />
                                </div>

                                <div class="fv-row mb-4">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "الطرف الآخر" : "The other side")</label>
                                    @if (accounts.Count == 0)
                                    {
                                        <div class="text-muted fs-7">@(isAr ? "لا توجد حسابات نقدية أو مصروفات قابلة للقيد." : "There are no postable cash or expense accounts.")</div>
                                    }
                                    else
                                    {
                                        <select name="counterAccountId" class="form-select form-select-solid" required>
                                            @foreach (var a in accounts)
                                            {
                                                <option value="@a.ID">@a.Code · @(isAr ? a.Name : (string.IsNullOrWhiteSpace(a.NameEn) ? a.Name : a.NameEn))</option>
                                            }
                                        </select>
                                        <div class="fs-8 text-muted mt-2" style="line-height:1.8">
                                            @(isAr
                                                ? "الحساب الذي ذهب إليه النقد (أو جاء منه): الخزنة، البنك، أو حساب المصروف الذي دُفع."
                                                : "The account the cash went to, or came from: the safe, the bank, or the expense that was paid.")
                                        </div>
                                    }
                                </div>

                                <div class="fv-row mb-5">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "بيان" : "Note")</label>
                                    <input name="note" type="text" maxlength="200" class="form-control form-control-solid" placeholder="@(isAr ? "توريد مسائي، دفعة مورّد…" : "evening drop, supplier payment…")" />
                                </div>

                                <button type="submit" class="btn btn-primary w-100" @(accounts.Count == 0 ? "disabled" : "")>
                                    <i class="ki-outline ki-check fs-5"></i>@(isAr ? "سجّل وقيّد" : "Record and post")
                                </button>
                                <div class="fs-8 text-muted mt-3" style="line-height:1.8">
                                    @(isAr
                                        ? "يُنشئ قيداً متوازناً فوراً. لتصحيح حركة خاطئة، اعكس قيدها من الحسابات — فالعكس يُستبعد من حساب المتوقَّع تلقائياً."
                                        : "This posts a balanced journal entry immediately. To correct a mistaken movement, reverse its entry in Accounting — a reversed entry drops out of the expected figure automatically.")
                                </div>
                            </div>
                        </div>
                    </form>
                }
            </div>

            <div class="col-xl-7">
                <div class="card">
                    <div class="card-header min-h-50px align-items-center">
                        <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? "حركات هذه الوردية" : "This shift’s movements")</h3>
                        <div class="card-toolbar"><span class="badge badge-light">@moves.Count</span></div>
                    </div>
                    <div class="card-body pt-4">
                        @{ var orphaned = moves.Count(m => m.CounterAccountMissing); }
                        @if (orphaned > 0)
                        {
                            @* COUNTED AND NAMED, not merely degraded. These movements are in the expected-cash
                               figure and always were meant to be; what is broken is the account they point at.
                               Left-joining alone would have made the number right and left the broken row silent. *@
                            <div class="alert alert-danger d-flex align-items-start mb-5">
                                <i class="ki-outline ki-information-5 fs-2tx me-4 mt-1"></i>
                                <div class="fs-7 text-gray-800" style="line-height:1.9">
                                    @(isAr
                                        ? $"{orphaned} حركة طرفها الآخر يشير إلى حساب لم يعد موجوداً. المبالغ محسوبة في المتوقَّع كما ينبغي — الخلل في الحساب المشار إليه، ويحتاج مراجعة في دليل الحسابات."
                                        : $"{orphaned} movement(s) point at an account that no longer exists. The amounts are counted in the expected figure as they should be — what is broken is the account they reference, and it needs looking at in the chart of accounts.")
                                </div>
                            </div>
                        }
                        @if (moves.Count == 0)
                        {
                            <div class="text-muted fs-7 py-6 text-center" style="line-height:1.9">
                                @(isAr
                                    ? "لم تُسجَّل حركة نقد على هذه الوردية — الدرج يُتوقَّع منه المبيعات النقدية ورصيد الافتتاح فقط."
                                    : "No cash movement has been recorded on this shift — the drawer is expected to hold its opening float and its cash takings, nothing else.")
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle gy-3 mb-0">
                                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                        <th class="ps-4">@(isAr ? "الاتجاه" : "Direction")</th>
                                        <th>@(isAr ? "الطرف الآخر" : "Other side")</th>
                                        <th class="text-end">@(isAr ? "المبلغ" : "Amount")</th>
                                        <th class="text-end pe-4" style="width:130px">@(isAr ? "القيد" : "Entry")</th>
                                    </tr></thead>
                                    <tbody class="fs-6">
                                        @foreach (var m in moves)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    @if (m.Kind == "Out")
                                                    {
                                                        <span class="badge badge-light-danger fw-bold">@(isAr ? "خروج" : "Out")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-light-success fw-bold">@(isAr ? "دخول" : "In")</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (m.CounterAccountMissing)
                                                    {
                                                        @* The movement still counts — it moved real money. What is
                                                           missing is the account it moved to, and that is a data
                                                           defect worth naming rather than a blank worth ignoring. *@
                                                        <span class="fw-bold text-danger d-block">
                                                            @(isAr ? $"حساب غير موجود (#{m.CounterAccountId})" : $"Account missing (#{m.CounterAccountId})")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @* BIDI ISOLATION. An account name and a free-typed note are both
                                                           arbitrary-direction text, and the note in particular mixes
                                                           scripts ("نقد داخل إلى الدرج — self-test top-up"). Without
                                                           <bdi> the runs reorder against each other and the line reads
                                                           in an order nobody wrote. *@
                                                        <bdi class="fw-bold text-gray-800 d-block">@m.CounterAccountName</bdi>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(m.Note))
                                                    {
                                                        <bdi class="fs-8 text-muted d-block">@m.Note</bdi>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold @(m.Kind == "Out" ? "text-danger" : "text-success")" style="font-variant-numeric:tabular-nums">
                                                    @(m.Kind == "Out" ? "−" : "+")@m.Amount.ToString(fmt)
                                                </td>
                                                <td class="text-end pe-4">
                                                    <a href="/Accounting/JournalEntry?id=@m.JournalEntryId" class="fs-8 fw-bold" style="font-variant-numeric:tabular-nums">
                                                        @(string.IsNullOrWhiteSpace(m.EntryNo) ? ("#" + m.JournalEntryId) : m.EntryNo)
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
