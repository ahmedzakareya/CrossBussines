@using CrossBuy.Controllers
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var branches = ViewBag.HyperBranches as List<HyperController.HyperBranchItem> ?? new();
    var branch = ViewBag.Branch as CrossBuy.Models.Context.Admin.Branch;
    var set = ViewBag.Setting as CrossBuy.Models.Context.Pos.BranchPosSetting;
    var weighed = ViewBag.Weighed as List<HyperController.HyperWeighedRow> ?? new();
    var weightOn = ViewBag.WeightOn as bool? ?? false;
    ViewData["Title"] = isAr ? "إعداد الموازين" : "Scale setup";

    var msgMap = new Dictionary<string, string> {
        ["scale-saved"] = isAr ? "حُفظ تنسيق باركود الميزان." : "The scale barcode format was saved.",
        ["weighed-saved"] = isAr ? "حُفظ الصنف الموزون." : "The weighed item was saved.",
        ["not-hyper-branch"] = isAr ? "هذا الفرع ليس فرع هايبر ماركت." : "This branch is not a hypermarket branch.",
        ["no-permission"] = isAr ? "لا تملك صلاحية تعديل إعدادات هذا الفرع." : "You may not change this branch’s setup."
    };
    Func<object, string> say = c => { var k = c as string ?? ""; return msgMap.TryGetValue(k, out var v) ? v : k; };

    var pfx = set?.ScaleBarcodePrefix ?? "21";
    var icl = set?.ScaleItemCodeLength ?? 5;
    var vl = set?.ScaleValueLength ?? 5;
    var vd = set?.ScaleValueDecimals ?? 3;
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-xxl">

        @if (TempData["HyperMsg"] != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-6"><i class="ki-outline ki-check-circle fs-2 me-3"></i>@say(TempData["HyperMsg"])</div>
        }
        @if (TempData["HyperErr"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center mb-6"><i class="ki-outline ki-information-5 fs-2 me-3"></i>@say(TempData["HyperErr"])</div>
        }

        @if (ViewBag.NoBranch == true)
        {
            <div class="card"><div class="card-body p-10 text-center">
                <i class="ki-outline ki-shop fs-3tx text-muted mb-4 d-block"></i>
                <div class="fs-5 fw-bold text-gray-800">@(isAr ? "لا يوجد فرع هايبر ماركت بعد" : "No hypermarket branch yet")</div>
            </div></div>
            return;
        }

        @if (branches.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2 mb-5">
                @foreach (var b in branches)
                {
                    var on = branch != null && b.Id == branch.ID;
                    <a href="/hyper/setup/scales?branchId=@b.Id" class="btn btn-sm @(on ? "btn-primary" : "btn-light")">@(isAr ? (b.NameAr ?? b.Name) : (b.Name ?? b.NameAr))</a>
                }
            </div>
        }

        @if (!weightOn)
        {
            <div class="alert alert-warning d-flex align-items-start mb-6">
                <i class="ki-outline ki-information-5 fs-2tx me-4 mt-1"></i>
                <div>
                    <div class="fw-bold fs-6 mb-1">@(isAr ? "البيع بالوزن متوقف على هذا الفرع" : "Selling by weight is off for this branch")</div>
                    <div class="fs-7 text-gray-700">
                        @(isAr ? "يمكنك ضبط التنسيق هنا، لكن الصندوق سيرفض باركود الميزان حتى تُفعَّل قدرة «الوزن»." : "You can set the format here, but the till refuses a scale barcode until the Weight capability is on.")
                        <a href="/hyper/setup/capabilities?branchId=@(branch?.ID)" class="fw-bold">@(isAr ? "قدرات الفرع" : "Branch capabilities")</a>
                    </div>
                </div>
            </div>
        }

        <div class="row g-5 g-xl-8">
            <div class="col-xl-5">
                <form method="post" action="/hyper/setup/scales">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                    <div class="card">
                        <div class="card-header min-h-50px align-items-center">
                            <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? "تنسيق باركود الميزان" : "Scale barcode format")</h3>
                            <div class="card-toolbar"><button type="submit" class="btn btn-sm btn-primary"><i class="ki-outline ki-check fs-5"></i>@(isAr ? "حفظ" : "Save")</button></div>
                        </div>
                        <div class="card-body pt-4">
                            @* THE WHOLE RISK OF THIS SCREEN, said where it is acted on. A wrong width does not
                               error — it reads the wrong digits as the weight and undercharges silently. *@
                            <div class="bg-light-danger rounded p-4 mb-5 fs-7" style="line-height:1.9">
                                <b>@(isAr ? "تنسيق خاطئ لا يُعطي خطأ." : "A wrong format does not raise an error.")</b>
                                @(isAr
                                    ? " يقرأ الصندوق أرقاماً أخرى على أنها الوزن فيبيع ٨.٥ كجم بسعر ٠.٨٥٠ — في كل مرة، بصمت، حتى يُجرَد المخزون. لذلك يُتحقَّق من الطول هنا قبل الحفظ."
                                    : " The till reads other digits as the weight and sells 8.5 kg at the price of 0.850 — every time, silently, until stock is counted. That is why the length is checked here before saving.")
                            </div>

                            <div class="row g-4">
                                <div class="col-6 fv-row">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "البادئة" : "Prefix")</label>
                                    <input name="prefix" value="@pfx" class="form-control form-control-solid" style="font-variant-numeric:tabular-nums" />
                                    <div class="fs-8 text-muted mt-1">@(isAr ? "المدى المحجوز للموازين" : "The range reserved for scales")</div>
                                </div>
                                <div class="col-6 fv-row">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "طول رمز الصنف" : "Item-code length")</label>
                                    <input name="itemCodeLength" type="number" min="1" value="@icl" class="form-control form-control-solid" />
                                </div>
                                <div class="col-6 fv-row">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "طول القيمة" : "Value length")</label>
                                    <input name="valueLength" type="number" min="1" value="@vl" class="form-control form-control-solid" />
                                </div>
                                <div class="col-6 fv-row">
                                    <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "خانات عشرية للوزن" : "Value decimals")</label>
                                    <input name="valueDecimals" type="number" min="0" value="@vd" class="form-control form-control-solid" />
                                </div>
                            </div>

                            <div class="separator separator-dashed my-5"></div>
                            <div class="fs-7 text-gray-700" style="line-height:1.9">
                                <div class="fw-bold mb-2">@(isAr ? "الشكل الناتج" : "The resulting label")</div>
                                <span style="font-variant-numeric:tabular-nums">
                                    @pfx<span class="text-muted">·</span>@(new string('C', Math.Max(0, icl)))<span class="text-muted">·</span>@(new string('V', Math.Max(0, vl)))<span class="text-muted">·</span>K
                                </span>
                                <div class="fs-8 text-muted mt-2">
                                    @(isAr ? "C رمز الصنف · V القيمة · K رقم التحقق — المجموع يجب أن يكون ١٣ خانة." : "C item code · V value · K check digit — the total must be 13 digits.")
                                </div>
                                <div class="fs-8 text-muted mt-2">
                                    @(isAr ? "النوع: وزن · خوارزمية التحقق: EanMod10 — وهما الوحيدان المنفَّذان في الصندوق، فلا يُعرضان كخيار." : "Type: weight · check: EanMod10 — the only two the till implements, so neither is offered as a choice.")
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-xl-7">
                <div class="card">
                    <div class="card-header min-h-50px align-items-center">
                        <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? "الأصناف الموزونة" : "Weighed items")</h3>
                        <div class="card-toolbar"><span class="badge badge-light">@weighed.Count</span></div>
                    </div>
                    <div class="card-body pt-4">
                        @if (weighed.Count == 0)
                        {
                            <div class="text-center text-muted py-10 fs-7">
                                @(isAr ? "لا يوجد صنف موزون بعد — أضف رمز ميزان لصنف من الأسفل." : "No weighed item yet — give an item a scale code below.")
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle gy-4 mb-0">
                                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                        <th class="ps-4">@(isAr ? "الصنف" : "Item")</th>
                                        <th style="width:150px">@(isAr ? "رمز الميزان" : "Scale code")</th>
                                        <th style="width:110px">@(isAr ? "نشط" : "Active")</th>
                                        <th class="pe-4" style="width:130px"></th>
                                    </tr></thead>
                                    <tbody class="fs-6">
                                        @foreach (var w in weighed)
                                        {
                                            <tr>
                                                <td class="ps-4"><span class="fw-bold text-gray-800">@(isAr ? w.Name : (w.NameEn ?? w.Name))</span></td>
                                                <td><span class="badge badge-light-primary fw-bold" style="font-variant-numeric:tabular-nums">@w.ScaleCode</span></td>
                                                <td>@(w.IsActive ? Html.Raw("<span class=\"badge badge-light-success fw-bold\">" + (isAr ? "نشط" : "Active") + "</span>") : Html.Raw("<span class=\"badge badge-light fw-bold text-muted\">" + (isAr ? "موقوف" : "Inactive") + "</span>"))</td>
                                                <td class="pe-4">
                                                    <form method="post" action="/hyper/setup/weighed" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                                                        <input type="hidden" name="itemId" value="@w.Id" />
                                                        <input type="hidden" name="isWeighted" value="false" />
                                                        <button type="submit" class="btn btn-sm btn-light-danger" data-cb-confirm="@(isAr ? "إلغاء الوزن عن هذا الصنف؟" : "Stop selling this item by weight?")">@(isAr ? "إلغاء الوزن" : "Unset")</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="separator separator-dashed my-5"></div>
                        <form method="post" action="/hyper/setup/weighed" class="row g-3 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                            <input type="hidden" name="isWeighted" value="true" />
                            <div class="col-md-5 fv-row">
                                <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "رقم الصنف" : "Item id")</label>
                                <input name="itemId" type="number" min="1" class="form-control form-control-solid" required />
                            </div>
                            <div class="col-md-4 fv-row">
                                <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "رمز الميزان" : "Scale code")</label>
                                <input name="scaleCode" type="number" min="1" class="form-control form-control-solid" required />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100"><i class="ki-outline ki-plus fs-4"></i>@(isAr ? "إضافة" : "Add")</button>
                            </div>
                        </form>
                        <div class="fs-8 text-muted mt-3">
                            @(isAr ? "رمز الميزان فريد داخل الشركة — لو كان مستخدماً يُرفض الحفظ بدل أن يصير صنف غير قابل للوصول." : "A scale code is unique per company — a duplicate is refused rather than leaving one item unreachable.")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
