@using CrossBuy.Controllers
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var branches = ViewBag.HyperBranches as List<HyperController.HyperBranchItem> ?? new();
    var branch = ViewBag.Branch as CrossBuy.Models.Context.Admin.Branch;
    var setting = ViewBag.Setting as CrossBuy.Models.Context.Pos.BranchPosSetting;
    var cats = ViewBag.Categories as List<HyperController.HyperCatRow> ?? new();
    var companyRate = ViewBag.CompanyRate as decimal?;
    var loyaltyOn = ViewBag.LoyaltyOn as bool? ?? false;
    var branchRate = setting?.LoyaltyPointsPerCurrencyUnit;
    ViewData["Title"] = isAr ? "برنامج الولاء" : "Loyalty programme";

    var msgMap = new Dictionary<string, string> {
        ["loyalty-saved"] = isAr ? "حُفظ معدّل النقاط." : "The points rate was saved.",
        ["loyalty-category-saved"] = isAr ? "حُفظت أهلية الفئة." : "Category eligibility was saved.",
        ["not-hyper-branch"] = isAr ? "هذا الفرع ليس فرع هايبر ماركت." : "This branch is not a hypermarket branch.",
        ["no-permission"] = isAr ? "لا تملك صلاحية تعديل إعدادات هذا الفرع." : "You may not change this branch’s setup."
    };
    Func<object, string> say = c => { var k = c as string ?? ""; return msgMap.TryGetValue(k, out var v) ? v : k; };
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-xxl">

        @if (TempData["HyperMsg"] != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-6"><i class="ki-outline ki-check-circle fs-2 me-3"></i>@say(TempData["HyperMsg"])</div>
        }
        @if (TempData["HyperErr"] != null)
        {
            <div class="alert alert-danger d-flex align-items-start mb-6"><i class="ki-outline ki-information-5 fs-2 me-3 mt-1"></i><div>@say(TempData["HyperErr"])</div></div>
        }

        @if (ViewBag.NoBranch == true)
        {
            <div class="card"><div class="card-body p-10 text-center">
                <i class="ki-outline ki-shop fs-3tx text-muted mb-4 d-block"></i>
                <div class="fs-5 fw-bold text-gray-800">@(isAr ? "لا يوجد فرع هايبر ماركت بعد" : "No hypermarket branch yet")</div>
            </div></div>
            return;
        }

        @if (branches.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2 mb-5">
                @foreach (var b in branches)
                {
                    var on = branch != null && b.Id == branch.ID;
                    <a href="/hyper/setup/loyalty?branchId=@b.Id" class="btn btn-sm @(on ? "btn-primary" : "btn-light")">@(isAr ? (b.NameAr ?? b.Name) : (b.Name ?? b.NameAr))</a>
                }
            </div>
        }

        @* THE HONEST HEADLINE, now reporting three separate facts instead of one flat "not built".
           Redemption EXISTS as of HM-22, but it only runs when all three line up, and each is fixed in a
           different place by a different person. Reporting only the capability would send a shop looking
           for a feature that is switched on and still refuses. *@
        @{
            var ptValue = (decimal)(ViewBag.PointValue ?? 0m);
            var ptTender = ViewBag.PointsTenderOk as bool? ?? false;
            var redeemReady = loyaltyOn && ptValue > 0m && ptTender;
        }
        <div class="alert @(redeemReady ? "alert-success" : (loyaltyOn ? "alert-danger" : "alert-primary")) d-flex align-items-start mb-6">
            <i class="ki-outline ki-information-5 fs-2tx me-4 mt-1"></i>
            <div class="min-w-0">
                <div class="fw-bold fs-6 mb-2">
                    @(redeemReady
                        ? (isAr ? "الكسب والاستبدال كلاهما يعمل" : "Earning and redemption both work")
                        : (isAr ? "الكسب يعمل · الاستبدال ينقصه ما يلي" : "Earning works · redemption is missing something"))
                </div>
                <div class="fs-7 text-gray-700 mb-3" style="line-height:1.9">
                    @(isAr
                        ? "النقاط تُحتسب وتُقيَّد في دفتر الحركات على كل بيعة مؤهَّلة. وصرفها يتم على الصندوق كوسيلة دفع لا كخصم — فقيمة البيعة وضريبتها لا تتغيّران، والنقاط تسدّد جزءاً مما هو مستحق."
                        : "Points are computed and written to the movements ledger on every eligible sale. Spending them happens at the till as a TENDER, not a discount — the sale’s value and its tax are unchanged, and the points settle part of what is due.")
                </div>

                <div class="d-flex flex-column gap-2">
                    <div class="d-flex align-items-start gap-2 fs-7">
                        <i class="ki-outline @(loyaltyOn ? "ki-check-circle text-success" : "ki-cross-circle text-danger") fs-4 mt-1"></i>
                        <div>
                            <span class="fw-bold text-gray-800">@(isAr ? "قدرة «الولاء» على هذا الفرع" : "The branch’s “Loyalty” capability")</span>
                            @if (!loyaltyOn)
                            {
                                <a href="/hyper/setup/capabilities?branchId=@(branch?.ID)" class="fw-bold ms-2">@(isAr ? "شغّلها" : "Turn it on")</a>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-2 fs-7">
                        <i class="ki-outline @(ptValue > 0m ? "ki-check-circle text-success" : "ki-cross-circle text-danger") fs-4 mt-1"></i>
                        <div>
                            <span class="fw-bold text-gray-800">@(isAr ? "قيمة النقطة بالعملة" : "The currency value of one point")</span>
                            <span class="text-muted ms-2" style="font-variant-numeric:tabular-nums">
                                @(ptValue > 0m
                                    ? ptValue.ToString()
                                    : (isAr ? "غير مضبوطة — Pos:LoyaltyPointValue في الإعدادات" : "not set — Pos:LoyaltyPointValue in configuration"))
                            </span>
                            @* THE PERCENTAGE IS THE NUMBER PEOPLE ACTUALLY DECIDE. Nobody can answer "what is a
                               point worth" cold; everybody can answer "what are we giving back". It is the
                               product of the two stored numbers, so show it rather than make them multiply. *@
                            @if (ptValue > 0m && (branchRate ?? companyRate) is decimal er && er > 0m)
                            {
                                <span class="d-block fs-8 text-gray-700 mt-1">
                                    @(isAr
                                        ? $"أي {(ptValue * er * 100m).ToString("0.##")}% تُعاد للعميل، بمعدّل الكسب الحالي."
                                        : $"= {(ptValue * er * 100m).ToString("0.##")}% given back, at the current earn rate.")
                                </span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-2 fs-7">
                        <i class="ki-outline @(ptTender ? "ki-check-circle text-success" : "ki-cross-circle text-danger") fs-4 mt-1"></i>
                        <div>
                            <span class="fw-bold text-gray-800">@(isAr ? "وسيلة دفع «Points» بحساب على هذا الفرع" : "A “Points” payment method with an account on this branch")</span>
                            @if (!ptTender)
                            {
                                <a href="/Pos/PaymentMethods" class="fw-bold ms-2">@(isAr ? "أضفها" : "Add it")</a>
                            }
                        </div>
                    </div>
                </div>

                @* WHOEVER READS THE LIABILITY ACCOUNT MUST BE TOLD THIS ONCE, here, where the scheme is
                   switched on — not in a conversation between two people who will not be the ones reading
                   it later. Points are deferred at FULL nominal value with no breakage estimate. IFRS 15
                   permits measuring the liability at the amount expected to be redeemed, and roughly half
                   of issued rewards never are, so deferring everything overstates what the shop will
                   really hand over. That is the conservative direction and deliberate — but a balance that
                   never fully unwinds is otherwise read as an error rather than as the policy it is. *@
                @if (redeemReady)
                {
                    <div class="fs-8 text-gray-700 mt-3 pt-3" style="border-top:1px dashed var(--bs-gray-300);line-height:1.9">
                        @(isAr
                            ? "ملاحظة محاسبية: الالتزام يُؤجَّل بالقيمة الاسمية الكاملة للنقاط، بلا تقدير لما لن يُصرف. والمعيار يسمح بقياسه بما يُتوقَّع استبداله فقط، ونحو نصف المكافآت لا تُصرف عادةً — فرصيد حساب الالتزام يقرأ أعلى مما سيُسلَّم فعلاً، وينحسر تدريجياً مع سقوط النقاط. هذا اتجاه متحفّظ ومقصود، لا خطأ في الرصيد."
                            : "Accounting note: the liability is deferred at the points’ FULL nominal value, with no estimate of what will go unredeemed. The standard permits measuring it at the amount expected to be redeemed, and roughly half of issued rewards never are — so the liability account reads higher than what the shop will actually hand over, and unwinds as points lapse. That is conservative and deliberate, not an error in the balance.")
                    </div>
                }
                @if (loyaltyOn && !redeemReady)
                {
                    <div class="fs-7 fw-bold text-danger mt-3">
                        @(isAr
                            ? "القدرة مفعَّلة والاستبدال لا يعمل — العملاء يجمعون نقاطاً لا منفذ لصرفها حتى يكتمل الناقص أعلاه."
                            : "The capability is on but redemption cannot run — customers are accruing points with no way to spend them until the above is completed.")
                    </div>
                }
            </div>
        </div>

        <div class="row g-5 g-xl-8">
            <div class="col-xl-5">
                <form method="post" action="/hyper/setup/loyalty">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                    <div class="card">
                        <div class="card-header min-h-50px align-items-center">
                            <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? "معدّل النقاط" : "Points rate")</h3>
                            <div class="card-toolbar"><button type="submit" class="btn btn-sm btn-primary"><i class="ki-outline ki-check fs-5"></i>@(isAr ? "حفظ" : "Save")</button></div>
                        </div>
                        <div class="card-body pt-4">
                            <div class="fs-7 text-muted mb-4" style="line-height:1.9">
                                @(isAr ? "نقاط لكل وحدة عملة، على صافي قيمة الأسطر المؤهَّلة فقط." : "Points per unit of currency, on the net value of eligible lines only.")
                            </div>

                            <div class="fv-row mb-4">
                                <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "معدّل الشركة (الافتراضي)" : "Company rate (default)")</label>
                                <input name="companyRate" type="number" step="any" min="0" value="@(companyRate?.ToString())" class="form-control form-control-solid" style="font-variant-numeric:tabular-nums" placeholder="@(isAr ? "بلا معدّل" : "no rate")" />
                            </div>

                            <div class="fv-row">
                                <label class="fw-semibold fs-7 text-gray-700 mb-2">@(isAr ? "معدّل هذا الفرع" : "This branch’s rate")</label>
                                <input name="branchRate" type="number" step="any" min="0" value="@(branchRate?.ToString())" class="form-control form-control-solid" style="font-variant-numeric:tabular-nums" placeholder="@(isAr ? "يرث معدّل الشركة" : "inherits the company rate")" />
                                <div class="fs-8 text-muted mt-2" style="line-height:1.8">
                                    @(isAr
                                        ? "فارغ = يرث معدّل الشركة. صفر = هذا الفرع لا يمنح نقاطاً — وهما ليسا الشيء نفسه."
                                        : "Empty = inherit the company rate. Zero = this branch awards nothing — the two are not the same thing.")
                                </div>
                            </div>

                            @if (branchRate != null)
                            {
                                <div class="form-check form-check-custom form-check-solid mt-4">
                                    <input class="form-check-input" type="checkbox" name="clearBranch" value="true" id="clearBranch" />
                                    <label class="form-check-label fs-7" for="clearBranch">@(isAr ? "امسح معدّل الفرع (ارجع لمعدّل الشركة)" : "Clear the branch rate (fall back to the company’s)")</label>
                                </div>
                            }

                            <div class="separator separator-dashed my-5"></div>
                            <div class="fs-8 text-muted" style="line-height:1.9">
                                <div class="fw-bold text-gray-700 mb-1">@(isAr ? "المعدّل الساري الآن" : "Rate in force now")</div>
                                @if (branchRate != null)
                                {
                                    <span style="font-variant-numeric:tabular-nums">@branchRate</span> <span>@(isAr ? "— من الفرع" : "— from the branch")</span>
                                }
                                else if (companyRate != null)
                                {
                                    <span style="font-variant-numeric:tabular-nums">@companyRate</span> <span>@(isAr ? "— موروث من الشركة" : "— inherited from the company")</span>
                                }
                                else
                                {
                                    <span>@(isAr ? "لا معدّل — لا تُحتسب نقاط" : "No rate — nothing is accrued")</span>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-xl-7">
                <div class="card">
                    <div class="card-header min-h-50px align-items-center">
                        <h3 class="card-title fs-5 fw-bold text-gray-900">@(isAr ? "أهلية الفئات" : "Category eligibility")</h3>
                        <div class="card-toolbar"><span class="badge badge-light">@(ViewBag.CatTotal ?? cats.Count)</span></div>
                    </div>
                    <div class="card-body pt-4">
                        @* Search and paging, because the full list ran off the bottom of the page at 49 rows
                           and grows with every category the shop adds. *@
                        <form method="get" action="/hyper/setup/loyalty" class="d-flex gap-2 mb-4">
                            <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                            <input name="catQ" value="@(ViewBag.CatQ as string)" type="text"
                                   class="form-control form-control-solid form-control-sm"
                                   placeholder="@(isAr ? "ابحث في الفئات…" : "Search categories…")" />
                            <button type="submit" class="btn btn-sm btn-light-primary">@(isAr ? "بحث" : "Search")</button>
                            @if (!string.IsNullOrWhiteSpace(ViewBag.CatQ as string))
                            {
                                <a href="/hyper/setup/loyalty?branchId=@(branch?.ID)" class="btn btn-sm btn-light">@(isAr ? "إلغاء" : "Clear")</a>
                            }
                        </form>
                        <div class="fs-8 text-muted mb-4" style="line-height:1.9">
                            @(isAr
                                ? "الصنف قد يخالف فئته: إن كان حقل الأهلية على الصنف فارغاً ورث الفئة، وإن كان محدَّداً غلب عليها. فإيقاف فئة هنا لا يُلغي قراراً اتُّخذ على صنف بعينه."
                                : "An item may override its category: an empty eligibility flag on the item inherits the category, a set one wins. So switching a category off here does not overrule a decision taken on a specific item.")
                        </div>

                        @if (cats.Count == 0)
                        {
                            <div class="text-muted fs-7 py-6 text-center">@(isAr ? "لا فئات أصناف بعد." : "No item categories yet.")</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle gy-3 mb-0">
                                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                        <th class="ps-4">@(isAr ? "الفئة" : "Category")</th>
                                        <th class="pe-4" style="width:190px">@(isAr ? "تكسب نقاطاً؟" : "Earns points?")</th>
                                    </tr></thead>
                                    <tbody class="fs-6">
                                        @foreach (var c in cats)
                                        {
                                            <tr>
                                                <td class="ps-4"><span class="fw-bold text-gray-800">@(isAr ? c.Name : (c.NameEn ?? c.Name))</span></td>
                                                <td class="pe-4">
                                                    <form method="post" action="/hyper/setup/loyalty/category" class="d-inline-flex align-items-center gap-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="branchId" value="@(branch?.ID ?? 0)" />
                                                        <input type="hidden" name="catQ" value="@(ViewBag.CatQ as string)" />
                                                        <input type="hidden" name="catPage" value="@(ViewBag.CatPage ?? 1)" />
                                                        <input type="hidden" name="categoryId" value="@c.Id" />
                                                        <input type="hidden" name="eligible" value="@((!c.Eligible).ToString().ToLowerInvariant())" />
                                                        @if (c.Eligible)
                                                        {
                                                            <span class="badge badge-light-success fw-bold">@(isAr ? "تكسب" : "Earns")</span>
                                                            <button type="submit" class="btn btn-sm btn-light">@(isAr ? "إيقاف" : "Turn off")</button>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-light fw-bold text-muted">@(isAr ? "لا تكسب" : "Excluded")</span>
                                                            <button type="submit" class="btn btn-sm btn-light-primary">@(isAr ? "تشغيل" : "Turn on")</button>
                                                        }
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @* Bare, NOT @{ }: this whole region is already inside the `else { }` body of the
                               block above, so the parser is in C# here even though markup was emitted in
                               between. Verified by build both ways — @{ } here is RZ1010. *@
                            int cPage = (int)(ViewBag.CatPage ?? 1);
                            int cPages = (int)(ViewBag.CatPages ?? 1);
                            var cQ = ViewBag.CatQ as string;
                            @if (cPages > 1)
                            {
                                <div class="d-flex flex-stack mt-4">
                                    <span class="fs-8 text-muted">@(isAr ? $"صفحة {cPage} من {cPages}" : $"Page {cPage} of {cPages}")</span>
                                    <div class="d-flex gap-2">
                                        @if (cPage > 1)
                                        {
                                            <a href="/hyper/setup/loyalty?branchId=@(branch?.ID)&amp;catQ=@cQ&amp;catPage=@(cPage - 1)" class="btn btn-sm btn-light">@(isAr ? "السابق" : "Previous")</a>
                                        }
                                        @if (cPage < cPages)
                                        {
                                            <a href="/hyper/setup/loyalty?branchId=@(branch?.ID)&amp;catQ=@cQ&amp;catPage=@(cPage + 1)" class="btn btn-sm btn-light">@(isAr ? "التالي" : "Next")</a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
