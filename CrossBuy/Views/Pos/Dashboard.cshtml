@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model PosDashboardDto
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    string Raw(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    // order-type meta — brand palette only (no green / amber)
    var typeMeta = new Dictionary<string, (string label, string color, string icon)>
    {
        ["Dine-in"] = (Localizer["Dine-in"].Value, "primary", "ki-cup"),
        ["Takeaway"] = (Localizer["Takeaway"].Value, "info", "ki-handcart"),
        ["Delivery"] = (Localizer["Delivery"].Value, "dark", "ki-scooter"),
    };
    (string label, string color, string icon) tm(string k) => typeMeta.TryGetValue(k, out var v) ? v : (k, "secondary", "ki-basket");
}
<style>
    /* Restaurant cockpit — the prototype design on the real data. Brand navy #3A5795 → #1F2D4D, no green, no amber. */
    .rdash { font-feature-settings: "tnum"; }
    .rdash .rdcard { border: 0 !important; border-radius: 16px !important; box-shadow: 0 1px 2px rgba(31,45,77,.05), 0 10px 28px -14px rgba(31,45,77,.18) !important; }
    .rdash .rdsq { width: 52px; height: 52px; flex: none; border-radius: 15px; display: inline-flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #3A5795 0%, #1F2D4D 100%); color: #fff; box-shadow: 0 8px 18px -8px rgba(31,45,77,.5); }
    .rdash .rdsq i { color: #fff !important; font-size: 1.6rem !important; }
    .rdash .rdval { font-weight: 800; font-size: 1.9rem; color: #1F2D4D; line-height: 1; letter-spacing: -.5px; }
    .rdash .rdlab { color: #5a6579; font-weight: 600; font-size: .82rem; margin-top: .3rem; }
    /* hero */
    .rdash .rdhero { position: relative; overflow: hidden; border-radius: 20px; color: #fff;
        background: linear-gradient(120deg, #1F2D4D 0%, #2B4170 55%, #3A5795 100%); }
    .rdash .rdhero::after { content: ''; position: absolute; width: 360px; height: 360px; border-radius: 50%; inset-inline-end: -120px; top: -150px;
        background: radial-gradient(circle, rgba(253,164,175,.22) 0%, rgba(255,255,255,0) 70%); }
    .rdash .rdhero > * { position: relative; z-index: 1; }
    .rdash .rdeyebrow { color: rgba(255,255,255,.65); letter-spacing: .08em; font-weight: 700; font-size: .75rem; text-transform: uppercase; }
    .rdash .rdglass { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18); border-radius: 16px; }
    .rdash .rdchip { display: inline-flex; align-items: center; gap: .4rem; border-radius: 999px; padding: .35rem .85rem; font-weight: 700; font-size: .8rem;
        background: rgba(255,255,255,.12); color: #fff; }
    /* quick access */
    .rdash .qa-tile { transition: transform .15s ease, box-shadow .15s ease; }
    .rdash .qa-tile:hover { transform: translateY(-3px); box-shadow: 0 14px 30px -16px rgba(31,45,77,.3); border-color: #C8D1E3 !important; }
    .rdash .rank { width: 30px; height: 30px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; font-weight: 800;
        background: #E7F0FF; color: #3A5795; }
</style>

<div class="d-flex flex-column flex-column-fluid rdash">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Restaurant"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">@Localizer["Home"]</li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@Localizer["Dashboard"]</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <a href="@Url.Action("Setup","Pos")" class="btn btn-sm btn-light fw-bold"><i class="ki-outline ki-setting-2 fs-3"></i>@Localizer["Operations setup"]</a>
                <a href="@Url.Action("Start","PosApp")" class="btn btn-sm btn-primary fw-bold"><i class="ki-outline ki-handcart fs-3"></i>@Localizer["Cashier terminal"]</a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <!-- Hero -->
            <div class="rdhero mb-6 p-8 p-lg-10">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-7">
                    <div class="flex-grow-1 min-w-0">
                        <div class="rdchip mb-3"><i class="ki-outline ki-shop fs-5 text-white"></i>@Localizer["Restaurant"]</div>
                        <div class="fw-bolder text-white lh-sm mb-2" style="font-size:clamp(1.6rem,3.5vw,2.4rem)">@Localizer["Sales this month"]</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="fw-bolder text-white lh-1" style="font-size:clamp(2rem,5vw,3rem)">@Model.SalesMonth.ToString("N2")</span>
                            <span class="text-white opacity-75 fw-bold fs-5">@Localizer["EGP"]</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <span class="rdchip"><i class="ki-outline ki-handcart fs-6 text-white"></i>@Localizer["Orders"] <b class="ms-1">@Model.OrdersMonth</b></span>
                            <span class="rdchip"><i class="ki-outline ki-basket fs-6 text-white"></i>@Localizer["Average ticket"] <b class="ms-1">@Model.AvgTicket.ToString("N2")</b></span>
                        </div>
                    </div>
                    <div class="rdglass p-6 flex-shrink-0 w-lg-300px">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div>
                                <div class="text-white opacity-75 fw-semibold fs-8 mb-1">@Localizer["Sales today"]</div>
                                <div class="text-white fw-bolder lh-1" style="font-size:2.2rem">@Model.SalesToday.ToString("N2")</div>
                            </div>
                            <span class="rdsq" style="background:rgba(255,255,255,.14)"><i class="ki-outline ki-dollar"></i></span>
                        </div>
                        <a href="@Url.Action("Start","PosApp")" class="btn btn-sm btn-light fw-bold w-100 rounded-pill"><i class="ki-outline ki-handcart fs-5"></i>@Localizer["Cashier terminal"]</a>
                    </div>
                </div>
            </div>

            <!-- Stat tiles -->
            @{
                var tiles = new (string value, string label, string icon, string badge)[] {
                    (Model.SalesMonth.ToString("N0"), Localizer["Sales this month"].Value, "ki-dollar", Model.Year.ToString()),
                    (Model.OrdersMonth.ToString(), Localizer["Orders"].Value, "ki-handcart", Localizer["This month"].Value),
                    (Model.AvgTicket.ToString("N0"), Localizer["Average ticket"].Value, "ki-basket", Localizer["Per order"].Value),
                    (Model.OpenOrders.ToString(), Localizer["Open orders"].Value, "ki-time", $"{Model.OccupiedTables} {Localizer["tables"].Value}"),
                    (Model.OpenShifts.ToString(), Localizer["Open shifts"].Value, "ki-devices", $"{Model.Terminals} {Localizer["terminals"].Value}"),
                };
            }
            <div class="row g-4 mb-6">
                @foreach (var t in tiles)
                {
                    <div class="col-6 col-xl">
                        <div class="card rdcard h-100"><div class="card-body d-flex align-items-center gap-4 py-5">
                            <span class="rdsq"><i class="ki-outline @t.icon"></i></span>
                            <div class="min-w-0"><div class="rdval">@t.value</div><div class="rdlab">@t.label</div></div>
                            @if (!string.IsNullOrEmpty(t.badge)) { <span class="badge badge-light-primary fw-bold fs-8 ms-auto">@t.badge</span> }
                        </div></div>
                    </div>
                }
            </div>

            <!-- Sales chart + floor-now -->
            <div class="row g-5 mb-6">
                <div class="col-xl-8">
                    <div class="card rdcard h-100">
                        <div class="card-header pt-6"><div class="card-title flex-column align-items-start">
                            <span class="card-label fw-bold text-gray-900 fs-4">@Localizer["Sales"]</span>
                            <span class="text-muted fw-semibold fs-7 mt-1">@Localizer["Last 7 days"]</span></div></div>
                        <div class="card-body pt-2 px-3 pb-3"><div id="pos_sales_chart" style="height:300px"></div></div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card rdcard h-100">
                        <div class="card-header pt-6"><div class="card-title"><span class="card-label fw-bold text-gray-900 fs-4">@Localizer["Floor plan"]</span></div></div>
                        <div class="card-body pt-2 d-flex flex-column gap-3">
                            <div class="d-flex align-items-center justify-content-between p-4 rounded bg-light-primary">
                                <span class="fw-semibold text-gray-800"><i class="ki-outline ki-shop fs-4 text-primary me-2"></i>@Localizer["Occupied"]</span>
                                <span class="fw-bold fs-3 text-primary">@Model.OccupiedTables</span></div>
                            <div class="d-flex align-items-center justify-content-between p-4 rounded" style="background:#F6F8FC">
                                <span class="fw-semibold text-gray-800">@Localizer["Open orders"]</span>
                                <span class="fw-bold fs-3 text-gray-900">@Model.OpenOrders</span></div>
                            <div class="d-flex align-items-center justify-content-between p-4 rounded" style="background:#F6F8FC">
                                <span class="fw-semibold text-gray-800">@Localizer["Open shifts"]</span>
                                <span class="fw-bold fs-3 text-gray-900">@Model.OpenShifts</span></div>
                            <a href="@Url.Action("FloorPlan","Pos")" class="btn btn-light-primary fw-bold mt-1"><i class="ki-outline ki-geolocation fs-4"></i>@Localizer["Floor plan"]</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent orders + orders by type -->
            <div class="row g-5 mb-6">
                <div class="col-xl-8">
                    <div class="card rdcard h-100">
                        <div class="card-header pt-6"><div class="card-title flex-column align-items-start">
                            <span class="card-label fw-bold text-gray-900 fs-4">@Localizer["Recent orders"]</span>
                            <span class="text-muted fw-semibold fs-7 mt-1">@Localizer["Paid"]</span></div>
                            <div class="card-toolbar"><a href="@Url.Action("Start","PosApp")" class="btn btn-sm btn-light-primary rounded-pill">@SR["View"]</a></div></div>
                        <div class="card-body pt-2">
                            <div class="table-responsive"><table class="table table-row-dashed align-middle fs-6 gy-3 my-0" style="font-variant-numeric:tabular-nums">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                    <th>@Localizer["Receipt"]</th><th>@SR["Type"]</th><th>@SR["Date"]</th><th class="text-end">@Localizer["Total"]</th><th class="text-center">@SR["Status"]</th></tr></thead>
                                <tbody>
                                    @if (Model.Recent.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-10">@SR["NoData"]</td></tr> }
                                    @foreach (var o in Model.Recent)
                                    {
                                        var m = tm(o.Type);
                                        <tr>
                                            <td class="fw-bold text-gray-900">@(string.IsNullOrEmpty(o.ReceiptNo) ? "—" : o.ReceiptNo)</td>
                                            <td><span class="badge badge-light-@m.color fw-bold"><i class="ki-outline @m.icon fs-7 me-1"></i>@m.label</span></td>
                                            <td class="text-muted fw-semibold">@o.When.ToString("yyyy/MM/dd HH:mm")</td>
                                            <td class="text-end fw-bold text-gray-900">@o.Total.ToString("N2")</td>
                                            <td class="text-center"><span class="badge badge-light-primary fw-bold">@Localizer["Paid"]</span></td>
                                        </tr>
                                    }
                                </tbody></table></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card rdcard h-100">
                        <div class="card-header pt-6"><div class="card-title flex-column align-items-start">
                            <span class="card-label fw-bold text-gray-900 fs-4">@Localizer["Orders by type"]</span>
                            <span class="text-muted fw-semibold fs-7 mt-1">@Localizer["This month"]</span></div></div>
                        <div class="card-body pt-2">
                            @if (Model.ByType.Count == 0) { <div class="text-center text-muted py-15">@SR["NoData"]</div> }
                            else
                            {
                                foreach (var b in Model.ByType)
                                {
                                    var m = tm(b.Type);
                                    <div class="d-flex flex-stack mb-2">
                                        <span class="text-gray-700 fw-semibold flex-grow-1 text-truncate me-3"><i class="ki-outline @m.icon fs-6 text-@m.color me-2"></i>@m.label</span>
                                        <span class="text-gray-900 fw-bold me-3">@b.Amount.ToString("N0")</span></div>
                                    <div class="d-flex align-items-center w-100 mb-4">
                                        <div class="progress h-6px w-100 me-2 bg-light-@m.color"><div class="progress-bar bg-@m.color" style="width:@(b.Pct)%"></div></div>
                                        <span class="text-gray-500 fw-semibold fs-7">@b.Count</span></div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top items (menu) + quick access -->
            <div class="row g-5 mb-6">
                <div class="col-xl-7">
                    <div class="card rdcard h-100">
                        <div class="card-header pt-6"><div class="card-title flex-column align-items-start">
                            <span class="card-label fw-bold text-gray-900 fs-4">@Localizer["Top items"]</span>
                            <span class="text-muted fw-semibold fs-7 mt-1">@Localizer["This month"]</span></div></div>
                        <div class="card-body pt-2">
                            @if (Model.TopItems.Count == 0) { <div class="text-center text-muted py-10">@SR["NoData"]</div> }
                            else
                            {
                                var idx = 0;
                                foreach (var it in Model.TopItems)
                                {
                                    idx++;
                                    <div class="d-flex align-items-center mb-4">
                                        <span class="rank me-3">@idx</span>
                                        <div class="d-flex flex-column flex-grow-1 me-3 min-w-0">
                                            <span class="fw-bold text-gray-900 fs-7 text-truncate">@it.Name</span>
                                            <div class="progress h-5px mt-2 bg-light-primary"><div class="progress-bar bg-primary" style="width:@(it.Pct)%"></div></div></div>
                                        <div class="text-end"><div class="fw-bold text-gray-900">@it.Amount.ToString("N2")</div>
                                            <div class="text-muted fw-semibold fs-8">@it.Qty.ToString("0.##") @Localizer["qty"]</div></div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-xl-5">
                    <div class="card rdcard h-100">
                        <div class="card-header pt-6"><div class="card-title"><span class="card-label fw-bold text-gray-900 fs-4">@Localizer["Quick Access"]</span></div></div>
                        <div class="card-body pt-2">
                            <div class="row g-3">
                                @{
                                    var links = new (string action, string controller, string label, string icon)[] {
                                        ("Start", "PosApp", Localizer["Cashier terminal"].Value, "ki-handcart"),
                                        ("Kitchen", "PosApp", Localizer["Kitchen display"].Value, "ki-teacher"),
                                        ("Delivery", "PosApp", Localizer["Delivery board"].Value, "ki-scooter"),
                                        ("FloorPlan", "Pos", Localizer["Floor plan"].Value, "ki-geolocation"),
                                        ("Reservations", "Pos", Localizer["Reservations"].Value, "ki-calendar"),
                                        ("Setup", "Pos", Localizer["Operations setup"].Value, "ki-setting-2"),
                                    };
                                }
                                @foreach (var l in links)
                                {
                                    <div class="col-6 col-md-4">
                                        <a href="@Url.Action(l.action,l.controller)" class="qa-tile d-flex flex-column flex-center bg-body rounded h-100 py-5 border border-gray-200 text-decoration-none">
                                            <span class="rdsq mb-3"><i class="ki-outline @l.icon"></i></span>
                                            <span class="fs-8 fw-semibold text-gray-800 text-center px-1">@l.label</span>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!window.ApexCharts) return;
            var days = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last7.Select(p => p.Date.ToString("MM/dd"))));
            var totals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last7.Select(p => p.Total)));
            new ApexCharts(document.querySelector('#pos_sales_chart'), {
                chart: { type: 'area', height: 300, fontFamily: 'inherit', toolbar: { show: false } },
                series: [{ name: '@Localizer["Sales"]', data: totals }],
                colors: ['#3A5795'],
                xaxis: { categories: days, labels: { style: { colors: '#99A1B7' } } },
                yaxis: { labels: { style: { colors: '#99A1B7' }, formatter: function (v) { return Math.round(v); } } },
                stroke: { curve: 'smooth', width: 3 },
                fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.03, stops: [0, 90, 100] } },
                dataLabels: { enabled: false }, legend: { show: false },
                grid: { borderColor: '#E4E6EF', strokeDashArray: 4 },
                markers: { size: 0, hover: { size: 6 } }
            }).render();
        })();
    </script>
}
