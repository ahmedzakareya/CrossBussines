@using CrossBuy.Models.Context.Admin
@using CrossBuy.Models.Context.Pos
@using CrossBuy.Models.Context.Inventory
@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var companies = ViewBag.Companies as List<Companies> ?? new();
    int? fC = ViewBag.FilterCompanyId;
    var branches = ViewBag.Branches as List<Branch> ?? new();
    int? fB = ViewBag.FilterBranchId;
    var branch = ViewBag.Branch as Branch;
    var presets = ViewBag.Presets as List<ActivityPreset> ?? new();
    var capDefs = ViewBag.CapabilityDefs as (string key, string ar, string en)[] ?? Array.Empty<(string, string, string)>();
    var caps = ViewBag.Caps as Dictionary<string, bool> ?? new();
    var setting = ViewBag.PosSetting as BranchPosSetting;
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    var priceLists = ViewBag.PriceLists as List<PriceList> ?? new();
    var currencies = ViewBag.Currencies as List<Currency> ?? new();
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading fw-bold fs-3 m-0">@Localizer["Operations platform setup"]</h1>
            <span class="text-muted fs-7">@Localizer["Activity type enables branch capabilities. Configuration only — no GL/stock impact."]</span></div>
        @if (fB != null)
        {
            <div class="d-flex gap-2">
                <a href="@Url.Action("Areas","Pos", new { branchId = fB })" class="btn btn-light-primary"><i class="ki-outline ki-office-bag fs-2"></i>@Localizer["Areas & stations"]</a>
                <a href="@Url.Action("FloorPlan","Pos", new { branchId = fB })" class="btn btn-light-primary"><i class="ki-outline ki-geolocation fs-2"></i>@Localizer["Floor plan"]</a>
            </div>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["PosMsg"] != null) { <div class="alert alert-success">@TempData["PosMsg"]</div> }
        @if (TempData["PosErr"] != null) { <div class="alert alert-danger">@TempData["PosErr"]</div> }
        @if (fC != null && !branches.Any())
        {
            <div class="alert alert-warning d-flex align-items-center"><i class="ki-outline ki-information-5 fs-2 me-3"></i>
                <span>@Localizer["This company has no branches — add one first from the Branches screen."]
                    <a href="@Url.Action("BranchesList","Service")" class="fw-bold ms-1">@Localizer["Manage branches"]</a></span></div>
        }

        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-4"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Company"]</label>
                <select id="coSel" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["Select company"]</option>@foreach (var c in companies) { <option value="@c.CompanyID" selected="@(fC==c.CompanyID)">@(isAr ? (c.ComoanyNameAr ?? c.CompanyName) : c.CompanyName)</option> }</select></div>
            <div class="col-md-4"><label class="required fw-semibold fs-7 text-muted mb-1">@Localizer["Branch (Location)"]</label>
                <select id="brSel" class="form-select form-select-solid" data-control="select2" @(fC == null ? "disabled" : "")><option value="">@Localizer["Select branch"]</option>@foreach (var b in branches) { <option value="@b.ID" selected="@(fB==b.ID)">@(isAr ? (b.NameAr ?? b.Name) : b.Name)</option> }</select>
                </div>
            <div class="col-md-4"><div class="text-muted fs-7 mb-1">@Localizer["Current activity"]</div><div class="fw-bold fs-5">@(branch == null ? "—" : (string.IsNullOrEmpty(branch.ActivityPresetCode) ? Localizer["— none —"].Value : branch.ActivityPresetCode))</div></div>
        </div></div></div>

        @if (fB == null)
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-shop fs-3x mb-3 d-block"></i>@Localizer["Select a branch to set up the operations platform."]</div></div>
        }
        else
        {
            <div class="row g-5">
                <!-- activity type -->
                <div class="col-lg-6">
                    <div class="card h-100"><div class="card-header"><div class="card-title"><h3>@Localizer["Activity type"]</h3></div></div>
                        <div class="card-body">
                            <div class="text-muted fs-7 mb-4">@Localizer["Choosing a type turns on its default capabilities (editable afterward)."]</div>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var p in presets)
                                {
                                    var active = branch?.ActivityPresetCode == p.Code;
                                    <form asp-action="ApplyPreset" method="post" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Apply this activity type and reset its default capabilities?"]">
                                        @Html.AntiForgeryToken()<input type="hidden" name="branchId" value="@fB" /><input type="hidden" name="presetCode" value="@p.Code" />
                                        <button class="btn @(active ? "btn-primary" : "btn-light-primary") d-flex flex-column align-items-center py-4 px-6">
                                            <i class="ki-outline @(p.Code == "Restaurant" ? "ki-glass" : p.Code == "Cafe" ? "ki-coffee" : p.Code == "Hyper" ? "ki-basket" : "ki-handcart") fs-2x mb-2"></i>
                                            <span class="fw-bold">@(isAr ? p.Name : p.NameEn)</span>
                                            @if (active) { <span class="badge badge-light mt-1 fs-8">@SR["Active"]</span> }
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <!-- capabilities -->
                <div class="col-lg-6">
                    <div class="card h-100"><div class="card-header"><div class="card-title"><h3>@Localizer["Enabled capabilities"]</h3></div>
                        <div class="card-toolbar"><button type="submit" form="capForm" class="btn btn-sm btn-primary"><i class="ki-outline ki-check fs-3"></i>@SR["Save"]</button></div></div>
                        <div class="card-body">
                            <form id="capForm" asp-action="SaveCapabilities" method="post">@Html.AntiForgeryToken()<input type="hidden" name="branchId" value="@fB" />
                                <div class="row g-3">
                                    @foreach (var c in capDefs)
                                    {
                                        var on = caps.TryGetValue(c.key, out var v) && v;
                                        <div class="col-md-6"><label class="form-check form-switch form-check-custom form-check-solid">
                                            <input class="form-check-input" type="checkbox" name="enabled" value="@c.key" @(on ? "checked" : "") />
                                            <span class="form-check-label fw-semibold">@(isAr ? c.ar : c.en)</span></label></div>
                                    }
                                </div>
                                <div class="text-muted fs-8 mt-4">@Localizer["Capabilities drive what the cashier surface shows later."]</div>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- POS sales settings -->
                <div class="col-12">
                    <div class="card"><div class="card-header"><div class="card-title"><h3>@Localizer["POS sales settings"]</h3></div></div>
                        <div class="card-body">
                            <form asp-action="SavePosSetting" method="post">@Html.AntiForgeryToken()<input type="hidden" name="branchId" value="@fB" />
                                <div class="row g-4">
                                    <div class="col-md-4"><label class="fw-semibold fs-7 mb-2">@Localizer["Default sales warehouse"]</label>
                                        <select name="defaultSalesWarehouseId" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["— select —"]</option>@foreach (var w in whs) { <option value="@w.ID" selected="@(setting?.DefaultSalesWarehouseId==w.ID)">@w.Code — @(isAr ? w.Name : w.NameEn)</option> }</select>
                                        <div class="text-muted fs-8 mt-1">@Localizer["The cashier deducts stock from here later."]</div></div>
                                    <div class="col-md-4"><label class="fw-semibold fs-7 mb-2">@Localizer["Price list"]</label>
                                        <select name="defaultPriceListId" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["— engine default —"]</option>@foreach (var p in priceLists) { <option value="@p.ID" selected="@(setting?.DefaultPriceListId==p.ID)">@(isAr ? p.Name : (p.NameEn ?? p.Name))</option> }</select>
                                        <div class="text-muted fs-8 mt-1">@Localizer["Applied via the existing PricingService."]</div></div>
                                    <div class="col-md-2"><label class="fw-semibold fs-7 mb-2">@Localizer["Service %"]</label>
                                        <input type="number" step="0.01" min="0" name="serviceChargePct" value="@(setting?.ServiceChargePct?.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="form-control form-control-solid" placeholder="0" /></div>
                                    <div class="col-md-2"><label class="fw-semibold fs-7 mb-2">@SR["Currency"]</label>
                                        <select name="defaultCurrencyId" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["— branch —"]</option>@foreach (var c in currencies) { <option value="@c.ID" selected="@(setting?.DefaultCurrencyId==c.ID)">@c.Code</option> }</select></div>
                                </div>
                                <div class="d-flex justify-content-end mt-5"><button class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@Localizer["Save settings"]</button></div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div></div>
</div>
@section Scripts {
<script>
var base='@Url.Action("Setup","Pos")';
var coSel=document.getElementById('coSel');
if(coSel){var goc=function(){var v=coSel.value||'';location.href=base+(v?('?companyId='+v):'');};if(window.jQuery){jQuery(coSel).on('change select2:select',goc);}else{coSel.addEventListener('change',goc);}}
var brSel=document.getElementById('brSel');
if(brSel){var go=function(){var v=brSel.value||'';if(v)location.href=base+'?companyId=@fC&branchId='+v;};if(window.jQuery){jQuery(brSel).on('change select2:select',go);}else{brSel.addEventListener('change',go);}}
</script>
}
