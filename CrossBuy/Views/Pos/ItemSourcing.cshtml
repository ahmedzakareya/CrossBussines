@using CrossBuy.Models.Context.Admin
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    Func<string, string, string> T = (ar, en) => isAr ? ar : en;
    var companies = ViewBag.Companies as List<Companies> ?? new();
    int? fC = ViewBag.FilterCompanyId;
    var branches = ViewBag.Branches as List<Branch> ?? new();
    int? fB = ViewBag.FilterBranchId;
    var rows = ViewBag.Rows as List<CrossBuy.BL.BranchSourcingRowDto> ?? new();
    var semiItems = ViewBag.SemiItems as System.Collections.IEnumerable;
    var allBranches = ViewBag.AllBranches as System.Collections.IEnumerable;
    var methods = new (string v, string label)[] {
        ("WorkOrder", T("أمر تصنيع كامل", "Full work order")),
        ("FinishedFromBranch", T("جاهز من فرع آخر", "Finished from another branch")),
        ("SemiFromBranchComplete", T("نصف-مصنّع من فرع + إكمال", "Semi from branch + finish")),
        ("RecipeAtSale", T("وصفة عند البيع", "Recipe at sale")),
    };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading fw-bold fs-3 m-0">@T("مصادر توفير الأصناف", "Item sourcing")</h1>
            <span class="text-muted fs-7">@T("لكل صنف في الفرع: كيف يوفّره الفرع (تصنيع / تحويل / وصفة عند البيع). إعداد فقط — لا أثر محاسبي.", "How each branch sources each item (manufacture / transfer / recipe at sale). Setup only, no accounting effect.")</span></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["PosMsg"] != null) { <div class="alert alert-success">@TempData["PosMsg"]</div> }
        @if (TempData["PosErr"] != null) { <div class="alert alert-danger">@TempData["PosErr"]</div> }

        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-6"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Company"]</label>
                <select id="coSel" class="form-select form-select-solid" data-control="select2"><option value="">@T("اختر الشركة", "Select company")</option>@foreach (var c in companies) { <option value="@c.CompanyID" selected="@(fC==c.CompanyID)">@(isAr ? (c.ComoanyNameAr ?? c.CompanyName) : c.CompanyName)</option> }</select></div>
            <div class="col-md-6"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Branch"]</label>
                <select id="brSel" class="form-select form-select-solid" data-control="select2" @(fC == null ? "disabled" : "")><option value="">@T("اختر الفرع", "Select branch")</option>@foreach (var b in branches) { <option value="@b.ID" selected="@(fB==b.ID)">@(isAr ? (b.NameAr ?? b.Name) : b.Name)</option> }</select></div>
        </div></div></div>

        @if (fB == null)
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-abstract-26 fs-3x mb-3 d-block"></i>@T("اختر فرعًا لإدارة مصادر توفير أصنافه.", "Select a branch to manage item sourcing.")</div></div>
        }
        else if (!rows.Any())
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-basket fs-3x mb-3 d-block"></i>@T("لا أصناف سريعة لهذا الفرع بعد — أضِفها من «الأصناف السريعة».", "This branch has no quick-menu items yet — add them in Quick items.")</div></div>
        }
        else
        {
            <div class="card"><div class="card-header"><div class="card-title"><h3>@T("أصناف الفرع", "Branch items") <span class="text-muted fs-7 ms-2">(@rows.Count)</span></h3></div></div>
            <div class="card-body">
                <table class="table table-row-dashed align-middle fs-7">
                    <thead><tr class="text-gray-500 fw-bold text-uppercase fs-8" style="border-bottom:2px solid #0E4A9E;">
                        <th>@T("الصنف", "Item")</th><th style="min-width:190px">@T("طريقة التوفير", "Sourcing method")</th>
                        <th style="min-width:170px">@T("الفرع المصدر", "Source branch")</th><th style="min-width:190px">@T("نصف-المصنّع", "Semi-finished")</th>
                        <th style="min-width:130px">@T("توقيت التحويل", "Transfer timing")</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td class="fw-bold text-gray-800">@r.ItemName<div class="text-muted fs-8">@r.ItemCode @(r.HasBom ? "" : "· " + T("بلا BOM", "no BOM"))</div></td>
                            <td colspan="5">
                                <form asp-action="SaveItemSourcing" method="post" class="row g-2 align-items-center bis-row">@Html.AntiForgeryToken()
                                    <input type="hidden" name="branchId" value="@fB" /><input type="hidden" name="itemId" value="@r.ItemId" />
                                    <div class="col-md-3"><select name="method" class="form-select form-select-sm form-select-solid bis-method">
                                        @foreach (var m in methods) { <option value="@m.v" selected="@(r.Method==m.v)">@m.label</option> }
                                    </select></div>
                                    <div class="col-md-3 bis-src d-none"><select name="sourceBranchId" class="form-select form-select-sm form-select-solid"><option value="">@T("— الفرع المصدر —", "— source branch —")</option>
                                        @if (allBranches != null) { foreach (dynamic b in allBranches) { if ((int)b.ID != (int)fB) { <option value="@b.ID" selected="@(r.SourceBranchId==(int)b.ID)">@b.Name</option> } } }
                                    </select></div>
                                    <div class="col-md-3 bis-semi d-none"><select name="semiFinishedItemId" class="form-select form-select-sm form-select-solid" data-control="select2"><option value="">@T("— نصف-المصنّع —", "— semi-finished —")</option>
                                        @if (semiItems != null) { foreach (dynamic it in semiItems) { <option value="@it.ID" selected="@(r.SemiFinishedItemId==(int)it.ID)">@it.ItemCode — @it.Name</option> } }
                                    </select></div>
                                    <div class="col-md-2 bis-timing d-none"><select name="transferTiming" class="form-select form-select-sm form-select-solid">
                                        <option value="Prepaid" selected="@(r.TransferTiming!="AtSale")">@T("مُقدَّم", "Prepaid")</option>
                                        <option value="AtSale" selected="@(r.TransferTiming=="AtSale")">@T("لحظة البيع", "At sale")</option>
                                    </select></div>
                                    <div class="col-md-1"><button class="btn btn-sm btn-primary w-100" title="@SR["Save"]"><i class="ki-outline ki-check fs-3"></i></button></div>
                                </form>
                            </td>
                        </tr>
                        @if (r.Method == "FinishedFromBranch" || r.Method == "SemiFromBranchComplete")
                        {
                            <tr class="bg-light-primary"><td></td><td colspan="5">
                                <form asp-action="@(r.Method == "FinishedFromBranch" ? "PrepareFinished" : "PrepareSemi")" method="post" class="row g-2 align-items-center" data-cb-confirm data-cb-action="generic" data-cb-text="@T("تجهيز هذه الكمية من الفرع المصدر؟", "Prepare this qty from the source branch?")">
                                    @Html.AntiForgeryToken()<input type="hidden" name="branchId" value="@fB" /><input type="hidden" name="itemId" value="@r.ItemId" />
                                    <div class="col-auto text-primary fw-semibold fs-8"><i class="ki-outline ki-two-way-arrows fs-5 me-1"></i>@T("تجهيز مسبق", "Prepare (Prepaid)")</div>
                                    <div class="col-md-2"><input name="qty" type="number" step="0.01" min="0" value="0" class="form-control form-control-sm form-control-solid" placeholder="@T("الكمية", "Qty")" required /></div>
                                    @if (r.Method == "SemiFromBranchComplete")
                                    {
                                        <div class="col-md-2"><input name="labor" type="number" step="0.01" min="0" value="0" class="form-control form-control-sm form-control-solid" placeholder="@T("عمالة الإكمال", "Finish labor")" /></div>
                                        <div class="col-md-2"><input name="overhead" type="number" step="0.01" min="0" value="0" class="form-control form-control-sm form-control-solid" placeholder="@T("أوفرهيد", "Overhead")" /></div>
                                    }
                                    <div class="col-auto"><button class="btn btn-sm btn-light-primary">@(r.Method == "FinishedFromBranch" ? T("تحويل من المصدر", "Transfer in") : T("تحويل + إكمال", "Transfer + finish"))</button></div>
                                </form>
                            </td></tr>
                        }
                    }
                    </tbody>
                </table>
                <div class="text-muted fs-8 mt-2"><i class="ki-outline ki-information-5 fs-6 me-1"></i>@T("سلوك البيع (خصم المخزون) يقرأ هذا الجدول في المرحلة التالية (BIS-2).", "Sale-time stock deduction will read this table in the next phase (BIS-2).")</div>
            </div></div>
        }
    </div></div>
</div>
@section Scripts {
<script>
var base='@Url.Action("ItemSourcing","Pos")';
var coSel=document.getElementById('coSel');
if(coSel){var goc=function(){var v=coSel.value||'';location.href=base+(v?('?companyId='+v):'');};if(window.jQuery){jQuery(coSel).on('change select2:select',goc);}else{coSel.addEventListener('change',goc);}}
var brSel=document.getElementById('brSel');
if(brSel){var go=function(){var v=brSel.value||'';if(v)location.href=base+'?companyId=@fC&branchId='+v;};if(window.jQuery){jQuery(brSel).on('change select2:select',go);}else{brSel.addEventListener('change',go);}}
// show helper fields per method: source+timing for 2/3, semi for 3
function bisToggle(row){
    var m=row.querySelector('.bis-method').value;
    var need23=(m==='FinishedFromBranch'||m==='SemiFromBranchComplete');
    var need3=(m==='SemiFromBranchComplete');
    row.querySelector('.bis-src').classList.toggle('d-none',!need23);
    row.querySelector('.bis-timing').classList.toggle('d-none',!need23);
    row.querySelector('.bis-semi').classList.toggle('d-none',!need3);
}
document.querySelectorAll('.bis-row').forEach(function(row){
    bisToggle(row);
    var sel=row.querySelector('.bis-method');
    if(window.jQuery){jQuery(sel).on('change',function(){bisToggle(row);});}else{sel.addEventListener('change',function(){bisToggle(row);});}
});
</script>
}
