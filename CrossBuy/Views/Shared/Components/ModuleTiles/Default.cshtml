@model bool

@*
    THE EIGHT MODULE TILES, drawn as the design draws them.

    WHY THESE ARE SVG AND NOT THE SUPPLIED PNGs. The files in the brand folder are rendered 3-D icons
    in blue and yellow only; the design uses FLAT icons in eight different colours — a blue bar chart,
    a green cube, purple people, an orange cart, a blue factory, a cyan folder, pink people and a
    yellow chart. Those are two different icon sets, and dropping the 3-D ones into this layout is
    what made the tile row look like a different product.

    These are geometry — bars, a cube, a folder, circles — not artwork, which is why they can be drawn
    here faithfully. If the flat set ever arrives as files, each <svg> below becomes one <img>.
*@

<div class="cb-tiles">

    @* ACCOUNTING — three bars rising, the tallest in brand blue *@
    <div class="cb-tile">
        <span class="cb-tile-art">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <rect x="5"  y="22" width="8" height="13" rx="2" fill="#7DB3F5"/>
                <rect x="16" y="14" width="8" height="21" rx="2" fill="#3B8DF0"/>
                <rect x="27" y="6"  width="8" height="29" rx="2" fill="#1667D6"/>
            </svg>
        </span>
        <span>@CrossBuy.Resources.SharedResources.Accounting</span>
    </div>

    @* INVENTORY — a cube seen from above, green *@
    <div class="cb-tile">
        <span class="cb-tile-art">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <path d="M20 4 36 12v16L20 36 4 28V12L20 4z" fill="#2BC48A"/>
                <path d="M20 4 36 12 20 20 4 12 20 4z" fill="#57D6A4"/>
                <path d="M20 20v16L4 28V12l16 8z" fill="#1FA874"/>
            </svg>
        </span>
        <span>@CrossBuy.Resources.SharedResources.Inventory</span>
    </div>

    @* CRM — two people, purple *@
    <div class="cb-tile">
        <span class="cb-tile-art">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <circle cx="26" cy="13" r="6" fill="#A78BFA"/>
                <path d="M15 33c0-5.5 4.9-9 11-9s11 3.5 11 9v2H15v-2z" fill="#A78BFA"/>
                <circle cx="13" cy="12" r="7" fill="#7C5CFC"/>
                <path d="M2 34c0-6.1 4.9-10 11-10s11 3.9 11 10v2H2v-2z" fill="#7C5CFC"/>
            </svg>
        </span>
        <span>@CrossBuy.Resources.SharedResources.CRM</span>
    </div>

    @* POS — a shopping trolley, orange *@
    <div class="cb-tile">
        <span class="cb-tile-art">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <path d="M3 6h4.6a2 2 0 0 1 1.95 1.56L10.2 11H35a1.6 1.6 0 0 1 1.56 1.98l-2.6 10.4A3 3 0 0 1 31.05 26H14.1a3 3 0 0 1-2.93-2.35L7.2 8.4A.6.6 0 0 0 6.6 8H3a1 1 0 1 1 0-2z" fill="#F5A623"/>
                <circle cx="15" cy="32" r="3.2" fill="#E08900"/>
                <circle cx="30" cy="32" r="3.2" fill="#E08900"/>
            </svg>
        </span>
        <span>@CrossBuy.Resources.SharedResources.POSShort</span>
    </div>

    @* MANUFACTURING — a factory with its chimney, blue *@
    <div class="cb-tile">
        <span class="cb-tile-art">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <rect x="27" y="4" width="6" height="12" rx="1.5" fill="#1667D6"/>
                <path d="M4 34V18l10 6V18l10 6V14h12v20H4z" fill="#3B8DF0"/>
                <rect x="9"  y="26" width="5" height="5" rx="1" fill="#CFE3FB"/>
                <rect x="18" y="26" width="5" height="5" rx="1" fill="#CFE3FB"/>
                <rect x="27" y="26" width="5" height="5" rx="1" fill="#CFE3FB"/>
            </svg>
        </span>
        <span>@CrossBuy.Resources.SharedResources.Manufacturing</span>
    </div>

    @* PROJECTS — a folder, cyan *@
    <div class="cb-tile">
        <span class="cb-tile-art">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <path d="M4 10a3 3 0 0 1 3-3h8.2a3 3 0 0 1 2.4 1.2L19.6 11H33a3 3 0 0 1 3 3v3H4v-7z" fill="#22B8CF"/>
                <rect x="4" y="14" width="32" height="20" rx="3" fill="#3FD0E3"/>
                <rect x="11" y="20" width="18" height="3" rx="1.5" fill="#E6FBFE"/>
            </svg>
        </span>
        <span>@CrossBuy.Resources.SharedResources.Projects</span>
    </div>

    @* HR — three people, pink *@
    <div class="cb-tile">
        <span class="cb-tile-art">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <circle cx="8"  cy="15" r="5" fill="#FAA5C0"/>
                <path d="M0 32c0-4.6 3.6-7.5 8-7.5s8 2.9 8 7.5v2H0v-2z" fill="#FAA5C0"/>
                <circle cx="32" cy="15" r="5" fill="#FAA5C0"/>
                <path d="M24 32c0-4.6 3.6-7.5 8-7.5s8 2.9 8 7.5v2H24v-2z" fill="#FAA5C0"/>
                <circle cx="20" cy="12" r="6.5" fill="#F06595"/>
                <path d="M9 33c0-6 4.9-9.8 11-9.8S31 27 31 33v2H9v-2z" fill="#F06595"/>
            </svg>
        </span>
        <span>@CrossBuy.Resources.SharedResources.HR</span>
    </div>

    @* REPORTS — bars with a rising line, yellow and blue *@
    <div class="cb-tile">
        <span class="cb-tile-art">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <rect x="4"  y="20" width="7" height="15" rx="2" fill="#9CC7F7"/>
                <rect x="14" y="12" width="7" height="23" rx="2" fill="#1667D6"/>
                <rect x="24" y="17" width="7" height="18" rx="2" fill="#9CC7F7"/>
                <path d="M6 16 15 9l7 5 12-9" stroke="#F5A623" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M28 5h7v7" stroke="#F5A623" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
        <span>@CrossBuy.Resources.SharedResources.Reports</span>
    </div>
</div>
