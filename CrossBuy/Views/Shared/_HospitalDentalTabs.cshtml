@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDentalTabsModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    The dental record's four tabs — odontogram, periodontal chart, treatment history, X-rays & photos — ONE markup
    for the dentist's chart (Hospital/Dental/Chart: Staff, Edit with `consult`) and the patient's dental report on the
    portal (H30). The drawing is hospital-dental.js's, the data HospitalDentalChartData's, the words
    _HospitalDentalText's, the styles hospital-dental-chart.css: the patient sees exactly what the dentist sees.
*@
@{
    var m = Model.Chart;
    var stats = m.Perio?.Stats;
    var lastPerio = m.Perio;
}
@* the chart's data: inside the content, so an in-place swap brings the new state with it *@
<script type="application/json" id="dn_data">@Json.Serialize(new
{
    teeth = HospitalDentalChartData.Teeth(m),
    marks = m.Marks.Select(x => new { id = x.Id, tooth = x.Tooth, surfaces = x.Surfaces, work = x.Work, status = HospitalDentalChartData.MarkKey(x.Status), fromPlan = x.FromPlan, note = x.Note }),
    perio = HospitalDentalChartData.Perio(m),
    dentition = m.Dentition,
    mob = m.Perio?.Teeth.Where(t => t.Mobility != null).ToDictionary(t => t.Tooth.ToString(), t => t.Mobility) ?? new Dictionary<string, int?>(),
    furc = m.Perio?.Teeth.Where(t => t.Furcation != null).ToDictionary(t => t.Tooth.ToString(), t => t.Furcation) ?? new Dictionary<string, int?>(),
})</script>
<ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-0 fs-6 fw-semibold mb-5">
    <li class="nav-item"><a class="nav-link text-active-primary active" data-bs-toggle="tab" href="#dch_o">@T["Odontogram"]</a></li>
    <li class="nav-item"><a class="nav-link text-active-primary" data-bs-toggle="tab" href="#dch_p">@T["Periodontal chart"]</a></li>
    <li class="nav-item"><a class="nav-link text-active-primary" data-bs-toggle="tab" href="#dch_h">@T["Treatment history"]</a></li>
    <li class="nav-item"><a class="nav-link text-active-primary" data-bs-toggle="tab" href="#dch_i">@T["X-rays & photos"]</a></li>
</ul>
<div class="tab-content">
    <div class="tab-pane fade show active" id="dch_o"><div class="row g-5">
        <div class="col-xl-9"><div class="card mb-5">
            <div class="card-header border-0 pt-6">
                <div class="card-title align-items-start flex-column m-0">
                    <span class="card-label fw-bold text-gray-900 fs-4">@T["Anatomical odontogram — FDI numbering (ISO 3950)"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@T["A side view with crown and roots over the five-surface view; from the dentist's side"]</span>
                </div>
                @if (Model.Staff)
                {
                    <div class="card-toolbar" style="width:190px">
                        <select id="dn_dent" class="form-select form-select-sm form-select-solid" data-control="select2" data-hide-search="true">
                            <option value="Permanent" selected="@(m.Dentition == HospitalDentition.Permanent)">@T["Permanent (11–48)"]</option>
                            <option value="Mixed" selected="@(m.Dentition == HospitalDentition.Mixed)">@T["Mixed"]</option>
                            <option value="Primary" selected="@(m.Dentition == HospitalDentition.Primary)">@T["Primary (51–85)"]</option>
                        </select>
                    </div>
                }
            </div>
            <div class="card-body pt-2">
                <div id="dn_chart_box"></div>
                <partial name="_HospitalDentalLegend" />
            </div>
        </div></div>
        <div class="col-xl-3"><div class="card mb-5">
            <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Selected tooth"]</span></div></div>
            <div class="card-body pt-2"><div id="dn_tooth_panel" class="text-muted fs-7">@T["Click a tooth to see its state, surfaces and what is planned"]</div></div>
        </div></div>
    </div></div>

    <div class="tab-pane fade" id="dch_p">
        <div class="row g-5 g-xl-8 mb-5">
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Bleeding on probing"]</div>
                <div class="fs-2hx fw-bold hp-num @(stats != null && stats.Sites > 0 && stats.Bleeding * 100 / stats.Sites > 20 ? "text-danger" : "text-gray-900")">@(stats == null || stats.Sites == 0 ? 0 : (int)Math.Round(stats.Bleeding * 100m / stats.Sites))%</div>
                <div class="text-muted fs-8 mt-1">@T["of"] <span class="hp-num">@(stats?.Sites ?? 0)</span> @T["sites"]</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Pockets 5 mm or more"]</div>
                <div class="fs-2hx fw-bold hp-num @(stats?.Deep > 0 ? "text-danger" : "text-gray-900")">@(stats?.Deep ?? 0)</div>
                <div class="text-muted fs-8 mt-1">@T["need periodontal care"]</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Mobile teeth"]</div>
                <div class="fs-2hx fw-bold hp-num text-gray-900">@(stats?.Mobile ?? 0)</div>
                <div class="text-muted fs-8 mt-1">@T["grade 2 or more needs review"]</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Last perio exam"]</div>
                <div class="fs-2hx fw-bold hp-num text-gray-900">@(lastPerio == null ? "—" : lastPerio.Exam.ExamDate.ToString("yyyy-MM-dd"))</div>
                <div class="text-muted fs-8 mt-1">@(lastPerio?.Examiner == null ? "" : DisplayName.Of(lastPerio.Examiner.Name, lastPerio.Examiner.NameEn))</div></div></div></div>
        </div>
        <div class="card mb-5">
            <div class="card-header border-0 pt-6">
                <div class="card-title align-items-start flex-column m-0">
                    <span class="card-label fw-bold text-gray-900 fs-4">@T["Periodontal chart — upper arch"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@T["Six sites per tooth; attachment loss = pocket depth + recession, calculated"]</span>
                </div>
                @if (Model.Edit) { <div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-perio-open><i class="ki-outline ki-plus fs-4"></i>@T["Record a perio exam"]</button></div> }
            </div>
            <div class="card-body pt-2" id="dn_perio_up"></div>
        </div>
        <div class="card mb-5">
            <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Periodontal chart — lower arch"]</span></div></div>
            <div class="card-body pt-2" id="dn_perio_lo"></div>
        </div>
    </div>

    <div class="tab-pane fade" id="dch_h"><div class="card mb-5"><div class="card-body pt-6">
        @if (m.History.Count == 0) { <div class="text-center text-muted py-10">@T["Nothing recorded yet."]</div> }
        else
        {
            <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0"><th class="w-125px">@T["Date"]</th><th class="w-80px">@T["Tooth"]</th><th>@T["Procedure"]</th><th>@T["Dentist"]</th></tr></thead>
                <tbody class="fw-semibold text-gray-700">
                    @foreach (var h in m.History)
                    {
                        var what = h.What is HospitalToothWork.Crown or HospitalToothWork.RootCanal or HospitalToothWork.Implant or HospitalToothWork.Extraction ? T["work:" + h.What].Value
                            : h.What == "" ? T["Filling"].Value : DisplayName.Of(h.What, h.WhatEn);
                        <tr>
                            <td><span class="hp-num">@h.At.ToLocalTime().ToString("yyyy-MM-dd")</span></td>
                            <td>@if (h.Tooth != null) {<span class="hp-num fw-bold">@h.Tooth</span>} else {<text>—</text>}</td>
                            <td>@what@if (h.Surfaces != null) {<text> </text><span class="hp-num">(@h.Surfaces)</span>}@if (h.Elsewhere) {<text> — </text>@T["another clinic"]}@if (h.Note != null) {<div class="text-muted fs-8">@h.Note</div>}</td>
                            <td>@if (h.By != null)
                                {
                                    <div class="d-flex align-items-center gap-2"><div class="symbol symbol-30px symbol-circle flex-shrink-0">@if (Model.Photo(h.By) is string byPhoto) {<img src="@byPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(h.By.NameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(h.By.NameEn)</span>}</div><span>@DisplayName.Of(h.By.Name, h.By.NameEn)</span></div>
                                } else {<text>—</text>}</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </div></div></div>

    <div class="tab-pane fade" id="dch_i"><div class="card mb-5"><div class="card-body pt-6">
        @{ var orders = m.Images.Where(x => Model.ShowOrder?.Invoke(x) ?? true).ToList(); }
        @if (orders.Count == 0) { <div class="text-center text-muted py-10">@T["No imaging for this patient yet."]</div> }
        @* H180 (staff only): a tooth's radiographs *@
        @if (Model.Staff && orders.Any(o => o.Teeth != null))
        {
            var allTeeth = orders.Where(o => o.Teeth != null).SelectMany(o => o.Teeth!.Split(',')).Distinct().OrderBy(x => int.Parse(x)).ToList();
            <div class="d-flex align-items-center gap-3 mb-6 mw-300px"><label class="fs-7 fw-semibold text-gray-700 text-nowrap">@T["Tooth"]</label>
                <select class="form-select form-select-sm form-select-solid" data-control="select2" data-hide-search="true" data-img-filter><option value="">@T["All teeth"]</option>@foreach (var t in allTeeth) {<option value="@t">@t</option>}</select></div>
        }
        @foreach (var x in orders)
        {
            var pics = Model.Pictures?.GetValueOrDefault(x.Id) ?? Array.Empty<HospitalRadImageRow>();
            var link = Model.ImageLink(x);
            <div class="mb-7" data-img-row="@x.Teeth">
                <div class="d-flex flex-stack mb-3">
                    <div>@if (link != null) {<a href="@link" class="fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(x.Name, x.NameEn)</a>} else {<span class="fw-bold text-gray-900">@DisplayName.Of(x.Name, x.NameEn)</span>}
                        <span class="text-muted fs-8 ms-2"><span class="hp-num">@x.At.ToLocalTime().ToString("yyyy-MM-dd")</span> · <span class="hp-num">@x.AccessionNo</span></span></div>
                    <div class="d-flex align-items-center gap-2">
                        @if (Model.Staff)
                        {
                            if (x.Teeth != null) { foreach (var t in x.Teeth.Split(',')) {<span class="badge badge-light-primary fs-8 fw-bold hp-num">@t</span>} }
                            if (Model.Edit) { <button type="button" class="btn btn-sm btn-icon btn-light-primary w-25px h-25px" title="@T["The teeth it shows"]" data-bs-toggle="tooltip" data-img-teeth="@x.Id" data-teeth="@x.Teeth"><i class="ki-outline ki-tag fs-5"></i></button> }
                        }
                        <span class="badge badge-light fs-8"><span class="hp-num me-1">@pics.Count</span>@T["attached images"]</span>
                    </div>
                </div>
                <div class="row g-4">
                    @if (pics.Count == 0)
                    {
                        <div class="col-md-3"><div class="rounded dn-xray"><i class="ki-outline ki-scan-barcode fs-2x text-white"></i></div><div class="text-muted fs-8 mt-2">@T["No images attached yet"]</div></div>
                    }
                    @foreach (var p in pics)
                    {
                        var src = Model.PictureSrc?.Invoke(p.Id);
                        <div class="col-6 col-md-3"><a href="@(src ?? "#")" target="_blank" rel="noopener" class="d-block text-hover-primary">
                            <div class="rounded dn-xray overflow-hidden">@if (src != null) {<img src="@src" alt="" style="width:100%;height:100%;object-fit:cover" loading="lazy" />}</div>
                            <div class="text-gray-700 fs-8 mt-2 text-truncate">@(p.Caption ?? p.FileName)</div>
                        </a></div>
                    }
                </div>
            </div>
        }
        <div class="mt-4 text-muted fs-8"><i class="ki-outline ki-information-4 fs-7"></i> @(Model.Staff ? T["Images are ordered, taken and reported in Radiology."] : T["Your imaging reports are in Results once your doctor has reviewed them."])</div>
    </div></div></div>
</div>
