@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@using System.Text.Json
@{
    var employeeJson = Context.Session.GetString("Employee");
    var employee = employeeJson != null ? JsonSerializer.Deserialize<EmployeeViewModel>(employeeJson) : null;
}
<!DOCTYPE html>
