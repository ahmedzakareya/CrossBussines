		<!--begin::Accounting list pager (client-side paging + search for flat list tables)-->
		<script>
		(function () {
			var PAGE = 10;
			function key(r) { return (r.getAttribute('data-s') || r.getAttribute('data-search') || r.textContent || '').toLowerCase(); }
			function setup(table) {
				var tbody = table.tBodies[0]; if (!tbody) return;
				var rows = [].slice.call(tbody.querySelectorAll('tr[data-s],tr[data-search]'));
				if (rows.length === 0) return;
				var resp = table.closest('.table-responsive') || table;
				var filtered = rows.slice(), page = 1;
				var bar = document.createElement('div'); bar.className = 'd-flex flex-stack flex-wrap pt-5';
				var info = document.createElement('div'); info.className = 'text-muted fs-7';
				var ulw = document.createElement('div'); var ul = document.createElement('ul'); ul.className = 'pagination'; ulw.appendChild(ul);
				bar.appendChild(info); bar.appendChild(ulw);
				resp.parentNode.insertBefore(bar, resp.nextSibling);
				function btn(label, p, dis, act) {
					var li = document.createElement('li'); li.className = 'page-item' + (dis ? ' disabled' : '') + (act ? ' active' : '');
					var a = document.createElement('a'); a.className = 'page-link'; a.href = '#'; a.innerHTML = label;
					a.onclick = function (e) { e.preventDefault(); if (!dis && !act) { page = p; render(); } };
					li.appendChild(a); ul.appendChild(li);
				}
				function gap() { var li = document.createElement('li'); li.className = 'page-item disabled'; li.innerHTML = '<span class="page-link">…</span>'; ul.appendChild(li); }
				function render() {
					var total = filtered.length, pages = Math.max(1, Math.ceil(total / PAGE));
					if (page > pages) page = pages; if (page < 1) page = 1;
					rows.forEach(function (r) { r.style.display = 'none'; });
					var start = (page - 1) * PAGE;
					filtered.slice(start, start + PAGE).forEach(function (r) { r.style.display = ''; });
					info.textContent = total ? (start + 1) + ' – ' + Math.min(start + PAGE, total) + ' / ' + total : '0';
					ul.innerHTML = '';
					btn('‹', page - 1, page <= 1, false);
					var from = Math.max(1, page - 2), to = Math.min(pages, page + 2);
					if (from > 1) btn('1', 1, false, false);
					if (from > 2) gap();
					for (var i = from; i <= to; i++) btn('' + i, i, false, i === page);
					if (to < pages - 1) gap();
					if (to < pages) btn('' + pages, pages, false, false);
					btn('›', page + 1, page >= pages, false);
					bar.style.display = pages > 1 ? 'flex' : 'none';
				}
				var card = table.closest('.card'); var input = card && card.querySelector('.card-header input[type="text"]');
				if (input) input.addEventListener('input', function () { var q = (input.value || '').trim().toLowerCase(); filtered = q ? rows.filter(function (r) { return key(r).indexOf(q) !== -1; }) : rows.slice(); page = 1; render(); });
				render();
			}
			document.addEventListener('DOMContentLoaded', function () {
				document.querySelectorAll('#kt_app_content table').forEach(function (t) {
					if (t.querySelector('tr[data-parent]')) return;   // skip hierarchical/tree tables
					setup(t);
				});
			});
		})();
		</script>
		<!--end::Accounting list pager-->
			<!--begin::Accounting Select2 enhancer (Metronic styled dropdowns)-->
			<script>
			(function () {
				if (!window.jQuery || !jQuery.fn || !jQuery.fn.select2) return;
				var $ = jQuery;
				var rtl = (document.documentElement.getAttribute('dir') || '').toLowerCase() === 'rtl';
				function enhance(scope) {
					$(scope).find('select.form-select').each(function () {
						var el = this;
						if (el.hasAttribute('data-no-select2')) return;
						if ($(el).hasClass('select2-hidden-accessible')) return;
						if (!$(el).closest('#kt_app_content, .modal').length) return;
						var $el = $(el);
						var $modal = $el.closest('.modal');
						var optCount = el.querySelectorAll('option').length;
						var ph = '';
						var first = el.querySelector('option[value=""]');
						if (first) ph = (first.textContent || '').trim();
						$el.select2({
							width: '100%',
							dir: rtl ? 'rtl' : 'ltr',
							placeholder: ph || null,
							allowClear: false,
							minimumResultsForSearch: optCount > 7 ? 0 : Infinity,
							dropdownParent: $modal.length ? $modal : $(document.body)
						});
						// relay select2's jQuery change to native addEventListener('change') listeners (guarded)
						$el.on('change.relay', function () {
							if (el.__relaying) return;
							el.__relaying = true;
							el.dispatchEvent(new Event('change', { bubbles: true }));
							el.__relaying = false;
						});
					});
				}
				document.addEventListener('DOMContentLoaded', function () { enhance(document); });
				document.addEventListener('shown.bs.modal', function (e) { enhance(e.target); });
			})();
			</script>
			<!--end::Accounting Select2 enhancer-->

			<!--begin::Accounting flatpickr enhancer (Metronic styled date pickers)-->
			<script>
			(function () {
				if (!window.flatpickr) return;
				function enhance(scope) {
					(scope || document).querySelectorAll('#kt_app_content input[type="date"], #kt_app_toolbar input[type="date"], .modal input[type="date"]').forEach(function (el) {
						if (el._flatpickr) return;                       // already initialized
						if (el.hasAttribute('data-no-flatpickr')) return;
						var inModal = !!el.closest('.modal');
						var current = el.getAttribute('value') || el.value || null;
						el.setAttribute('type', 'text');                 // hand control to flatpickr
						el.classList.add('form-control-solid');
						flatpickr(el, {
							dateFormat: 'Y-m-d',                          // keep the value the controllers parse
							defaultDate: current,
							allowInput: true,
							static: inModal,                             // render within the modal (no clipping)
							disableMobile: true,                          // consistent UI on all devices
							locale: { firstDayOfWeek: 6 }                 // week starts Saturday
						});
					});
				}
				document.addEventListener('DOMContentLoaded', function () { enhance(document); });
				document.addEventListener('shown.bs.modal', function (e) { enhance(e.target); });
			})();
			</script>
			<!--end::Accounting flatpickr enhancer-->
		<!--end::Javascript-->
	</body>
	<!--end::Body-->
</html>

