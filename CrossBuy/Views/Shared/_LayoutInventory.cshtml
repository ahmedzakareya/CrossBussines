		<!-- RTL Plugin Styles -->
		<link href="~/Backend-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
		<link href="~/Backend-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="~/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />

		<!-- Cairo Font -->
		<link href="https://fonts.googleapis.com/css2?family=Cairo&display=swap" rel="stylesheet">

		<!-- jQuery (usually best to place in Scripts section, but here is acceptable if needed early) -->
		<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

