		<title>@Localizer["PageTitle"]</title>
		<meta charset="utf-8" />
		@* Class C removal. This block shipped Metronic's own storefront metadata: a Themeforest sales
		   description, the vendor's SEO keyword list, og:title / og:url / og:site_name naming this page
		   "Metronic - The World's #1 Selling Bootstrap Admin Template by KeenThemes", and a
		   rel=canonical pointing at preview.keenthemes.com/metronic8. The canonical tag is the damaging
		   one — it declares this application a duplicate of the vendor's public demo. og:url and
		   canonical are dropped outright rather than repointed, because CrossBuy has no public URL to
		   name here and inventing one is out of scope.
		   The theme attribution comment near the top of this file is deliberately KEPT: it records
		   provenance and the Metronic licence terms, and it is a source comment, not rendered output. *@
		<meta name="description" content="CrossBuy business platform." />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="shortcut icon" href="~/Backend-assets/media/logos/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/Backend-assets/media/logos/crossbuy-favicon.svg" asp-append-version="true" />
		<!--begin::Fonts(mandatory for all pages)-->
		<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
		<!--end::Fonts-->
	<!-- ✅ FullCalendar -->
	<link href="~/Backend-assets/plugins/custom/fullcalendar/fullcalendar.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />

	<!-- ✅ DataTables -->
	<link href="~/Backend-assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />

	<!-- ✅ jsTree -->
	<link href="~/Backend-assets/plugins/custom/jstree/jstree.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />


	<!-- ✅ Dropzone (only Arabic needs this, but can be loaded globally if used in both) -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/min/dropzone.min.css">

	<!-- ✅ Culture check -->
	@if ((System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"))
