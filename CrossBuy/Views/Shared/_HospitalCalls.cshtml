@using System.Security.Claims
@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using Microsoft.EntityFrameworkCore
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> HT
@inject CrossBuy.Models.Context.CrossDbContext CallDb
@*
    H176 — internal calls on EVERY screen of the system (rendered by _LabCriticalAlerts, which every layout renders): a
    call rings wherever the person is working, like a critical value does. Only an employee connects; a portal patient
    renders nothing. Design: the approved prototype (#/calls) — the ringing card, the dark stage, the context panel.
*@
@{
    var uid = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var me = string.IsNullOrEmpty(uid) ? null : await CallDb.Employee.AsNoTracking().Where(e => e.UserId == uid && e.IsActive)
        .Select(e => new { e.ID, e.FullName, e.FullNameEn, e.EmpCompanyID }).FirstOrDefaultAsync();
    string? mePhoto = null;
    if (me != null)
    {
        var photos = await CrossBuy.BL.Platform.EmployeePhotos.ResolveAsync(CallDb, new CrossBuy.Models.Platform.BusinessContext { CompanyId = me.EmpCompanyID }, new[] { me.ID });
        mePhoto = photos.GetValueOrDefault(me.ID);
    }
    string S(string k) => HT[k].Value;
}
@if (me != null)
{
<style>
    .cbc-num{font-variant-numeric:tabular-nums;unicode-bidi:isolate}
    .cbc-face{position:relative;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;overflow:hidden;flex-shrink:0;background:#E7F0FF;color:#1F2D4D;font-weight:700}
    .cbc-face img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .cbc-overlay{position:fixed;inset:0;z-index:2050;background:rgba(15,23,42,.62);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:16px}
    .cbc-card{background:#fff;border-radius:1.25rem;max-width:420px;width:100%;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.35);text-align:center}
    .cbc-band{background:linear-gradient(160deg,var(--cb-brand,#3A5795),var(--cb-brand-ink,#1F2D4D));color:#fff;padding:34px 24px 26px}
    .cbc-kind{font-size:.85rem;font-weight:600;opacity:.75;margin-bottom:1.5rem;display:flex;align-items:center;justify-content:center;gap:.5rem}
    .cbc-ring{position:relative;display:inline-block;border-radius:50%}
    .cbc-ring:before,.cbc-ring:after{content:"";position:absolute;inset:-8px;border-radius:50%;border:2px solid rgba(255,255,255,.55);animation:cbcRing 1.8s ease-out infinite}
    .cbc-ring:after{animation-delay:.9s}
    .cbc-ring .cbc-face{border:3px solid #fff}
    @@keyframes cbcRing{0%{transform:scale(.92);opacity:1}100%{transform:scale(1.35);opacity:0}}
    .cbc-about{display:flex;align-items:center;gap:.75rem;border-radius:.75rem;padding:1rem;margin-bottom:1.5rem;text-align:start;background:#E7F0FF}
    .cbc-round{width:58px;height:58px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;border:0;color:#fff;transition:transform .12s}
    .cbc-round:hover{transform:scale(1.07)}.cbc-round.accept{background:var(--cb-brand,#3A5795)}.cbc-round.decline{background:#DC2626}.cbc-round.ghost{background:#F1F3F8;color:#1F2D4D}
    .cbc-stage{position:fixed;inset:0;z-index:2040;background:#0F172A;display:flex;color:#fff}
    .cbc-main{flex:1;position:relative;display:flex;flex-direction:column;min-width:0}
    .cbc-top{display:flex;align-items:center;gap:12px;padding:16px 22px;background:linear-gradient(180deg,rgba(0,0,0,.45),transparent);position:absolute;inset-inline:0;top:0;z-index:2}
    .cbc-remote{flex:1;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 40%,#2A3B63 0%,#0F172A 70%);overflow:hidden;position:relative}
    .cbc-remote video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#0F172A}
    .cbc-remote video.cbc-contain{object-fit:contain}
    .cbc-self{position:absolute;bottom:104px;inset-inline-end:22px;width:220px;aspect-ratio:4/3;border-radius:.9rem;overflow:hidden;background:#1F2D4D;border:2px solid rgba(255,255,255,.25);box-shadow:0 10px 30px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;z-index:2}
    .cbc-self video{width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
    .cbc-self .tag{position:absolute;bottom:6px;inset-inline-start:8px;font-size:.75rem;background:rgba(0,0,0,.45);padding:1px 8px;border-radius:20px}
    .cbc-bar{position:absolute;bottom:22px;inset-inline:0;display:flex;justify-content:center;gap:12px;z-index:2}
    .cbc-ctl{width:54px;height:54px;border-radius:50%;border:0;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.14);color:#fff;transition:background .15s}
    .cbc-ctl:hover{background:rgba(255,255,255,.24)}.cbc-ctl:disabled{opacity:.45}.cbc-ctl.off{background:#fff;color:#1F2D4D}.cbc-ctl.end{background:#DC2626;width:70px;border-radius:28px}
    .cbc-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.14);padding:4px 12px;border-radius:20px;font-size:.8rem;color:#fff;white-space:nowrap}
    .cbc-bars{display:flex;gap:2px;align-items:flex-end;height:14px}.cbc-bars i{width:3px;background:#fff;border-radius:2px;display:block}
    .cbc-side{width:340px;background:var(--bs-body-bg,#fff);color:var(--bs-gray-900);overflow-y:auto;flex-shrink:0}
    .cbc-hit:hover{background:#F5F8FF}
    /* recording: red is the recording signal (being recorded is something you must always know) */
    .cbc-chip.cbc-rec{background:#DC2626;font-weight:700}
    .cbc-recdot{width:9px;height:9px;border-radius:50%;background:#fff;display:inline-block;animation:cbcBlink 1.1s ease-in-out infinite}
    @@keyframes cbcBlink{0%,100%{opacity:1}50%{opacity:.25}}
    .cbc-ctl.rec-on{background:#DC2626}
    .cbc-band-rec{background:linear-gradient(160deg,#B91C1C,#7F1D1D);padding:26px 24px 22px}
    .cbc-step{width:32px;height:32px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;background:#E7F0FF;color:var(--cb-brand,#3A5795)}
    .cbc-step i{color:inherit}.cbc-step.red{background:#FEE2E2;color:#DC2626}
    /* group calls: the grid of tiles; the one speaking is framed in the brand's light tone */
    .cbc-grid{flex:1;display:grid;gap:10px;padding:78px 18px 100px;grid-template-columns:repeat(var(--cols,2),1fr);grid-auto-rows:1fr;min-height:0}
    .cbc-tile{position:relative;border-radius:.9rem;overflow:hidden;background:#1F2D4D;display:flex;align-items:center;justify-content:center;min-height:0;transition:box-shadow .2s}
    .cbc-tile video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#0F172A}
    .cbc-tile video.cbc-contain{object-fit:contain}.cbc-tile video.cbc-mirror{transform:scaleX(-1)}
    .cbc-tile.speaking{box-shadow:0 0 0 3px #7FA2E8}.cbc-tile.ringing{opacity:.75}
    .cbc-tname{position:absolute;bottom:8px;inset-inline-start:10px;display:flex;align-items:center;gap:6px;background:rgba(0,0,0,.5);color:#fff;padding:2px 10px;border-radius:20px;font-size:.8rem;z-index:1}
    .cbc-tstate{position:absolute;top:8px;inset-inline-end:10px;font-size:.72rem;padding:2px 9px;border-radius:20px;background:rgba(0,0,0,.45);color:#fff;z-index:1}
    .cbc-tmute{color:#FCA5A5;display:inline-flex}
    .cbc-stack{display:inline-flex}.cbc-stack .cbc-face{border:2px solid #fff}.cbc-stack .cbc-face + .cbc-face{margin-inline-start:-10px}
    .cbc-recnote{display:flex;align-items:center;gap:.75rem;border-radius:.75rem;padding:1rem;margin-bottom:1.5rem;background:#FEF2F2}
    @@media (max-width:991px){.cbc-side{display:none}.cbc-self{width:130px;bottom:96px}}
</style>
