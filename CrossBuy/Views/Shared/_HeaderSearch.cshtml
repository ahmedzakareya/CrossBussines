@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@*
    THE HEADER BOX — ONE DEFINITION, EVERY SHELL.

    This box does two jobs through one field: it finds records as you type (global-search.js calls
    /Search/Suggest), and it hands a question to the assistant (window.cbAi.ask) without the person
    having to decide first which of the two they wanted. The placeholder says both, because a box
    labelled only "Search" is a box nobody asks a question in.

    It replaces the stock Metronic block that used to sit inline in five layouts. That block carried
    roughly six hundred lines of demo content each — "Karina Clark" and friends — which
    global-search.js deleted at runtime on every page load anyway. The markup kept here is only what
    the wiring actually uses: the root (#kt_header_search), the mobile toggle, the form, and the
    input (.search-input). The content element stays, empty, because KTSearch looks for it on init;
    global-search.js removes it immediately afterwards, exactly as it did before.

    Do not add a second copy of this markup to a layout. Include the partial.
*@
<!--begin::Search-->
<div id="kt_header_search" class="header-search d-flex align-items-center w-lg-350px"
     data-kt-search-keypress="true" data-kt-search-min-length="2" data-kt-search-enter="enter"
     data-kt-search-layout="menu" data-kt-search-responsive="true"
     data-kt-menu-trigger="auto" data-kt-menu-permanent="true" data-kt-menu-placement="bottom-start">

    <!--begin::Tablet and mobile search toggle-->
    <div data-kt-search-element="toggle" class="search-toggle-mobile d-flex d-lg-none align-items-center">
        <div class="d-flex">
            <i class="ki-outline ki-magnifier fs-1"></i>
        </div>
    </div>
    <!--end::Tablet and mobile search toggle-->

    <!--begin::Form-->
    <form data-kt-search-element="form" class="d-none d-lg-block w-100 position-relative mb-5 mb-lg-0"
          autocomplete="off" role="search">
        @* Disables the browser's own autocomplete over the real field. *@
        <input type="hidden" />

        <i class="ki-outline ki-magnifier search-icon fs-2 text-gray-500 position-absolute top-50 translate-middle-y ms-5"></i>

        <label class="visually-hidden" for="kt_header_search_input">@Localizer["Search or ask the assistant"]</label>
        <input id="kt_header_search_input" type="text" name="search" value=""
               class="search-input form-control form-control border h-lg-45px ps-13"
               placeholder="@Localizer["Search or ask the assistant"]"
               data-kt-search-element="input" autocomplete="off" />

        <span class="search-spinner position-absolute top-50 end-0 translate-middle-y lh-0 d-none me-5" data-kt-search-element="spinner">
            <span class="spinner-border h-15px w-15px align-middle text-gray-500"></span>
        </span>

        <span class="search-reset btn btn-flush btn-active-color-primary position-absolute top-50 end-0 translate-middle-y lh-0 d-none me-4" data-kt-search-element="clear">
            <i class="ki-outline ki-cross fs-2 fs-lg-1 me-0"></i>
        </span>
    </form>
    <!--end::Form-->

    @* Empty on purpose: KTSearch expects a content element at init, and global-search.js removes
       this one right afterwards to put its own themed panel in its place. *@
    <div data-kt-search-element="content" class="menu menu-sub menu-sub-dropdown"></div>
</div>
<!--end::Search-->