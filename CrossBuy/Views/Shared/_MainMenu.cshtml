@using CrossBuy.Models.Menu
@using CrossBuy.BL
@* GetService<T>() — the OPTIONAL resolution below. This partial renders on every page in the product, so it
   asks the container for the Reporting module rather than declaring @inject and taking the whole shell down
   with it if that module is ever absent. *@
@using Microsoft.Extensions.DependencyInjection
@model List<MenuCategory>
@inject IInventoryAccessService InvAccess
@inject IAccountingAccessService AccAccess
@inject ICrmAccessService CrmAccess
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var path = (Context.Request.Path.Value ?? "").TrimEnd('/').ToLowerInvariant();
    // permission hook: items hide for users lacking the role (RBAC is bootstrap-open until the first role is set)
    bool canManage = true, canAccManage = true, canCrmManage = true;
    try { canManage = await InvAccess.CanAsync("manage"); } catch { canManage = true; }
    try { canAccManage = await AccAccess.CanAsync("manage"); } catch { canAccManage = true; }
    try { canCrmManage = await CrmAccess.CanAsync("manage"); } catch { canCrmManage = true; }
    // "platform-ops" must mirror PlatformOpsAttribute EXACTLY, not approximate it: admin role, or the
    // accounting management tier. Hiding a link the user could open is as wrong as showing one they cannot,
    // and a nav predicate that drifts from the filter produces both over time.
    bool canPlatformOps = CrossBuy.Models.PlatformOpsAttribute.IsAdmin(Context) || canAccManage;
    // "report" — a row that opens ONE named report. The Reports Center lists every report in the catalogue,
    // but opening one is a separate, fail-closed decision: a report whose permission key is unmapped is
    // refused with 404 to avoid handing out a catalogue oracle (ReportsController.Viewer). So a menu row for
    // a specific report must ask the SAME question the screen will ask, or it becomes a link that always
    // 404s — Platform.BusinessEventLog is exactly that today, because its key "reporting.businessevents.view"
    // is deliberately unmapped until an owner grants it.
    //
    // Resolved OPTIONALLY: this partial renders on every page in the product, and a hard dependency on the
    // Reporting module would take the whole shell down with it. Same reasoning as TasksController and the
    // Communication Platform.
    var reportsForMenu = Context.RequestServices.GetService<CrossBuy.BL.Reporting.IReportService>();
    async Task<bool> CanOpenReportAsync(MenuItem i)
    {
        var code = i.RouteValues is not null && i.RouteValues.TryGetValue("id", out var c) ? c : null;
        if (string.IsNullOrWhiteSpace(code) || reportsForMenu is null) { return false; }
        // Fail CLOSED, unlike the module hooks above. Those hide a screen the user could still reach another
        // way; this one would show a row whose only possible outcome is a 404.
        try { return await reportsForMenu.DescribeAsync(code) is not null; } catch { return false; }
    }
    var openableReports = new HashSet<MenuItem>();
    foreach (var candidate in MainMenu.Platform().SelectMany(c => c.Items).Where(x => x.Perm == "report"))
    {
        if (await CanOpenReportAsync(candidate)) { openableReports.Add(candidate); }
    }
    bool ReportVisible(MenuItem i) => openableReports.Any(o =>
        o.Controller == i.Controller && o.Action == i.Action
        && o.RouteValues is not null && i.RouteValues is not null
        && o.RouteValues.TryGetValue("id", out var a) && i.RouteValues.TryGetValue("id", out var b) && a == b);

    bool ItemVisible(MenuItem i) => i.Perm switch { "manage" => canManage, "acc-manage" => canAccManage, "crm-manage" => canCrmManage, "platform-ops" => canPlatformOps, "report" => ReportVisible(i), _ => true };

    // The URL a menu row points at. Route values go through Url.Action so the ROUTE decides whether each one
    // lands in the path (Reports/Viewer/{id}) or the query (Reports?favorites=true) - a URL assembled by hand
    // in Razor gets that wrong the first time a route changes, and gets it wrong silently.
    string Href(MenuItem i)
    {
        if (i.RouteValues is null || i.RouteValues.Count == 0)
        {
            return Url.Action(i.Action, i.Controller) ?? "#";
        }
        var values = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
        foreach (var kv in i.RouteValues) { values[kv.Key] = kv.Value; }
        return Url.Action(i.Action, i.Controller, values) ?? "#";
    }

    // Path AND query, because two rows can share an action and differ only by argument
    // (Reports vs Reports?favorites=true). Comparing paths alone would light both at once.
    //
    // "/X" and "/X/Index" are the SAME screen and must compare equal. This is not cosmetic: once a bare
    // module route exists, Url.Action("Index","Tasks") generates the SHORTER "/Tasks", so a user who arrives
    // at "/Tasks/Index" from a breadcrumb or a bookmark would find nothing highlighted at all. Adding those
    // routes silently broke the active state on two modules, and only clicking through caught it.
    string Canonical(string pathOnly)
    {
        var p = pathOnly.TrimEnd('/').ToLowerInvariant();
        return p.EndsWith("/index", StringComparison.Ordinal) ? p[..^"/index".Length] : p;
    }
    string Normalise(string url)
    {
        var q = url.IndexOf('?');
        var p = Canonical(q < 0 ? url : url[..q]);
        return q < 0 ? p : p + url[q..].ToLowerInvariant();
    }
    var currentUrl = Normalise(path + (Context.Request.QueryString.Value ?? ""));
    var currentPath = Canonical(path);

    // Platform surfaces (Workspace, Reporting, Business Event Monitor) span every module, so they are
    // prepended here ONCE rather than copied into each module's menu. Defined in MainMenu.Platform().
    var menu = MainMenu.Platform().Concat(Model ?? new List<MenuCategory>()).ToList();

    // Does some row claim this exact URL, arguments included? If so it OWNS the highlight, and the plainer
    // row it shares an action with must stand down. Without this, opening a specific report would light both
    // "Reports center" and "Business event report", and the sidebar would be telling the user two things.
    var exactClaimExists = menu.SelectMany(c => c.Items)
        .Any(i => !i.Soon && i.RouteValues is { Count: > 0 } && Normalise(Href(i)) == currentUrl);

    bool IsActive(MenuItem i)
    {
        if (i.Soon) { return false; }   // coming-soon placeholders share the dashboard URL — never let them steal the active state

        // A row with arguments matches only its exact URL - never the bare action.
        if (i.RouteValues is { Count: > 0 })
        {
            return Normalise(Href(i)) == currentUrl;
        }

        // Everything else keeps the original rule EXACTLY - path only, aliases included - except that it
        // yields when a more specific row has claimed this URL.
        if (exactClaimExists) { return false; }

        var href = Canonical(Url.Action(i.Action, i.Controller) ?? "");
        if (href.Length > 0 && currentPath == href) { return true; }
        // a hub link also lights up on its drill-down screens (same controller, aliased actions)
        foreach (var a in i.Aliases)
        {
            var ah = Canonical(Url.Action(a, i.Controller) ?? "");
            if (ah.Length > 0 && currentPath == ah) { return true; }
        }
        return false;
    }
}
<!--begin::Menu search-->
<div class="menu-item px-3 mb-2">
    <div class="position-relative"><i class="ki-outline ki-magnifier fs-4 position-absolute ms-3 mt-3 text-muted"></i>
        <input type="text" id="mainMenuSearch" class="form-control form-control-solid form-control-sm ps-10" placeholder="@Localizer["Search menu"]" autocomplete="off" />
    </div>
</div>
<!--end::Menu search-->
@foreach (var cat in menu)
{
    var items = cat.Items.Where(ItemVisible).ToList();
    if (items.Count == 0) { continue; }
    var here = items.Any(IsActive);
    <div class="menu-item menu-accordion cb-cat @(here ? "here show" : "")" data-kt-menu-trigger="click">
        <span class="menu-link">
            <span class="menu-icon"><i class="@cat.Icon fs-2"></i></span>
            <span class="menu-title">@SR[cat.LabelEn]</span>
            <span class="menu-arrow"></span>
        </span>
        <div class="menu-sub menu-sub-accordion">
            @foreach (var it in items)
            {
                <div class="menu-item">
                    <a class="menu-link @(IsActive(it) ? "active" : "")" href="@Href(it)">
                        <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                        <span class="menu-title @(it.Soon ? "text-muted" : "")">@SR[it.LabelEn]</span>
                        @if (it.Soon)
                        {
                            <span class="badge badge-light-secondary fs-9 fw-semibold">@(isAr ? "قريبًا" : "Soon")</span>
                        }
                    </a>
                </div>
            }
        </div>
    </div>
}

<!--begin::Systems quick-switch (cross-module navigation, like the LABELS section)-->
@{
    // manufacturing screens live under /Inventory but are their own system — match all of their actions
    string[] manufSegs = { "/workorder", "/manufdashboard", "/workcenter", "/routing", "/productionplanning", "/plandetails", "/manufreports", "/newworkorder" };
    bool isManufPath = manufSegs.Any(seg => path.Contains(seg));
    var sysItems = new (string ar, string en, string url, string color, string key)[] {
        ("Inventory", "Inventory", Url.Action("Index","Inventory") ?? "#", "#FBBF24", "inv"),
        ("Manufacturing", "Manufacturing", Url.Action("ManufDashboard","Inventory") ?? "#", "#FDBA74", "manuf"),
        ("Accounting", "Accounting", Url.Action("Index","Accounting") ?? "#", "#38BDF8", "acc"),
        ("Administration", "Back-office", Url.Action("Index","Admin") ?? "#", "#22D3EE", "svc"),
        ("Employees", "People", Url.Action("Dashboard","People") ?? "#", "#A8C5FF", "ppl"),
        ("CRM", "CRM", Url.Action("Index","Crm") ?? "#", "#D8B4FE", "crm"),
        ("Restaurant", "Restaurant", Url.Action("Dashboard","Pos") ?? "#", "#FDA4AF", "rest"),
        ("Hypermarket", "Hypermarket", Url.Action("Dashboard","Hyper") ?? "#", "#F9A8D4", "hyper"),
        ("Tasks", "Tasks", Url.Action("Index","Tasks") ?? "#", "#C4B5FD", "tasks"),
        // Calendar is a system in its own right - three screens and its own sidebar (MainMenu.Calendar()) -
        // but its ONLY way in was a single row buried in Back-office > General, so its Timeline and Resource
        // View could not be found by anyone who did not already know they existed. Same array, same styling,
        // same active rule as its neighbours: this is the switcher listing a system it had omitted.
        ("التقويم", "Calendar", Url.Action("Index","Calendar") ?? "#", "#F0ABFC", "cal"),
        ("المشاريع والمقاولات", "Projects & Contracting", Url.Action("Dashboard","Project") ?? "#", "#2DD4BF", "proj"),
    };
    string SysActive(string url, string key)
    {
        if (key == "manuf") return isManufPath ? "active" : "";
        if (key == "rest") return path.StartsWith("/pos") ? "active" : "";   // Restaurant = all /pos setup + operational screens
        if (key == "hyper") return path.StartsWith("/hyper") ? "active" : "";   // Hypermarket = back-office /hyper + lane /hyper/pos
        if (key == "svc") return (path.StartsWith("/admin") || path.StartsWith("/service")) ? "active" : "";   // Back-office = HR dashboard (/admin) + setup (/service)
        if (key == "tasks") return path.StartsWith("/tasks") ? "active" : "";
        if (key == "cal") return path.StartsWith("/calendar") ? "active" : "";
        if (key == "proj") return path.StartsWith("/project") ? "active" : "";   // Projects & Contracting system
        var u = url.TrimEnd('/').ToLowerInvariant(); var seg = u.Replace("/index","").Replace("/dashboard","");
        if (key == "inv") return (!isManufPath && (path == u || path.StartsWith("/inventory"))) ? "active" : "";   // inventory ≠ manufacturing
        return (path == u || (seg.Length > 1 && path.StartsWith(seg))) ? "active" : "";
    }
}
<div class="menu-item pt-5 px-3">
    @* Contrast (WCAG AA). text-muted resolves to --bs-text-muted #99A1B7, which is 2.58:1 on the sidebar's
       white ground — the single largest colour-contrast source in the rendered audit (44 findings, and up to
       ~130 nodes on a long menu because this heading repeats per category).
       text-gray-700 (#4B5675) is the next step on Metronic's OWN grey ramp and measures 7.27:1. gray-600 was
       rejected on measurement rather than taste: at 3.83:1 it still fails AA.
       The heading stays a quiet, uppercase, small label — subdued relative to the menu items beside it, which
       is the visual job it was doing. A token swap inside the existing ramp; no new colour, no hardcoded hex. *@
    <div class="menu-content"><span class="menu-heading fw-bold text-uppercase fs-7 text-gray-700">@Localizer["Systems"]</span></div>
</div>
@foreach (var s in sysItems)
{
    var act = SysActive(s.url, s.key);
    <div class="menu-item px-3">
        <a class="menu-link cb-sys @act" href="@s.url">
            <span class="menu-icon"><span class="cb-dot" style="background:@s.color"></span></span>
            <span class="menu-title fw-semibold">@SR[s.en]</span>
        </a>
    </div>
}
<div class="menu-item px-3 mb-4">
    <a class="menu-link cb-sys" href="@(Url.Action("Choose","Portal") ?? "#")">
        @* Same contrast swap as the Systems heading above: this is a real navigation label ("All systems"),
           not decoration, so it must clear AA. text-muted 2.58:1 -> text-gray-700 7.27:1.
           The icon keeps text-muted deliberately — it is a decorative glyph beside the label it belongs to,
           and the contrast rule governs text, not adjacent iconography. *@
        <span class="menu-icon"><i class="ki-outline ki-element-11 fs-5 text-muted" aria-hidden="true"></i></span>
        <span class="menu-title fw-semibold text-gray-700">@Localizer["All systems"]</span>
    </a>
</div>
<!--end::Systems quick-switch-->
<script>
(function () {
    var box = document.getElementById('mainMenuSearch');
    if (!box) return;
    box.addEventListener('input', function () {
        var q = (box.value || '').trim().toLowerCase();
        var cats = document.querySelectorAll('.cb-cat');
        cats.forEach(function (cat) {
            var any = false;
            cat.querySelectorAll('.menu-sub .menu-item').forEach(function (li) {
                var t = (li.textContent || '').trim().toLowerCase();
                var show = !q || t.indexOf(q) !== -1;
                li.style.display = show ? '' : 'none';
                if (show) any = true;
            });
            cat.style.display = any ? '' : 'none';
            if (q && any) cat.classList.add('show'); else if (q) cat.classList.remove('show');
        });
    });
})();
</script>
