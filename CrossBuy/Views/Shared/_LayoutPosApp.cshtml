@using System.Text.Json
@using CrossBuy.Controllers
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
	// Cashier chrome shell — modeled on the accounting layout (_LayoutAccounting): identical Metronic app-shell (head
	// bundle, page-loader, app-header, brand) so it matches the accounting screens. Bound to the cashier session (PosCtx),
	// with the admin sidebar/search/notifications removed (not applicable to a cashier). Used by /pos/start etc.
	var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
	var ctxJson = Context.Session.GetString("PosCtx");
	var ctx = ctxJson != null ? JsonSerializer.Deserialize<PosAppController.PosCtx>(ctxJson) : null;
	var uName = isAr ? (ctx?.EmployeeName ?? "") : (string.IsNullOrWhiteSpace(ctx?.EmployeeNameEn) ? ctx?.EmployeeName : ctx?.EmployeeNameEn);
	var photo = !string.IsNullOrWhiteSpace(ctx?.EmployeePhoto) ? Url.Content("~" + ctx!.EmployeePhoto.Replace("\\", "/")) : Url.Content("~/Backend-assets/media/svg/avatars/blank.svg");
}
<!DOCTYPE html>
<html lang="@Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName" dir="@(Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
	<title>@ViewData["Title"] · CrossBuy POS</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="shortcut icon" href="~/Backend-assets/media/logos/favicon.ico" />
	<link rel="icon" type="image/svg+xml" href="~/Backend-assets/media/logos/crossbuy-favicon.svg" />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
	<!-- PWA (installable cashier) — same as the standalone POS -->
	<link rel="manifest" href="~/pos.webmanifest" />
	<meta name="theme-color" content="#13433a" />
	@if (isAr)
	{
		<link href="~/Backend-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" />
		<link href="~/Backend-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" />
		<link href="~/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" />
		<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<style>html[lang="ar"] body { font-family: 'Cairo', sans-serif; direction: rtl; text-align: right; }</style>
	}
	else
	{
		<link href="~/Backend-assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
		<link href="~/Backend-assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
		<link href="~/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" />
	}
	<script>if (window.top != window.self) { window.top.location.replace(window.self.location.href); }</script>
	@await RenderSectionAsync("Styles", required: false)
</head>
<body id="kt_app_body" data-kt-app-header-fixed="true" data-kt-app-header-fixed-mobile="true" class="app-default" data-kt-app-page-loading="on">
	<!--begin::Theme mode setup on page load-->
	<script>var defaultThemeMode = "light"; var themeMode; if (document.documentElement) { if (document.documentElement.hasAttribute("data-bs-theme-mode")) { themeMode = document.documentElement.getAttribute("data-bs-theme-mode"); } else { if (localStorage.getItem("data-bs-theme") !== null) { themeMode = localStorage.getItem("data-bs-theme"); } else { themeMode = defaultThemeMode; } } if (themeMode === "system") { themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; } document.documentElement.setAttribute("data-bs-theme", themeMode); }</script>
	<!--end::Theme mode setup on page load-->
	<!--begin::Page loading(append to body)-->
	<div class="page-loader flex-column">
		<span class="spinner-border text-primary" role="status"></span>
		<span class="text-muted fs-6 fw-semibold mt-5">@CrossBuy.Resources.SharedResources.Loading</span>
	</div>
	<!--end::Page loading-->
	<!--begin::App-->
	<div class="d-flex flex-column flex-root app-root" id="kt_app_root">
		<!--begin::Page-->
		<div class="app-page flex-column flex-column-fluid" id="kt_app_page">
			<!--begin::Header (mirrors the accounting app-header)-->
			<div id="kt_app_header" class="app-header d-flex flex-column flex-stack">
				<div class="d-flex flex-stack flex-grow-1 px-lg-8">
					<!--begin::Logo-->
					<div class="app-header-logo d-flex align-items-center gap-4" id="kt_app_header_logo">
						<a href="/pos/start" class="app-sidebar-logo">
							<img alt="CrossBuy" src="~/Backend-assets/media/logos/crossbuy-logo.svg" class="h-28px" />
						</a>
						@if (!string.IsNullOrEmpty(ctx?.BranchName))
						{
							<span class="badge badge-light-primary fw-semibold fs-7"><i class="ki-outline ki-geolocation fs-7 me-1"></i>@ctx?.BranchName</span>
						}
					</div>
					<!--end::Logo-->
					<!--begin::Navbar-->
					<div class="app-navbar flex-shrink-0">
						<!--begin::User menu-->
						<div class="app-navbar-item ms-2 ms-lg-4" id="kt_header_user_menu_toggle">
							<div class="cursor-pointer d-flex align-items-center gap-3" data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
								<span class="d-none d-md-flex flex-column align-items-end lh-1">
									<span class="fw-bold fs-7 text-gray-800">@uName</span>
									<span class="fw-semibold fs-8 text-muted mt-1">@(isAr ? "الكاشير" : "Cashier")</span>
								</span>
								<div class="symbol symbol-circle symbol-40px"><img src="@photo" alt="user" /></div>
							</div>
							<!--begin::User account menu-->
							<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-4 fs-6 w-250px" data-kt-menu="true">
								<div class="menu-item px-3">
									<div class="menu-content d-flex align-items-center px-3">
										<div class="symbol symbol-50px me-5"><img alt="user" src="@photo" /></div>
										<div class="d-flex flex-column">
											<div class="fw-bold fs-5">@uName</div>
											<span class="fw-semibold text-muted fs-7">@ctx?.BranchName</span>
										</div>
									</div>
								</div>
								<div class="separator my-2"></div>
								<div class="menu-item px-5">
									<a href="/pos/start" class="menu-link px-5"><span class="menu-icon"><i class="ki-outline ki-screen fs-5"></i></span>@(isAr ? "تبديل الجهاز" : "Switch terminal")</a>
								</div>
								<div class="menu-item px-5">
									<a href="/pos/logout" class="menu-link px-5 text-danger"><span class="menu-icon"><i class="ki-outline ki-exit-right fs-5"></i></span>@(isAr ? "تسجيل الخروج" : "Logout")</a>
								</div>
							</div>
							<!--end::User account menu-->
						</div>
						<!--end::User menu-->
					</div>
					<!--end::Navbar-->
				</div>
			</div>
			<!--end::Header-->
			<!--begin::Wrapper-->
			<div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
				<!--begin::Main-->
				<div class="app-main flex-column flex-row-fluid" id="kt_app_main">
					<!--begin::Content wrapper-->
					<div class="d-flex flex-column flex-column-fluid">
						@RenderBody()
					</div>
					<!--end::Content wrapper-->
					<!--begin::Footer-->
					<div id="kt_app_footer" class="app-footer">
						<div class="app-container container-fluid d-flex flex-column flex-md-row flex-center flex-md-stack py-3">
							<div class="text-gray-900 order-2 order-md-1">
								<span class="text-muted fw-semibold me-1">© @System.DateTime.Now.Year</span>
								<span class="text-gray-800 fw-bold">CrossBuy POS</span>
							</div>
						</div>
					</div>
					<!--end::Footer-->
				</div>
				<!--end::Main-->
			</div>
			<!--end::Wrapper-->
		</div>
		<!--end::Page-->
	</div>
	<!--end::App-->
	<script>var hostUrl = "~/Backend-assets/";</script>
	<script src="~/Backend-assets/plugins/global/plugins.bundle.js"></script>
	<script src="~/Backend-assets/js/scripts.bundle.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
