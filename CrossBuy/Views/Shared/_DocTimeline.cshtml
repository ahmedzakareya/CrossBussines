@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    // Communication Hub P5 — reusable document comments / timeline. Include from any document view after
    // setting ViewBag.CommentEntityType + ViewBag.CommentEntityId.
    var cType = (ViewBag.CommentEntityType as string) ?? "";
    var cId = ViewBag.CommentEntityId?.ToString() ?? "0";
    var blank = Url.Content("~/Backend-assets/media/svg/avatars/blank.svg");
}
<div class="card mt-5" id="cbDocTimeline" data-type="@cType" data-id="@cId">
    <div class="card-header"><div class="card-title fw-bold fs-5"><i class="ki-outline ki-message-text-2 fs-3 text-primary me-2"></i>@SR["Comments"]</div></div>
    <div class="card-body">
        <div id="cbCmtList" class="mb-5"><div class="text-muted text-center py-6 fs-7">@SR["Loading..."]</div></div>
        <div class="separator my-4"></div>
        <div class="d-flex align-items-start gap-3">
            <textarea id="cbCmtInput" class="form-control form-control-solid" rows="2" placeholder="@SR["Write a comment…"]"></textarea>
            <button class="btn btn-primary flex-shrink-0" id="cbCmtSend"><i class="ki-outline ki-send fs-4"></i>@SR["Send"]</button>
        </div>
    </div>
</div>
<script>
(function () {
    var box = document.getElementById('cbDocTimeline'); if (!box || box.__wired) return; box.__wired = true;
    var type = box.getAttribute('data-type'), id = box.getAttribute('data-id');
    var blank = '@blank';
    function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
    function when(iso) { try { return new Date(iso).toLocaleString(); } catch (e) { return ''; } }
    function row(c) {
        var av = c.authorAvatar || blank;
        return '<div class="d-flex align-items-start mb-4" data-cid="' + c.id + '">' +
            '<div class="symbol symbol-35px symbol-circle me-3"><img src="' + av + '" alt="" /></div>' +
            '<div class="flex-grow-1"><div class="d-flex align-items-center"><span class="fw-bold text-gray-900 me-2">' + esc(c.authorName) + '</span>' +
            '<span class="text-muted fs-8">' + when(c.createdAt) + '</span>' +
            (c.mine ? '<a href="#" class="ms-auto text-muted cb-cmt-del" title="Delete"><i class="ki-outline ki-trash fs-6"></i></a>' : '') +
            '</div><div class="text-gray-800 fs-7" style="unicode-bidi:plaintext" dir="auto">' + esc(c.body).replace(/\n/g, '<br>') + '</div></div></div>';
    }
    function bind() {
        document.querySelectorAll('#cbCmtList .cb-cmt-del').forEach(function (a) {
            a.addEventListener('click', function (e) {
                e.preventDefault(); var el = a.closest('[data-cid]'); var cid = el.getAttribute('data-cid');
                var fd = new FormData(); fd.append('id', cid);
                fetch('/Comments/Delete', { method: 'POST', credentials: 'same-origin', body: fd })
                    .then(function (r) { return r.json(); }).then(function (res) { if (res.ok) el.remove(); });
            });
        });
    }
    function load() {
        fetch('/Comments/List?entityType=' + encodeURIComponent(type) + '&entityId=' + id, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (list) {
                var host = document.getElementById('cbCmtList');
                host.innerHTML = list.length ? list.map(row).join('') : '<div class="text-muted text-center py-6 fs-7">@SR["No comments yet"]</div>';
                bind();
            });
    }
    document.getElementById('cbCmtSend').addEventListener('click', function () {
        var inp = document.getElementById('cbCmtInput'); var body = inp.value.trim(); if (!body) return;
        var fd = new FormData(); fd.append('entityType', type); fd.append('entityId', id); fd.append('body', body);
        var btn = this; btn.disabled = true;
        fetch('/Comments/Add', { method: 'POST', credentials: 'same-origin', body: fd })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function () { inp.value = ''; load(); })
            .catch(function () { if (window.toastr) toastr.error('@SR["Send failed"]'); })
            .then(function () { btn.disabled = false; });
    });
    load();
})();
</script>
