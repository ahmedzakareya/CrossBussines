                                <div class="menu-item">
                                    <a class="menu-link @active("MyAppraisals")" href="@Url.Action("MyAppraisals", "People")">
                                        <span class="menu-icon"><i class="ki-outline ki-award fs-2"></i></span>
                                        <span class="menu-title">@Localizer["My Appraisals"]</span>
