    </div>

    <script>var hostUrl = "~/Backend-assets/";</script>
    <script src="~/Backend-assets/plugins/global/plugins.bundle.js"></script>
    <script src="~/Backend-assets/js/scripts.bundle.js"></script>
    <script src="~/Backend-assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/Backend-assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/app.ajax.js"></script>
    <script src="~/Backend-assets/js/crossbuy-confirm.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_CbToastr")
    <!--begin::Notifications (SignalR)-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (function () {
            var isAr = @(isAr ? "true" : "false");
            var badge = document.getElementById('ppl_notif_badge');
            var list = document.getElementById('ppl_notif_list');
            var empty = document.getElementById('ppl_notif_empty');
            var unread = 0;

            // ---- toast (matches success/info/warning/error style) ----
            var style = document.createElement('style');
            style.textContent =
                '#ppl_toasts{position:fixed;top:80px;inset-inline-end:20px;z-index:3000;display:flex;flex-direction:column;gap:10px;width:340px;max-width:90vw}' +
                '.ppl-toast{display:flex;align-items:flex-start;gap:12px;background:#fff;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.13);padding:14px 16px;transition:opacity .2s}' +
                '.ppl-toast .ic{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;font-size:18px;font-weight:700}' +
                '.ppl-toast.success .ic{background:#2f9e6e}.ppl-toast.info .ic{background:#1f6253}.ppl-toast.warning .ic{background:#d4a017}.ppl-toast.error .ic{background:#D9214E}' +
                '.ppl-toast .tt{font-weight:700;color:#181C32;font-size:14px}.ppl-toast .ms{color:#5E6278;font-size:12.5px;margin-top:2px}' +
                '.ppl-toast .cl{cursor:pointer;color:#99A1B7;font-size:20px;line-height:1;background:none;border:0;padding:0}';
            document.head.appendChild(style);
            var toastWrap = document.createElement('div');
            toastWrap.id = 'ppl_toasts';
            document.body.appendChild(toastWrap);

            function pplToast(level, title, msg) {
                var icons = { success: '✓', info: 'i', warning: '!', error: '✕' };
                var el = document.createElement('div');
                el.className = 'ppl-toast ' + level;
                el.innerHTML = '<div class="ic"></div><div style="flex:1"><div class="tt"></div><div class="ms"></div></div><button class="cl">&times;</button>';
                el.querySelector('.ic').textContent = icons[level] || 'i';
                el.querySelector('.tt').textContent = title || '';
                el.querySelector('.ms').textContent = msg || '';
                function close() { el.style.opacity = '0'; setTimeout(function () { el.remove(); }, 220); }
                el.querySelector('.cl').addEventListener('click', close);
                toastWrap.appendChild(el);
                setTimeout(close, 6000);
            }

            function setBadge(n) {
                unread = n;
                if (n > 0) { badge.style.display = ''; badge.textContent = n > 99 ? '99+' : n; }
                else { badge.style.display = 'none'; }
            }
            function timeAgo(iso) {
                try { var d = new Date(iso); return d.toLocaleString(); } catch (e) { return ''; }
            }
            function itemHtml(n) {
                var title = (isAr ? n.titleAr : n.titleEn) || n.titleEn || n.titleAr || '';
                var body = (isAr ? n.bodyAr : n.bodyEn) || n.bodyEn || n.bodyAr || '';
                var icon = n.type === 'leave_approved' ? 'ki-check-circle text-primary'
                    : n.type === 'leave_rejected' ? 'ki-cross-circle text-danger'
                    : 'ki-calendar-tick text-primary';
                var bg = n.isRead ? '' : 'bg-light-primary';
                return '<div class="d-flex align-items-start px-7 py-4 border-bottom border-gray-100 ' + bg + '">' +
                    '<span class="symbol symbol-35px me-3"><span class="symbol-label bg-light"><i class="ki-outline ' + icon + ' fs-3"></i></span></span>' +
                    '<div class="flex-grow-1"><div class="fw-bold fs-7 text-gray-900">' + title + '</div>' +
                    '<div class="fs-8 text-muted">' + body + '</div>' +
                    '<div class="fs-9 text-gray-400 mt-1">' + timeAgo(n.createdAt) + '</div></div></div>';
            }
            function render(items) {
                if (!items || !items.length) { return; }
                if (empty) empty.style.display = 'none';
                list.innerHTML = items.map(itemHtml).join('');
            }
            function prepend(n) {
                if (empty) empty.style.display = 'none';
                list.insertAdjacentHTML('afterbegin', itemHtml(n));
                setBadge(unread + 1);
            }

            var maxId = 0;
            function toastFor(n) {
                var title = (isAr ? n.titleAr : n.titleEn) || n.titleEn || n.titleAr || '';
                var body = (isAr ? n.bodyAr : n.bodyEn) || n.bodyEn || n.bodyAr || '';
                var level = n.type === 'leave_approved' ? 'success'
                    : n.type === 'leave_rejected' ? 'error'
                    : 'info';
                pplToast(level, title, body);
            }
            function apply(res, toastNew) {
                if (toastNew && res.data) {
                    res.data.filter(function (n) { return n.id > maxId; }).forEach(toastFor);
                }
                render(res.data);
                setBadge(res.unread || 0);
                if (res.data && res.data.length && res.data[0].id > maxId) maxId = res.data[0].id;
            }
            function loadNotifs(toastNew) {
                fetch('/api/notifications', { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (res) { if (res && res.success) apply(res, toastNew); })
                    .catch(function () {});
            }
            // initial load + polling fallback (works even across server instances)
            loadNotifs(false);
            setInterval(function () { loadNotifs(true); }, 15000);

            // mark all read
            var readAll = document.getElementById('ppl_notif_readall');
            if (readAll) readAll.addEventListener('click', function (e) {
                e.preventDefault();
                fetch('/api/notifications/read-all', { method: 'POST', credentials: 'same-origin' })
                    .then(function () {
                        setBadge(0);
                        list.querySelectorAll('.bg-light-primary').forEach(function (el) { el.classList.remove('bg-light-primary'); });
                    });
            });

            // realtime
            if (window.signalR) {
                var conn = new signalR.HubConnectionBuilder().withUrl('/hubs/notifications').withAutomaticReconnect().build();
                conn.on('notification', function (n) {
                    if (n && n.id && n.id <= maxId) return; // already shown by polling
                    if (n && n.id) maxId = n.id;
                    prepend(n);
                    toastFor(n);
                });
                conn.start().catch(function (err) { console.warn('notif hub:', err); });
            }
        })();
    </script>
    <!--end::Notifications-->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
