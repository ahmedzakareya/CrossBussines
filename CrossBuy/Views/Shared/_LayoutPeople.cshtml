                                <div class="menu-item">
                                    <a class="menu-link @active("Leaves")" href="@Url.Action("Leaves", "People")">
                                        <span class="menu-icon"><i class="ki-outline ki-calendar-tick fs-2"></i></span>
                                        <span class="menu-title">@Localizer["Leaves"]</span>
                                    </a>
                                </div>
                                <div class="menu-item">
                                    <a class="menu-link @active("Payslips")" href="@Url.Action("Payslips", "People")">
                                        <span class="menu-icon"><i class="ki-outline ki-dollar fs-2"></i></span>
                                        <span class="menu-title">@Localizer["My Payslips"]</span>
                                    </a>
