                                        <div class="menu-item px-3">
                                            <a asp-controller="Account" asp-action="SetLanguage" asp-route-culture="ar" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="menu-link d-flex px-5 @(isAr ? "active" : "")">
