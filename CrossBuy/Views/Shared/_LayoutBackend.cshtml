		<!--begin::Backend flatpickr enhancer (Metronic date pickers everywhere)-->
		<script>
			(function () {
				if (typeof flatpickr === 'undefined') return;
				function enhance(scope) {
					(scope || document).querySelectorAll('#kt_app_content input[type="date"], #kt_app_toolbar input[type="date"], .modal input[type="date"]').forEach(function (el) {
						if (el._flatpickr) return;
						if (el.hasAttribute('data-no-flatpickr')) return;
						var inModal = !!el.closest('.modal');
						var current = el.getAttribute('value') || el.value || null;
						el.setAttribute('type', 'text');
						el.classList.add('form-control-solid');
						var fp = flatpickr(el, {
							dateFormat: 'Y-m-d',
							defaultDate: current,
							allowInput: true,
							static: inModal,
							disableMobile: true,
							locale: { firstDayOfWeek: 6 }
						});
						// calendar-icon affordance (shows it's a date picker; click opens the calendar)
						if (el.parentElement && !el.parentElement.classList.contains('cb-date-wrap')) {
							var wrap = document.createElement('div');
							wrap.className = 'cb-date-wrap position-relative';
							el.parentNode.insertBefore(wrap, el);
							wrap.appendChild(el);
							var ic = document.createElement('i');
							ic.className = 'ki-outline ki-calendar-8 fs-3 text-gray-500';
							ic.style.cssText = 'position:absolute;top:50%;inset-inline-end:1rem;transform:translateY(-50%);cursor:pointer;pointer-events:auto;z-index:1;';
							ic.addEventListener('click', function () { if (el._flatpickr) el._flatpickr.open(); });
							wrap.appendChild(ic);
							el.style.paddingInlineEnd = '2.75rem';
						}
					});
				}
				document.addEventListener('DOMContentLoaded', function () { enhance(document); });
				document.addEventListener('shown.bs.modal', function (e) { enhance(e.target); });
			})();
		</script>
		<!--end::Backend flatpickr enhancer-->
		<!--end::Custom Javascript-->
