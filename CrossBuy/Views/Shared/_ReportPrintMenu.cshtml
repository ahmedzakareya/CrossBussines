@using CrossBuy.BL.Reporting
@using CrossBuy.Models.Context.Reporting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject IReportTemplateService Templates
@inject IReportCatalog Catalog
@inject CrossBuy.BL.Platform.IBusinessContextAccessor Contexts
@model ReportPrintMenuModel

@*  ================================================================================================
    PRINT — EVERY LAYOUT BOUND TO THIS SCREEN.

    The screen is bound to its reports in ReportScreenBindings, and each report's layouts are templates
    authored in Report Studio. So two different things vary without this file or the screen changing:

        a new REPORT on the screen   one line in ReportScreenBindings
        a new LAYOUT for a report    a template someone saves in Studio

    An earlier version took a report CODE from the view, which made the screen's markup the place a
    second report would have to be added — an edit, a build and a deployment to offer a document the
    platform already knew how to render.

    ONE LAYOUT IS A BUTTON, NOT A MENU. A dropdown offering a single choice is a step that teaches
    people the control is slow. The menu appears when there is a choice.

    NOTHING HERE PRINTS THE SCREEN and nothing downloads on click: every entry opens the shared dialog
    (_ReportPreviewModal), which is where "open in a tab" and "download" live.
    ================================================================================================ *@

@{
    var bindings = ReportScreenBindings.For(Model.ScreenKey);
    var context = await Contexts.TryGetCurrentAsync();
    var arabic = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    // What this caller may actually run. A binding names a report; whether the person may see it is a
    // separate question, and a menu that lists a report they cannot open is a 404 with extra steps.
    var visible = Catalog.GetDefinitions()
        .Select(d => d.Code)
        .ToHashSet(StringComparer.Ordinal);

    var entries = new List<(ReportScreenBinding Binding, string Title, IReadOnlyList<ReportTemplateSummary> Layouts)>();

    if (context is { CompanyId: > 0 })
    {
        foreach (var binding in bindings)
        {
            if (!visible.Contains(binding.ReportCode)) continue;

            var definition = Catalog.GetDefinitions()
                .FirstOrDefault(d => string.Equals(d.Code, binding.ReportCode, StringComparison.Ordinal));
            if (definition is null) continue;

            var layouts = await Templates.ListAsync(binding.ReportCode, context);
            entries.Add((binding, arabic ? definition.TitleAr : (definition.TitleEn ?? definition.TitleAr), layouts));
        }
    }

    // The export url for one layout of one bound report. `templateId` is omitted for a report's default
    // entry so the platform RESOLVES one — that walk (Personal, Team, Company, Platform) is how a
    // company's chosen layout wins, and naming a template here would silently override it.
    string Url_(ReportScreenBinding binding, int? templateId, bool inline)
    {
        var route = new Dictionary<string, string?>(StringComparer.Ordinal)
        {
            ["id"] = binding.ReportCode,
            ["format"] = "Pdf",
        };

        // A DOCUMENT is pinned by its id; a REGISTER is not. A list screen prints the rows it is
        // showing, so its binding names no id parameter and the screen contributes its filters
        // instead — the same menu and the same dialog, a different shape of report.
        if (!string.IsNullOrWhiteSpace(binding.IdParameter) && !string.IsNullOrWhiteSpace(Model.DocumentId))
            route[binding.IdParameter!] = Model.DocumentId;
        foreach (var (key, value) in Model.ExtraParameters) route[key] = value;
        if (templateId is > 0) route["templateId"] = templateId.Value.ToString();
        if (inline) route["inline"] = "true";

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            Url.Action("Export", "Reports")!, route);
    }

    string Name(ReportTemplateSummary t) =>
        arabic ? t.Name : (string.IsNullOrWhiteSpace(t.NameEn) ? t.Name : t.NameEn!);

    // A menu is warranted when there is more than one thing to pick: several reports, or one report
    // with layouts of its own beyond the default.
    var total = entries.Sum(e => e.Layouts.Count) + entries.Count;
    var single = entries.Count == 1 && entries[0].Layouts.Count <= 1;
}

@if (entries.Count == 0)
{
    @* NOTHING BOUND, OR NOTHING PERMITTED — and no control at all, rather than one that leads nowhere.
       A print button that opens an empty dialog is worse than its absence: the reader blames the
       document rather than their permissions. *@
}
else if (single)
{
    var e = entries[0];
    <button type="button" class="btn btn-sm btn-light-primary"
            data-report-view="@Url_(e.Binding, null, true)"
            data-report-download="@Url_(e.Binding, null, false)"
            data-report-label="PDF"
            data-report-viewable="true"
            title="@Localizer["Open the printable document"]">
        <i class="ki-outline ki-printer fs-5"></i>@Localizer["Print"]
    </button>
}
else
{
    <div class="d-inline-flex">
        @* Metronic's own menu engine (data-kt-menu) rather than Bootstrap's dropdown, so it matches
           every other menu in the product instead of being the same library in a different dialect. *@
        <button type="button" class="btn btn-sm btn-light-primary"
                data-kt-menu-trigger="click" data-kt-menu-placement="bottom-start"
                title="@Localizer["Choose a print layout"]">
            <i class="ki-outline ki-printer fs-5"></i>@Localizer["Print"]
            <i class="ki-outline ki-down fs-7 ms-1"></i>
        </button>

        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold fs-7 w-275px py-3"
             data-kt-menu="true">

            @for (var i = 0; i < entries.Count; i++)
            {
                var e = entries[i];

                @* THE REPORT'S NAME AS A HEADING, but only when the screen prints more than one. With a
                   single report it is a label above a list of its own layouts, which reads as noise. *@
                @if (entries.Count > 1)
                {
                    @if (i > 0)
                    {
                        <div class="separator my-2"></div>
                    }
                    <div class="menu-item px-3">
                        <div class="menu-content text-muted fs-8 text-uppercase fw-bold px-3 py-2">@e.Title</div>
                    </div>
                }

                <div class="menu-item px-3">
                    <a href="#" class="menu-link px-3"
                       data-report-view="@Url_(e.Binding, null, true)"
                       data-report-download="@Url_(e.Binding, null, false)"
                       data-report-label="PDF"
                       data-report-viewable="true">
                        <span class="menu-icon"><i class="ki-outline ki-document fs-5"></i></span>
                        <span class="menu-title">@Localizer["Default layout"]</span>
                    </a>
                </div>

                @foreach (var layout in e.Layouts)
                {
                    <div class="menu-item px-3">
                        <a href="#" class="menu-link px-3 d-flex align-items-center justify-content-between"
                           data-report-view="@Url_(e.Binding, layout.Id, true)"
                           data-report-download="@Url_(e.Binding, layout.Id, false)"
                           data-report-label="PDF · @Name(layout)"
                           data-report-viewable="true"
                           title="@Name(layout)">
                            <span class="menu-title text-truncate">@Name(layout)</span>

                            @* The scope, because "the company's layout" and "mine" is a meaningful
                               difference when two of them share a name — and they usually do. *@
                            <span class="badge badge-light fs-9 ms-2 flex-shrink-0">@Localizer[layout.Scope.ToString()]</span>
                        </a>
                    </div>
                }
            }
        </div>
    </div>
}
