@using CrossBuy.Models.Context.Admin
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model Brand
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isEdit = Model.ID > 0;
    string col(string? v, string def) => string.IsNullOrEmpty(v) ? def : v;
}
<form asp-action="SaveBrand" method="post" enctype="multipart/form-data" class="d-flex flex-column flex-column-fluid" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Save brand?"]">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ID" value="@Model.ID" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <h1 class="page-heading fw-bold fs-3 m-0">@(isEdit ? Localizer["Edit brand"] : Localizer["New brand"])</h1>
        <div class="d-flex gap-2"><a href="@Url.Action("Brands","Brand")" class="btn btn-light">@SR["Back"]</a><button class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid"><div class="row g-5">
        <div class="col-lg-8">
            <div class="card card-flush mb-5"><div class="card-header"><div class="card-title"><h2>@Localizer["Definition"]</h2></div></div>
                <div class="card-body pt-2"><div class="row g-4">
                    <div class="col-md-3"><label class="required fw-semibold fs-7 mb-1">@SR["Code"]</label><input name="Code" class="form-control form-control-solid" value="@Model.Code" required /></div>
                    <div class="col-md-5"><label class="required fw-semibold fs-7 mb-1">@SR["Name"]</label><input name="Name" class="form-control form-control-solid" value="@Model.Name" required /></div>
                    <div class="col-md-4"><label class="fw-semibold fs-7 mb-1">@Localizer["Name (EN)"]</label><input name="NameEn" class="form-control form-control-solid" value="@Model.NameEn" /></div>
                    <div class="col-md-12"><label class="form-check form-switch form-check-custom"><input type="hidden" name="IsActive" value="false" /><input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /><span class="form-check-label fw-semibold ms-2">@SR["Active"]</span></label></div>
                </div></div>
            </div>

            <div class="card card-flush mb-5"><div class="card-header"><div class="card-title"><h2>@Localizer["Document / receipt data"]</h2></div></div>
                <div class="card-body pt-2"><div class="row g-4">
                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Trade name"]</label><input name="TradeName" class="form-control form-control-solid" value="@Model.TradeName" /></div>
                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Website"]</label><input name="Website" class="form-control form-control-solid" value="@Model.Website" /></div>
                    <div class="col-md-12"><label class="fw-semibold fs-7 mb-1">@SR["Address"]</label><input name="Address" class="form-control form-control-solid" value="@Model.Address" /></div>
                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@SR["Phone"]</label><input name="Phone" class="form-control form-control-solid" value="@Model.Phone" /></div>
                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@SR["Email"]</label><input name="Email" class="form-control form-control-solid" value="@Model.Email" /></div>
                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Receipt footer (AR)"]</label><textarea name="ReceiptFooterAr" class="form-control form-control-solid" rows="2">@Model.ReceiptFooterAr</textarea></div>
                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Receipt footer (EN)"]</label><textarea name="ReceiptFooterEn" class="form-control form-control-solid" rows="2">@Model.ReceiptFooterEn</textarea></div>
                </div>
                <div class="text-muted fs-8 mt-3">@Localizer["Empty fields inherit from the company when rendered on receipts."]</div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card card-flush mb-5"><div class="card-header"><div class="card-title"><h2>@Localizer["Logo"]</h2></div></div>
                <div class="card-body pt-2 text-center">
                    <style>
                        .image-input-placeholder { background-image: url('@Url.Content("~/Backend-assets/media/svg/files/blank-image.svg")'); }
                        [data-bs-theme="dark"] .image-input-placeholder { background-image: url('@Url.Content("~/Backend-assets/media/svg/files/blank-image-dark.svg")'); }
                    </style>
                    <div class="image-input image-input-outline @(string.IsNullOrEmpty(Model.LogoPath) ? "image-input-placeholder" : "")" data-kt-image-input="true">
                        <div class="image-input-wrapper w-150px h-125px" style="background-size:contain;background-repeat:no-repeat;background-position:center;background-image:url('@(string.IsNullOrEmpty(Model.LogoPath) ? Url.Content("~/Backend-assets/media/svg/files/blank-image.svg") : Model.LogoPath)')"></div>
                        <label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow" data-kt-image-input-action="change" data-bs-toggle="tooltip" title="@Localizer["Change logo"]">
                            <i class="ki-outline ki-pencil fs-7"></i>
                            <input type="file" name="logo" accept=".png, .jpg, .jpeg, .svg" />
                            <input type="hidden" name="logo_remove" />
                        </label>
                        <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow" data-kt-image-input-action="cancel" data-bs-toggle="tooltip" title="@SR["Cancel"]"><i class="ki-outline ki-cross fs-2"></i></span>
                        <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow" data-kt-image-input-action="remove" data-bs-toggle="tooltip" title="@Localizer["Remove logo"]"><i class="ki-outline ki-cross fs-2"></i></span>
                    </div>
                    <div class="text-muted fs-8 mt-3">@Localizer["PNG/JPG/SVG — saved under /uploads/brands/"]</div>
                </div>
            </div>
            <div class="card card-flush"><div class="card-header"><div class="card-title"><h2>@Localizer["Identity colors"]</h2></div></div>
                <div class="card-body pt-2">
                    <label class="fw-semibold fs-7 mb-1">@Localizer["Primary"]</label>
                    <input name="ColorPrimary" type="color" class="form-control form-control-solid form-control-color mb-3" style="width:100%;height:42px" value="@col(Model.ColorPrimary, "#2b6cb0")" />
                    <label class="fw-semibold fs-7 mb-1">@Localizer["Secondary"]</label>
                    <input name="ColorSecondary" type="color" class="form-control form-control-solid form-control-color mb-3" style="width:100%;height:42px" value="@col(Model.ColorSecondary, "#718096")" />
                    <label class="fw-semibold fs-7 mb-1">@Localizer["Accent"]</label>
                    <input name="ColorAccent" type="color" class="form-control form-control-solid form-control-color" style="width:100%;height:42px" value="@col(Model.ColorAccent, "#ed8936")" />
                </div>
            </div>
        </div>
    </div></div></div>
</form>
