@using CrossBuy.Models.Context.Admin
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<Brand>
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading fw-bold fs-3 m-0">@Localizer["Brands"]</h1>
            <span class="text-muted fs-7">@Localizer["Trade name under the company — single ledger + analytic dimension (not a separate legal entity)."]</span></div>
        <div class="d-flex gap-2">
            <form asp-action="ActivateDefaultBrand" method="post" class="d-inline" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Create a default brand and link unbranded branches to it?"]">@Html.AntiForgeryToken()
                <button class="btn btn-light-primary"><i class="ki-outline ki-abstract-26 fs-2"></i>@Localizer["Activate default brand"]</button></form>
            <a href="@Url.Action("BrandEditor","Brand")" class="btn btn-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New brand"]</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["BrandMsg"] != null) { <div class="alert alert-success">@TempData["BrandMsg"]</div> }
        @if (TempData["BrandErr"] != null) { <div class="alert alert-danger">@TempData["BrandErr"]</div> }

        <div class="card card-flush mb-5"><div class="card-body py-5"><form method="get" class="row g-3 align-items-end">
            <div class="col-md-8"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@Localizer["Search (code / name / trade name)"]</label>
                <input name="q" value="@ViewBag.Q" class="form-control form-control-solid" placeholder="@Localizer["Type to search…"]" /></div>
            <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Status"]</label>
                <select name="status" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                    <option value="">@SR["All"]</option>
                    <option value="active" selected="@(ViewBag.Status as string == "active")">@SR["Active"]</option>
                    <option value="inactive" selected="@(ViewBag.Status as string == "inactive")">@SR["Inactive"]</option>
                </select></div>
            <div class="col-md-2"><button class="btn btn-light-primary w-100"><i class="ki-outline ki-magnifier fs-3"></i>@SR["Search"]</button></div>
        </form></div></div>

        <div class="card card-flush"><div class="card-body pt-6"><div class="table-responsive"><table class="table align-middle gy-3 mb-0">
            <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #13433a;"><th class="w-60px ps-4"></th><th>@SR["Code"]</th><th>@SR["Name"]</th><th>@Localizer["Trade name"]</th><th class="text-center">@Localizer["Identity"]</th><th class="text-center">@SR["Status"]</th><th class="text-end pe-4">@SR["Actions"]</th></tr></thead>
            <tbody>
            @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-8">@Localizer["No brands — create one or activate the default brand"]</td></tr> }
            @foreach (var b in Model)
            {
                <tr style="border-bottom:1px dashed #eef1f6;">
                    <td class="ps-4">@if (!string.IsNullOrEmpty(b.LogoPath)) { <img src="@b.LogoPath" style="width:44px;height:44px;object-fit:contain;border-radius:6px;" /> } else { <span class="badge badge-light-secondary">—</span> }</td>
                    <td class="fw-bold">@b.Code</td>
                    <td>@(isAr ? b.Name : (string.IsNullOrEmpty(b.NameEn) ? b.Name : b.NameEn))</td>
                    <td class="text-muted fs-7">@b.TradeName</td>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(b.ColorPrimary)) { <span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:@b.ColorPrimary;" title="@b.ColorPrimary"></span> }
                        @if (!string.IsNullOrEmpty(b.ColorSecondary)) { <span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:@b.ColorSecondary;margin-inline-start:3px;"></span> }
                        @if (!string.IsNullOrEmpty(b.ColorAccent)) { <span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:@b.ColorAccent;margin-inline-start:3px;"></span> }
                    </td>
                    <td class="text-center">@if (b.IsActive) { <span class="badge fw-bold" style="background:#eaf3ef;color:#13433a;">@SR["Active"]</span> } else { <span class="badge badge-light-secondary fw-bold">@SR["Inactive"]</span> }</td>
                    <td class="text-end pe-4">
                        <a href="@Url.Action("BrandEditor","Brand", new { id = b.ID })" class="btn btn-sm btn-icon btn-light-primary me-1"><i class="ki-outline ki-pencil fs-5"></i></a>
                        <form asp-action="DeleteBrand" method="post" class="d-inline" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Delete brand?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.ID" /><button class="btn btn-sm btn-icon btn-light-danger"><i class="ki-outline ki-trash fs-5"></i></button></form>
                    </td>
                </tr>
            }
            </tbody>
        </table></div></div></div>
    </div></div>
</div>
