@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var items = ViewBag.Items as List<Item> ?? new();
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    var units = ViewBag.Units as List<UnitOfMeasure> ?? new();
}
<form asp-action="CreateTransfer" method="post" id="f" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    <input type="hidden" name="linesJson" id="linesJson" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["New Stock Transfer"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("StockTransfers","Inventory")" class="text-muted text-hover-primary">@Localizer["Transfers"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["New"]</li></ul></div>
        <div class="d-flex gap-2"><a href="@Url.Action("StockTransfers","Inventory")" class="btn btn-light">@SR["Cancel"]</a><button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@Localizer["Post transfer"]</button></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body"><div class="row g-5">
            <div class="col-md-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["From warehouse"]</label><select name="fromWarehouseId" class="form-select form-select-solid" data-control="select2" required><option value="">@Localizer["Select"]</option>@foreach (var w in whs) { <option value="@w.ID">@w.Code — @(isAr ? w.Name : w.NameEn)</option> }</select></div>
            <div class="col-md-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["To warehouse"]</label><select name="toWarehouseId" class="form-select form-select-solid" data-control="select2" required><option value="">@Localizer["Select"]</option>@foreach (var w in whs) { <option value="@w.ID">@w.Code — @(isAr ? w.Name : w.NameEn)</option> }</select></div>
            <div class="col-md-2"><label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label><input type="text" name="transferDate" class="form-control form-control-solid" data-control="flatpickr" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-md-2"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" /></div>
        </div></div></div>
        <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@Localizer["Transferred items"]</h3><div class="card-toolbar d-flex gap-2 align-items-center flex-wrap"><div class="position-relative d-flex align-items-center"><i class="ki-outline ki-barcode fs-2 position-absolute ms-3"></i><input class="form-control form-control-solid form-control-sm w-220px ps-10 js-barcode-scan" placeholder="@Localizer["Scan barcode + Enter"]" autocomplete="off" /></div><button type="button" class="btn btn-sm btn-light-primary" id="add"><i class="ki-outline ki-plus fs-3"></i>@Localizer["Add line"]</button></div></div>
        <div class="card-body"><div class="alert alert-light-primary p-3 mb-4 fs-7"><i class="ki-outline ki-information-5 fs-3 me-2"></i>@Localizer["Transferred at actual cost — out of source, into destination, with no GL impact."]</div>
        <div class="table-responsive"><table class="table table-row-bordered align-middle"><thead><tr class="fw-bold fs-7 text-uppercase text-muted">
            <th style="min-width:220px">@SR["Item"]</th><th style="width:90px">@Localizer["Qty"]</th><th style="min-width:110px">@Localizer["Unit"]</th><th style="min-width:200px">@Localizer["From location (source)"]</th><th style="min-width:200px">@Localizer["To location (destination)"]</th><th style="min-width:110px">@Localizer["Batch"]</th><th style="min-width:110px">@Localizer["Serial"]</th><th style="width:40px"></th>
        </tr></thead><tbody id="rows"></tbody></table></div></div></div>
    </div></div>
</form>
<partial name="_ItemScanModal" />
<partial name="~/Views/Shared/_QuickAdd.cshtml" />
@section Scripts {
<script>
var ITEMS=[]; var itemPickUrl='@Url.Action("ItemPickData","Inventory")';
var UNITS=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(units.Select(u=>new{iD=u.ID,name=(isAr?u.Name:u.NameEn)})));
function iopts(sel){var o='<option value="">—</option>';ITEMS.forEach(function(i){o+='<option value="'+i.iD+'" data-base="'+(i.baseUom||'')+'"'+(sel==i.iD?' selected':'')+'>'+i.itemCode+' — '+i.name+'</option>';});return o;}
// ---- destination section/rack (location) support ----
var BINS={sections:[],racks:[],itemDefaults:{}}; var binsUrl='@Url.Action("WarehouseBinsData","Inventory")';
function secOpts(sel){var o='<option value="">—</option>';BINS.sections.forEach(function(s){o+='<option value="'+s.id+'"'+(sel==s.id?' selected':'')+'>'+s.code+(s.name?(' — '+s.name):'')+'</option>';});return o;}
function fillRacks(tr){var sec=tr.querySelector('.sec').value;var rk=tr.querySelector('.rack');var cur=rk.value;var o='<option value="">—</option>';BINS.racks.forEach(function(r){if(String(r.sectionId)===String(sec))o+='<option value="'+r.id+'"'+(cur==r.id?' selected':'')+'>'+r.code+(r.name?(' — '+r.name):'')+'</option>';});rk.innerHTML=o;}
function applyItemDefault(tr,itemId){var d=BINS.itemDefaults[String(itemId)];if(!d)return;if(!tr.querySelector('.sec').value&&d.sectionId){tr.querySelector('.sec').value=d.sectionId;fillRacks(tr);if(d.rackId)tr.querySelector('.rack').value=d.rackId;}}
function refreshRowBins(){document.querySelectorAll('#rows tr').forEach(function(tr){var s=tr.querySelector('.sec');if(!s)return;var cur=s.value;s.innerHTML=secOpts(cur);fillRacks(tr);var it=tr.querySelector('.it').value;if(it&&!s.value)applyItemDefault(tr,it);});}
function loadBins(whId){if(!whId){BINS={sections:[],racks:[],itemDefaults:{}};refreshRowBins();return;}fetch(binsUrl+'?warehouseId='+whId,{headers:{'X-Requested-With':'fetch'}}).then(function(r){return r.json();}).then(function(j){BINS=j;refreshRowBins();});}
(function(){var wh=document.querySelector('[name="toWarehouseId"]');if(!wh)return;var go=function(){loadBins(wh.value);};if(window.jQuery){jQuery(wh).on('change select2:select',go);}else{wh.addEventListener('change',go);}if(wh.value)loadBins(wh.value);})();
// ---- SOURCE section/rack (picked-from) support, bound to fromWarehouseId ----
var BINSS={sections:[],racks:[],itemDefaults:{}};
function secOptsS(sel){var o='<option value="">—</option>';BINSS.sections.forEach(function(s){o+='<option value="'+s.id+'"'+(sel==s.id?' selected':'')+'>'+s.code+(s.name?(' — '+s.name):'')+'</option>';});return o;}
function fillRacksS(tr){var sec=tr.querySelector('.ssec').value;var rk=tr.querySelector('.srack');var cur=rk.value;var o='<option value="">—</option>';BINSS.racks.forEach(function(r){if(String(r.sectionId)===String(sec))o+='<option value="'+r.id+'"'+(cur==r.id?' selected':'')+'>'+r.code+(r.name?(' — '+r.name):'')+'</option>';});rk.innerHTML=o;}
function applyItemDefaultS(tr,itemId){var d=BINSS.itemDefaults[String(itemId)];if(!d)return;if(!tr.querySelector('.ssec').value&&d.sectionId){tr.querySelector('.ssec').value=d.sectionId;fillRacksS(tr);if(d.rackId)tr.querySelector('.srack').value=d.rackId;}}
function refreshRowBinsS(){document.querySelectorAll('#rows tr').forEach(function(tr){var s=tr.querySelector('.ssec');if(!s)return;var cur=s.value;s.innerHTML=secOptsS(cur);fillRacksS(tr);var it=tr.querySelector('.it').value;if(it&&!s.value)applyItemDefaultS(tr,it);});}
function loadBinsS(whId){if(!whId){BINSS={sections:[],racks:[],itemDefaults:{}};refreshRowBinsS();return;}fetch(binsUrl+'?warehouseId='+whId,{headers:{'X-Requested-With':'fetch'}}).then(function(r){return r.json();}).then(function(j){BINSS=j;refreshRowBinsS();});}
(function(){var wh=document.querySelector('[name="fromWarehouseId"]');if(!wh)return;var go=function(){loadBinsS(wh.value);};if(window.jQuery){jQuery(wh).on('change select2:select',go);}else{wh.addEventListener('change',go);}if(wh.value)loadBinsS(wh.value);})();
function uopts(sel){var o='<option value="">—</option>';UNITS.forEach(function(u){o+='<option value="'+u.iD+'"'+(sel==u.iD?' selected':'')+'>'+u.name+'</option>';});return o;}
function addRow(d){d=d||{};var tr=document.createElement('tr');tr.innerHTML=
 '<td><select class="form-select form-select-solid it"></select></td>'+
 '<td><input type="number" step="0.0001" class="form-control form-control-solid q text-end" value="'+(d.qty||1)+'"></td>'+
 '<td><select class="form-select form-select-solid u">'+uopts(d.uomId)+'</select></td>'+
 '<td><div class="d-flex gap-2"><select class="form-select form-select-solid form-select-sm ssec">'+secOptsS(0)+'</select><select class="form-select form-select-solid form-select-sm srack"><option value="">—</option></select></div></td>'+
 '<td><div class="d-flex gap-2"><select class="form-select form-select-solid form-select-sm sec">'+secOpts(0)+'</select><select class="form-select form-select-solid form-select-sm rack"><option value="">—</option></select></div></td>'+
 '<td><input class="form-control form-control-solid b" placeholder="—"></td>'+
 '<td><input class="form-control form-control-solid sn" placeholder="—"></td>'+
 '<td class="text-center"><button type="button" class="btn btn-icon btn-light-danger btn-sm del"><i class="ki-outline ki-trash fs-5"></i></button></td>';
 document.getElementById('rows').appendChild(tr);
 fillRacksS(tr); fillRacks(tr);
 cbItemSelect(tr.querySelector('.it'), itemPickUrl);
 if(d.itemId) cbItemSelectSet(tr.querySelector('.it'), {id:d.itemId, name:d.text});}
document.getElementById('add').addEventListener('click',function(){addRow();});
document.getElementById('rows').addEventListener('change',function(e){if(e.target.classList.contains('it')){var tr=e.target.closest('tr'),o=e.target.options[e.target.selectedIndex];var b=o.getAttribute('data-base');if(b)tr.querySelector('.u').value=b;applyItemDefaultS(tr,e.target.value);applyItemDefault(tr,e.target.value);}else if(e.target.classList.contains('ssec')){fillRacksS(e.target.closest('tr'));}else if(e.target.classList.contains('sec')){fillRacks(e.target.closest('tr'));}});
document.getElementById('rows').addEventListener('click',function(e){if(e.target.closest('.del')){e.target.closest('tr').remove();}});
document.getElementById('save').addEventListener('click',function(){var lines=[];document.querySelectorAll('#rows tr').forEach(function(tr){var it=tr.querySelector('.it').value,q=parseFloat(tr.querySelector('.q').value)||0;var rk=tr.querySelector('.rack').value,sc=tr.querySelector('.sec').value,bin=rk||sc;var srk=tr.querySelector('.srack').value,ssc=tr.querySelector('.ssec').value,sbin=srk||ssc;if(it&&q>0)lines.push({itemId:parseInt(it),qty:q,uoMId:tr.querySelector('.u').value?parseInt(tr.querySelector('.u').value):null,batchNo:tr.querySelector('.b').value||null,serialNo:tr.querySelector('.sn').value||null,binLocationId:bin?parseInt(bin):null,sourceBinLocationId:sbin?parseInt(sbin):null});});if(!lines.length){alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Add an item"].Value)));return;}document.getElementById('linesJson').value=JSON.stringify(lines);document.getElementById('f').submit();});
addRow();
window.onItemScanned=function(p){ addRow({itemId:p.id, text:(p.code?p.code+' — ':'')+(p.name||''), qty:p.qty, uomId:p.uomId}); };
</script>
}
