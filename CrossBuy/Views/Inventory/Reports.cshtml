@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var cards = new (string action, string label, string desc, string icon, string color)[] {
        ("ValuationReport", Localizer["Inventory valuation"].Value, Localizer["Qty, value & avg cost per item/warehouse"].Value, "ki-dollar", "success"),
        ("StagnantReport", Localizer["Slow-moving items"].Value, Localizer["Items with no movement for a while"].Value, "ki-time", "warning"),
        ("ReorderReport", Localizer["Reorder / low stock"].Value, Localizer["Items at/below reorder point or out of stock"].Value, "ki-information-5", "danger"),
        ("ExpiryAlerts", Localizer["Expiry alerts"].Value, Localizer["Expired or soon-to-expire batches"].Value, "ki-time", "warning"),
    };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Inventory reports"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Reports"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8">
            @foreach (var c in cards)
            {
                <div class="col-md-4">
                    <a href="@Url.Action(c.action,"Inventory")" class="card card-flush h-100 text-decoration-none">
                        <div class="card-body d-flex flex-column p-7">
                            <div class="symbol symbol-50px mb-5"><span class="symbol-label bg-light-@c.color"><i class="ki-outline @c.icon fs-2x text-@c.color"></i></span></div>
                            <span class="fs-3 fw-bold text-gray-900">@c.label</span>
                            <span class="text-gray-500 fw-semibold fs-7 mt-2">@c.desc</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div></div>
</div>
