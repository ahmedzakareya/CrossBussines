@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model MatchResult
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Three-way match"] — @ViewBag.PoNo</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("PurchaseOrders","Inventory")" class="text-muted text-hover-primary">@Localizer["Purchase orders"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Match"]</li></ul></div>
        <a href="@Url.Action("PurchaseOrderDetails","Inventory", new { id = ViewBag.PoId })" class="btn btn-light"><i class="ki-outline ki-arrow-left fs-2"></i>@Localizer["Back to PO"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Received)
        {
            <div class="alert alert-light-warning d-flex align-items-center"><i class="ki-outline ki-information fs-2 text-warning me-3"></i>@Localizer["Not received yet — three-way match applies once a goods receipt is posted."]</div>
        }
        else
        {
            <div class="alert @(Model.Ok ? "alert-light-success" : "alert-light-danger") d-flex align-items-center mb-5">
                <i class="ki-outline @(Model.Ok ? "ki-check-circle text-primary" : "ki-cross-circle text-danger") fs-2 me-3"></i>
                <div>
                    <div class="fw-bold">@(Model.Ok ? Localizer["Match passed ✔"] : Localizer["Variance beyond tolerance ✘"])</div>
                    <div class="fs-7 text-muted">@Localizer["Tolerance: qty"] @Model.QtyTolerancePct% · @Localizer["price"] @Model.PriceTolerancePct%</div>
                </div>
            </div>
        }
        <div class="card card-flush"><div class="card-body pt-5">
            <div class="table-responsive"><table class="table table-row-bordered align-middle gy-3">
                <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                    <th>@SR["Item"]</th><th class="text-end">@Localizer["Ordered"]</th><th class="text-end">@Localizer["Received"]</th><th class="text-end">@Localizer["PO price"]</th><th class="text-end">@Localizer["Recv. cost"]</th><th class="text-end">@Localizer["Qty var%"]</th><th class="text-end">@Localizer["Price var%"]</th><th class="text-center">@SR["Status"]</th>
                </tr></thead>
                <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td class="fw-semibold text-gray-800">@l.ItemDesc</td>
                        <td class="text-end">@l.OrderedQty.ToString("0.##")</td>
                        <td class="text-end">@l.ReceivedQty.ToString("0.##")</td>
                        <td class="text-end">@l.PoPrice.ToString("N2")</td>
                        <td class="text-end">@l.ReceivedCost.ToString("N2")</td>
                        <td class="text-end @(l.QtyVarPct>Model.QtyTolerancePct?"text-danger fw-bold":"text-muted")">@l.QtyVarPct.ToString("0.#")</td>
                        <td class="text-end @(l.PriceVarPct>Model.PriceTolerancePct?"text-danger fw-bold":"text-muted")">@l.PriceVarPct.ToString("0.#")</td>
                        <td class="text-center"><span class="badge badge-light-@(l.Ok?"success":"danger")">@(l.Ok?Localizer["OK"]:Localizer["Variance"])</span></td>
                    </tr>
                }
                @if (Model.Lines.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-10">@Localizer["No stock lines to match"]</td></tr> }
                </tbody>
            </table></div>
        </div></div>
    </div></div>
</div>
