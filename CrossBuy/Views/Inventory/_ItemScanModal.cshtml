@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    var isArS = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var blankImg = Url.Content("~/Backend-assets/media/svg/files/blank-image.svg");
}
<!--begin::Item scan popup (reusable). Pages set window.onItemScanned(payload) and place an input.js-barcode-scan -->
<div class="modal fade" id="itemScanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px">
        <div class="modal-content">
            <div class="modal-header py-4">
                <h2 class="fw-bold fs-4 m-0">@Localizer["Scanned item"]</h2>
                <div class="btn btn-icon btn-sm btn-active-light" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-2"></i></div>
            </div>
            <div class="modal-body">
                <div id="scanNotFound" class="alert alert-danger d-none">@Localizer["No item with this barcode"]</div>
                <div id="scanCard" class="d-none">
                    <div class="d-flex align-items-center mb-5">
                        <div class="symbol symbol-80px me-4"><span class="symbol-label" id="scanImg" style="background-size:contain;background-repeat:no-repeat;background-position:center;background-color:#f5f8fa"></span></div>
                        <div class="flex-grow-1">
                            <div class="fs-4 fw-bold text-gray-900" id="scanName"></div>
                            <div class="text-muted fs-7"><span id="scanCode"></span></div>
                            <div class="mt-2"><span class="badge badge-light-dark d-none" id="scanType"></span> <span class="badge badge-light-secondary d-none" id="scanComposite"></span></div>
                        </div>
                    </div>
                    <div id="scanCompBox" class="d-none mb-5">
                        <div class="fw-semibold text-gray-700 mb-2">@Localizer["Components"]</div>
                        <div class="border rounded p-3 bg-light"><div class="table-responsive"><table class="table table-row-dashed mb-0 fs-7"><tbody id="scanComps"></tbody></table></div></div>
                    </div>
                    <div class="row g-4">
                        <div class="col-7"><label class="fw-semibold fs-7 mb-1">@Localizer["Unit"]</label><select id="scanUom" class="form-select form-select-solid form-select-sm"></select></div>
                        <div class="col-5"><label class="fw-semibold fs-7 mb-1">@SR["Quantity"]</label><input id="scanQty" type="number" step="0.0001" min="0" value="1" class="form-control form-control-solid form-control-sm" /></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-4">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">@SR["Cancel"]</button>
                <button type="button" class="btn btn-primary btn-sm" id="scanOk"><i class="ki-outline ki-check fs-3"></i>@Localizer["Add to list"]</button>
            </div>
        </div>
    </div>
</div>
<script>
(function(){
  var url='@Url.Action("ScanBarcode","Inventory")';
  var blank='@blankImg';
  var L={ base:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["base"].Value)), bundle:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Bundle"].Value)), assembly:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Assembly"].Value)) };
  var IS_AR=@(isArS?"true":"false");
  var cur=null, modalEl=document.getElementById('itemScanModal'), modal=null;
  function M(){ if(!modal) modal=new bootstrap.Modal(modalEl); return modal; }
  function show(d){
    cur=d;
    document.getElementById('scanNotFound').classList.add('d-none');
    document.getElementById('scanCard').classList.remove('d-none');
    document.getElementById('scanName').textContent = (IS_AR ? d.name : (d.nameEn||d.name));
    document.getElementById('scanCode').textContent = d.code;
    var img=document.getElementById('scanImg'); img.style.backgroundImage="url('"+(d.image||blank)+"')";
    var tEl=document.getElementById('scanType'); tEl.textContent=d.itemType; tEl.classList.toggle('d-none', !d.itemType);
    var cEl=document.getElementById('scanComposite');
    if(d.isComposite){ cEl.textContent=(d.compositeType==='Bundle'?L.bundle:L.assembly); cEl.classList.remove('d-none'); }
    else cEl.classList.add('d-none');
    var cb=document.getElementById('scanCompBox'), ct=document.getElementById('scanComps');
    if(d.isComposite && d.components && d.components.length){ ct.innerHTML=''; d.components.forEach(function(x){var tr=document.createElement('tr');tr.innerHTML='<td>'+x.name+'</td><td class="text-end fw-bold">'+x.qty+' '+(x.uom||'')+'</td>';ct.appendChild(tr);}); cb.classList.remove('d-none'); }
    else cb.classList.add('d-none');
    var u=document.getElementById('scanUom'); u.innerHTML='';
    (d.units||[]).forEach(function(x){var o=document.createElement('option');o.value=x.id;o.setAttribute('data-factor',x.factor);o.textContent=x.name+(x.baseUnit?' ('+L.base+')':'');if(d.matchedUomId&&x.id===d.matchedUomId)o.selected=true;u.appendChild(o);});
    document.getElementById('scanQty').value=1;
    M().show();
  }
  function notFound(bc){ cur=null; document.getElementById('scanCard').classList.add('d-none'); var nf=document.getElementById('scanNotFound'); nf.classList.remove('d-none'); M().show(); }
  function lookup(bc){
    fetch(url+'?barcode='+encodeURIComponent(bc), {headers:{'X-Requested-With':'XMLHttpRequest'}})
      .then(function(r){return r.json();})
      .then(function(d){ if(d&&d.ok) show(d); else notFound(bc); })
      .catch(function(){});
  }
  // attach to any scan input on the page
  document.addEventListener('keydown', function(e){
    var t=e.target;
    if(t && t.classList && t.classList.contains('js-barcode-scan') && e.key==='Enter'){
      e.preventDefault(); var v=(t.value||'').trim(); if(v){ lookup(v); t.value=''; }
    }
  });
  document.getElementById('scanOk').addEventListener('click', function(){
    if(!cur) return;
    var u=document.getElementById('scanUom'); var uomId=u.value?parseInt(u.value):null; var opt=u.options[u.selectedIndex];
    var uomName=opt?opt.textContent:''; var factor=opt?(parseFloat(opt.getAttribute('data-factor'))||1):1;
    var payload={ id:cur.id, code:cur.code, name:cur.name, nameEn:cur.nameEn, uomId:uomId, uomName:uomName, factor:factor, qty:parseFloat(document.getElementById('scanQty').value)||1, salesPrice:cur.salesPrice, cost:cur.cost, image:cur.image, isComposite:cur.isComposite };
    if(typeof window.onItemScanned==='function') window.onItemScanned(payload);
    M().hide();
  });
})();
</script>
<!--end::Item scan popup-->
