@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    int? fWh = ViewBag.FilterWarehouseId;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Stock on-hand"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Balances"]</li></ul></div>
        <a href="@Url.Action("StockMovements","Inventory")" class="btn btn-light"><i class="ki-outline ki-arrow-left fs-2"></i>@Localizer["Movements"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Advanced search-->
        <div class="card card-flush mb-5"><div class="card-body py-5">
            <div class="row g-4 align-items-end">
                <div class="col-md-5"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@Localizer["Multi-search (code / name / barcode)"]</label>
                    <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@Localizer["Add search terms…"]" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Warehouse"]</label>
                    <select id="f_wh" class="form-select form-select-solid" data-control="select2" data-placeholder="@Localizer["All warehouses"]"><option value="">@Localizer["All warehouses"]</option>@foreach (var w in whs) { <option value="@w.ID" selected="@(fWh==w.ID)">@w.Code — @(isAr ? w.Name : w.NameEn)</option> }</select></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Filter"]</label>
                    <div class="form-check form-switch form-check-custom form-check-solid mt-2"><input class="form-check-input" type="checkbox" id="f_instock" /><label class="form-check-label fs-7 ms-2" for="f_instock">@Localizer["With stock only"]</label></div></div>
                <div class="col-md-1"><button type="button" id="f_reset" class="btn btn-light w-100" title="@SR["Reset"]"><i class="ki-outline ki-arrows-circle fs-3"></i></button></div>
            </div>
        </div></div>
        <!--end::Advanced search-->

        <div class="card card-flush">
            <div class="card-header align-items-center py-4">
                <div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
                <div class="card-toolbar d-flex align-items-center gap-3 flex-wrap">
                    <span class="fs-6 fw-bold text-gray-600">@Localizer["Total value:"] <span class="text-gray-900" id="grandValue">—</span></span>
                    <button type="button" id="f_export" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-file-down fs-4"></i>@Localizer["Export Excel"]</button>
                    <select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                </div>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4" id="t">
                    <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                        <th class="min-w-200px">@SR["Item"]</th>
                        <th class="min-w-120px">@SR["Warehouse"]</th>
                        <th class="text-end min-w-90px">@Localizer["On hand"]</th>
                        <th class="text-end min-w-90px">@Localizer["Avg cost"]</th>
                        <th class="text-end min-w-100px">@Localizer["Value"]</th>
                        <th class="text-end min-w-70px">@Localizer["Ledger"]</th>
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-700" id="balBody"></tbody>
                </table>
                </div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Loading…"]</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@Localizer["No matching balances"]</div>
                <div class="d-flex flex-stack flex-wrap pt-5">
                    <div class="fs-7 text-muted" id="pageInfo"></div>
                    <ul class="pagination" id="pager"></ul>
                </div>
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
<script>
(function(){
  var body = document.getElementById('balBody');
  var loading = document.getElementById('loadingRow'), empty = document.getElementById('emptyRow');
  var pager = document.getElementById('pager'), pageInfo = document.getElementById('pageInfo'), resultCount = document.getElementById('resultCount'), grandValue = document.getElementById('grandValue');
  var q = document.getElementById('f_q'), wh = document.getElementById('f_wh'), instock = document.getElementById('f_instock'), size = document.getElementById('f_size');
  var page = 1, pages = 1, total = 0, timer = null;
  var url = '@Url.Action("StockBalancesData","Inventory")';
  var isAr = @(isAr ? "true" : "false");
  var search = cbTagify(q, { suggestUrl: '@Url.Action("ItemsSuggest","Inventory")', onChange: function(){ reload(); } });

  function params(){
    var p = new URLSearchParams();
    var terms = search.terms(); if (terms) p.set('q', terms);
    if (wh.value) p.set('warehouseId', wh.value);
    if (instock.checked) p.set('onlyInStock', 'true');
    p.set('page', page); p.set('pageSize', size.value || '25');
    return p.toString();
  }
  function load(){
    loading.classList.remove('d-none'); empty.classList.add('d-none'); body.innerHTML = '';
    fetch(url + '?' + params(), { headers: { 'X-Requested-With': 'fetch' } })
      .then(function(r){ total = parseInt(r.headers.get('X-Total')||'0'); page = parseInt(r.headers.get('X-Page')||'1'); pages = parseInt(r.headers.get('X-Pages')||'1');
        var gv = parseFloat(r.headers.get('X-GrandValue')||'0'); grandValue.textContent = gv.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); return r.text(); })
      .then(function(html){
        loading.classList.add('d-none');
        body.innerHTML = html;
        empty.classList.toggle('d-none', total !== 0);
        resultCount.textContent = '@(Localizer["{0} results"].Value)'.replace('{0}', total.toLocaleString());
        renderPager();
      })
      .catch(function(){ loading.classList.add('d-none'); empty.classList.remove('d-none'); });
  }
  function pageInfoText(){
    if (total === 0) { pageInfo.textContent=''; return; }
    var ps = parseInt(size.value||'25'); var from = (page-1)*ps + 1; var to = Math.min(page*ps, total);
    pageInfo.textContent = from + '–' + to + ' ' + '@Localizer["of"]' + ' ' + total.toLocaleString();
  }
  function btn(label, p, disabled, active){
    var li = document.createElement('li'); li.className = 'page-item' + (disabled?' disabled':'') + (active?' active':'');
    var a = document.createElement('a'); a.className='page-link'; a.href='#'; a.innerHTML=label;
    if (!disabled && !active) a.addEventListener('click', function(e){ e.preventDefault(); page=p; load(); window.scrollTo({top:0,behavior:'smooth'}); });
    li.appendChild(a); return li;
  }
  function renderPager(){
    pageInfoText(); pager.innerHTML='';
    if (pages <= 1) return;
    pager.appendChild(btn('<i class="ki-outline ki-' + (isAr?'right':'left') + '"></i>', page-1, page<=1, false));
    var start = Math.max(1, page-2), end = Math.min(pages, start+4); start = Math.max(1, end-4);
    if (start > 1) { pager.appendChild(btn('1', 1, false, page===1)); if (start>2) pager.appendChild(btn('…', 0, true, false)); }
    for (var i=start; i<=end; i++) pager.appendChild(btn(String(i), i, false, i===page));
    if (end < pages) { if (end<pages-1) pager.appendChild(btn('…', 0, true, false)); pager.appendChild(btn(String(pages), pages, false, page===pages)); }
    pager.appendChild(btn('<i class="ki-outline ki-' + (isAr?'left':'right') + '"></i>', page+1, page>=pages, false));
  }
  function reload(){ page=1; load(); }
  function debounced(){ clearTimeout(timer); timer=setTimeout(reload, 300); }

  if (window.jQuery && jQuery(wh).data('select2')) jQuery(wh).on('change', reload); else wh.addEventListener('change', reload);
  instock.addEventListener('change', reload);
  if (window.jQuery && jQuery(size).data('select2')) jQuery(size).on('change', reload); else size.addEventListener('change', reload);
  document.getElementById('f_reset').addEventListener('click', function(){
    search.clear(); instock.checked=false; wh.value=''; if(window.jQuery&&jQuery(wh).data('select2')) jQuery(wh).val('').trigger('change.select2'); reload();
  });
  document.getElementById('f_export').addEventListener('click', function(){
    var p = new URLSearchParams(); var t = search.terms(); if (t) p.set('q', t);
    if (wh.value) p.set('warehouseId', wh.value); if (instock.checked) p.set('onlyInStock', 'true');
    window.location = '@Url.Action("StockBalancesExport","Inventory")?' + p.toString();
  });
  load();
})();
</script>
}
