@using CrossBuy.Models.Context.Inventory
@model List<StockCount>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var whs = (ViewBag.Warehouses as List<Warehouse> ?? new()).ToDictionary(w => w.ID, w => w);
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Stock counts"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Counts"]</li></ul></div>
        <a href="@Url.Action("NewCount","Inventory")" class="btn btn-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New count"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header align-items-center py-5"><div class="card-title"><div class="d-flex align-items-center position-relative my-1"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" id="s" class="form-control form-control-solid w-250px ps-12" placeholder="@SR["Search"]" autocomplete="off" /></div></div></div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4" id="t">
                    <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                        <th class="min-w-120px">@Localizer["Count No."]</th><th>@SR["Date"]</th><th>@SR["Warehouse"]</th>
                        <th class="text-end">@Localizer["Net adjustment"]</th><th class="text-center">@SR["Status"]</th><th class="text-end">@SR["View"]</th>
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var t in Model)
                    {
                        <tr data-s="@t.CountNo @(whs.TryGetValue(t.WarehouseId, out var w0) ? w0.Code : "")">
                            <td class="fw-bold text-gray-900">@t.CountNo</td>
                            <td class="text-muted">@t.CountDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-muted">@(whs.TryGetValue(t.WarehouseId, out var w) ? w.Code : "—")</td>
                            <td class="text-end fw-bold @(t.TotalAdjValue<0?"text-danger":(t.TotalAdjValue>0?"text-primary":"text-gray-800"))">@t.TotalAdjValue.ToString("N2")</td>
                            <td class="text-center"><span class="badge badge-light-primary">@Localizer["Posted"]</span></td>
                            <td class="text-end"><a href="@Url.Action("CountDetails", new { id = t.ID })" class="btn btn-icon btn-light-primary btn-sm" title="@SR["View"]"><i class="ki-outline ki-eye fs-6"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
                @if (Model.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No counts"]</div> }
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>(function(){var s=document.getElementById('s'),rows=[].slice.call(document.querySelectorAll('#t tbody tr'));if(s)s.addEventListener('input',function(){var q=(s.value||'').trim().toLowerCase();rows.forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});})();</script>
}
