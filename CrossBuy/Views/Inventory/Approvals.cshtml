@using CrossBuy.Models.Context.Inventory
@model List<InventoryApproval>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@inject CrossBuy.BL.Communication.ICommActorDirectory Actors
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    int myEmp = ViewBag.MyEmpId ?? 0;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    // ---------------------------------------------------------------------------------------------
    // EVERY PERSON ON THIS PAGE IS SHOWN WITH THEIR PICTURE.
    //
    // ONE query for the whole page. ICommActorDirectory's own contract is "collect the ids first,
    // resolve them once" - an 80-row inbox names up to 160 people, and a lookup per cell would be
    // 160 round trips. It returns the name in both languages AND the photo path, which is why it
    // replaces the name-only dictionary the action used to hand over.
    //
    // NOTE for the next build: InventoryController.Approvals still builds ViewBag.EmpNames, which
    // nothing reads any more. It is a wasted query, not a bug - drop it from the action.
    // ---------------------------------------------------------------------------------------------
    var actors = await Actors.ResolveAsync(
        Model.Select(a => a.RequestedByEmployeeId).Concat(Model.Select(a => a.DecidedByEmployeeId)));

    // A photo path is only usable once it is ROOTED. Url.Content("~" + path) throws
    // ArgumentException on anything that does not start with '/', and the one time that reached the
    // shared layout it took EVERY shell-rendered screen to HTTP 500 for the affected employee - see
    // the note in Controllers/Api/UatSeedController.cs. So the path is rooted before it is used,
    // and anything without a '.' is not a file name at all (a placeholder like "-") and counts as
    // no photo rather than as a broken image.
    string? photoUrl(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var s = raw.Replace("\\", "/").Trim();
        if (!s.Contains('.')) return null;
        if (!s.StartsWith("/")) s = "/" + s;
        return Url.Content("~" + s);
    }

    // Initials when there is no photo, so the row still carries a face-shaped marker and stays
    // scannable by person. A grey blank silhouette makes every unphotographed row look identical,
    // which defeats the reason for putting a picture there.
    string initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, 1);
        return parts[0].Substring(0, 1) + parts[1].Substring(0, 1);
    }

    // The person chip: picture (or initials) then the name. Built with HtmlContentBuilder because
    // Append() encodes and AppendHtml() does not - a name goes through Append, never through string
    // concatenation into markup.
    Microsoft.AspNetCore.Html.IHtmlContent person(int? id, bool alignEnd = false)
    {
        var b = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        if (id == null || id <= 0) { b.AppendHtml("<span class=\"text-gray-400\">&mdash;</span>"); return b; }

        var actor = Actors.Get(actors, id);
        var name = actor.Display(isAr);
        var url = photoUrl(actor.AvatarUrl);

        b.AppendHtml("<span class=\"d-flex align-items-center gap-2" + (alignEnd ? " justify-content-end" : "") + "\">");
        b.AppendHtml("<span class=\"symbol symbol-25px symbol-circle flex-shrink-0\">");
        if (url != null)
        {
            b.AppendHtml("<img src=\"");
            b.Append(url);
            b.AppendHtml("\" alt=\"\" />");
        }
        else
        {
            b.AppendHtml("<span class=\"symbol-label bg-light-primary text-primary fw-bold fs-8\">");
            b.Append(initials(name));
            b.AppendHtml("</span>");
        }
        b.AppendHtml("</span><span class=\"text-gray-800 fw-semibold text-truncate\">");
        b.Append(name);
        b.AppendHtml("</span></span>");
        return b;
    }
    string docName(string d) => d switch { "PurchaseOrder" => Localizer["Purchase order"].Value, "StockTransfer" => Localizer["Inter-branch transfer"].Value, "StockCount" => Localizer["Stock count"].Value, _ => d };
    // brand-safe status styling (green approved / red rejected / amber-caution pending — no mint/yellow)
    string stStyle(string s) => s switch { "Approved" => "background:#E7F0FF;color:#0E4A9E;", "Rejected" => "background:#fdeaea;color:#d92d20;", _ => "background:#fef3e2;color:#b96a00;" };
    string stName(string s) => s switch { "Approved" => Localizer["Approved"].Value, "Rejected" => Localizer["Rejected"].Value, _ => Localizer["Pending"].Value };
    var pending = Model.Count(a => a.Status == "Pending");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Inventory approvals"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Approvals"]</li></ul></div>
        @if (pending > 0) { <span class="badge fs-7 py-2 px-3 fw-bold" style="background:#fef3e2;color:#b96a00;">@pending @Localizer["pending"]</span> }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-body pt-6">
                <div class="table-responsive">
                <table class="table align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                    @* cb-thead-rule instead of a literal #0E4A9E - the same rule read from the token layer. *@
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0 cb-thead-rule">
                        <th class="ps-4">@Localizer["Document"]</th><th class="text-end">@SR["Amount"]</th><th>@Localizer["Requested by"]</th><th>@SR["Date"]</th><th class="text-center">@SR["Status"]</th><th class="text-end min-w-200px pe-4">@Localizer["Action"]</th>
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var a in Model)
                    {
                        <tr style="border-bottom:1px dashed #eef1f6;">
                            <td class="ps-4"><span class="fw-bold text-gray-900">@docName(a.DocType)</span>@if (a.ResultDocNo != null) { <span class="text-muted fs-7"> · @a.ResultDocNo</span> }</td>
                            <td class="text-end fw-bold text-gray-800">@a.Amount.ToString("N2")</td>
                            <td>@person(a.RequestedByEmployeeId)</td>
                            <td class="text-muted">@(a.RequestedAt?.ToString("yyyy-MM-dd HH:mm"))</td>
                            <td class="text-center"><span class="badge fw-bold" style="@stStyle(a.Status)">@stName(a.Status)</span></td>
                            <td class="text-end pe-4">
                                @if (a.Status == "Pending")
                                {
                                    if (a.RequestedByEmployeeId == myEmp)
                                    {
                                        <span class="text-muted fs-7">@Localizer["Can't approve your own (SoD)"]</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2 justify-content-end">
                                            <form asp-action="ApproveDoc" method="post" data-cb-confirm data-cb-action="approve" data-cb-text="@Localizer["Approve & execute this document?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.ID" /><button class="btn btn-sm btn-light-primary"><i class="ki-outline ki-check fs-4"></i>@SR["Approve"]</button></form>
                                            <form asp-action="RejectDoc" method="post" data-cb-confirm data-cb-action="reject" data-cb-text="@Localizer["Reject this document?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.ID" /><button class="btn btn-sm btn-light-danger"><i class="ki-outline ki-cross fs-4"></i>@SR["Reject"]</button></form>
                                        </div>
                                    }
                                }
                                else
                                {
                                    @* The decision and the person who made it, with their picture. The word
                                       stays: this column is headed "Action", so it has to say what was done
                                       and not only who did it. *@
                                    <span class="d-flex align-items-center gap-2 justify-content-end">
                                        <span class="text-muted fs-7 flex-shrink-0">@stName(a.Status)</span>
                                        <span class="text-gray-400">·</span>
                                        @person(a.DecidedByEmployeeId, alignEnd: true)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10">@Localizer["No approval requests"]</td></tr> }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div></div>
</div>
