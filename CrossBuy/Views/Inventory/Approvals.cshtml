@using CrossBuy.Models.Context.Inventory
@model List<InventoryApproval>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var names = ViewBag.EmpNames as Dictionary<int, string> ?? new();
    int myEmp = ViewBag.MyEmpId ?? 0;
    string emp(int? id) => id != null && names.TryGetValue(id.Value, out var n) ? n : (id != null ? "#" + id : "—");
    string docName(string d) => d switch { "PurchaseOrder" => Localizer["Purchase order"].Value, "StockTransfer" => Localizer["Inter-branch transfer"].Value, "StockCount" => Localizer["Stock count"].Value, _ => d };
    // brand-safe status styling (green approved / red rejected / amber-caution pending — no mint/yellow)
    string stStyle(string s) => s switch { "Approved" => "background:#E7F0FF;color:#0E4A9E;", "Rejected" => "background:#fdeaea;color:#d92d20;", _ => "background:#fef3e2;color:#b96a00;" };
    string stName(string s) => s switch { "Approved" => Localizer["Approved"].Value, "Rejected" => Localizer["Rejected"].Value, _ => Localizer["Pending"].Value };
    var pending = Model.Count(a => a.Status == "Pending");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Inventory approvals"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Approvals"]</li></ul></div>
        @if (pending > 0) { <span class="badge fs-7 py-2 px-3 fw-bold" style="background:#fef3e2;color:#b96a00;">@pending @Localizer["pending"]</span> }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-body pt-6">
                <div class="table-responsive">
                <table class="table align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                        <th class="ps-4">@Localizer["Document"]</th><th class="text-end">@SR["Amount"]</th><th>@Localizer["Requested by"]</th><th>@SR["Date"]</th><th class="text-center">@SR["Status"]</th><th class="text-end min-w-200px pe-4">@Localizer["Action"]</th>
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var a in Model)
                    {
                        <tr style="border-bottom:1px dashed #eef1f6;">
                            <td class="ps-4"><span class="fw-bold text-gray-900">@docName(a.DocType)</span>@if (a.ResultDocNo != null) { <span class="text-muted fs-7"> · @a.ResultDocNo</span> }</td>
                            <td class="text-end fw-bold text-gray-800">@a.Amount.ToString("N2")</td>
                            <td class="text-muted">@emp(a.RequestedByEmployeeId)</td>
                            <td class="text-muted">@(a.RequestedAt?.ToString("yyyy-MM-dd HH:mm"))</td>
                            <td class="text-center"><span class="badge fw-bold" style="@stStyle(a.Status)">@stName(a.Status)</span></td>
                            <td class="text-end pe-4">
                                @if (a.Status == "Pending")
                                {
                                    if (a.RequestedByEmployeeId == myEmp)
                                    {
                                        <span class="text-muted fs-7">@Localizer["Can't approve your own (SoD)"]</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2 justify-content-end">
                                            <form asp-action="ApproveDoc" method="post" data-cb-confirm data-cb-action="approve" data-cb-text="@Localizer["Approve & execute this document?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.ID" /><button class="btn btn-sm btn-light-primary"><i class="ki-outline ki-check fs-4"></i>@SR["Approve"]</button></form>
                                            <form asp-action="RejectDoc" method="post" data-cb-confirm data-cb-action="reject" data-cb-text="@Localizer["Reject this document?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.ID" /><button class="btn btn-sm btn-light-danger"><i class="ki-outline ki-cross fs-4"></i>@SR["Reject"]</button></form>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fs-7">@stName(a.Status) · @emp(a.DecidedByEmployeeId)</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10">@Localizer["No approval requests"]</td></tr> }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div></div>
</div>
