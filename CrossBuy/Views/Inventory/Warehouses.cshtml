@using CrossBuy.Models.Context.Inventory
@using CrossBuy.Models.Context.Admin
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<Warehouse>
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var branches = ViewBag.Branches as List<Hierarchical> ?? new();
    var emps = ViewBag.Employees as List<Employee> ?? new();
    var types = new (string v, string en)[] {
        ("Main","Main"),("Transit","Transit"),("Quarantine","Quarantine"),
        ("Scrap","Scrap"),("Consignment","Consignment"),("Virtual","Virtual") };
    string TypeName(string v) => types.FirstOrDefault(t => t.v == v) is var t && t.v != null ? t.en : v;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Warehouses"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Warehouses"]</li></ul></div>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#mNew"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New warehouse"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><div class="d-flex align-items-center position-relative my-1"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search..."]" autocomplete="off" /></div></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table table-row-bordered align-middle gy-3">
                <thead><tr class="fw-bold fs-7 text-uppercase text-muted"><th>@SR["Code"]</th><th>@SR["Warehouse"]</th><th class="text-center">@SR["Type"]</th><th>@SR["Branch"]</th><th class="text-center">@SR["Status"]</th><th class="text-center">@SR["Edit"]</th></tr></thead>
                <tbody>
                @foreach (var w in Model) {
                    var br = branches.FirstOrDefault(b => b.H_ID == w.BranchHierarchicalId);
                    <tr data-s="@w.Code @w.Name @w.NameEn"
                        data-id="@w.ID" data-code="@w.Code" data-name="@w.Name" data-nameen="@w.NameEn" data-type="@w.WarehouseType"
                        data-branch="@w.BranchHierarchicalId" data-keeper="@w.KeeperEmployeeId" data-neg="@(w.AllowNegativeStock?"true":"false")" data-active="@(w.IsActive?"true":"false")">
                        <td class="fw-bold text-gray-800">@w.Code</td>
                        <td class="fw-semibold">@(isAr ? w.Name : (string.IsNullOrEmpty(w.NameEn) ? w.Name : w.NameEn))</td>
                        <td class="text-center"><span class="badge badge-light-primary">@Localizer[TypeName(w.WarehouseType)]</span></td>
                        <td class="text-muted">@(br == null ? "—" : (isAr ? br.H_Name : (br.H_NameEn ?? br.H_Name)))</td>
                        <td class="text-center"><span class="badge badge-light-@(w.IsActive?"success":"secondary")">@(w.IsActive?SR["Active"]:SR["Inactive"])</span></td>
                        <td class="text-center"><button type="button" class="btn btn-icon btn-light-primary btn-sm wh-edit" title="@SR["Edit"]"><i class="ki-outline ki-pencil fs-6"></i></button></td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10">@Localizer["No warehouses"]</td></tr> }
                </tbody>
            </table></div></div>
        </div>
    </div></div>
</div>

@functions {
    string Opts(List<Hierarchical> bs, bool ar) => string.Join("", bs.Select(b => $"<option value=\"{b.H_ID}\">{(ar ? b.H_Name : (b.H_NameEn ?? b.H_Name))}</option>"));
}

@* New + Edit share the same field set *@
@foreach (var mode in new[] { "New", "Edit" })
{
    var isEdit = mode == "Edit";
    var whAction = isEdit ? "EditWarehouse" : "CreateWarehouse";
    string? cbConfirm = isEdit ? "" : null;
    <div class="modal fade" id="m@(mode)" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form asp-action="@whAction" method="post" data-cb-confirm="@cbConfirm" data-cb-action="edit" data-cb-text="@Localizer["Save changes?"]">@Html.AntiForgeryToken()
            @if (isEdit) { <input type="hidden" name="id" id="e_id" /> }
            <div class="modal-header"><h2 class="fw-bold">@(isEdit ? Localizer["Edit warehouse"] : Localizer["New warehouse"])</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
            <div class="modal-body py-6 px-8">
                <div class="row"><div class="col-6 mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Code"]</label><input name="Code" id="@(isEdit?"e_":"")code" class="form-control form-control-solid" required /></div>
                <div class="col-6 mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Type"]</label><select name="WarehouseType" id="@(isEdit?"e_":"")type" class="form-select form-select-solid">@foreach (var t in types) { <option value="@t.v">@Localizer[t.en]</option> }</select></div></div>
                <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Name (AR)"]</label><input name="Name" id="@(isEdit?"e_":"")name" class="form-control form-control-solid" required /></div>
                <div class="mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Name (EN)"]</label><input name="NameEn" id="@(isEdit?"e_":"")nameen" class="form-control form-control-solid" /></div>
                <div class="row"><div class="col-6 mb-4"><label class="fw-semibold fs-6 mb-2">@SR["Branch"]</label><select name="BranchHierarchicalId" id="@(isEdit?"e_":"")branch" class="form-select form-select-solid"><option value="">—</option>@Html.Raw(Opts(branches, isAr))</select></div>
                <div class="col-6 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Keeper"]</label><select name="KeeperEmployeeId" id="@(isEdit?"e_":"")keeper" class="form-select form-select-solid"><option value="">—</option>@foreach (var e in emps) { <option value="@e.ID">@(isAr ? e.FullName : (string.IsNullOrEmpty(e.FullNameEn) ? e.FullName : e.FullNameEn))</option> }</select></div></div>
                <div class="d-flex gap-8">
                    <label class="form-check form-check-custom"><input type="checkbox" name="AllowNegativeStock" id="@(isEdit?"e_":"")neg" value="true" class="form-check-input" /><span class="form-check-label fw-semibold ms-2">@Localizer["Allow negative stock"]</span></label>
                    @if (isEdit) { <label class="form-check form-check-custom"><input type="checkbox" name="IsActive" id="e_active" value="true" class="form-check-input" /><span class="form-check-label fw-semibold ms-2">@SR["Active"]</span></label> }
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@SR["Save"]</button></div>
        </form>
    </div></div></div>
}

@section Scripts {
<script>
(function(){
  document.querySelectorAll('.wh-edit').forEach(function(btn){
    btn.addEventListener('click', function(){
      var r = btn.closest('tr');
      var g = function(k){ return r.getAttribute('data-'+k) || ''; };
      document.getElementById('e_id').value = g('id');
      document.getElementById('e_code').value = g('code');
      document.getElementById('e_name').value = g('name');
      document.getElementById('e_nameen').value = g('nameen');
      var setSel = function(id,val){ var el=document.getElementById(id); if(!el) return; el.value=val; if(window.jQuery && jQuery(el).data('select2')) jQuery(el).val(val).trigger('change'); };
      setSel('e_type', g('type'));
      setSel('e_branch', g('branch'));
      setSel('e_keeper', g('keeper'));
      document.getElementById('e_neg').checked = g('neg')==='true';
      document.getElementById('e_active').checked = g('active')==='true';
      new bootstrap.Modal(document.getElementById('mEdit')).show();
    });
  });
})();
</script>
}
