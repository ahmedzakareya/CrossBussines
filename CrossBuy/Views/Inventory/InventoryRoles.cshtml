@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var employees = ViewBag.Employees as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var branches = ViewBag.Branches as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var assignments = ViewBag.Assignments as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var roles = new (string v, string ar, string en)[] {
        ("InventoryManager","مدير المخزون","Inventory Manager"),
        ("WarehouseKeeper","أمين مخزن","Warehouse Keeper"),
        ("PurchasingOfficer","مسؤول مشتريات","Purchasing Officer"),
        ("InventoryAuditor","مراجع مخزون (قراءة)","Inventory Auditor (read)"),
    };
    string roleName(string r) => roles.FirstOrDefault(x => x.v == r) is var m && m.v != null ? (isAr ? m.ar : m.en) : r;
    // brand-safe per-role badge styling (green family + grays; no blue/mint/yellow)
    string roleStyle(string r) => r switch {
        "InventoryManager"  => "background:#E7F0FF;color:#0E4A9E;",
        "WarehouseKeeper"   => "background:#E7F0FF;color:#145DBF;",
        "PurchasingOfficer" => "background:#f2f4f7;color:#475467;",
        _                    => "background:#eef2f7;color:#3f4254;" };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Inventory roles"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Roles"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row">
            <div class="col-lg-5">
                <div class="card card-flush mb-5">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Assign role"]</h2></div></div>
                    <div class="card-body pt-2">
                        <form asp-action="AssignRole" method="post">@Html.AntiForgeryToken()
                            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Employee"]</label>
                                <select name="employeeId" class="form-select form-select-solid" data-control="select2" required><option value="">@Localizer["Select"]</option>@foreach (var e in employees) { <option value="@e.ID">@CrossBuy.BL.EmployeeNames.Of(e.FullName, e.FullNameEn)</option> }</select></div>
                            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Role"]</label>
                                <select name="role" id="roleSel" class="form-select form-select-solid" data-control="select2" data-hide-search="true" required>@foreach (var r in roles) { <option value="@r.v">@(isAr ? r.ar : r.en)</option> }</select></div>
                            <div class="mb-4" id="scopeWrap"><label class="fw-semibold fs-6 mb-2">@Localizer["Branch scope (keeper)"]</label>
                                <select name="scopeBranchId" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["All branches"]</option>@foreach (var b in branches) { <option value="@b.H_ID">@b.H_Name</option> }</select></div>
                            <button type="submit" class="btn btn-primary w-100"><i class="ki-outline ki-plus fs-3"></i>@Localizer["Assign"]</button>
                        </form>
                    </div>
                </div>
                <div class="card card-flush"><div class="card-body py-5">
                    <div class="text-gray-700 fw-semibold fs-7">
                        <div class="mb-2"><span class="badge me-2" style="@roleStyle("InventoryManager")">@Localizer["Manager"]</span>@Localizer["Full access incl. settings & roles."]</div>
                        <div class="mb-2"><span class="badge me-2" style="@roleStyle("WarehouseKeeper")">@Localizer["Keeper"]</span>@Localizer["Documents for his branch warehouses only."]</div>
                        <div class="mb-2"><span class="badge me-2" style="@roleStyle("PurchasingOfficer")">@Localizer["Purchasing"]</span>@Localizer["Purchase orders & receipts."]</div>
                        <div><span class="badge me-2" style="@roleStyle("InventoryAuditor")">@Localizer["Auditor"]</span>@Localizer["Read-only."]</div>
                    </div>
                </div></div>
            </div>
            <div class="col-lg-7">
                <div class="card card-flush">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Assigned roles"]</h2></div></div>
                    <div class="card-body pt-2">
                        <div class="table-responsive">
                        <table class="table align-middle gy-3 mb-0">
                            <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@SR["Employee"]</th><th>@Localizer["Role"]</th><th>@SR["Branch"]</th><th class="text-end pe-4"></th></tr></thead>
                            <tbody class="fw-semibold text-gray-700">
                            @foreach (var a in assignments)
                            {
                                <tr style="border-bottom:1px dashed #eef1f6;">
                                    <td class="ps-4 fw-bold text-gray-900">@a.EmployeeName</td>
                                    <td><span class="badge fw-bold" style="@roleStyle((string)a.Role)">@roleName((string)a.Role)</span></td>
                                    <td class="text-muted">@(a.Branch ?? "—")</td>
                                    <td class="text-end pe-4"><form asp-action="RemoveRole" method="post" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Remove role?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.ID" /><button class="btn btn-icon btn-light-danger btn-sm" title="@SR["Delete"]"><i class="ki-outline ki-trash fs-6"></i></button></form></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        </div>
                        @if (!assignments.Any()) { <div class="text-center text-muted py-10">@Localizer["No roles assigned — system is open until the first role is set."]</div> }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
(function(){var r=document.getElementById('roleSel'),w=document.getElementById('scopeWrap');
 function tog(){var keeper=r.value==='WarehouseKeeper';w.style.display=keeper?'':'none';}
 if(r){tog();r.addEventListener('change',tog);if(window.jQuery)jQuery(r).on('change',tog);}})();
</script>
}
