@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model PriceList
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var lineItems = ViewBag.LineItems as Dictionary<int, string> ?? new();
    var initial = Model.Lines.Select(l => new {
        itemId = l.ItemId,
        itemText = lineItems.TryGetValue(l.ItemId, out var nm) ? nm : ("#" + l.ItemId),
        minQty = l.MinQty,
        unitPrice = l.UnitPrice,
        discountPercent = l.DiscountPercent,
        pricingMode = l.PricingMode,
        markupPercent = l.MarkupPercent,
        validFrom = l.ValidFrom?.ToString("yyyy-MM-dd"),
        validTo = l.ValidTo?.ToString("yyyy-MM-dd")
    }).ToList();
    var initialJson = System.Text.Json.JsonSerializer.Serialize(initial);
    var isEdit = Model.ID > 0;
    var currencies = ViewBag.Currencies as List<CrossBuy.Models.Context.Accounting.Currency> ?? new();
    int funcCur = (int)(ViewBag.FunctionalCurrencyId ?? 0);
    var customerName = ViewBag.CustomerName as string;
    var selCur = Model.CurrencyId ?? funcCur;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isEdit ? Localizer["Edit price list"] : Localizer["New price list"])</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("PriceLists","Inventory")" class="text-muted text-hover-primary">@Localizer["Price lists"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@(isEdit ? Model.Code : Localizer["New"].Value)</li></ul></div>
        <a href="@Url.Action("PriceLists","Inventory")" class="btn btn-light"><i class="ki-outline ki-arrow-left fs-2"></i>@SR["Back"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <form asp-action="SavePriceList" method="post" id="plForm" data-cb-confirm data-cb-action="edit" data-cb-confirm-if="[name='id']" data-cb-text="@Localizer["Save changes?"]">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ID" />
            <input type="hidden" name="linesJson" id="linesJson" />

            <!--begin::Header-->
            <div class="card mb-5"><div class="card-body py-6"><div class="row g-4">
                <div class="col-md-3"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Code"]</label><input name="code" class="form-control form-control-solid" value="@Model.Code" required /></div>
                <div class="col-md-4"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Name"]</label><input name="name" class="form-control form-control-solid" value="@Model.Name" required /></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Name (EN)"]</label><input name="nameEn" class="form-control form-control-solid" value="@Model.NameEn" /></div>
                <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Priority"]</label><input name="priority" type="number" class="form-control form-control-solid" value="@Model.Priority" /></div>
                <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Currency"]</label>
                    <select name="currencyId" class="form-select form-select-solid">@foreach (var cu in currencies) { <option value="@cu.ID" selected="@(cu.ID == selCur)">@cu.Code</option> }</select></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Specific customer (blank = segment/all)"]</label>
                    <select name="customerId" id="custPick" class="form-select form-select-solid">@if (Model.CustomerId.HasValue) { <option value="@Model.CustomerId" selected>@customerName</option> }</select></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Segment (blank = all)"]</label><input name="segment" class="form-control form-control-solid" value="@Model.Segment" placeholder="VIP / @Localizer["Wholesale"] / @Localizer["Retail"]" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Valid from"]</label><input name="validFrom" type="date" class="form-control form-control-solid" value="@(Model.ValidFrom?.ToString("yyyy-MM-dd"))" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Valid to"]</label><input name="validTo" type="date" class="form-control form-control-solid" value="@(Model.ValidTo?.ToString("yyyy-MM-dd"))" /></div>
                <div class="col-md-3 d-flex align-items-end gap-5">
                    <div class="form-check form-switch"><input type="hidden" name="isDefault" value="false" /><input class="form-check-input" type="checkbox" name="isDefault" value="true" id="isDefault" @(Model.IsDefault ? "checked" : "")><label class="form-check-label fw-semibold ms-2" for="isDefault">@Localizer["Default"]</label></div>
                    <div class="form-check form-switch"><input type="hidden" name="isActive" value="false" /><input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "")><label class="form-check-label fw-semibold ms-2" for="isActive">@SR["Active"]</label></div>
                </div>
            </div></div></div>
            <!--end::Header-->

            <!--begin::Lines-->
            <div class="card mb-5"><div class="card-header"><div class="card-title fw-bold">@Localizer["Pricing rules"]</div></div>
                <div class="card-body">
                    <div class="row g-3 align-items-end mb-2 bg-light-primary rounded p-4">
                        <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Item"]</label><select id="l_item" class="form-select form-select-solid"></select></div>
                        <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Pricing mode"]</label>
                            <select id="l_mode" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                                <option value="Fixed">@Localizer["Fixed price"]</option>
                                <option value="CostPlus">@Localizer["Cost + markup"]</option>
                            </select></div>
                        <div class="col-md-1"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Min qty ≥"]</label><input id="l_minqty" type="number" step="0.01" class="form-control form-control-solid" value="1" /></div>
                        <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1" id="l_price_lbl">@Localizer["Override price"]</label>
                            <input id="l_price" type="number" step="0.01" class="form-control form-control-solid" placeholder="@Localizer["Item price"]" />
                            <input id="l_markup" type="number" step="0.01" class="form-control form-control-solid d-none" placeholder="@Localizer["Markup %"]" value="0" /></div>
                        <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Discount %"]</label><input id="l_disc" type="number" step="0.01" class="form-control form-control-solid" value="0" /></div>
                        <div class="col-md-2"><button type="button" id="l_add" class="btn btn-primary w-100"><i class="ki-outline ki-plus fs-3"></i>@SR["Add"]</button></div>
                    </div>
                    <div class="text-muted fs-8 mb-5 d-none" id="l_cp_hint"><i class="ki-outline ki-information-5 fs-7 me-1"></i>@Localizer["Price is computed from the current cost (manufactured / average stock) × (1 + markup%) and converted to the document currency — a dynamic price that moves with the cost, not a fixed one."]</div>
                    <div class="table-responsive"><table class="table table-row-bordered align-middle gy-2">
                        <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;"><th>@SR["Item"]</th><th>@Localizer["Mode"]</th><th class="text-end">@Localizer["Min qty"]</th><th class="text-end">@Localizer["Price/Markup"]</th><th class="text-end">@Localizer["Disc %"]</th><th class="text-end w-50px"></th></tr></thead>
                        <tbody id="lineRows"></tbody>
                    </table></div>
                    <div id="noLines" class="text-center text-muted py-6 d-none">@Localizer["No rules yet — add an item above"]</div>
                </div>
            </div>
            <!--end::Lines-->

            <div class="d-flex justify-content-end gap-2">
                <a href="@Url.Action("PriceLists","Inventory")" class="btn btn-light">@SR["Cancel"]</a>
                <button type="submit" class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
<script>
(function(){
  var LINES = @Html.Raw(initialJson);
  var pickUrl = '@Url.Action("ItemPickData","Inventory")';
  var tbody = document.getElementById('lineRows'), noLines = document.getElementById('noLines');

  function render(){
    tbody.innerHTML = '';
    noLines.classList.toggle('d-none', LINES.length !== 0);
    LINES.forEach(function(l, idx){
      var tr = document.createElement('tr');
      var cp = l.pricingMode === 'CostPlus';
      var modeBadge = cp ? '<span class="badge badge-light-primary">@Localizer["Cost+markup"]</span>' : '<span class="badge badge-light-secondary">@Localizer["Fixed"]</span>';
      var priceCell = cp ? ('+' + (l.markupPercent || 0) + '%') : (l.unitPrice != null && l.unitPrice !== '' ? l.unitPrice : '—');
      tr.innerHTML =
        '<td class="fw-semibold text-gray-800"></td>' +
        '<td>' + modeBadge + '</td>' +
        '<td class="text-end">' + (l.minQty || 1) + '</td>' +
        '<td class="text-end">' + priceCell + '</td>' +
        '<td class="text-end">' + (l.discountPercent || 0) + '</td>' +
        '<td class="text-end"><button type="button" class="btn btn-sm btn-icon btn-light-danger" data-rm="' + idx + '"><i class="ki-outline ki-trash fs-6"></i></button></td>';
      tr.querySelector('td').textContent = l.itemText || ('#' + l.itemId);
      tbody.appendChild(tr);
    });
  }
  tbody.addEventListener('click', function(e){
    var b = e.target.closest('[data-rm]'); if(!b) return;
    LINES.splice(parseInt(b.getAttribute('data-rm')), 1); render();
  });

  // scalable item picker (server-side search, no full catalog load)
  if (window.jQuery) {
    jQuery('#l_item').select2({
      placeholder: '@Localizer["Search item…"]', allowClear: true, minimumInputLength: 1,
      ajax: { url: pickUrl, dataType: 'json', delay: 250, data: function(p){ return { term: p.term }; }, processResults: function(d){ return { results: d.results }; } }
    });
    // customer picker (server-side) — empty = applies to segment/all
    jQuery('#custPick').select2({
      placeholder: '@Localizer["All customers / by segment"]', allowClear: true, minimumInputLength: 1,
      ajax: { url: '@Url.Action("CustomerPickData","Crm")', dataType: 'json', delay: 250, data: function(p){ return { term: p.term }; }, processResults: function(d){ return { results: d.results }; } }
    });
  }
  // toggle price vs markup + hint when the pricing mode changes
  function syncMode(){
    var cp = jQuery('#l_mode').val() === 'CostPlus';
    document.getElementById('l_price').classList.toggle('d-none', cp);
    document.getElementById('l_markup').classList.toggle('d-none', !cp);
    document.getElementById('l_cp_hint').classList.toggle('d-none', !cp);
    document.getElementById('l_price_lbl').textContent = cp ? '@Localizer["Markup %"]' : '@Localizer["Override price"]';
  }
  if (window.jQuery) jQuery('#l_mode').on('change', syncMode);
  syncMode();

  document.getElementById('l_add').addEventListener('click', function(){
    var sel = jQuery('#l_item');
    var id = parseInt(sel.val() || '0'); if(!id) return;
    var text = sel.select2('data')[0] ? sel.select2('data')[0].text : ('#' + id);
    var mode = jQuery('#l_mode').val() || 'Fixed';
    var minQty = parseFloat(document.getElementById('l_minqty').value || '1') || 1;
    var priceVal = document.getElementById('l_price').value;
    var markup = parseFloat(document.getElementById('l_markup').value || '0') || 0;
    var disc = parseFloat(document.getElementById('l_disc').value || '0') || 0;
    LINES.push({ itemId: id, itemText: text, minQty: minQty,
      unitPrice: mode === 'CostPlus' ? null : (priceVal === '' ? null : parseFloat(priceVal)),
      pricingMode: mode, markupPercent: mode === 'CostPlus' ? markup : 0, discountPercent: disc });
    sel.val(null).trigger('change'); jQuery('#l_mode').val('Fixed').trigger('change');
    document.getElementById('l_minqty').value = '1'; document.getElementById('l_price').value = ''; document.getElementById('l_markup').value = '0'; document.getElementById('l_disc').value = '0';
    render();
  });

  document.getElementById('plForm').addEventListener('submit', function(){
    document.getElementById('linesJson').value = JSON.stringify(LINES.map(function(l){
      return { ItemId: l.itemId, MinQty: l.minQty, UnitPrice: l.unitPrice, DiscountPercent: l.discountPercent, PricingMode: l.pricingMode || 'Fixed', MarkupPercent: l.markupPercent || 0, ValidFrom: l.validFrom || null, ValidTo: l.validTo || null };
    }));
  });

  render();
})();
</script>
}
