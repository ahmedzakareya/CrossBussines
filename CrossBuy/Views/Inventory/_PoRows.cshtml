@using CrossBuy.Controllers
@model List<PoRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    string st(string s) => s switch { "Approved" => "primary", "Received" => "success", "Closed" => "dark", "Cancelled" => "danger", _ => "secondary" };
    string stName(string s) => s switch { "Approved" => Localizer["Approved"].Value, "Received" => Localizer["Received"].Value, "Closed" => Localizer["Closed"].Value, "Cancelled" => Localizer["Cancelled"].Value, _ => SR["Draft"].Value };
}
@foreach (var p in Model)
{
    <tr>
        <td class="fw-bold text-gray-900">@p.OrderNo</td>
        <td class="text-muted">@p.OrderDate.ToString("yyyy-MM-dd")</td>
        <td>@(p.PartyName == null ? "—" : (isAr ? p.PartyName : (p.PartyNameEn ?? p.PartyName)))</td>
        <td class="text-end fw-bold text-gray-800">@p.GrandTotal.ToString("N2")</td>
        <td class="text-center"><span class="badge badge-light-@st(p.Status)">@stName(p.Status)</span></td>
        <td class="text-end">
            <a href="@Url.Action("PurchaseOrderDetails","Inventory", new { id = p.Id })" class="btn btn-sm btn-icon btn-light-primary me-1" title="@Localizer["View details"]"><i class="ki-outline ki-eye fs-5"></i></a>
            <a href="#" class="btn btn-sm btn-light btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">@SR["Actions"]<i class="ki-outline ki-down fs-5 ms-1"></i></a>
            <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-200px py-3" data-kt-menu="true">
                <div class="menu-item px-3"><a href="@Url.Action("PurchaseOrderDetails","Inventory", new { id = p.Id })" class="menu-link px-3"><i class="ki-outline ki-eye fs-6 me-2 text-primary"></i>@Localizer["View details"]</a></div>
                <div class="menu-item px-3"><a href="@Url.Action("PoMatch","Inventory", new { id = p.Id })" class="menu-link px-3"><i class="ki-outline ki-check-square fs-6 me-2 text-primary"></i>@Localizer["3-way match"]</a></div>
                @if (p.Status != "Received" && p.Status != "Closed" && p.Status != "Cancelled")
                {
                    <div class="menu-item px-3"><a href="@Url.Action("NewGoodsReceipt","Inventory", new { poId = p.Id })" class="menu-link px-3"><i class="ki-outline ki-entrance-left fs-6 me-2 text-primary"></i>@Localizer["Receive goods"]</a></div>
                }
                @if (p.Status != "Closed" && p.Status != "Cancelled")
                {
                    <div class="menu-item px-3">
                        <form asp-action="ConvertPoToInvoice" method="post" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["Convert this PO into a purchase invoice?"]">
                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="menu-link px-3 btn btn-link text-start w-100 text-gray-700"><i class="ki-outline ki-bill fs-6 me-2 text-primary"></i>@Localizer["Convert to invoice"]</button>
                        </form>
                    </div>
                }
                @if (p.Status == "Closed")
                {
                    <div class="menu-item px-3"><span class="menu-link px-3 text-muted"><i class="ki-outline ki-check-circle fs-6 me-2 text-primary"></i>@Localizer["Invoiced"]</span></div>
                }
            </div>
        </td>
    </tr>
}
