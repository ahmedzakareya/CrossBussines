@using CrossBuy.Models.Context.Inventory
@model List<Item>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var catById = ViewBag.CatById as Dictionary<int, ItemCategory> ?? new();
    var uById = ViewBag.UById as Dictionary<int, UnitOfMeasure> ?? new();
    var blank = Url.Content("~/Backend-assets/media/svg/files/blank-image.svg");
    string TypeName(string v) => v switch {
        "Stockable" => Localizer["Stockable"].Value,
        "NonStockable" => Localizer["Non-stockable"].Value,
        "Service" => Localizer["Service"].Value,
        "Asset" => Localizer["Asset"].Value,
        _ => v };
}
@foreach (var i in Model)
{
    var imgUrl = !string.IsNullOrWhiteSpace(i.ImagePath) ? Url.Content("~" + i.ImagePath.Replace("\\", "/")) : blank;
    <tr>
        <td>
            <div class="d-flex align-items-center">
                <div class="symbol symbol-50px me-3"><span class="symbol-label bg-light" style="background-image:url('@imgUrl');background-size:contain;background-repeat:no-repeat;background-position:center;"></span></div>
                <div class="d-flex flex-column">
                    <a href="@Url.Action("EditItem","Inventory", new { id = i.ID })" class="text-gray-800 text-hover-primary fw-bold mb-1">@(isAr ? i.Name : (string.IsNullOrEmpty(i.NameEn) ? i.Name : i.NameEn))</a>
                    <span class="text-muted fs-7">@(catById.TryGetValue(i.ItemCategoryId, out var c) ? (isAr ? c.Name : c.NameEn) : "—") · @(uById.TryGetValue(i.BaseUoMId, out var u) ? (isAr ? u.Name : u.NameEn) : "")</span>
                </div>
            </div>
        </td>
        <td class="text-end fw-bold text-gray-700">@i.ItemCode</td>
        <td class="text-end"><span class="badge badge-light-dark">@i.Barcode</span></td>
        <td class="text-end fw-bold text-gray-800">@(i.SalesPrice?.ToString("0.00") ?? "—")</td>
        <td class="text-end"><span class="badge badge-light-primary">@TypeName(i.ItemType)</span>@if (i.IsComposite && i.CompositeType == "Assembly") { <span class="badge badge-light-primary ms-1" title="@Localizer["Manufactured (has a BOM)"]"><i class="ki-outline ki-gear fs-7"></i> @Localizer["MFG"]</span> } else if (i.IsComposite) { <span class="badge badge-light-secondary ms-1" title="@Localizer["Sales bundle"]">@Localizer["Bundle"]</span> }</td>
        <td class="text-end"><span class="badge badge-light-@(i.IsActive?"success":"danger")">@(i.IsActive?SR["Active"]:SR["Inactive"])</span></td>
        <td class="text-end">
            <a href="@Url.Action("EditItem","Inventory", new { id = i.ID })" class="btn btn-sm btn-icon btn-light-primary me-1" title="@Localizer["Open item card"]"><i class="ki-outline ki-eye fs-5"></i></a>
            <a href="@Url.Action("ItemLedger","Inventory", new { itemId = i.ID })" class="btn btn-sm btn-icon btn-light" title="@Localizer["Item ledger"]"><i class="ki-outline ki-book-open fs-5"></i></a>
        </td>
    </tr>
}
