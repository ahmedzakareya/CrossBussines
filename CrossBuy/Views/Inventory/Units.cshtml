@using CrossBuy.Models.Context.Inventory
@model List<UnitOfMeasure>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Units of Measure"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Units"]</li></ul></div>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#mNew"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New unit"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><div class="d-flex align-items-center position-relative my-1"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search..."]" autocomplete="off" /></div></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table table-row-bordered align-middle gy-3">
                <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;"><th>@SR["Code"]</th><th>@SR["Name"]</th><th class="text-center">@SR["Status"]</th></tr></thead>
                <tbody>
                @foreach (var u in Model) {
                    <tr data-s="@u.Code @u.Name @u.NameEn"><td class="fw-bold text-gray-800">@u.Code</td><td>@(isAr ? u.Name : (string.IsNullOrEmpty(u.NameEn) ? u.Name : u.NameEn))</td><td class="text-center"><span class="badge badge-light-@(u.IsActive?"success":"secondary")">@(u.IsActive?SR["Active"]:SR["Inactive"])</span></td></tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-10">@Localizer["No units"]</td></tr> }
                </tbody>
            </table></div></div>
        </div>
    </div></div>
</div>
<div class="modal fade" id="mNew" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="CreateUnit" method="post">@Html.AntiForgeryToken()
        <div class="modal-header"><h2 class="fw-bold">@Localizer["New unit"]</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Code"]</label><input name="code" class="form-control form-control-solid" required /></div>
            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Name (AR)"]</label><input name="name" class="form-control form-control-solid" required /></div>
            <div class="mb-2"><label class="fw-semibold fs-6 mb-2">@Localizer["Name (EN)"]</label><input name="nameEn" class="form-control form-control-solid" /></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@SR["Save"]</button></div>
    </form>
</div></div></div>
