@using CrossBuy.Models.Context.Inventory
@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var checks = ViewBag.Checks as List<IntegrityCheck> ?? new();
    var runs = ViewBag.Runs as List<IntegrityCheckRun> ?? new();
    var allOk = checks.All(c => c.Ok);
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Integrity reconciliation"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Integrity"]</li></ul></div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge fs-6 py-2 px-4 fw-bold d-inline-flex align-items-center gap-2" style="@(allOk ? "background:#eaf3ef;color:#13433a;" : "background:#fdeaea;color:#d92d20;")"><i class="ki-outline @(allOk ? "ki-shield-tick" : "ki-shield-cross") fs-4" style="@(allOk ? "color:#13433a;" : "color:#d92d20;")"></i>@(allOk ? Localizer["Healthy"] : Localizer["Deviations"])</span>
            <button type="button" class="btn btn-light-primary btn-sm d-inline-flex align-items-center gap-1" id="exportBtn"><i class="ki-outline ki-exit-down fs-5"></i>@SR["Export"]</button>
            <form asp-action="RunIntegrity" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1"><i class="ki-outline ki-arrows-circle fs-5"></i>@Localizer["Run now"]</button></form>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="card card-flush">
                    <div class="card-header pt-6"><div class="card-title"><h2 class="fw-bold">@Localizer["System invariants"]</h2></div>
                        <div class="card-toolbar"><span class="text-muted fs-7">@Localizer["Live check now"]</span></div>
                    </div>
                    <div class="card-body pt-2"><div class="table-responsive">
                        <table class="table align-middle gy-3 mb-0" id="t" style="font-variant-numeric:tabular-nums;">
                            <thead><tr class="text-muted fw-bold fs-8 text-uppercase" style="border-bottom:2px solid #13433a;"><th class="ps-4">@Localizer["Check"]</th><th class="text-end">@Localizer["Expected"]</th><th class="text-end">@Localizer["Actual"]</th><th class="text-end">@Localizer["Diff"]</th><th class="text-center">@SR["Status"]</th><th class="pe-4"></th></tr></thead>
                            <tbody class="fw-semibold text-gray-700">
                            @foreach (var c in checks)
                            {
                                <tr class="@(c.Ok ? "" : "bg-light-danger")" style="border-bottom:1px dashed #eef1f6;">
                                    <td class="ps-4 fw-bold text-gray-900">@(isAr ? c.NameAr : (string.IsNullOrEmpty(c.NameEn) ? c.NameAr : c.NameEn))</td>
                                    <td class="text-end">@c.Expected.ToString("N2")</td>
                                    <td class="text-end">@c.Actual.ToString("N2")</td>
                                    <td class="text-end fw-bold @(c.Diff == 0 ? "text-muted" : "text-danger")">@c.Diff.ToString("N2")</td>
                                    <td class="text-center">@if (c.Ok) { <span class="badge badge-light-primary">@Localizer["Match"]</span> } else { <span class="badge badge-light-danger">@Localizer["Diff"]</span> }</td>
                                    <td class="text-end">@if (!string.IsNullOrEmpty(c.Detail)) { <a href="@c.Detail" class="btn btn-icon btn-light-primary btn-sm" title="@Localizer["Source"]"><i class="ki-outline ki-eye fs-6"></i></a> }</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card card-flush">
                    <div class="card-header pt-6"><div class="card-title"><h2 class="fw-bold">@Localizer["Run history"]</h2></div></div>
                    <div class="card-body pt-2">
                        @foreach (var r in runs)
                        {
                            var main = r.AllOk ? "#13433a" : "#d92d20";
                            var soft = r.AllOk ? "#eaf3ef" : "#fdeaea";
                            <div class="d-flex align-items-center justify-content-between py-3" style="border-bottom:1px dashed #eef1f6;">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="symbol symbol-40px"><span class="symbol-label" style="background:@soft;"><i class="ki-outline @(r.AllOk ? "ki-check-circle" : "ki-cross-circle") fs-2" style="color:@main;"></i></span></span>
                                    <div>
                                        <div class="fw-bold fs-6 text-gray-900">@r.RunAt.ToString("yyyy-MM-dd HH:mm")</div>
                                        <div class="fs-8 text-muted d-flex align-items-center gap-1"><i class="ki-outline ki-profile-circle fs-6"></i>@(r.Source == "Scheduled" ? Localizer["Scheduled"] : Localizer["Manual"])</div>
                                    </div>
                                </div>
                                <span class="badge fw-bold d-inline-flex align-items-center gap-2 px-3 py-2" style="background:@soft;color:@main;">
                                    <span style="width:7px;height:7px;border-radius:50%;background:@main;display:inline-block;"></span>@(r.AllOk ? Localizer["OK"].Value : $"{r.FailedCount} " + Localizer["fail"].Value)
                                </span>
                            </div>
                        }
                        @if (runs.Count == 0) { <div class="text-center text-muted py-8">@Localizer["No runs yet"]</div> }
                        <div class="text-muted fs-8 mt-3">@Localizer["A scheduled daily check runs automatically and notifies managers on any deviation."]</div>
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
document.getElementById('exportBtn').addEventListener('click',function(){
  var rows=[['@Localizer["Check"]','@Localizer["Expected"]','@Localizer["Actual"]','@Localizer["Diff"]','@SR["Status"]']];
  [].slice.call(document.querySelectorAll('#t tbody tr')).forEach(function(tr){var c=tr.querySelectorAll('td');rows.push([c[0].innerText.trim(),c[1].innerText.trim(),c[2].innerText.trim(),c[3].innerText.trim(),c[4].innerText.trim()]);});
  var csv=rows.map(function(r){return r.map(function(x){return '"'+(x||'').replace(/"/g,'""')+'"';}).join(',');}).join('\n');
  var blob=new Blob(['﻿'+csv],{type:'text/csv;charset=utf-8;'});var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='integrity.csv';a.click();
});
</script>
}
