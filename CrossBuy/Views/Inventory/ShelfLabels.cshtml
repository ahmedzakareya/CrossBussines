@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var priceLists = ViewBag.PriceLists as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var cards = ViewBag.Cards as IEnumerable<CrossBuy.BL.ShelfLabelCard> ?? Enumerable.Empty<CrossBuy.BL.ShelfLabelCard>();
    int? selected = ViewBag.SelectedList as int?;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@SR["Shelf labels"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@SR["Pricing"]</li></ul></div>
        <div class="d-flex gap-2 no-print">
            <form method="get" class="d-flex gap-2 align-items-center">
                <select name="priceListId" class="form-select form-select-solid" onchange="this.form.submit()" data-hide-search="true">
                    <option value="">@SR["Choose a price list"]</option>
                    @foreach (var p in priceLists) { <option value="@p.ID" selected="@(selected == (int)p.ID)">@p.Name</option> }
                </select>
            </form>
            <button type="button" class="btn btn-primary" onclick="window.print()"><i class="ki-outline ki-printer fs-2"></i>@SR["Print labels"]</button>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="label-sheet">
            @foreach (var card in cards)
            {
                <div class="shelf-card">
                    <div class="sc-name">@card.Name</div>
                    <div class="sc-price">@card.Price <span class="sc-unit">@(card.Weighted ? (SR["KWD"].Value + " / " + card.Unit) : card.Unit)</span></div>
                    @if (card.Weighted && card.ScaleCode != null)
                    {
                        <div class="sc-scale">@SR["Scale code"]: @card.ScaleCode</div>
                    }
                    <div class="sc-barcode">
                        @if (card.BarcodeSvg != null)
                        {
                            @Html.Raw(card.BarcodeSvg)
                        }
                        else
                        {
                            <span class="sc-barcode-text">@card.BarcodeText</span>
                        }
                    </div>
                    <div class="sc-date">@DateTime.Today.ToString("yyyy-MM-dd")</div>
                </div>
            }
            @if (!cards.Any())
            {
                <div class="text-center text-muted py-10 w-100">@SR["Choose a price list"]</div>
            }
        </div>
    </div></div>
</div>
<style>
    .label-sheet { display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; }
    .shelf-card { border:1px solid #d0d0d0; border-radius:4px; padding:10px 12px; background:#fff; break-inside:avoid; text-align:center; }
    .sc-name { font-weight:600; font-size:14px; color:#111; min-height:34px; }
    .sc-price { font-weight:800; font-size:26px; color:#000; margin:4px 0; }
    .sc-unit { font-weight:600; font-size:13px; color:#555; }
    .sc-scale { font-size:12px; color:#333; margin-bottom:4px; }
    .sc-barcode { margin:6px 0; }
    .sc-barcode-text { font-family:monospace; font-size:13px; }
    .sc-date { font-size:10px; color:#999; }
    @@media print {
        .no-print, #kt_app_toolbar, .app-sidebar, .app-header, .app-footer { display:none !important; }
        @@page { size:A4; margin:10mm; }
        .label-sheet { gap:6px; }
        .shelf-card { border:1px solid #000; }
    }
</style>
