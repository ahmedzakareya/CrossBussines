@using CrossBuy.Models.Context.Inventory
@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutManufacturing.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var plan = ViewBag.Plan as ManufPlan;
    var demands = ViewBag.Demands as List<ManufPlanDemand> ?? new();
    var demandNames = ViewBag.DemandItemNames as Dictionary<int, string> ?? new();
    var mrp = ViewBag.Mrp as List<MrpRow> ?? new();
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    var makeShort = mrp.Count(r => r.IsMake && r.Net > 0);
    var buyShort = mrp.Count(r => !r.IsMake && r.Net > 0);
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@plan?.Name <span class="badge badge-light-@(plan?.Status=="Generated"?"success":"secondary") ms-2 fs-7">@(plan?.Status == "Generated" ? Localizer["Generated"] : SR["Draft"])</span></h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("ProductionPlanning","Inventory")" class="text-muted text-hover-primary">@Localizer["Planning"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@plan?.Name</li></ul></div>
        <a href="@Url.Action("ProductionPlanning","Inventory")" class="btn btn-light"><i class="ki-outline ki-arrow-left fs-2"></i>@SR["Back"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["InvMsg"] != null) { <div class="alert alert-success">@TempData["InvMsg"]</div> }
        @if (TempData["InvErr"] != null) { <div class="alert alert-danger">@TempData["InvErr"]</div> }

        <div class="row g-5">
            <div class="col-lg-5">
                <div class="card"><div class="card-header"><div class="card-title fw-bold">@Localizer["Production demand"]</div></div>
                    <div class="card-body">
                        <form asp-action="AddPlanDemand" method="post" class="row g-3 mb-4">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@plan?.ID" />
                            <div class="col-12"><label class="required fw-semibold fs-8 text-muted mb-1">@Localizer["Manufactured item"]</label>
                                <select id="dm_item" name="itemId" class="form-select form-select-solid" style="width:100%" required></select></div>
                            <div class="col-7"><label class="required fw-semibold fs-8 text-muted mb-1">@Localizer["Qty"]</label><input type="number" step="0.01" min="0.01" name="qty" class="form-control form-control-solid" value="1" required /></div>
                            <div class="col-5"><label class="fw-semibold fs-8 text-muted mb-1">@Localizer["Due"]</label><input type="date" name="dueDate" class="form-control form-control-solid" /></div>
                            <div class="col-12 d-flex justify-content-end"><button class="btn btn-sm btn-light-primary"><i class="ki-outline ki-plus fs-3"></i>@SR["Add"]</button></div>
                        </form>
                        <div class="table-responsive"><table class="table table-row-dashed align-middle gy-2">
                            <thead><tr class="fw-bold fs-8 text-muted text-uppercase" style="border-bottom:2px solid #0E4A9E;"><th>@SR["Item"]</th><th class="text-end">@Localizer["Qty"]</th><th class="text-end">@Localizer["Due"]</th><th></th></tr></thead>
                            <tbody>
                            @if (!demands.Any()) { <tr><td colspan="4" class="text-center text-muted py-5">@Localizer["Add an item to the demand."]</td></tr> }
                            @foreach (var d in demands)
                            {
                                <tr><td class="fw-semibold text-gray-800">@(demandNames.TryGetValue(d.ItemId, out var n) ? n : ("#" + d.ItemId))</td><td class="text-end">@d.Qty.ToString("N2")</td><td class="text-end text-muted fs-8">@(d.DueDate?.ToString("yyyy-MM-dd"))</td>
                                <td class="text-end"><form asp-action="RemovePlanDemand" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.ID" /><input type="hidden" name="planId" value="@plan?.ID" /><button class="btn btn-icon btn-sm btn-light-danger"><i class="ki-outline ki-trash fs-6"></i></button></form></td></tr>
                            }
                            </tbody>
                        </table></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card"><div class="card-header"><div class="card-title fw-bold">@Localizer["Net requirements (MRP)"]</div>
                    <div class="card-toolbar">
                        @if (makeShort > 0)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <form asp-action="GeneratePlanWorkOrders" method="post" class="d-flex align-items-center gap-2" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["Create work orders for all manufactured shortages?"]">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@plan?.ID" />
                                    <select name="warehouseId" class="form-select form-select-sm form-select-solid w-150px" required>@foreach (var w in whs) { <option value="@w.ID">@w.Code — @(isAr ? w.Name : DisplayName.Or(w.NameEn, w.Name))</option> }</select>
                                    <button class="btn btn-sm btn-success"><i class="ki-outline ki-check fs-3"></i>@Localizer["Generate WOs"]</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
                    <div class="card-body">
                        <div class="d-flex gap-6 mb-4">
                            <div><span class="text-muted fs-8 d-block">@Localizer["To make"]</span><span class="fs-3 fw-bold text-primary">@makeShort</span></div>
                            <div><span class="text-muted fs-8 d-block">@Localizer["To buy"]</span><span class="fs-3 fw-bold text-warning">@buyShort</span></div>
                        </div>
                        <div class="table-responsive"><table class="table table-row-bordered align-middle gy-2">
                            <thead><tr class="fw-bold fs-8 text-muted text-uppercase" style="border-bottom:2px solid #0E4A9E;"><th>@SR["Item"]</th><th>@SR["Type"]</th><th class="text-end">@Localizer["Gross"]</th><th class="text-end">@Localizer["On hand"]</th><th class="text-end">@Localizer["Net"]</th></tr></thead>
                            <tbody>
                            @if (!mrp.Any()) { <tr><td colspan="5" class="text-center text-muted py-6">@Localizer["Add a demand to see requirements."]</td></tr> }
                            @foreach (var r in mrp)
                            {
                                <tr class="@(r.Net > 0 ? "" : "text-muted")">
                                    <td><span style="padding-inline-start:@(r.Level * 14)px" class="fw-semibold">@(r.Level > 0 ? "↳ " : "")@r.ItemCode</span><div class="fs-8 text-muted" style="padding-inline-start:@(r.Level * 14)px">@r.ItemName</div></td>
                                    <td>@if (r.IsMake) { <span class="badge badge-light-primary">@Localizer["Make"]</span> } else { <span class="badge badge-light-secondary">@Localizer["Buy"]</span> }</td>
                                    <td class="text-end">@r.Gross.ToString("N2")</td>
                                    <td class="text-end text-muted">@r.OnHand.ToString("N2")</td>
                                    <td class="text-end fw-bold @(r.Net > 0 ? (r.IsMake ? "text-primary" : "text-warning") : "")">@r.Net.ToString("N2")</td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                        <div class="text-muted fs-8 mt-2">@Localizer["Net = gross − on-hand. BOM is exploded only for make-item shortages. \"Generate WOs\" creates a draft work order for each make shortage at its net qty."]</div>
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
if(window.jQuery){ jQuery('#dm_item').select2({ placeholder:'@Localizer["Search a manufactured item…"]', minimumInputLength:1,
  ajax:{ url:'@Url.Action("WorkOrderItemPickData","Inventory")', dataType:'json', delay:250, data:function(p){return {term:p.term};}, processResults:function(d){return {results:d.results};} } }); }
</script>
}
