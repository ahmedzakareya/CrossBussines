@using CrossBuy.BL
@using CrossBuy.Models.Context.Inventory
@model List<ItemCategoryNode>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var accounts = ViewBag.Accounts as List<AccountNode> ?? new();
    var hasKids = Model.Select(n => n.ParentId).Where(p => p.HasValue).Select(p => p!.Value).ToHashSet();
    var blank = Url.Content("~/Backend-assets/media/svg/files/blank-image.svg");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Item Categories"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Categories"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Categories card-->
        <div class="card card-flush">
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                        <input type="text" id="s" class="form-control form-control-solid w-250px ps-12" placeholder="@Localizer["Search category"]" autocomplete="off" />
                    </div>
                </div>
                <div class="card-toolbar d-flex align-items-center flex-nowrap gap-3 gap-2 flex-wrap">
                    <button type="button" id="expandAll" class="btn btn-light flex-shrink-0">@Localizer["Expand"]</button>
                    <button type="button" id="collapseAll" class="btn btn-light flex-shrink-0">@Localizer["Collapse"]</button>
                    <a href="@Url.Action("CreateCategory","Inventory")" class="btn btn-primary flex-shrink-0 text-nowrap"><i class="ki-outline ki-plus fs-2"></i>@Localizer["Add category"]</a>
                </div>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="t">
                    <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                        <th class="min-w-250px">@Localizer["Category"]</th>
                        <th class="text-end min-w-100px">@Localizer["Inventory acct"]</th>
                        <th class="text-end min-w-100px">@Localizer["COGS acct"]</th>
                        <th class="text-end min-w-90px">@SR["Status"]</th>
                        <th class="text-end min-w-70px">@SR["Actions"]</th>
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-600">
                    @foreach (var n in Model)
                    {
                        var kids = hasKids.Contains(n.Id);
                        var inv = accounts.FirstOrDefault(a => a.Id == n.InventoryAccountId);
                        var cogs = accounts.FirstOrDefault(a => a.Id == n.CogsAccountId);
                        <tr class="r" data-id="@n.Id" data-parent="@(n.ParentId?.ToString() ?? "")" data-s="@n.Code @n.Name @n.NameEn">
                            <td>
                                <span style="display:inline-flex;align-items:center;padding-inline-start:@(n.Level * 22)px">
                                    @if (kids) { <i class="ki-outline ki-down fs-7 me-2 cat-caret" style="cursor:pointer"></i> } else { <span class="me-2" style="width:14px;display:inline-block"></span> }
                                    @{ var catIcon = string.IsNullOrWhiteSpace(n.StoreIcon) ? blank : Url.Content("~" + n.StoreIcon.Replace("\\", "/")); }
                                    <span class="symbol symbol-40px me-3"><span class="symbol-label bg-light" style="background-image:url('@catIcon');background-size:contain;background-repeat:no-repeat;background-position:center;"></span></span>
                                    <a href="@Url.Action("EditCategory","Inventory", new { id = n.Id })" class="d-flex flex-column text-gray-800 text-hover-primary">
                                        <span class="fw-bold">@(isAr ? n.Name : (string.IsNullOrEmpty(n.NameEn) ? n.Name : n.NameEn))</span>
                                        <span class="text-muted fs-7">@n.Code</span>
                                    </a>
                                </span>
                            </td>
                            <td class="text-end text-muted fs-7">@(inv == null ? "—" : inv.Code)</td>
                            <td class="text-end text-muted fs-7">@(cogs == null ? "—" : cogs.Code)</td>
                            <td class="text-end"><span class="badge badge-light-@(n.IsActive?"success":"danger")">@(n.IsActive?SR["Active"]:SR["Inactive"])</span></td>
                            <td class="text-end">
                                <a href="#" class="btn btn-sm btn-light btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">@SR["Actions"]<i class="ki-outline ki-down fs-5 ms-1"></i></a>
                                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-150px py-4" data-kt-menu="true">
                                    <div class="menu-item px-3"><a href="@Url.Action("EditCategory","Inventory", new { id = n.Id })" class="menu-link px-3"><i class="ki-outline ki-pencil fs-6 me-2"></i>@SR["Edit"]</a></div>
                                    <div class="menu-item px-3"><a href="@Url.Action("CreateCategory","Inventory")" class="menu-link px-3"><i class="ki-outline ki-plus fs-6 me-2"></i>@Localizer["Sub-category"]</a></div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
                <div id="catPager" class="d-flex flex-stack flex-wrap pt-5"></div>
                @if (Model.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No categories"]</div> }
            </div>
        </div>
        <!--end::Categories card-->
    </div></div>
</div>

@section Scripts {
<script>
(function(){
  var rows = [].slice.call(document.querySelectorAll('#t tbody tr.r'));
  var s = document.getElementById('s');
  var pager = document.getElementById('catPager');
  var pageSize = 10, page = 1;
  // group by root (DOM is pre-ordered: root then all its descendants until the next root)
  var groups = [], cur = null;
  rows.forEach(function(r){
    if (!r.getAttribute('data-parent')) { cur = { root: r, desc: [] }; groups.push(cur); }
    else if (cur) { cur.desc.push(r); }
  });
  function kids(id){ return rows.filter(function(r){ return r.getAttribute('data-parent') === String(id); }); }
  function setHidden(r, hide){ r.style.display = hide ? 'none' : ''; if (hide) { kids(r.getAttribute('data-id')).forEach(function(c){ setHidden(c, true); }); } }
  function q(){ return (s.value || '').trim().toLowerCase(); }
  function matchGroup(g){ var t = q(); if (!t) return true; return [g.root].concat(g.desc).some(function(r){ return (r.getAttribute('data-s')||'').toLowerCase().indexOf(t) !== -1; }); }
  function pnums(pages){ var o=[], lo=Math.max(1,page-2), hi=Math.min(pages,page+2); if(lo>1){o.push(1); if(lo>2)o.push('...');} for(var i=lo;i<=hi;i++)o.push(i); if(hi<pages){ if(hi<pages-1)o.push('...'); o.push(pages);} return o; }
  function render(){
    var f = groups.filter(matchGroup);
    var pages = Math.max(1, Math.ceil(f.length / pageSize));
    if (page > pages) page = pages; if (page < 1) page = 1;
    rows.forEach(function(r){ r.style.display = 'none'; });
    var t = q(), start = (page-1)*pageSize;
    f.slice(start, start + pageSize).forEach(function(g){
      g.root.style.display = '';
      var caret = g.root.querySelector('.cat-caret'); if (caret) { caret.classList.add('ki-down'); caret.classList.remove('ki-right'); }
      g.desc.forEach(function(r){ r.style.display = (!t || (r.getAttribute('data-s')||'').toLowerCase().indexOf(t) !== -1) ? '' : 'none'; });
    });
    var html = '<div class="fs-7 text-muted">' + f.length + ' @Localizer["Categories"]</div>';
    if (pages > 1) {
      html += '<ul class="pagination">';
      html += '<li class="page-item ' + (page<=1?'disabled':'') + '"><a class="page-link" data-p="' + (page-1) + '" href="#"><i class="ki-outline ki-@(isAr?"right":"left")"></i></a></li>';
      pnums(pages).forEach(function(n){ html += '<li class="page-item ' + (n===page?'active':'') + ' ' + (n==='...'?'disabled':'') + '"><a class="page-link" data-p="' + n + '" href="#">' + n + '</a></li>'; });
      html += '<li class="page-item ' + (page>=pages?'disabled':'') + '"><a class="page-link" data-p="' + (page+1) + '" href="#"><i class="ki-outline ki-@(isAr?"left":"right")"></i></a></li>';
      html += '</ul>';
    }
    pager.innerHTML = html;
    pager.querySelectorAll('a.page-link').forEach(function(a){ a.addEventListener('click', function(e){ e.preventDefault(); var p = parseInt(a.getAttribute('data-p')); if (!isNaN(p) && p>=1 && p<=pages) { page = p; render(); } }); });
  }
  document.querySelectorAll('.cat-caret').forEach(function(c){
    c.addEventListener('click', function(){
      var r = c.closest('tr'); var id = r.getAttribute('data-id');
      var collapsed = c.classList.toggle('ki-right'); c.classList.toggle('ki-down', !collapsed);
      kids(id).forEach(function(ch){ setHidden(ch, collapsed); });
    });
  });
  document.getElementById('collapseAll').addEventListener('click', function(){
    rows.forEach(function(r){ if (r.getAttribute('data-parent') && r.style.display !== 'none') r.style.display = 'none'; });
    document.querySelectorAll('.cat-caret').forEach(function(c){ c.classList.add('ki-right'); c.classList.remove('ki-down'); });
  });
  document.getElementById('expandAll').addEventListener('click', function(){ render(); });
  s.addEventListener('input', function(){ page = 1; render(); });
  render();
})();
</script>
}
