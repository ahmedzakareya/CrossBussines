@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var items = ViewBag.Items as List<Item> ?? new();
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    int? fWh = ViewBag.FilterWarehouseId;
    var mode = (string)(ViewBag.Mode ?? "SeparateDocument");
    var book = ((IEnumerable<dynamic>)(ViewBag.BookBalances ?? new List<object>())).ToList();
    var itemById = items.ToDictionary(i => i.ID, i => i);
    var reasons = new[] { ("Damaged", Localizer["Damaged"].Value), ("Expired", Localizer["Expired"].Value), ("Lost", Localizer["Lost"].Value), ("Other", Localizer["Other"].Value) };
}
<form asp-action="CreateWriteOff" method="post" id="f" class="d-flex flex-column flex-column-fluid" data-noitems="@Localizer["No items"]">@Html.AntiForgeryToken()
    <input type="hidden" name="linesJson" id="linesJson" />
    <input type="hidden" name="warehouseId" value="@fWh" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["New write-off / damage"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("WriteOffs","Inventory")" class="text-muted text-hover-primary">@Localizer["Write-offs"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["New"]</li></ul></div>
        <div class="d-flex gap-2"><a href="@Url.Action("WriteOffs","Inventory")" class="btn btn-light">@SR["Cancel"]</a>@if (fWh != null) { <button type="button" class="btn btn-danger" id="save"><i class="ki-outline ki-trash fs-2"></i>@Localizer["Post write-off"]</button> } else { <button type="button" class="btn btn-light-danger" disabled><i class="ki-outline ki-trash fs-2"></i>@Localizer["Select a warehouse first"]</button> }</div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="alert alert-light-@(mode == "AdjustmentReason" ? "warning" : "primary") d-flex align-items-center">
            <i class="ki-outline ki-information-5 fs-2 me-3"></i>
            <span>@(mode == "AdjustmentReason"
                ? Localizer["Current mode: 'Reason within adjustment' — this write-off is recorded as a stock adjustment."]
                : Localizer["Current mode: 'Separate document' — a WOF- numbered document is created."])
            @Localizer["Entry: Dr write-off expense (510103) / Cr inventory (1103). Expired batches may be written off."]</span>
        </div>
        <div class="card mb-5"><div class="card-body"><div class="row g-5 align-items-end">
            <div class="col-md-3"><label class="required fw-semibold fs-6 mb-2">@SR["Warehouse"]</label>
                <select id="whSel" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["Select to load items"]</option>@foreach (var w in whs) { <option value="@w.ID" selected="@(fWh==w.ID)">@w.Code — @(isAr ? w.Name : DisplayName.Or(w.NameEn, w.Name))</option> }</select></div>
            <div class="col-md-3"><label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label><input type="text" name="writeOffDate" class="form-control form-control-solid" data-control="flatpickr" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-3"><label class="fw-semibold fs-6 mb-2">@Localizer["Default reason"]</label>
                <select name="reason" class="form-select form-select-solid" data-control="select2" data-hide-search="true">@foreach (var r in reasons) { <option value="@r.Item1">@r.Item2</option> }</select></div>
            <div class="col-md-3"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" /></div>
        </div></div></div>

        @if (fWh == null)
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-information-5 fs-3x text-muted mb-3 d-block"></i>@Localizer["Select a warehouse to load its items and balances."]</div></div>
        }
        else
        {
            <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@Localizer["Items to write off"]</h3><div class="card-toolbar d-flex gap-2"><div class="position-relative d-flex align-items-center"><i class="ki-outline ki-barcode fs-2 position-absolute ms-3"></i><input class="form-control form-control-solid form-control-sm w-220px ps-10 js-barcode-scan" placeholder="@Localizer["Scan to add item"]" autocomplete="off" /></div></div></div>
            <div class="card-body"><div class="table-responsive"><table class="table table-row-bordered align-middle"><thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                <th style="min-width:240px">@SR["Item"]</th><th class="text-end" style="width:110px">@Localizer["Available"]</th><th class="text-end" style="width:120px">@Localizer["Write-off qty"]</th><th style="min-width:200px">@Localizer["Picked from (section/rack)"]</th><th style="width:150px">@Localizer["Reason"]</th><th style="width:120px">@Localizer["Batch"]</th><th style="width:120px">@Localizer["Serial"]</th><th style="width:40px"></th>
            </tr></thead><tbody id="rows">
                @foreach (var b in book)
                {
                    int iid = (int)b.ItemId; decimal bq = (decimal)b.QtyOnHand;
                    if (bq <= 0) { continue; }
                    var it = itemById.TryGetValue(iid, out var iv) ? iv : null;
                    <tr data-item="@iid" data-avail="@bq.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <td class="fw-bold text-gray-800">@(it == null ? ("#"+iid) : (it.ItemCode + " — " + (isAr ? it.Name : (string.IsNullOrEmpty(it.NameEn) ? it.Name : it.NameEn))))</td>
                        <td class="text-end text-muted">@bq.ToString("0.##")</td>
                        <td class="text-end"><input type="number" step="0.0001" min="0" class="form-control form-control-solid form-control-sm text-end qty" value="0"></td>
                        <td><div class="d-flex gap-2"><select class="form-select form-select-solid form-select-sm sec"><option value="">—</option></select><select class="form-select form-select-solid form-select-sm rack"><option value="">—</option></select></div></td>
                        <td><select class="form-select form-select-solid form-select-sm reason">@foreach (var r in reasons) { <option value="@r.Item1">@r.Item2</option> }</select></td>
                        <td><input class="form-control form-control-solid form-control-sm batch" placeholder="—"></td>
                        <td><input class="form-control form-control-solid form-control-sm serial" placeholder="—"></td>
                        <td class="text-center"><i class="ki-outline ki-cross fs-3 text-hover-danger cursor-pointer rm"></i></td>
                    </tr>
                }
            </tbody></table></div>
            @if (book.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No balances in this warehouse."]</div> }
            </div></div>
        }
    </div></div>
</form>
<partial name="_ItemScanModal" />
<partial name="~/Views/Shared/_QuickAdd.cshtml" />
@section Scripts {
<script>
var ITEMS=[]; // scan provides code/name directly; no full-catalog preload
var REASONS=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(reasons.Select(r=>new{code=r.Item1,label=r.Item2})));
var whSel=document.getElementById('whSel');
if(whSel){ var go=function(){ var v=whSel.value||''; location.href='@Url.Action("NewWriteOff","Inventory")'+(v?('?warehouseId='+v):''); }; if(window.jQuery){ jQuery(whSel).on('change select2:select',go); } else whSel.addEventListener('change',go); }
var rowsEl=document.getElementById('rows');
function reasonOpts(){ var s=''; for(var i=0;i<REASONS.length;i++){ s+='<option value="'+REASONS[i].code+'">'+REASONS[i].label+'</option>'; } return s; }
function findItem(id){ for(var i=0;i<ITEMS.length;i++) if(ITEMS[i].iD===id) return ITEMS[i]; return null; }
// ---- source section/rack (picked-from) support ----
var WH=@(fWh?.ToString() ?? "0"); var BINS={sections:[],racks:[],itemDefaults:{}}; var binsUrl='@Url.Action("WarehouseBinsData","Inventory")';
function secOpts(sel){var o='<option value="">—</option>';BINS.sections.forEach(function(s){o+='<option value="'+s.id+'"'+(sel==s.id?' selected':'')+'>'+s.code+(s.name?(' — '+s.name):'')+'</option>';});return o;}
function fillRacks(tr){var s=tr.querySelector('.sec');if(!s)return;var sec=s.value;var rk=tr.querySelector('.rack');var cur=rk.value;var o='<option value="">—</option>';BINS.racks.forEach(function(r){if(String(r.sectionId)===String(sec))o+='<option value="'+r.id+'"'+(cur==r.id?' selected':'')+'>'+r.code+(r.name?(' — '+r.name):'')+'</option>';});rk.innerHTML=o;}
function applyItemDefault(tr){var id=tr.getAttribute('data-item');var d=id?BINS.itemDefaults[String(id)]:null;if(d&&d.sectionId&&!tr.querySelector('.sec').value){tr.querySelector('.sec').value=d.sectionId;fillRacks(tr);if(d.rackId)tr.querySelector('.rack').value=d.rackId;}}
function refreshRows(){[].slice.call(rowsEl.querySelectorAll('tr')).forEach(function(tr){var s=tr.querySelector('.sec');if(!s)return;s.innerHTML=secOpts(s.value);fillRacks(tr);applyItemDefault(tr);});}
if(WH){ fetch(binsUrl+'?warehouseId='+WH,{headers:{'X-Requested-With':'fetch'}}).then(function(r){return r.json();}).then(function(j){BINS=j;refreshRows();}); }
if(rowsEl){
  rowsEl.addEventListener('click',function(e){ if(e.target.classList.contains('rm')) e.target.closest('tr').remove(); });
  rowsEl.addEventListener('change',function(e){ if(e.target.classList.contains('sec')) fillRacks(e.target.closest('tr')); });
}
window.onItemScanned=function(p){
  if(!rowsEl) return;
  var ex=rowsEl.querySelector('tr[data-item="'+p.id+'"]');
  if(ex){ var qi=ex.querySelector('.qty'); qi.value=(parseFloat(qi.value)||0)+(p.qty||1); return; }
  var it=findItem(p.id)||{itemCode:p.code,name:p.name};
  var tr=document.createElement('tr'); tr.setAttribute('data-item',p.id); tr.setAttribute('data-avail','0');
  tr.innerHTML='<td class="fw-bold text-gray-800">'+it.itemCode+' — '+(it.name||'')+'</td><td class="text-end text-muted">0</td>'+
    '<td class="text-end"><input type="number" step="0.0001" min="0" class="form-control form-control-solid form-control-sm text-end qty" value="'+(p.qty||1)+'"></td>'+
    '<td><div class="d-flex gap-2"><select class="form-select form-select-solid form-select-sm sec">'+secOpts(0)+'</select><select class="form-select form-select-solid form-select-sm rack"><option value="">—</option></select></div></td>'+
    '<td><select class="form-select form-select-solid form-select-sm reason">'+reasonOpts()+'</select></td>'+
    '<td><input class="form-control form-control-solid form-control-sm batch" placeholder="—"></td>'+
    '<td><input class="form-control form-control-solid form-control-sm serial" placeholder="—"></td>'+
    '<td class="text-center"><i class="ki-outline ki-cross fs-3 text-hover-danger cursor-pointer rm"></i></td>';
  rowsEl.appendChild(tr);
  fillRacks(tr); applyItemDefault(tr);
};
var saveBtn=document.getElementById('save');
if(saveBtn) saveBtn.addEventListener('click',function(){
  var lines=[]; [].slice.call(rowsEl.querySelectorAll('tr')).forEach(function(tr){
    var id=parseInt(tr.getAttribute('data-item')); var q=parseFloat(tr.querySelector('.qty').value);
    var rk=tr.querySelector('.rack').value,sc=tr.querySelector('.sec').value,bin=rk||sc;
    if(id&&q>0) lines.push({itemId:id,qty:q,reason:tr.querySelector('.reason').value,batchNo:tr.querySelector('.batch').value||null,serialNo:tr.querySelector('.serial').value||null,binLocationId:bin?parseInt(bin):null});
  });
  if(!lines.length){ alert(document.getElementById('f').getAttribute('data-noitems')); return; }
  CB.confirm({type:'delete', text:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Post this stock write-off? The quantities will be permanently removed."].Value))}).then(function(ok){
    if(!ok) return;
    document.getElementById('linesJson').value=JSON.stringify(lines); document.getElementById('f').submit();
  });
});
</script>
}
