@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var days = (int)(ViewBag.Days ?? 14);
    var wordings = (int)(ViewBag.DistinctWordings ?? 0);
    var refusals = (int)(ViewBag.TotalRefusals ?? 0);
    var topCount = (int)(ViewBag.TopCount ?? 0);
}
@*
    WHAT THE ASSISTANT WAS ASKED AND COULD NOT ANSWER.

    Every gap in the assistant used to be found the same way: someone asked something, it refused,
    and they sent a screenshot. That loop only ever surfaces the questions ONE person happened to
    ask on the day they were looking. This screen is the alternative — sorted by how often each
    wording was refused, so the next thing worth building is the first row on the page.

    It names no one. The log records the question and never the questioner: the question is the
    signal, and a record of what each named person asked their accounting system is a different
    artifact with different rules that nobody asked for.
*@
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Questions the assistant could not answer"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Assistant gaps"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        @* THE HEADLINE FIGURES ARE OVER THE WHOLE WINDOW, never over one page. A "total refusals"
           that changed when you paged would be worse than not showing one. *@
        <div class="row g-4 mb-5">
            <div class="col-md-4"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fs-8 text-uppercase fw-bold mb-1">@Localizer["Distinct wordings"]</div>
                <div class="fs-2 fw-bold text-gray-900" style="font-variant-numeric:tabular-nums">@wordings</div>
            </div></div></div>
            <div class="col-md-4"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fs-8 text-uppercase fw-bold mb-1">@Localizer["Times refused"]</div>
                <div class="fs-2 fw-bold text-gray-900" style="font-variant-numeric:tabular-nums">@refusals</div>
            </div></div></div>
            <div class="col-md-4"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fs-8 text-uppercase fw-bold mb-1">@Localizer["Most-repeated wording"]</div>
                <div class="fs-2 fw-bold text-gray-900" style="font-variant-numeric:tabular-nums">@topCount</div>
            </div></div></div>
        </div>

        @if (wordings == 0)
        {
            @* NOT AN ERROR, AND SHAPED SO IT DOES NOT READ AS ONE. An empty log means nothing was
               refused in the window — a result, not a failure, so it gets the neutral notice
               rather than the warning tone reserved for something the reader must fix. *@
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5">
                <span class="symbol symbol-45px me-4"><span class="symbol-label bg-primary"><i class="ki-outline ki-check-circle fs-2x text-white"></i></span></span>
                <div class="d-flex flex-column">
                    <h4 class="mb-1 text-gray-900">@Localizer["Nothing was refused"]</h4>
                    <span class="text-gray-700">@Localizer["Every question asked in this window was answered. The log records a question only when the assistant could not answer it."]</span>
                </div>
            </div>
        }

        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-8">
                <label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@Localizer["Multi-search (question / reason / intent)"]</label>
                <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@Localizer["Add search terms…"]" />
            </div>
            <div class="col-md-2">
                <label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Window"]</label>
                <select id="f_days" class="form-select form-select-solid cb-filter">
                    <option value="1" selected="@(days == 1)">@Localizer["Today"]</option>
                    <option value="7" selected="@(days == 7)">@Localizer["7 days"]</option>
                    <option value="14" selected="@(days == 14)">@Localizer["14 days"]</option>
                    <option value="30" selected="@(days == 30)">@Localizer["30 days"]</option>
                </select>
            </div>
            <div class="col-md-2"><button type="button" id="f_reset" class="btn btn-light w-100"><i class="ki-outline ki-arrows-circle fs-3"></i> @SR["Reset"]</button></div>
        </div></div></div>

        <div class="card card-flush">
            <div class="card-header align-items-center py-4">
                <div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
                <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                    <select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                </div>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4" id="t">
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                        <th class="ps-4 min-w-250px">@Localizer["Question"]</th>
                        <th class="text-center min-w-80px">@Localizer["Times"]</th>
                        <th class="text-center min-w-120px">@Localizer["Reason"]</th>
                        <th class="text-center min-w-130px">@Localizer["First asked"]</th>
                        <th class="text-center pe-4 min-w-130px">@Localizer["Last asked"]</th>
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-700" id="rows"></tbody>
                </table>
                </div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Loading…"]</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@Localizer["No matching questions"]</div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>

    </div></div>
</div>
@section Scripts {
<script>
// The window is a filter like any other: addParams puts it on every request, and `cb-filter` on
// the select means Reset clears it with the rest.
cbServerList({
    url: '@Url.Action("AskGapsData","Inventory")',
    isAr: @(isAr ? "true" : "false"),
    addParams: function (p) { var d = document.getElementById('f_days'); if (d && d.value) p.set('days', d.value); }
});
document.getElementById('f_days')?.addEventListener('change', function () { location.search = '?days=' + this.value; });
</script>
}
