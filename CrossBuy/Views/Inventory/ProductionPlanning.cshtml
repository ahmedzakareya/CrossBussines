@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutManufacturing.cshtml";
    var plans = ViewBag.Plans as List<ManufPlan> ?? new();
    string stCls(string s) => s == "Generated" ? "success" : "secondary";
    string stNm(string s) => s == "Generated" ? Localizer["Generated"].Value : SR["Draft"].Value;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Production planning (MRP)"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@SR["Manufacturing"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Planning"]</li></ul></div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#planModal"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New plan"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["InvMsg"] != null) { <div class="alert alert-success">@TempData["InvMsg"]</div> }
        @if (TempData["InvErr"] != null) { <div class="alert alert-danger">@TempData["InvErr"]</div> }
        <div class="card"><div class="card-body py-3">
            <div class="text-muted fs-8 mb-3">@Localizer["A plan is a production demand for manufactured items. On run, BOMs are exploded multi-level and on-hand is netted, surfacing shortages to make or buy."]</div>
            <div class="table-responsive"><table class="table table-row-bordered align-middle gy-3">
                <thead><tr class="fw-bold fs-7 text-muted text-uppercase" style="border-bottom:2px solid #0E4A9E;"><th>#</th><th>@SR["Name"]</th><th>@SR["Date"]</th><th>@SR["Status"]</th><th></th></tr></thead>
                <tbody>
                @if (!plans.Any()) { <tr><td colspan="5" class="text-center text-muted py-6">@Localizer["No plans yet."]</td></tr> }
                @foreach (var p in plans)
                {
                    <tr>
                        <td class="fw-bold">@p.ID</td>
                        <td><a href="@Url.Action("PlanDetails","Inventory", new { id = p.ID })" class="fw-bold text-hover-primary">@DisplayName.Of(p.Name, p.NameEn)</a></td>
                        <td class="text-muted">@(p.PlanDate?.ToString("yyyy-MM-dd"))</td>
                        <td><span class="badge badge-light-@stCls(p.Status)">@stNm(p.Status)</span></td>
                        <td class="text-end">
                            <a href="@Url.Action("PlanDetails","Inventory", new { id = p.ID })" class="btn btn-sm btn-light-primary">@Localizer["Open"]</a>
                            <form asp-action="DeletePlan" method="post" class="d-inline" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Delete this plan?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.ID" /><button class="btn btn-sm btn-light-danger">@SR["Delete"]</button></form>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        </div></div>
    </div></div>
</div>

<div class="modal fade" id="planModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <form asp-action="CreatePlan" method="post">@Html.AntiForgeryToken()
        <div class="modal-header"><h3 class="modal-title">@Localizer["New production plan"]</h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body row g-4">
            <div class="col-md-8"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Name"]</label><input name="name" class="form-control form-control-solid" required placeholder="@Localizer["June plan"]" /></div>
            <div class="col-md-4"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Date"]</label><input type="date" name="planDate" class="form-control form-control-solid" /></div>
            @* Optional English name. The list shows this to an English reader and falls back to
               the Arabic one when it is left empty, so nothing breaks if the planner skips it. *@
            <div class="col-md-8"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Name (English)"]</label><input name="nameEn" class="form-control form-control-solid" placeholder="@Localizer["June plan"]" /></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@Localizer["Create"]</button></div>
    </form>
</div></div></div>
