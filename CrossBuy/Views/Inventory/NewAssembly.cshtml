@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var kits = ViewBag.AssemblyItems as List<Item> ?? new();
    var warehouses = ViewBag.Warehouses as List<Warehouse> ?? new();
}
<form id="kt_asm_form" class="d-flex flex-column flex-column-fluid" method="post" asp-action="PostAssembly" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["Run this assembly/disassembly order? It will affect stock balances."]">
    @Html.AntiForgeryToken()
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Assembly / Disassembly order"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("StockMovements","Inventory")" class="text-muted text-hover-primary">@Localizer["Movements"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Assembly"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <a href="@Url.Action("StockMovements","Inventory")" class="btn btn-light">@SR["Cancel"]</a>
            <button type="submit" class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@Localizer["Run"]</button>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (kits.Count == 0) { <div class="alert alert-light-warning">@Localizer["No Assembly-type items. Create a composite item of type Assembly with components first."]</div> }

        <div class="d-flex flex-column flex-lg-row">
            <div class="d-flex flex-column gap-7 gap-lg-10 w-100 w-lg-400px mb-7 me-lg-10">
                <div class="card card-flush py-4">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Operation"]</h2></div></div>
                    <div class="card-body pt-0">
                        <select name="disassemble" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                            <option value="false" selected>@Localizer["Assemble (produce kit)"]</option>
                            <option value="true">@Localizer["Disassemble (return components)"]</option>
                        </select>
                        <div class="text-muted fs-7 mt-3">@Localizer["Assembly consumes components and produces the kit at the summed cost. Disassembly reverses it."]</div>
                    </div>
                </div>
                <div class="card card-flush py-4">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Date & warehouse"]</h2></div></div>
                    <div class="card-body pt-0 d-flex flex-column gap-4">
                        <div><label class="fw-semibold fs-6 mb-2">@SR["Date"]</label><input name="date" class="form-control form-control-solid" data-control="flatpickr" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                        <div><label class="required fw-semibold fs-6 mb-2">@SR["Warehouse"]</label>
                            <select name="warehouseId" class="form-select form-select-solid" data-control="select2" required>
                                <option value="">@Localizer["Select"]</option>
                                @foreach (var w in warehouses) { <option value="@w.ID">@w.Code — @(isAr ? w.Name : DisplayName.Or(w.NameEn, w.Name))</option> }
                            </select></div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-row-fluid gap-7 gap-lg-10">
                <div class="card card-flush py-4">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Composite item & qty"]</h2></div></div>
                    <div class="card-body pt-0">
                        <div class="row">
                            <div class="col-md-8 mb-5"><label class="required fw-semibold fs-6 mb-2">@Localizer["Assembly item"]</label>
                                <select name="assemblyItemId" class="form-select form-select-solid" data-control="select2" required>
                                    <option value="">@Localizer["Select"]</option>
                                    @foreach (var k in kits) { <option value="@k.ID">@k.ItemCode — @(isAr ? k.Name : (string.IsNullOrEmpty(k.NameEn) ? k.Name : k.NameEn))</option> }
                                </select></div>
                            <div class="col-md-4 mb-5"><label class="required fw-semibold fs-6 mb-2">@SR["Quantity"]</label><input name="qty" id="asmQty" type="number" step="0.0001" min="0" class="form-control form-control-solid" required value="1" /></div>
                        </div>

                        <!--begin::BOM preview-->
                        <div id="bomBox" class="d-none">
                            <div class="separator separator-dashed my-5"></div>
                            <h3 class="fs-5 fw-bold text-gray-800 mb-4">@Localizer["This item's components"]</h3>
                            <div class="table-responsive">
                                <table class="table align-middle gy-3 mb-0" style="font-variant-numeric:tabular-nums;">
                                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                        <th class="ps-4 min-w-200px">@Localizer["Component"]</th>
                                        <th class="text-end min-w-100px">@Localizer["Per unit"]</th>
                                        <th class="text-end min-w-110px">@Localizer["Total needed"]</th>
                                        <th class="text-end min-w-110px">@Localizer["Available"]</th>
                                        <th class="text-center pe-4 min-w-90px">@SR["Status"]</th>
                                    </tr></thead>
                                    <tbody id="bomBody" class="fw-semibold text-gray-700"></tbody>
                                </table>
                            </div>
                            <div id="bomEmpty" class="text-muted text-center py-6 d-none">@Localizer["This item has no components defined."]</div>
                            <div id="bomHint" class="text-muted fs-7 mt-3">@Localizer["Assembly deducts components and adds the kit. Disassembly reverses it."]</div>
                        </div>
                        <!--end::BOM preview-->
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</form>

<partial name="~/Views/Shared/_QuickAdd.cshtml" />
@section Scripts {
<script>
(function(){
  var itemSel = document.getElementById('kt_asm_form').querySelector('[name=assemblyItemId]');
  var whSel = document.getElementById('kt_asm_form').querySelector('[name=warehouseId]');
  var qtyInput = document.getElementById('asmQty');
  var box = document.getElementById('bomBox'), body = document.getElementById('bomBody');
  var empty = document.getElementById('bomEmpty');
  var bomUrl = '@Url.Action("ItemBom","Inventory")';
  var lblShort = '@Localizer["Short"]', lblOk = '@Localizer["OK"]';

  function val(el){ return el ? el.value : ''; }
  function render(rows){
    var qty = parseFloat(qtyInput.value) || 0;
    body.innerHTML = '';
    if (!rows || !rows.length){ empty.classList.remove('d-none'); return; }
    empty.classList.add('d-none');
    rows.forEach(function(r){
      var need = (r.qtyPerUnit || 0) * qty;
      var short = need > (r.available || 0);
      var tr = document.createElement('tr');
      tr.setAttribute('style','border-bottom:1px dashed #eef1f6;');
      tr.innerHTML =
        '<td class="ps-4 fw-bold text-gray-800">'+(r.code? r.code+' — ':'')+(r.name||'')+'</td>'+
        '<td class="text-end text-muted">'+ (r.qtyPerUnit||0) + (r.uom? ' '+r.uom : '') +'</td>'+
        '<td class="text-end fw-bold text-gray-900">'+ (Math.round(need*10000)/10000) +'</td>'+
        '<td class="text-end '+(short?'':'text-gray-700')+'">'+ (r.available||0) +'</td>'+
        '<td class="text-center pe-4"><span class="badge fw-bold" style="'+(short?'background:#fdeaea;color:#d92d20;':'background:#E7F0FF;color:#0E4A9E;')+'">'+(short?lblShort:lblOk)+'</span></td>';
      body.appendChild(tr);
    });
  }
  function load(){
    var id = val(itemSel);
    if (!id){ box.classList.add('d-none'); return; }
    var url = bomUrl + '?itemId=' + encodeURIComponent(id) + (val(whSel)? '&warehouseId='+encodeURIComponent(val(whSel)) : '');
    fetch(url, { headers: { 'X-Requested-With':'XMLHttpRequest' } })
      .then(function(r){ return r.json(); })
      .then(function(d){ box.classList.remove('d-none'); render(d && d.components); })
      .catch(function(){ box.classList.add('d-none'); });
  }
  [itemSel, whSel].forEach(function(el){ if(!el) return; el.addEventListener('change', load); if(window.jQuery) jQuery(el).on('change', load); });
  if (qtyInput) qtyInput.addEventListener('input', load);
})();
</script>
}
