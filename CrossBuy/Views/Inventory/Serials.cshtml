@using CrossBuy.Controllers
@model List<SerialRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    string? fStatus = ViewBag.FilterStatus;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Serial numbers"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Serials"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header align-items-center py-5 gap-3">
                <div class="card-title"><div class="d-flex align-items-center position-relative my-1"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" id="s" class="form-control form-control-solid w-250px ps-12" placeholder="@SR["Search"]" autocomplete="off" /></div></div>
                <div class="card-toolbar"><select id="stFilter" class="form-select form-select-solid w-175px" data-control="select2" data-hide-search="true">
                    <option value="" selected="@string.IsNullOrEmpty(fStatus)">@SR["All"]</option>
                    <option value="InStock" selected="@(fStatus=="InStock")">@Localizer["In stock"]</option>
                    <option value="Issued" selected="@(fStatus=="Issued")">@Localizer["Issued"]</option>
                </select></div>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-3" id="t">
                    <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0"><th>@SR["Code"]</th><th class="min-w-200px">@SR["Item"]</th><th>@Localizer["Serial"]</th><th>@Localizer["WH"]</th><th class="text-center">@SR["Status"]</th></tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var r in Model)
                    {
                        <tr data-s="@r.ItemCode @r.ItemName @r.SerialNo">
                            <td class="fw-bold text-gray-800">@r.ItemCode</td><td>@r.ItemName</td><td><span class="badge badge-light-primary">@r.SerialNo</span></td><td class="text-muted">@r.Warehouse</td>
                            <td class="text-center"><span class="badge badge-light-@(r.Status=="InStock"?"success":"secondary")">@(r.Status=="InStock"?Localizer["In stock"]:Localizer["Issued"])</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
                @if (Model.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No serials"]</div> }
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>(function(){var s=document.getElementById('s'),st=document.getElementById('stFilter'),rows=[].slice.call(document.querySelectorAll('#t tbody tr'));
 if(s)s.addEventListener('input',function(){var q=(s.value||'').trim().toLowerCase();rows.forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});
 if(st){var go=function(){location.href='?status='+(st.value||'');};if(window.jQuery&&jQuery(st).data('select2'))jQuery(st).on('change',go);else st.addEventListener('change',go);}})();</script>
}
