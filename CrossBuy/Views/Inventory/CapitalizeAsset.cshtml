@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var items = ViewBag.AssetItems as List<Item> ?? new();
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
}
<form asp-action="DoCapitalizeAsset" method="post" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Capitalize asset from stock"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Capitalize"]</li></ul></div>
        @if (items.Count > 0) { <button class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@Localizer["Capitalize"]</button> } else { <button type="button" class="btn btn-light-primary" disabled>@Localizer["No asset items"]</button> }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="alert alert-light-primary d-flex align-items-center"><i class="ki-outline ki-information-5 fs-2 me-3"></i><span>@Localizer["For an Asset-type item in stock: issues it at actual cost and creates a fixed asset that enters the depreciation schedule. Entry: Dr Fixed asset (1201) / Cr Inventory (1103)."]</span></div>
        <div class="card"><div class="card-body"><div class="row g-5">
            <div class="col-md-5"><label class="required fw-semibold fs-6 mb-2">@Localizer["Asset item"]</label>
                <select name="itemId" class="form-select form-select-solid" data-control="select2" required>@foreach (var i in items) { <option value="@i.ID">@i.ItemCode — @(isAr ? i.Name : (string.IsNullOrEmpty(i.NameEn) ? i.Name : i.NameEn))</option> }</select></div>
            <div class="col-md-3"><label class="required fw-semibold fs-6 mb-2">@SR["Warehouse"]</label>
                <select name="warehouseId" class="form-select form-select-solid" data-control="select2" required>@foreach (var w in whs) { <option value="@w.ID">@w.Code — @(isAr ? w.Name : w.NameEn)</option> }</select></div>
            <div class="col-md-2"><label class="required fw-semibold fs-6 mb-2">@SR["Quantity"]</label><input name="qty" type="number" step="0.0001" min="0" class="form-control form-control-solid" required /></div>
            <div class="col-md-2"><label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label><input name="date" type="text" class="form-control form-control-solid" data-control="flatpickr" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
        </div></div></div>
    </div></div>
</form>
