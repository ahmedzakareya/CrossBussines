@using CrossBuy.Models.Context.Inventory
@model List<StockMovement>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var item = ViewBag.Item as Item;
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    var whById = whs.ToDictionary(w => w.ID, w => w);
    int? fWh = ViewBag.FilterWarehouseId;
    decimal balQty = ViewBag.BalQty ?? 0m, balVal = ViewBag.BalValue ?? 0m, balAvg = ViewBag.BalAvg ?? 0m;
    // running balance (oldest first) — Model is newest-first, so reverse for the running calc
    var chrono = Model.AsEnumerable().Reverse().ToList();
    var running = new Dictionary<int, decimal>();
    decimal run = 0m;
    foreach (var m in chrono) { run += m.Direction * m.QtyBase; running[m.ID] = run; }
    string srcName(string? s) => s switch {
        "Opening" => Localizer["Opening"].Value, "Receipt" => Localizer["Receipt"].Value,
        "Issue" => Localizer["Issue"].Value, "Adjustment" => Localizer["Adjustment"].Value,
        "PurchaseInvoice" => Localizer["Purchase"].Value, "SalesInvoice" => Localizer["Sale"].Value, _ => s ?? "—" };

    // ---- item analytics (computed from the movements) ----
    var purchaseSrcs = new[] { "Receipt", "PurchaseInvoice" };
    var purchases = Model.Where(m => m.Direction == 1 && purchaseSrcs.Contains(m.SourceType)).ToList();
    var lastOp = Model.FirstOrDefault();                                  // newest movement
    var lastPurchase = purchases.FirstOrDefault();                        // newest purchase
    var lastEntry = Model.FirstOrDefault(m => m.Direction == 1);
    var lastExit = Model.FirstOrDefault(m => m.Direction == -1);
    var pQty = purchases.Sum(p => p.QtyBase);
    var avgPurchase = pQty > 0 ? purchases.Sum(p => p.QtyBase * p.UnitCost) / pQty : 0m;
    string dOrDash(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "—";
    // balance-trend series for the chart (chronological)
    var trendCats = chrono.Select(m => m.MovementDate.ToString("yyyy-MM-dd")).ToList();
    var trendBal = chrono.Select(m => running[m.ID]).ToList();
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Item ledger"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("StockBalances","Inventory")" class="text-muted text-hover-primary">@Localizer["Balances"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@(item?.ItemCode)</li></ul></div>
        <a href="@Url.Action("StockBalances","Inventory")" class="btn btn-light"><i class="ki-outline ki-arrow-left fs-2"></i>@SR["Back"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            <div class="col-12">
                <div class="card card-flush"><div class="card-body d-flex flex-wrap justify-content-between align-items-center py-6">
                    <div>
                        <div class="fs-3 fw-bold text-gray-900">@(item == null ? "" : (item.ItemCode + " — " + (isAr ? item.Name : (string.IsNullOrEmpty(item.NameEn) ? item.Name : item.NameEn))))</div>
                        <div class="text-muted fs-7">@Localizer["Barcode"]: @item?.Barcode</div>
                    </div>
                    <div class="d-flex gap-10">
                        <div class="text-center"><div class="fs-2hx fw-bold text-gray-900">@balQty.ToString("0.##")</div><div class="text-muted fs-7">@Localizer["On hand"]</div></div>
                        <div class="text-center"><div class="fs-2hx fw-bold text-gray-900">@balAvg.ToString("0.00")</div><div class="text-muted fs-7">@Localizer["Avg cost"]</div></div>
                        <div class="text-center"><div class="fs-2hx fw-bold text-primary">@balVal.ToString("0.00")</div><div class="text-muted fs-7">@Localizer["Value"]</div></div>
                    </div>
                </div></div>
            </div>
        </div>

        <!-- analytics strip -->
        <div class="row g-5 g-xl-8 mb-5">
            <div class="col-sm-6 col-xl-4">
                <div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@Localizer["Last operation"]</div>
                    @if (lastOp == null) { <div class="fs-4 fw-bold text-gray-400">—</div> }
                    else {
                        <div class="d-flex align-items-center gap-2"><span class="badge badge-light-@(lastOp.Direction==1?"success":"danger")">@srcName(lastOp.SourceType)</span><span class="fs-5 fw-bold text-gray-900">@lastOp.MovementDate.ToString("yyyy-MM-dd")</span></div>
                        <div class="text-muted fs-8 mt-1">@(lastOp.Direction==1?Localizer["In"]:Localizer["Out"]) @lastOp.QtyBase.ToString("0.##") · @lastOp.UnitCost.ToString("0.00")</div>
                    }
                </div></div>
            </div>
            <div class="col-sm-6 col-xl-4">
                <div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@Localizer["Last purchase"]</div>
                    @if (lastPurchase == null) { <div class="fs-4 fw-bold text-gray-400">—</div> }
                    else {
                        <div class="d-flex align-items-center gap-2"><span class="badge badge-light-secondary">@srcName(lastPurchase.SourceType)</span><span class="fs-5 fw-bold text-gray-900">@lastPurchase.MovementDate.ToString("yyyy-MM-dd")</span></div>
                        <div class="text-muted fs-8 mt-1">@lastPurchase.QtyBase.ToString("0.##") @Localizer["@"] @lastPurchase.UnitCost.ToString("0.00")</div>
                    }
                </div></div>
            </div>
            <div class="col-sm-6 col-xl-4">
                <div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@Localizer["Avg purchase price"]</div>
                    <div class="fs-2hx fw-bold text-gray-900">@avgPurchase.ToString("0.00")</div>
                    <div class="text-muted fs-8 mt-1">@Localizer["over"] @pQty.ToString("0.##") @Localizer["units purchased"]</div>
                </div></div>
            </div>
            <div class="col-sm-6 col-xl-4">
                <div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@Localizer["Current avg cost"]</div>
                    <div class="fs-2hx fw-bold text-primary">@balAvg.ToString("0.00")</div>
                </div></div>
            </div>
            <div class="col-sm-6 col-xl-4">
                <div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@Localizer["Last entry date"]</div>
                    <div class="fs-3 fw-bold text-primary">@dOrDash(lastEntry?.MovementDate)</div>
                </div></div>
            </div>
            <div class="col-sm-6 col-xl-4">
                <div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@Localizer["Last exit date"]</div>
                    <div class="fs-3 fw-bold text-danger">@dOrDash(lastExit?.MovementDate)</div>
                </div></div>
            </div>
        </div>

        <!-- balance trend chart -->
        <div class="card card-flush mb-5">
            <div class="card-header pt-5"><div class="card-title"><h2>@Localizer["Item balance over time"]</h2></div></div>
            <div class="card-body pt-2">
                @if (trendCats.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No movements to chart"]</div> }
                else { <div id="item_trend_chart"></div> }
            </div>
        </div>

        <div class="card card-flush">
            <div class="card-header align-items-center py-5">
                <div class="card-title"><h2>@Localizer["Movements"]</h2></div>
                <div class="card-toolbar">
                    <div class="d-flex align-items-center flex-nowrap gap-3">
                        <div class="position-relative">
                            <i class="ki-outline ki-magnifier fs-4 position-absolute top-50 translate-middle-y ms-3" style="color:#0E4A9E !important;"></i>
                            <input type="text" class="form-control form-control-solid ps-10 w-200px" placeholder="@SR["Search"]" autocomplete="off" />
                        </div>
                        <select id="whFilter" class="form-select form-select-solid w-250px" data-control="select2">
                            <option value="">@Localizer["All warehouses"]</option>
                            @foreach (var w in whs) { <option value="@w.ID" selected="@(fWh==w.ID)">@w.Code — @(isAr ? w.Name : DisplayName.Or(w.NameEn, w.Name))</option> }
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4">
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                        <th class="min-w-100px">@SR["Date"]</th>
                        <th class="min-w-100px">@SR["Warehouse"]</th>
                        <th class="text-center min-w-90px">@SR["Type"]</th>
                        <th class="text-end min-w-80px">@Localizer["In"]</th>
                        <th class="text-end min-w-80px">@Localizer["Out"]</th>
                        <th class="text-end min-w-90px">@SR["Balance"]</th>
                        <th class="text-end min-w-90px">@Localizer["Unit cost"]</th>
                        <th class="text-end min-w-100px">@Localizer["Value"]</th>
                        <th class="text-center min-w-60px">@Localizer["JE"]</th>
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var m in Model)
                    {
                        var w = whById.TryGetValue(m.WarehouseId, out var wv) ? wv : null;
                        <tr data-s="@m.MovementDate.ToString("yyyy-MM-dd") @(w?.Code) @srcName(m.SourceType) @(m.JournalEntryId)">
                            <td class="text-muted">@m.MovementDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-muted">@(w == null ? "—" : w.Code)</td>
                            <td class="text-center"><span class="badge badge-light-@(m.Direction==1?"success":"danger")">@srcName(m.SourceType)</span></td>
                            <td class="text-end fw-bold text-primary">@(m.Direction==1 ? m.QtyBase.ToString("0.##") : "—")</td>
                            <td class="text-end fw-bold text-danger">@(m.Direction==-1 ? m.QtyBase.ToString("0.##") : "—")</td>
                            <td class="text-end fw-bold text-gray-900">@(running.TryGetValue(m.ID, out var rb) ? rb.ToString("0.##") : "")</td>
                            <td class="text-end text-muted">@m.UnitCost.ToString("0.00")</td>
                            <td class="text-end fw-bold text-gray-800">@m.TotalCost.ToString("0.00")</td>
                            <td class="text-center">@if (m.JournalEntryId != null) { <a href="@Url.Action("JournalEntry", "Accounting", new { id = m.JournalEntryId })" class="badge badge-light-primary" title="@SR["View"]">#@m.JournalEntryId</a> } else { <span class="text-muted">—</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
                @if (Model.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No movements"]</div> }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
<script>
(function(){
  var wf = document.getElementById('whFilter');
  if (wf){ var go=function(){ var u=new URL(location.href); if(wf.value) u.searchParams.set('warehouseId',wf.value); else u.searchParams.delete('warehouseId'); location.href=u.toString(); };
    if(window.CB && CB.onSelectChange) CB.onSelectChange(wf, go); else wf.addEventListener('change', go); }

  var el = document.querySelector('#item_trend_chart');
  if (el && window.ApexCharts) {
    var cats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendCats));
    var bal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendBal));
    new ApexCharts(el, {
      chart: { type: 'area', height: 300, fontFamily: 'inherit', toolbar: { show: false } },
      series: [ { name: '@SR["Balance"]', data: bal } ],
      colors: ['#145DBF'],
      xaxis: { categories: cats, labels: { rotate: -45, style: { colors: '#99A1B7', fontSize: '11px' } }, tickAmount: 10 },
      yaxis: { labels: { style: { colors: '#99A1B7' }, formatter: function (v) { return Number(v).toLocaleString(); } } },
      stroke: { curve: 'stepline', width: 3 },
      fill: { type: 'gradient', gradient: { opacityFrom: 0.4, opacityTo: 0.05 } },
      dataLabels: { enabled: false }, legend: { show: false },
      grid: { borderColor: '#E4E6EF', strokeDashArray: 4 },
      markers: { size: 0, hover: { size: 5 } },
      tooltip: { y: { formatter: function (v) { return Number(v).toLocaleString(); } } }
    }).render();
  }
})();
</script>
}
