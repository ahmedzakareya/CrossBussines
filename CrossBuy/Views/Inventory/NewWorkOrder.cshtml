@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutManufacturing.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["New work order"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("WorkOrders","Inventory")" class="text-muted text-hover-primary">@Localizer["Work orders"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["New"]</li></ul></div>
        <a href="@Url.Action("WorkOrders","Inventory")" class="btn btn-light">@SR["Cancel"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["InvErr"] != null) { <div class="alert alert-danger">@TempData["InvErr"]</div> }
        <div class="card"><div class="card-body">
            @* Stage 0: the POST target carries [InvPerm("doc")]; do not render a form that would be rejected. *@
            @if (ViewBag.CanDoc != null && !(bool)ViewBag.CanDoc)
            {
                <div class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-6">
                    <i class="ki-outline ki-shield-cross fs-2tx text-warning me-4"></i>
                    <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                        <h4 class="text-gray-900 fw-bold">@SR["You do not have permission to perform this action"]</h4>
                        <div class="fs-6 text-gray-700">@Localizer["Creating a work order requires an inventory document permission."]</div>
                    </div></div>
                </div>
            }
            else
            {
            <form asp-action="CreateWorkOrder" method="post" class="row g-5">@Html.AntiForgeryToken()
                <div class="col-md-6"><label class="required fw-semibold fs-7 text-muted mb-1">@Localizer["Manufactured item (has a BOM)"]</label>
                    <select id="wo_item" name="itemId" class="form-select form-select-solid" style="width:100%" required></select>
                    <div class="text-muted fs-8 mt-1">@Localizer["Only items that have defined components appear here."]</div></div>
                <div class="col-md-3"><label class="required fw-semibold fs-7 text-muted mb-1">@Localizer["Qty to produce"]</label><input type="number" step="0.01" min="0.01" name="qty" class="form-control form-control-solid" value="1" required /></div>
                <div class="col-md-3"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Warehouse"]</label>
                    <select name="warehouseId" class="form-select form-select-solid" data-control="select2" required>@foreach (var w in whs) { <option value="@w.ID">@w.Code — @(isAr ? w.Name : DisplayName.Or(w.NameEn, w.Name))</option> }</select></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Planned start"]</label><input type="date" name="plannedStart" class="form-control form-control-solid" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Planned end"]</label><input type="date" name="plannedEnd" class="form-control form-control-solid" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Labor cost (total)"]</label><input type="number" step="0.01" min="0" name="laborCost" class="form-control form-control-solid" value="0" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Overhead (total)"]</label><input type="number" step="0.01" min="0" name="overheadCost" class="form-control form-control-solid" value="0" /></div>
                <div class="col-12"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Notes"]</label><textarea name="notes" class="form-control form-control-solid" rows="2"></textarea></div>
                <div class="col-12 d-flex justify-content-end"><button class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@Localizer["Create work order"]</button></div>
            </form>
            }
        </div></div>
        <div class="text-muted fs-8 mt-3">@Localizer["After creating: BOM components are pulled automatically; release then complete to consume materials, produce the item and post the JE (materials + labor + overhead via the WIP account)."]</div>
    </div></div>
</div>
<partial name="~/Views/Shared/_QuickAdd.cshtml" />
@section Scripts {
<script>
if(window.jQuery){ jQuery('#wo_item').select2({ placeholder:'@Localizer["Search a manufactured item…"]', minimumInputLength:1,
  ajax:{ url:'@Url.Action("WorkOrderItemPickData","Inventory")', dataType:'json', delay:250, data:function(p){return {term:p.term};}, processResults:function(d){return {results:d.results};} } }); }
</script>
}
