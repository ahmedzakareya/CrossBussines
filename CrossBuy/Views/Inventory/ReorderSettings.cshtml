@using CrossBuy.Controllers
@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    int? fWh = ViewBag.FilterWarehouseId;
    var rows = ViewBag.Rows as List<InvReportRow> ?? new();
}
<form asp-action="SaveReorderSettings" method="post" id="f" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    <input type="hidden" name="settingsJson" id="settingsJson" />
    <input type="hidden" name="warehouseId" value="@fWh" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Reorder settings"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Planning"]</li></ul></div>
        @if (fWh != null) { <button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button> }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body"><div class="row g-5 align-items-end">
            <div class="col-md-5"><label class="required fw-semibold fs-6 mb-2">@SR["Warehouse"]</label>
                <select id="whSel" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["Select warehouse"]</option>@foreach (var w in whs) { <option value="@w.ID" selected="@(fWh==w.ID)">@w.Code — @(isAr ? w.Name : DisplayName.Or(w.NameEn, w.Name))</option> }</select></div>
            <div class="col-md-7"><div class="text-muted fs-7">@Localizer["Set per item: reorder point, min/max. Suggested qty = max − on-hand."]</div></div>
        </div></div></div>
        @if (fWh == null)
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-information-5 fs-3x mb-3 d-block"></i>@Localizer["Select a warehouse to list items."]</div></div>
        }
        else
        {
            <div class="card"><div class="card-header align-items-center py-5"><div class="card-title"><div class="d-flex align-items-center position-relative my-1"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" id="s" class="form-control form-control-solid w-250px ps-12" placeholder="@SR["Search"]" autocomplete="off" /></div></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table table-row-dashed align-middle fs-6 gy-3" id="t">
                @* cb-thead-rule instead of a literal #0E4A9E: same rule, read from the token layer,
                   so a change to the brand ink does not have to be hunted through the views. *@
                <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0 cb-thead-rule"><th>@SR["Code"]</th><th class="min-w-200px">@SR["Item"]</th><th style="width:160px">@Localizer["Reorder pt"]</th><th style="width:140px">@Localizer["Min"]</th><th style="width:140px">@Localizer["Max"]</th></tr></thead>
                <tbody class="fw-semibold text-gray-700">
                @foreach (var r in rows)
                {
                    <tr data-s="@r.ItemCode @r.ItemName" data-item="@r.ItemId">
                        <td class="fw-bold text-gray-800">@r.ItemCode</td><td>@r.ItemName</td>
                        <td><input type="number" step="0.01" min="0" class="form-control form-control-solid form-control-sm rp text-end" value="@r.ReorderPoint.ToString(System.Globalization.CultureInfo.InvariantCulture)"></td>
                        <td><input type="number" step="0.01" min="0" class="form-control form-control-solid form-control-sm mn text-end" value="@r.MinQty.ToString(System.Globalization.CultureInfo.InvariantCulture)"></td>
                        <td><input type="number" step="0.01" min="0" class="form-control form-control-solid form-control-sm mx text-end" value="@r.MaxQty.ToString(System.Globalization.CultureInfo.InvariantCulture)"></td>
                    </tr>
                }
                </tbody>
            </table></div></div></div>
        }
    </div></div>
</form>
@section Scripts {
<script>
var whSel=document.getElementById('whSel');
if(whSel){var go=function(){location.href='?warehouseId='+(whSel.value||'');};if(window.CB&&CB.onSelectChange)CB.onSelectChange(whSel,go);else whSel.addEventListener('change',go);}
var s=document.getElementById('s'); if(s)s.addEventListener('input',function(){var q=(s.value||'').trim().toLowerCase();[].slice.call(document.querySelectorAll('#t tbody tr')).forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});
var save=document.getElementById('save');
if(save)save.addEventListener('click',function(){function doSave(){var arr=[];[].slice.call(document.querySelectorAll('#t tbody tr')).forEach(function(tr){arr.push({itemId:parseInt(tr.getAttribute('data-item')),reorderPoint:parseFloat(tr.querySelector('.rp').value)||0,minQty:parseFloat(tr.querySelector('.mn').value)||0,maxQty:parseFloat(tr.querySelector('.mx').value)||0});});document.getElementById('settingsJson').value=JSON.stringify(arr);document.getElementById('f').submit();}if(window.CB&&CB.confirm){CB.confirm({type:'edit',text:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Save settings?"].Value))}).then(function(ok){if(ok)doSave();});}else{doSave();}});
</script>
}
