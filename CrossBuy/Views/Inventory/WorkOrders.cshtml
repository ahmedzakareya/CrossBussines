@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutManufacturing.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var sts = new[] { ("Draft", "Draft"), ("Released", "Released"), ("Completed", "Completed"), ("Cancelled", "Cancelled") };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Work orders"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@SR["Manufacturing"]</li></ul></div>
        @if (ViewBag.CanDoc == null || (bool)ViewBag.CanDoc)
        {
            <a href="@Url.Action("NewWorkOrder","Inventory")" class="btn btn-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New work order"]</a>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["InvMsg"] != null) { <div class="alert alert-success">@TempData["InvMsg"]</div> }
        @if (TempData["InvErr"] != null) { <div class="alert alert-danger">@TempData["InvErr"]</div> }
        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-8"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@Localizer["Search (WO no / item)"]</label>
                <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@Localizer["Add search terms…"]" /></div>
            <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Status"]</label>
                <select id="f_status" class="form-select form-select-solid cb-filter" data-hide-search="true"><option value="">@SR["All"]</option>@foreach (var s in sts) { <option value="@s.Item1">@(s.Item1 == "Draft" ? SR["Draft"] : Localizer[s.Item2])</option> }</select></div>
            <div class="col-md-2"><button type="button" id="f_reset" class="btn btn-light w-100"><i class="ki-outline ki-arrows-circle fs-3"></i> @SR["Reset"]</button></div>
        </div></div></div>
        <div class="card"><div class="card-header border-0 pt-6"><div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
            <div class="card-toolbar"><select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3">
                <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase"><th>@Localizer["WO no"]</th><th>@SR["Item"]</th><th class="text-center">@Localizer["Qty"]</th><th class="text-center">@SR["Warehouse"]</th><th class="text-end">@Localizer["Unit cost"]</th><th class="text-center">@SR["Status"]</th><th class="text-end">@Localizer["Open"]</th></tr></thead>
                <tbody id="rows"></tbody>
            </table></div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Loading…"]</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@Localizer["No work orders"]</div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
cbServerList({ url:'@Url.Action("WorkOrdersData","Inventory")', isAr:@(isAr ? "true" : "false"),
  addParams:function(p){ var s=document.getElementById('f_status'); if(s&&s.value)p.set('status',s.value); } });
</script>
}
