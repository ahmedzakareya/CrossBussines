@model CrossBuy.Models.DocDetailVm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    string st(string s) => s switch { "Posted" => "success", "Approved" => "success", "Cancelled" => "danger", "Rejected" => "danger", "Draft" => "secondary", _ => "primary" };
    string stName(string s) => s switch { "Posted" => Localizer["Posted"].Value, "Approved" => Localizer["Approved"].Value, "Cancelled" => Localizer["Cancelled"].Value, "Draft" => SR["Draft"].Value, "Closed" => Localizer["Closed"].Value, "Received" => Localizer["Received"].Value, "Delivered" => Localizer["Delivered"].Value, _ => s };
}
@*  THE RECORD HEADER FOR EIGHT DOCUMENTS, DEFINED ONCE. Purchase and sales orders, receipts,
    deliveries, transfers, counts, write-offs and landed costs all render through this view, so the
    head is written here and every one of them gets it.

    Built on the theme record page (demo39 apps/projects/project.html): an icon tile, the document
    number with its status beside it, the document kind and date underneath, the actions on the far
    side, and the header key/values as dashed stat boxes. The toolbar above keeps only the title and
    the breadcrumb - the actions belong to the record, not to the chrome. *@
<div class="d-flex flex-column flex-column-fluid">

    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isAr ? Model.Title : (string.IsNullOrEmpty(Model.TitleEn) ? Model.Title : Model.TitleEn))</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action(Model.BackAction,"Inventory")" class="text-muted text-hover-primary">@(isAr ? Model.BackLabel : (string.IsNullOrEmpty(Model.BackLabelEn) ? Model.BackLabel : Model.BackLabelEn))</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted"><bdi dir="ltr">@Model.DocNo</bdi></li>
                </ul>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <div class="card mb-6">
                <div class="card-body py-8">
                    <div class="d-flex flex-wrap flex-sm-nowrap">
                        <div class="d-flex flex-center flex-shrink-0 bg-light-primary rounded w-100px h-100px me-7 mb-4">
                            <i class="ki-outline ki-document fs-3x text-primary" aria-hidden="true"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                                <div class="d-flex flex-column">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="text-gray-900 fs-2 fw-bold me-3"><bdi dir="ltr">@Model.DocNo</bdi></span>
                                        <span class="badge badge-light-@st(Model.Status) fs-7 py-2 px-3">@stName(Model.Status)</span>
                                    </div>
                                    <div class="d-flex flex-wrap fw-semibold mb-4 fs-6 text-gray-500">
                                        <span class="d-flex align-items-center text-gray-500 me-5">
                                            <i class="ki-outline ki-abstract-26 fs-4 me-1" aria-hidden="true"></i>@(isAr ? Model.Title : (string.IsNullOrEmpty(Model.TitleEn) ? Model.Title : Model.TitleEn))
                                        </span>
                                        <span class="d-flex align-items-center text-gray-500">
                                            <i class="ki-outline ki-calendar fs-4 me-1" aria-hidden="true"></i><bdi dir="ltr">@Model.DateStr</bdi>
                                        </span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-4">
                                    @*  PRINTING FOR EIGHT DOCUMENTS, DEFINED ONCE. A document names its screen on the
                                        view model and every layout bound to that screen appears; one that has no report
                                        yet leaves it null and renders nothing, which is honest - a print button that opens
                                        nothing is worse than its absence. Nothing here prints the SCREEN: the platform
                                        renders the document, which is the rule. *@
                                    @if (!string.IsNullOrWhiteSpace(Model.PrintScreenKey) && Model.DocumentId is > 0)
                                    {
                                        @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
                                        {
                                            ScreenKey = Model.PrintScreenKey!,
                                            DocumentId = Model.DocumentId!.Value.ToString(),
                                        })
                                    }
                                    @if (Model.JournalEntryId.HasValue)
                                    {
                                        <a href="@Url.Action("JournalEntry","Accounting", new { id = Model.JournalEntryId })" class="btn btn-sm btn-primary"><i class="ki-outline ki-document fs-5" aria-hidden="true"></i>@Localizer["Journal entry"]</a>
                                    }
                                    <a href="@Url.Action(Model.BackAction,"Inventory")" class="btn btn-sm btn-bg-light btn-active-color-primary">@SR["Back"]</a>
                                </div>
                            </div>

                            @*  The header key/values become the stat row. A document with none simply has no
                                boxes - the shape does not assume a fixed set, because eight documents do not
                                carry the same fields. *@
                            @if (Model.Header.Any())
                            {
                                <div class="d-flex flex-wrap">
                                    @foreach (var kv in Model.Header)
                                    {
                                        <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                            <div class="fs-4 fw-bold">@(string.IsNullOrEmpty(kv.Value) ? "—" : kv.Value)</div>
                                            <div class="fw-semibold fs-6 text-gray-500">@(isAr ? kv.Label : (string.IsNullOrEmpty(kv.LabelEn) ? kv.Label : kv.LabelEn))</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        <div class="card card-flush">
            <div class="card-header align-items-center">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-900">@Localizer["Lines"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@Localizer["Document lines"]</span>
                </h3>
                <div class="card-toolbar"><span class="badge badge-light-primary fs-8 fw-bold">@Model.Rows.Count</span></div>
            </div>
            <div class="card-body pt-2"><div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-3">
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                        @foreach (var c in Model.Columns) { <th class="@(c.Num ? "text-end" : "")">@(isAr ? c.Label : (string.IsNullOrEmpty(c.LabelEn) ? c.Label : c.LabelEn))</th> }
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @for (var i = 0; i < row.Count; i++)
                            {
                                var num = i < Model.Columns.Count && Model.Columns[i].Num;
                                <td class="@(num ? "text-end" : "") @(i == 0 ? "fw-bold text-gray-900" : "")">@row[i]</td>
                            }
                        </tr>
                    }
                    @if (Model.Rows.Count == 0) { <tr><td colspan="@Math.Max(1, Model.Columns.Count)" class="text-center text-muted py-10">@Localizer["No lines"]</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (Model.Totals.Count > 0)
            {
                <div class="d-flex justify-content-end mt-4"><div class="w-300px">
                    @foreach (var t in Model.Totals)
                    {
                        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted fw-semibold">@(isAr ? t.Label : (string.IsNullOrEmpty(t.LabelEn) ? t.Label : t.LabelEn))</span><span class="fw-bold fs-5 @(Model.Danger ? "text-danger" : "text-gray-900")">@t.Value</span></div>
                    }
                </div></div>
            }

            @* THE CONVERSATION AND THE ACTIVITY PANEL, for whichever of the eight documents this is.
               Wired ONCE here rather than in eight actions: they share this view, so they share the
               panels, and a document that names no entity code renders neither.

               INSIDE the page's own .app-container, not in one of their own: a second container
               appended after #kt_app_content is rebuilt by the layout script, which re-inserts its
               markup as innerHTML — and a script inserted that way never executes. The panel was in
               the DOM with a clean console and simply never loaded.

               The conversation endpoints are the module's own — one gate resolves the family from
               the code, so nine documents are served by three actions rather than twenty-seven. *@
            @if (!string.IsNullOrWhiteSpace(Model.EntityCode) && Model.DocumentId is > 0)
            {
                ViewBag.TimelineEntityType = Model.EntityCode;
                ViewBag.TimelineEntityId = Model.DocumentId;

                ViewBag.ConversationEntityCode = Model.EntityCode;
                ViewBag.ConversationEntityId = Model.DocumentId;
                ViewBag.ConversationListUrl = Url.Action("QuotationConversation", "Inventory");
                ViewBag.ConversationMentionUrl = Url.Action("QuotationConversationMentions", "Inventory");
                ViewBag.ConversationAddUrl = Url.Action("QuotationConversationAdd", "Inventory");
                ViewBag.ConversationReactUrl = Url.Action("QuotationConversationReact", "Inventory");

                @* COMMUNICATION PHASE 3 - TASKS. Every endpoint below lives on the TASKS controller, not this
                   module: the conversation is this screen's, the work is Tasks'. Naming them here is the whole
                   of the opt-in - the shared partial resolves nothing on a caller's behalf, so a screen that
                   omits them keeps exactly its previous behaviour.

                   THE PANEL STILL DECIDES WHETHER TO SHOW ANYTHING. It reveals the link controls only when all
                   three link urls are present AND the service reports LinkingAvailable AND a thread exists, so a
                   deployment without the CommTaskLinks table shows nothing rather than a button that refuses.

                   ONE SCREEN, EIGHT ENTITY CODES. Model.EntityCode already carries whichever of PurchaseOrder,
                   GoodsReceipt, SalesOrder, DeliveryNote, StockTransfer, StockCount, StockWriteOff or LandedCost
                   this page is showing, so these endpoints serve all eight with no per-document branch.

                   NONE OF THE EIGHT is EligibleForTaskLink, and this wave does not change that. Linking an
                   existing task is unaffected; a task created from a message is saved without a business anchor
                   and the panel renders the anchor_not_linkable warning rather than a plain confirmation. *@
                ViewBag.ConversationCreateTaskUrl = Url.Action("CreateFromMessage", "Tasks");
                ViewBag.ConversationTasksUrl = Url.Action("ForConversation", "Tasks");
                ViewBag.ConversationLinkUrl = Url.Action("LinkConversation", "Tasks");
                ViewBag.ConversationUnlinkUrl = Url.Action("UnlinkConversation", "Tasks");
                ViewBag.ConversationLinkSearchUrl = Url.Action("LinkCandidates", "Tasks");

                @await Html.PartialAsync("_DocEventTimeline")
                @await Html.PartialAsync("_EntityConversation")
            }
            </div>
        </div>

</div>

@* The shared report dialog — see Views/Shared/_ReportPreviewModal.cshtml. *@
@if (!string.IsNullOrWhiteSpace(Model.PrintScreenKey) && Model.DocumentId is > 0)
{
    @await Html.PartialAsync("_ReportPreviewModal", (object)((isAr ? Model.Title : Model.TitleEn) + " " + Model.DocNo))
}

