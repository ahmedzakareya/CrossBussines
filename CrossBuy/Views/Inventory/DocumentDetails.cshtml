@model CrossBuy.Models.DocDetailVm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    string st(string s) => s switch { "Posted" => "success", "Approved" => "success", "Cancelled" => "danger", "Rejected" => "danger", "Draft" => "secondary", _ => "primary" };
    string stName(string s) => s switch { "Posted" => Localizer["Posted"].Value, "Approved" => Localizer["Approved"].Value, "Cancelled" => Localizer["Cancelled"].Value, "Draft" => SR["Draft"].Value, "Closed" => Localizer["Closed"].Value, "Received" => Localizer["Received"].Value, "Delivered" => Localizer["Delivered"].Value, _ => s };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isAr ? Model.Title : (string.IsNullOrEmpty(Model.TitleEn) ? Model.Title : Model.TitleEn)) <span class="text-muted fs-5 fw-semibold">@Model.DocNo</span></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="@Url.Action(Model.BackAction,"Inventory")" class="text-muted text-hover-primary">@(isAr ? Model.BackLabel : (string.IsNullOrEmpty(Model.BackLabelEn) ? Model.BackLabel : Model.BackLabelEn))</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Model.DocNo</li>
            </ul>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @* PRINTING FOR EIGHT DOCUMENTS, DEFINED ONCE.
               Purchase and sales orders, receipts, deliveries, transfers, counts, write-offs and landed
               costs all render through this view, so the print control belongs here rather than in each
               of them. A document names its screen on the view model and every layout bound to that
               screen appears; one that has no report yet leaves it null and renders nothing, which is
               honest — a print button that opens nothing is worse than its absence.

               Nothing here prints the SCREEN: the platform renders the document, which is the rule. *@
            @if (!string.IsNullOrWhiteSpace(Model.PrintScreenKey) && Model.DocumentId is > 0)
            {
                @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
                {
                    ScreenKey = Model.PrintScreenKey!,
                    DocumentId = Model.DocumentId!.Value.ToString(),
                })
            }

            @if (Model.JournalEntryId.HasValue) { <a href="@Url.Action("JournalEntry","Accounting", new { id = Model.JournalEntryId })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-document fs-5"></i>@Localizer["Journal entry"]</a> }
            <a href="@Url.Action(Model.BackAction,"Inventory")" class="btn btn-sm btn-light">@SR["Back"]</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush mb-5">
            <div class="card-header pt-6"><div class="card-title"><h2 class="fw-bold">@Localizer["Document details"]</h2></div>
                <div class="card-toolbar"><span class="badge badge-light-@st(Model.Status) fs-7 py-2 px-3">@stName(Model.Status)</span></div>
            </div>
            <div class="card-body pt-2"><div class="row g-4">
                <div class="col-md-3"><div class="fs-7 text-muted">@Localizer["Document No."]</div><div class="fw-bold text-gray-900">@Model.DocNo</div></div>
                <div class="col-md-3"><div class="fs-7 text-muted">@SR["Date"]</div><div class="fw-bold text-gray-900">@Model.DateStr</div></div>
                @foreach (var kv in Model.Header)
                {
                    <div class="col-md-3"><div class="fs-7 text-muted">@(isAr ? kv.Label : (string.IsNullOrEmpty(kv.LabelEn) ? kv.Label : kv.LabelEn))</div><div class="fw-bold text-gray-900">@(string.IsNullOrEmpty(kv.Value) ? "—" : kv.Value)</div></div>
                }
            </div></div>
        </div>

        <div class="card card-flush">
            <div class="card-header pt-6"><div class="card-title"><h2 class="fw-bold">@Localizer["Lines"]</h2></div></div>
            <div class="card-body pt-2"><div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-3">
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                        @foreach (var c in Model.Columns) { <th class="@(c.Num ? "text-end" : "")">@(isAr ? c.Label : (string.IsNullOrEmpty(c.LabelEn) ? c.Label : c.LabelEn))</th> }
                    </tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @for (var i = 0; i < row.Count; i++)
                            {
                                var num = i < Model.Columns.Count && Model.Columns[i].Num;
                                <td class="@(num ? "text-end" : "") @(i == 0 ? "fw-bold text-gray-900" : "")">@row[i]</td>
                            }
                        </tr>
                    }
                    @if (Model.Rows.Count == 0) { <tr><td colspan="@Math.Max(1, Model.Columns.Count)" class="text-center text-muted py-10">@Localizer["No lines"]</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (Model.Totals.Count > 0)
            {
                <div class="d-flex justify-content-end mt-4"><div class="w-300px">
                    @foreach (var t in Model.Totals)
                    {
                        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted fw-semibold">@(isAr ? t.Label : (string.IsNullOrEmpty(t.LabelEn) ? t.Label : t.LabelEn))</span><span class="fw-bold fs-5 @(Model.Danger ? "text-danger" : "text-gray-900")">@t.Value</span></div>
                    }
                </div></div>
            }
            </div>
        </div>
    </div></div>
</div>

@* The shared report dialog — see Views/Shared/_ReportPreviewModal.cshtml. *@
@if (!string.IsNullOrWhiteSpace(Model.PrintScreenKey) && Model.DocumentId is > 0)
{
    @await Html.PartialAsync("_ReportPreviewModal", (object)((isAr ? Model.Title : Model.TitleEn) + " " + Model.DocNo))
}

