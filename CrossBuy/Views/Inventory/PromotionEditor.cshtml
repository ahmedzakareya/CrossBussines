@using CrossBuy.Models.Context.Inventory
@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model Promotion
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var currencies = ViewBag.Currencies as List<Currency> ?? new List<Currency>();
    var categories = ViewBag.Categories as List<ItemCategory> ?? new List<ItemCategory>();
    var customers = ViewBag.Customers as List<Customer> ?? new List<Customer>();
    int funcCur = ViewBag.FunctionalCurrencyId ?? 0;
    string d(DateTime? x) => x?.ToString("yyyy-MM-dd") ?? "";
    string nv(decimal v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
    bool isNew = Model.ID <= 0;
}
<form id="promoForm" asp-action="SavePromotion" method="post" class="d-flex flex-column flex-column-fluid" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Save promotion?"]">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.ID" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isNew ? Localizer["New promotion"] : Localizer["Edit promotion"])</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Promotions","Inventory")" class="text-muted text-hover-primary">@Localizer["Promotions"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@(isNew ? Localizer["New"].Value : Model.Code)</li></ul></div>
        <div class="d-flex gap-2"><a href="@Url.Action("Promotions","Inventory")" class="btn btn-light">@SR["Back"]</a><button type="submit" class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid"><div class="row">
        <div class="col-lg-7">
            <div class="card card-flush mb-5">
                <div class="card-header"><div class="card-title"><h2>@Localizer["Promotion details"]</h2></div></div>
                <div class="card-body pt-2">
                    <div class="row">
                        <div class="col-md-4 mb-5"><label class="required fw-semibold fs-6 mb-2">@SR["Code"]</label><input name="code" class="form-control form-control-solid" value="@Model.Code" required /></div>
                        <div class="col-md-4 mb-5"><label class="required fw-semibold fs-6 mb-2">@SR["Name"]</label><input name="name" class="form-control form-control-solid" value="@Model.Name" required /></div>
                        <div class="col-md-4 mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Name (EN)"]</label><input name="nameEn" class="form-control form-control-solid" value="@Model.NameEn" /></div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Discount type"]</label>
                            <select name="discountType" id="p_type" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                                <option value="Percent" selected="@(Model.DiscountType != "Amount")">@Localizer["Percent %"]</option>
                                <option value="Amount" selected="@(Model.DiscountType == "Amount")">@Localizer["Fixed amount / unit"]</option>
                            </select></div>
                        <div class="col-md-4 mb-5"><label class="required fw-semibold fs-6 mb-2">@Localizer["Value"]</label><input name="value" id="p_value" type="number" step="0.01" min="0" class="form-control form-control-solid" value="@nv(Model.Value)" required /></div>
                        <div class="col-md-4 mb-5" id="p_curwrap"><label class="fw-semibold fs-6 mb-2">@Localizer["Amount currency"]</label>
                            <select name="currencyId" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                                @foreach (var c in currencies) { <option value="@c.ID" selected="@(Model.CurrencyId == c.ID || (Model.CurrencyId == null && c.ID == funcCur))">@c.Code@(c.ID == funcCur ? Localizer[" (functional)"].Value : "")</option> }
                            </select>
                            <div class="text-muted fs-8 mt-1">@Localizer["Converted to the document currency on use."]</div></div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Min qty"]</label><input name="minQty" type="number" step="0.01" min="0" class="form-control form-control-solid" value="@nv(Model.MinQty)" /></div>
                        <div class="col-md-4 mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Priority"]</label><input name="priority" type="number" step="1" class="form-control form-control-solid" value="@Model.Priority" /></div>
                        <div class="col-md-4 mb-5"><label class="fw-semibold fs-6 mb-2">@SR["Status"]</label>
                            <label class="form-check form-switch form-check-custom form-check-solid mt-2">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "") />
                                <input type="hidden" name="isActive" value="false" />
                                <span class="form-check-label fw-semibold">@SR["Active"]</span>
                            </label></div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Valid from"]</label><input name="validFrom" type="date" class="form-control form-control-solid" value="@d(Model.ValidFrom)" /></div>
                        <div class="col-md-6 mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Valid to"]</label><input name="validTo" type="date" class="form-control form-control-solid" value="@d(Model.ValidTo)" /></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card card-flush mb-5">
                <div class="card-header"><div class="card-title"><h2>@Localizer["Targeting"]</h2></div></div>
                <div class="card-body pt-2">
                    <div class="text-muted fs-7 mb-4">@Localizer["Leave a field empty to match all. The promotion applies when every set field matches together."]</div>
                    <div class="mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Specific item"]</label>
                        <select name="itemId" id="p_item" class="form-select form-select-solid">
                            @if (Model.ItemId.HasValue) { <option value="@Model.ItemId" selected>@ViewBag.ItemName</option> }
                        </select></div>
                    <div class="mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Item category"]</label>
                        <select name="itemCategoryId" class="form-select form-select-solid" data-control="select2">
                            <option value="">@Localizer["All categories"]</option>
                            @foreach (var c in categories) { <option value="@c.ID" selected="@(Model.ItemCategoryId == c.ID)">@(isAr ? c.Name : (string.IsNullOrEmpty(c.NameEn) ? c.Name : c.NameEn))</option> }
                        </select></div>
                    <div class="mb-5"><label class="fw-semibold fs-6 mb-2">@Localizer["Specific customer"]</label>
                        <select name="customerId" id="p_cust" class="form-select form-select-solid" data-control="select2">
                            <option value="">@Localizer["All customers"]</option>
                            @foreach (var c in customers) { <option value="@c.ID" selected="@(Model.CustomerId == c.ID)">@c.Name</option> }
                        </select></div>
                    <div class="mb-2"><label class="fw-semibold fs-6 mb-2">@Localizer["Customer segment"]</label><input name="segment" class="form-control form-control-solid" value="@Model.Segment" placeholder="@Localizer["e.g. GOLD"]" /></div>
                </div>
            </div>
        </div>
    </div></div></div>
</form>
@section Scripts {
<script>
(function(){
  function toggleCur(){ var amt = jQuery('#p_type').val() === 'Amount'; document.getElementById('p_curwrap').style.display = amt ? '' : 'none'; }
  if (window.jQuery) {
    jQuery('#p_type').on('change', toggleCur); toggleCur();
    jQuery('#p_item').select2({ placeholder: '@Localizer["All items"]', allowClear: true, minimumInputLength: 1,
      ajax: { url: '@Url.Action("ItemPickData","Inventory")', dataType: 'json', delay: 250, data: function(p){ return { term: p.term }; }, processResults: function(d){ return { results: d.results }; } } });
  }
})();
</script>
}
