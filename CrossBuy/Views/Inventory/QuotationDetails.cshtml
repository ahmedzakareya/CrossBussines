@using CrossBuy.Models.Context.Inventory
@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model Quotation
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var cust = ViewBag.Customer as Customer;
    @* The CommentEntityType/CommentEntityId pair fed _DocTimeline, which stored rows in the legacy
       DocComments table. It is retired here: the quotation discussion now lives in the Communication
       Platform alongside the invoices. Note the legacy pair also carried the literal string "Quotation"
       rather than the frozen registry constant — a literal that could drift away from the registry in
       silence. The replacement below uses EntityRegistry.Quotation. *@
    var itemCodes = ViewBag.Items as Dictionary<int, string> ?? new();
    string M(decimal v) => v.ToString("N2");
    string stCls(string s) => s switch { "Draft" => "secondary", "Sent" => "info", "Accepted" => "primary", "Converted" => "success", "Rejected" => "danger", "Expired" => "warning", _ => "light" };
    string stName(string s) => s switch { "Draft" => SR["Draft"].Value, "Sent" => Localizer["Sent"].Value, "Accepted" => Localizer["Accepted"].Value, "Converted" => Localizer["Converted"].Value, "Rejected" => Localizer["Rejected"].Value, "Expired" => Localizer["Expired"].Value, _ => s };
    bool locked = Model.Status == "Converted";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Quotation"] @Model.QuoteNo</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Quotations","Inventory")" class="text-muted text-hover-primary">@Localizer["Quotations"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Model.QuoteNo</li></ul></div>
        <div class="d-flex gap-2 align-items-center">
            @* Every layout bound to THIS screen, read live — see Views/Shared/_ReportPrintMenu.cshtml.
               A second design is authored in Report Studio and appears here on its own; nothing in
               this file names a report or a template. *@
            @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
            {
                ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.InventoryQuotationDetails,
                DocumentId = Model.ID.ToString(),
            })

            <a href="@Url.Action("Quotations","Inventory")" class="btn btn-light btn-sm">@SR["Back"]</a>
            @if (!locked)
            {
                @if (Model.Status == "Draft")
                {
                    <form asp-action="SetQuoteStatus" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ID" /><input type="hidden" name="status" value="Sent" /><button class="btn btn-sm btn-light-primary">@Localizer["Mark sent"]</button></form>
                }
                @if (Model.Status == "Draft" || Model.Status == "Sent")
                {
                    <form asp-action="SetQuoteStatus" method="post" class="d-inline" data-cb-confirm data-cb-action="approve" data-cb-text="@Localizer["Accept this quotation?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ID" /><input type="hidden" name="status" value="Accepted" /><button class="btn btn-sm btn-light-primary">@Localizer["Accept"]</button></form>
                    <form asp-action="SetQuoteStatus" method="post" class="d-inline" data-cb-confirm data-cb-action="reject" data-cb-text="@Localizer["Reject this quotation?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ID" /><input type="hidden" name="status" value="Rejected" /><button class="btn btn-sm btn-light-danger">@SR["Reject"]</button></form>
                }
                @if (Model.Status != "Rejected" && Model.Status != "Expired")
                {
                    <form asp-action="ConvertQuoteToOrder" method="post" class="d-inline" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["Convert this quotation to a sales order?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ID" /><button class="btn btn-sm btn-primary"><i class="ki-outline ki-arrow-right fs-3"></i>@Localizer["Convert to order"]</button></form>
                }
            }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body py-6"><div class="row g-6">
            <div class="col-md-3"><div class="text-muted fs-7">@SR["Customer"]</div><div class="fw-bold fs-5 text-gray-900">@(cust == null ? "—" : (isAr ? cust.Name : (cust.NameEn ?? cust.Name)))</div></div>
            <div class="col-md-2"><div class="text-muted fs-7">@SR["Date"]</div><div class="fw-bold fs-5">@Model.QuoteDate.ToString("yyyy-MM-dd")</div></div>
            <div class="col-md-2"><div class="text-muted fs-7">@Localizer["Valid until"]</div><div class="fw-bold fs-5">@(Model.ValidUntil?.ToString("yyyy-MM-dd") ?? "—")</div></div>
            <div class="col-md-2"><div class="text-muted fs-7">@SR["Status"]</div><div><span class="badge badge-light-@stCls(Model.Status) fs-7">@stName(Model.Status)</span></div></div>
            <div class="col-md-3 text-md-end"><div class="text-muted fs-7">@SR["Total"]</div><div class="fw-bold fs-3 text-primary">@M(Model.GrandTotal) <span class="fs-7 text-muted">EGP</span></div></div>
        </div>
        @if (locked && Model.SalesOrderId != null)
        {
            <div class="alert alert-success mt-5 mb-0 d-flex align-items-center"><i class="ki-outline ki-check-circle fs-2 text-primary me-2"></i>@Localizer["Converted to sales order"] <a href="@Url.Action("SalesOrderDetails","Inventory", new { id = Model.SalesOrderId })" class="fw-bold ms-2">#@Model.SalesOrderId</a></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="text-muted fs-7 mt-4">@Model.Notes</div> }
        </div></div>

        <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@Localizer["Lines"]</h3></div>
            <div class="card-body pt-2"><div class="table-responsive">
                <table class="table table-row-bordered align-middle gy-3">
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;"><th>#</th><th>@SR["Item"]</th><th>@SR["Description"]</th><th class="text-end">@Localizer["Qty"]</th><th class="text-end">@SR["Price"]</th><th class="text-end">@Localizer["Disc"]</th><th class="text-end">@Localizer["Tax%"]</th><th class="text-end">@SR["Total"]</th></tr></thead>
                    <tbody>
                    @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
                    {
                        <tr>
                            <td class="text-muted">@l.LineNo</td>
                            <td class="fw-semibold">@(l.ItemId.HasValue && itemCodes.TryGetValue(l.ItemId.Value, out var c) ? c : "—")</td>
                            <td>@l.ItemDescription</td>
                            <td class="text-end">@l.Qty.ToString("0.##")</td>
                            <td class="text-end">@M(l.UnitPrice)</td>
                            <td class="text-end">@M(l.DiscountAmount)</td>
                            <td class="text-end">@l.TaxRate.ToString("0.##")</td>
                            <td class="text-end fw-bold">@M(l.LineTotal)</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot><tr class="fw-bold"><td colspan="7" class="text-end">@Localizer["Sub"] / @SR["Tax"] / @SR["Total"]</td><td class="text-end">@M(Model.SubTotal) / @M(Model.TaxTotal) / @M(Model.GrandTotal)</td></tr></tfoot>
                </table>
            </div></div>
        </div>
        @* BUSINESS CONVERSATION. This REPLACES the _DocTimeline widget rather than sitting beside it.
           _DocTimeline posts to /Comments/* and stores rows in DocComments — a SECOND comment store for
           the same (EntityType, EntityId) pair the Communication Platform already owns, and the last one
           still reachable from a screen. Two widgets writing two stores on one document is how a
           discussion ends up half in each.

           The four ViewBag values are the whole contract: what the record is, and where THIS module
           answers conversation traffic. The endpoints are named here because the shared panel resolves
           none on a caller's behalf — before d867505 it hardcoded Accounting's, which would have posted a
           quotation's messages at a permission gate written for invoices. *@
        @{
            @* THE ACTIVITY PANEL. This was the one document detail screen without it, though the
               registry has declared Quotation SupportsTimeline all along. *@
            ViewBag.TimelineEntityType = CrossBuy.BL.Platform.EntityRegistry.Quotation;
            ViewBag.TimelineEntityId = Model.ID;

            ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.Quotation;
            ViewBag.ConversationEntityId = Model.ID;
            ViewBag.ConversationListUrl = Url.Action("QuotationConversation", "Inventory");
            ViewBag.ConversationAddUrl = Url.Action("QuotationConversationAdd", "Inventory");
            ViewBag.ConversationReactUrl = Url.Action("QuotationConversationReact", "Inventory");
        }
        @await Html.PartialAsync("_DocEventTimeline")
        @await Html.PartialAsync("_EntityConversation")
    </div></div>
</div>

@* The shared report dialog — see Views/Shared/_ReportPreviewModal.cshtml. *@
@await Html.PartialAsync("_ReportPreviewModal", (object)"Quotation")

