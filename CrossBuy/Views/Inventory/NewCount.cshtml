@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var items = ViewBag.Items as List<Item> ?? new();
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    int? fWh = ViewBag.FilterWarehouseId;
    var book = ((IEnumerable<dynamic>)(ViewBag.BookBalances ?? new List<object>())).ToList();
    var batchBal = ((IEnumerable<dynamic>)(ViewBag.BatchBalances ?? new List<object>())).ToList();
    var itemById = items.ToDictionary(i => i.ID, i => i);
    // HM-7: batches per tracked item, from the derived per-batch on-hand
    var batchByItem = batchBal.GroupBy(b => (int)b.ItemId).ToDictionary(g => g.Key, g => g.ToList());
    string Nm(Item it) => it.ItemCode + " — " + (isAr ? it.Name : (string.IsNullOrEmpty(it.NameEn) ? it.Name : it.NameEn));
    string Inv(decimal v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<form asp-action="PostCount" method="post" id="f" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    <input type="hidden" name="linesJson" id="linesJson" />
    <input type="hidden" name="warehouseId" value="@fWh" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["New Stock Count"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("StockCounts","Inventory")" class="text-muted text-hover-primary">@Localizer["Counts"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["New"]</li></ul></div>
        <div class="d-flex gap-2"><a href="@Url.Action("StockCounts","Inventory")" class="btn btn-light">@SR["Cancel"]</a>@if (fWh != null) { <button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@Localizer["Post count"]</button> } else { <button type="button" class="btn btn-light-primary" disabled><i class="ki-outline ki-check fs-2"></i>@Localizer["Select a warehouse first"]</button> }</div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body"><div class="row g-5 align-items-end">
            <div class="col-md-4"><label class="required fw-semibold fs-6 mb-2">@SR["Warehouse"]</label>
                <select id="whSel" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["Select to load items"]</option>@foreach (var w in whs) { <option value="@w.ID" selected="@(fWh==w.ID)">@w.Code — @(isAr ? w.Name : DisplayName.Or(w.NameEn, w.Name))</option> }</select></div>
            <div class="col-md-3"><label class="required fw-semibold fs-6 mb-2">@Localizer["Count date"]</label><input type="text" name="countDate" class="form-control form-control-solid" data-control="flatpickr" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-5"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" /></div>
        </div></div></div>

        @if (fWh == null)
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-information-5 fs-3x text-muted mb-3 d-block"></i>@Localizer["Select a warehouse to load its items and book balances."]</div></div>
        }
        else
        {
            <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@Localizer["Items & counted quantities"]</h3></div>
            <div class="card-body">
                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-4 mb-5"><span class="fs-8 text-gray-700">@Localizer["Expiry-tracked items are counted per batch. A batch you do not tick is treated as NOT counted — left untouched and reported as uncounted (its stock is never zeroed)."]</span></div>
                <div class="table-responsive"><table class="table table-row-bordered align-middle"><thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                <th style="width:44px"></th><th style="min-width:260px">@SR["Item"]</th><th>@Localizer["Batch"]</th><th class="text-end" style="width:120px">@Localizer["Book qty"]</th><th class="text-end" style="width:130px">@Localizer["Counted"]</th><th class="text-end" style="width:110px">@Localizer["Diff"]</th>
            </tr></thead><tbody id="rows">
                @foreach (var b in book)
                {
                    int iid = (int)b.ItemId; decimal bq = (decimal)b.QtyOnHand;
                    var it = itemById.TryGetValue(iid, out var iv) ? iv : null;
                    bool tracked = it != null && it.TrackExpiry;
                    if (!tracked)
                    {
                        <tr data-item="@iid" data-tracked="0" data-book="@Inv(bq)" data-counted="1">
                            <td></td>
                            <td class="fw-bold text-gray-800">@(it == null ? ("#"+iid) : Nm(it))</td>
                            <td class="text-muted fs-8">—</td>
                            <td class="text-end text-muted bookc">@bq.ToString("0.##")</td>
                            <td class="text-end"><input type="number" step="0.0001" class="form-control form-control-solid form-control-sm text-end counted" value="@Inv(bq)"></td>
                            <td class="text-end fw-bold diff">0</td>
                        </tr>
                    }
                    else
                    {
                        var bats = batchByItem.TryGetValue(iid, out var bl) ? bl : new List<dynamic>();
                        <tr class="bg-light-primary"><td colspan="6" class="fw-bold text-gray-800 py-2">@(it == null ? ("#"+iid) : Nm(it)) <span class="badge badge-light-primary ms-2">@Localizer["Expiry-tracked"]</span> <button type="button" class="btn btn-sm btn-light-primary py-1 px-3 ms-2 js-addbatch" data-item="@iid">+ @Localizer["Unlisted batch"]</button></td></tr>
                        foreach (var bt in bats)
                        {
                            decimal bbq = (decimal)bt.Qty; string bno = (string)bt.BatchNo; string exp = bt.ExpiryDate == null ? "" : ((DateTime)bt.ExpiryDate).ToString("yyyy-MM-dd");
                            <tr data-item="@iid" data-tracked="1" data-batch="@bno" data-expiry="@exp" data-book="@Inv(bbq)" data-counted="0">
                                <td class="text-center"><input type="checkbox" class="form-check-input countck"></td>
                                <td class="text-muted fs-8">↳</td>
                                <td><span class="fw-semibold">@bno</span> @if (!string.IsNullOrEmpty(exp)) { <span class="text-muted fs-8">· @exp</span> }</td>
                                <td class="text-end text-muted bookc">@bbq.ToString("0.##")</td>
                                <td class="text-end"><input type="number" step="0.0001" class="form-control form-control-solid form-control-sm text-end counted" value="@Inv(bbq)" disabled></td>
                                <td class="text-end fw-bold diff text-muted">@Localizer["not counted"]</td>
                            </tr>
                        }
                    }
                }
            </tbody></table></div>
            @if (book.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No balances in this warehouse."]</div> }
            </div></div>
        }
    </div></div>
</form>
@section Scripts {
<script>
var whSel=document.getElementById('whSel');
if(whSel){ var go=function(){ location.href='?warehouseId='+(whSel.value||''); }; if(window.CB&&CB.onSelectChange)CB.onSelectChange(whSel,go); else whSel.addEventListener('change',go); }
var rowsEl=document.getElementById('rows');
function recalc(tr){
  if(tr.getAttribute('data-counted')!=='1'){ var d0=tr.querySelector('.diff'); d0.textContent=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["not counted"].Value)); d0.className='text-end fw-bold diff text-muted'; return; }
  var b=parseFloat(tr.getAttribute('data-book'))||0; var c=parseFloat(tr.querySelector('.counted').value)||0; var d=Math.round((c-b)*10000)/10000;
  var el=tr.querySelector('.diff'); el.textContent=(d>0?'+':'')+d; el.className='text-end fw-bold diff '+(d<0?'text-danger':(d>0?'text-primary':'text-muted'));
}
if(rowsEl){
  rowsEl.addEventListener('input',function(e){ if(e.target.classList.contains('counted')) recalc(e.target.closest('tr')); });
  rowsEl.addEventListener('change',function(e){
    if(e.target.classList.contains('countck')){ var tr=e.target.closest('tr'); var on=e.target.checked; tr.setAttribute('data-counted',on?'1':'0'); tr.querySelector('.counted').disabled=!on; tr.classList.toggle('opacity-50',!on); recalc(tr); }
    if(e.target.classList.contains('js-newexp')){ e.target.closest('tr').setAttribute('data-expiry',e.target.value); }
  });
  rowsEl.addEventListener('click',function(e){ var btn=e.target.closest('.js-addbatch'); if(!btn) return; addBatchRow(parseInt(btn.getAttribute('data-item')), btn.closest('tr')); });
  [].slice.call(rowsEl.querySelectorAll('tr[data-item]')).forEach(recalc);
}
function addBatchRow(iid, headerTr){
  var tr=document.createElement('tr'); tr.setAttribute('data-item',iid); tr.setAttribute('data-tracked','1'); tr.setAttribute('data-book','0'); tr.setAttribute('data-counted','1'); tr.setAttribute('data-batch',''); tr.setAttribute('data-expiry','');
  tr.innerHTML='<td></td><td class="text-muted fs-8">↳ new</td>'+
    '<td class="d-flex gap-1"><input class="form-control form-control-solid form-control-sm js-newbatch" placeholder="@Localizer["Batch no"]" style="width:110px"><input type="date" class="form-control form-control-solid form-control-sm js-newexp" style="width:140px"></td>'+
    '<td class="text-end text-muted">0</td>'+
    '<td class="text-end"><input type="number" step="0.0001" class="form-control form-control-solid form-control-sm text-end counted" value="1"></td>'+
    '<td class="text-end fw-bold diff text-primary">+1</td>';
  headerTr.parentNode.insertBefore(tr, headerTr.nextSibling);
  tr.querySelector('.js-newbatch').addEventListener('input',function(){ tr.setAttribute('data-batch',this.value); });
  tr.querySelector('.js-newexp').addEventListener('input',function(){ tr.setAttribute('data-expiry',this.value); });
  recalc(tr);
}
var saveBtn=document.getElementById('save');
if(saveBtn) saveBtn.addEventListener('click',function(){
  var lines=[], missingExp=false;
  [].slice.call(rowsEl.querySelectorAll('tr[data-item]')).forEach(function(tr){
    if(tr.getAttribute('data-counted')!=='1') return;   // uncounted batch → left untouched (reported as uncounted)
    var id=parseInt(tr.getAttribute('data-item')); var c=parseFloat(tr.querySelector('.counted').value);
    if(!id||isNaN(c)) return;
    var tracked=tr.getAttribute('data-tracked')==='1'; var bn=tr.getAttribute('data-batch')||''; var ex=tr.getAttribute('data-expiry')||'';
    if(tracked && !bn) return;
    var line={itemId:id, countedQty:c}; if(tracked){ line.batchNo=bn; if(ex) line.expiry=ex; }
    lines.push(line);
  });
  if(!lines.length){ alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Tick at least one batch/item to count"].Value))); return; }
  CB.confirm({type:'generic', text:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Post this stock count and create variance adjustments?"].Value))}).then(function(ok){
    if(!ok) return;
    document.getElementById('linesJson').value=JSON.stringify(lines); document.getElementById('f').submit();
  });
});
</script>
}
