@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var items = ViewBag.Items as List<Item> ?? new();
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    int? fWh = ViewBag.FilterWarehouseId;
    var book = ((IEnumerable<dynamic>)(ViewBag.BookBalances ?? new List<object>())).ToList();
    var itemById = items.ToDictionary(i => i.ID, i => i);
}
<form asp-action="PostCount" method="post" id="f" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    <input type="hidden" name="linesJson" id="linesJson" />
    <input type="hidden" name="warehouseId" value="@fWh" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["New Stock Count"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("StockCounts","Inventory")" class="text-muted text-hover-primary">@Localizer["Counts"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["New"]</li></ul></div>
        <div class="d-flex gap-2"><a href="@Url.Action("StockCounts","Inventory")" class="btn btn-light">@SR["Cancel"]</a>@if (fWh != null) { <button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@Localizer["Post count"]</button> } else { <button type="button" class="btn btn-light-primary" disabled><i class="ki-outline ki-check fs-2"></i>@Localizer["Select a warehouse first"]</button> }</div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body"><div class="row g-5 align-items-end">
            <div class="col-md-4"><label class="required fw-semibold fs-6 mb-2">@SR["Warehouse"]</label>
                <select id="whSel" class="form-select form-select-solid" data-control="select2"><option value="">@Localizer["Select to load items"]</option>@foreach (var w in whs) { <option value="@w.ID" selected="@(fWh==w.ID)">@w.Code — @(isAr ? w.Name : w.NameEn)</option> }</select></div>
            <div class="col-md-3"><label class="required fw-semibold fs-6 mb-2">@Localizer["Count date"]</label><input type="text" name="countDate" class="form-control form-control-solid" data-control="flatpickr" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-5"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" /></div>
        </div></div></div>

        @if (fWh == null)
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-information-5 fs-3x text-muted mb-3 d-block"></i>@Localizer["Select a warehouse to load its items and book balances."]</div></div>
        }
        else
        {
            <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@Localizer["Items & counted quantities"]</h3><div class="card-toolbar d-flex gap-2"><div class="position-relative d-flex align-items-center"><i class="ki-outline ki-barcode fs-2 position-absolute ms-3"></i><input class="form-control form-control-solid form-control-sm w-220px ps-10 js-barcode-scan" placeholder="@Localizer["Scan to add item"]" autocomplete="off" /></div></div></div>
            <div class="card-body"><div class="table-responsive"><table class="table table-row-bordered align-middle"><thead><tr class="fw-bold fs-7 text-uppercase text-muted">
                <th style="min-width:260px">@SR["Item"]</th><th class="text-end" style="width:130px">@Localizer["Book qty"]</th><th class="text-end" style="width:130px">@Localizer["Counted"]</th><th class="text-end" style="width:120px">@Localizer["Diff"]</th>
            </tr></thead><tbody id="rows">
                @foreach (var b in book)
                {
                    int iid = (int)b.ItemId; decimal bq = (decimal)b.QtyOnHand;
                    var it = itemById.TryGetValue(iid, out var iv) ? iv : null;
                    <tr data-item="@iid" data-book="@bq.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <td class="fw-bold text-gray-800">@(it == null ? ("#"+iid) : (it.ItemCode + " — " + (isAr ? it.Name : (string.IsNullOrEmpty(it.NameEn) ? it.Name : it.NameEn))))</td>
                        <td class="text-end text-muted bookc">@bq.ToString("0.##")</td>
                        <td class="text-end"><input type="number" step="0.0001" class="form-control form-control-solid form-control-sm text-end counted" value="@bq.ToString(System.Globalization.CultureInfo.InvariantCulture)"></td>
                        <td class="text-end fw-bold diff">0</td>
                    </tr>
                }
            </tbody></table></div>
            @if (book.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No balances in this warehouse — scan/add items manually."]</div> }
            </div></div>
        }
    </div></div>
</form>
<partial name="_ItemScanModal" />
<partial name="~/Views/Shared/_QuickAdd.cshtml" />
@section Scripts {
<script>
var ITEMS=[]; // scan provides code/name directly; no full-catalog preload
var whSel=document.getElementById('whSel');
if(whSel){ var go=function(){ location.href='?warehouseId='+(whSel.value||''); }; if(window.jQuery&&jQuery(whSel).data('select2'))jQuery(whSel).on('change',go); else whSel.addEventListener('change',go); }
function recalc(tr){ var b=parseFloat(tr.getAttribute('data-book'))||0; var c=parseFloat(tr.querySelector('.counted').value)||0; var d=Math.round((c-b)*10000)/10000; var el=tr.querySelector('.diff'); el.textContent=(d>0?'+':'')+d; el.className='text-end fw-bold diff '+(d<0?'text-danger':(d>0?'text-primary':'text-muted')); }
var rowsEl=document.getElementById('rows');
if(rowsEl){
  rowsEl.addEventListener('input',function(e){ if(e.target.classList.contains('counted')) recalc(e.target.closest('tr')); });
  [].slice.call(rowsEl.querySelectorAll('tr')).forEach(recalc);
}
function findItem(id){ for(var i=0;i<ITEMS.length;i++) if(ITEMS[i].iD===id) return ITEMS[i]; return null; }
window.onItemScanned=function(p){
  if(!rowsEl) return;
  var ex=rowsEl.querySelector('tr[data-item="'+p.id+'"]');
  if(ex){ var ci=ex.querySelector('.counted'); ci.value=(parseFloat(ci.value)||0)+(p.qty||1); recalc(ex); return; }
  var it=findItem(p.id)||{itemCode:p.code,name:p.name};
  var tr=document.createElement('tr'); tr.setAttribute('data-item',p.id); tr.setAttribute('data-book','0');
  tr.innerHTML='<td class="fw-bold text-gray-800">'+it.itemCode+' — '+(it.name||'')+'</td><td class="text-end text-muted bookc">0</td><td class="text-end"><input type="number" step="0.0001" class="form-control form-control-solid form-control-sm text-end counted" value="'+(p.qty||1)+'"></td><td class="text-end fw-bold diff">0</td>';
  rowsEl.appendChild(tr); recalc(tr);
};
var saveBtn=document.getElementById('save');
if(saveBtn) saveBtn.addEventListener('click',function(){
  var lines=[]; [].slice.call(rowsEl.querySelectorAll('tr')).forEach(function(tr){ var id=parseInt(tr.getAttribute('data-item')); var c=parseFloat(tr.querySelector('.counted').value); if(id&&!isNaN(c)) lines.push({itemId:id,countedQty:c}); });
  if(!lines.length){ alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["No items"].Value))); return; }
  CB.confirm({type:'generic', text:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Post this stock count and create variance adjustments?"].Value))}).then(function(ok){
    if(!ok) return;
    document.getElementById('linesJson').value=JSON.stringify(lines); document.getElementById('f').submit();
  });
});
</script>
}
