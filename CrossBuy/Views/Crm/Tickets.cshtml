@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var s = ((int open, int breachedFr, int breachedRes))(ViewBag.Stats ?? (0, 0, 0));
    var priorities = new[] { ("Urgent", Localizer["Urgent"].Value), ("High", Localizer["High"].Value), ("Normal", Localizer["Normal"].Value), ("Low", Localizer["Low"].Value) };
    var statuses = new[] { ("New", Localizer["New"].Value), ("Open", Localizer["Open"].Value), ("Pending", Localizer["Pending"].Value), ("Resolved", Localizer["Resolved"].Value), ("Closed", Localizer["Closed"].Value) };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Tickets"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Crm")" class="text-muted">CRM</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Tickets"]</li></ul></div>
        <a href="@Url.Action("TicketEditor","Crm")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New ticket"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["CrmMsg"] != null) { <div class="alert alert-success">@TempData["CrmMsg"]</div> }
        @if (TempData["CrmErr"] != null) { <div class="alert alert-danger">@TempData["CrmErr"]</div> }

        @{
            string Raw(decimal v) => v.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);   // invariant countUp value
            // (value, raw, label, sub, icon, bg-tint, fg-color)
            var cards = new (int value, string label, string sub, string icon, string bg, string fg)[] {
                (s.open, Localizer["Open tickets"].Value, Localizer["Active"].Value, "ki-questionnaire-tablet", "#eaf3ef", "#13433a"),
                (s.breachedFr, Localizer["First-response breached"].Value, s.breachedFr > 0 ? Localizer["Breached"].Value : Localizer["On track"].Value, "ki-timer", s.breachedFr > 0 ? "#fdeaea" : "#eaf3ef", s.breachedFr > 0 ? "#d92d20" : "#13433a"),
                (s.breachedRes, Localizer["Resolution breached"].Value, s.breachedRes > 0 ? Localizer["Breached"].Value : Localizer["On track"].Value, "ki-shield-cross", s.breachedRes > 0 ? "#fdeaea" : "#eaf3ef", s.breachedRes > 0 ? "#d92d20" : "#13433a"),
            };
        }
        <div class="row g-3 g-xl-5 mb-5">
            @foreach (var c in cards)
            {
                <div class="col-md-4">
                    <div class="card card-flush h-100">
                        <div class="card-body d-flex flex-stack p-5">
                            <div class="d-flex flex-column me-2">
                                <span class="text-gray-900 fw-bold fs-2x lh-1 ls-n2" data-kt-countup="true" data-kt-countup-value="@Raw(c.value)">@c.value</span>
                                <span class="text-muted fw-semibold fs-7 mt-2">@c.label</span>
                                <span class="fw-semibold fs-8 mt-1" style="color:@c.fg">@c.sub</span>
                            </div>
                            <span class="symbol symbol-45px"><span class="symbol-label" style="background:@c.bg;"><i class="ki-outline @c.icon fs-2x" style="color:@c.fg;"></i></span></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-6"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@Localizer["Search (subject / account)"]</label>
                <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@Localizer["Add search terms…"]" /></div>
            <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Status"]</label>
                <select id="f_status" class="form-select form-select-solid cb-filter" data-hide-search="true"><option value="">@SR["All"]</option>@foreach (var st in statuses) { <option value="@st.Item1">@st.Item2</option> }</select></div>
            <div class="col-md-2"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Priority"]</label>
                <select id="f_priority" class="form-select form-select-solid cb-filter" data-hide-search="true"><option value="">@SR["All"]</option>@foreach (var p in priorities) { <option value="@p.Item1">@p.Item2</option> }</select></div>
            <div class="col-md-2"><button type="button" id="f_reset" class="btn btn-light w-100"><i class="ki-outline ki-arrows-circle fs-3"></i> @SR["Reset"]</button></div>
        </div></div></div>

        <div class="card"><div class="card-header border-0 pt-6"><div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
            <div class="card-toolbar"><select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #13433a;"><th class="ps-4">#</th><th>@Localizer["Subject"]</th><th>@SR["Account"]</th><th class="text-center">@Localizer["Priority"]</th><th class="text-center">@SR["Status"]</th><th class="text-center">SLA</th><th>@Localizer["Created"]</th><th class="text-end pe-4">@Localizer["Open"]</th></tr></thead>
                <tbody id="rows"></tbody>
            </table></div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Loading…"]</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@Localizer["No tickets"]</div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
cbServerList({ url:'@Url.Action("TicketsData","Crm")', isAr:@(isAr ? "true" : "false"),
  addParams:function(p){ var st=document.getElementById('f_status'), pr=document.getElementById('f_priority'); if(st&&st.value)p.set('status',st.value); if(pr&&pr.value)p.set('priority',pr.value); } });
</script>
}
