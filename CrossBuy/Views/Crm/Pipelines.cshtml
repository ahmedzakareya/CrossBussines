@using CrossBuy.Models.Context.Crm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var pipelines = ViewBag.Pipelines as List<CrmPipeline> ?? new();
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Pipelines"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Crm")" class="text-muted">CRM</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Pipelines"]</li></ul></div>
        <a href="@Url.Action("PipelineEditor","Crm")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New pipeline"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card"><div class="card-body pt-6"><div class="table-responsive">
            <table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@SR["Name"]</th><th class="text-center">@Localizer["Default"]</th><th class="text-center">@SR["Status"]</th><th class="text-end pe-4">@SR["Edit"]</th></tr></thead>
                <tbody>
                @foreach (var p in pipelines)
                {
                    <tr style="border-bottom:1px dashed #eef1f6;">
                        <td class="ps-4 fw-bold text-gray-900"><a href="@Url.Action("PipelineEditor","Crm", new { id = p.ID })" class="text-gray-900 text-hover-primary">@(isAr ? p.Name : (p.NameEn ?? p.Name))</a></td>
                        <td class="text-center">@if (p.IsDefault) { <span class="badge fw-bold" style="background:#E7F0FF;color:#0E4A9E;">@Localizer["Default"]</span> }</td>
                        <td class="text-center"><span class="badge fw-bold" style="@(p.IsActive?"background:#E7F0FF;color:#0E4A9E;":"background:#f2f4f7;color:#475467;")">@(p.IsActive?SR["Active"].Value:SR["Inactive"].Value)</span></td>
                        <td class="text-end pe-4"><a href="@Url.Action("PipelineEditor","Crm", new { id = p.ID })" class="btn btn-sm btn-icon btn-light-primary"><i class="ki-outline ki-pencil fs-5"></i></a></td>
                    </tr>
                }
                @if (pipelines.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-10">@Localizer["No pipelines — create one"]</td></tr> }
                </tbody>
            </table>
        </div></div></div>
    </div></div>
</div>
