@model CrossBuy.BL.CrmIdentity.BookingLinkView
@inject Microsoft.Extensions.Localization.IStringLocalizer<CrossBuy.CrmResources> T
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var l = Model.Link; var origin = (string)ViewBag.Origin;
    var url = l.ID > 0 ? origin + "/store/meet/" + l.PublicKey : null;
    var ics = l.ID > 0 ? origin + "/store/cal/" + l.CalendarToken + ".ics" : null;
    string Initials(string? s) { var w = (s ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return ((w.Length > 0 ? w[0][..1] : "") + (w.Length > 1 ? w[1][..1] : "")).ToUpperInvariant(); }
    var ini = Initials(Model.Person.Name);
}
@section Styles { <link href="~/css/crm-identity.css" rel="stylesheet" asp-append-version="true" /> }
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["My booking link"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Sequences","Crm")" class="text-muted text-hover-primary">@T["Follow-up sequences"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["My booking link"]</li></ul></div>
        @if (url != null && l.IsActive) { <a href="@url" target="_blank" rel="noopener" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-eye fs-4"></i>@T["Open my booking page"]</a> }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @Html.AntiForgeryToken()
        <div class="row g-5">
            <div class="col-xl-5"><div class="card h-100"><div class="card-body">
                <div class="d-flex align-items-center gap-4 mb-6"><div class="symbol symbol-60px symbol-circle">@if (Model.Person.HasPhoto) { <img src="/People/Photo/@Model.Person.EmployeeId" alt="" onerror="this.outerHTML='<span class=&quot;symbol-label crm-initials fs-3&quot;>@ini</span>'" /> } else { <span class="symbol-label crm-initials fs-3">@ini</span> }</div>
                    <div><div class="fw-bold fs-4">@Model.Person.Name</div><div class="text-muted fs-7">@T["Customers pick a free time from your own working calendar — your days off, public holidays, approved leave and the meetings already in the CRM are never offered."]</div></div></div>
                <div class="mb-5"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["Title the customer sees"]</label><input id="bTitle" class="form-control form-control-solid" maxlength="150" value="@l.Title" placeholder="@T["A 30-minute call to discuss your needs"]" /></div>
                <div class="row g-4 mb-5">
                    <div class="col-6"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["Meeting length"]</label><select id="bDur" class="form-select form-select-solid" data-control="select2" data-hide-search="true">@foreach (var m in new[] { 15, 30, 45, 60, 90 }) { <option value="@m" selected="@(l.DurationMinutes == m)">@m @T["minutes"]</option> }</select></div>
                    <div class="col-6"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["Gap between meetings"]</label><select id="bBuf" class="form-select form-select-solid" data-control="select2" data-hide-search="true">@foreach (var m in new[] { 0, 5, 10, 15, 30 }) { <option value="@m" selected="@(l.BufferMinutes == m)">@m @T["minutes"]</option> }</select></div>
                    <div class="col-6"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["Bookable days ahead"]</label><input id="bDays" type="number" min="1" max="60" class="form-control form-control-solid num" value="@l.DaysAhead" /></div>
                    <div class="col-6"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["Minimum notice (hours)"]</label><input id="bNotice" type="number" min="0" max="168" class="form-control form-control-solid num" value="@l.MinNoticeHours" /></div>
                </div>
                <label class="form-check form-switch form-check-custom form-check-solid mb-6"><input class="form-check-input" type="checkbox" id="bActive" @(l.ID == 0 || l.IsActive ? "checked" : "") /><span class="form-check-label fw-semibold">@T["The link is open for bookings"]</span></label>
                <button type="button" class="btn btn-primary" id="bSave"><i class="ki-outline ki-check fs-4"></i>@(l.ID == 0 ? T["Create my link"] : T["Save"])</button>
                <div class="text-danger fs-7 fw-semibold mt-3 d-none" id="bErr"></div>
                @if (url != null)
                {
                    <div class="separator my-6"></div>
                    <div class="fw-bold fs-7 mb-2">@T["Your link"]</div>
                    <div class="d-flex gap-2 mb-1"><input class="form-control form-control-sm form-control-solid num" dir="ltr" readonly value="@url" id="bUrl" /><button type="button" class="btn btn-sm btn-light-primary" data-copy="bUrl">@T["Copy"]</button></div>
                    <div class="fs-8 text-muted mb-5">@T["Sequences can put it in a message with {booking}."].Value</div>
                    <div class="fw-bold fs-7 mb-2"><i class="ki-outline ki-calendar-2 fs-6"></i> @T["See your CRM calendar in Outlook or Google"]</div>
                    <div class="d-flex gap-2 mb-1"><input class="form-control form-control-sm form-control-solid num" dir="ltr" readonly value="@ics" id="bIcs" /><button type="button" class="btn btn-sm btn-light-primary" data-copy="bIcs">@T["Copy"]</button></div>
                    <div class="fs-8 text-muted">@T["In Outlook: Add calendar → Subscribe from web. In Google Calendar: Other calendars → From URL. Keep this address to yourself: it shows your CRM meetings, calls and tasks."]</div>
                }
            </div></div></div>
            <div class="col-xl-7"><div class="card h-100"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start m-0"><span class="fw-bold fs-4 text-gray-900">@T["Booked meetings"]</span><span class="text-muted fs-7 mt-1">@T["Each one is also a meeting activity on the person, with a reminder 30 minutes before."]</span></div></div>
                <div class="card-body pt-2"><div class="table-responsive"><table class="table align-middle gy-3 mb-0 crm-table">
                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-4">@T["When"]</th><th>@T["Who"]</th><th>@T["Their note"]</th><th class="pe-4">@T["In the CRM"]</th></tr></thead>
                    <tbody class="fs-6">
                    @foreach (var b in Model.Upcoming)
                    {
                        var st = b.StartsAt.ToLocalTime();
                        <tr class="@(b.EndsAt < DateTime.UtcNow ? "opacity-50" : "")"><td class="ps-4 text-nowrap"><div class="fw-bold num">@st.ToString("yyyy-MM-dd")</div><div class="text-muted fs-8 num">@st.ToString("HH:mm") – @b.EndsAt.ToLocalTime().ToString("HH:mm")</div></td>
                            <td><div class="fw-semibold">@b.Name</div><div class="text-muted fs-8 num">@(b.Phone ?? b.Email)</div></td>
                            <td class="fs-7 text-gray-700">@b.Note</td>
                            <td class="pe-4">@if (b.ContactId != null) { <a href="@Url.Action("Contact","Crm", new { id = b.ContactId })" class="badge badge-light-primary">@T["Contact"]</a> }
                                else if (b.LeadId != null) { <a href="@Url.Action("Leads","Crm", new { q = b.Name })" class="badge badge-light-primary">@T["kind:Lead"]</a> }
                                else { <span class="badge badge-light">@T["Being filed…"]</span> }</td></tr>
                    }
                    @if (Model.Upcoming.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-10">@T["No meeting booked yet."]</td></tr> }
                    </tbody></table></div></div></div></div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
(function(){
  var txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["failed"] = T["Could not save. Refresh the page and try again."].Value, ["copied"] = T["Copied"].Value }));
  document.querySelectorAll('[data-copy]').forEach(function(b){ b.addEventListener('click', function(){ var i = document.getElementById(b.getAttribute('data-copy')); i.select(); navigator.clipboard && navigator.clipboard.writeText(i.value); if (window.CB && CB.toast) CB.toast(txt.copied, 'success'); }); });
  document.getElementById('bSave').addEventListener('click', async function(){
    var fd = new FormData();
    fd.append('title', document.getElementById('bTitle').value); fd.append('duration', document.getElementById('bDur').value); fd.append('buffer', document.getElementById('bBuf').value);
    fd.append('daysAhead', document.getElementById('bDays').value); fd.append('notice', document.getElementById('bNotice').value); fd.append('isActive', document.getElementById('bActive').checked ? 'true' : 'false');
    fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
    var r = await fetch('@Url.Action("SaveBookingLink","Crm")', { method:'POST', body:fd, credentials:'same-origin' }).then(function(x){ return x.json(); }).catch(function(){ return { ok:false, error: txt.failed }; });
    if (r.ok) location.reload(); else { var e = document.getElementById('bErr'); e.textContent = r.error || txt.failed; e.classList.remove('d-none'); }
  });
})();
</script>
}
