@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<ListRow>
@{
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
@foreach (var l in Model)
{
    <tr style="border-bottom:1px dashed #eef1f6;">
        <td class="ps-4 fw-bold text-gray-800">@(isAr ? l.Name : (string.IsNullOrEmpty(l.NameEn) ? l.Name : l.NameEn))</td>
        <td class="text-muted">@{ var desc = isAr ? l.Description : (string.IsNullOrEmpty(l.DescriptionEn) ? l.Description : l.DescriptionEn); }@(string.IsNullOrEmpty(desc) ? "—" : desc)</td>
        <td class="text-center"><span class="badge fw-bold" style="background:#E7F0FF;color:#0E4A9E;">@l.Members</span></td>
        <td class="text-center"><span class="badge fw-bold" style="@(l.IsActive ? "background:#E7F0FF;color:#0E4A9E;" : "background:#f2f4f7;color:#475467;")">@(l.IsActive ? SR["Active"] : SR["Inactive"])</span></td>
        <td class="text-end pe-4"><a href="@Url.Action("ListEditor","Crm", new { id = l.Id })" class="btn btn-sm btn-icon btn-light-primary" title="@Localizer["Open"]"><i class="ki-outline ki-eye fs-6"></i></a></td>
    </tr>
}
