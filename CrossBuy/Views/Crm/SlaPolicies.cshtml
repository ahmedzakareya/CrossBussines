@using CrossBuy.Models.Context.Crm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var policies = ViewBag.Policies as List<CrmSlaPolicy> ?? new();
    var priorities = new[] { ("Urgent", Localizer["Urgent"].Value), ("High", Localizer["High"].Value), ("Normal", Localizer["Normal"].Value), ("Low", Localizer["Low"].Value) };
    string prNm(string p) => priorities.FirstOrDefault(x => x.Item1 == p).Item2 ?? p;
    // brand-safe priority colours (match the Tickets screen): red urgent / amber high / green normal / gray low
    string prStyle(string p) => p switch { "Urgent" => "background:#fdeaea;color:#d92d20;", "High" => "background:#fef3e2;color:#b96a00;", "Low" => "background:#f2f4f7;color:#475467;", _ => "background:#eaf3ef;color:#13433a;" };
    string mins(int m) => m >= 60 ? (m / 60) + Localizer["hUnit"].Value + (m % 60 > 0 ? " " + (m % 60) + Localizer["mUnit"].Value : "") : m + Localizer["mUnit"].Value;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["SLA policies"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Tickets","Crm")" class="text-muted text-hover-primary">@Localizer["Tickets"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">SLA</li></ul></div>
        <button type="button" class="btn btn-sm btn-primary" onclick="slaNew()"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New policy"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["CrmMsg"] != null) { <div class="alert alert-success">@TempData["CrmMsg"]</div> }
        @if (TempData["CrmErr"] != null) { <div class="alert alert-danger">@TempData["CrmErr"]</div> }

        <!--begin::SLA policy modal-->
        <div class="modal fade" id="slaModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered mw-650px">
                <div class="modal-content">
                    <div class="modal-header py-4"><h2 class="fw-bold fs-4 m-0" id="formTitle">@Localizer["New policy"]</h2>
                        <div class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
                    <div class="modal-body">
                        <form asp-action="SaveSlaPolicy" method="post" class="row g-4" id="slaForm" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Save policy?"]">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" id="f_id" value="0" />
                            <div class="col-md-8"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Name"]</label><input name="name" id="f_name" class="form-control form-control-solid" required /></div>
                            <div class="col-md-4"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Priority"]</label>
                                <select name="priority" id="f_priority" class="form-select form-select-solid">@foreach (var p in priorities) { <option value="@p.Item1">@p.Item2</option> }</select></div>
                            <div class="col-md-6"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["First response (min)"]</label><input type="number" min="1" name="firstResponseMins" id="f_fr" class="form-control form-control-solid" value="240" required /></div>
                            <div class="col-md-6"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Resolution (min)"]</label><input type="number" min="1" name="resolutionMins" id="f_res" class="form-control form-control-solid" value="1440" required /></div>
                            <div class="col-12"><div class="form-check form-switch"><input type="hidden" name="isActive" value="false" /><input class="form-check-input" type="checkbox" name="isActive" value="true" id="f_active" checked><label class="form-check-label fw-semibold ms-1 fs-7" for="f_active">@SR["Active"]</label></div></div>
                            <div class="col-12 d-flex justify-content-end gap-2"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary"><i class="ki-outline ki-check fs-4"></i>@SR["Save"]</button></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!--end::SLA policy modal-->

        <div class="card"><div class="card-header"><div class="card-title fw-bold">@Localizer["Policies"] (@policies.Count)</div></div>
            <div class="card-body">
                <div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #13433a;"><th class="ps-4">@SR["Name"]</th><th class="text-center">@Localizer["Priority"]</th><th class="text-center">@Localizer["First response"]</th><th class="text-center">@Localizer["Resolution"]</th><th class="text-center">@SR["Status"]</th><th class="text-end pe-4"></th></tr></thead>
                    <tbody>
                    @foreach (var p in policies)
                    {
                        <tr data-id="@p.ID" data-name="@p.Name" data-priority="@p.Priority" data-fr="@p.FirstResponseMins" data-res="@p.ResolutionMins" data-active="@(p.IsActive ? "true" : "false")" style="border-bottom:1px dashed #eef1f6;">
                            <td class="ps-4 fw-bold text-gray-800">@p.Name</td>
                            <td class="text-center"><span class="badge fw-bold" style="@prStyle(p.Priority)">@prNm(p.Priority)</span></td>
                            <td class="text-center">@mins(p.FirstResponseMins)</td>
                            <td class="text-center">@mins(p.ResolutionMins)</td>
                            <td class="text-center"><span class="badge fw-bold" style="@(p.IsActive ? "background:#eaf3ef;color:#13433a;" : "background:#f2f4f7;color:#475467;")">@(p.IsActive ? SR["Active"].Value : Localizer["Off"].Value)</span></td>
                            <td class="text-end pe-4"><button class="btn btn-sm btn-icon btn-light-primary" onclick="slaEdit(this)" title="@SR["Edit"]"><i class="ki-outline ki-pencil fs-6"></i></button></td>
                        </tr>
                    }
                    @if (policies.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-8">@Localizer["No policies — add one per priority"]</td></tr> }
                    </tbody>
                </table></div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
function slaModal(){ return new bootstrap.Modal(document.getElementById('slaModal')); }
function slaNew(){
  document.getElementById('f_id').value='0';
  document.getElementById('f_name').value='';
  document.getElementById('f_priority').value='Normal';
  document.getElementById('f_fr').value='240';
  document.getElementById('f_res').value='1440';
  document.getElementById('f_active').checked=true;
  document.getElementById('formTitle').textContent='@Localizer["New policy"]';
  slaModal().show();
}
function slaEdit(btn){ var tr=btn.closest('tr');
  document.getElementById('f_id').value=tr.dataset.id;
  document.getElementById('f_name').value=tr.dataset.name;
  document.getElementById('f_priority').value=tr.dataset.priority;
  document.getElementById('f_fr').value=tr.dataset.fr;
  document.getElementById('f_res').value=tr.dataset.res;
  document.getElementById('f_active').checked = tr.dataset.active==='true';
  document.getElementById('formTitle').textContent='@Localizer["Edit policy"]'+' #'+tr.dataset.id;
  slaModal().show();
}
</script>
}
