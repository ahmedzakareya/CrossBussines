@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var employees = ViewBag.Employees as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var assignments = ViewBag.Assignments as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var roles = new (string v, string ar, string en)[] {
        ("SalesManager","مدير مبيعات","Sales manager"), ("SalesRep","مندوب مبيعات","Sales rep"),
        ("Marketing","تسويق","Marketing"), ("CrmViewer","قارئ CRM","CRM viewer") };
    string roleName(string r) => roles.FirstOrDefault(x => x.v == r) is var m && m.v != null ? (isAr ? m.ar : m.en) : r;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["CRM Roles"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Crm")" class="text-muted">CRM</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Roles"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="alert alert-light-primary border border-primary border-dashed d-flex align-items-center p-4 mb-5">
            <i class="ki-outline ki-information-5 fs-2 text-primary me-3"></i>
            <span class="fs-7 text-gray-700">@Localizer["Sales rep sees own records; manager sees the team; Marketing manages leads/campaigns; CRM viewer is read-only. (Open until the first role is assigned.)"]</span>
        </div>
        <div class="row g-5">
            <div class="col-lg-5">
                <div class="card card-flush"><div class="card-header"><div class="card-title"><h2>@Localizer["Assign role"]</h2></div></div>
                    <div class="card-body">
                        <form asp-action="AssignCrmRole" method="post" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Assign role?"]">@Html.AntiForgeryToken()
                            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Employee"]</label>
                                <select name="employeeId" class="form-select form-select-solid" data-control="select2" required><option value="">@Localizer["Select"]</option>
                                    @foreach (var e in employees) { <option value="@e.ID">@e.FullName</option> }</select></div>
                            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Role"]</label>
                                <select name="role" class="form-select form-select-solid">@foreach (var r in roles) { <option value="@r.v">@(isAr ? r.ar : r.en)</option> }</select></div>
                            <button class="btn btn-primary"><i class="ki-outline ki-check fs-3"></i>@Localizer["Assign"]</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card card-flush"><div class="card-header"><div class="card-title"><h2>@Localizer["Assigned roles"]</h2></div></div>
                    <div class="card-body pt-2">
                        <div class="table-responsive">
                        <table class="table align-middle fs-6 gy-3" style="font-variant-numeric:tabular-nums;">
                            <thead><tr class="text-start fw-bold fs-8 text-uppercase text-muted gs-0" style="border-bottom:2px solid #13433a;"><th class="ps-4">@SR["Employee"]</th><th>@Localizer["Role"]</th><th class="text-end pe-4"></th></tr></thead>
                            <tbody class="fw-semibold text-gray-700">
                            @foreach (var a in assignments)
                            {
                                <tr style="border-bottom:1px dashed #eef1f6;">
                                    <td class="ps-4 fw-bold text-gray-800">@a.EmployeeName</td>
                                    <td><span class="badge fw-bold" style="background:#eaf3ef;color:#13433a;">@roleName((string)a.Role)</span></td>
                                    <td class="text-end pe-4"><form asp-action="RemoveCrmRole" method="post" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Remove role?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.ID" /><button class="btn btn-icon btn-light-danger btn-sm"><i class="ki-outline ki-trash fs-6"></i></button></form></td>
                                </tr>
                            }
                            @if (!assignments.Any()) { <tr><td colspan="3" class="text-center text-muted py-8">@Localizer["No roles assigned — CRM open to all"]</td></tr> }
                            </tbody>
                        </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
