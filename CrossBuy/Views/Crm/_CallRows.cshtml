@using CrossBuy.Models.Context.Crm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<CrmCall>
@{
    @* ONE DEFINITION OF A CALL ROW, for the call log and for the ticket it belongs to.

       There were two, and they had already drifted: this table showed the outcome as the raw
       stored "Answered" on an Arabic page and the UTC stamp, so the same call read 14:35 on one
       screen and 11:35 on the other. A row with an expandable detail - the agent and their photo,
       the unit it went to, who logged it, the notes - existed on one screen only.

       The TICKET column is the only difference, and it is a parameter: inside a ticket every row
       is that ticket, so the column would repeat one number down the page. *@
    var calls = Model ?? new List<CrmCall>();
    var employees = ViewBag.Employees as List<CrossBuy.Models.Context.Admin.Employee> ?? new();
    var deptNames = ViewBag.DeptNames as Dictionary<int, CrossBuy.BL.CrmOrgNode> ?? new();
    var empById = employees.GroupBy(e => e.ID).ToDictionary(g => g.Key, g => g.First());
    bool showTicket = (bool)(ViewData["ShowTicket"] ?? true);
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    string dirName(string d) => d == "Outbound" ? (isAr ? "صادرة" : "Outbound") : (isAr ? "واردة" : "Inbound");
    string outName(string o) => o switch
    {
        "NoAnswer"  => isAr ? "بدون رد"   : "No answer",
        "Busy"      => isAr ? "مشغول"     : "Busy",
        "Voicemail" => isAr ? "بريد صوتي" : "Voicemail",
        "Dropped"   => isAr ? "انقطعت"    : "Dropped",
        _           => isAr ? "تم الرد"   : "Answered",
    };
    string dur(int? s) => s is not > 0 ? "—" : (s.Value / 60) + ":" + (s.Value % 60).ToString("00");
    @* Stored UTC, read in the reader’s clock. EF hands back Kind=Unspecified, which ToLocalTime
       treats as UTC - the house convention. *@
    string whenLocal(DateTime utc) => utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    int cols = showTicket ? 7 : 6;
}
                            <table class="table align-middle gy-3 mb-0" style="font-variant-numeric:tabular-nums;">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                    <th class="ps-4">@Localizer["When"]</th><th>@Localizer["Direction"]</th>
                                    <th>@Localizer["Number"]</th><th>@Localizer["Outcome"]</th>
                                    <th>@Localizer["Duration"]</th>@if (showTicket) { <th>@Localizer["Ticket"]</th> }
                                    <th class="text-end pe-4 w-40px"></th>
                                </tr></thead>
                                <tbody class="fs-7">
                                @foreach (var c in calls)
                                {
                                    <tr style="border-bottom:1px dashed #eef1f6;">
                                        <td class="ps-4 text-muted" dir="ltr" style="unicode-bidi:isolate">@whenLocal(c.StartedAt)</td>
                                        <td><span class="badge fw-bold fs-8" style="background:#E7F0FF;color:#145DBF;">@dirName(c.Direction)</span></td>
                                        <td>
                                            <span dir="ltr" style="unicode-bidi:isolate">@(string.IsNullOrWhiteSpace(c.PhoneNumber) ? "—" : c.PhoneNumber)</span>
                                            @* Where it went belongs on the row, not only inside the detail: "who is
                                               this department waiting on" is a question you scan a list for. *@
                                            @if (c.DepartmentId is > 0)
                                            {
                                                <div class="fs-8 text-gray-600 mt-1">
                                                    <i class="ki-outline ki-arrow-right fs-8"></i>
                                                    @(deptNames.TryGetValue(c.DepartmentId.Value, out var dn) ? CrossBuy.BL.DisplayName.Of(dn.NameAr, dn.NameEn) : "#" + c.DepartmentId)
                                                </div>
                                            }
                                        </td>
                                        @* An unanswered call is the one a supervisor is looking for, so it is
                                           the only outcome that changes colour. *@
                                        <td class="@(c.Outcome == "Answered" ? "text-gray-700" : "")" style="@(c.Outcome == "Answered" ? "" : "color:#C0392B;")">@outName(c.Outcome)</td>
                                        <td dir="ltr" style="unicode-bidi:isolate">@dur(c.DurationSeconds)</td>
                                        @if (showTicket)
                                        {
                                        <td>
                                            @if (c.TicketId is > 0)
                                            { <a href="@Url.Action("TicketEditor","Crm", new { id = c.TicketId })" class="fw-bold">#@c.TicketId</a> }
                                            else { <span class="text-gray-300">—</span> }
                                        </td>
                                        }
                                        @* WHAT WAS WRITTEN DOWN HAS TO BE READABLE AGAIN. The notes were saved and
                                           then had nowhere to appear, so the agent typed them into a hole. The row
                                           already carries everything, so this is a toggle rather than a round trip. *@
                                        <td class="text-end pe-4">
                                            <button type="button" class="btn btn-icon btn-sm btn-active-light-primary cb-call-more"
                                                    data-target="cbcall-@c.ID" title="@Localizer["Details"]">
                                                <i class="ki-outline ki-down fs-4"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr id="cbcall-@c.ID" class="d-none">
                                        <td colspan="@cols" class="px-4 py-4" style="background:#F9FAFB;">
                                            <div class="row g-4">
                                                <div class="col-md-4">
                                                    <div class="fs-8 text-gray-500 mb-1">@Localizer["Agent"]</div>
                                                    @if (c.AgentEmployeeId is > 0 && empById.ContainsKey(c.AgentEmployeeId.Value))
                                                    {
                                                        var ag = empById[c.AgentEmployeeId.Value];
                                                        var agName = CrossBuy.BL.DisplayName.Of(ag.FullName, ag.FullNameEn);
                                                        <div class="d-flex align-items-center">
                                                            <span class="symbol symbol-25px me-2 flex-shrink-0">
                                                                @if (!string.IsNullOrWhiteSpace(ag.ProfileImage))
                                                                {
                                                                    <img src="@Url.Content("~" + ag.ProfileImage.Replace("\\", "/"))" class="rounded-circle" style="object-fit:cover" alt="" />
                                                                }
                                                                else
                                                                {
                                                                    <span class="symbol-label bg-light-primary text-primary fw-bold fs-8">@(string.IsNullOrWhiteSpace(agName) ? "?" : agName.Trim().Substring(0, 1))</span>
                                                                }
                                                            </span>
                                                            <span class="fw-semibold">@agName</span>
                                                        </div>
                                                    }
                                                    else { <span class="text-gray-400">—</span> }
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="fs-8 text-gray-500 mb-1">@Localizer["Routed to"]</div>
                                                    @if (c.DepartmentId is > 0)
                                                    {
                                                        <span class="fw-semibold">@(deptNames.TryGetValue(c.DepartmentId.Value, out var dd) ? CrossBuy.BL.DisplayName.Of(dd.NameAr, dd.NameEn) : "#" + c.DepartmentId)</span>
                                                    }
                                                    else { <span class="text-gray-400">—</span> }
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="fs-8 text-gray-500 mb-1">@Localizer["Logged by"]</div>
                                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(c.CreatedBy) ? "—" : c.CreatedBy)</span>
                                                    @if (c.CreatedAt.HasValue)
                                                    { <span class="fs-8 text-gray-500 ms-2" dir="ltr" style="unicode-bidi:isolate">@whenLocal(c.CreatedAt.Value)</span> }
                                                </div>
                                                <div class="col-12">
                                                    <div class="fs-8 text-gray-500 mb-1">@SR["Notes"]</div>
                                                    @if (string.IsNullOrWhiteSpace(c.Notes))
                                                    { <span class="text-gray-400">@Localizer["Nothing was written down"]</span> }
                                                    else
                                                    { <div class="fs-7 text-gray-800" style="white-space:pre-wrap">@c.Notes</div> }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (calls.Count == 0)
                                { <tr><td colspan="@cols" class="text-center text-muted py-10">@Localizer["No calls logged yet"]</td></tr> }
                                </tbody>
</table>

@* The toggle lives WITH the rows, so any screen that renders them gets it. Delegated on the
   document and guarded by a flag: two copies of this handler would toggle a row twice and
   leave it exactly as it was. *@
<script>
(function () {
    if (window.__cbCallMoreBound) { return; }
    window.__cbCallMoreBound = true;
    document.addEventListener("click", function (ev) {
        var btn = ev.target.closest ? ev.target.closest(".cb-call-more") : null;
        if (!btn) { return; }
        var row = document.getElementById(btn.getAttribute("data-target"));
        if (!row) { return; }
        var open = !row.classList.contains("d-none");
        row.classList.toggle("d-none", open);
        var ic = btn.querySelector("i");
        if (ic) { ic.className = open ? "ki-outline ki-down fs-4" : "ki-outline ki-up fs-4"; }
    });
})();
</script>
