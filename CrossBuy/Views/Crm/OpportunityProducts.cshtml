@using CrossBuy.Models.Context.Crm
@model Opportunity
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var products = ViewBag.Products as List<OpportunityProduct> ?? new();
    var accountName = ViewBag.AccountName as string;
    var initial = products.Select(p => new { itemId = p.ItemId, itemText = p.ItemDescription, qty = p.Qty, unitPrice = p.UnitPrice, discountPercent = p.DiscountPercent }).ToList();
    var initialJson = System.Text.Json.JsonSerializer.Serialize(initial);
    var converted = Model.QuotationId.HasValue;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Model.Title</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Opportunities","Crm")" class="text-muted text-hover-primary">@Localizer["Opportunities"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Products"]</li></ul></div>
        <a href="@Url.Action("Opportunities","Crm")" class="btn btn-light"><i class="ki-outline ki-arrow-left fs-2"></i>@SR["Back"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["CrmMsg"] != null) { <div class="alert alert-success">@TempData["CrmMsg"]</div> }
        @if (TempData["CrmErr"] != null) { <div class="alert alert-danger">@TempData["CrmErr"]</div> }

        <div class="card mb-5"><div class="card-body py-5"><div class="d-flex flex-wrap gap-6 align-items-center">
            <div><div class="fs-8 text-muted">@SR["Account"]</div><div class="fw-bold text-gray-800">@(accountName ?? Localizer["No account"].Value)</div></div>
            <div><div class="fs-8 text-muted">@Localizer["Stage"]</div><span class="badge badge-light-primary">@Model.Stage</span></div>
            <div><div class="fs-8 text-muted">@Localizer["Opportunity value"]</div><div class="fw-bold fs-4 text-gray-900" id="oppValue">@Model.Amount.ToString("N2")</div></div>
            <div class="ms-auto">
                @if (converted)
                {
                    <a href="@Url.Action("QuotationDetails","Inventory", new { id = Model.QuotationId })" class="btn btn-light-primary"><i class="ki-outline ki-document fs-3"></i>@Localizer["Quotation"] #@Model.QuotationId</a>
                }
                else
                {
                    <form asp-action="ConvertOpportunityToQuotation" method="post" class="d-inline" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Create a quotation from this opportunity? (the account will be linked to a financial customer)"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ID" />
                        <button class="btn btn-primary"><i class="ki-outline ki-arrow-right-left fs-3"></i>@Localizer["Convert to quotation"]</button></form>
                }
            </div>
        </div></div></div>

        <form asp-action="SaveOpportunityProducts" method="post" id="pForm" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Save opportunity products?"]">@Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ID" /><input type="hidden" name="linesJson" id="linesJson" />
            <div class="card"><div class="card-header"><div class="card-title fw-bold">@Localizer["Products"]</div>
                <div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" id="add"><i class="ki-outline ki-plus fs-3"></i>@Localizer["Add line"]</button></div></div>
                <div class="card-body">
                    <div class="table-responsive"><table class="table table-row-bordered align-middle"><thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                        <th style="min-width:240px">@SR["Item"]</th><th style="min-width:160px">@SR["Description"]</th><th style="width:90px">@Localizer["Qty"]</th><th style="width:120px">@SR["Price"]</th><th style="width:90px">@Localizer["Disc%"]</th><th class="text-end" style="width:120px">@SR["Total"]</th><th style="width:40px"></th>
                    </tr></thead><tbody id="rows"></tbody><tfoot><tr class="fw-bold"><td colspan="5" class="text-end">@SR["Total"]</td><td class="text-end" id="tot">0.00</td><td></td></tr></tfoot></table></div>
                    <div class="d-flex justify-content-end mt-4"><button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@Localizer["Save products"]</button></div>
                </div></div>
        </form>
    </div></div>
</div>
@section Scripts {
<script>
(function(){
  var LINES=@Html.Raw(initialJson); var pickUrl='@Url.Action("ItemPickData","Inventory")'; var priceUrl='@Url.Action("PriceLookup","Inventory")';
  var tb=document.getElementById('rows');
  function calc(){ var sum=0; tb.querySelectorAll('tr').forEach(function(tr){ var q=parseFloat(tr.querySelector('.q').value)||0,p=parseFloat(tr.querySelector('.p').value)||0,d=parseFloat(tr.querySelector('.disc').value)||0; var lt=q*p*(1-d/100); tr.querySelector('.lt').textContent=lt.toFixed(2); sum+=lt; });
    document.getElementById('tot').textContent=sum.toFixed(2); document.getElementById('oppValue').textContent=sum.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function addRow(d){ d=d||{}; var tr=document.createElement('tr'); tr.innerHTML=
    '<td><select class="form-select form-select-solid it"></select></td>'+
    '<td><input class="form-control form-control-solid d" value="'+((d.itemText||'')+'').replace(/"/g,'&quot;')+'"></td>'+
    '<td><input type="number" step="0.01" class="form-control form-control-solid q text-end" value="'+(d.qty||1)+'"></td>'+
    '<td><input type="number" step="0.01" class="form-control form-control-solid p text-end" value="'+(d.unitPrice||0)+'"></td>'+
    '<td><input type="number" step="0.01" class="form-control form-control-solid disc text-end" value="'+(d.discountPercent||0)+'"></td>'+
    '<td class="text-end lt fw-bold">0.00</td>'+
    '<td class="text-center"><button type="button" class="btn btn-icon btn-light-danger btn-sm del"><i class="ki-outline ki-trash fs-5"></i></button></td>';
    tb.appendChild(tr); var sel=tr.querySelector('.it'); cbItemSelect(sel, pickUrl);
    if(d.itemId){ var o=new Option(d.itemText||('#'+d.itemId), d.itemId, true, true); sel.appendChild(o); }
    calc(); }
  tb.addEventListener('input',calc);
  tb.addEventListener('click',function(e){ if(e.target.closest('.del')){ e.target.closest('tr').remove(); calc(); } });
  tb.addEventListener('change',function(e){ if(e.target.classList.contains('it')){ var tr=e.target.closest('tr'), opt=e.target.options[e.target.selectedIndex], id=parseInt(e.target.value||'0');
    if(id){ if(!tr.querySelector('.d').value)tr.querySelector('.d').value=opt.getAttribute('data-name')||''; var q=parseFloat(tr.querySelector('.q').value)||1;
      fetch(priceUrl+'?itemId='+id+'&qty='+q,{headers:{'X-Requested-With':'fetch'}}).then(function(r){return r.json();}).then(function(pr){ if(pr&&pr.unitPrice!=null){ tr.querySelector('.p').value=pr.unitPrice; tr.querySelector('.disc').value=pr.discountPercent||0; calc(); } }).catch(function(){}); } } });
  document.getElementById('add').addEventListener('click',function(){ addRow(); });
  document.getElementById('save').addEventListener('click',function(){ var lines=[]; tb.querySelectorAll('tr').forEach(function(tr){ var it=tr.querySelector('.it').value, q=parseFloat(tr.querySelector('.q').value)||0, p=parseFloat(tr.querySelector('.p').value)||0;
      if((it||tr.querySelector('.d').value)&&q>0) lines.push({ ItemId: it?parseInt(it):null, ItemDescription: tr.querySelector('.d').value, Qty:q, UnitPrice:p, DiscountPercent: parseFloat(tr.querySelector('.disc').value)||0 }); });
    document.getElementById('linesJson').value=JSON.stringify(lines); document.getElementById('pForm').submit(); });
  LINES.forEach(addRow); calc();
})();
</script>
}
