@using CrossBuy.Models.Context.Crm
@model List<CrmCustomField>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var entityTypes = new[] { "Lead", "Opportunity", "Account", "Activity" };
    string etName(string e) => e switch { "Opportunity" => Localizer["Opportunity"].Value, "Account" => SR["Account"].Value, "Activity" => Localizer["Activity"].Value, _ => Localizer["Lead"].Value };
    string ftName(string f) => f switch { "Number" => SR["Number"].Value, "Date" => SR["Date"].Value, "Select" => Localizer["Select"].Value, "Checkbox" => Localizer["Checkbox"].Value, _ => Localizer["Text"].Value };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <h1 class="page-heading fw-bold fs-3 m-0">@Localizer["Custom fields (CRM)"]</h1>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["CrmMsg"] != null) { <div class="alert alert-success">@TempData["CrmMsg"]</div> }
        @if (TempData["CrmErr"] != null) { <div class="alert alert-danger">@TempData["CrmErr"]</div> }

        <div class="card card-flush mb-5"><div class="card-header"><div class="card-title"><h2>@Localizer["New custom field"]</h2></div></div>
            <div class="card-body pt-2"><form asp-action="SaveCustomField" method="post" class="row g-3 align-items-end">@Html.AntiForgeryToken()
                <div class="col-md-2"><label class="fw-semibold fs-7 mb-1">@Localizer["Entity"]</label>
                    <select name="entityType" class="form-select form-select-solid" data-control="select2" data-hide-search="true">@foreach (var e in entityTypes) { <option value="@e" selected="@(ViewBag.EntityType as string == e)">@etName(e)</option> }</select></div>
                <div class="col-md-3"><label class="required fw-semibold fs-7 mb-1">@Localizer["Label"]</label><input name="label" class="form-control form-control-solid" required /></div>
                <div class="col-md-2"><label class="fw-semibold fs-7 mb-1">@Localizer["Label (EN)"]</label><input name="labelEn" class="form-control form-control-solid" /></div>
                <div class="col-md-2"><label class="fw-semibold fs-7 mb-1">@SR["Type"]</label>
                    <select name="fieldType" class="form-select form-select-solid" data-control="select2" data-hide-search="true"><option value="Text">@Localizer["Text"]</option><option value="Number">@SR["Number"]</option><option value="Date">@SR["Date"]</option><option value="Select">@Localizer["Select"]</option><option value="Checkbox">@Localizer["Checkbox"]</option></select></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 mb-1">@Localizer["Select options (comma)"]</label><input name="options" class="form-control form-control-solid" placeholder="A, B, C" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-7 mb-1">@Localizer["Select options (EN)"]</label><input name="optionsEn" class="form-control form-control-solid" placeholder="A, B, C" /></div>
                <div class="col-md-1"><label class="fw-semibold fs-7 mb-1">@Localizer["Sort"]</label><input name="sortOrder" type="number" value="0" class="form-control form-control-solid" /></div>
                <div class="col-md-2 d-flex gap-3"><label class="form-check form-switch mt-2"><input type="hidden" name="required" value="false" /><input class="form-check-input" type="checkbox" name="required" value="true" /><span class="form-check-label fw-semibold ms-2">@SR["Required"]</span></label>
                    <label class="form-check form-switch mt-2"><input type="hidden" name="isActive" value="false" /><input class="form-check-input" type="checkbox" name="isActive" value="true" checked /><span class="form-check-label fw-semibold ms-2">@SR["Active"]</span></label></div>
                <div class="col-md-2"><button class="btn btn-primary w-100"><i class="ki-outline ki-plus fs-3"></i>@SR["Add"]</button></div>
            </form></div>
        </div>

        <div class="card card-flush"><div class="card-body pt-6"><div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
            <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #13433a;"><th class="ps-4">@Localizer["Entity"]</th><th>@Localizer["Label"]</th><th class="text-center">@SR["Type"]</th><th class="text-center">@SR["Required"]</th><th class="text-center">@SR["Status"]</th><th class="text-end pe-4"></th></tr></thead>
            <tbody>
            @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-8">@Localizer["No custom fields"]</td></tr> }
            @foreach (var f in Model)
            {
                <tr style="border-bottom:1px dashed #eef1f6;">
                    <td class="ps-4"><span class="badge fw-bold" style="background:#eaf3ef;color:#13433a;">@etName(f.EntityType)</span></td>
                    <td class="fw-bold">@(isAr ? f.Label : (string.IsNullOrEmpty(f.LabelEn) ? f.Label : f.LabelEn))@{ var optsD = isAr ? f.Options : (string.IsNullOrEmpty(f.OptionsEn) ? f.Options : f.OptionsEn); }@if (!string.IsNullOrEmpty(optsD)) { <div class="text-muted fs-8">@optsD</div> }</td>
                    <td class="text-center">@ftName(f.FieldType)</td>
                    <td class="text-center">@if (f.Required) { <i class="ki-outline ki-check-circle fs-4" style="color:#13433a;"></i> } else { <span class="text-gray-300">—</span> }</td>
                    <td class="text-center"><span class="badge fw-bold" style="@(f.IsActive ? "background:#eaf3ef;color:#13433a;" : "background:#f2f4f7;color:#475467;")">@(f.IsActive?SR["Active"].Value:SR["Inactive"].Value)</span></td>
                    <td class="text-end pe-4"><form asp-action="DeleteCustomField" method="post" class="d-inline" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Delete field and its values?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@f.ID" /><input type="hidden" name="entityType" value="@f.EntityType" /><button class="btn btn-sm btn-icon btn-light-danger"><i class="ki-outline ki-trash fs-5"></i></button></form></td>
                </tr>
            }
            </tbody>
        </table></div></div></div>
    </div></div>
</div>
