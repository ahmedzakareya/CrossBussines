@model List<CrossBuy.Controllers.CrmController.PortalContactRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var q = ViewBag.Query as string;
    var allCapabilities = ViewBag.AllCapabilities as string[] ?? System.Array.Empty<string>();

    // The capability vocabulary in the customer's language. Taken from PortalCapabilities.All rather
    // than written out here, so a capability the platform stops declaring disappears from the screen
    // instead of becoming a checkbox that grants nothing.
    Func<string, string> capLabel = c => c switch
    {
        "portal-quotations"        => isAr ? "عروض الأسعار" : "Quotations",
        "portal-projects"          => isAr ? "المشاريع" : "Projects",
        "portal-invoices"          => isAr ? "الفواتير" : "Invoices",
        "portal-documents"         => isAr ? "المستندات" : "Documents",
        "portal-quotation-respond" => isAr ? "الرد على عروض الأسعار" : "Respond to quotations",
        "portal-contact-request"   => isAr ? "طلب تواصل" : "Request contact",
        _ => c,
    };
}
@*
    PORTAL CONTACTS — the staff side of the Client Portal's people.

    WHAT THE CONVERGENCE ADDED, and why it is here rather than on a screen of its own: creating a
    portal login, revoking it and setting its capabilities are decisions about exactly these rows.
    A separate provisioning screen would have been a second place to look at the same people, and
    the brief is explicit that it must not exist.

    THE PHOTOGRAPH IS NEVER A PATH. The column renders Crm/PortalUserPhotoContent, an endpoint that
    checks the CRM read right and the caller's own company before it streams a byte. A contact with
    no photograph shows the same neutral avatar the portal shows, so what you see here is what the
    customer sees — and the stored locator never reaches this page, because PortalContactRow does
    not carry it.

    EVERY MUTATION IS A POST WITH AN ANTI-FORGERY TOKEN and is refused server-side without the CRM
    `manage` right. The screen hides nothing that the server would have allowed.
*@
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isAr ? "مستخدمو بوابة العملاء" : "Client portal contacts")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Crm")" class="text-muted">CRM</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@(isAr ? "مستخدمو البوابة" : "Portal contacts")</li>
                </ul>
            </div>
        </div>
    </div>
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            @if (TempData["CrmMsg"] != null) { <div class="alert alert-success">@TempData["CrmMsg"]</div> }
            @if (TempData["CrmErr"] != null) { <div class="alert alert-danger">@TempData["CrmErr"]</div> }

            <div class="card card-flush mb-5">
                <div class="card-body py-5">
                    <form method="get" class="row g-4 align-items-end">
                        <div class="col-md-10">
                            <label class="fw-semibold fs-7 text-muted mb-1">
                                <i class="ki-outline ki-magnifier fs-5 me-1"></i>@(isAr ? "بحث بالاسم أو البريد أو العميل" : "Search by name, email or customer")
                            </label>
                            <input type="text" name="q" value="@q" class="form-control form-control-solid" autocomplete="off" />
                        </div>
                        <div class="col-md-2"><button type="submit" class="btn btn-light w-100">@SR["Search"]</button></div>
                    </form>
                </div>
            </div>

            @* ---- NEW PORTAL CONTACT ---------------------------------------------------------------
               The customer is chosen by id, and the server re-reads it in the CALLER'S company: a
               customer id from another tenant refuses with the same answer as one that does not
               exist. There is no company field on this form, deliberately — the company comes from
               the resolved staff identity and must never be a value the browser sends. *@
            <div class="card card-flush mb-5">
                <div class="card-header border-0 pt-6">
                    <div class="card-title"><h3 class="fw-bold fs-5 m-0">@(isAr ? "إضافة مستخدم بوابة" : "Add a portal contact")</h3></div>
                </div>
                <div class="card-body pt-0">
                    <form method="post" action="@Url.Action("PortalUserProvision","Crm")" class="row g-4 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-md-2">
                            <label class="fw-semibold fs-7 text-muted mb-1">@(isAr ? "رقم العميل" : "Customer id")</label>
                            <input type="number" name="customerId" min="1" class="form-control form-control-sm form-control-solid" required />
                        </div>
                        <div class="col-md-3">
                            <label class="fw-semibold fs-7 text-muted mb-1">@(isAr ? "اسم الشخص" : "Contact name")</label>
                            <input type="text" name="contactName" maxlength="200" class="form-control form-control-sm form-control-solid" required />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold fs-7 text-muted mb-1">@SR["Email"]</label>
                            <input type="email" name="email" maxlength="200" class="form-control form-control-sm form-control-solid" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold fs-7 text-muted mb-1">@(isAr ? "الهاتف" : "Phone")</label>
                            <input type="text" name="phone" maxlength="64" class="form-control form-control-sm form-control-solid" />
                        </div>
                        <div class="col-md-2">
                            @* Optional: a contact can exist before a sign-in is linked to them. *@
                            <label class="fw-semibold fs-7 text-muted mb-1">@(isAr ? "حساب الدخول (اختياري)" : "Sign-in id (optional)")</label>
                            <input type="text" name="userId" maxlength="450" class="form-control form-control-sm form-control-solid" />
                        </div>
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-sm btn-primary w-100">@(isAr ? "إضافة" : "Add")</button>
                        </div>
                        <div class="col-12">
                            <div class="fs-8 text-muted mb-2">
                                @(isAr
                                    ? "بدون اختيار أي صلاحية يحصل المستخدم على الصلاحيات الافتراضية للقراءة فقط."
                                    : "With nothing ticked the contact gets the read-only defaults.")
                            </div>
                            <div class="d-flex flex-wrap gap-4">
                                @foreach (var cap in allCapabilities)
                                {
                                    <label class="form-check form-check-custom form-check-sm">
                                        <input class="form-check-input" type="checkbox" name="capabilities" value="@cap" />
                                        <span class="form-check-label text-gray-700">@capLabel(cap)</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header border-0 pt-6">
                    <div class="card-title"><span class="text-muted fs-7">@Model.Count @(isAr ? "مستخدم" : "contact(s)")</span></div>
                </div>
                <div class="card-body pt-0">
                    @if (!Model.Any())
                    {
                        <div class="text-center text-muted py-10">@(isAr ? "لا يوجد مستخدمو بوابة لهذه الشركة." : "No portal contacts for this company.")</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle gy-4" style="font-variant-numeric:tabular-nums;">
                                <thead>
                                    <tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                        <th class="ps-4" style="width:70px;">@(isAr ? "الصورة" : "Photo")</th>
                                        <th>@(isAr ? "الشخص" : "Contact")</th>
                                        <th>@(isAr ? "العميل" : "Customer")</th>
                                        <th>@SR["Email"]</th>
                                        <th class="text-center">@SR["Status"]</th>
                                        <th style="min-width:280px;">@(isAr ? "الصلاحيات" : "Capabilities")</th>
                                        <th class="text-end pe-4" style="min-width:320px;">@(isAr ? "إجراءات" : "Actions")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model)
                                    {
                                        var held = (row.Capabilities ?? string.Empty)
                                            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                        <tr>
                                            <td class="ps-4">
                                                <div class="symbol symbol-45px symbol-circle">
                                                    @* The endpoint, never the stored locator. HasPhoto is the only thing
                                                       this page knows about the file, which is all it needs to know. *@
                                                    <img src="@(row.HasPhoto
                                                            ? Url.Action("PortalUserPhotoContent","Crm", new { id = row.Id })
                                                            : "/portal-assets/media/avatars/blank.png")" alt="@row.ContactName" />
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-gray-800">@row.ContactName</div>
                                                @if (!row.HasLogin)
                                                {
                                                    @* Provisioned but never linked to a sign-in: they cannot open the portal yet,
                                                       and a photo on such a row is harmless but pointless, so it is stated. *@
                                                    <div class="fs-8 text-muted">@(isAr ? "لا يوجد حساب دخول مرتبط" : "no sign-in linked")</div>
                                                }
                                            </td>
                                            <td class="text-gray-700">@row.CustomerName</td>
                                            <td class="text-gray-700">@row.Email</td>
                                            <td class="text-center">
                                                <span class="badge @(row.IsActive ? "badge-light-success" : "badge-light")">
                                                    @(row.IsActive ? (isAr ? "نشط" : "Active") : (isAr ? "موقوف" : "Revoked"))
                                                </span>
                                            </td>
                                            <td>
                                                @* The whole grant is replaced by what is submitted, which is what
                                                   SetCapabilitiesAsync does — so an unticked box is a revocation and
                                                   the form shows the CURRENT state rather than an empty set. *@
                                                <form method="post" action="@Url.Action("PortalUserCapabilities","Crm")">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@row.Id" />
                                                    <div class="d-flex flex-wrap gap-3 mb-2">
                                                        @foreach (var cap in allCapabilities)
                                                        {
                                                            <label class="form-check form-check-custom form-check-sm">
                                                                <input class="form-check-input" type="checkbox" name="capabilities"
                                                                       value="@cap" @(held.Contains(cap) ? "checked" : "") />
                                                                <span class="form-check-label fs-8 text-gray-700">@capLabel(cap)</span>
                                                            </label>
                                                        }
                                                    </div>
                                                    <button type="submit" class="btn btn-sm btn-light">@(isAr ? "حفظ الصلاحيات" : "Save capabilities")</button>
                                                </form>
                                            </td>
                                            <td class="text-end pe-4">
                                                <form method="post" enctype="multipart/form-data" action="@Url.Action("PortalUserPhoto","Crm")" class="d-inline-flex align-items-center gap-2 mb-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@row.Id" />
                                                    @* accept is a convenience for the file picker only; the server decides what it
                                                       stores from the content type, and writes its own file name. *@
                                                    <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="form-control form-control-sm form-control-solid w-auto" required />
                                                    <button type="submit" class="btn btn-sm btn-primary">@(isAr ? "رفع" : "Upload")</button>
                                                </form>
                                                @if (row.HasPhoto)
                                                {
                                                    <form method="post" action="@Url.Action("PortalUserPhotoRemove","Crm")" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@row.Id" />
                                                        <button type="submit" class="btn btn-sm btn-light ms-2">@(isAr ? "إزالة الصورة" : "Remove photo")</button>
                                                    </form>
                                                }
                                                <div class="mt-2">
                                                    @* Revocation, never deletion: the row survives with its audit trail and
                                                       the customer loses sight of the portal on the very next request. *@
                                                    @if (row.IsActive)
                                                    {
                                                        <form method="post" action="@Url.Action("PortalUserDeactivate","Crm")" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@row.Id" />
                                                            <button type="submit" class="btn btn-sm btn-light">@(isAr ? "إيقاف الوصول" : "Revoke access")</button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form method="post" action="@Url.Action("PortalUserReactivate","Crm")" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@row.Id" />
                                                            <button type="submit" class="btn btn-sm btn-light">@(isAr ? "استعادة الوصول" : "Restore access")</button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
