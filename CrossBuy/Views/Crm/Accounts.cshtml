@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Accounts"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Crm")" class="text-muted">CRM</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Accounts"]</li></ul></div>
        <a href="@Url.Action("AccountEditor","Crm")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New account"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-10"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@Localizer["Multi-search (name / industry / phone / segment)"]</label>
                <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@Localizer["Add search terms…"]" /></div>
            <div class="col-md-2"><button type="button" id="f_reset" class="btn btn-light w-100"><i class="ki-outline ki-arrows-circle fs-3"></i> @SR["Reset"]</button></div>
            <div class="col-md-5"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-price-tag fs-5 me-1"></i>@SR["Tags"]</label>
                <select id="f_tags" class="form-select form-select-solid cb-filter" multiple data-control="select2" data-placeholder="@SR["Select tags"]">
                    @foreach (var tg in (ViewBag.AllTags as IReadOnlyList<CrossBuy.Models.Context.Platform.Tag> ?? new List<CrossBuy.Models.Context.Platform.Tag>())) { <option value="@tg.ID">@tg.Name</option> }
                </select></div>
            <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">&nbsp;</label>
                <select id="f_tagmode" class="form-select form-select-solid cb-filter" data-hide-search="true">
                    <option value="false">@SR["Any tag"]</option><option value="true">@SR["All tags"]</option>
                </select></div>
            <div class="col-md-4 d-flex align-items-center gap-4 pt-4">
                <label class="form-check form-check-custom form-check-sm">
                    <input class="form-check-input cb-filter" type="checkbox" id="f_unassigned" /><span class="form-check-label fw-semibold">@SR["Unassigned"]</span></label>
            </div>
        </div></div></div>
        <div class="card"><div class="card-header border-0 pt-6"><div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
            <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap"><select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@SR["Account"]</th><th>@Localizer["Industry/Segment"]</th><th>@SR["Phone"]</th><th class="text-center">@Localizer["Contacts"]</th><th class="text-center">@Localizer["Opps"]</th><th class="text-center">@Localizer["Financial"]</th><th class="text-center">@SR["Status"]</th><th class="text-end pe-4">@Localizer["Open"]</th></tr></thead>
                <tbody id="rows"></tbody>
            </table></div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Loading…"]</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@Localizer["No accounts"]</div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
cbServerList({ url:'@Url.Action("AccountsData","Crm")', isAr:@(isAr ? "true" : "false"),
  addParams:function(p){ cbTagFilterParams(p); } });
// The tag ids go on the wire as ids, never as names: a name is editable and not unique. There is no
// overdue switch here - Activity has typed columns for a lead and an opportunity and none for an
// account, so an account "follow-up" would be a relationship the model does not state.
function cbTagFilterParams(p){
  var t=document.getElementById('f_tags'); if(t){ Array.prototype.forEach.call(t.selectedOptions,function(o){ p.append('tagIds',o.value); }); }
  var m=document.getElementById('f_tagmode'); if(m&&m.value==='true')p.set('tagMatchAll','true');
  var u=document.getElementById('f_unassigned'); if(u&&u.checked)p.set('unassigned','true');
}
</script>
}
