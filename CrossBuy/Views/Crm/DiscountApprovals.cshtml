@model List<CrossBuy.BL.CrmIdentity.PendingApprovalView>
@inject Microsoft.Extensions.Localization.IStringLocalizer<CrossBuy.CrmResources> T
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var curCode = (string)ViewBag.CurCode; var curDec = (int)ViewBag.CurDec;
    string M(decimal v) => v.ToString("N" + curDec, System.Globalization.CultureInfo.InvariantCulture);
    string Initials(string? s) { var p = (s ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return ((p.Length > 0 ? p[0][..1] : "") + (p.Length > 1 ? p[1][..1] : "")).ToUpperInvariant(); }
}
@section Styles { <link href="~/css/crm-identity.css" rel="stylesheet" asp-append-version="true" /> }
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Discount approvals"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Crm")" class="text-muted text-hover-primary">@T["Customer relationships"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["Discount approvals"]</li></ul></div>
        <a href="@Url.Action("DealRules","Crm")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-setting-2 fs-4"></i>@T["Deal rules"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            <div class="col-sm-6 col-xl-4"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@T["Waiting for my decision"]</div><i class="ki-outline ki-notification-status fs-2 text-gray-400"></i></div>
                <div class="fs-2hx fw-bold @(Model.Count > 0 ? "text-primary" : "text-gray-900") num">@Model.Count</div>
                <div class="text-muted fs-8 mt-1">@T["only requests your own limit covers"]</div></div></div></div>
            <div class="col-sm-6 col-xl-4"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@T["Value of the deals waiting"]</div><i class="ki-outline ki-wallet fs-2 text-gray-400"></i></div>
                <div class="fs-2hx fw-bold text-gray-900"><span class="num">@M(Model.Sum(m => m.DealAmount))</span> <span class="fs-6 text-muted">@curCode</span></div>
                <div class="text-muted fs-8 mt-1">@T["their quotations cannot leave until you decide"]</div></div></div></div>
            <div class="col-sm-6 col-xl-4"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@T["Oldest waiting"]</div><i class="ki-outline ki-time fs-2 text-gray-400"></i></div>
                <div class="fs-2hx fw-bold text-gray-900">@if (Model.Count > 0) { <span class="num">@((int)Math.Max(0, (DateTime.UtcNow - Model.Min(m => m.View.A.RequestedAt)).TotalHours))</span> <span class="fs-6 text-muted">@T["hours"]</span> } else { <span>—</span> }</div>
                <div class="text-muted fs-8 mt-1">&nbsp;</div></div></div></div>
        </div>
        <div class="card"><div class="card-header border-0 pt-6"><div class="card-title align-items-start flex-column m-0">
                <span class="card-label fw-bold text-gray-900 fs-4">@T["Waiting for my decision"]</span>
                <span class="text-muted mt-1 fw-semibold fs-7">@T["Open the deal to see its lines and decide there"]</span></div></div>
            <div class="card-body pt-2"><div class="table-responsive"><table class="table align-middle gy-4 mb-0 crm-table">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-4">@T["Asked by"]</th><th>@T["Deal"]</th><th class="text-end">@T["Amount"]</th><th class="text-end">@T["Discount"]</th><th>@T["Reason"]</th><th class="text-end pe-4"></th></tr></thead>
                <tbody class="fs-6">
                @foreach (var m in Model)
                {
                    var a = m.View.A;
                    <tr><td class="ps-4"><div class="d-flex align-items-center gap-3"><span class="symbol symbol-35px symbol-circle">@if (m.View.RequesterPhoto) { <img src="/People/Photo/@a.RequestedByEmployeeId" alt="" onerror="this.outerHTML='<span class=&quot;symbol-label crm-initials fs-8&quot;>@Initials(m.View.RequesterName)</span>'" /> } else { <span class="symbol-label crm-initials fs-8">@Initials(m.View.RequesterName)</span> }</span>
                            <div><div class="fw-bold">@m.View.RequesterName</div><div class="text-muted fs-8 num">@a.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div></div></div></td>
                        <td><a href="@Url.Action("Deal","Crm", new { id = m.OpportunityId })" class="fw-bold text-gray-900 text-hover-primary">@m.DealTitle</a><div class="text-muted fs-8">@m.AccountName</div></td>
                        <td class="text-end num">@M(m.DealAmount)</td>
                        <td class="text-end"><span class="badge badge-light-danger fs-7 num">@a.RequestedPercent.ToString("0.##")%</span></td>
                        <td class="fs-7" style="max-width:320px">@a.Reason</td>
                        <td class="text-end pe-4"><a href="@Url.Action("Deal","Crm", new { id = m.OpportunityId })#dl_a" class="btn btn-sm btn-primary">@T["Review & decide"]</a></td></tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10"><i class="ki-outline ki-check-circle fs-2x text-success d-block mb-2"></i>@T["Nothing is waiting for you."]</td></tr> }
                </tbody></table></div></div></div>
    </div></div>
</div>
