@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var pipeline = ViewBag.Pipeline as List<PipelineStage> ?? new();
    var stages = new[] { "Prospecting", "Qualification", "Proposal", "Negotiation", "Won", "Lost" };
    decimal amt(string s) => pipeline.FirstOrDefault(p => p.Stage == s)?.Amount ?? 0;
    int cnt(string s) => pipeline.FirstOrDefault(p => p.Stage == s)?.Count ?? 0;
    var campaigns = ViewBag.Campaigns as List<(int id, string name)> ?? new();
    var stgHex = new Dictionary<string, string> { ["Prospecting"] = "#7239ea", ["Qualification"] = "#0d9edc", ["Proposal"] = "#f6c000", ["Negotiation"] = "#f1416c", ["Won"] = "#0E4A9E" };
    string hex(string s) => stgHex.TryGetValue(s, out var h) ? h : "#7239ea";
    var sumStages = stages.Where(x => x != "Lost").ToList();
    var totalPipe = sumStages.Sum(x => amt(x));
    int share(string s) => totalPipe > 0 ? (int)Math.Round(amt(s) / totalPipe * 100) : 0;
    // invariant number for the countUp value (Arabic culture would emit Arabic digits and break countUp)
    string Raw(decimal v) => v.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Opportunities"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Crm")" class="text-muted">@SR["CRM"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Opportunities"]</li></ul></div>
        <button class="btn btn-sm btn-primary" onclick="oppNew()"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New opportunity"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["CrmMsg"] != null) { <div class="alert alert-success">@TempData["CrmMsg"]</div> }
        @if (TempData["CrmErr"] != null) { <div class="alert alert-danger">@TempData["CrmErr"]</div> }

        <!--begin::Pipeline summary (Statistics Widget 3 style)-->
        <div class="row g-3 g-xl-5 mb-5">
            @for (var i = 0; i < sumStages.Count; i++)
            {
                var s = sumStages[i];
                var h = hex(s);
                <div class="col-md-4 col-xl">
                    <div class="card card-flush h-100">
                        <div class="card-body d-flex flex-column p-0">
                            <div class="d-flex flex-stack flex-grow-1 p-5 pb-3">
                                <div class="d-flex flex-column me-2">
                                    <span class="text-gray-900 fw-bold fs-3 lh-1" data-kt-countup="true" data-kt-countup-value="@Raw(amt(s))">@amt(s).ToString("N0")</span>
                                    <span class="text-muted fw-semibold fs-7 mt-2">@Localizer[s] · @cnt(s) @Localizer["deals"]</span>
                                </div>
                                <span class="symbol symbol-45px">
                                    <span class="symbol-label fs-6 fw-bold" style="background:@(h)22;color:@h">@share(s)%</span>
                                </span>
                            </div>
                            <div class="px-5 pb-5">
                                <div class="progress h-8px" style="background:@(h)1a">
                                    <div class="progress-bar" role="progressbar" style="width:@share(s)%;background:@h" aria-valuenow="@share(s)" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!--end::Pipeline summary-->

        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-7"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@Localizer["Multi-search (title / customer)"]</label>
                <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@Localizer["Add search terms…"]" /></div>
            <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Stage"]</label>
                <select id="f_stage" class="form-select form-select-solid cb-filter" data-control="select2" data-hide-search="true"><option value="">@SR["All"]</option>@foreach (var s in stages) { <option value="@s">@Localizer[s]</option> }</select></div>
            <div class="col-md-2"><button type="button" id="f_reset" class="btn btn-light w-100"><i class="ki-outline ki-arrows-circle fs-3"></i> @SR["Reset"]</button></div>
        </div></div></div>

        <div class="card"><div class="card-header border-0 pt-6"><div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
            <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap"><select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@Localizer["Title"]</th><th>@SR["Customer"]</th><th class="text-end">@SR["Amount"]</th><th class="text-center">@Localizer["Prob."]</th><th>@Localizer["Expected close"]</th><th class="text-center">@Localizer["Stage"]</th><th class="text-center pe-4">@SR["Actions"]</th></tr></thead>
                <tbody id="rows"></tbody>
            </table></div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Loading…"]</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@Localizer["No opportunities"]</div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="mNew" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
    <form asp-action="SaveOpportunity" method="post" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Save opportunity details?"]">@Html.AntiForgeryToken()
        <input type="hidden" name="id" id="f_id" value="0" />
        <input type="hidden" name="pipelineId" value="@ViewBag.DefaultPipelineId" />
        <div class="modal-header"><h2 class="fw-bold" id="mTitle">@Localizer["New opportunity"]</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8"><div class="row">
            <div class="col-md-8 mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Title"]</label><input name="title" id="f_title" class="form-control form-control-solid" required /></div>
            <div class="col-md-4 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Stage"]</label><select name="stage" id="f_stage_m" class="form-select form-select-solid">@foreach (var s in stages) { <option value="@s">@Localizer[s]</option> }</select></div>
            <div class="col-md-12 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Title (EN)"]</label><input name="titleEn" id="f_titleEn" class="form-control form-control-solid" placeholder="@Localizer["Optional English title"]" /></div>
            <div class="col-md-6 mb-4"><label class="fw-semibold fs-6 mb-2">@SR["Account"]</label><select name="accountId" id="f_cust" class="form-select form-select-solid"></select></div>
            <div class="col-md-3 mb-4"><label class="fw-semibold fs-6 mb-2">@SR["Amount"]</label><input name="amount" id="f_amount" type="number" step="0.01" class="form-control form-control-solid" value="0" /></div>
            <div class="col-md-3 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Probability %"]</label><input id="f_prob" type="number" class="form-control form-control-solid" value="50" readonly title="@Localizer["Derived from the stage"]" /></div>
            <div class="col-md-6 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Expected close"]</label><input name="expectedCloseDate" id="f_close" type="date" class="form-control form-control-solid" /></div>
            <div class="col-md-6 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Campaign"]</label><select name="campaignId" id="f_campaign" class="form-select form-select-solid"><option value="">@Localizer["None"]</option>@foreach (var cm in campaigns) { <option value="@cm.id">@cm.name</option> }</select></div>
            <div class="col-md-12 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Win/Loss reason"]</label><input name="winLossReason" id="f_reason" class="form-control form-control-solid" placeholder="@Localizer["Fill when won or lost"]" /></div>
            <div class="col-md-12 mb-2"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><textarea name="notes" id="f_notes" class="form-control form-control-solid" rows="2"></textarea></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@SR["Save"]</button></div>
    </form>
</div></div></div>

@section Scripts {
<script>
cbServerList({ url:'@Url.Action("OpportunitiesData","Crm")', exportUrl:'@Url.Action("OpportunitiesExport","Crm")', isAr:@(isAr ? "true" : "false"),
  addParams:function(p){ var s=document.getElementById('f_stage'); if(s&&s.value)p.set('stage',s.value); } });
if(window.jQuery){ jQuery('#f_cust').select2({ dropdownParent: jQuery('#mNew'), placeholder:'@Localizer["Search account…"]', allowClear:true, minimumInputLength:1,
  ajax:{ url:'@Url.Action("AccountPickData","Crm")', dataType:'json', delay:250, data:function(p){return {term:p.term};}, processResults:function(d){return {results:d.results};} } }); }
var modal; function v(id,val){document.getElementById(id).value=val||'';}
function setCust(id,name){ var $c=jQuery('#f_cust'); $c.empty(); if(id&&name){ $c.append(new Option(name,id,true,true)); } $c.trigger('change'); }
function oppNew(){ document.getElementById('mTitle').textContent='@Localizer["New opportunity"]';
  v('f_id','0');v('f_title','');v('f_titleEn','');document.getElementById('f_stage_m').value='Prospecting';v('f_amount','0');v('f_prob','50');v('f_close','');v('f_campaign','');v('f_notes','');v('f_reason','');setCust('','');
  modal=modal||new bootstrap.Modal(document.getElementById('mNew'));modal.show(); }
function oppEdit(btn){ var r=btn.closest('tr'); document.getElementById('mTitle').textContent='@Localizer["Edit opportunity"]';
  v('f_id',r.getAttribute('data-id'));v('f_title',r.getAttribute('data-title'));v('f_titleEn',r.getAttribute('data-titleen')||'');document.getElementById('f_stage_m').value=r.getAttribute('data-stage')||'Prospecting';v('f_amount',r.getAttribute('data-amount'));v('f_prob',r.getAttribute('data-prob'));v('f_close',r.getAttribute('data-close'));v('f_campaign',r.getAttribute('data-campaign'));v('f_notes','');v('f_reason','');
  setCust(r.getAttribute('data-accountid'), r.getAttribute('data-accountname'));
  modal=modal||new bootstrap.Modal(document.getElementById('mNew'));modal.show(); }
</script>
}
