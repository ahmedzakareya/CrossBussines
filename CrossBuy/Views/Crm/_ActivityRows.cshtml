@using CrossBuy.Models.Context.Crm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<Activity>
@{
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "ar";
    string tIcon(string t) => t switch { "Call" => "ki-phone", "Meeting" => "ki-people", "Email" => "ki-sms", _ => "ki-check-square" };
    string tName(string t) => t switch { "Call" => Localizer["Call"].Value, "Meeting" => Localizer["Meeting"].Value, "Email" => SR["Email"].Value, _ => Localizer["Task"].Value };
}
@foreach (var a in Model)
{
    var overdue = !a.Done && a.DueDate.HasValue && a.DueDate.Value.Date < DateTime.Today;
    <tr data-id="@a.ID" data-type="@a.Type" data-subject="@a.Subject" data-subjecten="@a.SubjectEn" data-due="@(a.DueDate?.ToString("yyyy-MM-dd"))" data-notes="@a.Notes" style="border-bottom:1px dashed #eef1f6;">
        <td class="ps-4"><span class="badge fw-bold" style="background:#f2f4f7;color:#475467;"><i class="ki-outline @tIcon(a.Type) fs-7 me-1"></i>@tName(a.Type)</span></td>
        <td class="fw-semibold @(a.Done?"text-muted text-decoration-line-through":"text-gray-800")">@(isEn ? (string.IsNullOrWhiteSpace(a.SubjectEn) ? a.Subject : a.SubjectEn) : a.Subject)</td>
        <td class="@(overdue?"text-danger fw-bold":"text-muted")">@(a.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
        <td class="text-center"><span class="badge fw-bold" style="@(a.Done?"background:#E7F0FF;color:#0E4A9E;":"background:#fef3e2;color:#b96a00;")">@(a.Done?Localizer["Done"]:Localizer["Open"])</span></td>
        <td class="text-center pe-4">
            <form asp-action="ToggleActivity" method="post" class="d-inline" data-cb-confirm data-cb-action="generic" data-cb-text="@(a.Done?Localizer["Reopen this activity?"]:Localizer["Mark this activity as done?"])">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.ID" />
                <button class="btn btn-sm btn-icon" style="@(a.Done?"background:#fef3e2;color:#b96a00;":"background:#E7F0FF;color:#0E4A9E;")" title="@(a.Done?Localizer["Reopen"]:Localizer["Mark done"])"><i class="ki-outline @(a.Done?"ki-arrows-circle":"ki-check") fs-6"></i></button>
            </form>
            <button class="btn btn-sm btn-icon btn-light-primary" title="@SR["Edit"]" onclick="actEdit(this)"><i class="ki-outline ki-pencil fs-6"></i></button>
        </td>
    </tr>
}
