@model List<CrossBuy.BL.CrmIdentity.ContactRow>
@inject Microsoft.Extensions.Localization.IStringLocalizer<CrossBuy.CrmResources> T
@{
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string N(string n, string? en) => !isAr && !string.IsNullOrWhiteSpace(en) ? en! : n;
    string Initials(string? s) { var p = (s ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return ((p.Length > 0 ? p[0][..1] : "") + (p.Length > 1 ? p[1][..1] : "")).ToUpperInvariant(); }
    var channels = new[] { ("WhatsApp", "WhatsApp"), ("Email", T["ch:Email"].Value), ("Sms", "SMS") };
}
@foreach (var c in Model)
{
    <tr>
        <td class="ps-4"><div class="d-flex align-items-center min-w-0">
            <div class="symbol symbol-40px symbol-circle flex-shrink-0"><span class="symbol-label crm-initials">@Initials(c.NameEn ?? c.Name)</span></div>
            <div class="d-flex flex-column ms-3 min-w-0">
                <a href="@Url.Action("Contact","Crm", new { id = c.Id })" class="text-gray-900 text-hover-primary fs-6 fw-bold text-truncate">@N(c.Name, c.NameEn)</a>
                <span class="text-muted fw-semibold fs-7 text-truncate">@N(c.Title ?? "", c.TitleEn)@if (c.IsPrimary) { <span class="badge badge-light-primary fs-9 ms-1">@T["Primary"]</span> }</span>
            </div></div></td>
        <td><a href="@Url.Action("Account360","Crm", new { id = c.AccountId })" class="text-gray-800 text-hover-primary fw-semibold">@N(c.AccountName, c.AccountNameEn)</a></td>
        <td>@if (!string.IsNullOrWhiteSpace(c.Phone)) { <span class="num text-gray-800">@c.Phone</span> } else { <span class="text-gray-300">—</span> }</td>
        <td>@if (!string.IsNullOrWhiteSpace(c.Email)) { <span class="num text-gray-800 fs-7">@c.Email</span> } else { <span class="text-gray-300">—</span> }</td>
        <td>@foreach (var (k, label) in channels)
            {
                var st = c.Consent.TryGetValue(k, out var s) ? s.State : null;
                <span class="crm-consent @(st == "OptIn" ? "in" : st == "OptOut" ? "out" : "none")" title="@(st == null ? T["Never asked"].Value : T["consent:" + st].Value)">@(st == "OptIn" ? "✓" : st == "OptOut" ? "✕" : "?") @label</span>
            }</td>
        <td class="text-end pe-4"><a href="@Url.Action("Contact","Crm", new { id = c.Id })" class="btn btn-sm btn-light-primary">@T["Open"]</a></td>
    </tr>
}
