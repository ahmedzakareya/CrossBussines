@using CrossBuy.Models.Context.Crm
@model CrmMarketingList
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isEdit = Model.ID > 0;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var listName = !isAr && !string.IsNullOrWhiteSpace(Model.NameEn) ? Model.NameEn! : Model.Name;
    var memberNames = ViewBag.MemberNames as Dictionary<int, string> ?? new();
    string typeName(string t) => t switch { "Lead" => Localizer["Lead"].Value, "Account" => SR["Account"].Value, "Contact" => Localizer["Contact"].Value, _ => t };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isEdit ? listName : Localizer["New list"].Value)</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("MarketingLists","Crm")" class="text-muted text-hover-primary">@Localizer["Marketing lists"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@(isEdit ? "#" + Model.ID : Localizer["New"].Value)</li></ul></div>
        <a href="@Url.Action("MarketingLists","Crm")" class="btn btn-light"><i class="ki-outline ki-arrow-left fs-2"></i>@SR["Back"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["CrmMsg"] != null) { <div class="alert alert-success">@TempData["CrmMsg"]</div> }
        @if (TempData["CrmErr"] != null) { <div class="alert alert-danger">@TempData["CrmErr"]</div> }

        <div class="card mb-5"><div class="card-body">
            <form asp-action="SaveList" method="post" class="row g-4" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Save list?"]">@Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ID" />
                <div class="col-md-4"><label class="required fw-semibold fs-7 text-muted mb-1">@SR["Name"]</label><input name="name" class="form-control form-control-solid" value="@Model.Name" required /></div>
                <div class="col-md-4"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Name (EN)"]</label><input name="nameEn" class="form-control form-control-solid" value="@Model.NameEn" /></div>
                <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch"><input type="hidden" name="isActive" value="false" /><input class="form-check-input" type="checkbox" name="isActive" value="true" id="act" @(Model.IsActive ? "checked" : "")><label class="form-check-label fw-semibold ms-1 fs-7" for="act">@SR["Active"]</label></div></div>
                <div class="col-md-6"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Description"]</label><textarea name="description" class="form-control form-control-solid" rows="2">@Model.Description</textarea></div>
                <div class="col-md-6"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Description (EN)"]</label><textarea name="descriptionEn" class="form-control form-control-solid" rows="2" placeholder="@Localizer["Optional English description"]">@Model.DescriptionEn</textarea></div>
                <div class="col-12 d-flex justify-content-end"><button class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button></div>
            </form>
        </div></div>

        @if (isEdit)
        {
            <div class="card"><div class="card-header"><div class="card-title fw-bold">@Localizer["List members"] (@Model.Members.Count)</div></div>
                <div class="card-body">
                    <form asp-action="AddListMember" method="post" class="row g-3 align-items-end mb-5 bg-light-primary rounded p-4" id="addForm">@Html.AntiForgeryToken()
                        <input type="hidden" name="listId" value="@Model.ID" /><input type="hidden" name="memberName" id="m_name" />
                        <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Type"]</label>
                            <select id="m_type" name="entityType" class="form-select form-select-solid form-select-sm">
                                <option value="Account">@SR["Account"]</option><option value="Lead">@Localizer["Lead"]</option><option value="Contact">@Localizer["Contact"]</option>
                            </select></div>
                        <div class="col-md-6"><label class="fw-semibold fs-7 text-muted mb-1">@Localizer["Member"]</label>
                            <select id="m_entity" name="entityId" class="form-select form-select-solid" style="width:100%"></select></div>
                        <div class="col-md-3"><button class="btn btn-primary btn-sm w-100"><i class="ki-outline ki-plus fs-4"></i>@SR["Add"]</button></div>
                    </form>
                    <div class="table-responsive"><table class="table align-middle gy-2" style="font-variant-numeric:tabular-nums;">
                        <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@Localizer["Member"]</th><th>@SR["Type"]</th><th class="text-end pe-4" style="width:60px"></th></tr></thead>
                        <tbody>
                        @foreach (var m in Model.Members)
                        {
                            <tr style="border-bottom:1px dashed #eef1f6;">
                                <td class="ps-4 fw-bold text-gray-800">@(memberNames.TryGetValue(m.ID, out var mn) ? mn : (m.MemberName ?? ("#" + m.EntityId)))</td>
                                <td><span class="badge fw-bold" style="background:#f2f4f7;color:#475467;">@typeName(m.EntityType)</span></td>
                                <td class="text-end pe-4"><form asp-action="RemoveListMember" method="post" class="d-inline" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Remove this member?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.ID" /><input type="hidden" name="listId" value="@Model.ID" /><button class="btn btn-sm btn-icon btn-light-danger"><i class="ki-outline ki-trash fs-6"></i></button></form></td>
                            </tr>
                        }
                        @if (Model.Members.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-8">@Localizer["No members yet"]</td></tr> }
                        </tbody>
                    </table></div>
                </div>
            </div>
        }
    </div></div>
</div>
@section Scripts {
<script>
(function(){
  var pickUrl='@Url.Action("EntityPickData","Crm")';
  if(window.jQuery){
    var $e=jQuery('#m_entity');
    function bind(){
      $e.empty().select2({ placeholder:'@Localizer["Search…"]', allowClear:true, minimumInputLength:1,
        ajax:{ url:pickUrl, dataType:'json', delay:250, data:function(p){ return { type: jQuery('#m_type').val(), term:p.term }; }, processResults:function(d){ return { results:d.results }; } } });
    }
    bind();
    jQuery('#m_type').on('change', bind);
    $e.on('select2:select', function(e){ document.getElementById('m_name').value = e.params.data.text || ''; });
  }
})();
</script>
}
