@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var rows = ViewBag.Forecast as List<ForecastRow> ?? new();
    var totWeighted = rows.Sum(r => r.WeightedAmount);
    var totOpen = rows.Sum(r => r.OpenAmount);
    var totWon = rows.Sum(r => r.WonAmount);
    string Raw(decimal v) => v.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);   // invariant countUp value
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Sales forecast"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Crm")" class="text-muted">@SR["CRM"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Forecast"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-3 g-xl-5 mb-5">
            @{
                // (label, value, raw, icon, bg-tint, fg)
                var kpis = new (string label, string value, string raw, string icon, string bg, string fg)[] {
                    (Localizer["Weighted (expected)"].Value, totWeighted.ToString("N0"), Raw(totWeighted), "ki-chart-line-up", "#E7F0FF", "#0E4A9E"),
                    (Localizer["Total open pipeline"].Value, totOpen.ToString("N0"), Raw(totOpen), "ki-chart-simple", "#E7F0FF", "#145DBF"),
                    (Localizer["Won"].Value, totWon.ToString("N0"), Raw(totWon), "ki-medal-star", "#E7F0FF", "#0E4A9E"),
                };
            }
            @foreach (var k in kpis)
            {
                <div class="col-md-4">
                    <div class="card card-flush h-100"><div class="card-body d-flex flex-stack p-5">
                        <div class="d-flex flex-column me-2">
                            <span class="fs-2 fw-bold text-gray-900 lh-1" data-kt-countup="true" data-kt-countup-value="@k.raw">@k.value</span>
                            <span class="fs-7 text-muted mt-2">@k.label</span>
                        </div>
                        <span class="symbol symbol-45px"><span class="symbol-label" style="background:@k.bg;"><i class="ki-outline @k.icon fs-2x" style="color:@k.fg;"></i></span></span>
                    </div></div>
                </div>
            }
        </div>

        <div class="card"><div class="card-header"><div class="card-title fw-bold">@Localizer["Forecast by expected close month"]</div></div>
            <div class="card-body">
                <div class="table-responsive"><table class="table align-middle fs-6 gy-3" style="font-variant-numeric:tabular-nums;">
                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@Localizer["Month"]</th><th class="text-center">@Localizer["Open opps"]</th><th class="text-end">@Localizer["Open value"]</th><th class="text-end">@Localizer["Weighted"]</th><th class="text-end pe-4">@Localizer["Won"]</th></tr></thead>
                    <tbody>
                    @foreach (var r in rows)
                    {
                        <tr style="border-bottom:1px dashed #eef1f6;">
                            <td class="ps-4 fw-bold text-gray-800">@r.Month</td>
                            <td class="text-center">@r.OpenCount</td>
                            <td class="text-end text-muted">@r.OpenAmount.ToString("N0")</td>
                            <td class="text-end fw-bold" style="color:#0E4A9E;">@r.WeightedAmount.ToString("N0")</td>
                            <td class="text-end fw-bold pe-4" style="color:#0E4A9E;">@r.WonAmount.ToString("N0")</td>
                        </tr>
                    }
                    @if (rows.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-10">@Localizer["No opportunities with an expected close date"]</td></tr> }
                    </tbody>
                    @if (rows.Count > 0)
                    {
                        <tfoot><tr class="fw-bolder fs-6" style="background:#E7F0FF;border-top:2px solid #0E4A9E;"><td class="ps-4" style="color:#145DBF;">@SR["Total"]</td><td></td><td class="text-end" style="color:#0E4A9E;">@totOpen.ToString("N0")</td><td class="text-end" style="color:#0E4A9E;">@totWeighted.ToString("N0")</td><td class="text-end pe-4" style="color:#0E4A9E;">@totWon.ToString("N0")</td></tr></tfoot>
                    }
                </table></div>
                <div class="text-muted fs-8 mt-3">@Localizer["Weighted = Σ (opportunity amount × stage probability). Lost opportunities are excluded."]</div>
            </div>
        </div>
    </div></div>
</div>
