@using CrossBuy.Models.Context.Platform
@model IReadOnlyList<Tag>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    ViewData["Title"] = Localizer["Tags"].Value;

    var usage = ViewBag.TagUsage as IDictionary<int, int> ?? new Dictionary<int, int>();
    var canManage = ViewBag.CanManage is true;

    var active = Model.Where(t => t.IsActive).ToList();
    var archived = Model.Where(t => !t.IsActive).ToList();

    // A TAG'S NAME IS BUSINESS DATA, never a UI label: the tenant chose the word and it is not
    // translated. So no DisplayName.Of here and no twin column - Tag.Name is the one spelling.
    int Used(int id) => usage.TryGetValue(id, out var n) ? n : 0;
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading fw-bold fs-3 m-0">@Localizer["Tags"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-gray-700">@SR["CRM"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-gray-700">
                    @Localizer["One word, shared by every record that carries it."]
                </li>
            </ul>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            @* WHY THIS SCREEN EXISTS, said once where it answers the question a reader actually has:
               the tag pickers on leads, opportunities and accounts were permanently empty, and this
               is the only place a tag can be created. *@
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information-5 fs-2tx text-primary me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap">
                    <div class="fs-7 text-gray-800">
                        @Localizer["Tags created here are the ones offered on leads, opportunities, accounts and activities. A tag belongs to this company only."]
                        <div class="text-gray-600 mt-1">
                            @Localizer["A tag that has never been used is deleted outright; one that records history is archived instead, so every record keeps its answer."]
                        </div>
                    </div>
                </div>
            </div>

            @if (canManage)
            {
                <div class="card card-flush mb-5">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["New tag"]</h2></div></div>
                    <div class="card-body pt-2">
                        <form asp-action="CreateTag" method="post" class="row g-3 align-items-end">
                            @Html.AntiForgeryToken()
                            <div class="col-md-5">
                                <label class="required fw-semibold fs-7 mb-1">@SR["Name"]</label>
                                @* The limit is read FROM the service, not retyped: a literal here would
                                   drift the day TagService.MaxNameLength changes, and the box would then
                                   accept what the save refuses. *@
                                <input name="name" class="form-control form-control-solid" required
                                       maxlength="@CrossBuy.BL.Platform.TagService.MaxNameLength"
                                       placeholder="@Localizer["e.g. Key account"]" autocomplete="off" />
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-primary w-100"><i class="ki-outline ki-plus fs-3"></i>@SR["Add"]</button>
                            </div>
                            <div class="col-md-5 fs-8 text-gray-600 pb-2">
                                @Localizer["Case and spacing do not make a new tag: “Urgent” and “ urgent ” are the same one."]
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="card card-flush">
                <div class="card-body pt-6">
                    <div class="table-responsive">
                        <table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                            <thead>
                                <tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                    <th class="ps-4">@SR["Name"]</th>
                                    <th class="text-center w-150px">@Localizer["Records"]</th>
                                    <th class="text-center w-125px">@SR["Status"]</th>
                                    <th class="text-end pe-4 w-250px"></th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (!Model.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-8">@Localizer["No tags yet"]</td></tr>
                            }
                            @foreach (var t in active.Concat(archived))
                            {
                                var n = Used(t.ID);
                                <tr style="border-bottom:1px dashed #eef1f6;">
                                    <td class="ps-4">
                                        @if (canManage)
                                        {
                                            @* RENAMED IN PLACE. A tag has exactly one editable field, so a
                                               modal for it would be ceremony - and the id travels on the
                                               wire, never the name, so a rename leaves every assignment
                                               pointing at the same tag. *@
                                            <form asp-action="RenameTag" method="post" class="d-flex align-items-center gap-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@t.ID" />
                                                <span class="badge fw-bold flex-shrink-0" style="background:#E7F0FF;color:#0E4A9E;">
                                                    <i class="ki-outline ki-price-tag fs-7 me-1"></i>@t.Name
                                                </span>
                                                <input name="name" class="form-control form-control-sm form-control-solid w-200px"
                                                       value="@t.Name" maxlength="@CrossBuy.BL.Platform.TagService.MaxNameLength"
                                                       required aria-label="@SR["Name"]" />
                                                <button class="btn btn-sm btn-light-primary" title="@SR["Save"]">
                                                    <i class="ki-outline ki-check fs-5"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge fw-bold" style="background:#E7F0FF;color:#0E4A9E;">
                                                <i class="ki-outline ki-price-tag fs-7 me-1"></i>@t.Name
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (n > 0)
                                        {
                                            <span class="fw-bold text-gray-800">@n</span>
                                        }
                                        else
                                        {
                                            @* NOT "0". A tag nobody has used is a different thing from a
                                               count, and it is the fact that decides delete vs archive. *@
                                            <span class="text-gray-500 fs-8">@Localizer["Never used"]</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge fw-bold" style="@(t.IsActive ? "background:#E7F0FF;color:#0E4A9E;" : "background:#f2f4f7;color:#475467;")">
                                            @(t.IsActive ? SR["Active"].Value : Localizer["Archived"].Value)
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (canManage)
                                        {
                                            if (t.IsActive)
                                            {
                                                @* THE BUTTON SAYS WHAT IT WILL DO. Retire deletes a tag with no
                                                   history and archives one with history, so the label and the
                                                   confirmation both read from the usage count rather than
                                                   promising one and doing the other. *@
                                                <form asp-action="RetireTag" method="post" class="d-inline"
                                                      data-cb-confirm data-cb-action="@(n > 0 ? "generic" : "delete")"
                                                      data-cb-text="@(n > 0
                                                          ? string.Format(Localizer["Archive “{0}”? It stays on {1} record(s) and leaves the pickers."].Value, t.Name, n)
                                                          : string.Format(Localizer["Delete “{0}”? It has never been used."].Value, t.Name))">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@t.ID" />
                                                    @if (n > 0)
                                                    {
                                                        <button class="btn btn-sm btn-light">
                                                            <i class="ki-outline ki-archive fs-5"></i>@Localizer["Archive"]
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-light-danger">
                                                            <i class="ki-outline ki-trash fs-5"></i>@SR["Delete"]
                                                        </button>
                                                    }
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ReviveTag" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@t.ID" />
                                                    <button class="btn btn-sm btn-light-primary">
                                                        <i class="ki-outline ki-arrows-circle fs-5"></i>@Localizer["Restore"]
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
