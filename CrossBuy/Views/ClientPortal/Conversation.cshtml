@model CrossBuy.BL.Communication.PortalConversationDto
@using System.Globalization
@*
    THE CONVERSATION — one thread, in the theme's own language.

    EVERYTHING ON THIS PAGE WAS ALREADY AUTHORIZED. The comments are the Public ones the service
    returned; an internal note was never materialised, so there is nothing here for a template
    mistake to leak. The attachments are METADATA — name, type, size, preview kind — and carry no
    StorageKey, path or URL, because the DTO has no member that could hold one.

    WHO WROTE IT is deliberately coarse. A comment is "you" or the company and nothing else: an
    employee's name, id or role is internal information, and a conversation reads perfectly without
    it. IsMine is the only author fact the approved contract carries.

    NO CONTROLS THIS WAVE DOES NOT OWN. There is no delete, no moderation, no participant
    management, no thread creation, no upload and no internal note, because the external service
    exposes none of them — the buttons are absent rather than hidden, which is the difference
    between a boundary and a decoration.
*@
@{
    Layout = null;
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var comments = ViewData["Comments"] as IReadOnlyList<CrossBuy.BL.Communication.PortalCommentDto>
                   ?? new List<CrossBuy.BL.Communication.PortalCommentDto>();
    var attachments = ViewData["Attachments"] as IReadOnlyList<CrossBuy.BL.Communication.PortalAttachmentDto>
                      ?? new List<CrossBuy.BL.Communication.PortalAttachmentDto>();
    var subject = isAr ? Model.SubjectAr : Model.SubjectEn;
    var postFailed = TempData["PortalCommentError"] != null;
    var anchor = Model.EntityType == "Quotation"
        ? (isAr ? $"عرض سعر رقم {Model.EntityId}" : $"Quotation #{Model.EntityId}")
        : (isAr ? $"مستند رقم {Model.EntityId}" : $"Document #{Model.EntityId}");
}
<!DOCTYPE html>
<!--
Author: Keenthemes
Product Name: Metronic
Product Version: 8.3.3 (demo30)
Purchase: https://1.envato.market/EA4JP
License: For each use you must have a valid license purchased only from above link in order to legally use the theme for your project.
-->
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
	<!--begin::Head-->
	<head>
		<title>@anchor — CrossBuy</title>
		<meta charset="utf-8" />
		<meta name="description" content="CrossBuy client portal." />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="shortcut icon" href="/Backend-assets/media/logos/favicon.ico" asp-append-version="true" />
		<link rel="icon" type="image/svg+xml" href="/Backend-assets/media/logos/crossbuy-favicon.svg" asp-append-version="true" />
		<!--begin::Fonts(mandatory for all pages)-->
		<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
		<!--end::Fonts-->
		<!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
		@if (isAr)
		{
			<link href="/portal-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/portal-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/Backend-assets/fonts/cairo/cairo.css" rel="stylesheet" asp-append-version="true">
			<style>
				html[lang="ar"] body { font-family: 'Cairo', sans-serif; direction: rtl; text-align: right; }
				html[lang="ar"] .btn, html[lang="ar"] input, html[lang="ar"] select, html[lang="ar"] textarea,
				html[lang="ar"] h1, html[lang="ar"] h2, html[lang="ar"] h3, html[lang="ar"] h4, html[lang="ar"] h5, html[lang="ar"] h6 { font-family: 'Cairo', sans-serif; }
				html[lang="ar"] td, html[lang="ar"] th, html[lang="ar"] .fs-2hx, html[lang="ar"] .app-toolbar .fs-3 { unicode-bidi: plaintext; }
			</style>
		}
		else
		{
			<link href="/portal-assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/portal-assets/css/style.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
		}
		<!--end::Global Stylesheets Bundle-->
	</head>
	<!--end::Head-->
	<!--begin::Body-->
	<body id="kt_app_body" data-kt-app-header-fixed-mobile="true" data-kt-app-toolbar-enabled="true" class="app-default">
		<!--begin::Theme mode setup on page load-->
		<script>var defaultThemeMode = "light"; var themeMode; if ( document.documentElement ) { if ( document.documentElement.hasAttribute("data-bs-theme-mode")) { themeMode = document.documentElement.getAttribute("data-bs-theme-mode"); } else { if ( localStorage.getItem("data-bs-theme") !== null ) { themeMode = localStorage.getItem("data-bs-theme"); } else { themeMode = defaultThemeMode; } } if (themeMode === "system") { themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; } document.documentElement.setAttribute("data-bs-theme", themeMode); }</script>
		<!--end::Theme mode setup on page load-->
		<!--begin::App-->
		<div class="d-flex flex-column flex-root app-root" id="kt_app_root">
			<!--begin::Page-->
			<div class="app-page flex-column flex-column-fluid" id="kt_app_page">
				@await Html.PartialAsync("_PortalHeader")
				<!--begin::Wrapper-->
				<div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
					<!--begin::Toolbar-->
					<div id="kt_app_toolbar" class="app-toolbar py-6">
						<div id="kt_app_toolbar_container" class="app-container container-xxl d-flex align-items-start">
							<div class="d-flex flex-column flex-row-fluid">
								<div class="d-flex align-items-center pt-1">
									<ul class="breadcrumb breadcrumb-separatorless fw-semibold">
										<li class="breadcrumb-item text-white opacity-75 fw-bold lh-1">
											<a href="@Url.Action("Updates", "ClientPortal")" class="text-white opacity-75 text-hover-primary">@(isAr ? "المستجدات" : "Updates")</a>
										</li>
										<li class="breadcrumb-item"><span class="bullet bg-white opacity-75 w-5px h-2px"></span></li>
										<li class="breadcrumb-item text-white fw-bold lh-1">@anchor</li>
									</ul>
								</div>
								<div class="d-flex flex-stack flex-wrap flex-lg-nowrap gap-4 gap-lg-10 pt-6 pb-18 py-lg-13">
									<div class="page-title d-flex flex-column me-3">
										<h1 class="page-heading d-flex text-white fw-bolder fs-2 flex-column justify-content-center my-0">@anchor</h1>
										@if (!string.IsNullOrWhiteSpace(subject))
										{
											<span class="text-white opacity-75 pt-2 fs-6">@subject</span>
										}
									</div>
									@* ---- MARK READ ----------------------------------------------------------
									   Server state is authoritative: this POSTs and the redirect re-queries.
									   Nothing is marked read in the browser, so a customer who never presses it
									   keeps their unread count. *@
									@if (Model.UnreadCount > 0)
									{
										<div class="d-flex align-items-center flex-shrink-0">
											<form method="post" action="@Url.Action("MarkConversationRead", "ClientPortal", new { threadId = Model.ThreadId })" class="m-0">
												@Html.AntiForgeryToken()
												<button type="submit" class="btn btn-sm btn-light fw-bold">
													@(isAr ? $"تعليم {Model.UnreadCount} كمقروء" : $"Mark {Model.UnreadCount} as read")
												</button>
											</form>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
					<!--end::Toolbar-->
					<!--begin::Wrapper container-->
					<div class="app-container container-xxl">
						<!--begin::Main-->
						<div class="app-main flex-column flex-row-fluid" id="kt_app_main">
							<!--begin::Content wrapper-->
							<div class="d-flex flex-column flex-column-fluid">
								<!--begin::Content-->
								<div id="kt_app_content" class="app-content">

									<!--begin::Messages-->
									<div class="card mb-6">
										<div class="card-body">
										@if (!comments.Any())
										{
											<div class="text-center text-gray-600 fw-semibold py-10">
												@(isAr ? "لا توجد رسائل بعد." : "No messages yet.")
											</div>
										}
										else
										{
											foreach (var c in comments)
											{
												<div class="d-flex flex-column mb-6 pb-6 border-bottom border-gray-300 border-bottom-dashed">
													<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
														<span class="fw-bold text-gray-900 fs-6">
															@* "You" or the company. No employee identity crosses this boundary. *@
															@(c.IsMine ? (isAr ? "أنت" : "You") : (isAr ? "فريقنا" : "Our team"))
														</span>
														<span class="text-muted fs-7">@(c.CreatedAt?.ToString("yyyy/MM/dd HH:mm") ?? "")</span>
														@if (c.AttachmentCount > 0)
														{
															<span class="badge badge-light fw-bold">
																@(isAr ? $"{c.AttachmentCount} مرفق" : $"{c.AttachmentCount} attached")
															</span>
														}
													</div>
													@* The body is stored unrendered by design — this platform accepts no
													   HTML, so Razor's encoding is the whole sanitiser and there is
													   nothing to configure. *@
													<div class="text-gray-800 fs-6" style="white-space: pre-wrap;">@c.Body</div>
												</div>
											}
										}
										</div>
									</div>
									<!--end::Messages-->

									@* ---- ATTACHMENTS: METADATA ONLY --------------------------------------
									   There is no link, because there is no authorized portal download route for
									   a conversation attachment. Naming bytes to an external caller is handing
									   out a URL that answers to nobody, so the file is described and not offered. *@
									@if (attachments.Any())
									{
										<div class="card mb-6">
											<div class="card-header border-0 pt-6">
												<div class="card-title"><h2 class="fw-bold">@(isAr ? "المرفقات" : "Attachments")</h2></div>
											</div>
											<div class="card-body pt-0">
												<div class="table-responsive">
													<table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
														<thead>
															<tr class="fw-bold text-muted">
																<th class="min-w-200px">@(isAr ? "الملف" : "File")</th>
																<th class="min-w-100px">@(isAr ? "النوع" : "Type")</th>
																<th class="min-w-100px text-end">@(isAr ? "الحجم" : "Size")</th>
															</tr>
														</thead>
														<tbody>
														@foreach (var a in attachments)
														{
															<tr>
																<td class="text-gray-900 fw-bold">@a.FileName</td>
																<td class="text-gray-700 fw-semibold">@a.PreviewKind</td>
																<td class="text-gray-700 fw-semibold text-end">@((a.SizeBytes / 1024m).ToString("N0")) KB</td>
															</tr>
														}
														</tbody>
													</table>
												</div>
												<div class="text-muted fs-7 mt-4">
													@(isAr
														? "لتنزيل أي مرفق، يرجى التواصل مع فريقنا."
														: "To receive any attachment, please contact our team.")
												</div>
											</div>
										</div>
									}

									@* ---- COMPOSER --------------------------------------------------------
									   The body is the ONLY field. No author, no visibility, no company, no
									   customer: all four are decided server-side from the resolved portal
									   identity, so there is nothing on this form for a request to forge.
									   Anti-forgery applies as it does everywhere else in the product. *@
									@if (Model.CanComment)
									{
										<div class="card">
											<div class="card-header border-0 pt-6">
												<div class="card-title"><h2 class="fw-bold">@(isAr ? "أضف رسالة" : "Add a message")</h2></div>
											</div>
											<div class="card-body pt-0">
												@if (postFailed)
												{
													@* One message for every refusal — an empty body, a locked thread,
													   a revoked link. The screen does not say which, for the same
													   reason the sign-in screen does not. *@
													<div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mb-6">
														<span class="symbol symbol-45px me-4">
															<span class="symbol-label bg-danger">
																<i class="ki-outline ki-information-5 fs-2 text-white"></i>
															</span>
														</span>
														<div class="d-flex flex-stack flex-grow-1">
															<div class="fw-semibold">
																<div class="fs-6 text-gray-700">
																	@(isAr ? "تعذّر إرسال رسالتك. يرجى المحاولة مرة أخرى." : "Your message could not be sent. Please try again.")
																</div>
															</div>
														</div>
													</div>
												}
												<form method="post" action="@Url.Action("PostComment", "ClientPortal", new { threadId = Model.ThreadId })">
													@Html.AntiForgeryToken()
													<textarea name="body" rows="4" class="form-control form-control-solid mb-5"
															  placeholder="@(isAr ? "اكتب رسالتك هنا" : "Write your message here")"></textarea>
													<button type="submit" class="btn btn-primary fw-bold">@(isAr ? "إرسال" : "Send")</button>
												</form>
											</div>
										</div>
									}

								</div>
								<!--end::Content-->
							</div>
							<!--end::Content wrapper-->
							<!--begin::Footer-->
							<div id="kt_app_footer" class="app-footer d-flex flex-column flex-md-row align-items-center flex-center flex-md-stack py-2 py-lg-4">
								<div class="text-gray-900 order-2 order-md-1">
									<span class="text-muted fw-semibold me-1">@DateTime.UtcNow.Year&copy;</span>
									<span class="text-gray-800">CrossBuy</span>
								</div>
							</div>
							<!--end::Footer-->
						</div>
						<!--end::Main-->
					</div>
					<!--end::Wrapper container-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Page-->
		</div>
		<!--end::App-->
		<!--begin::Javascript-->
		<script>var hostUrl = "/portal-assets/";</script>
		<script src="/portal-assets/plugins/global/plugins.bundle.js"></script>
		<script src="/portal-assets/js/scripts.bundle.js"></script>
		<!--end::Javascript-->
	</body>
	<!--end::Body-->
</html>
