@model IReadOnlyList<CrossBuy.BL.Portal.PortalQuotation>
@using System.Globalization
@*
    QUOTATIONS — Metronic demo30's "Orders Listing" page (apps/ecommerce/sales/listing.html).

    The design is the theme's, untouched: same card, same toolbar, same eight-column table, same
    DataTable wiring (listing.js orders on the data-order attributes and disables columns 0 and 7,
    so the column count is kept exactly). What changed is the content: every row is a quotation of
    the signed-in customer, read through IPortalDataService, and the figures above are counted from
    the rows this page rendered rather than stated separately.
*@
@{
    Layout = null;
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var customerName = User.Identity?.Name ?? string.Empty;
    var initial = string.IsNullOrWhiteSpace(customerName) ? "?" : customerName.Trim().Substring(0, 1).ToUpperInvariant();
    var awaiting = Model.Count(q => q.AwaitingResponse);
    var totalValue = Model.Sum(q => q.Total);
    var statuses = Model.Select(q => q.Status).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList();
}
<!DOCTYPE html>
<!--
