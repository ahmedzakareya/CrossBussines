@model CrossBuy.Models.Context.Crm.CrmKbArticle
@using System.Globalization
@*
    ONE HELP ARTICLE — a published, public knowledge-base article, and the two buttons that tell us whether it helped.
*@
@{
    Layout = null;
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["PortalSection"] = "Support";
}
<!DOCTYPE html>
<!--
Author: Keenthemes
Product Name: Metronic
Product Version: 8.3.3 (demo30)
Purchase: https://1.envato.market/EA4JP
License: For each use you must have a valid license purchased only from above link in order to legally use the theme for your project.
-->
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
	<!--begin::Head-->
	<head>
		<title>@(isAr ? Model.Title : (string.IsNullOrWhiteSpace(Model.TitleEn) ? Model.Title : Model.TitleEn)) — @CrossBuy.BL.Platform.ProductIdentity.Name</title>
		<meta charset="utf-8" />
		<meta name="description" content="@(CrossBuy.BL.Platform.ProductIdentity.ShortName) client portal." />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="shortcut icon" href="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.FaviconIco)" asp-append-version="true" />
		<link rel="icon" type="image/svg+xml" href="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.Icon)" asp-append-version="true" />
		<!--begin::Fonts(mandatory for all pages)-->
		<link rel="stylesheet" href="~/Backend-assets/fonts/inter/inter.css" />
		<!--end::Fonts-->
		<!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
		@if (isAr)
		{
			<link href="/portal-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/portal-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<!-- The product token layer, AFTER the theme bundle so it wins on specificity order.
			     Without this the portal rendered raw Metronic demo30: the theme's blue, the theme's
			     buttons, the theme's radii - none of them the CrossBusiness identity the rest of the
			     product uses. Same stylesheet the back office loads; one token layer, not two. -->
			<link href="/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/Backend-assets/css/crossbusiness-portal.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/Backend-assets/fonts/cairo/cairo.css" rel="stylesheet" asp-append-version="true">
			<style>
				html[lang="ar"] body { font-family: 'Cairo', sans-serif; direction: rtl; text-align: right; }
				html[lang="ar"] .btn, html[lang="ar"] input, html[lang="ar"] select, html[lang="ar"] textarea,
				html[lang="ar"] h1, html[lang="ar"] h2, html[lang="ar"] h3, html[lang="ar"] h4, html[lang="ar"] h5, html[lang="ar"] h6 { font-family: 'Cairo', sans-serif; }
				html[lang="ar"] td, html[lang="ar"] th, html[lang="ar"] .fs-2hx, html[lang="ar"] .app-toolbar .fs-3 { unicode-bidi: plaintext; }
			</style>
		}
		else
		{
			<link href="/portal-assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/portal-assets/css/style.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<!-- The product token layer, AFTER the theme bundle so it wins on specificity order.
			     Without this the portal rendered raw Metronic demo30: the theme's blue, the theme's
			     buttons, the theme's radii - none of them the CrossBusiness identity the rest of the
			     product uses. Same stylesheet the back office loads; one token layer, not two. -->
			<link href="/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/Backend-assets/css/crossbusiness-portal.css" rel="stylesheet" type="text/css" asp-append-version="true" />
		}
		<!--end::Global Stylesheets Bundle-->
	</head>
	<!--end::Head-->
	<!--begin::Body-->
	<body id="kt_app_body" data-kt-app-header-fixed-mobile="true" data-kt-app-toolbar-enabled="true" class="app-default">
		<!--begin::Theme mode setup on page load-->
		<script>var defaultThemeMode = "light"; var themeMode; if ( document.documentElement ) { if ( document.documentElement.hasAttribute("data-bs-theme-mode")) { themeMode = document.documentElement.getAttribute("data-bs-theme-mode"); } else { if ( localStorage.getItem("data-bs-theme") !== null ) { themeMode = localStorage.getItem("data-bs-theme"); } else { themeMode = defaultThemeMode; } } if (themeMode === "system") { themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; } document.documentElement.setAttribute("data-bs-theme", themeMode); }</script>
		<!--end::Theme mode setup on page load-->
		<!--begin::App-->
		<div class="d-flex flex-column flex-root app-root" id="kt_app_root">
			<!--begin::Page-->
			<div class="app-page flex-column flex-column-fluid" id="kt_app_page">
				@await Html.PartialAsync("_PortalHeader")
				<!--begin::Wrapper-->
				<div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
					<!--begin::Toolbar-->
					<div id="kt_app_toolbar" class="app-toolbar py-6">
						<!--begin::Toolbar container-->
						<div id="kt_app_toolbar_container" class="app-container container-xxl d-flex align-items-start">
							<div class="d-flex flex-column flex-row-fluid">
								<!--begin::Toolbar wrapper-->
								<div class="d-flex align-items-center pt-1">
									<ul class="breadcrumb breadcrumb-separatorless fw-semibold">
										<li class="breadcrumb-item text-white fw-bold lh-1">
											<i class="ki-outline ki-home text-white fs-3"></i>
										</li>
									</ul>
								</div>
								<!--end::Toolbar wrapper-->
								<!--begin::Toolbar wrapper-->
								<div class="d-flex flex-stack flex-wrap flex-lg-nowrap gap-4 gap-lg-10 pt-6 pb-18 py-lg-13">
									<!--begin::Page title-->
									<div class="page-title d-flex flex-column me-3">
										<h1 class="page-heading d-flex text-white fw-bolder fs-2 flex-column justify-content-center my-0">@(isAr ? Model.Title : (string.IsNullOrWhiteSpace(Model.TitleEn) ? Model.Title : Model.TitleEn))</h1>
										<span class="text-white opacity-75 pt-2 fs-6">
											@(isAr ? (Model.Category ?? "مساعدة") : (Model.Category ?? "Help"))
										</span>
									</div>
									<!--end::Page title-->
									
								</div>
								<!--end::Toolbar wrapper-->
							</div>
						</div>
						<!--end::Toolbar container-->
					</div>
					<!--end::Toolbar-->
					<!--begin::Wrapper container-->
					<div class="app-container container-xxl">
						<!--begin::Main-->
						<div class="app-main flex-column flex-row-fluid" id="kt_app_main">
							<!--begin::Content wrapper-->
							<div class="d-flex flex-column flex-column-fluid">
								<!--begin::Content-->
								<div id="kt_app_content" class="app-content">
										@{ var voted = TempData["PortalHelpVoted"] is bool v && v; var body = !isAr && !string.IsNullOrWhiteSpace(Model.BodyEn) ? Model.BodyEn : Model.Body; }
										<!--begin::Card-->
										<div class="card">
											<div class="card-header border-0 pt-6"><div class="card-title"><a href="@Url.Action("Support", "ClientPortal")" class="btn btn-sm btn-light me-3"><i class="ki-outline ki-arrow-@(isAr ? "right" : "left") fs-4"></i></a><h2 class="fw-bold">@(isAr ? "الإجابة" : "The answer")</h2></div></div>
											<div class="card-body pt-0">
												<div class="fs-5 text-gray-800 lh-lg mb-10" style="white-space:pre-wrap">@body</div>
												<div class="separator mb-6"></div>
												@if (voted) { <div class="fw-semibold text-success">@(isAr ? "شكراً، وصلنا رأيك." : "Thank you — noted.")</div> }
												else
												{
													<div class="d-flex flex-wrap align-items-center gap-3">
														<span class="fw-semibold text-gray-700 me-2">@(isAr ? "هل أفادتك هذه الإجابة؟" : "Did this answer help?")</span>
														<form method="post" action="@Url.Action("HelpVote", "ClientPortal", new { id = Model.ID })">@Html.AntiForgeryToken()<input type="hidden" name="helpful" value="true" /><button class="btn btn-sm btn-light-success"><i class="ki-outline ki-like fs-4"></i>@(isAr ? "نعم" : "Yes")</button></form>
														<form method="post" action="@Url.Action("HelpVote", "ClientPortal", new { id = Model.ID })">@Html.AntiForgeryToken()<input type="hidden" name="helpful" value="false" /><button class="btn btn-sm btn-light"><i class="ki-outline ki-dislike fs-4"></i>@(isAr ? "لا" : "No")</button></form>
														<a href="@Url.Action("Support", "ClientPortal")" class="btn btn-sm btn-light-primary ms-auto">@(isAr ? "ما زلت أحتاج المساعدة — أرسل طلباً" : "Still need help — send a request")</a>
													</div>
												}
											</div>
										</div>
										<!--end::Card-->
								</div>
								<!--end::Content-->
							</div>
							<!--end::Content wrapper-->
							<!--begin::Footer-->
							<div id="kt_app_footer" class="app-footer d-flex flex-column flex-md-row align-items-center flex-center flex-md-stack py-2 py-lg-4">
								<div class="text-gray-900 order-2 order-md-1">
									<span class="text-muted fw-semibold me-1">@DateTime.UtcNow.Year&copy;</span>
									<span class="text-gray-800">@CrossBuy.BL.Platform.ProductIdentity.ShortName</span>
								</div>
							</div>
							<!--end::Footer-->
						</div>
						<!--end::Main-->
					</div>
					<!--end::Wrapper container-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Page-->
		</div>
		<!--end::App-->
		<!--begin::Javascript-->
		<script>var hostUrl = "/portal-assets/";</script>
		<script src="/portal-assets/plugins/global/plugins.bundle.js"></script>
		<script src="/portal-assets/js/scripts.bundle.js"></script>
		<!--end::Javascript-->
	</body>
	<!--end::Body-->
</html>
