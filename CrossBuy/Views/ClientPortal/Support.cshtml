@model List<CrossBuy.BL.CrmIdentity.PortalTicketRow>
@using System.Globalization
@*
    SUPPORT — the customer's own requests, a new request and the company's published help, on the demo30 skeleton of
    Updates. Customer language only: no owner, no SLA, no internal status words.
*@
@{
    Layout = null;
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["PortalSection"] = "Support";
}
<!DOCTYPE html>
<!--
Author: Keenthemes
Product Name: Metronic
Product Version: 8.3.3 (demo30)
Purchase: https://1.envato.market/EA4JP
License: For each use you must have a valid license purchased only from above link in order to legally use the theme for your project.
-->
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
	<!--begin::Head-->
	<head>
		<title>@(isAr ? "الدعم" : "Support") — @CrossBuy.BL.Platform.ProductIdentity.Name</title>
		<meta charset="utf-8" />
		<meta name="description" content="@(CrossBuy.BL.Platform.ProductIdentity.ShortName) client portal." />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="shortcut icon" href="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.FaviconIco)" asp-append-version="true" />
		<link rel="icon" type="image/svg+xml" href="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.Icon)" asp-append-version="true" />
		<!--begin::Fonts(mandatory for all pages)-->
		<link rel="stylesheet" href="~/Backend-assets/fonts/inter/inter.css" />
		<!--end::Fonts-->
		<!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
		@if (isAr)
		{
			<link href="/portal-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/portal-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<!-- The product token layer, AFTER the theme bundle so it wins on specificity order.
			     Without this the portal rendered raw Metronic demo30: the theme's blue, the theme's
			     buttons, the theme's radii - none of them the CrossBusiness identity the rest of the
			     product uses. Same stylesheet the back office loads; one token layer, not two. -->
			<link href="/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/Backend-assets/css/crossbusiness-portal.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/Backend-assets/fonts/cairo/cairo.css" rel="stylesheet" asp-append-version="true">
			<style>
				html[lang="ar"] body { font-family: 'Cairo', sans-serif; direction: rtl; text-align: right; }
				html[lang="ar"] .btn, html[lang="ar"] input, html[lang="ar"] select, html[lang="ar"] textarea,
				html[lang="ar"] h1, html[lang="ar"] h2, html[lang="ar"] h3, html[lang="ar"] h4, html[lang="ar"] h5, html[lang="ar"] h6 { font-family: 'Cairo', sans-serif; }
				html[lang="ar"] td, html[lang="ar"] th, html[lang="ar"] .fs-2hx, html[lang="ar"] .app-toolbar .fs-3 { unicode-bidi: plaintext; }
			</style>
		}
		else
		{
			<link href="/portal-assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/portal-assets/css/style.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<!-- The product token layer, AFTER the theme bundle so it wins on specificity order.
			     Without this the portal rendered raw Metronic demo30: the theme's blue, the theme's
			     buttons, the theme's radii - none of them the CrossBusiness identity the rest of the
			     product uses. Same stylesheet the back office loads; one token layer, not two. -->
			<link href="/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/Backend-assets/css/crossbusiness-portal.css" rel="stylesheet" type="text/css" asp-append-version="true" />
		}
		<!--end::Global Stylesheets Bundle-->
	</head>
	<!--end::Head-->
	<!--begin::Body-->
	<body id="kt_app_body" data-kt-app-header-fixed-mobile="true" data-kt-app-toolbar-enabled="true" class="app-default">
		<!--begin::Theme mode setup on page load-->
		<script>var defaultThemeMode = "light"; var themeMode; if ( document.documentElement ) { if ( document.documentElement.hasAttribute("data-bs-theme-mode")) { themeMode = document.documentElement.getAttribute("data-bs-theme-mode"); } else { if ( localStorage.getItem("data-bs-theme") !== null ) { themeMode = localStorage.getItem("data-bs-theme"); } else { themeMode = defaultThemeMode; } } if (themeMode === "system") { themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; } document.documentElement.setAttribute("data-bs-theme", themeMode); }</script>
		<!--end::Theme mode setup on page load-->
		<!--begin::App-->
		<div class="d-flex flex-column flex-root app-root" id="kt_app_root">
			<!--begin::Page-->
			<div class="app-page flex-column flex-column-fluid" id="kt_app_page">
				@await Html.PartialAsync("_PortalHeader")
				<!--begin::Wrapper-->
				<div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
					<!--begin::Toolbar-->
					<div id="kt_app_toolbar" class="app-toolbar py-6">
						<!--begin::Toolbar container-->
						<div id="kt_app_toolbar_container" class="app-container container-xxl d-flex align-items-start">
							<div class="d-flex flex-column flex-row-fluid">
								<!--begin::Toolbar wrapper-->
								<div class="d-flex align-items-center pt-1">
									<ul class="breadcrumb breadcrumb-separatorless fw-semibold">
										<li class="breadcrumb-item text-white fw-bold lh-1">
											<i class="ki-outline ki-home text-white fs-3"></i>
										</li>
									</ul>
								</div>
								<!--end::Toolbar wrapper-->
								<!--begin::Toolbar wrapper-->
								<div class="d-flex flex-stack flex-wrap flex-lg-nowrap gap-4 gap-lg-10 pt-6 pb-18 py-lg-13">
									<!--begin::Page title-->
									<div class="page-title d-flex flex-column me-3">
										<h1 class="page-heading d-flex text-white fw-bolder fs-2 flex-column justify-content-center my-0">@(isAr ? "الدعم" : "Support")</h1>
										<span class="text-white opacity-75 pt-2 fs-6">
											@(isAr ? "طلباتك لدى فريقنا، وإجابات جاهزة لأكثر الأسئلة." : "Your requests with our team, and ready answers to common questions.")
										</span>
									</div>
									<!--end::Page title-->
									<!--begin::Open total-->
									@{ var openCount = Model.Count(r => r.T.Status != "Resolved" && r.T.Status != "Closed"); }
									<div class="d-flex align-items-center flex-shrink-0">
										<span class="fs-2hx text-white fw-bold me-2">@openCount</span>
										<span class="text-white opacity-75 fs-6">@(isAr ? "طلب مفتوح" : "open requests")</span>
									</div>
									<!--end::Open total-->
								</div>
								<!--end::Toolbar wrapper-->
							</div>
						</div>
						<!--end::Toolbar container-->
					</div>
					<!--end::Toolbar-->
					<!--begin::Wrapper container-->
					<div class="app-container container-xxl">
						<!--begin::Main-->
						<div class="app-main flex-column flex-row-fluid" id="kt_app_main">
							<!--begin::Content wrapper-->
							<div class="d-flex flex-column flex-column-fluid">
								<!--begin::Content-->
								<div id="kt_app_content" class="app-content">
@functions {
    static (string cls, string ar, string en) Badge(string s) => s switch {
        "New" => ("badge-light-primary", "جديد", "New"), "Open" => ("badge-light-primary", "قيد المعالجة", "In progress"),
        "Pending" => ("badge-light", "بانتظار ردك", "Waiting for you"), "Resolved" => ("badge-light-success", "تم الحل", "Resolved"),
        "Closed" => ("badge-light", "مغلق", "Closed"), _ => ("badge-light", s, s) };
}
										@{ var err = TempData["PortalSupportError"] as string; var help = (List<CrossBuy.Models.Context.Crm.CrmKbArticle>)ViewBag.Help; var q = ViewBag.Q as string; }
										<div class="row g-6">
										<div class="col-xl-8">
										<!--begin::Card-->
										<div class="card mb-6">
											<div class="card-header border-0 pt-6"><div class="card-title"><h2 class="fw-bold">@(isAr ? "طلباتي" : "My requests")</h2></div></div>
											<div class="card-body pt-0">
											@if (!Model.Any())
											{
												<div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6">
													<span class="symbol symbol-45px me-4"><span class="symbol-label bg-primary"><i class="ki-outline ki-support-24 fs-2 text-white"></i></span></span>
													<div class="fw-semibold fs-6 text-gray-700 align-self-center">@(isAr ? "لا توجد طلبات بعد. اكتب طلبك في النموذج وسيرد عليك فريقنا هنا." : "No requests yet. Write yours in the form and our team will answer you here.")</div>
												</div>
											}
											else
											{
												<div class="table-responsive"><table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
													<thead><tr class="fw-bold text-muted"><th class="min-w-60px">#</th><th class="min-w-200px">@(isAr ? "الموضوع" : "Subject")</th><th class="min-w-100px">@(isAr ? "التاريخ" : "Date")</th><th class="min-w-120px text-end">@(isAr ? "الحالة" : "Status")</th></tr></thead>
													<tbody>
													@foreach (var r in Model)
													{
														var b = Badge(r.T.Status);
														<tr>
															<td class="text-gray-600 fw-semibold">@r.T.ID</td>
															<td><a href="@Url.Action("SupportRequest", "ClientPortal", new { id = r.T.ID })" class="text-gray-900 fw-bold text-hover-primary fs-6">@r.T.Subject</a>
																@if (r.AwaitingYou) { <div class="fs-7 text-primary fw-semibold">@(isAr ? "لديك رد جديد من فريقنا" : "You have a new reply from our team")</div> }
																@if (r.Survey == null && (r.T.Status == "Resolved" || r.T.Status == "Closed") || r.Survey != null && r.Survey.AnsweredAt == null) { <div class="fs-7 text-muted">@(isAr ? "قيّم الخدمة" : "Rate the service")</div> }</td>
															<td class="text-gray-600 fw-semibold">@(r.T.CreatedAt?.ToString("yyyy/MM/dd") ?? "—")</td>
															<td class="text-end"><span class="badge @b.cls fw-bold">@(isAr ? b.ar : b.en)</span></td>
														</tr>
													}
													</tbody></table></div>
											}
											</div>
										</div>
										<!--end::Card-->
										<div class="card">
											<div class="card-header border-0 pt-6"><div class="card-title"><h2 class="fw-bold">@(isAr ? "طلب جديد" : "New request")</h2></div></div>
											<div class="card-body pt-0">
												@if (err != null) { <div class="alert alert-danger py-3">@(err switch { "subject" => isAr ? "اكتب موضوع الطلب." : "Write the subject.", "body" => isAr ? "اشرح طلبك في سطر على الأقل." : "Describe your request in at least a line.", "busy" => isAr ? "طلبات كثيرة الآن، حاول بعد قليل." : "Too many requests right now — try again shortly.", _ => isAr ? "تعذّر إرسال الطلب. حاول مرة أخرى." : "The request could not be sent. Please try again." })</div> }
												<form method="post" action="@Url.Action("OpenRequest", "ClientPortal")">
													@Html.AntiForgeryToken()
													<input name="subject" class="form-control form-control-solid mb-4" maxlength="200" placeholder="@(isAr ? "الموضوع" : "Subject")" value="@(TempData["PortalSupportSubject"] as string)" />
													<textarea name="body" class="form-control form-control-solid mb-4" rows="5" maxlength="4000" placeholder="@(isAr ? "اشرح طلبك بالتفصيل" : "Describe your request")">@(TempData["PortalSupportBody"] as string)</textarea>
													<button type="submit" class="btn btn-primary"><i class="ki-outline ki-send fs-3"></i>@(isAr ? "أرسل الطلب" : "Send the request")</button>
												</form>
											</div>
										</div>
										</div>
										<div class="col-xl-4">
										<div class="card h-100">
											<div class="card-header border-0 pt-6"><div class="card-title"><h2 class="fw-bold">@(isAr ? "إجابات جاهزة" : "Ready answers")</h2></div></div>
											<div class="card-body pt-0">
												<form method="get" action="@Url.Action("Support", "ClientPortal")" class="mb-5">
													<div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
														<input name="q" value="@q" class="form-control form-control-solid ps-12" placeholder="@(isAr ? "ابحث عن سؤالك…" : "Search your question…")" /></div>
												</form>
												@if (!help.Any()) { <div class="text-muted fs-7">@(isAr ? "لا توجد إجابة تطابق بحثك — أرسل طلباً وسنرد عليك." : "No answer matches — send a request and we will reply.")</div> }
												@foreach (var a in help)
												{
													<a href="@Url.Action("HelpArticle", "ClientPortal", new { id = a.ID })" class="d-flex align-items-start py-3 border-bottom border-gray-200 text-hover-primary">
														<i class="ki-outline ki-book-open fs-3 text-primary me-3 mt-1"></i>
														<span><span class="fw-bold text-gray-900 d-block">@(!isAr && !string.IsNullOrWhiteSpace(a.TitleEn) ? a.TitleEn : a.Title)</span>@if (a.Category != null) { <span class="fs-8 text-muted">@a.Category</span> }</span>
													</a>
												}
											</div>
										</div>
										</div>
										</div>
								</div>
								<!--end::Content-->
							</div>
							<!--end::Content wrapper-->
							<!--begin::Footer-->
							<div id="kt_app_footer" class="app-footer d-flex flex-column flex-md-row align-items-center flex-center flex-md-stack py-2 py-lg-4">
								<div class="text-gray-900 order-2 order-md-1">
									<span class="text-muted fw-semibold me-1">@DateTime.UtcNow.Year&copy;</span>
									<span class="text-gray-800">@CrossBuy.BL.Platform.ProductIdentity.ShortName</span>
								</div>
							</div>
							<!--end::Footer-->
						</div>
						<!--end::Main-->
					</div>
					<!--end::Wrapper container-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Page-->
		</div>
		<!--end::App-->
		<!--begin::Javascript-->
		<script>var hostUrl = "/portal-assets/";</script>
		<script src="/portal-assets/plugins/global/plugins.bundle.js"></script>
		<script src="/portal-assets/js/scripts.bundle.js"></script>
		<!--end::Javascript-->
	</body>
	<!--end::Body-->
</html>
