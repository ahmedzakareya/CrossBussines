@model IReadOnlyList<CrossBuy.BL.Portal.PortalProject>
@using System.Globalization
@*
    MY PROJECTS — Metronic demo30's project list (apps/projects/list.html), same cards, same grid.

    Every figure and every card is one of the customer's own projects, read through
    IPortalDataService. Three of the theme's decorations carry no data in the platform and are NOT
    faked: the donut chart (its labels below it are real counts), the per-project progress bar
    (the platform records no completion percentage) and the team avatars (staff identity is not a
    customer's business). The theme's "Project Finance" and "Our Clients" cards are gone for a
    harder reason than missing data: budget is forbidden on this surface, and "our clients" would
    have shown one customer the others.
*@
@{
    Layout = null;
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var customerName = User.Identity?.Name ?? string.Empty;
    var today = DateTime.Today;
    var active = Model.Count(x => (x.StartDate == null || x.StartDate <= today) && (x.EndDate == null || x.EndDate >= today));
    var completed = Model.Count(x => x.EndDate != null && x.EndDate < today);
    var notStarted = Model.Count(x => x.StartDate != null && x.StartDate > today);
    var nextDue = Model.Where(x => x.EndDate != null && x.EndDate >= today).OrderBy(x => x.EndDate).Select(x => x.EndDate).FirstOrDefault();
}
<!DOCTYPE html>
<!--
Author: Keenthemes
Product Name: MetronicProduct Version: 8.3.3
Purchase: https://1.envato.market/EA4JP
Website: http://www.keenthemes.com
Contact: support@@keenthemes.com
Follow: www.twitter.com/keenthemes
Dribbble: www.dribbble.com/keenthemes
Like: www.facebook.com/keenthemes
License: For each use you must have a valid license purchased only from above link in order to legally use the theme for your project.
-->
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")">
	<!--begin::Head-->
	<head>
		<title>@(isAr ? "مشاريعي" : "My Projects") — CrossBuy</title>
		<meta charset="utf-8" />
		<meta name="description" content="CrossBuy client portal." />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="shortcut icon" href="/Backend-assets/media/logos/favicon.ico" asp-append-version="true" />
		<link rel="icon" type="image/svg+xml" href="/Backend-assets/media/logos/crossbuy-favicon.svg" asp-append-version="true" />
		<!--begin::Fonts(mandatory for all pages)-->
		<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
		<!--end::Fonts-->
		<!--begin::Vendor Stylesheets(used for this page only)-->
		<link href="/portal-assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css" />
		<!--end::Vendor Stylesheets-->
		<!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
		@if (isAr)
		{
			<link href="/portal-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/portal-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="/Backend-assets/fonts/cairo/cairo.css" rel="stylesheet" asp-append-version="true">
			<style>
				html[lang="ar"] body { font-family: 'Cairo', sans-serif; direction: rtl; text-align: right; }
				html[lang="ar"] .btn, html[lang="ar"] input, html[lang="ar"] select, html[lang="ar"] textarea,
				html[lang="ar"] h1, html[lang="ar"] h2, html[lang="ar"] h3, html[lang="ar"] h4, html[lang="ar"] h5, html[lang="ar"] h6 { font-family: 'Cairo', sans-serif; }
				/* A number, a date or a document reference is its own bidi run: without this
				   "14/02/2026" inside an Arabic cell is reordered by the text around it and reads as
				   a different date. `plaintext` takes each cell's direction from its own first
				   strong character, so a cell of Arabic words still reads right-to-left. */
				html[lang="ar"] td, html[lang="ar"] th, html[lang="ar"] .fs-2hx, html[lang="ar"] .app-toolbar .fs-3 { unicode-bidi: plaintext; }
			</style>
		}
		else
		{
			<link href="/portal-assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
			<link href="/portal-assets/css/style.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
		}
		<!--end::Global Stylesheets Bundle-->
		<script>// Frame-busting to prevent site from being loaded within a frame without permission (click-jacking) if (window.top != window.self) { window.top.location.replace(window.self.location.href); }</script>
	</head>
	<!--end::Head-->
	<!--begin::Body-->
	<body id="kt_app_body" data-kt-app-header-fixed-mobile="true" data-kt-app-toolbar-enabled="true" class="app-default">
		<!--begin::Theme mode setup on page load-->
		<script>var defaultThemeMode = "light"; var themeMode; if ( document.documentElement ) { if ( document.documentElement.hasAttribute("data-bs-theme-mode")) { themeMode = document.documentElement.getAttribute("data-bs-theme-mode"); } else { if ( localStorage.getItem("data-bs-theme") !== null ) { themeMode = localStorage.getItem("data-bs-theme"); } else { themeMode = defaultThemeMode; } } if (themeMode === "system") { themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; } document.documentElement.setAttribute("data-bs-theme", themeMode); }</script>
		<!--end::Theme mode setup on page load-->
		<!--begin::App-->
		<div class="d-flex flex-column flex-root app-root" id="kt_app_root">
			<!--begin::Page-->
			<div class="app-page flex-column flex-column-fluid" id="kt_app_page">
				@await Html.PartialAsync("_PortalHeader")
				<!--begin::Wrapper-->
				<div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
					<!--begin::Toolbar-->
					<div id="kt_app_toolbar" class="app-toolbar py-6">
						<!--begin::Toolbar container-->
						<div id="kt_app_toolbar_container" class="app-container container-xxl d-flex align-items-start">
							<!--begin::Toolbar container-->
							<div class="d-flex flex-column flex-row-fluid">
								<!--begin::Toolbar wrapper-->
								<div class="d-flex align-items-center pt-1">
									<!--begin::Breadcrumb-->
									<ul class="breadcrumb breadcrumb-separatorless fw-semibold">
										<!--begin::Item-->
										<li class="breadcrumb-item text-white fw-bold lh-1">
											<a href="index.html" class="text-white text-hover-primary">
												<i class="ki-outline ki-home text-white fs-3"></i>
											</a>
										</li>
										<!--end::Item-->
										<!--begin::Item-->
										<li class="breadcrumb-item">
											<i class="ki-outline ki-right fs-4 text-white mx-n1"></i>
										</li>
										<!--end::Item-->
										<!--begin::Item-->
										<li class="breadcrumb-item text-white fw-bold lh-1">@(isAr ? "مشاريعي" : "My Projects")</li>
										<!--end::Item-->
									</ul>
									<!--end::Breadcrumb-->
								</div>
								<!--end::Toolbar wrapper=-->
								<!--begin::Toolbar wrapper=-->
								<div class="d-flex flex-stack flex-wrap flex-lg-nowrap gap-4 gap-lg-10 pt-6 pb-18 py-lg-13">
									<!--begin::Page title-->
									<div class="page-title d-flex align-items-center me-3">
										@* The theme puts a 60px white disc here (media/svg/misc/layer.svg, a generic bar-chart glyph).
										   Same disc, same 60px, same spacing — with our own mark inside it instead, so the
										   band carries the business rather than the template's decoration. *@
										<img alt="CrossBuy" src="/Backend-assets/media/brand/crossbuy-disc.png" class="h-60px me-5" />
										<!--begin::Title-->
										<h1 class="page-heading d-flex text-white fw-bolder fs-2 flex-column justify-content-center my-0">@(isAr ? "مشاريعي" : "My Projects") 
										<!--begin::Description-->
										<span class="page-desc text-white opacity-50 fs-6 fw-bold pt-4">@customerName</span>
										<!--end::Description--></h1>
										<!--end::Title-->
									</div>
									<!--end::Page title-->
									<!--begin::Items-->
									<div class="d-flex gap-4 gap-lg-13">
										<!--begin::Item-->
										<div class="d-flex flex-column">
											<span class="text-white fw-bold fs-3 mb-1">@Model.Count</span>
											<div class="text-white opacity-50 fw-bold">@(isAr ? "إجمالي المشاريع" : "Projects")</div>
										</div>
										<!--end::Item-->
										<!--begin::Item-->
										<div class="d-flex flex-column">
											<span class="text-white fw-bold fs-3 mb-1">@active</span>
											<div class="text-white opacity-50 fw-bold">@(isAr ? "جارية الآن" : "Running now")</div>
										</div>
										<!--end::Item-->
										<!--begin::Item-->
										<div class="d-flex flex-column">
											<span class="text-white fw-bold fs-3 mb-1">@(nextDue?.ToString("dd/MM/yyyy") ?? "—")</span>
											<div class="text-white opacity-50 fw-bold">@(isAr ? "أقرب موعد انتهاء" : "Next due date")</div>
										</div>
										<!--end::Item-->
									</div>
									<!--end::Items-->
								</div>
								<!--end::Toolbar wrapper=-->
							</div>
							<!--end::Toolbar container=-->
						</div>
						<!--end::Toolbar container-->
					</div>
					<!--end::Toolbar-->
					<!--begin::Wrapper container-->
					<div class="app-container container-xxl">
						<!--begin::Main-->
						<div class="app-main flex-column flex-row-fluid" id="kt_app_main">
							<!--begin::Content wrapper-->
							<div class="d-flex flex-column flex-column-fluid">
								<!--begin::Content-->
								<div id="kt_app_content" class="app-content">
									<!--begin::Stats-->
									<div class="row gx-6 gx-xl-9">
										<div class="col-lg-6 col-xxl-4">
											<!--begin::Card-->
											<div class="card h-100">
												<!--begin::Card body-->
												<div class="card-body p-9">
													<!--begin::Heading-->
													<div class="fs-2hx fw-bold">@Model.Count</div>
													<div class="fs-4 fw-semibold text-gray-500 mb-7">@(isAr ? "مشاريعك" : "Your projects")</div>
													<!--end::Heading-->
													@* The theme draws a doughnut here from figures baked into its own JS. The labels
													   below are the real counts, derived from each project's own dates; the chart is
													   left out rather than drawn from numbers that are not yours. *@
													<!--begin::Labels-->
													<div class="d-flex flex-column justify-content-center flex-row-fluid pe-11 mb-5">
														<div class="d-flex fs-6 fw-semibold align-items-center mb-3">
															<div class="bullet bg-primary me-3"></div>
															<div class="text-gray-500">@(isAr ? "جارية" : "Active")</div>
															<div class="ms-auto fw-bold text-gray-700">@active</div>
														</div>
														<div class="d-flex fs-6 fw-semibold align-items-center mb-3">
															<div class="bullet bg-success me-3"></div>
															<div class="text-gray-500">@(isAr ? "منتهية" : "Completed")</div>
															<div class="ms-auto fw-bold text-gray-700">@completed</div>
														</div>
														<div class="d-flex fs-6 fw-semibold align-items-center">
															<div class="bullet bg-gray-300 me-3"></div>
															<div class="text-gray-500">@(isAr ? "لم تبدأ بعد" : "Yet to start")</div>
															<div class="ms-auto fw-bold text-gray-700">@notStarted</div>
														</div>
													</div>
													<!--end::Labels-->
												</div>
												<!--end::Card body-->
											</div>
											<!--end::Card-->
										</div>
										<div class="col-lg-6 col-xxl-4">
											<div class="card h-100">
												<div class="card-body p-9">
													<div class="fs-2hx fw-bold">@active</div>
													<div class="fs-4 fw-semibold text-gray-500 mb-7">@(isAr ? "جارية الآن" : "Running now")</div>
													<div class="fs-6 fw-semibold text-gray-500">
														@(isAr ? "مشاريع بدأت ولم ينتهِ موعدها بعد." : "Started, and not past their end date.")
													</div>
												</div>
											</div>
										</div>
										<div class="col-lg-6 col-xxl-4">
											<div class="card h-100">
												<div class="card-body p-9">
													<div class="fs-2hx fw-bold">@(nextDue?.ToString("dd/MM/yyyy") ?? "—")</div>
													<div class="fs-4 fw-semibold text-gray-500 mb-7">@(isAr ? "أقرب موعد انتهاء" : "Next due date")</div>
													<div class="fs-6 fw-semibold text-gray-500">
														@(nextDue == null
															? (isAr ? "لا يوجد مشروع بموعد انتهاء قادم." : "No project has an upcoming end date.")
															: (isAr ? $"بعد {(nextDue.Value - today).Days} يوم" : $"in {(nextDue.Value - today).Days} day(s)"))
													</div>
												</div>
											</div>
										</div>
									</div>
									<!--end::Stats-->
									<!--begin::Toolbar-->
									<div class="d-flex flex-wrap flex-stack my-5">
										<!--begin::Heading-->
										<h2 class="fs-2 fw-semibold my-2">Projects 
										<span class="fs-6 text-gray-500 ms-1">by Status</span></h2>
										<!--end::Heading-->
										<!--begin::Controls-->
										<div class="d-flex flex-wrap my-1">
											<!--begin::Select wrapper-->
											<div class="m-0">
												<!--begin::Select-->
												<select name="status" data-control="select2" data-hide-search="true" class="form-select form-select-sm form-select-solid fw-bold w-125px">
													<option value="Active" selected="selected">Active</option>
													<option value="Approved">In Progress</option>
													<option value="Declined">To Do</option>
													<option value="In Progress">Completed</option>
												</select>
												<!--end::Select-->
											</div>
											<!--end::Select wrapper-->
										</div>
										<!--end::Controls-->
									</div>
									<!--end::Toolbar-->
									<!--begin::Row-->
									<div class="row g-6 g-xl-9">
										@if (!Model.Any())
										{
											<!--begin::Col-->
											<div class="col-12">
												<div class="card">
													<div class="card-body p-9 text-center">
														<div class="fs-4 fw-semibold text-gray-500">@(isAr ? "لا توجد مشاريع مسجّلة على حسابك." : "No projects are recorded on your account.")</div>
													</div>
												</div>
											</div>
											<!--end::Col-->
										}
										@foreach (var p in Model)
										{
											var ended = p.EndDate != null && p.EndDate < today;
											var notYet = p.StartDate != null && p.StartDate > today;
											var badge = ended ? "badge-light-success" : (notYet ? "badge-light" : "badge-light-primary");
											var state = p.Status ?? (ended ? (isAr ? "منتهي" : "Completed") : (notYet ? (isAr ? "لم يبدأ" : "Yet to start") : (isAr ? "جارٍ" : "In progress")));
											var letter = string.IsNullOrWhiteSpace(p.Name) ? "?" : p.Name.Trim().Substring(0, 1).ToUpperInvariant();
											<!--begin::Col-->
											<div class="col-md-6 col-xl-4">
												<!--begin::Card-->
												<div class="card border-hover-primary h-100">
													<!--begin::Card header-->
													<div class="card-header border-0 pt-9">
														<!--begin::Card Title-->
														<div class="card-title m-0">
															@* The theme puts a brand logo here; a project has none, so this is the
															   theme's own letter symbol instead of a borrowed picture. *@
															<div class="symbol symbol-50px w-50px bg-light">
																<span class="symbol-label fs-2 fw-bold text-primary">@letter</span>
															</div>
														</div>
														<!--end::Card Title-->
														<!--begin::Card toolbar-->
														<div class="card-toolbar">
															<span class="badge @badge fw-bold me-auto px-4 py-3">@state</span>
														</div>
														<!--end::Card toolbar-->
													</div>
													<!--end::Card header-->
													<!--begin::Card body-->
													<div class="card-body p-9">
														<!--begin::Name-->
														<div class="fs-3 fw-bold text-gray-900">@p.Name</div>
														<!--end::Name-->
														<!--begin::Description-->
														<p class="text-gray-500 fw-semibold fs-5 mt-1 mb-7">
															@p.Code@(string.IsNullOrWhiteSpace(p.Location) ? "" : " · " + p.Location)
														</p>
														<!--end::Description-->
														<!--begin::Info-->
														<div class="d-flex flex-wrap mb-5">
															<!--begin::Start-->
															<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-7 mb-3">
																<div class="fs-6 text-gray-800 fw-bold">@(p.StartDate?.ToString("dd MMM yyyy") ?? "—")</div>
																<div class="fw-semibold text-gray-500">@(isAr ? "تاريخ البداية" : "Start Date")</div>
															</div>
															<!--end::Start-->
															@* The theme's second box is Budget. A customer's portal does not show budget,
															   contract value or retention, so the end date takes that slot. *@
															<!--begin::Due-->
															<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 mb-3">
																<div class="fs-6 text-gray-800 fw-bold">@(p.EndDate?.ToString("dd MMM yyyy") ?? "—")</div>
																<div class="fw-semibold text-gray-500">@(isAr ? "تاريخ الانتهاء" : "Due Date")</div>
															</div>
															<!--end::Due-->
														</div>
														<!--end::Info-->
														@* Removed with nothing put in their place: the progress bar (the platform records
														   no completion percentage for a project) and the team avatars (who works on it
														   is internal). Neither was going to be invented. *@
													</div>
													<!--end::Card body-->
												</div>
												<!--end::Card-->
											</div>
											<!--end::Col-->
										}
									</div>
									<!--end::Row-->
									<!--begin::Pagination-->
									<div class="d-flex flex-stack flex-wrap pt-10">
										<div class="fs-6 fw-semibold text-gray-700">
											@(isAr ? $"عرض {Model.Count} مشروع" : $"Showing {Model.Count} project(s)")
										</div>
									</div>
									<!--end::Pagination-->
									<!--begin::Modals-->
									
									
									<!--end::Modals-->
								</div>
								<!--end::Content-->
							</div>
							<!--end::Content wrapper-->
							<!--begin::Footer-->
							<div id="kt_app_footer" class="app-footer d-flex flex-column flex-md-row align-items-center flex-center flex-md-stack py-2 py-lg-4">
								<!--begin::Copyright-->
								<div class="text-gray-900 order-2 order-md-1">
									<span class="text-muted fw-semibold me-1">@DateTime.UtcNow.Year&copy;</span>
									<span class="text-gray-800">CrossBuy</span>
								</div>
								<!--end::Copyright-->
							</div>
							<!--end::Footer-->
						</div>
						<!--end:::Main-->
					</div>
					<!--end::Wrapper container-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Page-->
		</div>
		<!--end::App-->
		<!--begin::Scrolltop-->
		<div id="kt_scrolltop" class="scrolltop" data-kt-scrolltop="true">
			<i class="ki-outline ki-arrow-up"></i>
		</div>
		<!--end::Scrolltop-->
		<!--begin::Modals-->
		<!--begin::Modal - Upgrade plan-->
		<div class="modal fade" id="kt_modal_upgrade_plan" tabindex="-1" aria-hidden="true">
			<!--begin::Modal dialog-->
			<div class="modal-dialog modal-xl">
				<!--begin::Modal content-->
				<div class="modal-content rounded">
					<!--begin::Modal header-->
					<div class="modal-header justify-content-end border-0 pb-0">
						<!--begin::Close-->
						<div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
							<i class="ki-outline ki-cross fs-1"></i>
						</div>
						<!--end::Close-->
					</div>
					<!--end::Modal header-->
					<!--begin::Modal body-->
					<div class="modal-body pt-0 pb-15 px-5 px-xl-20">
						<!--begin::Heading-->
						<div class="mb-13 text-center">
							<h1 class="mb-3">Upgrade a Plan</h1>
							<div class="text-muted fw-semibold fs-5">If you need more info, please check 
							<a href="#" class="link-primary fw-bold">Pricing Guidelines</a>.</div>
						</div>
						<!--end::Heading-->
						<!--begin::Plans-->
						<div class="d-flex flex-column">
							<!--begin::Nav group-->
							<div class="nav-group nav-group-outline mx-auto" data-kt-buttons="true">
								<button class="btn btn-color-gray-500 btn-active btn-active-secondary px-6 py-3 me-2 active" data-kt-plan="month">Monthly</button>
								<button class="btn btn-color-gray-500 btn-active btn-active-secondary px-6 py-3" data-kt-plan="annual">Annual</button>
							</div>
							<!--end::Nav group-->
							<!--begin::Row-->
							<div class="row mt-10">
								<!--begin::Col-->
								<div class="col-lg-6 mb-10 mb-lg-0">
									<!--begin::Tabs-->
									<div class="nav flex-column">
										<!--begin::Tab link-->
										<label class="nav-link btn btn-outline btn-outline-dashed btn-color-dark btn-active btn-active-primary d-flex flex-stack text-start p-6 active mb-6" data-bs-toggle="tab" data-bs-target="#kt_upgrade_plan_startup">
											<!--end::Description-->
											<div class="d-flex align-items-center me-2">
												<!--begin::Radio-->
												<div class="form-check form-check-custom form-check-solid form-check-success flex-shrink-0 me-6">
													<input class="form-check-input" type="radio" name="plan" checked="checked" value="startup" />
												</div>
												<!--end::Radio-->
												<!--begin::Info-->
												<div class="flex-grow-1">
													<div class="d-flex align-items-center fs-2 fw-bold flex-wrap">Startup</div>
													<div class="fw-semibold opacity-75">Best for startups</div>
												</div>
												<!--end::Info-->
											</div>
											<!--end::Description-->
											<!--begin::Price-->
											<div class="ms-5">
												<span class="mb-2">$</span>
