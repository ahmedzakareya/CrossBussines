@model IReadOnlyList<CrossBuy.BL.Portal.PortalInvoice>
@using System.Globalization
@*
    INVOICES & PAYMENTS — Metronic demo30's invoice document (apps/invoices/view/invoice-1.html).

    The theme's page is ONE invoice; the portal holds the customer's whole run of them, and the
    platform's portal projection carries no invoice lines. So the same document design is used as a
    STATEMENT: the theme's items table lists the invoices, and its totals block adds them up. Every
    figure is summed from the rows rendered below it.

    Gone, because nothing in the portal answers them: the "Pay Now" button (the portal takes no
    payments), the PayPal/IBAN payment block and the project/time sidebar (that content belonged to
    the demo, not to this customer). No due date is shown anywhere, and that is deliberate — a sales
    invoice in this platform carries no due date, and deriving one from payment terms would be
    telling a customer they are late on the strength of a guess.
*@
@{
    Layout = null;
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var customerName = User.Identity?.Name ?? string.Empty;
    var totalAll = Model.Sum(i => i.Total);
    var paidAll = Model.Sum(i => i.Paid);
    var outstandingAll = Model.Sum(i => i.Outstanding);
    var openCount = Model.Count(i => i.Outstanding > 0);
    var settledCount = Model.Count - openCount;
    var oldestOpen = Model.Where(i => i.Outstanding > 0).OrderBy(i => i.Date).FirstOrDefault();
}
