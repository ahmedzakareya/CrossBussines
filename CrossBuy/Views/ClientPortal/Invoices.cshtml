		<script src="/portal-assets/plugins/custom/datatables/datatables.bundle.js" asp-append-version="true"></script>
		<script>
			// Same shape as the theme's own listing.js: hold the DataTable, point the card's search
			// box and page-size select at it, nothing else.
			"use strict";
			var isAr = @(isAr ? "true" : "false");
			var KTPortalInvoices = function () {
				var table, datatable;

				var initDatatable = function () {
					datatable = $(table).DataTable({
						"info": false,
						'order': [],
						'pageLength': 25,
						'language': {
							'emptyTable': isAr ? 'لا توجد فواتير على حسابك.' : 'No invoices are recorded on your account.',
							'zeroRecords': isAr ? 'لا توجد فاتورة مطابقة.' : 'No matching invoice.',
							'lengthMenu': '_MENU_',
							'paginate': { 'previous': '', 'next': '' }
						}
					});
				}

				var handleSearch = function () {
					var search = document.querySelector('[data-kt-portal-invoice-filter="search"]');
					if (!search) return;
					search.addEventListener('keyup', function (e) {
						datatable.search(e.target.value).draw();
					});
				}

				return {
					init: function () {
						table = document.querySelector('#kt_portal_invoices_table');
						if (!table) return;
						initDatatable();
						handleSearch();
					}
				};
			}();

			KTUtil.onDOMContentLoaded(function () {
				KTPortalInvoices.init();
			});
		</script>
		<script src="/portal-assets/js/widgets.bundle.js"></script>
