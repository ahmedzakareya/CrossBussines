@using System.Globalization
@inject CrossBuy.BL.Portal.IPortalContextAccessor PortalContexts
@*
    PORTAL HEADER — Metronic demo30's header, kept as the theme ships it.

    Extracted into a partial because the same markup sat in all four pages; the rendered HTML is
    unchanged. Three things inside it now come from the platform instead of the demo:

      · the menu carries the portal's four sections, written with the theme's own menu-item markup,
        in place of the mega menu of Metronic demo pages (those links were all 404 here);
      · the user block is the signed-in account (AspNetUsers), with the theme's letter-avatar
        fallback because a portal contact has no photograph in the platform;
      · Language and Sign Out point at AccountController; the theme's Mode submenu is untouched.

    The search box, the notifications drawer and the quick-links grid are still the theme's demo
    content: nothing in the portal answers them yet. They are listed for the owner to decide, not
    quietly removed.
*@
@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var section = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    // A single conversation is a page WITHIN Updates, not a section of its own, so it lights the
    // Updates entry. Without this the menu goes blank the moment a customer opens a thread, which
    // reads as "you have navigated out of the portal" rather than "you are one level deeper".
    if (string.Equals(section, "Conversation", StringComparison.OrdinalIgnoreCase)) section = "Updates";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    // The portal identity, resolved from the signed-in principal alone — the same accessor every
    // portal query uses, and it caches per request, so naming the person costs no extra round trip.
    var portal = await PortalContexts.TryGetCurrentAsync();

    // The contact's own name when the platform knows it; the sign-in name is only the fallback for
    // a session that has no portal row (the refusal page renders this header too).
    var contactName = !string.IsNullOrWhiteSpace(portal?.ContactName) ? portal!.ContactName! : (User.Identity?.Name ?? string.Empty);
    var emailClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
    var contactEmail = string.Equals(emailClaim, contactName, StringComparison.OrdinalIgnoreCase) ? null : emailClaim;

    // ONE place decides the avatar: the contact's photograph when staff have set one on the CRM
    // screen, and the theme's neutral avatar when they have not. Never one of the theme's demo
    // faces — a stranger's photograph shown as the customer is worse than no photograph.
    // ONE place decides the avatar, and after the convergence it decides a URL THIS APPLICATION
    // SERVES rather than a stored file path.
    //
    // WHAT CHANGED AND WHY. This used to render portal.PhotoPath straight into <img src>, which made
    // a guessable /uploads/portal/... path the only thing between a stranger and a named person's
    // photograph - and, because PrivateFileGate reads the DEFAULT authentication scheme while the
    // portal holds its own, it also meant the signed-in customer got 404 on their own picture. The
    // bytes now live outside wwwroot and come back through ClientPortalController.ContactPhoto,
    // which checks that the id IS the caller.
    //
    // PhotoPath is still consulted, for one thing only: whether a photograph EXISTS. The value never
    // reaches the browser. Never one of the theme's demo faces - a stranger's photograph shown as
    // the customer is worse than no photograph.
    var avatarUrl = string.IsNullOrWhiteSpace(portal?.PhotoPath)
        ? "/portal-assets/media/avatars/blank.png"
        : Url.Action("ContactPhoto", "ClientPortal")!;
}
