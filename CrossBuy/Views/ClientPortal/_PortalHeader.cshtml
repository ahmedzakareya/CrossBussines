@{
    // Customer language only. No module names, no internal terminology.
    //
    // Updates and My Documents are the two sections the convergence added. They are entries in THIS
    // array rather than markup of their own for the reason the array exists: the menu is one list, so
    // a new section cannot arrive with a different active-state rule or a different link shape.
    var sections = new (string Action, string Ar, string En)[]
    {
        ("Index",      "الرئيسية",             "Home"),
        ("Quotations", "عروض الأسعار",         "Quotations"),
        ("Projects",   "مشاريعي",              "My Projects"),
        ("Invoices",   "الفواتير والمدفوعات",  "Invoices & Payments"),
        ("Updates",    "المستجدات",            "Updates"),
        ("Documents",  "مستنداتي",             "My Documents"),
    };
}
@foreach (var s in sections)
{
