@using CrossBuy.Models.Context.Accounting
@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var prj = ViewBag.Project as Project;
    var issues = ViewBag.Issues as List<ProjectMaterialIssue> ?? new();
    var whs = ViewBag.Warehouses as List<Warehouse> ?? new();
    var boq = ViewBag.BoqItems as List<BoqItem> ?? new();
    var balances = ViewBag.Balances as List<CrossBuy.BL.ProjectStockRow> ?? new List<CrossBuy.BL.ProjectStockRow>();
    int? selWh = ViewBag.SelectedWarehouseId as int?;
    var edit = ViewBag.EditIssue as ProjectMaterialIssue;
    string nm(string ar, string? en) => isAr ? ar : (string.IsNullOrEmpty(en) ? ar : en);
    string Badge(string s) => s == "Posted" ? "success" : "warning";
    var editLines = edit?.Lines.ToDictionary(l => l.ItemId, l => l) ?? new Dictionary<int, ProjectMaterialIssueLine>();
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading fw-bold fs-3 m-0">@Localizer["Material issue"]</h1>
            <span class="text-muted fs-7">@(prj == null ? "" : prj.Code + " — " + nm(prj.Name, prj.NameEn))</span></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Projects","Project")" class="btn btn-light"><i class="ki-outline ki-arrow-@(isAr ? "right" : "left") fs-2"></i>@Localizer["Projects"]</a>
            <a href="@Url.Action("MaterialIssues","Project", new { id = prj?.ID })" class="btn btn-light-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New issue"]</a>
            @if (selWh != null) { <button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["PrjMsg"] != null) { <div class="alert alert-success">@TempData["PrjMsg"]</div> }
        @if (TempData["PrjErr"] != null) { <div class="alert alert-danger">@TempData["PrjErr"]</div> }

        <!--begin::Issues list-->
        <div class="card mb-5">
            <div class="card-header"><h3 class="card-title fw-bold">@Localizer["Material issues"]</h3></div>
            <div class="card-body pt-2">
                @if (!issues.Any()) { <div class="text-muted fs-6 py-3">@Localizer["No issues yet"]</div> }
                else
                {
                    <div class="table-responsive"><table class="table table-row-bordered align-middle">
                        <thead><tr class="fw-bold text-muted fs-7 text-uppercase" style="border-bottom:2px solid #0E4A9E;"><th>#</th><th>@SR["Date"]</th><th>@SR["Warehouse"]</th><th class="text-center">@Localizer["Lines"]</th><th class="text-center">@SR["Status"]</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var r in issues)
                        {
                            var wh = whs.FirstOrDefault(w => w.ID == r.WarehouseId);
                            <tr class="@(r.ID == edit?.ID ? "bg-light-primary" : "")">
                                <td class="fw-bold">@r.IssueNo</td>
                                <td>@r.IssueDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-muted">@(wh == null ? "—" : wh.Code)</td>
                                <td class="text-center">@r.Lines.Count</td>
                                <td class="text-center"><span class="badge badge-light-@Badge(r.Status)">@Localizer[r.Status]</span></td>
                                <td class="text-center text-nowrap">
                                    <a href="@Url.Action("MaterialIssues","Project", new { id = prj?.ID, b = r.ID, w = r.WarehouseId })" class="btn btn-sm btn-icon btn-light-primary me-1" title="@SR["Edit"]"><i class="ki-outline ki-eye fs-5"></i></a>
                                    @if (r.Status == "Draft")
                                    {
                                        <form asp-action="PostMaterialIssue" method="post" class="d-inline" data-cb-confirm data-cb-action="edit" data-cb-text="@Localizer["Post this material issue? Stock will be reduced."]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.ID" /><input type="hidden" name="projectId" value="@prj?.ID" /><button class="btn btn-sm btn-icon btn-light-primary me-1" title="@Localizer["Post issue"]"><i class="ki-outline ki-check fs-5"></i></button></form>
                                        <form asp-action="DeleteMaterialIssue" method="post" class="d-inline" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Delete issue?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.ID" /><input type="hidden" name="projectId" value="@prj?.ID" /><button class="btn btn-sm btn-icon btn-light-danger" title="@SR["Delete"]"><i class="ki-outline ki-trash fs-5"></i></button></form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody></table></div>
                }
            </div>
        </div>
        <!--end::Issues list-->

        <div class="alert alert-light-primary d-flex align-items-center">
            <i class="ki-outline ki-information-5 fs-2 me-3"></i>
            <span>@Localizer["Entry on post: Dr project execution cost (510104) / Cr inventory (1103) — tagged to the project. Stock is issued via the inventory service."]</span>
        </div>

        <!--begin::Editor-->
        <form asp-action="SaveMaterialIssue" method="post" id="fIssue">@Html.AntiForgeryToken()
            <input type="hidden" name="projectId" value="@(prj?.ID ?? 0)" />
            <input type="hidden" name="issueId" value="@(edit?.ID ?? 0)" />
            <input type="hidden" name="warehouseId" value="@selWh" />
            <input type="hidden" name="rowsJson" id="rowsJson" />
            <div class="card mb-5"><div class="card-body"><div class="row g-5 align-items-end">
                <div class="col-md-4"><label class="required fw-semibold fs-6 mb-2">@SR["Warehouse"]</label>
                    <select id="whSel" class="form-select form-select-solid" data-control="select2" data-placeholder="@Localizer["Select warehouse to load items"]"><option value="">@Localizer["Select warehouse to load items"]</option>
                        @foreach (var w in whs) { <option value="@w.ID" selected="@(selWh == w.ID)">@w.Code — @nm(w.Name, w.NameEn)</option> }</select></div>
                <div class="col-md-4"><label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label>
                    <input name="issueDate" id="mi_date" class="form-control form-control-solid js-mi-date" autocomplete="off" value="@((edit?.IssueDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" /></div>
                <div class="col-md-4"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="note" class="form-control form-control-solid" value="@edit?.Note" /></div>
            </div></div></div>

            @if (selWh == null)
            {
                <div class="card"><div class="card-body text-center text-muted py-12"><i class="ki-outline ki-information-5 fs-3x text-muted mb-3 d-block"></i>@Localizer["Select a warehouse to load its items and balances."]</div></div>
            }
            else
            {
                <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@Localizer["Items to issue"]</h3></div>
                <div class="card-body"><div class="table-responsive"><table class="table table-row-bordered align-middle">
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;"><th style="min-width:240px">@SR["Item"]</th><th class="text-end" style="width:120px">@Localizer["Available"]</th><th class="text-end" style="width:130px">@Localizer["Issue qty"]</th><th style="min-width:220px">@Localizer["BOQ item"]</th></tr></thead>
                    <tbody id="rows">
                    @foreach (var b in balances)
                    {
                        int iid = b.ItemId; decimal bq = b.QtyOnHand;
                        editLines.TryGetValue(iid, out var el);
                        <tr data-item="@iid">
                            <td class="fw-bold text-gray-800">@b.ItemCode — @nm(b.Name, b.NameEn)</td>
                            <td class="text-end text-muted">@bq.ToString("0.##")</td>
                            <td class="text-end"><input type="number" step="0.0001" min="0" class="form-control form-control-solid form-control-sm text-end qty" value="@((el?.Qty ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"></td>
                            <td><select class="form-select form-select-solid form-select-sm boq" data-control="select2" data-placeholder="—" data-allow-clear="true"><option value="">—</option>
                                @foreach (var bi in boq) { <option value="@bi.ID" selected="@(el?.BoqItemId == bi.ID)">@(string.IsNullOrEmpty(bi.Code) ? "" : bi.Code + " · ")@bi.Description</option> }
                            </select></td>
                        </tr>
                    }
                    </tbody></table></div>
                    @if (balances.Count == 0) { <div class="text-center text-muted py-10">@Localizer["No stock in this warehouse."]</div> }
                </div></div>
            }
        </form>
        <!--end::Editor-->
    </div></div>
</div>

@section Scripts {
<script>
(function () {
    if (typeof flatpickr !== 'undefined') { var d = document.getElementById('mi_date'); if (d) flatpickr(d, { dateFormat: "Y-m-d", locale: { firstDayOfWeek: 6 }, allowInput: true }); }
    var whSel = document.getElementById('whSel');
    function whGo() { var v = whSel.value || ''; location.href = '@Url.Action("MaterialIssues","Project")?id=@(prj?.ID)&b=@(edit?.ID ?? 0)' + (v ? ('&w=' + v) : ''); }
    if (whSel) { if (window.jQuery) jQuery(whSel).on('change select2:select', whGo); else whSel.addEventListener('change', whGo); }
    var save = document.getElementById('save');
    if (save) save.addEventListener('click', function () {
        var rows = [];
        document.querySelectorAll('#rows tr').forEach(function (tr) {
            var q = parseFloat(tr.querySelector('.qty').value) || 0;
            if (q <= 0) return;
            var boq = tr.querySelector('.boq').value;
            rows.push({ itemId: parseInt(tr.dataset.item), qty: q, boqItemId: boq ? parseInt(boq) : null });
        });
        document.getElementById('rowsJson').value = JSON.stringify(rows);
        var f = document.getElementById('fIssue');
        if (window.CB && CB.submitForm) CB.submitForm(f, { type: 'save' }); else f.submit();
    });
})();
</script>
}
