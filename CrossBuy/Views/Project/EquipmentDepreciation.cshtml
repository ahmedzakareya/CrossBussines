@using CrossBuy.Models.Context.Accounting
@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var prj = ViewBag.Project as Project;
    var allocs = ViewBag.Allocations as List<EquipmentDepreciationAllocation> ?? new();
    var assets = ViewBag.Assets as List<EquipmentAssetRow> ?? new();
    var edit = ViewBag.EditAlloc as EquipmentDepreciationAllocation;
    string nm(string ar, string? en) => isAr ? ar : (string.IsNullOrEmpty(en) ? ar : en);
    string Badge(string s) => s == "Posted" ? "success" : "warning";
    decimal postedTotal = allocs.Where(x => x.Status == "Posted").Sum(x => x.Amount);
    decimal draftTotal = allocs.Where(x => x.Status != "Posted").Sum(x => x.Amount);
    var assetJson = System.Text.Json.JsonSerializer.Serialize(assets.ToDictionary(a => a.AssetId, a => new { md = a.MonthlyDepreciation, nbv = a.NetBookValue }));
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading fw-bold fs-3 m-0">@Localizer["Equipment depreciation"]</h1>
            <span class="text-muted fs-7">@(prj == null ? "" : prj.Code + " — " + nm(prj.Name, prj.NameEn))</span></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Projects","Project")" class="btn btn-light"><i class="ki-outline ki-arrow-@(isAr ? "right" : "left") fs-2"></i>@Localizer["Projects"]</a>
            <a href="@Url.Action("EquipmentDepreciation","Project", new { id = prj?.ID })" class="btn btn-light-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New allocation"]</a>
            <button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["PrjMsg"] != null) { <div class="alert alert-success">@TempData["PrjMsg"]</div> }
        @if (TempData["PrjErr"] != null) { <div class="alert alert-danger">@TempData["PrjErr"]</div> }

        <!--begin::Allocations list-->
        <div class="card mb-5">
            <div class="card-header"><h3 class="card-title fw-bold">@Localizer["Depreciation allocations"]</h3></div>
            <div class="card-body pt-2">
                @if (!allocs.Any()) { <div class="text-muted fs-6 py-3">@Localizer["No allocations yet"]</div> }
                else
                {
                    <div class="table-responsive"><table class="table table-row-bordered align-middle" style="font-variant-numeric:tabular-nums;">
                        <thead><tr class="fw-bold text-muted fs-7 text-uppercase" style="border-bottom:2px solid #0E4A9E;"><th>#</th><th>@Localizer["Equipment"]</th><th>@Localizer["Period"]</th><th class="text-end">@Localizer["Share"]</th><th class="text-center">@SR["Status"]</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var r in allocs)
                        {
                            <tr class="@(r.ID == edit?.ID ? "bg-light-primary" : "")">
                                <td class="fw-bold">@r.AllocationNo</td>
                                <td class="text-gray-800">@(r.Asset == null ? ("#" + r.FixedAssetId) : ((string.IsNullOrWhiteSpace(r.Asset.AssetNo) ? "" : r.Asset.AssetNo + " — ") + nm(r.Asset.Name, r.Asset.NameEn)))</td>
                                <td class="text-muted">@r.PeriodDate.ToString("yyyy-MM")</td>
                                <td class="text-end fw-bold">@r.Amount.ToString("N2")</td>
                                <td class="text-center"><span class="badge badge-light-@Badge(r.Status)">@Localizer[r.Status]</span></td>
                                <td class="text-center text-nowrap">
                                    <a href="@Url.Action("EquipmentDepreciation","Project", new { id = prj?.ID, a = r.ID })" class="btn btn-sm btn-icon btn-light-primary me-1" title="@SR["Edit"]"><i class="ki-outline ki-eye fs-5"></i></a>
                                    @if (r.Status == "Draft")
                                    {
                                        <form asp-action="PostEquipmentDepreciation" method="post" class="d-inline" data-cb-confirm data-cb-action="edit" data-cb-text="@Localizer["Post this allocation? Dr project cost / Cr depreciation expense (does not touch the depreciation schedule)."]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.ID" /><input type="hidden" name="projectId" value="@prj?.ID" /><button class="btn btn-sm btn-icon btn-light-primary me-1" title="@Localizer["Post allocation"]"><i class="ki-outline ki-check fs-5"></i></button></form>
                                        <form asp-action="DeleteEquipmentDepreciation" method="post" class="d-inline" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Delete allocation?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.ID" /><input type="hidden" name="projectId" value="@prj?.ID" /><button class="btn btn-sm btn-icon btn-light-danger" title="@SR["Delete"]"><i class="ki-outline ki-trash fs-5"></i></button></form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody></table></div>
                    <div class="d-flex flex-wrap gap-6 justify-content-end border-top pt-5 mt-2">
                        <div class="text-end"><div class="fs-8 text-muted text-uppercase">@Localizer["Unposted"]</div><div class="fs-3 fw-bold text-warning">@draftTotal.ToString("N2")</div></div>
                        <div class="text-end"><div class="fs-8 text-muted text-uppercase">@Localizer["Posted"]</div><div class="fs-3 fw-bold text-primary">@postedTotal.ToString("N2")</div></div>
                    </div>
                }
            </div>
        </div>
        <!--end::Allocations list-->

        <div class="alert alert-light-primary d-flex align-items-center">
            <i class="ki-outline ki-information-5 fs-2 me-3"></i>
            <span>@Localizer["On post: Dr project execution cost (510104) / Cr depreciation expense (520103) — the equipment's depreciation share is reclassified into project cost, tagged to the project. Accumulated depreciation and the depreciation schedule are not affected."]</span>
        </div>

        <!--begin::Editor-->
        <form asp-action="SaveEquipmentDepreciation" method="post" id="fAlloc">@Html.AntiForgeryToken()
            <input type="hidden" name="projectId" value="@(prj?.ID ?? 0)" />
            <input type="hidden" name="allocId" value="@(edit?.ID ?? 0)" />
            <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@(edit == null ? Localizer["New allocation"] : Localizer["Edit allocation"])</h3></div>
            <div class="card-body">
                <div class="row g-5">
                    <div class="col-md-6"><label class="required fw-semibold fs-6 mb-2">@Localizer["Equipment"]</label>
                        <select name="fixedAssetId" id="assetSel" class="form-select form-select-solid" data-control="select2" data-placeholder="@Localizer["Select equipment"]"><option value="">@Localizer["Select equipment"]</option>
                            @foreach (var a in assets) { <option value="@a.AssetId" selected="@(edit?.FixedAssetId == a.AssetId)">@a.Label</option> }</select>
                        <div class="form-text" id="mdRef"></div>
                    </div>
                    <div class="col-md-3"><label class="required fw-semibold fs-6 mb-2">@Localizer["Period"]</label>
                        <input name="periodDate" id="ed_period" class="form-control form-control-solid" autocomplete="off" value="@((edit?.PeriodDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" /></div>
                    <div class="col-md-3"><label class="required fw-semibold fs-6 mb-2">@Localizer["Share amount"]</label>
                        <input type="number" step="0.01" min="0" name="amount" id="ed_amount" class="form-control form-control-solid text-end" value="@((edit?.Amount ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))" /></div>
                </div>
                <div class="separator my-6"></div>
                <div class="text-muted fs-7 mb-3">@Localizer["Optional helper — hours × rate fills the share amount"]</div>
                <div class="row g-5 align-items-end">
                    <div class="col-md-3"><label class="fw-semibold fs-6 mb-2">@Localizer["Hours"]</label>
                        <input type="number" step="0.01" min="0" id="ed_hours" name="hours" class="form-control form-control-solid text-end" value="@(edit?.Hours?.ToString(System.Globalization.CultureInfo.InvariantCulture))" /></div>
                    <div class="col-md-3"><label class="fw-semibold fs-6 mb-2">@Localizer["Rate per hour"]</label>
                        <input type="number" step="0.0001" min="0" id="ed_rate" name="rate" class="form-control form-control-solid text-end" value="@(edit?.Rate?.ToString(System.Globalization.CultureInfo.InvariantCulture))" /></div>
                    <div class="col-md-6"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label>
                        <input name="note" class="form-control form-control-solid" value="@edit?.Note" /></div>
                </div>
            </div></div>
        </form>
        <!--end::Editor-->
    </div></div>
</div>

@section Scripts {
<script>
(function () {
    var assets = @Html.Raw(assetJson);
    if (typeof flatpickr !== 'undefined') { var d = document.getElementById('ed_period'); if (d) flatpickr(d, { dateFormat: "Y-m-d", locale: { firstDayOfWeek: 6 }, allowInput: true }); }

    var assetSel = document.getElementById('assetSel'), mdRef = document.getElementById('mdRef');
    function showRef() {
        var id = assetSel.value, a = id ? assets[id] : null;
        if (a) mdRef.innerHTML = '@Localizer["Monthly depreciation"]: <b>' + (a.md).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) + '</b> · @Localizer["Net book value"]: ' + (a.nbv).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
        else mdRef.innerHTML = '';
    }
    if (assetSel) { if (window.jQuery) jQuery(assetSel).on('change select2:select', showRef); else assetSel.addEventListener('change', showRef); showRef(); }

    var h = document.getElementById('ed_hours'), r = document.getElementById('ed_rate'), amt = document.getElementById('ed_amount');
    function calcHelper() {
        var hv = parseFloat(h.value) || 0, rv = parseFloat(r.value) || 0;
        if (hv > 0 && rv > 0) amt.value = (Math.round(hv * rv * 100) / 100);
    }
    [h, r].forEach(function (el) { if (el) el.addEventListener('input', calcHelper); });

    var save = document.getElementById('save');
    if (save) save.addEventListener('click', function () {
        var f = document.getElementById('fAlloc');
        if (window.CB && CB.submitForm) CB.submitForm(f, { type: 'save' }); else f.submit();
    });
})();
</script>
}
