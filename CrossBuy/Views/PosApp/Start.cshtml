@using CrossBuy.Models.Context.Pos
@using CrossBuy.Controllers
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutPosApp.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var terminals = ViewBag.Terminals as List<PosTerminal> ?? new();
    var open = ViewBag.OpenShifts as Dictionary<int, PosShift?> ?? new();
    ViewData["Title"] = Localizer["Choose terminal"].Value;
}
@* Content only — the header/shell come from _LayoutPosApp (the accounting-style shell). *@
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-6 py-lg-8">
    <div class="app-container container-xxl text-center">
        <h1 class="page-heading fw-bold text-gray-900 fs-2hx mb-2">@Localizer["Choose your terminal"]</h1>
        <div class="text-muted fs-5">@Localizer["Open a new shift or continue the open one."]</div>
    </div>
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-xxl">
        @if (TempData["PosErr"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center mx-auto mb-8" style="max-width:560px">
                <i class="ki-outline ki-information-5 fs-2 me-3"></i>@TempData["PosErr"]
            </div>
        }
        @if (ViewBag.NoActivity == true)
        {
            <div class="alert alert-warning d-flex align-items-center mx-auto mb-8" style="max-width:640px">
                <i class="ki-outline ki-information-5 fs-2 me-3"></i>@(isAr ? "هذا الفرع بلا نشاط محدَّد — يعمل كفرع مطعم توافقيًّا. يُنصح بضبط نشاطه." : "This branch has no defined activity — it operates as a restaurant branch for compatibility. Setting its activity is recommended.")
            </div>
        }
        @if (!terminals.Any())
        {
            <div class="card shadow-sm mx-auto" style="max-width:560px">
                <div class="card-body text-center py-15">
                    <span class="symbol symbol-90px mb-5"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-screen fs-3x text-primary"></i></span></span>
                    <div class="fw-bold fs-3 text-gray-900 mb-2">@Localizer["No terminals for this branch"]</div>
                    <div class="text-muted fs-6">@Localizer["Admin defines them in «Cashier terminals»."]</div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-6 g-xl-9 justify-content-center">
                @foreach (var t in terminals)
                {
                    open.TryGetValue(t.ID, out var sh);
                    <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                        <form method="post" action="/pos/start" class="card card-flush border border-gray-300 shadow-sm h-100">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="terminalId" value="@t.ID" />
                            <div class="card-header border-0 pt-8 justify-content-center">
                                <span class="symbol symbol-90px">
                                    <span class="symbol-label @(sh != null ? "bg-light-success" : "bg-light-primary")">
                                        <i class="ki-outline ki-screen fs-3x @(sh != null ? "text-primary" : "text-primary")"></i>
                                    </span>
                                </span>
                            </div>
                            <div class="card-body text-center pt-4 d-flex flex-column">
                                <div class="fw-bold fs-2 text-gray-900">@t.Code</div>
                                <div class="text-muted fs-6 mb-6">@t.Name</div>
                                <div class="mt-auto">
                                    @if (sh != null)
                                    {
                                        <input type="hidden" name="resumeShiftId" value="@sh.ID" />
                                        <div class="d-flex align-items-center justify-content-center bg-light-success text-primary rounded py-3 mb-4 fw-semibold">
                                            <i class="ki-outline ki-time fs-5 text-primary me-2"></i>
                                            @Localizer["Shift open"] · @(sh.ShiftType == "Evening" ? Localizer["Evening"] : Localizer["Morning"])
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100"><i class="ki-outline ki-entrance-right fs-4"></i>@Localizer["Enter"]</button>
                                    }
                                    else
                                    {
                                        <div class="separator separator-dashed mb-4"></div>
                                        <div class="text-start mb-3">
                                            <label class="form-label fs-8 text-muted mb-1">@Localizer["Shift type"]</label>
                                            <select name="shiftType" class="form-select form-select-solid form-select-sm">
                                                <option value="Morning">@Localizer["Morning shift"]</option>
                                                <option value="Evening">@Localizer["Evening shift"]</option>
                                            </select>
                                        </div>
                                        <div class="text-start mb-4">
                                            <label class="form-label fs-8 text-muted mb-1">@Localizer["Opening float"]</label>
                                            <input type="number" step="0.01" name="openingFloat" value="0" class="form-control form-control-solid form-control-sm" />
                                        </div>
                                        <button type="submit" class="btn btn-light-primary w-100"><i class="ki-outline ki-plus fs-4"></i>@Localizer["Open & enter"]</button>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
<!--end::Content-->
