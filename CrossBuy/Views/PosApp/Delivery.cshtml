@using CrossBuy.Controllers
@using CrossBuy.Models.Context.Pos
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var ctx = ViewBag.Ctx as PosAppController.PosCtx;
    var drivers = ViewBag.Drivers as List<Driver> ?? new();
    var isManager = ViewBag.IsManager == true;
    ViewData["Title"] = Localizer["Delivery board"].Value;
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Delivery board"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@SR["POS"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@ctx?.BranchName</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge badge-light-primary fs-7 py-2">@Localizer["Orders"]: <span id="delivCount">0</span></span>
            <button type="button" id="delivRefresh" class="btn btn-sm btn-light"><i class="ki-outline ki-arrows-circle fs-3"></i>@Localizer["Refresh"]</button>
            <a href="/pos/start" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-exit-left fs-3"></i>@SR["Back"]</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5" id="delivGrid"></div>
        <div class="card d-none" id="delivEmpty"><div class="card-body text-center py-15">
            <i class="ki-outline ki-scooter fs-3x text-primary mb-4 d-block"></i>
            <span class="text-muted fs-5">@Localizer["No open delivery orders"]</span>
        </div></div>
    </div></div>
</div>

<form id="af">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="~/Backend-assets/plugins/signalr.min.js" asp-append-version="true"></script>
    <script>
        window.DELIV = {
            rtl: @(isAr ? "true" : "false"),
            drivers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(drivers.Select(d => new { id = d.ID, name = d.Name }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })),
            urls: { orders: '/pos/delivery/orders', driver: '/pos/order/driver', status: '/pos/order/delivery-status' },
            L: {
                out: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Out for delivery"].Value)),
                delivered: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Deliver"].Value)),
                deliveredDone: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Delivered"].Value)),
                awaitingPay: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Awaiting payment"].Value)),
                kNew: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["New"].Value)),
                kPrep: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Preparing"].Value)),
                kReady: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Ready"].Value)),
                notReady: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Not ready yet"].Value)),
                driver: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Driver"].Value)),
                pickDriver: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Assign driver"].Value)),
                order: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Order"].Value)),
                items: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["items"].Value)),
                since: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Since order"].Value)),
                confirmOut: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Confirm order out for delivery?"].Value)),
                confirmDelivered: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Confirm order delivered?"].Value)),
                confirmDriver: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Assign this driver to the order?"].Value))
            }
        };
    </script>
    <script src="~/Backend-assets/js/pos-delivery.js" asp-append-version="true"></script>
}
