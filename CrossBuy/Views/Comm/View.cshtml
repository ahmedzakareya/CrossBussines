@using CrossBuy.BL
@model MailFull
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    int cAll = ViewBag.CountAll ?? 0, cSent = ViewBag.CountSent ?? 0, cOut = ViewBag.CountOutbox ?? 0, cFail = ViewBag.CountFailed ?? 0;
    var initial = string.IsNullOrEmpty(Model.ToAddress) ? "?" : Model.ToAddress.Substring(0, 1).ToUpper();
    string sBadge = Model.Status switch { "Sent" => "badge-light-success", "Failed" => "badge-light-danger", _ => "badge-light-warning" };
    string sLabel = Model.Status switch { "Sent" => Localizer["Sent"].Value, "Failed" => Localizer["Failed"].Value, _ => Localizer["Queued"].Value };
    string human(long n) => n < 1024 ? $"{n} B" : n < 1048576 ? $"{n / 1024} KB" : $"{n / 1048576.0:0.#} MB";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Email"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Comm")" class="text-muted">@Localizer["Email"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted text-truncate mw-300px">@Model.Subject</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="d-flex flex-column flex-lg-row">
            <!--begin::Sidebar-->
            <div class="flex-column flex-lg-row-auto w-100 w-lg-275px mb-6 mb-lg-0">
                <div class="card card-flush mb-0"><div class="card-body">
                    <a href="@Url.Action("Compose","Comm")" class="btn btn-primary fw-bold w-100 mb-8">@Localizer["New Message"]</a>
                    <div class="menu menu-column menu-rounded menu-state-bg menu-state-title-primary menu-state-icon-primary">
                        <div class="menu-item mb-2"><a href="@Url.Action("Index","Comm", new { folder = "All" })" class="menu-link"><span class="menu-icon"><i class="ki-outline ki-sms fs-2 me-3"></i></span><span class="menu-title fw-bold">@Localizer["All"]</span><span class="badge badge-light-primary">@cAll</span></a></div>
                        <div class="menu-item mb-2"><a href="@Url.Action("Index","Comm", new { folder = "Outbox" })" class="menu-link"><span class="menu-icon"><i class="ki-outline ki-time fs-2 me-3"></i></span><span class="menu-title fw-bold">@Localizer["Outbox"]</span>@if (cOut > 0){<span class="badge badge-light-warning">@cOut</span>}</a></div>
                        <div class="menu-item mb-2"><a href="@Url.Action("Index","Comm", new { folder = "Sent" })" class="menu-link"><span class="menu-icon"><i class="ki-outline ki-send fs-2 me-3"></i></span><span class="menu-title fw-bold">@Localizer["Sent"]</span>@if (cSent > 0){<span class="badge badge-light-success">@cSent</span>}</a></div>
                        <div class="menu-item"><a href="@Url.Action("Index","Comm", new { folder = "Failed" })" class="menu-link"><span class="menu-icon"><i class="ki-outline ki-cross-circle fs-2 me-3"></i></span><span class="menu-title fw-bold">@Localizer["Failed"]</span>@if (cFail > 0){<span class="badge badge-light-danger">@cFail</span>}</a></div>
                    </div>
                </div></div>
            </div>
            <!--end::Sidebar-->
            <!--begin::Message-->
            <div class="flex-lg-row-fluid ms-lg-7 ms-xl-10">
                <div class="card">
                    <div class="card-header align-items-center py-4 gap-2 flex-wrap">
                        <a href="@Url.Action("Index","Comm")" class="btn btn-sm btn-icon btn-light" title="@SR["Back"]"><i class="ki-outline ki-arrow-left fs-2"></i></a>
                        <h2 class="fw-bold fs-4 m-0 flex-grow-1 text-truncate">@Model.Subject</h2>
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Compose","Comm", new { parentId = Model.Id, kind = "Reply" })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-arrow-left fs-5"></i>@Localizer["Reply"]</a>
                            <a href="@Url.Action("Compose","Comm", new { parentId = Model.Id, kind = "ReplyAll" })" class="btn btn-sm btn-light"><i class="ki-outline ki-arrow-mix fs-5"></i>@Localizer["Reply all"]</a>
                            <a href="@Url.Action("Compose","Comm", new { parentId = Model.Id, kind = "Forward" })" class="btn btn-sm btn-light"><i class="ki-outline ki-arrow-right fs-5"></i>@Localizer["Forward"]</a>
                            @if (Model.Status != "Sent")
                            {
                                <form method="post" asp-action="Resend" asp-controller="Comm" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-sm btn-light-warning"><i class="ki-outline ki-arrows-circle fs-5"></i>@Localizer["Retry"]</button></form>
                            }
                            @{ var inTrash = Model.DeletedAt != null; }
                            @* IT NOW CARRIES VISIBLE TEXT, like every sibling in this row. It used to be
                               icon-only: the title and aria-label satisfied a screen reader, but a sighted
                               user scanning a row of labelled buttons simply did not see the destructive
                               one, and reported the screen as having no delete at all.
                               The WORD changes with the folder, because the ACT does: from Deleted Items
                               this is final, and a control that said the same thing in both places would
                               be hiding that. Only the irreversible one asks for confirmation. *@
                            @* The confirm is attached in script rather than as a conditional attribute:
                               Razor does not allow C# inside a tag-helper's attribute declaration, and
                               only the irreversible branch asks at all. *@
                            <form method="post" asp-action="Delete" asp-controller="Comm" class="d-inline"
                                  data-confirm="@(inTrash ? Localizer["Delete permanently? This cannot be undone."].Value : Localizer["Move to Deleted Items?"].Value)">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ids" value="@Model.Id" />
                                <input type="hidden" name="folder" value="@(inTrash ? "Trash" : "All")" />
                                <button class="btn btn-sm btn-light-danger" title="@SR["Delete"]" aria-label="@SR["Delete"]">
                                    <i class="ki-outline ki-trash fs-5"></i>@(inTrash ? @Localizer["Delete permanently"] : @SR["Delete"])
                                </button>
                            </form>
                            @if (inTrash)
                            {
                                <form method="post" asp-action="Restore" asp-controller="Comm" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ids" value="@Model.Id" />
                                    <button class="btn btn-sm btn-light-primary"><i class="ki-outline ki-arrow-circle-left fs-5"></i>@Localizer["Restore"]</button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-6">
                            @* THE PERSON, when we have a picture of them. Rendered exactly as the list
                               renders it so the row and the message it opens show the same face; the
                               coloured initial stays the fallback, because most mail goes to customers
                               and vendors who have no employee record. *@
                            <div class="symbol symbol-45px me-4">
                                @if (!string.IsNullOrWhiteSpace(Model.RecipientPhoto))
                                {
                                    <img src="@Url.Content("~" + Model.RecipientPhoto.Replace("\\", "/"))"
                                         alt="@Model.ToAddress" class="symbol-label" style="object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="symbol-label bg-light-primary text-primary fw-bold fs-3">@initial</div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-gray-900 fs-5"><span class="text-muted fw-semibold fs-7">@SR["To"]:</span> @Model.ToAddress</div>
                                @if (!string.IsNullOrWhiteSpace(Model.Cc)) { <div class="fs-8 text-muted">@SR["Cc"]: @Model.Cc</div> }
                                <div class="fs-8 text-muted">@(Model.SentAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? Model.CreatedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))</div>
                            </div>
                            <span class="badge @sBadge fs-7">@sLabel</span>
                        </div>
                        @if (Model.Status == "Failed" && !string.IsNullOrEmpty(Model.Error))
                        {
                            <div class="alert alert-danger d-flex align-items-center py-3 mb-6"><i class="ki-outline ki-information-5 fs-2 text-danger me-3"></i><div class="fs-7">@Model.Error</div></div>
                        }
                        @* ========================================================================
                           THE INVITATION, DRAWN AS A MEETING.

                           The platform already sends a proper METHOD:REQUEST VEVENT; this screen used to
                           show it as a grey chip with a filename, so an invitation arrived looking like
                           paperwork and you had to download a file to find out when it was.

                           READ FROM THE .ics, NOT FROM THE SUBJECT. The subject of these messages does
                           carry a human summary, but it is composed for a person, it is localized, and it
                           changes whenever somebody edits the wording. The VEVENT has a grammar.

                           NO ACCEPT / DECLINE BUTTONS, and their absence is deliberate rather than
                           unfinished - see the note under the card.
                           ======================================================================== *@
                        @if (Model.Invite is { } inv)
                        {
                            var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
                            var cal = ar ? new System.Globalization.CultureInfo("ar-EG") : System.Globalization.CultureInfo.CurrentUICulture;

                            <div class="card bg-light-primary border border-primary border-dashed mb-6">
                                <div class="card-body p-5">
                                    <div class="d-flex align-items-start">
                                        @* The date block a calendar client puts on the left: the day you are
                                           being asked about, legible before any of the words are read. *@
                                        <div class="text-center me-5 flex-shrink-0">
                                            <div class="fs-8 fw-bold text-uppercase text-danger">
                                                @inv.StartsAt!.Value.ToLocalTime().ToString("MMM", cal)
                                            </div>
                                            <div class="fs-2hx fw-bolder text-gray-900 lh-1">
                                                @inv.StartsAt!.Value.ToLocalTime().Day
                                            </div>
                                            <div class="fs-8 text-muted">
                                                @inv.StartsAt!.Value.ToLocalTime().ToString("ddd", cal)
                                            </div>
                                        </div>

                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="ki-outline ki-calendar-tick fs-2 text-primary me-2"></i>
                                                <span class="fw-bold fs-5 text-gray-900">@inv.Title</span>
                                                @if (inv.IsCancellation)
                                                {
                                                    @* A withdrawal is not an invitation awaiting an answer, and
                                                       drawing it as one would be the card lying about its state. *@
                                                    <span class="badge badge-light-danger ms-2">@Localizer["Cancelled"]</span>
                                                }
                                            </div>

                                            <div class="d-flex align-items-center text-gray-700 fs-7 mb-1">
                                                <i class="ki-outline ki-time fs-4 text-muted me-2"></i>
                                                <bdi>
                                                    @if (inv.AllDay)
                                                    {
                                                        @inv.StartsAt!.Value.ToString("d", cal)
                                                        @if (inv.EndsAt is { } ad && ad.Date > inv.StartsAt!.Value.Date)
                                                        {
                                                            <text> — </text>@ad.ToString("d", cal)
                                                        }
                                                        <span class="text-muted ms-2">@Localizer["All day"]</span>
                                                    }
                                                    else
                                                    {
                                                        @inv.StartsAt!.Value.ToLocalTime().ToString("f", cal)
                                                        @if (inv.EndsAt is { } e)
                                                        {
                                                            <text> — </text>@e.ToLocalTime().ToString("t", cal)
                                                        }
                                                    }
                                                </bdi>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(inv.Location))
                                            {
                                                <div class="d-flex align-items-center text-gray-700 fs-7 mb-1">
                                                    <i class="ki-outline ki-geolocation fs-4 text-muted me-2"></i>
                                                    <span>@inv.Location</span>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(inv.Description))
                                            {
                                                <div class="d-flex align-items-start text-gray-700 fs-7 mb-1">
                                                    <i class="ki-outline ki-notepad-edit fs-4 text-muted me-2 mt-1"></i>
                                                    <span style="white-space:pre-wrap">@inv.Description</span>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(inv.OrganizerName) || !string.IsNullOrWhiteSpace(inv.OrganizerEmail))
                                            {
                                                <div class="d-flex align-items-center text-gray-700 fs-7 mb-1">
                                                    <i class="ki-outline ki-profile-circle fs-4 text-muted me-2"></i>
                                                    <span>@Localizer["Organizer"]:</span>
                                                    <bdi class="ms-1">@(inv.OrganizerName ?? inv.OrganizerEmail)</bdi>
                                                </div>
                                            }

                                            @if (inv.Attendees.Count > 0)
                                            {
                                                <div class="d-flex align-items-start text-gray-700 fs-7">
                                                    <i class="ki-outline ki-people fs-4 text-muted me-2 mt-1"></i>
                                                    <div>
                                                        @* Capped at six with a count. A thirty-person invitation
                                                           would otherwise push the message body off the screen. *@
                                                        @foreach (var who in inv.Attendees.Take(6))
                                                        {
                                                            <bdi class="badge badge-light me-1 mb-1">@who</bdi>
                                                        }
                                                        @if (inv.Attendees.Count > 6)
                                                        {
                                                            <span class="text-muted">+@(inv.Attendees.Count - 6)</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @{
                                        var icsFile = Model.Attachments.FirstOrDefault(a =>
                                            a.FileName.EndsWith(".ics", StringComparison.OrdinalIgnoreCase));
                                    }
                                    @if (icsFile != null)
                                    {
                                        <div class="separator separator-dashed my-4"></div>
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            @* THIS PRODUCT'S calendar, not a file for somebody else's. The button
                                               used to hand over the .ics, which is what you do when the recipient's
                                               calendar lives elsewhere - here it is one screen away. The .ics is
                                               still on the message as an attachment for anyone who wants it.

                                               TWO STATES, DECIDED BEFORE THE READER TOUCHES ANYTHING. The meeting
                                               is usually already on their calendar - the organiser's send put it
                                               there - so the honest control is a STATEMENT plus a way in, not an
                                               action that turns out to have nothing to do. The button appears only
                                               when pressing it would actually change something. *@
                                            @if (ViewBag.InviteOnCalendar == true)
                                            {
                                                <a class="btn btn-sm btn-light-success"
                                                   href="@(ViewBag.InviteCalendarUrl as string)">
                                                    <i class="ki-outline ki-calendar-tick fs-5"></i>@Localizer["In your calendar — open it"]
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button" id="cb-addcal" class="btn btn-sm btn-light-primary">
                                                    <i class="ki-outline ki-calendar-add fs-5"></i>@Localizer["Add to calendar"]
                                                </button>
                                            }
                                            @* THE THREE ANSWERS, shown only to someone this meeting is actually
                                               addressed to. A forwarded invitation shows the card and no buttons,
                                               because replying must not add you to a meeting you were not invited
                                               to - that check lives in the responder, on the attendee row.

                                               The chosen one is FILLED rather than outlined, so the card states
                                               what you answered instead of asking again every time it opens. *@
                                            @if (ViewBag.CanRespond == true)
                                            {
                                                string cur = ViewBag.InviteResponse as string ?? "";
                                                <div class="btn-group btn-group-sm" role="group" aria-label="@Localizer["Respond to this invitation"]">
                                                    <button type="button" class="btn @(cur == "ACCEPTED" ? "btn-success" : "btn-light-success") cb-rsvp" data-r="ACCEPTED">
                                                        <i class="ki-outline ki-check fs-5"></i>@Localizer["Accept"]
                                                    </button>
                                                    <button type="button" class="btn @(cur == "TENTATIVE" ? "btn-primary" : "btn-light-primary") cb-rsvp" data-r="TENTATIVE">
                                                        <i class="ki-outline ki-question fs-5"></i>@Localizer["Tentative"]
                                                    </button>
                                                    <button type="button" class="btn @(cur == "DECLINED" ? "btn-danger" : "btn-light-danger") cb-rsvp" data-r="DECLINED">
                                                        <i class="ki-outline ki-cross fs-5"></i>@Localizer["Decline"]
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="separator mb-6"></div>
                        @{ var cbFullDoc = "<!doctype html><html dir=\"auto\"><head><meta charset=\"utf-8\"><style>body{font-family:Inter,Helvetica,Arial,sans-serif;font-size:15px;color:#181c32;margin:0;padding:6px;word-wrap:break-word}img{max-width:100%}table{max-width:100%}</style></head><body>" + (Model.Body ?? "") + "</body></html>"; }
                        @* ---- THE ORIGINAL MESSAGE, FOLDED AWAY WHEN A CARD SAYS THE SAME THING ----
                           
                           The invitation mail this product sends is GENERATED: title, "X invited you to an
                           event", when, where, description. Every one of those is now on the card above it,
                           so leaving it open printed the meeting twice.
                           
                           AND IT IS FROZEN IN THE LANGUAGE IT WAS SENT IN. The body is stored content, not
                           UI: switching the interface to French leaves it Arabic, which is what made the
                           screen look half-translated. The card follows the reader's language; the body
                           cannot, so the card leads and the body is available rather than in the way.
                           
                           FOLDED, NOT DROPPED. It is the message as it was actually sent - the only honest
                           record of what the recipient received - and one click away. *@
                        @if (Model.Invite is not null)
                        {
                            <details class="mb-2">
                                <summary class="text-muted fs-7 cursor-pointer">@Localizer["Show original message"]</summary>
                                <iframe id="cbMailBody" class="w-100 border-0 mt-3" style="min-height:200px" sandbox="allow-same-origin" srcdoc="@cbFullDoc"></iframe>
                            </details>
                        }
                        else
                        {
                            <!-- email HTML body: rendered server-side into the sandboxed iframe's srcdoc (Razor attribute-encodes it). No inline-script embedding → nothing can break out. sandbox has no allow-scripts → stored-XSS-safe. -->
                            <iframe id="cbMailBody" class="w-100 border-0" style="min-height:200px" sandbox="allow-same-origin" srcdoc="@cbFullDoc"></iframe>
                        }
                        @if (Model.Attachments.Any())
                        {
                            <div class="separator my-6"></div>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var a in Model.Attachments)
                                {
                                    <a href="@a.FilePath" target="_blank" class="d-flex align-items-center border border-dashed rounded p-3 text-gray-800">
                                        <i class="ki-outline ki-paper-clip fs-2 text-primary me-3"></i>
                                        <div><div class="fw-semibold">@a.FileName</div><div class="fs-8 text-muted">@human(a.Size)</div></div>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <!--end::Message-->
        </div>
    </div></div>
</div>

@section Scripts {
<script>
    // ---- ANSWERING THE INVITATION ------------------------------------------------------------
    // Updated in place: a reload would close the message you are reading in order to repaint three
    // buttons. The server returns the stored answer, and the page paints THAT rather than what was
    // clicked - so a refusal leaves the buttons showing the truth.
    (function () {
        var btns = document.querySelectorAll('.cb-rsvp');
        var tok = document.querySelector('input[name="__RequestVerificationToken"]');
        var solidOf = { ACCEPTED: 'btn-success', TENTATIVE: 'btn-primary', DECLINED: 'btn-danger' };

        function paint(status) {
            btns.forEach(function (x) {
                var r = x.getAttribute('data-r');
                var solid = solidOf[r], light = 'btn-light-' + solid.slice(4);
                var on = r === status;
                x.classList.toggle(solid, on);
                x.classList.toggle(light, !on);
            });
        }

        var cal = document.getElementById('cb-addcal');
        if (cal) {
            cal.addEventListener('click', function () {
                var fd = new FormData();
                fd.append('id', '@Model.Id');
                if (tok) fd.append('__RequestVerificationToken', tok.value);
                cal.disabled = true;
                fetch('@Url.Action("AddToCalendar","Comm")', { method: 'POST', credentials: 'same-origin', body: fd })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        // The button SAYS WHAT HAPPENED and stays spent. "Added" and "already there"
                        // are different outcomes and a single generic toast would hide the second,
                        // which is the one that tells you a colleague already put it on the calendar.
                        if (!res || !res.ok) { cal.disabled = false; return; }

                        // THE BUTTON BECOMES THE SAME LINK THE SCREEN WOULD HAVE SHOWN had the meeting
                        // been there on arrival, so the two routes to this state end up identical and
                        // a reload changes nothing.
                        //
                        // IT POINTS AT THE MEETING, not at the calendar. The calendar opens on the
                        // current month and a meeting is routinely weeks away in either direction, so
                        // a bare /Calendar link lands on an empty grid and reads as "it did not work".
                        // res.url carries ?day=&eventId=, which the calendar already understands: it
                        // renders on that day and opens the event's own card.
                        //
                        // AND IT DOES NOT NAVIGATE BY ITSELF. Adding a meeting and going to look at it
                        // are two decisions; taking the reader off the message they were reading makes
                        // the second one for them, and they lose their place in the mailbox.
                        //
                        // Falling back to the plain calendar when the server sent no url keeps a way
                        // in rather than a dead button, which is the right failure for a link.
                        var open = document.createElement('a');
                        open.className = 'btn btn-sm btn-light-success';
                        open.href = res.url || '@Url.Action("Index","Calendar")';
                        open.innerHTML = '<i class="ki-outline ki-calendar-tick fs-5"></i>' +
                            (res.added
                                ? '@Localizer["Added — open calendar"]'
                                : '@Localizer["In your calendar — open it"]');
                        cal.replaceWith(open);
                    })
                    .catch(function () { cal.disabled = false; });
            });
        }

        btns.forEach(function (b) {
            b.addEventListener('click', function () {
                var fd = new FormData();
                fd.append('id', '@Model.Id');
                fd.append('response', b.getAttribute('data-r'));
                if (tok) fd.append('__RequestVerificationToken', tok.value);
                fetch('@Url.Action("Respond","Comm")', { method: 'POST', credentials: 'same-origin', body: fd })
                    .then(function (r) { return r.json(); })
                    .then(function (res) { if (res && res.ok) paint(res.status); });
            });
        });
    })();
    // Both deletes ask, and the message says WHICH delete this is - reversible or final. The dialog
    // is the product's own (Swal) with the browser's confirm as a fallback, so a plugin bundle that
    // failed to load degrades to a weaker prompt rather than to no prompt at all.
    document.querySelectorAll('form[data-confirm]').forEach(function (f) {
        var msg = f.getAttribute('data-confirm');
        if (!msg) return;
        f.addEventListener('submit', function (e) {
            if (f.dataset.confirmed === '1') return;      // the resubmit we trigger ourselves
            e.preventDefault();
            if (window.Swal) {
                Swal.fire({
                    text: msg, icon: 'warning', showCancelButton: true, buttonsStyling: false,
                    confirmButtonText: '@SR["Yes"]', cancelButtonText: '@SR["Cancel"]',
                    customClass: { confirmButton: 'btn btn-danger', cancelButton: 'btn btn-light' }
                }).then(function (r) { if (r.isConfirmed) { f.dataset.confirmed = '1'; f.submit(); } });
            } else if (confirm(msg)) { f.dataset.confirmed = '1'; f.submit(); }
        });
    });
</script>
<script>
    // resize-only: the body is already in the iframe's srcdoc (server-side). No body embedded here → nothing can break out.
    (function () {
        var f = document.getElementById('cbMailBody'); if (!f) return;
        f.addEventListener('load', function () { try { var h = f.contentWindow.document.body.scrollHeight; if (h) f.style.height = (h + 24) + 'px'; } catch (e) { } });
    })();
</script>
}
