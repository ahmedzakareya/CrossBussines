@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    int cAll = ViewBag.CountAll ?? 0, cSent = ViewBag.CountSent ?? 0, cOut = ViewBag.CountOutbox ?? 0, cFail = ViewBag.CountFailed ?? 0;
    var kind = (ViewBag.Kind as string) ?? "New";
    var emTo = (ViewBag.To as string) ?? ""; var emCc = (ViewBag.Cc as string) ?? "";
    var emSubject = (ViewBag.Subject as string) ?? ""; var emBody = (ViewBag.Body as string) ?? "";
    var inherited = ViewBag.Inherited as List<CrossBuy.BL.MailAttachmentDto> ?? new();
    var title = kind == "Forward" ? Localizer["Forward"].Value : (kind == "Reply" || kind == "ReplyAll") ? Localizer["Reply"].Value : Localizer["New message"].Value;
}
<style>
    .cbrecip-box { min-height: 40px; align-content: center; }
    .cbrecip-input { outline: 0; border: 0; background: transparent; min-width: 140px; padding: 6px 2px; }
    .cbrecip-chip { font-size: .85rem; }
    .cbrecip-menu { position: absolute; top: 100%; inset-inline-start: 0; z-index: 1050; background: #fff; border: 1px solid #e1e3ea; border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.12); width: 360px; max-width: 100%; max-height: 320px; overflow: auto; margin-top: 4px; }
    .cbrecip-item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; cursor: pointer; }
    .cbrecip-item:hover, .cbrecip-item.active { background: #f4f6fa; }
    .cbrecip-av img, .cbrecip-av .cbrecip-ini { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; display: flex; align-items: center; justify-content: center; background: var(--bs-light-primary, #E7F0FF); color: var(--bs-primary, #0E4A9E); font-weight: 700; }
    .cbrecip-meta { display: flex; flex-direction: column; min-width: 0; }
    .cbrecip-name { font-weight: 600; color: #181c32; font-size: .9rem; }
    .cbrecip-email { font-size: .78rem; color: #7e8299; }
</style>
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Email"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Comm")" class="text-muted">@Localizer["Email"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@title</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="d-flex flex-column flex-lg-row">
            <!--begin::Sidebar-->
            <div class="flex-column flex-lg-row-auto w-100 w-lg-275px mb-6 mb-lg-0">
                <div class="card card-flush mb-0"><div class="card-body">
                    <a href="@Url.Action("Compose","Comm")" class="btn btn-primary fw-bold w-100 mb-8">@Localizer["New Message"]</a>
                    <div class="menu menu-column menu-rounded menu-state-bg menu-state-title-primary menu-state-icon-primary">
                        <div class="menu-item mb-2"><a href="@Url.Action("Index","Comm", new { folder = "All" })" class="menu-link"><span class="menu-icon"><i class="ki-outline ki-sms fs-2 me-3"></i></span><span class="menu-title fw-bold">@Localizer["All"]</span><span class="badge badge-light-primary">@cAll</span></a></div>
                        <div class="menu-item mb-2"><a href="@Url.Action("Index","Comm", new { folder = "Outbox" })" class="menu-link"><span class="menu-icon"><i class="ki-outline ki-time fs-2 me-3"></i></span><span class="menu-title fw-bold">@Localizer["Outbox"]</span>@if (cOut > 0){<span class="badge badge-light-warning">@cOut</span>}</a></div>
                        <div class="menu-item mb-2"><a href="@Url.Action("Index","Comm", new { folder = "Sent" })" class="menu-link"><span class="menu-icon"><i class="ki-outline ki-send fs-2 me-3"></i></span><span class="menu-title fw-bold">@Localizer["Sent"]</span>@if (cSent > 0){<span class="badge badge-light-success">@cSent</span>}</a></div>
                        <div class="menu-item"><a href="@Url.Action("Index","Comm", new { folder = "Failed" })" class="menu-link"><span class="menu-icon"><i class="ki-outline ki-cross-circle fs-2 me-3"></i></span><span class="menu-title fw-bold">@Localizer["Failed"]</span>@if (cFail > 0){<span class="badge badge-light-danger">@cFail</span>}</a></div>
                    </div>
                </div></div>
            </div>
            <!--end::Sidebar-->
            <!--begin::Compose-->
            <div class="flex-lg-row-fluid ms-lg-7 ms-xl-10">
                @if (TempData["MailError"] as string == "recipient_subject_required")
                {
                    <div class="alert alert-danger d-flex align-items-center py-3 mb-5"><i class="ki-outline ki-information-5 fs-2 text-danger me-3"></i><div class="fs-7">@Localizer["Recipient and subject are required"]</div></div>
                }
                <form method="post" enctype="multipart/form-data" asp-action="Send" asp-controller="Comm" id="cbComposeForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="kind" value="@kind" />
                    <input type="hidden" name="parentId" value="@(ViewBag.ParentId?.ToString() ?? "")" />
                    <div class="card">
                        <div class="card-header align-items-center py-4">
                            <h2 class="fw-bold fs-4 m-0">@title</h2>
                            <div class="card-toolbar gap-2">
                                <a href="@Url.Action("Index","Comm")" class="btn btn-sm btn-light">@Localizer["Discard"]</a>
                                <button type="submit" class="btn btn-sm btn-primary"><i class="ki-outline ki-send fs-4"></i>@Localizer["Send"]</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-start border-bottom px-2 py-2">
                                <span class="text-muted w-75px fw-semibold pt-2">@SR["To"]</span>
                                <div class="cbrecip flex-grow-1 position-relative" data-init="@emTo">
                                    <div class="cbrecip-box d-flex flex-wrap align-items-center gap-1"><input type="text" class="cbrecip-input flex-grow-1" placeholder="name@@example.com" autocomplete="off" /></div>
                                    <div class="cbrecip-menu d-none"></div>
                                    <input type="hidden" name="to" value="@emTo" />
                                </div>
                            </div>
                            <div class="d-flex align-items-start border-bottom px-2 py-2">
                                <span class="text-muted w-75px fw-semibold pt-2">@SR["Cc"]</span>
                                <div class="cbrecip flex-grow-1 position-relative" data-init="@emCc">
                                    <div class="cbrecip-box d-flex flex-wrap align-items-center gap-1"><input type="text" class="cbrecip-input flex-grow-1" placeholder="a@@x.com, b@@y.com" autocomplete="off" /></div>
                                    <div class="cbrecip-menu d-none"></div>
                                    <input type="hidden" name="cc" value="@emCc" />
                                </div>
                            </div>
                            <div class="d-flex align-items-center border-bottom px-2 py-3">
                                <span class="text-muted w-75px fw-semibold">@SR["Subject"]</span>
                                <input name="subject" value="@emSubject" type="text" required class="form-control form-control-transparent border-0" />
                            </div>
                            <textarea name="body" id="cbBody">@emBody</textarea>
                            @if (inherited.Any())
                            {
                                <div class="px-2 pb-2"><div class="fs-8 text-muted mb-2">@SR["Forwarded attachments"]</div>
                                    @foreach (var a in inherited) { <span class="badge badge-light d-inline-flex align-items-center gap-1 py-2 me-2"><i class="ki-outline ki-paper-clip fs-6"></i>@a.FileName</span> }
                                </div>
                            }
                            <div class="d-flex align-items-center flex-wrap gap-2 border-top px-2 pt-4">
                                <label class="btn btn-sm btn-light-primary mb-0"><i class="ki-outline ki-paper-clip fs-5"></i>@SR["Attach files"]<input type="file" name="files" id="cbFiles" class="d-none" multiple /></label>
                                <button type="button" class="btn btn-sm btn-light-primary" id="cbLibBtn"><i class="ki-outline ki-folder fs-5"></i>@SR["Attach from library"]</button>
                                <input type="hidden" name="libraryFileIds" id="cbLibIds" value="" />
                                <div id="cbFileList" class="d-flex flex-wrap gap-2"></div>
                                <div id="cbLibList" class="d-flex flex-wrap gap-2"></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <!--end::Compose-->
        </div>
    </div></div>

    <!--begin::Modal - Attach from library-->
    <div class="modal fade" id="cbLibModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered mw-700px">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="fw-bold">@SR["Attach from library"]</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div>
                </div>
                <div class="modal-body py-6 px-lg-10">
                    <div class="badge badge-lg badge-light-primary mb-4"><div class="d-flex align-items-center flex-wrap" id="cbLibPath"></div></div>
                    <div class="table-responsive">
                        <table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                            <tbody id="cbLibRows"></tbody>
                        </table>
                    </div>
                    <div id="cbLibEmpty" class="text-center text-muted py-8 d-none">@SR["This folder is empty"]</div>
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@SR["Cancel"]</button>
                    <button type="button" class="btn btn-light-primary me-3" id="cbLibAttach"><i class="ki-outline ki-paper-clip fs-5"></i>@SR["Attach a copy"]</button>
                    <button type="button" class="btn btn-primary" id="cbLibLink"><i class="ki-outline ki-link fs-5"></i>@SR["Insert link"]</button>
                </div>
            </div>
        </div>
    </div>
    <!--end::Modal - Attach from library-->
</div>

@section Scripts {
<script src="@Url.Content("~/Backend-assets/plugins/custom/tinymce/tinymce.bundle.js")"></script>
<script>
    // Word-like rich text editor (TinyMCE 5, loaded LOCALLY — offline-safe). Font family/size/color + full formatting. Syncs to the textarea on submit.
    tinymce.init({
        selector: '#cbBody',
        height: 380,
        menubar: false,
        statusbar: false,
        branding: false,
        directionality: '@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr")',
        plugins: 'lists link table code autolink',
        toolbar: 'undo redo | formatselect fontselect fontsizeselect | bold italic underline strikethrough forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link table | removeformat code',
        content_style: 'body{font-family:Inter,Helvetica,Arial,sans-serif;font-size:14px;color:#181c32}'
    });
    (function () {
        var input = document.getElementById('cbFiles'), list = document.getElementById('cbFileList');
        function human(n) { return n < 1024 ? n + ' B' : n < 1048576 ? (n / 1024).toFixed(0) + ' KB' : (n / 1048576).toFixed(1) + ' MB'; }
        input.addEventListener('change', function () {
            list.innerHTML = Array.prototype.map.call(input.files, function (f) {
                var d = document.createElement('div'); d.textContent = f.name;
                return '<span class="badge badge-light-primary d-inline-flex align-items-center gap-1 py-2"><i class="ki-outline ki-file fs-6"></i>' + d.innerHTML + ' <span class="text-muted">(' + human(f.size) + ')</span></span>';
            }).join('');
        });
    })();

    // ---------- Attach from library: browse the company document library + pick files (no re-upload) ----------
    (function () {
        var modalEl = document.getElementById('cbLibModal'); if (!modalEl) return;
        var modal = new bootstrap.Modal(modalEl);
        var rows = document.getElementById('cbLibRows'), pathEl = document.getElementById('cbLibPath'), emptyEl = document.getElementById('cbLibEmpty');
        var hidden = document.getElementById('cbLibIds'), chips = document.getElementById('cbLibList');
        var selected = {};                    // id -> name (persists while navigating folders)
        var rootName = '@SR["Library"]';
        function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }

        document.getElementById('cbLibBtn').addEventListener('click', function () { load(null); modal.show(); });

        function load(folderId) {
            fetch('/FileManager/List' + (folderId != null ? '?folderId=' + folderId : ''), { credentials: 'same-origin' })
                .then(function (r) { return r.json(); }).then(function (d) {
                    var ph = '<i class="ki-outline ki-abstract-32 fs-3 me-1"></i><a class="cursor-pointer cb-crumb" data-fid="">' + esc(rootName) + '</a>';
                    (d.path || []).forEach(function (c) { ph += '<i class="ki-outline ki-right fs-4 mx-1"></i><a class="cursor-pointer cb-crumb" data-fid="' + c.id + '">' + esc(c.name) + '</a>'; });
                    pathEl.innerHTML = ph;
                    pathEl.querySelectorAll('.cb-crumb').forEach(function (a) { a.addEventListener('click', function () { var f = a.getAttribute('data-fid'); load(f ? parseInt(f) : null); }); });
                    rows.innerHTML = (d.items || []).map(function (it) {
                        if (it.isFolder)
                            return '<tr><td style="width:28px"></td><td><a class="cursor-pointer text-gray-800 text-hover-primary fw-semibold cb-nav" data-fid="' + it.id + '"><i class="ki-outline ki-folder fs-2 text-primary me-2"></i>' + esc(it.name) + '</a></td><td class="text-muted text-end">' + esc(it.sizeText || '') + '</td></tr>';
                        var ck = selected[it.id] ? 'checked' : '';
                        return '<tr><td style="width:28px"><input type="checkbox" class="form-check-input cb-pick" data-id="' + it.id + '" data-name="' + esc(it.name) + '" data-url="' + esc(it.url || '') + '" data-size="' + esc(it.sizeText || '') + '" ' + ck + ' /></td><td><i class="ki-outline ki-document fs-2 text-primary me-2"></i>' + esc(it.name) + '</td><td class="text-muted text-end">' + esc(it.sizeText || '') + '</td></tr>';
                    }).join('');
                    emptyEl.classList.toggle('d-none', (d.items || []).length > 0);
                    rows.querySelectorAll('.cb-nav').forEach(function (a) { a.addEventListener('click', function () { load(parseInt(a.getAttribute('data-fid'))); }); });
                    rows.querySelectorAll('.cb-pick').forEach(function (c) { c.addEventListener('change', function () { var id = c.getAttribute('data-id'); if (c.checked) selected[id] = { name: c.getAttribute('data-name'), url: c.getAttribute('data-url'), size: c.getAttribute('data-size') }; else delete selected[id]; }); });
                }).catch(function () { });
        }

        // "Attach a copy" → chips + hidden ids (server attaches the actual file bytes, no re-upload)
        document.getElementById('cbLibAttach').addEventListener('click', function () { renderChips(); modal.hide(); });

        function renderChips() {
            hidden.value = Object.keys(selected).join(',');
            chips.innerHTML = Object.keys(selected).map(function (id) {
                return '<span class="badge badge-light-success d-inline-flex align-items-center gap-1 py-2" data-id="' + id + '"><i class="ki-outline ki-paper-clip fs-6"></i>' + esc(selected[id].name) + ' <i class="ki-outline ki-cross fs-7 cursor-pointer cb-rm"></i></span>';
            }).join('');
            chips.querySelectorAll('.cb-rm').forEach(function (x) { x.addEventListener('click', function () { var id = x.closest('[data-id]').getAttribute('data-id'); delete selected[id]; renderChips(); }); });
        }

        // "Insert link" → cloud-attachment style: drop a document link card into the email body (like real M365/SharePoint)
        document.getElementById('cbLibLink').addEventListener('click', function () {
            var ids = Object.keys(selected); if (!ids.length) { modal.hide(); return; }
            var html = ids.map(function (id) {
                var it = selected[id]; if (!it.url) return '';
                var abs = window.location.origin + it.url;
                return '<a href="' + abs + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;border:1px solid #e1e3ea;border-radius:8px;padding:10px 14px;text-decoration:none;color:#181c32;margin:6px 0;background:#f9f9f9;max-width:100%">' +
                       '<span style="font-size:22px">📄</span>' +
                       '<span style="line-height:1.3"><strong>' + esc(it.name) + '</strong><br><span style="color:#7e8299;font-size:12px">' + esc(it.size || '') + ' · @SR["From the library"]</span></span></a>';
            }).join('<br>');
            try {
                if (window.tinymce && tinymce.get('cbBody')) { tinymce.get('cbBody').insertContent('<p>' + html + '</p>'); }
                else { var ta = document.getElementById('cbBody'); ta.value += '\n' + html; }
            } catch (e) { }
            selected = {}; modal.hide();
        });
    })();

    // ---------- recipient picker (To/Cc): company contacts autocomplete w/ photos + multi-select chips ----------
    (function () {
        function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
        function initRecip(root) {
            var box = root.querySelector('.cbrecip-box'), input = root.querySelector('.cbrecip-input'),
                menu = root.querySelector('.cbrecip-menu'), hidden = root.querySelector('input[type=hidden]');
            var chips = [];
            function sync() { hidden.value = chips.join(', '); }
            function render() {
                box.querySelectorAll('.cbrecip-chip').forEach(function (c) { c.remove(); });
                chips.forEach(function (em, i) {
                    var chip = document.createElement('span');
                    chip.className = 'cbrecip-chip badge badge-light-primary d-inline-flex align-items-center gap-1 py-2';
                    chip.innerHTML = esc(em) + ' <i class="ki-outline ki-cross fs-7 cursor-pointer"></i>';
                    chip.querySelector('i').addEventListener('click', function () { chips.splice(i, 1); render(); });
                    box.insertBefore(chip, input);
                });
                sync();
            }
            function add(em) { em = (em || '').trim().replace(/[,;]+$/, ''); if (!em) return; if (chips.indexOf(em) === -1) { chips.push(em); render(); } input.value = ''; hideMenu(); }
            function hideMenu() { menu.classList.add('d-none'); menu.innerHTML = ''; }
            function showMenu(items) {
                if (!items || !items.length) { hideMenu(); return; }
                menu.innerHTML = items.map(function (c, i) {
                    var av = c.photo ? '<img src="' + esc(c.photo) + '" alt="" />' : '<span class="cbrecip-ini">' + esc((c.name || c.email || '?').substring(0, 1).toUpperCase()) + '</span>';
                    return '<div class="cbrecip-item' + (i === 0 ? ' active' : '') + '" data-email="' + esc(c.email) + '"><span class="cbrecip-av">' + av + '</span><span class="cbrecip-meta"><span class="cbrecip-name">' + esc(c.name) + '</span><span class="cbrecip-email">' + esc(c.email) + '</span></span></div>';
                }).join('');
                menu.querySelectorAll('.cbrecip-item').forEach(function (el) { el.addEventListener('mousedown', function (e) { e.preventDefault(); add(el.getAttribute('data-email')); input.focus(); }); });
                menu.classList.remove('d-none');
            }
            var timer;
            input.addEventListener('input', function () {
                var q = input.value.trim(); clearTimeout(timer);
                if (q.length < 1) { hideMenu(); return; }
                timer = setTimeout(function () {
                    fetch('@Url.Action("Contacts","Comm")' + '?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
                        .then(function (r) { return r.ok ? r.json() : []; }).then(showMenu).catch(function () {});
                }, 180);
            });
            input.addEventListener('keydown', function (e) {
                var first = menu.querySelector('.cbrecip-item.active') || menu.querySelector('.cbrecip-item');
                if (e.key === 'Enter') { e.preventDefault(); if (first && !menu.classList.contains('d-none')) add(first.getAttribute('data-email')); else if (input.value.trim()) add(input.value); return; }
                if (e.key === ',' || e.key === ';') { if (input.value.trim()) { e.preventDefault(); add(input.value); } return; }
                if (e.key === 'Backspace' && !input.value && chips.length) { chips.pop(); render(); }
                if (e.key === 'Escape') hideMenu();
                if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && !menu.classList.contains('d-none')) {
                    e.preventDefault(); var items = [].slice.call(menu.querySelectorAll('.cbrecip-item')); var idx = items.findIndex(function (x) { return x.classList.contains('active'); });
                    if (idx < 0) idx = 0; items[idx].classList.remove('active'); idx = e.key === 'ArrowDown' ? (idx + 1) % items.length : (idx - 1 + items.length) % items.length; items[idx].classList.add('active'); items[idx].scrollIntoView({ block: 'nearest' });
                }
            });
            input.addEventListener('blur', function () { setTimeout(function () { if (input.value.trim()) add(input.value); hideMenu(); }, 150); });
            box.addEventListener('click', function () { input.focus(); });
            var f = root.closest('form'); if (f) f.addEventListener('submit', function () { if (input.value.trim()) add(input.value); });
            (root.getAttribute('data-init') || '').split(/[,;]+/).forEach(function (em) { em = em.trim(); if (em) chips.push(em); });
            render();
        }
        document.querySelectorAll('.cbrecip').forEach(initRecip);
        // require at least one recipient in To
        var form = document.getElementById('cbComposeForm');
        if (form) form.addEventListener('submit', function (e) {
            var to = document.querySelector('input[name="to"]');
            if (to && !to.value.trim()) { e.preventDefault(); if (window.toastr) toastr.error('@Localizer["Recipient and subject are required"]'); }
        });
    })();
</script>
}
