@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    @* GLOBAL UI RULE: Inventory is the only visual authority. Inventory shell, Inventory cards. *@
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var dir = isAr ? "rtl" : "ltr";
}
<link href="@Url.Content("~/Backend-assets/plugins/custom/fullcalendar/fullcalendar.bundle.css")" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="~/Backend-assets/css/crossbuy-brand.css" asp-append-version="true" />
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Calendar"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@Localizer["Home"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Calendar"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header align-items-center py-4">
                <div class="card-title"><h3 class="fw-bold text-gray-900 fs-4 m-0">@Localizer["Calendar"]</h3></div>
                <div class="card-toolbar">
                    <button class="btn btn-flex btn-primary" data-kt-calendar="add"><i class="ki-outline ki-plus fs-2"></i>@Localizer["Add Event"]</button>
                </div>
            </div>
            <div class="card-body">
                @* COLOUR KEY. Same form as the one on /Pos/Reservations. The colour tells a reader
                   WHO SEES an event, which is information rather than decoration, and until now it
                   was explained only in a code comment and in a badge you had to open an event to
                   find. Swatches point at the same tokens the chips use. *@
                <div class="d-flex gap-4 mb-4 fs-8 text-muted flex-wrap align-items-center">
                    <span><span class="d-inline-block rounded-circle align-middle me-1" style="width:11px;height:11px;background:var(--cb-violet-strong);"></span> @Localizer["Company"]</span>
                    <span><span class="d-inline-block rounded-circle align-middle me-1" style="width:11px;height:11px;background:var(--cb-brand-fill);"></span> @Localizer["Personal"]</span>
                </div>
                <div id="kt_calendar_app"></div>
            </div>
        </div>

        @Html.AntiForgeryToken()

        <!--begin::Modal - Add/Edit Event-->
        <div class="modal fade" id="kt_modal_add_event" tabindex="-1" aria-hidden="true" data-bs-focus="false">
            <div class="modal-dialog modal-dialog-centered mw-650px">
                <div class="modal-content">
                    <form class="form" id="kt_modal_add_event_form">
                        <input type="hidden" name="id" value="" />
                        <div class="modal-header">
                            <h2 class="fw-bold" data-kt-calendar="title">@Localizer["Add Event"]</h2>
                            <div class="btn btn-icon btn-sm btn-active-icon-primary" id="kt_modal_add_event_close"><i class="ki-outline ki-cross fs-1"></i></div>
                        </div>
                        <div class="modal-body py-10 px-lg-17">
                            @* TWO NAMES. CalendarEvents.TitleEn is new; without a field for it every event
                               would keep exactly one title and the unified agenda would go on showing Arabic
                               event names in an English UI. Optional - no twin means the stored name is used
                               in both languages, the same fallback tasks and templates use. *@
                            <div class="row row-cols-lg-2 g-9">
                                <div class="col">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold required mb-2">@Localizer["Event Name"]</label>
                                        <input type="text" class="form-control form-control-solid" name="title" required />
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2">@Localizer["Event Name"] (EN)</label>
                                        <input type="text" dir="ltr" class="form-control form-control-solid" name="titleEn" />
                                    </div>
                                </div>
                            </div>
                            <div class="row row-cols-lg-2 g-9">
                                <div class="col">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2">@Localizer["Event Description"] (AR)</label>
                                        <input type="text" dir="rtl" class="form-control form-control-solid" name="description" />
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2">@Localizer["Event Description"] (EN)</label>
                                        <input type="text" dir="ltr" class="form-control form-control-solid" name="descriptionEn" />
                                    </div>
                                </div>
                            </div>
                            <div class="row row-cols-lg-2 g-9">
                                <div class="col">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2">@Localizer["Event Location"] (AR)</label>
                                        <input type="text" dir="rtl" class="form-control form-control-solid" name="location" />
                                        <label class="fs-6 fw-semibold mb-2 mt-3">@Localizer["Event Location"] (EN)</label>
                                        <input type="text" dir="ltr" class="form-control form-control-solid" name="locationEn" />
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2">@Localizer["Visibility"]</label>
                                        <select class="form-select form-select-solid" name="scope">
                                            <option value="Personal">@Localizer["Personal (only me)"]</option>
                                            <option value="Company">@Localizer["Company (everyone sees)"]</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="fv-row mb-9">
                                <label class="fs-6 fw-semibold mb-2">@Localizer["Invite attendees"]</label>
                                <div class="cbrecip position-relative">
                                    <div class="cbrecip-box form-control form-control-solid d-flex flex-wrap align-items-center gap-1"><input type="text" class="cbrecip-input" placeholder="@Localizer["Type a colleague's name…"]" autocomplete="off" /></div>
                                    <div class="cbrecip-menu d-none"></div>
                                    <input type="hidden" name="attendees" value="" />
                                </div>
                            </div>
                            <div class="fv-row mb-9">
                                <label class="form-check form-check-custom form-check-solid">
                                    <input class="form-check-input" type="checkbox" id="cbAllDay" name="allDay" value="true" />
                                    <span class="form-check-label fw-semibold">@Localizer["All Day"]</span>
                                </label>
                            </div>
                            <div class="row row-cols-lg-2 g-9">
                                <div class="col">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2 required">@Localizer["Event Start Date"]</label>
                                        <input class="form-control form-control-solid" id="cbStartDate" placeholder="@Localizer["Pick a start date"]" />
                                    </div>
                                </div>
                                <div class="col" data-kt-calendar="datepicker">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2">@Localizer["Event Start Time"]</label>
                                        <input class="form-control form-control-solid" id="cbStartTime" placeholder="@Localizer["Pick a start time"]" />
                                    </div>
                                </div>
                            </div>
                            <div class="row row-cols-lg-2 g-9">
                                <div class="col">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2 required">@Localizer["Event End Date"]</label>
                                        <input class="form-control form-control-solid" id="cbEndDate" placeholder="@Localizer["Pick an end date"]" />
                                    </div>
                                </div>
                                <div class="col" data-kt-calendar="datepicker">
                                    <div class="fv-row mb-9">
                                        <label class="fs-6 fw-semibold mb-2">@Localizer["Event End Time"]</label>
                                        <input class="form-control form-control-solid" id="cbEndTime" placeholder="@Localizer["Pick an end time"]" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer flex-center">
                            <button type="reset" id="kt_modal_add_event_cancel" class="btn btn-light me-3">@Localizer["Cancel"]</button>
                            <button type="submit" id="kt_modal_add_event_submit" class="btn btn-primary"><span class="indicator-label">@Localizer["Submit"]</span></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!--end::Modal - Add/Edit Event-->

        <!--begin::Modal - View Event-->
        <div class="modal fade" id="kt_modal_view_event" tabindex="-1" data-bs-focus="false" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered mw-650px">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="fw-bold" data-kt-calendar="event_name"></h2>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn btn-icon btn-sm btn-color-gray-500 btn-active-icon-primary d-none" title="@Localizer["Edit Event"]" id="kt_modal_view_event_edit"><i class="ki-outline ki-pencil fs-2"></i></div>
                            <div class="btn btn-icon btn-sm btn-color-gray-500 btn-active-icon-danger d-none" title="@Localizer["Delete Event"]" id="kt_modal_view_event_delete"><i class="ki-outline ki-trash fs-2"></i></div>
                            <div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div>
                        </div>
                    </div>
                    <div class="modal-body py-10 px-lg-17">
                        <div class="d-flex mb-9">
                            <i class="ki-outline ki-calendar-8 fs-1 text-muted me-5"></i>
                            <div>
                                <div class="mb-2"><span class="badge" data-kt-calendar="scope"></span></div>
                                <div class="fs-6" data-kt-calendar="event_description"></div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-2"><span class="bullet bullet-dot h-10px w-10px bg-primary ms-2 me-7"></span><div class="fs-6"><span class="fw-bold">@Localizer["Starts"]</span> <span data-kt-calendar="event_start_date"></span></div></div>
                        <div class="d-flex align-items-center mb-9"><span class="bullet bullet-dot h-10px w-10px bg-secondary ms-2 me-7"></span><div class="fs-6"><span class="fw-bold">@Localizer["Ends"]</span> <span data-kt-calendar="event_end_date"></span></div></div>
                        <div class="d-flex align-items-center mb-4"><i class="ki-outline ki-geolocation fs-1 text-muted me-5"></i><div class="fs-6" data-kt-calendar="event_location"></div></div>
                        <div class="d-flex align-items-center mb-4"><i class="ki-outline ki-profile-circle fs-1 text-muted me-5"></i><div class="fs-6"><span class="fw-bold">@Localizer["Owner"]:</span> <span data-kt-calendar="event_owner"></span></div></div>
                        <div class="d-flex align-items-start"><i class="ki-outline ki-people fs-1 text-muted me-5"></i><div class="fs-6" data-kt-calendar="event_attendees"></div></div>
                    </div>
                </div>
            </div>
        </div>
        <!--end::Modal - View Event-->
    </div></div>
</div>

@section Scripts {
<script src="@Url.Content("~/Backend-assets/plugins/custom/fullcalendar/fullcalendar.bundle.js")"></script>
<script>
(function () {
    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    var calEl = document.getElementById('kt_calendar_app');
    var addModalEl = document.getElementById('kt_modal_add_event');
    var viewModalEl = document.getElementById('kt_modal_view_event');
    var addModal = new bootstrap.Modal(addModalEl);
    var viewModal = new bootstrap.Modal(viewModalEl);
    var form = document.getElementById('kt_modal_add_event_form');
    var currentEvent = null;   // for the view modal

    function esc(s){ var d=document.createElement('div'); d.textContent=(s==null?'':s); return d.innerHTML; }
    function pad(n){ return (n<10?'0':'')+n; }
    function toLocalInput(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes()); }
    function fmt(iso){ if(!iso) return '—'; var d=new Date(iso); return d.toLocaleString('@(isAr ? "ar-EG" : "en-GB")', {dateStyle:'medium', timeStyle:'short'}); }

    // ---------- attendees picker (chips + company autocomplete) ----------
    (function initRecip(){
        var root = document.querySelector('.cbrecip'), box = root.querySelector('.cbrecip-box'),
            input = root.querySelector('.cbrecip-input'), menu = root.querySelector('.cbrecip-menu'),
            hidden = root.querySelector('input[type=hidden]');
        var chips = [];  // {id, name}
        window.__cbSetAttendees = function(list){ chips = (list||[]).slice(); render(); };
        function sync(){ hidden.value = chips.map(function(c){return c.id;}).join(','); }
        function render(){
            box.querySelectorAll('.cbrecip-chip').forEach(function(c){c.remove();});
            chips.forEach(function(c,i){
                var chip=document.createElement('span');
                chip.className='cbrecip-chip badge badge-light-primary d-inline-flex align-items-center gap-1 py-2';
                chip.innerHTML=esc(c.name)+' <i class="ki-outline ki-cross fs-7 cursor-pointer"></i>';
                chip.querySelector('i').addEventListener('click', function(){ chips.splice(i,1); render(); });
                box.insertBefore(chip, input);
            });
            sync();
        }
        function add(c){ if(!c||!c.id) return; if(!chips.some(function(x){return x.id===c.id;})) chips.push(c); render(); input.value=''; hide(); }
        function hide(){ menu.classList.add('d-none'); menu.innerHTML=''; }
        function show(items){
            if(!items||!items.length){ hide(); return; }
            menu.innerHTML = items.map(function(c,i){
                var av = c.photo ? '<img src="'+esc(c.photo)+'" alt="" />' : '<span class="cbrecip-ini">'+esc((c.name||'?').substring(0,1).toUpperCase())+'</span>';
                return '<div class="cbrecip-item'+(i===0?' active':'')+'" data-id="'+c.id+'" data-name="'+esc(c.name)+'"><span class="cbrecip-av">'+av+'</span><span class="cbrecip-meta"><span class="cbrecip-name">'+esc(c.name)+'</span><span class="cbrecip-email">'+esc(c.email)+'</span></span></div>';
            }).join('');
            menu.querySelectorAll('.cbrecip-item').forEach(function(el){ el.addEventListener('mousedown', function(e){ e.preventDefault(); add({id:parseInt(el.getAttribute('data-id')), name:el.getAttribute('data-name')}); input.focus(); }); });
            menu.classList.remove('d-none');
        }
        var timer;
        input.addEventListener('input', function(){ var q=input.value.trim(); clearTimeout(timer); if(q.length<1){ hide(); return; }
            timer=setTimeout(function(){ fetch('@Url.Action("Attendees","Calendar")'+'?q='+encodeURIComponent(q), {credentials:'same-origin'}).then(function(r){return r.ok?r.json():[];}).then(show).catch(function(){}); }, 180); });
        input.addEventListener('keydown', function(e){ if(e.key==='Enter'){ var f=menu.querySelector('.cbrecip-item.active')||menu.querySelector('.cbrecip-item'); if(f && !menu.classList.contains('d-none')){ e.preventDefault(); add({id:parseInt(f.getAttribute('data-id')), name:f.getAttribute('data-name')}); } }
            if(e.key==='Backspace' && !input.value && chips.length){ chips.pop(); render(); } if(e.key==='Escape') hide(); });
        input.addEventListener('blur', function(){ setTimeout(hide, 150); });
        box.addEventListener('click', function(){ input.focus(); });
    })();

    // ---------- add/edit modal (Metronic flatpickr: separate date + time fields) ----------
    var fpSD = flatpickr('#cbStartDate', { dateFormat: 'd M Y' });
    var fpST = flatpickr('#cbStartTime', { enableTime: true, noCalendar: true, dateFormat: 'h:i K' });
    var fpED = flatpickr('#cbEndDate', { dateFormat: 'd M Y' });
    var fpET = flatpickr('#cbEndTime', { enableTime: true, noCalendar: true, dateFormat: 'h:i K' });
    function toggleTimeCols(hide){ addModalEl.querySelectorAll('[data-kt-calendar="datepicker"]').forEach(function(el){ el.classList.toggle('d-none', hide); }); }
    function combine(dPick, tPick, allDay){
        var d = dPick.selectedDates[0]; if(!d) return null;
        var t = allDay ? null : tPick.selectedDates[0];
        return new Date(d.getFullYear(), d.getMonth(), d.getDate(), t ? t.getHours() : 0, t ? t.getMinutes() : 0, 0);
    }
    function localStr(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes())+':00'; }
    document.getElementById('cbAllDay').addEventListener('change', function(){ toggleTimeCols(this.checked); });
    function openAdd(startDate, endDate){
        form.querySelector('[name=id]').value=''; form.querySelector('[name=title]').value=''; form.querySelector('[name=titleEn]').value=''; form.querySelector('[name=description]').value='';
        form.querySelector('[name=location]').value=''; form.querySelector('[name=scope]').value='Personal'; window.__cbSetAttendees([]);
        document.getElementById('cbAllDay').checked=false; toggleTimeCols(false);
        addModalEl.querySelector('[data-kt-calendar="title"]').textContent='@Localizer["Add Event"]';
        var s = startDate || new Date(); var e = endDate || new Date(s.getTime()+60*60*1000);
        fpSD.setDate(s); fpST.setDate(s); fpED.setDate(e); fpET.setDate(e);
        addModal.show();
    }
    function openEdit(ev){
        addModalEl.querySelector('[data-kt-calendar="title"]').textContent='@Localizer["Edit Event"]';
        form.querySelector('[name=id]').value = ev.id;
        // THE STORED TITLE, not the displayed one. ev.title is resolved for the current culture, so an
        // English UI would prefill the English twin into the primary name box and the next save would
        // overwrite the Arabic title with it.
        form.querySelector('[name=title]').value = (ev.extendedProps && ev.extendedProps.titleAr) || ev.title || '';
        form.querySelector('[name=titleEn]').value = (ev.extendedProps && ev.extendedProps.titleEn) || '';
        form.querySelector('[name=description]').value = ev.extendedProps.description || '';
        form.querySelector('[name=location]').value = ev.extendedProps.location || '';
        form.querySelector('[name=scope]').value = ev.extendedProps.scope || 'Personal';
        var all = ev.allDay; document.getElementById('cbAllDay').checked = all; toggleTimeCols(all);
        var s = ev.start || new Date(); var e = ev.end || new Date(s.getTime()+60*60*1000);
        fpSD.setDate(s); fpST.setDate(s); fpED.setDate(e); fpET.setDate(e);
        var ids = ev.extendedProps.attendeeIds||[], names = ev.extendedProps.attendees||[];
        window.__cbSetAttendees(ids.map(function(id,i){ return {id:id, name:names[i]||('#'+id)}; }));
        viewModal.hide(); addModal.show();
    }
    document.getElementById('kt_modal_add_event_close').addEventListener('click', function(){ addModal.hide(); });
    document.getElementById('kt_modal_add_event_cancel').addEventListener('click', function(){ addModal.hide(); });

    form.addEventListener('submit', function(e){
        e.preventDefault();
        if(!form.querySelector('[name=title]').value.trim()){ if(window.toastr) toastr.error('@Localizer["Event name is required"]'); return; }
        var allDay = document.getElementById('cbAllDay').checked;
        var sd = combine(fpSD, fpST, allDay), ed = combine(fpED, fpET, allDay);
        if(!sd){ if(window.toastr) toastr.error('@Localizer["Pick a start date"]'); return; }
        var fd = new FormData(form);
        fd.set('allDay', allDay ? 'true' : 'false');
        fd.set('start', localStr(sd));
        fd.set('end', ed ? localStr(ed) : '');
        fd.append('__RequestVerificationToken', token);
        var btn = document.getElementById('kt_modal_add_event_submit'); btn.disabled=true;
        fetch('@Url.Action("Save","Calendar")', {method:'POST', credentials:'same-origin', body:fd})
            .then(function(r){return r.json();}).then(function(res){ btn.disabled=false;
                if(res && res.ok){ addModal.hide(); calendar.refetchEvents(); if(window.toastr){ toastr.success('@Localizer["Saved"]'); if(res.invited > 0) toastr.info('@Localizer["Invitations emailed to attendees"]'); } }
                else { if(window.toastr) toastr.error('@Localizer["Could not save"]'); } })
            .catch(function(){ btn.disabled=false; if(window.toastr) toastr.error('@Localizer["Could not save"]'); });
    });

    // ---------- view modal ----------
    function openView(ev){
        currentEvent = ev; var p = ev.extendedProps;
        var m = viewModalEl;
        m.querySelector('[data-kt-calendar="event_name"]').textContent = ev.title || '';
        var sc = m.querySelector('[data-kt-calendar="scope"]');
        sc.textContent = p.scope === 'Company' ? '@Localizer["Company"]' : '@Localizer["Personal"]';
        sc.className = 'badge ' + (p.scope === 'Company' ? 'badge-light-info' : 'badge-light-primary');
        m.querySelector('[data-kt-calendar="event_description"]').textContent = p.description || '';
        m.querySelector('[data-kt-calendar="event_start_date"]').textContent = fmt(ev.startStr);
        m.querySelector('[data-kt-calendar="event_end_date"]').textContent = fmt(ev.endStr);
        m.querySelector('[data-kt-calendar="event_location"]').textContent = p.location || '—';
        m.querySelector('[data-kt-calendar="event_owner"]').textContent = p.ownerName || '';
        m.querySelector('[data-kt-calendar="event_attendees"]').textContent = (p.attendees && p.attendees.length) ? p.attendees.join(', ') : '—';
        var edit = document.getElementById('kt_modal_view_event_edit'), del = document.getElementById('kt_modal_view_event_delete');
        edit.classList.toggle('d-none', !p.canEdit); del.classList.toggle('d-none', !p.canEdit);
        viewModal.show();
    }
    document.getElementById('kt_modal_view_event_edit').addEventListener('click', function(){ if(currentEvent) openEdit(currentEvent); });
    document.getElementById('kt_modal_view_event_delete').addEventListener('click', function(){
        if(!currentEvent) return;
        Swal.fire({
            text: '@Localizer["Delete this event?"]', icon: 'warning', showCancelButton: true, buttonsStyling: false,
            confirmButtonText: '@Localizer["Yes, delete"]', cancelButtonText: '@Localizer["Cancel"]',
            customClass: { confirmButton: 'btn btn-danger', cancelButton: 'btn btn-active-light' }
        }).then(function(res){
            if(!res.isConfirmed) return;
            var fd = new FormData(); fd.append('id', currentEvent.id); fd.append('__RequestVerificationToken', token);
            fetch('@Url.Action("Delete","Calendar")', {method:'POST', credentials:'same-origin', body:fd})
                .then(function(r){return r.json();}).then(function(res){ if(res && res.ok){ viewModal.hide(); calendar.refetchEvents(); if(window.toastr) toastr.success('@Localizer["Deleted"]'); } });
        });
    });

    // ---------- FullCalendar ----------
    // On phones let the grid flow (auto height, page scrolls); on desktop keep the fixed Metronic height.
    function calHeight(){ return window.innerWidth < 768 ? 'auto' : 750; }
    // Full weekday names overlap in a seven-column phone month grid. Keep the
    // complete accessible label while rendering locale-native narrow day names.
    // Desktop and the date-bearing week/day headers retain FullCalendar's text.
    function calDayHeader(arg) {
        var label = document.createElement('span');
        var compactMonth = window.innerWidth < 576 && arg.view.type === 'dayGridMonth';
        var locale = '@(isAr ? "ar" : "en")';
        var full = arg.view.type === 'dayGridMonth'
            ? new Intl.DateTimeFormat(locale, {weekday:'long', timeZone:'UTC'}).format(arg.date)
            : arg.text;
        label.textContent = compactMonth
            ? new Intl.DateTimeFormat(locale, {weekday:'narrow', timeZone:'UTC'}).format(arg.date)
            : arg.text;
        label.title = full;
        label.setAttribute('aria-label', full);
        return {domNodes:[label]};
    }
    // The deep-link parameters, read once. Both are optional and each is independent: a day with no
    // event id simply opens the calendar on that day.
    var qs = new URLSearchParams(location.search);
    var wantEventId = qs.get('eventId');
    var wantDay = qs.get('day');
    var openedDeepLink = false;

    var calendar = new FullCalendar.Calendar(calEl, {
        direction: '@dir',
        // Set before render so the linked event is inside the window that gets fetched.
        initialDate: (wantDay && /^\d{4}-\d{2}-\d{2}$/.test(wantDay)) ? wantDay : undefined,
        locale: '@(isAr ? "ar" : "en")',
        buttonText: {
            today: '@Localizer["today"]',
            month: '@Localizer["month"]',
            week: '@Localizer["week"]',
            day: '@Localizer["day"]',
            list: '@Localizer["list"]'
        },
        headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek' },
        initialView: 'dayGridMonth',
        dayHeaderContent: calDayHeader,
        height: calHeight(),
        selectable: true,
        navLinks: true,
        dayMaxEvents: true,
        // ACCESSIBILITY FIX FOR THE "+N more" LINK, applied through FullCalendar's OWN documented
        // mount hook rather than by patching the vendor bundle.
        //
        // v5.11.5 renders that link as <a class="fc-daygrid-more-link" aria-expanded="false"
        // aria-controls="" tabindex="0"> with NO href. An <a> without href exposes no implicit role,
        // and ARIA state is illegal on a roleless element - so axe reports aria-allowed-attr as a
        // CRITICAL ("ARIA attribute is not allowed: aria-expanded"). The attribute is not wrong in
        // spirit: the link really does expand a popover. What is missing is the role that makes it
        // legal to say so.
        //
        // role="button" is the accurate one - it opens a popover, it is keyboard-activated, and the
        // role permits aria-expanded. The empty aria-controls is also removed: an IDREF pointing at
        // nothing is worse than no attribute, because a screen reader announces a relationship that
        // does not resolve. FullCalendar sets it before the popover exists and never fills it in.
        //
        // moreLinkDidMount is a supported public option (present in this bundle), so no vendor file
        // is modified and an upgrade will not silently drop the fix - it would drop the hook loudly.
        moreLinkDidMount: function (arg) {
            arg.el.setAttribute('role', 'button');
            if (arg.el.getAttribute('aria-controls') === '') { arg.el.removeAttribute('aria-controls'); }
        },
        windowResize: function(){
            calendar.setOption('height', calHeight());
            calendar.setOption('dayHeaderContent', function(arg){ return calDayHeader(arg); });
        },
        events: function(info, success, failure){
            fetch('@Url.Action("Events","Calendar")'+'?from='+encodeURIComponent(info.startStr)+'&to='+encodeURIComponent(info.endStr), {credentials:'same-origin'})
                .then(function(r){return r.ok?r.json():[];})
                .then(function(list){ success(list.map(function(e){ return {
                    id:e.id, title:e.title, start:e.start, end:e.end, allDay:e.allDay, className:e.className,
                    extendedProps:{ scope:e.scope, description:e.description, location:e.location, ownerName:e.ownerName, attendees:e.attendees, attendeeIds:e.attendeeIds, canEdit:e.canEdit, titleAr:e.titleAr, titleEn:e.titleEn } }; })); })
                .catch(failure);
        },
        dateClick: function(info){ var s=new Date(info.dateStr); openAdd(s, new Date(s.getTime()+60*60*1000)); },
        select: function(info){ openAdd(info.start, info.end); },
        eventClick: function(info){ info.jsEvent.preventDefault(); openView(info.event); },
        // Fires once the fetched events are in the calendar, which is the earliest moment
        // getEventById can resolve. The flag makes it a one-shot: without it, every later month
        // navigation would reopen the modal.
        eventsSet: function(){
            if (openedDeepLink || !wantEventId) return;
            var ev = calendar.getEventById(wantEventId);
            if (!ev) return;
            openedDeepLink = true;
            openView(ev);
            // The parameters are consumed. Left in the address bar, a refresh or a back-navigation
            // reopens a modal the reader has already dismissed.
            history.replaceState({}, '', location.pathname);
        }
    });
    calendar.render();
    // Constructor buttonText has precedence over locale defaults in the bundled
    // FullCalendar version. Let its renderer own the text nodes across resizes.
    window.calendar = calendar;

    // ---------- real-time: refetch when an event is created/edited/deleted anywhere in the company ----------
    (function(){
        var pending = false;
        function refetch(){
            // debounce bursts of changes into a single refetch
            if (pending) return; pending = true;
            setTimeout(function(){ pending = false; try { calendar.refetchEvents(); } catch(e){} }, 300);
        }
        function connect(){
            if (!window.signalR) return;
            try {
                var conn = new signalR.HubConnectionBuilder().withUrl('/hubs/notifications').withAutomaticReconnect().build();
                conn.on('calendarChanged', refetch);
                conn.start().catch(function(){});
            } catch(e){}
        }
        if (window.signalR) { connect(); }
        else {
            var s = document.createElement('script');
            s.src = '@Url.Content("~/Backend-assets/plugins/signalr.min.js")';
            s.onload = connect; s.onerror = function(){};
            document.head.appendChild(s);
        }
    })();

    document.querySelectorAll('[data-kt-calendar="add"]').forEach(function(b){ b.addEventListener('click', function(){ openAdd(); }); });
})();
</script>
}
