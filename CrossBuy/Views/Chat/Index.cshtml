system", "Add a note (optional)", "Agenda (optional)", "An hour", "Anonymous — nobody sees who voted for what", "Approvals waiting for you", "Assign to", "Channels", "Choose a time at least a minute from now", "Choose a time in the future", "Choose at least one conversation", "Choose one", "Choose one or more", "Clear", "Clear after", "Close", "Close the poll", "Closes (optional)", "Commands", "Could not forward", "Could not pin it (at most 50)", "Create", "Create the task", "Decisions", "Description", "Do not disturb", "Do not disturb is off", "Do not disturb is on", "Do not disturb — no ringing, no desktop notices", "Done", "Due", "Each opens on its own screen, where it is decided with that module’s rules", "Edit the group", "Every member of the group gets it in their calendar, with the way back to this conversation; at the time, start the group call from here", "Files", "Find a channel", "Focusing", "Forward", "Forwarded", "High", "I will remind you", "In 20 minutes", "In 3 hours", "In a meeting", "In an hour", "Links", "Low", "Make a task", "Me", "Meeting", "Mentions of you", "Messages", "More than one answer", "Never", "New channel", "No channels yet — create the first one", "No message matches", "No message to make a task from", "No reminders", "No replies yet — start the thread", "Normal", "Not available", "Not sent", "Not yet", "Nothing saved yet — “Save” in a message’s menu", "Nothing waits for you", "OK", "Off sick", "On leave", "On the way", "Only the group admin can change it, and a picture must be an image under 5 MB", "Only you see this", "Open", "Open and decide", "Options — one per line (2 to 12)", "Pin in the conversation", "Pinned by", "Pinned messages", "Poll", "Polls", "Priority", "Private group", "Public channel", "Public channel — anyone in the company can find and join it", "Question", "Questions", "Read by", "Remind me", "Reminders", "Remove from saved", "Remove the picture", "Removed from saved", "Replies", "Reply in a thread", "Reply in the thread…", "Save", "Saved", "Saved and reminders", "Saved messages", "Schedule", "Schedule a meeting", "Schedule a message", "Scheduled", "Scheduled messages", "Search by number or name", "Send anyway", "Send it anyway?", "Send the poll", "Sensitive data", "Set a status", "Set the reminder", "Show", "Status set", "That message is further up — scroll up to load it", "The channel could not be created", "The company does not allow it in chat.", "The meeting could not be scheduled", "The meeting is in everyone’s calendar", "The poll could not be sent", "The task could not be created", "The task is created and linked to the message", "This message contains", "This week", "Thread", "Title", "Tomorrow at 9", "Unpin from the conversation", "Until I turn it off", "Until tomorrow", "Urgent", "What is it for? (optional)", "What is your status?", "What you missed", "Working from home", "You may not assign tasks to others", "You may not create tasks", "Your status", "a national ID number", "a payment card number", "a word the company listed", "an IBAN", "anonymous", "closed", "closes", "days", "e.g. sales-team", "last", "messages from", "next (scheduled)", "or a time of your choosing", "pinned by (person)", "replies (count)", "reply (count)", "scheduled (count)", "the message is back in the box, send it again", "unread messages", "voted", " and ", "A group call is on now", "for", "Join", "Group calls", "people (count)", "Up to 4, up to 12 with the internal media server", "Pinned", "Live", "Play", "Sound", "Full screen", "Unmute", "Mute", "Unpin the chat", "Pin the chat to the top", "Every file and recording in the File Manager", "Admin", "you (me)", "Stop and send", "You left the group", "You were removed from this group", "You", "agreed by", "available", "edited", "is typing", "members (count)",
    };
    var S = keys.ToDictionary(k => k, k => Localizer[k].Value);
    var cfg = new
    {
        meId, openConv, tab, hospital = (bool)(ViewBag.Hospital ?? false), module = (string?)ViewBag.CommModule,
        meName = (string?)ViewBag.MeName, meAlt = (string?)ViewBag.MeAlt, meAvatar = (string?)ViewBag.MeAvatar,
        blank = Url.Content("~/Backend-assets/media/svg/avatars/blank.svg"), fileManager = Url.Action("Index", "FileManager"),
        signalr = Url.Content("~/Backend-assets/plugins/signalr.min.js"),
        S,
    };
}
<link href="~/css/comm/comm.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    @Html.AntiForgeryToken()
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Chats & calls"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@Localizer["Communication"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="cm-root">
        <div class="cm-shell no-info" id="cmShell" data-pane="list">

            @* ---------------- the list: chats, calls, people ---------------- *@
            <div class="cm-pane cm-list">
                <div class="cm-list-head">
                    <div class="cm-title"><span>@Localizer["Communication"]</span>
                        <span class="ms-auto d-flex gap-1">
                            @if (ViewBag.CanManage == true)
                            {
                                <a class="cm-ib ghost" href="@Url.Action("Settings")" title="@Localizer["Communication settings"]" aria-label="@Localizer["Communication settings"]"><i data-lucide="settings" class="cm-i" style="width:18px;height:18px"></i></a>
                            }
                            <button type="button" class="cm-ib ghost" id="cmNewGroup" title="@Localizer["New group"]" aria-label="@Localizer["New group"]"><i data-lucide="users-round" class="cm-i" style="width:18px;height:18px"></i></button>
                            <button type="button" class="cm-ib ghost" id="cmNewChat" title="@Localizer["New chat"]" aria-label="@Localizer["New chat"]"><i data-lucide="square-pen" class="cm-i" style="width:18px;height:18px"></i></button>
                        </span>
                    </div>
                    <div class="cm-search"><i data-lucide="search" class="cm-i" style="width:16px;height:16px"></i><input type="text" id="cmSearch" autocomplete="off" placeholder="@Localizer["Search chats and people"]" /></div>
                    <div class="cm-tabs" id="cmTabs" role="tablist">
                        <a role="tab" tabindex="0" data-tab="chats" class="@(tab == "chats" ? "on" : "")"><i data-lucide="message-circle" class="cm-i" style="width:15px;height:15px"></i>@Localizer["Chats"]<span class="cm-count num" id="cmCountChats"></span></a>
                        <a role="tab" tabindex="0" data-tab="calls" class="@(tab == "calls" ? "on" : "")"><i data-lucide="phone" class="cm-i" style="width:15px;height:15px"></i>@Localizer["Calls"]<span class="cm-count red num" id="cmCountCalls"></span></a>
                        <a role="tab" tabindex="0" data-tab="people" class="@(tab == "people" ? "on" : "")"><i data-lucide="contact-round" class="cm-i" style="width:15px;height:15px"></i>@Localizer["People"]</a>
                    </div>
                    <div class="cm-chips" id="cmChips"></div>
                </div>
                <div class="cm-items" id="cmItems"><div class="cm-empty">…</div></div>
            </div>

            @* ---------------- the conversation (or the selected call) ---------------- *@
            <div class="cm-pane cm-conv" id="cmConv">
                <div class="cm-blank" id="cmBlank"><div>
                    <div class="ic"><i data-lucide="messages-square" class="cm-i" style="width:32px;height:32px"></i></div>
                    <div class="fs-5 fw-bold text-gray-800">@Localizer["Pick someone to start"]</div>
                    <div class="fs-7 mt-1">@Localizer["Write, or call by voice or video, from the same place"]</div>
                </div></div>
                <div class="cm-head d-none" id="cmHead"></div>
                <div class="cm-banner d-none" id="cmBanner"></div>
                <div class="cm-head d-none py-2" id="cmFind" style="min-height:0">
                    <i data-lucide="search" class="cm-i" style="width:16px;height:16px;color:var(--cm-muted)"></i>
                    <input type="text" id="cmFindInput" class="form-control form-control-sm form-control-solid" autocomplete="off" placeholder="@Localizer["Search in this conversation"]" />
                    <span class="fs-7 text-muted" id="cmFindCount"></span>
                    <button type="button" class="cm-ib ghost xs" id="cmFindClose" title="@Localizer["Close"]"><i data-lucide="x" class="cm-i" style="width:16px;height:16px"></i></button>
                </div>
                <div class="cm-thread d-none" id="cmThread" role="log" aria-live="polite" aria-relevant="additions" aria-label="@Localizer["Messages"]" tabindex="0"></div>
                <div class="cm-compose-wrap d-none" id="cmComposeWrap">
                    <div class="cm-typing" id="cmTyping"></div>
                    <div class="cm-pop cm-mention d-none" id="cmMention"></div>
                    <div class="cm-replybar d-none" id="cmReplyBar">
                        <i data-lucide="reply" class="cm-i" style="width:16px;height:16px"></i>
                        <div class="flex-grow-1" style="min-width:0"><div class="fw-bold fs-8" id="cmReplyWho"></div><div class="fs-8 text-muted text-truncate" id="cmReplyText"></div></div>
                        <button type="button" class="cm-ib ghost xs" id="cmReplyCancel" title="@Localizer["Cancel"]"><i data-lucide="x" class="cm-i" style="width:16px;height:16px"></i></button>
                    </div>
                    <div class="cm-replybar d-none" id="cmVoiceBar" style="color:var(--cm-red);border-inline-start-color:var(--cm-red)">
                        <span class="cm-live-dot" style="background:var(--cm-red);box-shadow:none"></span>
                        <div class="flex-grow-1 fw-bold fs-7">@Localizer["Recording a voice message"] · <span class="cm-num" id="cmVoiceTime">0:00</span></div>
                        <button type="button" class="cm-ib ghost xs" id="cmVoiceCancel" title="@Localizer["Cancel"]"><i data-lucide="trash-2" class="cm-i" style="width:16px;height:16px"></i></button>
                    </div>
                    @* a recorded voice message is listened to before it is sent (owner 2026-11-19) *@
                    <div class="cm-replybar cm-vprev d-none" id="cmVoicePreview">
                        <button type="button" class="cm-ib ghost xs" id="cmVpDelete" title="@Localizer["Delete the recording"]"><i data-lucide="trash-2" class="cm-i" style="width:16px;height:16px"></i></button>
                        <button type="button" class="pl" id="cmVpPlay" title="@Localizer["Play"]"><i data-lucide="play" class="cm-i" style="width:14px;height:14px"></i></button>
                        <span class="prog" id="cmVpProg"><i style="width:0%"></i></span>
                        <span class="cm-num fs-8" id="cmVpTime">0:00</span>
                        <span class="fs-8 text-muted d-none d-sm-inline">@Localizer["Listen, then send"]</span>
                        <button type="button" class="cm-vp-send" id="cmVpSend" title="@Localizer["Send"]"><i data-lucide="send-horizontal" class="cm-i" style="width:16px;height:16px"></i></button>
                        <audio id="cmVpAudio" preload="auto" class="d-none"></audio>
                    </div>
                    <div class="cm-compose" id="cmCompose">
                        <div class="box">
                            <button type="button" class="cm-ib ghost xs" id="cmAttachBtn" title="@Localizer["Attach"]" aria-label="@Localizer["Attach"]"><i data-lucide="plus" class="cm-i" style="width:18px;height:18px"></i></button>
                            <textarea id="cmInput" rows="1" maxlength="@CrossBuy.BL.ChatService.MaxMessageLength" placeholder="@Localizer["Write a message"]" aria-label="@Localizer["Write a message"]"></textarea>
                            <button type="button" class="cm-ib ghost xs" id="cmEmojiBtn" title="@Localizer["Emoji"]" aria-label="@Localizer["Emoji"]"><i data-lucide="smile" class="cm-i" style="width:18px;height:18px"></i></button>
                            <button type="button" class="cm-ib ghost xs" id="cmPaperBtn" title="@Localizer["File"]" aria-label="@Localizer["File"]"><i data-lucide="paperclip" class="cm-i" style="width:18px;height:18px"></i></button>
                            <button type="button" class="cm-ib ghost xs" id="cmImageBtn" title="@Localizer["Picture"]" aria-label="@Localizer["Picture"]"><i data-lucide="image" class="cm-i" style="width:18px;height:18px"></i></button>
                        </div>
                        <button type="button" class="cm-send voice" id="cmMic" title="@Localizer["Voice message"]" aria-label="@Localizer["Voice message"]"><i data-lucide="mic" class="cm-i" style="width:18px;height:18px"></i></button>
                        <button type="button" class="cm-send" id="cmSend" title="@Localizer["Send"]" aria-label="@Localizer["Send"]"><i data-lucide="send-horizontal" class="cm-i" style="width:18px;height:18px"></i></button>
                        <input type="file" id="cmFile" class="d-none" />
                    </div>
                </div>
            </div>

            @* ---------------- the details ---------------- *@
            <div class="cm-pane cm-info" id="cmInfo"></div>
        </div>
        </div>
    </div></div>
</div>

@* ---------------- windows ---------------- *@
<div class="modal fade" id="cmNewModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content cm-root">
    <div class="modal-header py-4"><h2 class="fs-4 m-0">@Localizer["New chat"]</h2><button type="button" class="cm-ib ghost sm" data-bs-dismiss="modal" title="@Localizer["Close"]"><i data-lucide="x" class="cm-i" style="width:18px;height:18px"></i></button></div>
    <div class="modal-body">
        <div class="cm-search mb-3"><i data-lucide="search" class="cm-i" style="width:16px;height:16px"></i><input type="text" id="cmDirSearch" autocomplete="off" placeholder="@Localizer["Search"]" /></div>
        <div id="cmDirList" class="scroll-y mh-400px"></div>
    </div>
</div></div></div>

<div class="modal fade" id="cmGroupModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content cm-root">
    <div class="modal-header py-4"><h2 class="fs-4 m-0">@Localizer["New group"]</h2><button type="button" class="cm-ib ghost sm" data-bs-dismiss="modal" title="@Localizer["Close"]"><i data-lucide="x" class="cm-i" style="width:18px;height:18px"></i></button></div>
    <div class="modal-body">
        <label class="fw-semibold fs-7 mb-1" for="cmGrpTitle">@Localizer["Group name"]</label>
        <input type="text" id="cmGrpTitle" class="form-control form-control-solid mb-4" />
        <div class="cm-search mb-3"><i data-lucide="search" class="cm-i" style="width:16px;height:16px"></i><input type="text" id="cmGrpSearch" autocomplete="off" placeholder="@Localizer["Search"]" /></div>
        <div id="cmGrpList" class="scroll-y mh-300px"></div>
    </div>
    <div class="modal-footer py-3"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@Localizer["Cancel"]</button><button type="button" class="btn btn-primary" id="cmGrpCreate">@Localizer["Create"]</button></div>
</div></div></div>

<div class="modal fade" id="cmMembersModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content cm-root">
    <div class="modal-header py-4"><h2 class="fs-4 m-0">@Localizer["Members"]</h2><button type="button" class="cm-ib ghost sm" data-bs-dismiss="modal" title="@Localizer["Close"]"><i data-lucide="x" class="cm-i" style="width:18px;height:18px"></i></button></div>
    <div class="modal-body">
        <div id="cmMemList" class="scroll-y mh-250px mb-3"></div>
        <div class="border-top pt-4">
            <div class="fw-bold fs-7 mb-2">@Localizer["Add a member"]</div>
            <div class="cm-search mb-3"><i data-lucide="search" class="cm-i" style="width:16px;height:16px"></i><input type="text" id="cmMemSearch" autocomplete="off" placeholder="@Localizer["Search"]" /></div>
            <div id="cmMemAdd" class="scroll-y mh-200px"></div>
        </div>
    </div>
</div></div></div>

<div class="modal fade" id="cmPreviewModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content cm-root">
    <div class="modal-header py-3"><h2 class="fs-5 m-0">@Localizer["Send a file"]</h2><button type="button" class="cm-ib ghost sm" data-bs-dismiss="modal" title="@Localizer["Close"]"><i data-lucide="x" class="cm-i" style="width:18px;height:18px"></i></button></div>
    <div class="modal-body">
        <div id="cmPreviewWrap" class="mb-4"></div>
        <input type="text" id="cmCaption" class="form-control form-control-solid" placeholder="@Localizer["Add a caption…"]" />
    </div>
    <div class="modal-footer py-3"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@Localizer["Cancel"]</button><button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" id="cmPreviewSend"><i data-lucide="send-horizontal" class="cm-i" style="width:16px;height:16px"></i>@Localizer["Send"]</button></div>
</div></div></div>

<div class="modal fade" id="cmEditModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content cm-root">
    <div class="modal-header py-3"><h2 class="fs-5 m-0">@Localizer["Edit message"]</h2><button type="button" class="cm-ib ghost sm" data-bs-dismiss="modal" title="@Localizer["Close"]"><i data-lucide="x" class="cm-i" style="width:18px;height:18px"></i></button></div>
    <div class="modal-body"><input type="hidden" id="cmEditId" /><textarea id="cmEditText" class="form-control form-control-solid" rows="4"></textarea></div>
    <div class="modal-footer py-3"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@Localizer["Cancel"]</button><button type="button" class="btn btn-primary" id="cmEditSave">@Localizer["Save"]</button></div>
</div></div></div>

<div class="modal fade" id="cmImgViewModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content bg-transparent border-0 shadow-none">
    <div class="modal-body p-0" id="cmImgView" data-bs-dismiss="modal"></div>
</div></div></div>

<div class="modal fade" id="cmRecModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content cm-root">
    <div class="modal-header py-3"><h2 class="fs-5 m-0">@Localizer["Call recording"]</h2><button type="button" class="cm-ib ghost sm" data-bs-dismiss="modal" title="@Localizer["Close"]"><i data-lucide="x" class="cm-i" style="width:18px;height:18px"></i></button></div>
    <div class="modal-body" id="cmRecBody"></div>
</div></div></div>

@section Scripts {
<script>window.CB_COMM = @(Json.Serialize(cfg));</script>
<script src="~/js/comm/comm.js" asp-append-version="true"></script>
<script src="~/js/comm/comm-plus.js" asp-append-version="true"></script>
}
