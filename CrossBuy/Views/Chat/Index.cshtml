@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    int meId = ViewBag.MeId;
    var openConv = ViewBag.OpenConv as int?;
    var blank = Url.Content("~/Backend-assets/media/svg/avatars/blank.svg");
}
<style>
    .chat-col { position: relative; }
    .chat-tools { position: absolute; top: -12px; display: flex; opacity: 0; pointer-events: none; transition: opacity .12s ease; background: #fff; border: 1px solid #e4e6ef; border-radius: 8px; box-shadow: 0 3px 10px rgba(0,0,0,.08); padding: 2px 4px; z-index: 5; white-space: nowrap; }
    .chat-tools-start { inset-inline-start: 0; }
    .chat-tools-end { inset-inline-end: 0; }
    .chat-msg:hover .chat-tools { opacity: 1; pointer-events: auto; }
    /* fixed messenger height so the composer stays pinned/visible without page scroll */
    #cbchat_messenger { display: flex; flex-direction: column; min-height: 420px; }
    #cbchat_messenger_body { flex: 1 1 auto; overflow: hidden; display: flex; flex-direction: column; padding-bottom: 0; }
    #chatScroll { flex: 1 1 auto; height: auto !important; }
    #chatFooter { flex: 0 0 auto; position: relative; }
    #chatMentionBox .cbm.active { background: var(--bs-light-primary); }
    /* WhatsApp-style composer */
    .cbchat-pill { background: var(--bs-gray-100); border-radius: 24px; padding: 4px 6px; min-height: 46px; }
    .cbchat-pill .cbchat-ta { background: transparent !important; border: 0 !important; box-shadow: none !important; resize: none; padding: 8px 6px; margin: 0; max-height: 130px; line-height: 1.4; }
    .cbchat-pill .cbchat-ta:focus { background: transparent !important; }
    .cbchat-icbtn { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; color: var(--bs-gray-600); cursor: pointer; flex: 0 0 auto; margin: 0; transition: color .15s, background .15s; }
    .cbchat-icbtn:hover { color: var(--bs-primary); background: rgba(0,0,0,.05); }
    .cbchat-send { width: 46px; height: 46px; border-radius: 50%; flex: 0 0 auto; box-shadow: 0 2px 6px rgba(31,125,87,.35); }
    .cbchat-send i { font-size: 20px; }
    .cbchat-quote { max-width: 420px; }
    .cbchat-flash { animation: cbchatFlash 1.2s ease; }
    @@keyframes cbchatFlash { 0%, 100% { box-shadow: none; } 25% { box-shadow: 0 0 0 3px rgba(31,125,87,.45); } }
    .cbchat-locked { opacity: .55; pointer-events: none; }
    .rtl-flip { transform: scaleX(1); }
    html[dir="rtl"] .rtl-flip { transform: scaleX(-1); }

    /* ---------------- PHONE: one pane at a time ----------------
       Below lg the two columns are two SCREENS, not two stacked cards. The list fills the viewport;
       opening a conversation swaps to the thread, which is a fixed full-height column: sticky header,
       the messages scrolling in the middle, and the composer pinned above the home indicator. */
    @@media (max-width: 991.98px) {
        #cbchat_wrap[data-cbchat-pane="list"]   #cbchat_threadpane { display: none; }
        #cbchat_wrap[data-cbchat-pane="thread"] #cbchat_listpane   { display: none; }

        /* the list scrolls with the page instead of inside a 65vh box that produced two scrollbars */
        #chatConvList { max-height: none !important; }
        #cbchat_listpane { margin-bottom: 0 !important; }

        #cbchat_wrap[data-cbchat-pane="thread"] #cbchat_messenger {
            position: fixed; inset: 0; z-index: 105;
            height: 100dvh; max-height: 100dvh;
            margin: 0; border-radius: 0; border: 0;
        }
        #cbchat_wrap[data-cbchat-pane="thread"] #cbchat_messenger_header {
            flex: 0 0 auto; min-height: 0; padding: 10px 12px;
            padding-top: calc(10px + env(safe-area-inset-top));
            border-bottom: 1px solid var(--bs-gray-200);
        }
        #cbchat_wrap[data-cbchat-pane="thread"] #cbchat_messenger_body { padding: 10px 12px 0; }
        #cbchat_wrap[data-cbchat-pane="thread"] #chatFooter {
            padding: 8px 12px calc(8px + env(safe-area-inset-bottom)) !important;
            border-top: 1px solid var(--bs-gray-200);
        }
        /* a 16px composer: anything smaller makes iOS zoom the whole page on focus */
        #cbchat_wrap[data-cbchat-pane="thread"] .cbchat-ta { font-size: 16px; }
        /* a quoted message may not force the thread wider than the screen */
        .cbchat-quote { max-width: 100%; }

        /* TAP TO REVEAL, not always-on. There is no hover on a touch screen, but pinning the delete /
           edit / react row above every bubble buried the conversation under its own controls — measured
           at six visible tool rows on one screen. Tapping a message opens its tools and closes the
           others, which is the gesture every phone messenger already trained people to expect. */
        .chat-msg .chat-tools { opacity: 0; pointer-events: none; }
        .chat-msg.cbchat-tools-open .chat-tools { opacity: 1; pointer-events: auto; }
    }

    /* A LONG UNBROKEN STRING IS NOT A LAYOUT: one pasted url or token measured 23,256px wide inside a
       390px screen, so the message was simply unreadable. Applies at every width — a desktop bubble
       blows out the same way, it just takes a longer string. */
    .chat-msg .p-4, .chat-msg .cbchat-quote { overflow-wrap: anywhere; word-break: break-word; min-width: 0; }
    #chatScroll { overflow-x: hidden; }
</style>
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Chat"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@Localizer["Home"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Communications"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* ONE PANE AT A TIME ON A PHONE. The desktop layout is two columns side by side; below lg it
           simply STACKED, so the phone showed the whole conversation list and then an empty "select a
           conversation" card underneath it. Tapping a name opened a thread that was entirely below the
           fold — nothing appeared to happen — and the composer was never on screen at all. Same markup,
           same desktop behaviour: the panes become alternating full-screen views, switched by
           data-cbchat-pane on the wrapper. *@
        <div class="d-flex flex-column flex-lg-row" id="cbchat_wrap" data-cbchat-pane="list">
            <!--begin::Contacts sidebar-->
            <div class="flex-column flex-lg-row-auto w-100 w-lg-300px w-xl-350px mb-10 mb-lg-0" id="cbchat_listpane">
                <div class="card card-flush">
                    <div class="card-header pt-7 border-0" id="cbchat_contacts_header">
                        <div class="d-flex align-items-center gap-3 w-100">
                            <div class="position-relative flex-grow-1 my-1">
                                <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4 top-50 translate-middle-y"></i>
                                <input type="text" id="chatSearch" class="form-control form-control-solid ps-12" placeholder="@SR["Search"]" autocomplete="off" />
                            </div>
                            <div class="flex-shrink-0">
                                <button class="btn btn-icon btn-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end" title="@Localizer["New"]"><i class="ki-outline ki-plus fs-2"></i></button>
                                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 fw-semibold w-200px py-3" data-kt-menu="true">
                                    <div class="menu-item px-3"><a href="#" class="menu-link px-3" id="chatBtnNew"><i class="ki-outline ki-message-text-2 fs-5 me-2"></i>@Localizer["New chat"]</a></div>
                                    <div class="menu-item px-3"><a href="#" class="menu-link px-3" id="chatBtnGroup"><i class="ki-outline ki-people fs-5 me-2"></i>@Localizer["New group"]</a></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body pt-5">
                        <div id="chatConvList" class="scroll-y" style="max-height:65vh;">
                            <div class="text-center text-muted py-10 fs-7" id="chatConvEmpty">@Localizer["No conversations yet"]</div>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Contacts sidebar-->

            <!--begin::Messenger-->
            <div class="flex-lg-row-fluid ms-lg-7 ms-xl-10" id="cbchat_threadpane">
                <div class="card" id="cbchat_messenger">
                    <div class="card-header" id="cbchat_messenger_header">
                        <div class="card-title">
                            @* The way back. A full-screen thread with no way out is a trap, and the
                               browser's back button would leave the screen entirely. *@
                            <button type="button" class="btn btn-icon btn-sm btn-light me-2 d-lg-none" id="chatBack" aria-label="@SR["Back"]">
                                <i class="ki-outline ki-black-left fs-3 rtl-flip"></i>
                            </button>
                            <div class="symbol symbol-40px symbol-circle me-3 d-none" id="chatHeadSym"><img id="chatHeadAvatar" src="@blank" alt="" /></div>
                            <div class="d-flex justify-content-center flex-column">
                                <span class="fs-4 fw-bold text-gray-900 me-1 mb-1 lh-1" id="chatTitle">@Localizer["Select a conversation"]</span>
                                <div class="mb-0 lh-1"><span id="chatPresence" class="fs-7 fw-semibold text-muted"></span></div>
                            </div>
                        </div>
                        <div class="card-toolbar">
                            <button type="button" class="btn btn-sm btn-light-primary d-none" id="chatMembersBtn" title="@Localizer["Members"]">
                                <i class="ki-outline ki-people fs-4 me-1"></i><span id="chatMembersCount"></span>
                            </button>
                        </div>
                    </div>
                    <div class="card-body" id="cbchat_messenger_body">
                        <div id="chatEmpty" class="d-flex flex-center flex-column py-20 text-muted">
                            <i class="ki-outline ki-message-text-2 fs-5x text-primary mb-4"></i>
                            <div class="fs-5 fw-semibold">@Localizer["Pick someone to start chatting"]</div>
                        </div>
                        <div id="chatScroll" class="scroll-y me-n5 pe-5 d-none" style="height:58vh;"></div>
                        <div id="chatSeen" class="text-muted fs-8 fw-semibold text-end pe-2" style="height:16px;"></div>
                        <div id="chatTyping" class="text-muted fs-8 fw-semibold mt-1" style="height:16px;"></div>
                    </div>
                    <div class="card-footer pt-4 d-none" id="chatFooter">
                        <div id="chatMentionBox" class="d-none position-absolute bg-body border border-gray-300 rounded shadow-sm p-1" style="bottom:100%;inset-inline-start:12px;margin-bottom:6px;max-height:230px;overflow:auto;width:270px;z-index:30;"></div>
                        <div id="chatReplyBar" class="d-none align-items-center bg-light-primary rounded p-2 mb-2">
                            <i class="ki-outline ki-share fs-5 text-primary me-2"></i>
                            <span class="fs-8 text-gray-700 flex-grow-1 text-truncate" id="chatReplyText"></span>
                            <button type="button" class="btn btn-icon btn-sm" id="chatReplyCancel"><i class="ki-outline ki-cross fs-6"></i></button>
                        </div>
                        <div id="chatAttachName" class="fs-8 text-muted mb-2 d-none"><i class="ki-outline ki-paper-clip fs-6 me-1"></i><span></span></div>
                        <div class="d-flex align-items-end gap-2">
                            <div class="cbchat-pill d-flex align-items-center flex-grow-1">
                                <span class="cbchat-icbtn" id="chatEmojiBtn" title="@Localizer["Emoji"]"><i class="ki-outline ki-emoji-happy fs-2"></i></span>
                                <label class="cbchat-icbtn mb-0" title="@Localizer["Attach"]">
                                    <i class="ki-outline ki-plus fs-1"></i>
                                    <input type="file" id="chatAttach" class="d-none" />
                                </label>
                                <textarea class="form-control cbchat-ta flex-grow-1" rows="1" id="chatInput" maxlength="@CrossBuy.BL.ChatService.MaxMessageLength" placeholder="@Localizer["Type a message"]"></textarea>
                            </div>
                            <button class="btn btn-primary btn-icon cbchat-send" id="chatSend" type="button" title="@Localizer["Send"]"><i class="ki-outline ki-send fs-2"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Messenger-->
        </div>
    </div></div>
</div>

<!--begin::New chat modal-->
<div class="modal fade" id="chatNewModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header py-4"><h2 class="fs-4 m-0">@Localizer["New chat"]</h2><div class="btn btn-icon btn-sm btn-active-light-danger" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body">
        <input type="text" id="dirSearch" class="form-control form-control-solid mb-4" placeholder="@SR["Search"]" autocomplete="off" />
        <div id="dirList" class="scroll-y mh-350px"></div>
    </div>
</div></div></div>
<!--end::New chat modal-->

<!--begin::New group modal-->
<div class="modal fade" id="chatGroupModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header py-4"><h2 class="fs-4 m-0">@Localizer["New group"]</h2><div class="btn btn-icon btn-sm btn-active-light-danger" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body">
        <label class="fw-semibold fs-7 mb-1">@Localizer["Group name"]</label>
        <input type="text" id="grpTitle" class="form-control form-control-solid mb-4" />
        <input type="text" id="grpSearch" class="form-control form-control-solid mb-3" placeholder="@SR["Search"]" autocomplete="off" />
        <div id="grpList" class="scroll-y mh-300px"></div>
    </div>
    <div class="modal-footer py-3"><button class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary" id="grpCreate">@Localizer["Create"]</button></div>
</div></div></div>
<!--end::New group modal-->

<!--begin::Image/attachment preview modal (before send)-->
<div class="modal fade" id="chatImgModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header py-3"><h2 class="fs-5 m-0">@Localizer["Send image"]</h2><div class="btn btn-icon btn-sm btn-active-light-danger" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body">
        <div id="chatImgPreviewWrap" class="text-center mb-4"></div>
        <input type="text" id="chatImgCaption" class="form-control form-control-solid" placeholder="@Localizer["Add a caption…"]" />
    </div>
    <div class="modal-footer py-3">
        <button class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button>
        <button class="btn btn-primary" id="chatImgSend"><i class="ki-outline ki-send fs-4"></i>@Localizer["Send"]</button>
    </div>
</div></div></div>
<!--end::Image/attachment preview modal-->

<!--begin::Edit message modal-->
<div class="modal fade" id="chatEditModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header py-3"><h2 class="fs-5 m-0">@Localizer["Edit message"]</h2><div class="btn btn-icon btn-sm btn-active-light-danger" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body">
        <input type="hidden" id="chatEditId" />
        <textarea id="chatEditText" class="form-control form-control-solid" rows="4"></textarea>
    </div>
    <div class="modal-footer py-3">
        <button class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button>
        <button class="btn btn-primary" id="chatEditSave"><i class="ki-outline ki-check fs-4"></i>@SR["Save"]</button>
    </div>
</div></div></div>
<!--end::Edit message modal-->

<!--begin::Group members modal-->
<div class="modal fade" id="chatMembersModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header py-4"><h2 class="fs-4 m-0">@Localizer["Members"]</h2><div class="btn btn-icon btn-sm btn-active-light-danger" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body">
        <div id="memList" class="scroll-y mh-250px mb-2"></div>
        <div id="memAddWrap" class="border-top pt-3 d-none">
            <label class="fw-semibold fs-7 mb-2 d-block">@Localizer["Add member"]</label>
            <input type="text" id="memSearch" class="form-control form-control-solid mb-3" placeholder="@SR["Search"]" autocomplete="off" />
            <div id="memAddList" class="scroll-y mh-200px"></div>
        </div>
    </div>
    <div class="modal-footer py-3"><button class="btn btn-light" data-bs-dismiss="modal">@SR["Close"]</button></div>
</div></div></div>
<!--end::Group members modal-->

@section Scripts {
<script>
(function () {
    // surface any JS error on-screen (so we can see it without the console)
    window.addEventListener('error', function (e) {
        try {
            var d = document.getElementById('cbchat_err');
            if (!d) { d = document.createElement('div'); d.id = 'cbchat_err'; d.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:2147483647;background:#f1416c;color:#fff;padding:10px;font:12px/1.5 monospace;white-space:pre-wrap'; (document.body || document.documentElement).appendChild(d); }
            d.textContent = 'CHAT JS ERROR: ' + e.message + '  @@ ' + String(e.filename || '').split('/').pop() + ':' + e.lineno + ':' + e.colno;
        } catch (x) { }
    });
    // safety: never let the theme page-loader trap this page
    setTimeout(function () { try { document.body.removeAttribute('data-kt-app-page-loading'); document.body.classList.remove('page-loading'); } catch (e) { } }, 1200);
})();
</script>
<script src="@Url.Content("~/Backend-assets/plugins/signalr.min.js")"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var isAr = @(isAr ? "true" : "false");
    var meId = @meId;
    var blank = '@blank';
    var EMO = ['😀','😁','😂','🤣','😊','😍','😘','😎','🤩','🥳','😅','😉','🙂','😇','🤔','🤗','😴','😢','😭','😡','👍','👎','👏','🙏','💪','🙌','👌','✌️','🤝','❤️','🔥','⭐','✅','❌','🎉','💯','☕','🚀','📎','📌'];
    var openConv = @(openConv?.ToString() ?? "null");
    var signalrSrc = '@Url.Content("~/Backend-assets/plugins/signalr.min.js")';
    var cur = null, curHeader = null, dir = [], members = [], conn = null, replyTo = null, oldestId = null, loading = false, seen = {}, otherReadUpTo = 0, memberReads = {}, pendingFile = null;

    var $ = function (id) { return document.getElementById(id); };
    var convList = $('chatConvList'), convEmpty = $('chatConvEmpty');
    var scroll = $('chatScroll'), emptyBox = $('chatEmpty'), footer = $('chatFooter');
    var titleEl = $('chatTitle'), presenceEl = $('chatPresence'), typingEl = $('chatTyping');
    var input = $('chatInput'), sendBtn = $('chatSend'), attach = $('chatAttach'), attachName = $('chatAttachName');
    var headSym = $('chatHeadSym'), headAvatar = $('chatHeadAvatar');

    function esc(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
    // THE PAGE'S LOCALE, NOT THE BROWSER'S. toLocaleString() with no argument asked the BROWSER, so an
    // Arabic screen printed "8/26/2026, 7:52:05 AM" — a US format, to the second, that nobody reads on a
    // message. A time is also a mixed run: dropped into an RTL line unisolated it reorders, which is why
    // the stamp appeared to start with "AM".
    var CB_CHAT_LOCALE = document.documentElement.lang || 'ar';
    function timeStr(iso) {
        try {
            var d = new Date(iso), now = new Date();
            var sameDay = d.toDateString() === now.toDateString();
            return d.toLocaleString(CB_CHAT_LOCALE, sameDay
                ? { hour: '2-digit', minute: '2-digit' }
                : { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
        } catch (e) { return ''; }
    }
    function post(url, data) {
        var fd; if (data instanceof FormData) fd = data; else { fd = new FormData(); for (var k in data) if (data[k] != null) fd.append(k, data[k]); }
        return fetch(url, { method: 'POST', credentials: 'same-origin', body: fd }).then(function (r) { return r.ok ? r.json() : null; });
    }

    // ---------- conversation list ----------
    function convItemHtml(c) {
        var av = c.avatar || blank;
        var dot = c.kind === 'Direct' ? '<span class="badge badge-circle w-8px h-8px position-absolute bottom-0 end-0 ' + (c.online ? 'badge-success' : 'badge-secondary') + '"></span>' : '';
        var unread = c.unread > 0 ? '<span class="badge badge-circle badge-danger ms-2">' + c.unread + '</span>' : '';
        var icon = c.kind === 'Group'
            ? '<span class="symbol-label bg-light-primary"><i class="ki-outline ki-people fs-2 text-primary"></i></span>'
            : '<img src="' + av + '" alt="" />';
        return '<div class="d-flex align-items-center p-3 rounded mb-1 cursor-pointer chat-conv ' + (cur === c.id ? 'bg-light-primary' : 'bg-hover-light') + '" data-id="' + c.id + '" data-kind="' + c.kind + '" data-title="' + esc(c.title) + '" data-avatar="' + esc(av) + '" data-online="' + (c.online ? 1 : 0) + '" data-other="' + (c.otherEmployeeId || '') + '">' +
            '<div class="symbol symbol-40px symbol-circle position-relative me-3">' + icon + dot + '</div>' +
            '<div class="flex-grow-1 min-w-0"><div class="d-flex flex-stack"><span class="fw-bold text-gray-900 text-truncate">' + esc(c.title) + '</span>' + unread + '</div>' +
            '<div class="text-muted fs-8 text-truncate">' + esc(c.preview || '') + '</div></div></div>';
    }
    function loadConvs(then) {
        fetch('/Chat/Conversations', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (list) {
            window._convs = list;
            renderConvs(list);
            if (then) then(list);
        });
    }
    function renderConvs(list) {
        var q = ($('chatSearch').value || '').trim().toLowerCase();
        var filtered = list.filter(function (c) { return !q || (c.title || '').toLowerCase().indexOf(q) !== -1; });
        if (!filtered.length) { convList.innerHTML = ''; convList.appendChild(convEmpty); convEmpty.style.display = ''; return; }
        convEmpty.style.display = 'none';
        convList.innerHTML = filtered.map(convItemHtml).join('');
        convList.querySelectorAll('.chat-conv').forEach(function (el) {
            el.addEventListener('click', function () { openConversation(parseInt(el.getAttribute('data-id')), {
                kind: el.getAttribute('data-kind'), title: el.getAttribute('data-title'), avatar: el.getAttribute('data-avatar'), online: el.getAttribute('data-online') === '1', other: parseInt(el.getAttribute('data-other')) || null
            }); });
        });
    }
    $('chatSearch').addEventListener('input', function () { if (window._convs) renderConvs(window._convs); });

    // ---------- messages ----------
    function reactionsHtml(m) {
        if (!m.reactions || !m.reactions.length) return '';
        return '<div class="d-flex gap-1 mt-1">' + m.reactions.map(function (r) {
            return '<span class="badge ' + (r.mine ? 'badge-light-primary' : 'badge-light') + ' fs-8">' + r.emoji + ' ' + r.count + '</span>';
        }).join('') + '</div>';
