@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    var customers = ViewBag.Customers as List<(int, string)> ?? new();
    var banks = ViewBag.Banks as List<(int, string)> ?? new();
    bool hasHolding = ViewBag.HasHolding ?? false;
    string cur = ViewBag.Currency ?? "";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("شيكات تحت التحصيل", "Cheques under collection")</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Receipts","Accounting")" class="text-muted text-hover-primary">@L("سندات القبض", "Receipts")</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@L("الشيكات", "Cheques")</li></ul></div>
        @if (hasHolding)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mNew"><i class="ki-outline ki-plus fs-2"></i>@L("استلام شيك", "Receive a cheque")</button>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!hasHolding)
        {
            <div class="notice d-flex align-items-center bg-light-danger rounded border-danger border border-dashed p-4 mb-5"><i class="ki-outline ki-information-5 fs-2tx text-danger me-4"></i>
                <div class="fs-7 text-gray-700">@L("حساب «شيكات تحت التحصيل» (1106) غير موجود في دليل حسابات هذه الشركة؛ أضفه تحت الأصول المتداولة لتسجيل الشيكات.", "The «Cheques under collection» account (1106) is not in this company's chart of accounts; add it under current assets to record cheques.")</div></div>
        }
        <div class="notice d-flex align-items-center bg-light-primary rounded border-primary border border-dashed p-4 mb-5"><i class="ki-outline ki-information-5 fs-2tx text-primary me-4"></i>
            <div class="fs-7 text-gray-700">@L("الشيك سند قبض يُرحَّل على حساب الشيكات تحت التحصيل لا على النقدية. «تحصيل» ينقله إلى البنك، و«مرتد» يعكس السند فيعود المبلغ على العميل وتُفتح فواتيره من جديد.", "A cheque is a receipt posted to cheques under collection, not to cash. «Clear» moves it to the bank; «Bounced» reverses the receipt, so the customer owes it again and their invoices reopen.")</div></div>

        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-6"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@L("بحث (رقم الشيك / البنك / العميل / السند)", "Search (cheque no. / bank / customer / receipt)")</label>
                <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@L("أضف كلمات البحث…", "Add search terms…")" /></div>
            <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@L("الحالة", "Status")</label>
                <select id="f_status" class="form-select form-select-solid cb-filter" data-control="select2" data-hide-search="true"><option value="">@L("الكل", "All")</option><option value="InHand">@L("في الخزينة", "In hand")</option><option value="Cleared">@L("محصّل", "Cleared")</option><option value="Bounced">@L("مرتد", "Bounced")</option></select></div>
            <div class="col-md-3"><button type="button" id="f_reset" class="btn btn-light w-100"><i class="ki-outline ki-arrows-circle fs-3"></i> @L("مسح", "Reset")</button></div>
        </div></div></div>

        <div class="card card-flush">
            <div class="card-header align-items-center py-4">
                <div class="card-title d-flex flex-column"><span class="text-muted fs-7" id="resultCount">—</span>
                    <span class="fs-7 text-gray-700">@L("قيمة الشيكات في الخزينة:", "In hand:") <span class="fw-bold" id="grandValue" dir="ltr">—</span> @cur</span></div>
                <div class="card-toolbar"><select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
            </div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table table-row-bordered align-middle gy-3" id="t">
                <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                    <th>@L("رقم الشيك", "Cheque no.")</th><th>@L("البنك", "Bank")</th><th>@L("العميل", "Customer")</th><th>@L("سند القبض", "Receipt")</th><th>@L("الاستحقاق", "Due")</th><th class="text-end">@L("المبلغ", "Amount")</th><th class="text-center">@L("الحالة", "Status")</th><th class="text-end">@L("إجراءات", "Actions")</th>
                </tr></thead>
                <tbody id="rows"></tbody>
            </table></div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ التحميل…", "Loading…")</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@L("لا شيكات مطابقة", "No matching cheques")</div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="mNew" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="Receive" asp-controller="Cheques" method="post" data-cb-confirm data-cb-action="save" data-cb-text="@L("تسجيل الشيك وترحيل سند القبض؟", "Record the cheque and post the receipt?")">@Html.AntiForgeryToken()
        <div class="modal-header"><h2 class="fw-bold">@L("استلام شيك", "Receive a cheque")</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <div class="mb-5"><label class="required fw-semibold fs-6 mb-2">@L("العميل", "Customer")</label>
                <select name="customerId" class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#mNew" required><option value="">@L("اختر العميل", "Choose the customer")</option>@foreach (var (id, name) in customers) { <option value="@id">@name</option> }</select></div>
            <div class="row">
                <div class="col-6 mb-5"><label class="required fw-semibold fs-6 mb-2">@L("رقم الشيك", "Cheque no.")</label><input name="chequeNo" class="form-control form-control-solid" required dir="ltr" /></div>
                <div class="col-6 mb-5"><label class="fw-semibold fs-6 mb-2">@L("البنك المسحوب عليه", "Drawn on")</label><input name="bank" class="form-control form-control-solid" /></div>
            </div>
            <div class="row">
                <div class="col-4 mb-5"><label class="required fw-semibold fs-6 mb-2">@L("المبلغ", "Amount")</label><input name="amount" type="number" step="0.001" min="0.001" class="form-control form-control-solid" required dir="ltr" /></div>
                <div class="col-4 mb-5"><label class="required fw-semibold fs-6 mb-2">@L("تاريخ الاستلام", "Received")</label><input name="receiptDate" type="date" class="form-control form-control-solid" value="@today" required /></div>
                <div class="col-4 mb-5"><label class="required fw-semibold fs-6 mb-2">@L("تاريخ الاستحقاق", "Due")</label><input name="dueDate" type="date" class="form-control form-control-solid" value="@today" required /></div>
            </div>
            <div><label class="fw-semibold fs-6 mb-2">@L("ملاحظة", "Note")</label><input name="notes" class="form-control form-control-solid" /></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@L("إلغاء", "Cancel")</button><button class="btn btn-primary">@L("حفظ وترحيل", "Save & post")</button></div>
    </form>
</div></div></div>

<div class="modal fade" id="mClear" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="Clear" asp-controller="Cheques" method="post" data-cb-confirm data-cb-action="save" data-cb-text="@L("ترحيل تحصيل الشيك إلى الحساب؟", "Post the cheque into the account?")">@Html.AntiForgeryToken()
        <input type="hidden" name="id" id="clearId" />
        <div class="modal-header"><h2 class="fw-bold">@L("تحصيل الشيك", "Clear the cheque") <span class="text-muted fs-6" id="clearNo"></span></h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <div class="mb-5"><label class="required fw-semibold fs-6 mb-2">@L("أودع في", "Deposited into")</label>
                <select name="bankAccountId" class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#mClear" required>@foreach (var (id, name) in banks) { <option value="@id">@name</option> }</select></div>
            <div><label class="required fw-semibold fs-6 mb-2">@L("تاريخ التحصيل", "Cleared on")</label><input name="date" type="date" class="form-control form-control-solid" value="@today" required /></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@L("إلغاء", "Cancel")</button><button class="btn btn-primary">@L("ترحيل التحصيل", "Post clearing")</button></div>
    </form>
</div></div></div>

<div class="modal fade" id="mBounce" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="Bounce" asp-controller="Cheques" method="post" data-cb-confirm data-cb-action="delete" data-cb-text="@L("تسجيل الشيك مرتداً؟ يُعكس سند القبض ويعود المبلغ على العميل.", "Record the cheque as bounced? The receipt is reversed and the customer owes the amount again.")">@Html.AntiForgeryToken()
        <input type="hidden" name="id" id="bounceId" />
        <div class="modal-header"><h2 class="fw-bold">@L("شيك مرتد", "Bounced cheque") <span class="text-muted fs-6" id="bounceNo"></span></h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <label class="required fw-semibold fs-6 mb-2">@L("السبب", "Reason")</label><input name="reason" class="form-control form-control-solid" required placeholder="@L("مثال: رصيد غير كافٍ", "e.g. insufficient funds")" />
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@L("إلغاء", "Cancel")</button><button class="btn btn-danger">@L("تسجيل الارتداد", "Record as bounced")</button></div>
    </form>
</div></div></div>

@section Scripts {
<script>
cbServerList({ url:'@Url.Action("Data","Cheques")', isAr:@(isAr ? "true" : "false"),
  addParams:function(p){ var s=document.getElementById('f_status'); if(s&&s.value)p.set('status',s.value); } });
document.addEventListener('click', function (e) {
  var b = e.target.closest('[data-cheque-action]'); if (!b) return;
  var kind = b.getAttribute('data-cheque-action');
  document.getElementById(kind + 'Id').value = b.getAttribute('data-id');
  document.getElementById(kind + 'No').textContent = b.getAttribute('data-no');
  bootstrap.Modal.getOrCreateInstance(document.getElementById(kind === 'clear' ? 'mClear' : 'mBounce')).show();
});
</script>
}
