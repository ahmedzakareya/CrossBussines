@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    int fromYear = ViewBag.FromYear;
    var rows = ViewBag.Rows as List<CrossBuy.BL.CarryOverRow> ?? new();
    int existing = ViewBag.Existing as int? ?? 0;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Annual leave carry-over"]</h1>
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="fw-semibold fs-7">@Localizer["From year"]</label>
            <input name="fromYear" type="number" class="form-control form-control-sm form-control-solid w-100px" value="@fromYear" onchange="this.form.submit()" />
        </form>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["HrErr"] != null) { <div class="alert alert-danger">@TempData["HrErr"]</div> }
        <div class="card card-flush"><div class="card-body pt-6">
            <div class="d-flex flex-stack mb-5">
                <div class="text-muted fs-7">@Localizer["Unused {0} balance to carry into {1} (capped by the policy limit).", fromYear, fromYear + 1]
                    @if (existing > 0) { <span class="badge badge-light-primary ms-2">@Localizer["Currently carried: {0}d", existing]</span> }
                </div>
                @if (rows.Any())
                {
                    <form asp-action="RunLeaveCarryOver" method="post" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["Carry balances into {0}? Replaces any prior carry-over for that year.", fromYear + 1]">@Html.AntiForgeryToken()
                        <input type="hidden" name="fromYear" value="@fromYear" />
                        <button class="btn btn-sm btn-primary"><i class="ki-outline ki-arrow-right fs-4"></i>@Localizer["Carry into {0}", fromYear + 1]</button>
                    </form>
                }
            </div>
            @if (!rows.Any())
            {
                <div class="text-center text-muted py-15">@Localizer["Nothing to carry (no carry-over limit in policies, or no remaining balance)."]</div>
            }
            else
            {
                <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-3">
                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@SR["Employee"]</th><th>@SR["LeaveType"]</th><th class="text-end">@Localizer["Remaining"]</th><th class="text-end">@Localizer["Limit"]</th><th class="text-end pe-4">@Localizer["Carried"]</th></tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var r in rows)
                    {
                        <tr style="border-bottom:1px dashed #eef1f6;">
                            <td class="ps-4 fw-bold text-gray-900">@r.EmployeeName</td>
                            <td class="text-muted">@r.LeaveTypeName</td>
                            <td class="text-end">@r.Remaining @Localizer["d"]</td>
                            <td class="text-end">@r.Limit</td>
                            <td class="text-end fw-bolder" style="color:#0E4A9E;">@r.CarryDays</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </div></div>
    </div></div>
</div>
