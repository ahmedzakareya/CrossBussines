@model CrossBuy.Controllers.AdminController.ExpiryRowsModel
@{
    // One page of the documents & expiry list (AdminController.ExpiryData), injected by cbServerList.
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
    var names = new Dictionary<string, (string ar, string en)>(StringComparer.OrdinalIgnoreCase) {
        ["NationalId"] = ("البطاقة المدنية", "Civil ID"), ["Passport"] = ("جواز السفر", "Passport"), ["Qualification"] = ("المؤهل", "Qualification"),
        ["Contract"] = ("عقد", "Contract"), ["Insurance"] = ("التأمين", "Insurance"), ["WorkPermit"] = ("إذن العمل", "Work permit"), ["Other"] = ("أخرى", "Other"),
        ["Permanent"] = ("عقد دائم", "Permanent contract"), ["FixedTerm"] = ("عقد محدد المدة", "Fixed-term contract"), ["Probation"] = ("عقد تجربة", "Probation contract"), ["PartTime"] = ("عقد دوام جزئي", "Part-time contract") };
    string ItemName(CrossBuy.BL.ExpiryItem i) => names.TryGetValue(i.Label ?? "", out var v) ? L(v.ar, v.en) : i.Label ?? "";
}
@foreach (var i in Model.Rows)
{
    var photo = Model.Photos.TryGetValue(i.EmployeeId, out var ph) ? ph : null;
    <tr>
        <td class="ps-4">
            <div class="d-flex align-items-center min-w-0">
                <div class="symbol symbol-35px symbol-circle flex-shrink-0">
                    @if (photo != null) { <img src="@photo" alt="" /> } else { <span class="symbol-label fw-bold fs-8 hr-initials">@Initials(i.EmployeeName)</span> }
                </div>
                <a href="@Url.Action("EmployeeProfile", "Admin", new { id = i.EmployeeId })" class="ms-3 text-gray-900 text-hover-primary fw-bold text-truncate"><bdi>@(i.EmployeeName ?? "—")</bdi></a>
            </div>
        </td>
        <td><span class="fw-semibold">@ItemName(i)</span><div class="text-muted fs-8">@(i.Kind == "Contract" ? L("عقد عمل", "Employment contract") : L("وثيقة", "Document"))</div></td>
        <td class="hr-num text-nowrap">@i.Date.ToString("yyyy-MM-dd")</td>
        <td class="text-nowrap">
            @if (i.DaysLeft < 0) { <span class="badge badge-light-danger fw-bold">@(L("منتهية منذ ", "Expired ") + (-i.DaysLeft) + L(" يوم", " days ago"))</span> }
            else if (i.DaysLeft <= 30) { <span class="badge badge-light-danger fw-bold">@(i.DaysLeft + L(" يوم", " days"))</span> }
            else if (i.DaysLeft <= 60) { <span class="badge badge-light-warning fw-bold">@(i.DaysLeft + L(" يوم", " days"))</span> }
            else { <span class="badge badge-light-success fw-bold">@(i.DaysLeft + L(" يوم", " days"))</span> }
        </td>
        <td class="pe-4 text-end text-nowrap">
            @if (i.FileCount > 0) { <button type="button" class="btn btn-icon btn-light-primary btn-sm me-1 position-relative cb-gallery" data-cb-kind="@i.Kind" data-cb-id="@i.RefId" data-cb-title="@ItemName(i) — @i.EmployeeName" title="@L("المرفقات", "Attachments")"><i class="ki-outline ki-paper-clip fs-5"></i><span class="badge badge-circle badge-success position-absolute top-0 start-100 translate-middle" style="font-size:.65rem;min-width:16px;height:16px;">@i.FileCount</span></button> }
            else { <button type="button" class="btn btn-icon btn-light btn-sm me-1" disabled title="@L("لا يوجد ملف مرفق", "No file attached")"><i class="ki-outline ki-paper-clip fs-5 text-gray-400"></i></button> }
            <a href="@Url.Action("HrDocuments", "Admin", new { employeeId = i.EmployeeId })" class="btn btn-icon btn-light btn-sm" title="@L("إدارة الوثائق", "Manage documents")"><i class="ki-outline ki-document fs-5"></i></a>
        </td>
    </tr>
}
