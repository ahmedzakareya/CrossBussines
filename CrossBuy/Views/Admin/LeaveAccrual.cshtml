@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var emps = ViewBag.Employees as List<CrossBuy.ViewModel.EmployeeListItemDto> ?? new();
    var balances = ViewBag.Balances as List<CrossBuy.BL.EncashableBalance> ?? new();
    var sources = ViewBag.PaySources as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var prov = ViewBag.Provision as CrossBuy.BL.ProvisionPreview;
    var leaveTypes = ViewBag.LeaveTypes as List<CrossBuy.Models.Context.Admin.LeaveTypes> ?? new();
    int? selEmp = ViewBag.SelectedEmployee as int?;
    DateTime asOf = ViewBag.AsOf is DateTime d ? d : new DateTime(DateTime.Today.Year, 12, 31);
    var ci = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal v) => v.ToString("#,##0.00", ci);
    string empName(CrossBuy.ViewModel.EmployeeListItemDto e) => isAr ? (e.FullName ?? "") : (string.IsNullOrEmpty(e.FullNameEn) ? e.FullName : e.FullNameEn) ?? "";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Leave encashment & provision"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@Localizer["HR"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Leave & attendance"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["HrErr"] != null) { <div class="alert alert-danger">@TempData["HrErr"]</div> }
        <div class="row g-5">
            <!-- Encashment -->
            <div class="col-lg-7">
                <div class="card card-flush mb-5">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Leave encashment"]</h2></div></div>
                    <div class="card-body pt-2">
                        <form method="get" class="d-flex gap-2 mb-5">
                            <select name="employeeId" class="form-select form-select-solid" data-control="select2" onchange="this.form.submit()">
                                <option value="">@Localizer["Select employee…"]</option>
                                @foreach (var e in emps) { <option value="@e.ID" selected="@(selEmp == e.ID)">@empName(e)</option> }
                            </select>
                        </form>
                        @if (selEmp.HasValue)
                        {
                            if (!balances.Any())
                            {
                                <div class="text-center text-muted py-10">@Localizer["No encashable balance for this employee."]</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                <table class="table align-middle table-row-dashed fs-6 gy-3">
                                    <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@SR["LeaveType"]</th><th>@SR["Balance"]</th><th>@Localizer["Daily rate"]</th><th>@Localizer["Value"]</th><th class="text-end pe-4">@Localizer["Encash"]</th></tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                    @foreach (var b in balances)
                                    {
                                        <tr style="border-bottom:1px dashed #eef1f6;">
                                            <td class="ps-4 fw-bold text-gray-900">@(isAr ? b.NameAr : DisplayName.Or(b.NameEn, b.NameAr))</td>
                                            <td>@b.RemainingDays @Localizer["d"]</td>
                                            <td>@Money(b.DailyRate)</td>
                                            <td class="fw-bolder" style="color:#0E4A9E;">@Money(b.Amount)</td>
                                            <td class="text-end pe-4">
                                                <form asp-action="Encash" method="post" class="d-flex gap-2 justify-content-end align-items-center" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["Pay out this leave balance in cash?"]">@Html.AntiForgeryToken()
                                                    <input type="hidden" name="employeeId" value="@selEmp" /><input type="hidden" name="leaveTypeId" value="@b.LeaveTypeId" />
                                                    <input name="days" type="number" min="1" max="@b.RemainingDays" value="@b.RemainingDays" class="form-control form-control-sm form-control-solid w-70px" />
                                                    <select name="payFromGlAccountId" class="form-select form-select-sm form-select-solid w-150px" data-control="select2" data-hide-search="true" required>@foreach (var s in sources){<option value="@s.GlAccountId">@s.Name</option>}</select>
                                                    <input name="encashDate" type="date" class="form-control form-control-sm form-control-solid w-140px" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                                    <button class="btn btn-sm btn-light-primary">@Localizer["Pay"]</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                                </div>
                                <div class="text-muted fs-8 mt-2">@Localizer["Daily rate = (base + allowances) ÷ 30. Entry: Dr 520104 / Cr bank. Paid days reduce the balance."]</div>
                            }
                        }
                        else { <div class="text-center text-muted py-10">@Localizer["Pick an employee to view encashable balance."]</div> }
                    </div>
                </div>

                <!-- Encashability toggles -->
                <div class="card card-flush">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Encashable leave types"]</h2></div></div>
                    <div class="card-body pt-2">
                        <div class="text-muted fs-8 mb-3">@Localizer["Mark which types may be paid out and included in the provision (usually annual leave only)."]</div>
                        @foreach (var t in leaveTypes)
                        {
                            <form asp-action="SaveLeaveTypeEncashable" method="post" class="d-flex align-items-center justify-content-between border-bottom py-2">@Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.ID" />
                                <span class="fw-semibold text-gray-800">@(isAr ? t.NameAr : DisplayName.Or(t.NameEn, t.NameAr))</span>
                                <div class="form-check form-switch">
                                    <input type="hidden" name="isEncashable" value="false" />
                                    <input class="form-check-input" type="checkbox" name="isEncashable" value="true" @(t.IsEncashable ? "checked" : "") onchange="this.form.submit()" />
                                </div>
                            </form>
                        }
                        @if (!leaveTypes.Any()) { <div class="text-center text-muted py-5">@Localizer["No leave types."]</div> }
                    </div>
                </div>
            </div>

            <!-- Provision -->
            <div class="col-lg-5">
                <div class="card card-flush">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Leave provision"]</h2></div></div>
                    <div class="card-body pt-2">
                        <form method="get" class="mb-4">
                            <input type="hidden" name="employeeId" value="@selEmp" />
                            <label class="fw-semibold fs-7 mb-1">@Localizer["As of date"]</label>
                            <div class="d-flex gap-2"><input name="asOf" type="date" class="form-control form-control-solid" value="@asOf.ToString("yyyy-MM-dd")" /><button class="btn btn-light-primary">@Localizer["Compute"]</button></div>
                        </form>
                        @if (prov != null)
                        {
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@SR["Employees"]</span><span class="fw-bold">@prov.Employees</span></div>
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@Localizer["Total earned days"]</span><span class="fw-bold">@Money(prov.TotalDays)</span></div>
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@Localizer["Required provision"]</span><span class="fw-bold text-primary">@Money(prov.TargetAmount)</span></div>
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@Localizer["Current balance (210206)"]</span><span class="fw-bold">@Money(prov.CurrentBalance)</span></div>
                            <div class="d-flex justify-content-between py-3"><span class="fw-bold">@Localizer["Adjustment to post"]</span><span class="fw-bold @(prov.Adjustment >= 0 ? "text-primary" : "text-danger")">@Money(prov.Adjustment)</span></div>
                            <form asp-action="PostLeaveProvision" method="post" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["Post the provision adjustment?"]">@Html.AntiForgeryToken()
                                <input type="hidden" name="asOf" value="@asOf.ToString("yyyy-MM-dd")" />
                                <button class="btn btn-primary w-100" @(prov.Adjustment == 0 ? "disabled" : "")>@Localizer["Post adjustment"]</button>
                            </form>
                            <div class="text-muted fs-8 mt-3">@Localizer["Increase ← Dr 520106 / Cr 210206; release ← reverse. Only the difference is posted to match the liability."]</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
