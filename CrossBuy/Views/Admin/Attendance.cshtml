@using CrossBuy.BL
@model List<AttendanceMonthRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    int y = ViewBag.Year; int m = ViewBag.Month;
    ViewData["Title"] = Localizer["Monthly attendance"].Value;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Monthly attendance summary"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@Localizer["HR"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Attendance"]</li></ul>
        </div>
        <a href="@Url.Action("AttendanceEntry","Admin", new { year = y, month = m })" class="btn btn-primary"><i class="ki-outline ki-time fs-2"></i>@Localizer["Record attendance"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush mb-5"><div class="card-body py-4"><form method="get" class="d-flex align-items-end gap-3">
            <div><label class="fs-7 fw-semibold text-muted">@Localizer["Year"]</label><input name="year" type="number" value="@y" class="form-control form-control-solid w-120px" /></div>
            <div><label class="fs-7 fw-semibold text-muted">@Localizer["Month"]</label><input name="month" type="number" min="1" max="12" value="@m" class="form-control form-control-solid w-100px" /></div>
            <button class="btn btn-light-primary">@SR["Show"]</button>
        </form></div></div>
        <div class="card card-flush"><div class="card-body pt-6"><div class="table-responsive">
            <table class="table align-middle fs-6 gy-3 mb-0" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #13433a;">
                    <th class="ps-4">@SR["Employee"]</th><th class="text-center">@Localizer["Work days"]</th><th class="text-center">@Localizer["Present"]</th>
                    <th class="text-center">@Localizer["Late count"]</th><th class="text-center">@Localizer["Late min"]</th><th class="text-center">@Localizer["OT min"]</th>
                    <th class="text-center">@Localizer["Leave"]</th><th class="text-center pe-4">@Localizer["Absent"]</th>
                </tr></thead>
                <tbody class="fw-semibold text-gray-700">
                @foreach (var r in Model)
                {
                    <tr style="border-bottom:1px dashed #eef1f6;">
                        <td class="ps-4 fw-bold text-gray-900">@r.EmployeeName</td>
                        <td class="text-center">@r.WorkDays</td>
                        <td class="text-center fw-bold" style="color:#1f6253;">@r.PresentDays</td>
                        <td class="text-center @(r.LateCount>0?"text-gray-900 fw-bold":"text-gray-400")">@r.LateCount</td>
                        <td class="text-center @(r.LateMinutes>0?"text-gray-900 fw-bold":"text-gray-400")">@r.LateMinutes</td>
                        <td class="text-center @(r.OvertimeMinutes>0?"fw-bold":"text-gray-400")" style="@(r.OvertimeMinutes>0?"color:#1f6253;":"")">@r.OvertimeMinutes</td>
                        <td class="text-center text-muted">@r.LeaveDays</td>
                        <td class="text-center pe-4 @(r.AbsentDays>0?"text-danger fw-bold":"text-gray-400")">@r.AbsentDays</td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-10">@Localizer["No data (no employees with an attendance policy, or no records)"]</td></tr> }
                </tbody>
            </table>
        </div>
        <div class="text-muted fs-7 mt-2">@Localizer["Late/overtime minutes and absences are ready to feed payroll in the next phase (HR-3) via SalaryPolicies components."]</div>
        </div></div>
    </div></div>
</div>
