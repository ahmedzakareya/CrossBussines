@using CrossBuy.BL
@model List<AttendanceMonthRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    // HR prototype design (design-output/hr-prototype #/attendance), adopted by the owner on 2026-11-08.
    // Same monthly summary as before (AttendanceService.MonthlySummaryAsync), plus the month's latest punches.
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    ViewData["Title"] = "Attendance";
    int y = ViewBag.Year; int mo = ViewBag.Month;
    var month = new DateTime(y, mo, 1);
    var photos = (ViewBag.Photos as Dictionary<int, string>) ?? new Dictionary<int, string>();
    var names = (ViewBag.Names as Dictionary<int, string>) ?? new Dictionary<int, string>();
    var latest = (ViewBag.Latest as List<CrossBuy.Models.Context.Admin.AttendanceRecord>) ?? new();
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
    string NameOf(int id, string? fallback = null) => names.TryGetValue(id, out var n) ? n : (fallback ?? "#" + id);
    var monthsAr = new[] { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var monthsEn = new[] { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    string MonthName(DateTime d) => (isAr ? monthsAr[d.Month] : monthsEn[d.Month]) + " " + d.Year;
    int present = Model.Sum(r => r.PresentDays), absent = Model.Sum(r => r.AbsentDays), lateCount = Model.Sum(r => r.LateCount), otMin = Model.Sum(r => r.OvertimeMinutes), work = Model.Sum(r => r.WorkDays);
    string Hm(int minutes) => minutes <= 0 ? "0" : (minutes / 60) + ":" + (minutes % 60).ToString("00");
    var prev = month.AddMonths(-1); var next = month.AddMonths(1);
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />

@{
    void Person(int id, string? name)
    {
        var photo = photos.TryGetValue(id, out var ph) ? ph : null;
        <div class="d-flex align-items-center min-w-0">
            <div class="symbol symbol-30px symbol-circle flex-shrink-0">
                @if (photo != null) { <img src="@photo" alt="" /> } else { <span class="symbol-label fw-bold fs-9 hr-initials">@Initials(name)</span> }
            </div>
            <a href="@Url.Action("EmployeeProfile", "Admin", new { id })" class="ms-2 text-gray-900 text-hover-primary fw-bold fs-7 text-truncate"><bdi>@name</bdi></a>
        </div>
    }
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("الحضور والعمل الإضافي", "Attendance & overtime")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index", "Admin")" class="text-muted text-hover-primary">@SR["HumanResources"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@L("الإجازات والحضور", "Leave & attendance")</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Attendance", "Admin", new { year = prev.Year, month = prev.Month })" class="btn btn-sm btn-icon btn-light" title="@L("الشهر السابق", "Previous month")"><i class="ki-outline @(isAr ? "ki-arrow-right" : "ki-arrow-left") fs-4"></i></a>
                <span class="fw-bold fs-6 px-2">@MonthName(month)</span>
                <a href="@Url.Action("Attendance", "Admin", new { year = next.Year, month = next.Month })" class="btn btn-sm btn-icon btn-light" title="@L("الشهر التالي", "Next month")"><i class="ki-outline @(isAr ? "ki-arrow-left" : "ki-arrow-right") fs-4"></i></a>
                <a href="@Url.Action("Overtime", "Admin", new { month = $"{y}-{mo:00}" })" class="btn btn-sm btn-light ms-2"><i class="ki-outline ki-timer fs-4"></i>@L("اعتماد الإضافي", "Overtime approval")</a>
                <a href="@Url.Action("AttendanceImport", "Admin")" class="btn btn-sm btn-light ms-2"><i class="ki-outline ki-file-up fs-4"></i>@L("استيراد من جهاز البصمة", "Import from device")</a>
                <a href="@Url.Action("AttendanceEntry", "Admin", new { year = y, month = mo })" class="btn btn-sm btn-primary ms-2"><i class="ki-outline ki-time fs-4"></i>@L("تسجيل حضور", "Record attendance")</a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] { (L("أيام حضور", "Days present"), present.ToString(), "ki-check-circle", "text-success", L("من", "of") + " " + work + " " + L("يوم عمل مجدول", "scheduled work days")),
                                           (L("أيام غياب", "Days absent"), absent.ToString(), "ki-cross-circle", absent > 0 ? "text-danger" : "text-gray-900", L("بلا إجازة أو عطلة", "without leave or holiday")),
                                           (L("حالات تأخير", "Late arrivals"), lateCount.ToString(), "ki-time", "text-gray-900", Hm(Model.Sum(r => r.LateMinutes)) + " " + L("ساعة إجمالاً", "hours in total")),
                                           (L("عمل إضافي", "Overtime"), Hm(otMin), "ki-timer", "text-primary", L("ساعة:دقيقة", "hours:minutes")) })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                        <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div><i class="ki-outline @s.Item3 fs-2 text-gray-400"></i></div>
                        <div class="fs-2hx fw-bold @s.Item4"><span class="hr-num">@s.Item2</span></div>
                        <div class="text-muted fs-8 mt-1">@s.Item5</div>
                    </div></div></div>
                }
            </div>

            <div class="row g-5 g-xl-8">
                <div class="col-12">
                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6 flex-wrap gap-3">
                            <div class="card-title flex-column m-0">
                                <span class="fw-bold text-gray-900 fs-4">@L("ملخص الشهر", "Month summary")</span>
                                <span class="text-muted fs-7 mt-1">@MonthName(month) · <span id="resultCount">—</span></span>
                            </div>
                            <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                                <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@L("ابحث باسم الموظف…", "Search by employee name…")" /></div>
                                <select id="f_size" class="form-select form-select-solid form-select-sm w-auto"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                                <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@L("إعادة ضبط", "Reset")"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                            </div>
                        </div>
                        <div class="card-body pt-4">
                            <div class="table-responsive">
                                <table class="table align-middle gy-3 mb-0 hr-table">
                                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                        <th class="ps-4">@L("الموظف", "Employee")</th><th class="text-center">@L("حضور", "Present")</th><th>@L("نسبة الحضور", "Attendance rate")</th>
                                        <th class="text-center">@L("تأخير", "Late")</th><th class="text-center">@L("إضافي", "Overtime")</th><th class="text-center">@L("إجازة", "Leave")</th><th class="text-center pe-4">@L("غياب", "Absent")</th>
                                    </tr></thead>
                                    <tbody class="fs-6" id="rows"></tbody>
                                </table>
                            </div>
                            <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ التحميل…", "Loading…")</div>
                            <div class="text-center text-muted py-10 d-none" id="emptyRow">@L("لا نتائج: لا موظفون بسياسة حضور، أو لا تطابق للبحث", "No results: no employees with an attendance policy, or nothing matches the search")</div>
                            <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("آخر الحركات", "Latest punches")</span>
                            <span class="text-muted fs-7 mt-1">@L("آخر ١٥ سجلاً في الشهر", "The month's last 15 records")</span></div></div>
                        <div class="card-body pt-4">
                            <table class="table align-middle gy-3 mb-0 hr-table">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-0">@L("الموظف", "Employee")</th><th>@L("دخول – خروج", "In – out")</th><th class="text-end">@L("الحالة", "Status")</th></tr></thead>
                                <tbody class="fs-6">
                                    @if (latest.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-8">@L("لا سجلات هذا الشهر", "No records this month")</td></tr> }
                                    @foreach (var a in latest)
                                    {
                                        <tr>
                                            <td class="ps-0">@{ Person(a.EmployeeID, NameOf(a.EmployeeID)); }<div class="text-muted fs-8 hr-num ms-10">@a.WorkDate.ToString("yyyy-MM-dd")</div></td>
                                            <td class="text-nowrap"><span class="hr-num">@(a.CheckIn?.ToString("HH:mm") ?? "—") – @(a.CheckOut?.ToString("HH:mm") ?? "—")</span><div class="text-muted fs-8"><span class="hr-num">@a.WorkedHours.ToString("0.#")</span> @L("س", "h") · @a.Source</div></td>
                                            <td class="text-end">
                                                @switch (a.Status)
                                                {
                                                    case "Absent": <span class="badge badge-light-danger fw-bold fs-8">@L("غياب", "Absent")</span> break;
                                                    case "Late": <span class="badge badge-light-primary fw-bold fs-8">@(L("تأخير ", "Late ") + a.LateMinutes + L(" د", "m"))</span> break;
                                                    case "Leave": <span class="badge badge-light fw-bold fs-8">@L("إجازة", "Leave")</span> break;
                                                    case "Holiday": case "RestDay": <span class="badge badge-light fw-bold fs-8">@L("عطلة", "Day off")</span> break;
                                                    default: <span class="badge badge-light-success fw-bold fs-8">@L("منتظم", "Regular")</span> break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-5 mb-5">
                <div class="col-xl-6"><div class="hr-notice h-100 mb-0">
                    <i class="ki-outline ki-wallet fs-2"></i>
                    <div><div class="fw-bold">@L("إلى الرواتب", "Into payroll")</div>
                    <div class="fs-7">@L("دقائق التأخير والعمل الإضافي والغياب جاهزة لتغذية الراتب عبر مكونات سياسة الرواتب. نسب العمل الإضافي والسقوف ستأتي من حزمة الدولة في الإعدادات.", "Late and overtime minutes and absences are ready to feed payroll through the salary-policy components. Overtime rates and caps will come from the country pack in settings.")</div></div>
                </div></div>
                <div class="col-xl-6"><div class="hr-notice h-100 mb-0">
                    <i class="ki-outline ki-fingerprint-scanning fs-2"></i>
                    <div><div class="fw-bold">@L("أجهزة البصمة — قادم", "Biometric devices — coming")</div>
                    <div class="fs-7">@L("المصدر «جهاز» معرّف ولا يغذيه شيء اليوم. المخطط: استيراد دوري من الأجهزة بمطابقة الرقم الوظيفي، وكل حركة تحتفظ بمصدرها.", "A \"Device\" source exists and nothing feeds it today. Planned: periodic import from devices matched on employee number; every punch keeps its source.")</div></div>
                </div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/Backend-assets/js/crossbuy-tagify.js" asp-append-version="true"></script>
<script>
cbServerList({
    url: '@Url.Action("AttendanceData", "Admin")',
    isAr: @(isAr ? "true" : "false"),
    addParams: function (p) { p.set('year', '@y'); p.set('month', '@mo'); }
});
</script>
}
