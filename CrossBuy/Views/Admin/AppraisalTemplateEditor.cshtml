@using CrossBuy.Models.Context.Admin
@model AppraisalTemplate
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isEdit = Model.ID > 0;
    var initial = Model.Criteria.Select(c => new { name = c.Name, nameEn = c.NameEn, weight = c.Weight, maxScore = c.MaxScore }).ToList();
    var initialJson = System.Text.Json.JsonSerializer.Serialize(initial);
}
<form asp-action="SaveAppraisalTemplate" method="post" id="tplForm" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.ID" />
    <input type="hidden" name="criteriaJson" id="criteriaJson" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <h1 class="page-heading fw-bold fs-3 m-0">@(isEdit ? Localizer["Edit template"] : Localizer["New template"])</h1>
        <div class="d-flex gap-2"><a href="@Url.Action("AppraisalTemplates","Admin")" class="btn btn-light">@SR["Back"]</a><button class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush mb-5"><div class="card-body py-6"><div class="row g-4">
            <div class="col-md-5"><label class="required fw-semibold fs-7 mb-1">@SR["Name"]</label><input name="name" class="form-control form-control-solid" value="@Model.Name" required /></div>
            <div class="col-md-5"><label class="fw-semibold fs-7 mb-1">@Localizer["Name (EN)"]</label><input name="nameEn" class="form-control form-control-solid" value="@Model.NameEn" /></div>
            <div class="col-md-2 d-flex align-items-end"><label class="form-check form-switch form-check-custom"><input type="hidden" name="isActive" value="false" /><input class="form-check-input" type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "") /><span class="form-check-label fw-semibold ms-2">@SR["Active"]</span></label></div>
        </div></div></div>

        <div class="card card-flush"><div class="card-header"><div class="card-title fw-bold">@Localizer["Criteria (weight + max)"]</div></div>
            <div class="card-body">
                <div class="row g-2 align-items-end mb-4 bg-light-primary rounded p-3">
                    <div class="col-md-5"><label class="fw-semibold fs-8 mb-1">@Localizer["Criterion"]</label><input id="c_name" class="form-control form-control-solid form-control-sm" /></div>
                    <div class="col-md-3"><label class="fw-semibold fs-8 mb-1">@Localizer["Name (EN)"]</label><input id="c_nameEn" class="form-control form-control-solid form-control-sm" /></div>
                    <div class="col-md-2"><label class="fw-semibold fs-8 mb-1">@Localizer["Weight"]</label><input id="c_weight" type="number" step="0.01" class="form-control form-control-solid form-control-sm" value="1" /></div>
                    <div class="col-md-1"><label class="fw-semibold fs-8 mb-1">@Localizer["Max"]</label><input id="c_max" type="number" step="0.01" class="form-control form-control-solid form-control-sm" value="5" /></div>
                    <div class="col-md-1"><button type="button" id="c_add" class="btn btn-sm btn-primary w-100"><i class="ki-outline ki-plus fs-4"></i></button></div>
                </div>
                <div class="text-muted fs-8 mb-3">@Localizer["Final score = Σ(score ÷ max × weight) ÷ Σweights × 100."]</div>
                <table class="table table-row-bordered align-middle gy-2">
                    <thead><tr class="fw-bold fs-8 text-muted" style="border-bottom:2px solid #0E4A9E;"><th>@Localizer["Criterion"]</th><th class="text-end">@Localizer["Weight"]</th><th class="text-end">@Localizer["Max"]</th><th class="text-end w-50px"></th></tr></thead>
                    <tbody id="critRows"></tbody>
                </table>
                <div id="noCrit" class="text-center text-muted py-6 d-none">@Localizer["Add at least one criterion"]</div>
            </div>
        </div>
    </div></div>
</form>
@section Scripts {
<script>
(function(){
  var C = @Html.Raw(initialJson);
  var tb = document.getElementById('critRows'), no = document.getElementById('noCrit');
  function render(){
    tb.innerHTML=''; no.classList.toggle('d-none', C.length!==0);
    C.forEach(function(c,i){ var tr=document.createElement('tr');
      tr.innerHTML='<td></td><td class="text-end">'+(c.weight||0)+'</td><td class="text-end">'+(c.maxScore||5)+'</td>'+
        '<td class="text-end"><button type="button" class="btn btn-sm btn-icon btn-light-danger" data-rm="'+i+'"><i class="ki-outline ki-trash fs-6"></i></button></td>';
      tr.querySelector('td').textContent=c.name||''; tb.appendChild(tr); });
  }
  tb.addEventListener('click',function(e){var b=e.target.closest('[data-rm]');if(!b)return;C.splice(+b.getAttribute('data-rm'),1);render();});
  document.getElementById('c_add').addEventListener('click',function(){
    var n=document.getElementById('c_name').value.trim(); if(!n)return;
    C.push({name:n,nameEn:document.getElementById('c_nameEn').value.trim(),weight:parseFloat(document.getElementById('c_weight').value||'1')||0,maxScore:parseFloat(document.getElementById('c_max').value||'5')||5});
    document.getElementById('c_name').value='';document.getElementById('c_nameEn').value='';document.getElementById('c_weight').value='1';document.getElementById('c_max').value='5';render();
  });
  document.getElementById('tplForm').addEventListener('submit',function(){
    document.getElementById('criteriaJson').value=JSON.stringify(C.map(function(c){return {Name:c.name,NameEn:c.nameEn,Weight:c.weight,MaxScore:c.maxScore};}));
  });
  render();
})();
</script>
}
