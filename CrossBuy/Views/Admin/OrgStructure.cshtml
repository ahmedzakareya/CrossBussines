@model CrossBuy.Controllers.AdminController.OrgChartModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    // HR prototype design (design-output/hr-prototype #/org), adopted by the owner on 2026-11-08 for every HR
    // screen the prototype shares with the system. The previous AdministrativeStructure.cshtml is untouched.
    ViewData["Title"] = "OrgStructure";
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    var byParent = Model.Nodes.Where(n => n.ParentId.HasValue).GroupBy(n => n.ParentId!.Value).ToDictionary(g => g.Key, g => g.ToList());
    var roots = Model.Nodes.Where(n => !n.ParentId.HasValue || !Model.Nodes.Any(p => p.Id == n.ParentId)).ToList();
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
    string TypeLabel(int t) => t switch { 1 => L("شركة", "Company"), 2 => L("فرع", "Branch"), 3 => L("إدارة", "Department"), 4 => L("وظيفة", "Position"), _ => "" };
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />

@{
    void Node(CrossBuy.Controllers.AdminController.OrgChartNode n)
    {
        var kids = byParent.TryGetValue(n.Id, out var k) ? k : new List<CrossBuy.Controllers.AdminController.OrgChartNode>();
        var name = isAr ? n.Name : (string.IsNullOrWhiteSpace(n.NameEn) ? n.Name : n.NameEn);
        var vacant = n.Type == 4 && !kids.Any(c => c.Type == 5);
        var cls = n.Type == 1 ? "company" : n.Type == 5 ? "" : vacant ? "vacant" : "unit";
        <li>
            @if (n.Type == 5)
            {
                var title = isAr ? (n.Title ?? n.TitleEn) : (n.TitleEn ?? n.Title);
                <a href="@Url.Action("EmployeeProfile", "Admin", new { id = n.EmployeeId })" class="org-node text-hover-primary @(n.Active ? "" : "inactive")" data-org-node="@n.Id" data-org-text="@(n.Name) @(n.NameEn) @(n.Title) @(n.TitleEn)">
                    <div class="symbol symbol-50px symbol-circle">
                        @if (!string.IsNullOrEmpty(n.Photo))
                        {
                            <img src="@n.Photo" alt="@name" onerror="this.parentNode.innerHTML='<span class=\'symbol-label fw-bold hr-initials\'>@Initials(n.NameEn ?? n.Name)</span>'" />
                        }
                        else
                        {
                            <span class="symbol-label fw-bold hr-initials">@Initials(n.NameEn ?? n.Name)</span>
                        }
                    </div>
                    <span class="org-name">@name</span>
                    <span class="org-sub">@(title ?? "")</span>
                    @if (!n.Active) { <span class="badge badge-light fs-9">@L("غير نشط", "Inactive")</span> }
                </a>
            }
            else
            {
                <div class="org-node @cls" data-org-node="@n.Id" data-org-text="@(n.Name) @(n.NameEn)">
                    @if (Model.CanManage && n.Type != 4)
                    {
                        <span class="org-add" data-org-add="@n.Id" data-org-add-name="@name" title="@L("إضافة وحدة تحتها", "Add a unit under it")"><i class="ki-outline ki-plus fs-6"></i></span>
                    }
                    <i class="ki-outline @(n.Type == 1 ? "ki-bank" : n.Type == 2 ? "ki-geolocation" : n.Type == 4 ? "ki-briefcase" : "ki-abstract-26") fs-2 @(n.Type == 1 ? "text-white" : "text-primary")"></i>
                    <span class="org-name">@name</span>
                    <span class="org-sub">@TypeLabel(n.Type)@(vacant ? " · " + L("شاغرة", "Vacant") : "")</span>
                </div>
            }
            @if (kids.Count > 0)
            {
                <ul data-org-children="@n.Id">
                    @foreach (var c in kids.OrderBy(c => c.Type).ThenBy(c => c.Name)) { Node(c); }
                </ul>
            }
        </li>
    }
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("الهيكل التنظيمي", "Organisation chart")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index", "Admin")" class="text-muted text-hover-primary">@SR["HumanResources"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@L("الموظفون والهيكل", "People & organisation")</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="d-flex align-items-center position-relative">
                    <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                    <input type="text" id="orgSearch" class="form-control form-control-solid w-250px ps-12" placeholder="@L("ابحث باسم شخص أو وحدة...", "Search a person or unit...")" autocomplete="off" />
                </div>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <div class="notice d-flex rounded border border-dashed p-6 hr-notice mb-5">
                <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label"><i class="ki-outline ki-abstract-26 fs-2x text-white"></i></span></span>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                    <div class="mb-3 mb-md-0 fw-semibold pe-5">
                        <h4 class="text-gray-900 fw-bold mb-1">@L("هيكل شركتك", "Your company's tree")</h4>
                        <div class="fs-6 text-gray-700">@L("يظهر هنا هيكل شركتك وحدها، وكل موظف بصورته. الوظيفة الشاغرة تظهر بإطار منقط. اضغط على أي شخص لفتح ملفه.", "Only your company's tree is shown, every person with their photo. A vacant position has a dashed frame. Click anyone to open their file.")</div>
                    </div>
                    <span class="badge fs-7 fw-bold px-4 py-2 flex-shrink-0 hr-badge-solid"><span class="hr-num">@Model.People</span>&nbsp;@L("موظفاً", "people")</span>
                </div>
            </div>

            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] { (L("الموظفون في الهيكل", "People in the chart"), Model.People, "ki-people", ""), (L("الإدارات والفروع", "Departments & branches"), Model.Units, "ki-abstract-26", ""), (L("الوظائف", "Positions"), Model.Positions, "ki-briefcase", ""), (L("وظائف شاغرة", "Vacant positions"), Model.Vacant, "ki-user-square", Model.Vacant > 0 ? "text-primary" : "") })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                        <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div><i class="ki-outline @s.Item3 fs-2 text-gray-400"></i></div>
                        <div class="fs-2hx fw-bold @(string.IsNullOrEmpty(s.Item4) ? "text-gray-900" : s.Item4)"><span class="hr-num">@s.Item2</span></div>
                    </div></div></div>
                }
            </div>

            <div class="card mb-5 mb-xl-8">
                <div class="card-header border-0 pt-6">
                    <div class="card-title align-items-start flex-column m-0">
                        <span class="card-label fw-bold text-gray-900 fs-4">@L("الهيكل التنظيمي", "Organisation chart")</span>
                        <span class="text-muted mt-1 fw-semibold fs-7">@L("اضغط على أي شخص لفتح ملفه", "Click anyone to open their file")@(Model.CanManage ? " · " + L("مرّر فوق وحدة لإضافة وحدة تحتها", "hover a unit to add one under it") : "")</span>
                    </div>
                </div>
                <div class="card-body pt-4">
                    @if (Model.Nodes.Count == 0)
                    {
                        <div class="text-center text-muted py-10">@L("لا يوجد هيكل لهذه الشركة بعد", "This company has no tree yet")</div>
                    }
                    else
                    {
                        <div class="org-scroll"><div class="org-tree" id="orgTree"><ul>
                            @foreach (var r in roots) { Node(r); }
                        </ul></div></div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.CanManage)
{
    <div class="modal fade" id="orgAddModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered mw-600px"><div class="modal-content">
            <div class="modal-header"><h2 class="fw-bold m-0">@L("إضافة وحدة تحت", "Add a unit under") <span id="orgAddParent" class="text-primary"></span></h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
            <div class="modal-body py-8 px-lg-10"><div class="row g-5">
                <div class="col-md-6"><label class="fw-semibold fs-7 text-gray-700 mb-2 required">@L("الاسم بالعربي", "Arabic name")</label><input id="orgAddAr" class="form-control form-control-solid" dir="rtl" /></div>
                <div class="col-md-6"><label class="fw-semibold fs-7 text-gray-700 mb-2 required">@L("الاسم بالإنجليزي", "English name")</label><input id="orgAddEn" class="form-control form-control-solid" dir="ltr" /></div>
                <div class="col-12"><label class="fw-semibold fs-7 text-gray-700 mb-2">@L("ملاحظات", "Notes")</label><input id="orgAddNotes" class="form-control form-control-solid" /></div>
                <div class="col-12"><div id="orgAddErr" class="text-danger fs-7 d-none"></div></div>
            </div></div>
            <div class="modal-footer flex-center"><button class="btn btn-light" data-bs-dismiss="modal">@L("إلغاء", "Cancel")</button><button class="btn btn-primary" id="orgAddSave">@L("حفظ", "Save")</button></div>
        </div></div>
    </div>
}

@section Scripts {
<script>
(function () {
    // Search: highlight matching people/units and scroll to the first one.
    var input = document.getElementById('orgSearch');
    if (input) input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase(), first = null;
        document.querySelectorAll('[data-org-node]').forEach(function (el) {
            var hit = q && (el.getAttribute('data-org-text') || '').toLowerCase().indexOf(q) !== -1;
            el.classList.toggle('hit', !!hit);
            if (hit && !first) first = el;
        });
        if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
    });

    var modalEl = document.getElementById('orgAddModal');
    if (!modalEl) return;
    var parentId = null, parentNode = null;
    document.addEventListener('click', function (e) {
        var add = e.target.closest('[data-org-add]'); if (!add) return;
        e.preventDefault();
        parentId = add.getAttribute('data-org-add');
        parentNode = add.closest('li');
        document.getElementById('orgAddParent').textContent = add.getAttribute('data-org-add-name');
        ['orgAddAr', 'orgAddEn', 'orgAddNotes'].forEach(function (id) { document.getElementById(id).value = ''; });
        document.getElementById('orgAddErr').classList.add('d-none');
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    });
    document.getElementById('orgAddSave').addEventListener('click', function () {
        var ar = document.getElementById('orgAddAr').value.trim(), en = document.getElementById('orgAddEn').value.trim();
        var err = document.getElementById('orgAddErr');
        if (!ar || !en) { err.textContent = '@L("الاسم بالعربي والإنجليزي مطلوبان", "Both the Arabic and English names are required")'; err.classList.remove('d-none'); return; }
        var body = new URLSearchParams({ parentId: parentId, nameAr: ar, nameEn: en, notes: document.getElementById('orgAddNotes').value, __RequestVerificationToken: '@token' });
        fetch('@Url.Action("AddHierarchicalItem", "Admin")', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' }, body: body })
            .then(function (r) { return r.json().catch(function () { return { success: false }; }); })
            .then(function (res) {
                if (!res || !res.success) { err.textContent = (res && res.message) || '@L("تعذر الحفظ", "Could not save")'; err.classList.remove('d-none'); return; }
                // Insert the new unit in place — a mutation never reloads the page.
                var ul = parentNode.querySelector(':scope > ul');
                if (!ul) { ul = document.createElement('ul'); parentNode.appendChild(ul); }
                var li = document.createElement('li');
                var name = '@(isAr ? "ar" : "en")' === 'ar' ? ar : en;
                li.innerHTML = '<div class="org-node unit" data-org-node="' + res.itemId + '" data-org-text=""><i class="ki-outline ki-abstract-26 fs-2 text-primary"></i><span class="org-name"></span><span class="org-sub">@L("إدارة", "Department")</span></div>';
                li.querySelector('.org-name').textContent = name;
                li.querySelector('[data-org-node]').setAttribute('data-org-text', ar + ' ' + en);
                ul.appendChild(li);
                bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                if (window.toastr) toastr.success('@L("أُضيفت الوحدة", "Unit added")');
            })
            .catch(function () { err.textContent = '@L("تعذر الحفظ", "Could not save")'; err.classList.remove('d-none'); });
    });
})();
</script>
}
