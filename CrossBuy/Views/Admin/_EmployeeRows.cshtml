@model CrossBuy.Controllers.AdminController.EmployeeRowsModel
@{
    // One page of the employee directory (AdminController.EmployeesData), injected by cbServerList.
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Pick(string? ar, string? en) => isAr ? (string.IsNullOrWhiteSpace(ar) ? en ?? "" : ar) : (string.IsNullOrWhiteSpace(en) ? ar ?? "" : en);
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
    var today = DateTime.Today;
}
@foreach (var e in Model.Rows)
{
    var name = Pick(e.FullName, e.FullNameEn);
    var photo = CrossBuy.BL.Platform.EmployeePhotos.Web(e.ProfileImage);
    var years = e.DateOfJoining.HasValue ? Math.Max(0, (today - e.DateOfJoining.Value.Date).TotalDays / 365.25) : (double?)null;
    <tr>
        <td class="ps-4">
            <div class="d-flex align-items-center min-w-0">
                <div class="symbol symbol-40px symbol-circle flex-shrink-0">
                    @if (photo != null) { <img src="@photo" alt="" /> } else { <span class="symbol-label fw-bold hr-initials">@Initials(e.FullNameEn ?? e.FullName)</span> }
                </div>
                <div class="d-flex flex-column ms-3 min-w-0">
                    <a href="@Url.Action("EmployeeProfile", "Admin", new { id = e.ID })" class="text-gray-900 text-hover-primary fs-6 fw-bold text-truncate"><bdi>@name</bdi></a>
                    <span class="text-muted fw-semibold fs-7 text-truncate">@Pick(e.JobTitleAr, e.JobTitleEn)</span>
                </div>
            </div>
        </td>
        <td class="text-nowrap">@Pick(e.BranchAr, e.BranchEn)</td>
        <td>@Pick(e.CountryAr, e.CountryEn)</td>
        <td class="text-nowrap">
            @if (e.DateOfJoining.HasValue)
            {
                <span class="hr-num">@e.DateOfJoining.Value.ToString("yyyy-MM-dd")</span>
                <div class="text-muted fs-8"><span class="hr-num">@years!.Value.ToString("0.0")</span> @L("سنة", "yrs")</div>
            }
            else { <span class="text-gray-300">—</span> }
        </td>
        <td class="fs-7 d-none d-xxl-table-cell">
            @if (!string.IsNullOrWhiteSpace(e.Email)) { <div class="text-gray-700 text-truncate hr-num" style="max-width:200px">@e.Email</div> }
            @if (!string.IsNullOrWhiteSpace(e.PhoneNumber)) { <div class="text-muted hr-num">@e.PhoneNumber</div> }
        </td>
        <td>
            @if (e.IsActive) { <span class="badge badge-light-success fw-bold fs-8">@L("على رأس العمل", "Active")</span> }
            else { <span class="badge badge-light fw-bold fs-8">@L("غير نشط", "Inactive")</span> }
        </td>
        <td class="pe-4 text-end text-nowrap">
            <a href="@Url.Action("EmployeeProfile", "Admin", new { id = e.ID })" class="btn btn-icon btn-light btn-sm me-1" title="@L("فتح الملف", "Open file")"><i class="ki-outline ki-profile-circle fs-4"></i></a>
            <a href="@Url.Action("HrDocuments", "Admin", new { employeeId = e.ID })" class="btn btn-icon btn-light btn-sm" title="@L("الوثائق والعقود", "Documents & contracts")"><i class="ki-outline ki-document fs-4"></i></a>
        </td>
    </tr>
}
