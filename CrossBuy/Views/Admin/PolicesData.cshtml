				<script>
					/* Policies AJAX: save (POST) + reload (GET) + toastr */
					/* Comments are in English only. */
					(function ($) {
						if (!$) return;

						// --- endpoints ---
						var endpointSave = '@Url.Action("SaveMainPolices", "Admin", new { area = "Admin" })';
						var endpointGet  = '@Url.Action("GetPolicy", "Admin", new { area = "Admin" })';

						// --- elements ---
						var $form       = $('#kt_account_profile_details_form');
						var $btnSubmit1 = $('#kt_ecommerce_add_category_submit');
						var $btnSubmit2 = $('#kt_account_profile_details_submit');
						var $btnSave    = $('#btnSavePolicy');
						var busy = false;

						// --- notifications ---
						function ok(msg){ if (window.toastr) toastr.success(msg); else alert(msg); }
						function err(msg){ if (window.toastr) toastr.error(msg); else alert(msg); }

						// Case-insensitive field getter
						function get(obj, Upper, lower) {
							return (obj && (obj[Upper] != null ? obj[Upper] : obj[lower]));
						}

						// --- helpers ---
						function applyToForm(item) {
							if (!item) return;

							var id     = parseInt(get(item, 'ID', 'id') || 0, 10) || 0;
							var nameAr = get(item, 'NameAr', 'nameAr') || '';
							var nameEn = get(item, 'NameEn', 'nameEn') || '';
							var notes  = get(item, 'Notes',  'notes')  || '';

							$('[name="ID"]').val(id);
							$('[name="NameAr"]').val(nameAr);
							$('[name="NameEn"]').val(nameEn);
							$('[name="Notes"]').val(notes);
						}

						function gatherModel() {
							return {
								ID: parseInt(($('[name="ID"]').val() || '0'), 10) || 0,
								NameAr: ($('[name="NameAr"]').val() || '').trim(),
								NameEn: ($('[name="NameEn"]').val() || '').trim(),
								Notes:  ($('[name="Notes"]').val()  || '').trim()
							};
						}

						function getToken() {
							return $form.find('input[name="__RequestVerificationToken"]').val() || '';
						}

						function lockBtn($btn, labelHtml) {
							if (!$btn || !$btn.length) return { restore: function(){} };
							var old = $btn.html();
							$btn.prop('disabled', true)
								.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' + (labelHtml || old));
							return { restore: function(){ $btn.prop('disabled', false).html(old); } };
						}

						function updateUrlId(id) {
							if (!id) return;
							var u = new URL(window.location.href);
							u.searchParams.set('id', String(id));
							window.history.replaceState({}, '', u.toString());
						}

						function loadById(id) {
							if (!id) return $.Deferred().resolve().promise();
							return $.ajax({
								url: endpointGet + '?id=' + id,
								type: 'GET',
								dataType: 'json'
							}).done(function (res) {
								if (res && res.ok && res.data && res.data.item) applyToForm(res.data.item);
							});
						}

						// --- save ---
						function save(model, $btnToLock) {
							if (busy) return;
							busy = true;

							if (!model.NameAr || !model.NameEn) {
								err('@Localizer["Arabic name and English name are required."]');
								busy = false; return;
							}

							var lock = lockBtn(($btnToLock && $btnToLock.length) ? $btnToLock : $btnSubmit1, '@CrossBuy.Resources.SharedResources.Save');
							var token = getToken();

							var req = (window.Ajax && typeof Ajax.sendJson === 'function')
								? Ajax.sendJson(endpointSave, model)              // send model directly
								: $.ajax({
									url: endpointSave,
									type: 'POST',
									data: JSON.stringify(model),
									contentType: 'application/json; charset=utf-8',
									dataType: 'json',
									headers: token ? { 'RequestVerificationToken': token } : {}
								});

							req.done(function (res) {
								if (res && res.ok) {
									// Fill immediately from echo
									if (res.data && res.data.item) applyToForm(res.data.item);

									// Safe id extraction (supports string/number and camel/pascal case)
									var id = 0;
									if (res && res.data) {
										var item = res.data.item || {};
										var rawId = (res.data.id != null ? res.data.id : (item.ID != null ? item.ID : item.id));
										id = parseInt(rawId, 10) || 0;
									}

									if (id) updateUrlId(id);

									// Reload from DB to reflect canonical values, then success toast
									loadById(id).always(function () {
										ok(res.message || '@CrossBuy.Resources.SharedResources.Success');
									});
								} else {
									var msg = (res && res.message) || '@Localizer["Save failed."]';
									if (res && res.errors && Array.isArray(res.errors) && res.errors.length) {
										msg += '\n- ' + res.errors.join('\n- ');
									}
									err(msg);
								}
							}).fail(function (xhr) {
								var msg = '@Localizer["An error occurred during the request."]';
								try { var j = xhr.responseJSON; if (j && j.message) msg = j.message; } catch(e){}
								err(msg);
							}).always(function () {
								lock.restore();
								busy = false;
							});
						}

						// --- bindings ---
						$form.on('submit', function (e) {
							e.preventDefault();
							var model = gatherModel();
							var $active = $(document.activeElement).closest('button[type="submit"]');
							save(model, $active.length ? $active : $btnSubmit1);
						});

						if ($btnSave.length) {
							$btnSave.on('click', function (e) {
								e.preventDefault();
								save(gatherModel(), $btnSave);
							});
						}

						// --- preload on page open if id exists ---
						(function () {
							var u = new URL(window.location.href);
							var id = parseInt(u.searchParams.get('id') || '0', 10);
							if (id) loadById(id);
						})();

						// --- toastr defaults (optional) ---
						if (window.toastr) {
							toastr.options = {
								closeButton: true,
								progressBar: true,
								newestOnTop: true,
								timeOut: 3000,
								positionClass: 'toast-top-center'
							};
						}
					})(window.jQuery);
				</script>






			</div>
			<!--end::Content-->

		</div>
		<!--end::Content container-->
	</div>
	<!--end::Content-->
