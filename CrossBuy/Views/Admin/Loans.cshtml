@model CrossBuy.Controllers.AdminController.LoansPageModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    // HR prototype design (design-output/hr-prototype #/loans), adopted by the owner on 2026-11-08 — HR4.
    ViewData["Title"] = "Loans";
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal v) => v.ToString("N3", inv);
    var cap = Model.Cap;
    var next = DateTime.Today.AddMonths(1);
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("القروض والسلف", "Loans & advances")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index", "Admin")" class="text-muted text-hover-primary">@SR["HumanResources"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@L("الرواتب والمستحقات", "Pay & entitlements")</li>
                </ul>
            </div>
            @if (Model.CanManage && Model.HasLoanAccount) { <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#loanModal"><i class="ki-outline ki-plus fs-4"></i>@L("قرض أو سلفة", "Loan or advance")</button> }
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            @if (TempData["HrErr"] is string err) { <div class="alert alert-danger d-flex align-items-center py-3 mb-5"><i class="ki-outline ki-information-5 fs-2 me-3 text-danger"></i>@err</div> }
            @if (TempData["HrMsg"] is string msg) { <div class="alert alert-primary d-flex align-items-center py-3 mb-5"><i class="ki-outline ki-check-circle fs-2 me-3 text-primary"></i>@msg</div> }

            <div class="hr-notice mb-5">
                <i class="ki-outline ki-shield-tick fs-2"></i>
                <div class="flex-grow-1"><div class="fw-bold">@L("سقف الاستقطاع القانوني", "Legal deduction cap") <span class="badge badge-light-primary hr-num ms-1">@cap.Pct.ToString("0.##", inv)%</span> @if (!string.IsNullOrWhiteSpace(cap.Reference)) { <span class="text-muted fs-8 ms-1">@cap.Reference</span> }</div>
                <div class="fs-7">@L("مجموع أقساط الموظف لا يتجاوز هذه النسبة من أجره (" + (cap.OnBasic ? "الأساسي" : "الإجمالي") + "). عند المنح يرفض النظام القسط الأكبر ويقترح أكبر قسط مسموح ومدته؛ وفي الرواتب يُخصم القسط في حدود السقف وصافي الراتب، والباقي يبقى مستحقاً. النسبة إعداد في حزمة قواعد الدولة.",
                    "An employee's instalments together may not exceed this share of the " + (cap.OnBasic ? "basic" : "total") + " wage. When granting, a larger instalment is refused with the largest allowed one and its term; in payroll the instalment is taken within the cap and the net pay, and the rest stays outstanding. The figure is a setting of the country rule pack.")</div></div>
            </div>
            @if (!Model.HasLoanAccount)
            {
                <div class="hr-notice mb-5"><i class="ki-outline ki-information-5 fs-2"></i><div><div class="fw-bold">@L("حساب سلف الموظفين غير معرّف", "No employee-loans account")</div><div class="fs-7">@L("عرّف قاعدة الترحيل «الرواتب / EmployeeLoans» لهذه الشركة قبل منح القروض.", "Define the posting rule Payroll / EmployeeLoans for this company before granting loans.")</div></div></div>
            }

            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] { (L("قروض وسلف نشطة", "Active loans & advances"), Model.ActiveCount.ToString(inv), "ki-wallet"),
                                           (L("المتبقي على الموظفين", "Outstanding"), Money(Model.OutstandingTotal) + " " + Model.Currency, "ki-bank"),
                                           (L("أقساط الشهر", "Monthly instalments"), Money(Model.MonthlyInstalments) + " " + Model.Currency, "ki-calendar") })
                {
                    <div class="col-sm-6 col-xl-4"><div class="card card-flush h-100"><div class="card-body py-5">
                        <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div><i class="ki-outline @s.Item3 fs-2 text-gray-400"></i></div>
                        <div class="fs-2 fw-bold text-gray-900"><span class="hr-num">@s.Item2</span></div>
                    </div></div></div>
                }
            </div>

            @{ var toPay = ViewBag.AdvancesToPay as List<CrossBuy.Controllers.AdminController.AdvanceToPay> ?? new(); }
            @if (toPay.Count > 0)
            {
                @* HR9: self-service advance requests approved by the chain, waiting for payroll to pay them out *@
                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                        <span class="fw-bold text-gray-900 fs-4">@L("سلف معتمدة بانتظار الصرف", "Approved advances awaiting payment") <span class="badge badge-light-primary ms-1 hr-num">@toPay.Count</span></span>
                        <span class="text-muted fs-7 mt-1">@L("طلبها الموظفون من بوابتهم واعتمدها مديروهم. الصرف يرحّل القيد ويبدأ الخصم من الشهر المختار.", "Requested by employees from self-service and approved by their managers. Paying posts the entry and starts the deduction from the chosen month.")</span></div></div>
                    <div class="card-body pt-2"><div class="table-responsive">
                        <table class="table align-middle gy-3 mb-0 hr-table">
                            <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-4">@L("الموظف", "Employee")</th><th class="text-end">@L("المبلغ", "Amount")</th><th class="text-end">@L("القسط", "Instalment")</th><th>@L("اعتُمدت", "Approved")</th><th class="pe-4 text-end"></th></tr></thead>
                            <tbody class="fs-6">
                                @foreach (var a in toPay)
                                {
                                    <tr><td class="ps-4"><a href="@Url.Action("EmployeeProfile", "Admin", new { id = a.EmployeeId })" class="text-gray-900 text-hover-primary fw-bold fs-7"><bdi>@(a.Name ?? "—")</bdi></a>@if (!string.IsNullOrWhiteSpace(a.Reason)) { <div class="text-muted fs-8">@a.Reason</div> }</td>
                                        <td class="text-end hr-num">@Money(a.Amount)</td><td class="text-end hr-num">@Money(a.Installment)</td><td class="hr-num">@(a.ApprovedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                        <td class="pe-4 text-end">
                                            @if (Model.CanManage && Model.HasLoanAccount)
                                            {
                                                <form asp-action="PayAdvanceRequest" method="post" class="d-inline-flex gap-2 align-items-center" data-cb-confirm data-cb-action="generic" data-cb-text="@L("صرف السلفة وترحيل قيدها؟", "Pay the advance and post its entry?")">
                                                    @Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@a.RequestId" />
                                                    <input type="month" name="firstMonth" required value="@next.ToString("yyyy-MM")" class="form-control form-control-solid form-control-sm w-auto" title="@L("يبدأ الخصم من راتب", "First deduction in")" />
                                                    <select name="paidFromAccountId" class="form-select form-select-solid form-select-sm w-auto" required>@foreach (var acc in Model.PayFrom) { <option value="@acc.Id">@acc.Code — @acc.Name</option> }</select>
                                                    <button class="btn btn-sm btn-primary text-nowrap"><i class="ki-outline ki-wallet fs-4"></i>@L("صرف", "Pay")</button>
                                                </form>
                                            }
                                        </td></tr>
                                }
                            </tbody>
                        </table>
                    </div></div>
                </div>
            }

            <div class="card mb-5">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0">
                        <span class="fw-bold text-gray-900 fs-4">@L("القروض والسلف", "Loans & advances")</span>
                        <span class="text-muted fs-7 mt-1"><span id="resultCount">—</span></span>
                    </div>
                    <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@L("ابحث بالموظف أو الرقم أو السبب…", "Search employee, number or reason…")" /></div>
                        <select id="f_status" class="form-select form-select-solid form-select-sm w-auto cb-filter"><option value="">@L("كل الحالات", "All statuses")</option><option value="Active">@L("نشط", "Active")</option><option value="Settled">@L("مسدَّد", "Settled")</option></select>
                        <select id="f_size" class="form-select form-select-solid form-select-sm w-auto"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@L("إعادة ضبط", "Reset")"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-4">
                    <div class="table-responsive">
                        <table class="table align-middle gy-3 mb-0 hr-table">
                            <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                <th class="ps-4">@L("الرقم", "No.")</th><th>@L("الموظف", "Employee")</th><th class="text-end">@L("المبلغ", "Amount")</th><th class="text-end">@L("القسط", "Instalment")</th><th>@L("من الأجر", "Of wage")</th><th style="min-width:150px">@L("المتبقي", "Remaining")</th><th>@L("يبدأ الخصم", "Deducted from")</th><th class="pe-4 text-end">@L("الحالة", "Status")</th>
                            </tr></thead>
                            <tbody class="fs-6" id="rows"></tbody>
                        </table>
                    </div>
                    <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ التحميل…", "Loading…")</div>
                    <div class="text-center text-muted py-10 d-none" id="emptyRow">@L("لا قروض أو سلف", "No loans or advances")</div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.CanManage && Model.HasLoanAccount)
{
    <div class="modal fade" id="loanModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered mw-650px">
            <div class="modal-content">
                <form asp-action="CreateLoan" method="post" data-cb-confirm data-cb-action="generic" data-cb-text="@L("منح القرض وترحيل قيد صرفه من الحساب المختار؟", "Grant the loan and post its payment from the chosen account?")">
                    @Html.AntiForgeryToken()
                    <div class="modal-header"><h2 class="fw-bold fs-3">@L("قرض أو سلفة جديدة", "New loan or advance")</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
                    <div class="modal-body py-8 px-9">
                        <div class="mb-6"><label class="form-label required">@L("الموظف", "Employee")</label>
                            <select name="employeeId" class="form-select form-select-solid" data-person-select required><option value=""></option>@foreach (var e in Model.Employees) { <option value="@e.Id" data-photo="@e.Photo" data-initials="@e.Initials">@e.Name</option> }</select></div>
                        <div class="row g-5 mb-6">
                            <div class="col-md-4"><label class="form-label required">@L("النوع", "Kind")</label>
                                <select name="kind" class="form-select form-select-solid"><option value="Advance">@L("سلفة راتب", "Salary advance")</option><option value="Loan">@L("قرض شخصي", "Personal loan")</option></select></div>
                            <div class="col-md-4"><label class="form-label required">@L("المبلغ", "Amount")</label><input type="number" name="principal" step="0.001" min="0.001" required class="form-control form-control-solid hr-num" /></div>
                            <div class="col-md-4"><label class="form-label required">@L("القسط الشهري", "Monthly instalment")</label><input type="number" name="installment" step="0.001" min="0.001" required class="form-control form-control-solid hr-num" /></div>
                        </div>
                        <div class="row g-5 mb-6">
                            <div class="col-md-4"><label class="form-label required">@L("يبدأ الخصم من راتب", "First deduction in")</label><input type="month" name="firstMonth" required value="@next.ToString("yyyy-MM")" class="form-control form-control-solid" /></div>
                            <div class="col-md-4"><label class="form-label required">@L("تاريخ الصرف", "Paid on")</label><input type="date" name="disbursedOn" required value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-solid" /></div>
                            <div class="col-md-4"><label class="form-label required">@L("يُصرف من", "Paid from")</label>
                                <select name="paidFromAccountId" class="form-select form-select-solid" required>@foreach (var a in Model.PayFrom) { <option value="@a.Id">@a.Code — @a.Name</option> }</select></div>
                        </div>
                        <div><label class="form-label">@L("السبب", "Reason")</label><input name="reason" maxlength="400" class="form-control form-control-solid" /></div>
                        <div class="form-text mt-3">@L("يُرحَّل قيد الصرف فوراً (مدين: سلف وقروض الموظفين، دائن: الحساب المختار)، ويُخصم القسط تلقائياً من رواتب الأشهر التالية حتى السداد.", "The payment is posted at once (Dr employee loans & advances, Cr the chosen account), and the instalment is deducted automatically from each payroll until repaid.")</div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@L("منح", "Grant")</button></div>
                </form>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_PersonSelect")
}

@section Scripts {
<script src="~/Backend-assets/js/crossbuy-tagify.js" asp-append-version="true"></script>
<script>
cbServerList({
    url: '@Url.Action("LoansData", "Admin")',
    isAr: @(isAr ? "true" : "false"),
    addParams: function (p) { var st = document.getElementById('f_status'); if (st && st.value !== '') p.set('status', st.value); },
    onReset: function () { var st = document.getElementById('f_status'); if (st) st.value = ''; }
});
</script>
}
