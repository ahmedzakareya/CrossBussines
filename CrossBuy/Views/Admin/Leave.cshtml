@model CrossBuy.Controllers.AdminController.LeavePageModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    // HR prototype design (design-output/hr-prototype #/leave), adopted by the owner on 2026-11-08.
    ViewData["Title"] = "Leave";
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Pick(string? ar, string? en) => (isAr ? (string.IsNullOrWhiteSpace(ar) ? en : ar) : (string.IsNullOrWhiteSpace(en) ? ar : en)) ?? "—";
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
    var m = Model.Month;
    int days = DateTime.DaysInMonth(m.Year, m.Month);
    var monthsAr = new[] { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var monthsEn = new[] { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    string MonthName(DateTime d) => (isAr ? monthsAr[d.Month] : monthsEn[d.Month]) + " " + d.Year;
    var weekend = ViewBag.Weekend as HashSet<DayOfWeek> ?? new HashSet<DayOfWeek> { DayOfWeek.Friday, DayOfWeek.Saturday };
    bool Weekend(DateTime d) => weekend.Contains(d.DayOfWeek);   // the company's weekend, from its country rule pack
    var dayNamesAr = new Dictionary<DayOfWeek, string> { [DayOfWeek.Saturday] = "السبت", [DayOfWeek.Sunday] = "الأحد", [DayOfWeek.Monday] = "الاثنين", [DayOfWeek.Tuesday] = "الثلاثاء", [DayOfWeek.Wednesday] = "الأربعاء", [DayOfWeek.Thursday] = "الخميس", [DayOfWeek.Friday] = "الجمعة" };
    var weekendLabel = string.Join(isAr ? " و" : " / ", weekend.OrderBy(d => ((int)d + 1) % 7).Select(d => isAr ? dayNamesAr[d] : d.ToString().Substring(0, 3)));
    var calRows = Model.Requests.Where(r => r.Status != 2 && r.Start.Date <= m.AddMonths(1).AddDays(-1) && r.End.Date >= m).OrderBy(r => r.Start).ToList();
    bool IsSick(string? en) => (en ?? "").Contains("sick", StringComparison.OrdinalIgnoreCase) || (en ?? "").Contains("medical", StringComparison.OrdinalIgnoreCase);
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />

@{
    void Person(int id, string? name, string? sub)
    {
        var photo = Model.Photos.TryGetValue(id, out var ph) ? ph : null;
        <div class="d-flex align-items-center min-w-0">
            <div class="symbol symbol-30px symbol-circle flex-shrink-0">
                @if (photo != null) { <img src="@photo" alt="" /> } else { <span class="symbol-label fw-bold fs-9 hr-initials">@Initials(name)</span> }
            </div>
            <div class="d-flex flex-column ms-2 min-w-0">
                <a href="@Url.Action("EmployeeProfile", "Admin", new { id })" class="text-gray-900 text-hover-primary fw-bold fs-7 text-truncate"><bdi>@(name ?? "—")</bdi></a>
                @if (!string.IsNullOrWhiteSpace(sub)) { <span class="text-muted fs-8 text-truncate">@sub</span> }
            </div>
        </div>
    }
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("الإجازات", "Leave")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index", "Admin")" class="text-muted text-hover-primary">@SR["HumanResources"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@L("الإجازات والحضور", "Leave & attendance")</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("LeaveTypesList", "Admin")" class="btn btn-sm btn-light"><i class="ki-outline ki-setting-2 fs-4"></i>@L("أنواع الإجازات", "Leave types")</a>
                <a href="@Url.Action("Index", "Approvals")" class="btn btn-sm btn-primary"><i class="ki-outline ki-notification-status fs-4"></i>@L("صندوق الموافقات", "Approvals inbox")</a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] { (L("قيد الموافقة", "Pending approval"), Model.Pending, "ki-time", Model.Pending > 0 ? "text-primary" : "text-gray-900"),
                                           (L("في إجازة اليوم", "On leave today"), Model.OnLeaveToday, "ki-calendar-tick", "text-gray-900"),
                                           (L("طلبات معتمدة هذا العام", "Approved this year"), Model.ApprovedThisYear, "ki-check-circle", "text-success"),
                                           (L("أيام إجازة معتمدة هذا العام", "Approved days this year"), Model.DaysThisYear, "ki-calendar", "text-gray-900") })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                        <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div><i class="ki-outline @s.Item3 fs-2 text-gray-400"></i></div>
                        <div class="fs-2hx fw-bold @s.Item4"><span class="hr-num">@s.Item2</span></div>
                    </div></div></div>
                }
            </div>

            @* ── Requests ── *@
            <div class="card mb-5">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0">
                        <span class="fw-bold text-gray-900 fs-4">@L("الطلبات", "Requests")</span>
                        <span class="text-muted fs-7 mt-1">@L("المعلّقة كلها، وآخر ١٢٠ يوماً", "Every pending request, and the last 120 days") · <span id="resultCount">—</span></span>
                    </div>
                    <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@L("ابحث بالموظف أو النوع أو المعتمِد…", "Search employee, type or approver…")" /></div>
                        <select id="f_status" class="form-select form-select-solid form-select-sm w-auto cb-filter"><option value="">@L("كل الحالات", "All statuses")</option><option value="0">@L("قيد الموافقة", "Pending")</option><option value="1">@L("معتمدة", "Approved")</option><option value="2">@L("مرفوضة", "Rejected")</option></select>
                        <select id="f_size" class="form-select form-select-solid form-select-sm w-auto"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@L("إعادة ضبط", "Reset")"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-4">
                    <div class="table-responsive">
                        <table class="table align-middle gy-3 mb-0 hr-table">
                            <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                <th class="ps-4">@L("الموظف", "Employee")</th><th>@L("النوع", "Type")</th><th>@L("الفترة", "Period")</th><th class="text-end">@L("أيام", "Days")</th><th>@L("الحالة", "Status")</th><th class="pe-4">@L("أين وصل", "Where it is")</th>
                            </tr></thead>
                            <tbody class="fs-6" id="rows"></tbody>
                        </table>
                    </div>
                    <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ التحميل…", "Loading…")</div>
                    <div class="text-center text-muted py-10 d-none" id="emptyRow">@L("لا طلبات مطابقة", "No matching requests")</div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>

            @* ── Team calendar ── *@
            <div class="card mb-5">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0">
                        <span class="fw-bold text-gray-900 fs-4">@L("تقويم الفريق", "Team calendar") — @MonthName(m)</span>
                    </div>
                    <div class="card-toolbar gap-2">
                        <a href="@Url.Action("Leave", "Admin", new { month = m.AddMonths(-1).ToString("yyyy-MM") })" class="btn btn-sm btn-icon btn-light" title="@L("الشهر السابق", "Previous month")"><i class="ki-outline @(isAr ? "ki-arrow-right" : "ki-arrow-left") fs-4"></i></a>
                        <a href="@Url.Action("Leave", "Admin")" class="btn btn-sm btn-light">@L("هذا الشهر", "This month")</a>
                        <a href="@Url.Action("Leave", "Admin", new { month = m.AddMonths(1).ToString("yyyy-MM") })" class="btn btn-sm btn-icon btn-light" title="@L("الشهر التالي", "Next month")"><i class="ki-outline @(isAr ? "ki-arrow-left" : "ki-arrow-right") fs-4"></i></a>
                    </div>
                </div>
                <div class="card-body pt-4">
                    <div class="d-flex flex-wrap gap-5 fs-7 fw-semibold mb-4">
                        <span><span class="lv-swatch lv-annual"></span> @L("معتمدة", "Approved")</span>
                        <span><span class="lv-swatch lv-sick"></span> @L("مرضية", "Sick")</span>
                        <span><span class="lv-swatch lv-pending"></span> @L("قيد الموافقة", "Pending")</span>
                        <span><span class="lv-swatch" style="background:var(--bs-gray-100)"></span> @(weekendLabel + L(" لا تحتسب", " not counted"))</span>
                        <span><span class="lv-swatch" style="background:#F8F5FF"></span> @L("عطلة رسمية لا تحتسب", "Official holiday not counted")</span>
                    </div>
                    @if (calRows.Count == 0)
                    {
                        <div class="text-center text-muted py-10">@L("لا أحد في إجازة هذا الشهر", "Nobody is on leave this month")</div>
                    }
                    else
                    {
                        <div class="overflow-auto">
                            <div class="lv-grid" style="grid-template-columns: 170px repeat(@days, minmax(18px, 1fr)); min-width: 760px;">
                                <div class="hd who">@L("الموظف", "Employee")</div>
                                @for (int d = 1; d <= days; d++)
                                {
                                    var day = new DateTime(m.Year, m.Month, d);
                                    <div class="hd @(Weekend(day) ? "we" : Model.Holidays.Contains(day) ? "hol" : "")"><span class="hr-num">@d</span></div>
                                }
                                @foreach (var r in calRows)
                                {
                                    <div class="who">@{ Person(r.EmployeeId, r.Name, Pick(r.TypeAr, r.TypeEn)); }</div>
                                    @for (int d = 1; d <= days; d++)
                                    {
                                        var day = new DateTime(m.Year, m.Month, d);
                                        var cls = Weekend(day) ? "we" : Model.Holidays.Contains(day) ? "hol" : "";
                                        bool inR = day >= r.Start.Date && day <= r.End.Date;
                                        <div class="@cls">@if (inR && cls == "") { <div class="lv-day @(r.Status == 0 ? "lv-pending" : IsSick(r.TypeEn) ? "lv-sick" : "lv-annual")" title="@Pick(r.TypeAr, r.TypeEn)"></div> }</div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* ── Policies ── *@
            <div class="card mb-5">
                <div class="card-header border-0 pt-6">
                    <div class="card-title flex-column m-0">
                        <span class="fw-bold text-gray-900 fs-4">@L("سياسات الإجازات المطبقة", "Leave policies in use")</span>
                        <span class="text-muted fs-7 mt-1">@L("السياسات المسندة لموظفي شركتك، بنداً بنداً", "The policies assigned to your company's employees, line by line")</span>
                    </div>
                    <div class="card-toolbar"><a href="@Url.Action("Polices", "Admin")" class="btn btn-sm btn-light-primary">@L("إدارة السياسات", "Manage policies")</a></div>
                </div>
                <div class="card-body pt-4">
                    @if (Model.Policies.Count == 0) { <div class="text-center text-muted py-10">@L("لم تُسند أي سياسة إجازات لموظفي شركتك بعد", "No leave policy is assigned to your company's employees yet")</div> }
                    @foreach (var p in Model.Policies)
                    {
                        <div class="d-flex flex-stack mb-3 mt-2">
                            <span class="fw-bold fs-5 text-gray-900">@Pick(p.NameAr, p.NameEn)</span>
                            <span class="badge badge-light-primary fw-bold"><span class="hr-num me-1">@p.Employees</span>@L("موظفاً", "employees")</span>
                        </div>
                        <div class="table-responsive mb-6">
                            <table class="table align-middle gy-3 mb-0 hr-table">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                    <th class="ps-4">@L("النوع", "Type")</th><th class="text-end">@L("أيام في السنة", "Days a year")</th><th class="text-end">@L("القانون", "The law")</th><th class="text-end">@L("الحد الأقصى للترحيل", "Carry-over cap")</th><th class="text-end">@L("مهلة الإشعار (يوم)", "Notice (days)")</th><th class="pe-4 text-end">@L("تقرير طبي", "Medical certificate")</th>
                                </tr></thead>
                                <tbody class="fs-6">
                                    @foreach (var l in p.Lines)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-semibold">@Pick(l.TypeAr, l.TypeEn)</td>
                                            <td class="text-end hr-num fw-bold">@l.Days</td>
                                            <td class="text-end text-nowrap">
                                                @if (l.LawDays is decimal law)
                                                {
                                                    <span class="hr-num text-muted me-1">@law.ToString("0.##")</span>
                                                    @if (l.Days < law) { <span class="badge badge-light-danger fw-bold fs-8" title="@l.LawReference">@L("أقل من القانون", "Below the law")</span> }
                                                    else { <span class="badge badge-light-success fw-bold fs-8" title="@l.LawReference">@L("مطابق", "Compliant")</span> }
                                                }
                                                else { <span class="text-gray-400 fs-8">@L("ليس في الحزمة", "Not in the pack")</span> }
                                            </td>
                                            <td class="text-end hr-num">@l.CarryOver</td>
                                            <td class="text-end hr-num">@l.Notice</td>
                                            <td class="pe-4 text-end">@if (l.Medical) { <span class="badge badge-light-primary fw-bold fs-8">@L("مطلوب", "Required")</span> } else { <span class="text-gray-400">—</span> }</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="hr-notice mb-5">
                <i class="ki-outline ki-information-5 fs-2"></i>
                <div><div class="fw-bold">@L("ما يبقى وما يأتي", "What stays and what is coming")</div>
                <div class="fs-7">@L("الطلب يبقى من بوابة الموظف، والاعتماد من صندوق الموافقات بسلسلته الحالية. القادم: استحقاق شهري؛ أما عطلة نهاية الأسبوع فصارت من حزمة قواعد الدولة.", "Requesting stays in the employee portal, approving in the approvals inbox with its current chain. Coming: monthly accrual; the weekend already comes from the country rule pack.")</div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/Backend-assets/js/crossbuy-tagify.js" asp-append-version="true"></script>
<script>
cbServerList({
    url: '@Url.Action("LeaveData", "Admin")',
    isAr: @(isAr ? "true" : "false"),
    addParams: function (p) { var st = document.getElementById('f_status'); if (st && st.value !== '') p.set('status', st.value); },
    onReset: function () { var st = document.getElementById('f_status'); if (st) st.value = ''; }
});
</script>
}
