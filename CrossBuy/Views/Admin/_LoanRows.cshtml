@model CrossBuy.Controllers.AdminController.LoanRowsModel
@{
    // One page of loans & advances (AdminController.LoansData), injected by cbServerList.
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
}
@foreach (var r in Model.Rows)
{
    var photo = Model.Photos.TryGetValue(r.EmployeeId, out var ph) ? ph : null;
    var over = r.PctOfWage is decimal pw && Model.CapPct > 0 && pw > Model.CapPct;
    var donePct = r.Principal > 0 ? (int)Math.Round(r.Paid * 100m / r.Principal) : 0;
    <tr>
        <td class="ps-4 hr-num text-muted">LN-@r.Id.ToString("0000")</td>
        <td>
            <div class="d-flex align-items-center min-w-0">
                <div class="symbol symbol-30px symbol-circle flex-shrink-0">
                    @if (photo != null) { <img src="@photo" alt="" /> } else { <span class="symbol-label fw-bold fs-9 hr-initials">@Initials(r.Name)</span> }
                </div>
                <div class="d-flex flex-column ms-2 min-w-0">
                    <a href="@Url.Action("EmployeeProfile", "Admin", new { id = r.EmployeeId })" class="text-gray-900 text-hover-primary fw-bold fs-7 text-truncate"><bdi>@(r.Name ?? "—")</bdi></a>
                    <span class="text-muted fs-8 text-truncate">@(r.Kind == "Advance" ? L("سلفة راتب", "Salary advance") : L("قرض شخصي", "Personal loan"))@if (!string.IsNullOrWhiteSpace(r.Reason)) { <text> · @r.Reason</text> }</span>
                </div>
            </div>
        </td>
        <td class="text-end hr-num">@r.Principal.ToString("N3", inv)</td>
        <td class="text-end hr-num">@r.Installment.ToString("N3", inv)</td>
        <td>@if (r.PctOfWage is decimal pct) { <span class="hr-num fw-bold @(over ? "text-danger" : "")">@pct.ToString("0.0", inv)%</span> if (over) { <div><span class="badge badge-light-danger fs-9">@L("يتجاوز السقف", "Above the cap")</span></div> } } else { <span class="text-gray-400">—</span> }</td>
        <td><span class="hr-num">@r.Outstanding.ToString("N3", inv)</span>
            <div class="h-5px w-100 bg-light rounded mt-1"><div class="bg-success rounded h-5px" style="width:@(donePct)%"></div></div></td>
        <td class="hr-num">@($"{r.FirstYear}-{r.FirstMonth:00}")</td>
        <td class="pe-4 text-end">@switch (r.Status)
            {
                case "Active": <span class="badge badge-light-success fw-bold">@L("نشط", "Active")</span> break;
                case "Settled": <span class="badge badge-light fw-bold">@L("مسدَّد", "Settled")</span> break;
                default: <span class="badge badge-light-danger fw-bold">@L("ملغى", "Cancelled")</span> break;
            }</td>
    </tr>
}
