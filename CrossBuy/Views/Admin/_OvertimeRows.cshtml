@model CrossBuy.Controllers.AdminController.OvertimeRowsModel
@{
    // One page of the month's overtime (AdminController.OvertimeData), injected by cbServerList.
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Hm(int m) => CrossBuy.BL.Hr.HrOvertimeService.Hm(m);
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
    var month = Model.Month.ToString("yyyy-MM");
}
@foreach (var r in Model.Rows)
{
    var photo = Model.Photos.TryGetValue(r.EmployeeId, out var ph) ? ph : null;
    var d = r.Decision;
    var yearLeft = Model.YearlyCapMinutes > 0 ? Math.Max(0, Model.YearlyCapMinutes - r.YearApprovedBefore) : (int?)null;
    <tr>
        <td class="ps-4">
            <div class="d-flex align-items-center min-w-0">
                <div class="symbol symbol-30px symbol-circle flex-shrink-0">
                    @if (photo != null) { <img src="@photo" alt="" /> } else { <span class="symbol-label fw-bold fs-9 hr-initials">@Initials(r.Name)</span> }
                </div>
                <a href="@Url.Action("EmployeeProfile", "Admin", new { id = r.EmployeeId })" class="ms-2 text-gray-900 text-hover-primary fw-bold fs-7 text-truncate"><bdi>@r.Name</bdi></a>
            </div>
        </td>
        <td class="text-end hr-num">@(r.Working > 0 ? Hm(r.Working) : "—")</td>
        <td class="text-end hr-num">@(r.RestDay > 0 ? Hm(r.RestDay) : "—")</td>
        <td class="text-end hr-num">@(r.Holiday > 0 ? Hm(r.Holiday) : "—")</td>
        <td class="text-end hr-num">@(yearLeft is int yl ? Hm(yl) : L("بلا سقف", "No cap"))</td>
        <td>
            @if (d == null) { <span class="badge badge-light-primary fw-bold">@L("بانتظار الاعتماد", "Awaiting approval")</span> }
            else if (d.Status == "Approved") { <span class="badge badge-light-primary fw-bold">@L("معتمد", "Approved") <span class="hr-num ms-1">@Hm(d.TotalMinutes)</span></span>@if (d.TotalMinutes < d.RequestedMinutes) { <div class="text-muted fs-8 mt-1">@L("قُصّ بالسقف السنوي من ", "Clipped by the yearly cap from ")<span class="hr-num">@Hm(d.RequestedMinutes)</span></div> } }
            else { <span class="badge badge-light-danger fw-bold">@L("مرفوض", "Rejected")</span> }
        </td>
        <td class="pe-4 text-end text-nowrap">
            @if (Model.CanDecide && !Model.Posted)
            {
                <form asp-action="DecideOvertime" method="post" class="d-inline">
                    @Html.AntiForgeryToken()<input type="hidden" name="employeeId" value="@r.EmployeeId" /><input type="hidden" name="month" value="@month" />
                    <button type="submit" name="approve" value="false" class="btn btn-sm btn-light-danger" data-cb-confirm data-cb-action="reject" data-cb-text="@L("رفض العمل الإضافي لهذا الشهر؟ لن يُصرف.", "Reject this month's overtime? It will not be paid.")"><i class="ki-outline ki-cross fs-4"></i>@L("رفض", "Reject")</button>
                    <button type="submit" name="approve" value="true" class="btn btn-sm btn-light-primary" data-cb-confirm data-cb-action="approve" data-cb-text="@L("اعتماد العمل الإضافي لهذا الشهر في حدود السقف السنوي؟", "Approve this month's overtime within the yearly cap?")"><i class="ki-outline ki-check fs-4"></i>@L("اعتماد", "Approve")</button>
                </form>
            }
            else if (Model.Posted) { <span class="text-muted fs-8">@L("الرواتب مرحّلة", "Payroll posted")</span> }
        </td>
    </tr>
}
