@using CrossBuy.Models.Context.Admin
@model TrainingCourse
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isEdit = Model.ID > 0;
    string d(DateTime? x) => x?.ToString("yyyy-MM-dd") ?? "";
    string nv(decimal v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<form asp-action="SaveTrainingCourse" method="post" class="d-flex flex-column flex-column-fluid" data-cb-confirm data-cb-action="save" data-cb-text="@Localizer["Save course?"]">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ID" value="@Model.ID" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <h1 class="page-heading fw-bold fs-3 m-0">@(isEdit ? Localizer["Edit course"] : Localizer["New course"])</h1>
        <div class="d-flex gap-2"><a href="@Url.Action("TrainingCourses","Admin")" class="btn btn-light">@SR["Back"]</a><button class="btn btn-primary"><i class="ki-outline ki-check fs-2"></i>@SR["Save"]</button></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush"><div class="card-body py-6"><div class="row g-4">
            <div class="col-md-3"><label class="required fw-semibold fs-7 mb-1">@SR["Code"]</label><input name="Code" class="form-control form-control-solid" value="@Model.Code" required /></div>
            <div class="col-md-5"><label class="required fw-semibold fs-7 mb-1">@Localizer["Title"]</label><input name="Title" class="form-control form-control-solid" value="@Model.Title" required /></div>
            <div class="col-md-4"><label class="fw-semibold fs-7 mb-1">@Localizer["Title (EN)"]</label><input name="TitleEn" class="form-control form-control-solid" value="@Model.TitleEn" /></div>
            <div class="col-md-4"><label class="fw-semibold fs-7 mb-1">@Localizer["Provider"]</label><input name="Provider" class="form-control form-control-solid" value="@Model.Provider" /></div>
            <div class="col-md-4"><label class="fw-semibold fs-7 mb-1">@Localizer["Provider"] (EN)</label><input name="ProviderEn" dir="ltr" class="form-control form-control-solid" value="@Model.ProviderEn" /></div>
            <div class="col-md-4"><label class="fw-semibold fs-7 mb-1">@Localizer["Category"]</label><input name="Category" class="form-control form-control-solid" value="@Model.Category" /></div>
            <div class="col-md-2"><label class="fw-semibold fs-7 mb-1">@Localizer["Hours"]</label><input name="Hours" type="number" step="0.5" min="0" class="form-control form-control-solid" value="@nv(Model.Hours)" /></div>
            <div class="col-md-2"><label class="fw-semibold fs-7 mb-1">@Localizer["Cost/seat"]</label><input name="Cost" type="number" step="0.01" min="0" class="form-control form-control-solid" value="@nv(Model.Cost)" /></div>
            <div class="col-md-3"><label class="fw-semibold fs-7 mb-1">@Localizer["Start"]</label><input name="StartDate" type="date" class="form-control form-control-solid" value="@d(Model.StartDate)" /></div>
            <div class="col-md-3"><label class="fw-semibold fs-7 mb-1">@Localizer["End"]</label><input name="EndDate" type="date" class="form-control form-control-solid" value="@d(Model.EndDate)" /></div>
            <div class="col-md-3 d-flex align-items-end"><label class="form-check form-switch form-check-custom"><input type="hidden" name="IsActive" value="false" /><input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /><span class="form-check-label fw-semibold ms-2">@SR["Active"]</span></label></div>
            <div class="col-12"><label class="fw-semibold fs-7 mb-1">@SR["Notes"]</label><textarea name="Notes" class="form-control form-control-solid" rows="2">@Model.Notes</textarea></div>
        </div>
        <div class="text-muted fs-8 mt-3">@Localizer["Cost is informational — not posted to the GL at this stage."]</div>
        </div></div>
    </div></div>
</form>
