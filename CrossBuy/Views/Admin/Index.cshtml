@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model AdminDashboardDto
@{
    // HR prototype design (design-output/hr-prototype #/dashboard), adopted by the owner on 2026-11-08 for every
    // HR screen the prototype shares with the system. Same data as before (AdminController.Index); people are
    // shown with their photo, and nothing here prints — printing goes through Report Studio.
    ViewData["Title"] = "HrDashboard";
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Pick(string? ar, string? en) => (isAr ? (string.IsNullOrWhiteSpace(ar) ? en : ar) : (string.IsNullOrWhiteSpace(en) ? ar : en)) ?? "—";
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
    string? Photo(int id) => Model.Photos.TryGetValue(id, out var p) ? p : null;
    var monthsAr = new[] { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var monthsEn = new[] { "", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    var docTypes = new Dictionary<string, (string ar, string en)>(StringComparer.OrdinalIgnoreCase) {
        ["NationalId"] = ("البطاقة المدنية", "Civil ID"), ["Passport"] = ("جواز السفر", "Passport"), ["Qualification"] = ("المؤهل", "Qualification"),
        ["Contract"] = ("عقد", "Contract"), ["Insurance"] = ("التأمين", "Insurance"), ["WorkPermit"] = ("إذن العمل", "Work permit"), ["Other"] = ("أخرى", "Other"),
        ["Permanent"] = ("عقد دائم", "Permanent contract"), ["FixedTerm"] = ("عقد محدد المدة", "Fixed-term contract"), ["Probation"] = ("عقد تجربة", "Probation contract"), ["PartTime"] = ("عقد دوام جزئي", "Part-time contract") };
    string DocName(string t) => docTypes.TryGetValue(t ?? "", out var v) ? L(v.ar, v.en) : t ?? "";
    var attTotal = Model.AttPresent + Model.AttAbsent + Model.AttLeave;
    int Pct(int v, int of) => of > 0 ? (int)Math.Round(100.0 * v / of) : 0;
    var maxMonth = Math.Max(1, Model.LeaveMonthly.Count == 0 ? 1 : Model.LeaveMonthly.Max(m => m.Count));
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />

@functions {
    static string ChipCls(int days) => days <= 30 ? "badge-light-danger" : days <= 60 ? "badge-light-primary" : "badge-light-secondary";   // urgent·soon·far (no green/amber)
}

@* One person: photo (or initials), name, and a second line. *@
@{
    void Person(int id, string? name, string? sub, bool link = true)
    {
        var photo = Photo(id);
        <div class="d-flex align-items-center min-w-0">
            <div class="symbol symbol-35px symbol-circle flex-shrink-0">
                @if (photo != null) { <img src="@photo" alt="" /> }
                else { <span class="symbol-label fw-bold fs-8 hr-initials">@Initials(name)</span> }
            </div>
            <div class="d-flex flex-column ms-3 min-w-0">
                @if (link && id > 0) { <a href="@Url.Action("EmployeeProfile", "Admin", new { id })" class="text-gray-900 text-hover-primary fw-bold fs-6 text-truncate"><bdi>@(name ?? "—")</bdi></a> }
                else { <span class="text-gray-900 fw-bold fs-6 text-truncate"><bdi>@(name ?? "—")</bdi></span> }
                @if (!string.IsNullOrWhiteSpace(sub)) { <span class="text-muted fs-7 text-truncate">@sub</span> }
            </div>
        </div>
    }
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("لوحة الموارد البشرية", "People dashboard")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">@SR["HumanResources"]</li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@L("نظرة عامة", "Overview")</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Attendance", "Admin")" class="btn btn-sm btn-light"><i class="ki-outline ki-time fs-4"></i>@L("الحضور", "Attendance")</a>
                <a href="@Url.Action("EmployeesList", "Admin")" class="btn btn-sm btn-primary"><i class="ki-outline ki-people fs-4"></i>@L("سجل الموظفين", "Employee directory")</a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            @* ── Headline figures ── *@
            <div class="row g-5 g-xl-8 mb-5">
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@L("الموظفون", "Headcount")</div><i class="ki-outline ki-people fs-2 text-gray-400"></i></div>
                    <div class="fs-2hx fw-bold text-gray-900"><span class="hr-num">@Model.TotalEmployees</span></div>
                    <div class="text-muted fs-7 mt-1"><span class="hr-num">@Model.ActiveEmployees</span> @L("على رأس العمل", "active") · <span class="hr-num">@Model.NewHiresThisYear</span> @L("معيّنون هذا العام", "joined this year")</div>
                </div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@L("وثائق منتهية أو تنتهي خلال 60 يوماً", "Documents expired or due in 60 days")</div><i class="ki-outline ki-shield-cross fs-2 text-gray-400"></i></div>
                    <div class="fs-2hx fw-bold @(Model.ExpiredDocs + Model.ExpiringSoonCount > 0 ? "text-danger" : "text-gray-900")"><span class="hr-num">@(Model.ExpiredDocs + Model.ExpiringSoonCount)</span></div>
                    <div class="text-muted fs-7 mt-1"><span class="hr-num">@Model.ExpiredDocs</span> @L("منتهية", "expired") · <a href="@Url.Action("DocExpiryAlerts", "Admin")">@L("افتح التنبيهات", "Open alerts")</a></div>
                </div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@L("طلبات إجازة معلّقة", "Pending leave requests")</div><i class="ki-outline ki-notification-status fs-2 text-gray-400"></i></div>
                    <div class="fs-2hx fw-bold text-primary"><span class="hr-num">@Model.PendingLeaves</span></div>
                    <div class="text-muted fs-7 mt-1"><span class="hr-num">@Model.ApprovedLeavesYtd</span> @L("معتمدة هذا العام", "approved this year")</div>
                </div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@L("في إجازة اليوم", "On leave today")</div><i class="ki-outline ki-calendar-tick fs-2 text-gray-400"></i></div>
                    <div class="fs-2hx fw-bold text-gray-900"><span class="hr-num">@Model.OnLeaveToday</span></div>
                    <div class="text-muted fs-7 mt-1">@L("من أصل", "of") <span class="hr-num">@Model.ActiveEmployees</span> @L("على رأس العمل", "active")</div>
                </div></div></div>
            </div>

            <div class="row g-5 g-xl-8">
                @* ── Left column ── *@
                <div class="col-xl-6">
                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("التوزيع حسب المسمى الوظيفي", "Headcount by job title")</span>
                            <span class="text-muted fs-7 mt-1">@L("أكبر ستة مسميات", "Top six titles")</span></div></div>
                        <div class="card-body pt-4">
                            <table class="table align-middle gy-3 mb-0 hr-table">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-0">@L("المسمى", "Title")</th><th class="text-end">@L("العدد", "Count")</th><th style="width:45%"></th></tr></thead>
                                <tbody class="fs-6">
                                    @if (Model.ByJobTitle.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-8">@L("لا يوجد موظفون بعد", "No employees yet")</td></tr> }
                                    @foreach (var r in Model.ByJobTitle)
                                    {
                                        <tr><td class="ps-0 fw-semibold">@Pick(r.NameAr, r.NameEn)</td><td class="text-end hr-num fw-bold">@r.Count</td>
                                            <td><div class="d-flex align-items-center gap-2"><div class="progress h-6px w-100 bg-light-primary"><div class="progress-bar bg-primary" style="width:@(r.Pct)%"></div></div><span class="text-muted fs-8 hr-num">@(r.Pct)%</span></div></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("الحضور هذا الشهر", "Attendance this month")</span>
                            <span class="text-muted fs-7 mt-1"><span class="hr-num">@Model.AttWorkDays</span> @L("يوم عمل على مستوى الشركة", "company working days")</span></div>
                            <div class="card-toolbar"><a href="@Url.Action("Attendance", "Admin")" class="btn btn-sm btn-light-primary">@L("الكل", "All")</a></div></div>
                        <div class="card-body pt-4">
                            @foreach (var a in new[] { (L("حضور", "Present"), Model.AttPresent, "bg-primary"), (L("غياب", "Absent"), Model.AttAbsent, "bg-danger"), (L("إجازة", "Leave"), Model.AttLeave, "bg-info") })
                            {
                                <div class="d-flex align-items-center gap-3 mb-4">
                                    <span class="fw-semibold fs-6 w-75px">@a.Item1</span>
                                    <div class="progress h-8px flex-grow-1 bg-light"><div class="progress-bar @a.Item3" style="width:@(Pct(a.Item2, attTotal))%"></div></div>
                                    <span class="hr-num fw-bold w-50px text-end">@a.Item2</span>
                                </div>
                            }
                            <div class="text-muted fs-7">@L("حالات تأخير", "Late arrivals"): <span class="hr-num fw-bold text-gray-800">@Model.AttLate</span></div>
                        </div>
                    </div>

                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("طلبات الإجازة", "Leave requests")</span>
                            <span class="text-muted fs-7 mt-1">@L("آخر ستة أشهر", "Last six months")</span></div></div>
                        <div class="card-body pt-4">
                            <div class="d-flex align-items-end gap-3" style="height:140px">
                                @foreach (var m in Model.LeaveMonthly)
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-end flex-grow-1 h-100">
                                        <span class="hr-num fs-8 fw-bold text-gray-700 mb-1">@m.Count</span>
                                        <div class="w-100 rounded-top bg-primary" style="height:@(Math.Max(3, 100 * m.Count / maxMonth))px;max-width:36px"></div>
                                        <span class="text-muted fs-8 mt-2">@(isAr ? monthsAr[m.Month] : monthsEn[m.Month])</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Right column ── *@
                <div class="col-xl-6">
                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("أقرب الانتهاءات", "Nearest expiries")</span>
                            <span class="text-muted fs-7 mt-1">@L("وثائق وعقود خلال 60 يوماً", "Documents and contracts within 60 days")</span></div>
                            <div class="card-toolbar"><a href="@Url.Action("DocExpiryAlerts", "Admin")" class="btn btn-sm btn-light-primary">@L("الكل", "All")</a></div></div>
                        <div class="card-body pt-4">
                            <table class="table align-middle gy-3 mb-0 hr-table">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-0">@L("الموظف والوثيقة", "Employee & document")</th><th class="text-end">@L("المتبقي", "Left")</th></tr></thead>
                                <tbody class="fs-6">
                                    @if (Model.ExpiringDocs.Count == 0) { <tr><td colspan="2" class="text-center text-muted py-8">@L("لا شيء ينتهي خلال 60 يوماً", "Nothing expires within 60 days")</td></tr> }
                                    @foreach (var d in Model.ExpiringDocs)
                                    {
                                        <tr><td class="ps-0">@{ Person(d.EmployeeId, d.EmployeeName, DocName(d.Label) + " · " + d.Date.ToString("yyyy-MM-dd")); }</td>
                                            <td class="text-end text-nowrap">
                                                @if (d.DaysLeft < 0) { <span class="badge @ChipCls(d.DaysLeft) fw-bold">@(L("منتهية منذ ", "Expired ") + (-d.DaysLeft) + L(" يوم", " days ago"))</span> }
                                                else { <span class="badge @ChipCls(d.DaysLeft) fw-bold">@(d.DaysLeft + L(" يوم", " days"))</span> }
                                            </td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("المعيّنون خلال آخر 13 شهراً", "Joiners in the last 13 months")</span></div>
                            <div class="card-toolbar"><a href="@Url.Action("EmployeesList", "Admin")" class="btn btn-sm btn-light-primary">@L("الكل", "All")</a></div></div>
                        <div class="card-body pt-4">
                            <table class="table align-middle gy-3 mb-0 hr-table">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-0">@L("الموظف", "Employee")</th><th>@L("تاريخ التعيين", "Joined")</th><th class="text-end">@L("الحالة", "Status")</th></tr></thead>
                                <tbody class="fs-6">
                                    @if (Model.RecentJoiners.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-8">@L("لا تعيينات حديثة", "No recent joiners")</td></tr> }
                                    @foreach (var p in Model.RecentJoiners)
                                    {
                                        <tr><td class="ps-0">@{ Person(p.Id, p.Name, Pick(p.TitleAr, p.TitleEn)); }</td>
                                            <td class="hr-num text-nowrap">@p.Date.ToString("yyyy-MM-dd")</td>
                                            <td class="text-end">@if (p.Active) { <span class="badge badge-light-primary fw-bold fs-8">@L("على رأس العمل", "Active")</span> } else { <span class="badge badge-light fw-bold fs-8">@L("غير نشط", "Inactive")</span> }</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("آخر طلبات الإجازة", "Recent leave requests")</span></div></div>
                        <div class="card-body pt-4">
                            <table class="table align-middle gy-3 mb-0 hr-table">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-0">@L("الموظف", "Employee")</th><th>@L("الفترة", "Period")</th><th class="text-end">@L("الحالة", "Status")</th></tr></thead>
                                <tbody class="fs-6">
                                    @if (Model.RecentLeaves.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-8">@L("لا طلبات بعد", "No requests yet")</td></tr> }
                                    @foreach (var r in Model.RecentLeaves)
                                    {
                                        <tr><td class="ps-0">@{ Person(r.EmployeeId, r.EmployeeName, Pick(r.TypeAr, r.TypeEn)); }</td>
                                            <td class="text-nowrap"><span class="hr-num">@r.StartDate.ToString("yyyy-MM-dd")</span><div class="text-muted fs-8"><span class="hr-num">@r.Days</span> @L("يوم", "days")</div></td>
                                            <td class="text-end">
                                                @switch (r.Status)
                                                {
                                                    case 1: <span class="badge badge-light-primary fw-bold fs-8">@L("معتمدة", "Approved")</span> break;
                                                    case 2: <span class="badge badge-light-danger fw-bold fs-8">@L("مرفوضة", "Rejected")</span> break;
                                                    case 3: <span class="badge badge-light-info fw-bold fs-8">@L("أُعيدت للمراجعة", "Returned for review")</span> break;
                                                    default: <span class="badge badge-light-secondary fw-bold fs-8">@L("معلّقة", "Pending")</span> break;
                                                }
                                            </td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("العطل الرسمية القادمة", "Upcoming official holidays")</span></div>
                            <div class="card-toolbar"><a href="@Url.Action("HolidaysList", "Admin")" class="btn btn-sm btn-light-primary">@L("الكل", "All")</a></div></div>
                        <div class="card-body pt-4">
                            @if (Model.UpcomingHolidays.Count == 0) { <div class="text-center text-muted py-6">@L("لا عطل مسجلة قادمة", "No upcoming holidays recorded")</div> }
                            @foreach (var h in Model.UpcomingHolidays)
                            {
                                <div class="d-flex flex-stack py-2 border-bottom border-gray-200">
                                    <span class="fw-semibold">@Pick(h.NameAr, h.NameEn)</span>
                                    <span class="hr-num text-muted">@h.Date.ToString("yyyy-MM-dd")</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="hr-notice mb-5">
                <i class="ki-outline ki-printer fs-2"></i>
                <div><div class="fw-bold">@L("الطباعة والتقارير", "Printing and reports")</div>
                <div class="fs-7">@L("هذه الأرقام تُطبع من Report Studio — لا تطبع أي شاشة نفسها.", "These figures print through Report Studio — no screen prints itself.")</div></div>
            </div>
        </div>
    </div>
</div>
