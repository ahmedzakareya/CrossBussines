@model List<CrossBuy.ViewModel.EmployeeListItemDto>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    // HR prototype design (design-output/hr-prototype #/employees), adopted by the owner on 2026-11-08 for every
    // HR screen the prototype shares with the system.
    ViewData["Title"] = "EmployeesList";
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Pick(string? ar, string? en) => isAr ? (string.IsNullOrWhiteSpace(ar) ? en ?? "" : ar) : (string.IsNullOrWhiteSpace(en) ? ar ?? "" : en);
    string Initials(string? name) { var p = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return string.Concat(p.Take(2).Select(w => w[0])).ToUpperInvariant(); }
    var today = DateTime.Today;
    var total = Model.Count;
    var active = Model.Count(e => e.IsActive);
    var newThisYear = Model.Count(e => e.DateOfJoining.HasValue && e.DateOfJoining.Value.Year == today.Year);
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("سجل الموظفين", "Employee directory")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index", "Admin")" class="text-muted text-hover-primary">@SR["HumanResources"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@L("الموظفون والهيكل", "People & organisation")</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("AdministrativeStructure", "Admin")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-abstract-26 fs-4"></i>@L("الهيكل التنظيمي", "Organisation chart")</a>
                <a href="@Url.Action("EmployeeData", "Admin")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-4"></i>@L("موظف جديد", "New employee")</a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] { (L("الموظفون", "Headcount"), total, "ki-people", "text-gray-900", L("في شركتك", "in your company")),
                                           (L("على رأس العمل", "Active"), active, "ki-check-circle", "text-success", ""),
                                           (L("غير نشط", "Inactive"), total - active, "ki-minus-circle", "text-gray-600", ""),
                                           (L("معيّنون هذا العام", "Joined this year"), newThisYear, "ki-user-tick", "text-primary", today.Year.ToString()) })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                        <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div><i class="ki-outline @s.Item3 fs-2 text-gray-400"></i></div>
                        <div class="fs-2hx fw-bold @s.Item4"><span class="hr-num">@s.Item2</span></div>
                        <div class="text-muted fs-8 mt-1">@(string.IsNullOrEmpty(s.Item5) ? " " : s.Item5)</div>
                    </div></div></div>
                }
            </div>

            <div class="card mb-5 mb-xl-8">
                <div class="card-header border-0 pt-6">
                    <div class="card-title align-items-start flex-column m-0">
                        <span class="card-label fw-bold text-gray-900 fs-4">@L("سجل الموظفين", "Employee directory")</span>
                        <span class="text-muted mt-1 fw-semibold fs-7" id="resultCount">—</span>
                    </div>
                    <div class="card-toolbar gap-3">
                        <div class="btn-group" role="group" id="empStatus">
                            <button type="button" class="btn btn-sm btn-light-primary active" data-status="all">@L("الكل", "All")</button>
                            <button type="button" class="btn btn-sm btn-light-primary" data-status="1">@L("على رأس العمل", "Active")</button>
                            <button type="button" class="btn btn-sm btn-light-primary" data-status="0">@L("غير نشط", "Inactive")</button>
                        </div>
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@L("بحث بالاسم أو المسمى أو الفرع أو البريد...", "Search name, title, branch or email...")" /></div>
                        <select id="f_size" class="form-select form-select-solid form-select-sm w-auto"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@L("إعادة ضبط", "Reset")"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-4">
                    <div class="table-responsive">
                        <table class="table align-middle gy-4 mb-0 hr-table" id="empTable">
                            <thead>
                                <tr class="fw-bold fs-8 text-uppercase text-muted">
                                    <th class="ps-4">@L("الموظف", "Employee")</th>
                                    <th>@L("الفرع", "Branch")</th>
                                    <th>@L("الجنسية", "Nationality")</th>
                                    <th>@L("التعيين", "Joined")</th>
                                    <th class="d-none d-xxl-table-cell">@L("التواصل", "Contact")</th>
                                    <th>@L("الحالة", "Status")</th>
                                    <th class="pe-4 text-end"></th>
                                </tr>
                            </thead>
                            <tbody class="fs-6" id="rows"></tbody>
                        </table>
                    </div>
                    <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ التحميل…", "Loading…")</div>
                    <div class="text-center text-muted py-10 d-none" id="emptyRow">@L("لا موظفون مطابقون", "No matching employees")</div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/Backend-assets/js/crossbuy-tagify.js" asp-append-version="true"></script>
<script>
(function () {
    var status = 'all';
    var list = cbServerList({
        url: '@Url.Action("EmployeesData", "Admin")',
        isAr: @(isAr ? "true" : "false"),
        addParams: function (p) { if (status !== 'all') p.set('status', status); }
    });
    document.querySelectorAll('#empStatus [data-status]').forEach(function (b) {
        b.addEventListener('click', function () {
            document.querySelectorAll('#empStatus [data-status]').forEach(function (x) { x.classList.remove('active'); });
            b.classList.add('active'); status = b.getAttribute('data-status'); list.reload();
        });
    });
})();
</script>
}
