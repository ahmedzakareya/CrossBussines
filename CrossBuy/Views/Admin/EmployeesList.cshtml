@model List<CrossBuy.ViewModel.EmployeeListItemDto>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR

@{
    ViewData["Title"] = "EmployeesList";
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">
	<!--begin::Toolbar-->
	<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
		<!--begin::Toolbar container-->
		<div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
			<!--begin::Toolbar wrapper-->
			<div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
				<!--begin::Page title-->
				<div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
					<!--begin::Title-->
					<h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">@Localizer["Employees List"]</h1>
					<!--end::Title-->
					<!--begin::Breadcrumb-->
					<ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
						<li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Admin")" class="text-muted text-hover-primary">@SR["HumanResources"]</a></li>
						<li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
						<li class="breadcrumb-item text-muted">@SR["Employees"]</li>
					</ul>
					<!--end::Breadcrumb-->
				</div>
				<!--end::Page title-->
				<!--begin::Actions-->
				<div class="d-flex align-items-center gap-2 gap-lg-3">
					<button type="button" class="btn btn-sm btn-primary" onclick="redirectToAction()">
						<i class="ki-outline ki-plus fs-2"></i>@CrossBuy.Resources.SharedResources.New
					</button>
					<script>
						function redirectToAction() {
							window.location.href = '/Admin/EmployeeData';
						}
					</script>
				</div>
				<!--end::Actions-->
			</div>
			<!--end::Toolbar wrapper-->
		</div>
		<!--end::Toolbar container-->
	</div>
	<!--end::Toolbar-->
	<!--begin::Content-->
	<div id="kt_app_content" class="app-content flex-column-fluid">
		<!--begin::Content container-->
		<div id="kt_app_content_container" class="app-container container-fluid">
			<!--begin::Products-->
			<div class="card card-flush">
				<!--begin::Card header-->
				<div class="card-header align-items-center py-5 gap-2 gap-md-5">
					<!--begin::Card title-->
					<div class="card-title">
						<!--begin::Search-->
						<div class="d-flex align-items-center position-relative my-1">
							<i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
							<input type="text" id="empSearch" class="form-control form-control-solid w-250px ps-12" placeholder="@Localizer["Search employee"]" />
						</div>
						<!--end::Search-->
					</div>
					<!--end::Card title-->
				</div>
				<!--end::Card header-->
				<!--begin::Card body-->
				<div class="card-body pt-0">
					<!--begin::Table-->
					<div class="table-responsive">
						<table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_ecommerce_products_table">
						<thead>
							<tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
								<th class="w-10px pe-2 ps-4">
									<div class="form-check form-check-sm form-check-custom form-check-solid me-3">
										<input class="form-check-input" type="checkbox" data-kt-check="true" data-kt-check-target="#kt_ecommerce_products_table .form-check-input" value="1" />
									</div>
								</th>
								<th class="min-w-200px">@SR["Employee"]</th>
								<th class="text-end min-w-100px">@CrossBuy.Resources.SharedResources.JobTitle</th>
								<th class="text-end min-w-100px">@CrossBuy.Resources.SharedResources.Companies</th>
								<th class="text-end min-w-100px">@CrossBuy.Resources.SharedResources.Branches</th>
								<th class="text-end min-w-70px">@CrossBuy.Resources.SharedResources.Country</th>
								<th class="text-end min-w-125px">@CrossBuy.Resources.SharedResources.Email</th>
								<th class="text-center min-w-90px">@SR["Status"]</th>
								<th class="text-end min-w-70px">@SR["Actions"]</th>
							</tr>
						</thead>
						<tbody class="fw-semibold text-gray-600">
							@if (Model != null && Model.Count > 0)
							{
								foreach (var emp in Model)
								{
									<tr data-search="@(($"{emp.FullName} {emp.FullNameEn} {emp.Email} {emp.JobTitleAr} {emp.JobTitleEn}").ToLower())">
										<td>
											<div class="form-check form-check-sm form-check-custom form-check-solid ms-3">
												<input class="form-check-input" type="checkbox" value="1" />
											</div>
										</td>
										<td class="d-flex align-items-center">
											<!--begin:: Avatar -->
											<div class="symbol symbol-circle symbol-50px overflow-hidden me-3">
												<a href="@Url.Action("EmployeeData", "Admin", new { id = emp.ID })">
													<div class="symbol-label bg-light-primary">
														<img src="@(string.IsNullOrEmpty(emp.ProfileImage) ? Url.Content("~/Backend-assets/media/svg/avatars/blank.svg") : emp.ProfileImage)"
															 alt="@CrossBuy.BL.EmployeeNames.Of(emp.FullName, emp.FullNameEn)" class="w-100" />
													</div>
												</a>
											</div>
											<!--end::Avatar-->
											<!--begin::User details-->
											@if (isAr)
											{
												<div class="d-flex flex-column">
													<a href="@Url.Action("EmployeeData", "Admin", new { id = emp.ID })" class="text-gray-800 text-hover-primary mb-1 fw-bold">@emp.FullName</a>
													<span class="fw-bold">@emp.FullNameEn</span>
												</div>
											}
											else
											{
												<div class="d-flex flex-column">
													<a href="@Url.Action("EmployeeData", "Admin", new { id = emp.ID })" class="text-gray-800 text-hover-primary mb-1 fw-bold">@emp.FullNameEn</a>
													<span class="fw-bold">@emp.FullName</span>
												</div>
											}
											<!--end::User details-->
										</td>
										<td class="text-end pe-0">
											<span class="fw-bold badge badge-light-primary">@(isAr ? emp.JobTitleAr : DisplayName.Or(emp.JobTitleEn, emp.JobTitleAr))</span>
										</td>
										<td class="text-end pe-0">
											<span class="fw-bold badge badge-light-secondary">@(isAr ? emp.CompanyAr : emp.CompanyEn)</span>
										</td>
										<td class="text-end pe-0">
											<span class="fw-semibold text-gray-700">@(isAr ? emp.BranchAr : emp.BranchEn)</span>
										</td>
										<td class="text-end pe-0">
											<span class="fw-semibold text-gray-700 ms-3">@(isAr ? emp.CountryAr : emp.CountryEn)</span>
										</td>
										<td class="text-end pe-0 text-gray-700">@emp.Email</td>
										<td class="text-center">
											@if (emp.IsActive) { <span class="badge fw-bold" style="background:#E7F0FF;color:#0E4A9E;">@Localizer["Active"]</span> }
											else { <span class="badge badge-light-danger">@Localizer["Inactive"]</span> }
										</td>
										<td class="text-end">
											<!--begin::Icon-->
											<div class="d-flex justify-content-end flex-shrink-0">
												<a href="@Url.Action("EmployeeData", "Admin", new { id = emp.ID })" class="btn btn-icon btn-light-primary btn-sm me-2" title="@SR["Edit"]">
													<i class="ki-outline ki-eye fs-4"></i>
												</a>
												<a href="@Url.Action("HrDocuments", "Admin", new { employeeId = emp.ID })" class="btn btn-icon btn-light-primary btn-sm" title="@Localizer["Documents"]">
													<i class="ki-outline ki-paper-clip fs-4"></i>
												</a>
											</div>
											<!--end::Icon-->
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
					</div>
					<!--end::Table-->
				</div>
				<!--end::Card body-->
			</div>
			<!--end::Products-->
		</div>
		<!--end::Content container-->
	</div>
	<!--end::Content-->
</div>
<!--end::Content wrapper-->

@section Scripts {
<script>
(function () {
    var s = document.getElementById('empSearch');
    if (s) s.addEventListener('input', function () {
        var q = this.value.trim().toLowerCase();
        document.querySelectorAll('#kt_ecommerce_products_table tbody tr').forEach(function (tr) {
            tr.style.display = (!q || (tr.getAttribute('data-search') || '').indexOf(q) >= 0) ? '' : 'none';
        });
    });
})();
</script>
}
