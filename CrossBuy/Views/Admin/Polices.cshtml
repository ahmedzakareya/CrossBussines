          +  '<div class="att-modern-time-step-group"><div class="att-modern-time-step-label"><i class="ki-outline ki-watch fs-6"></i>@Localizer["Minutes"]</div><div class="att-modern-time-step" dir="ltr"><button type="button" class="att-modern-time-btn" data-att-unit="minute" data-att-delta="-1" aria-label="Decrease minutes">−</button><button type="button" class="att-modern-time-btn" data-att-unit="minute" data-att-delta="1" aria-label="Increase minutes">+</button></div></div>'
          +'</div>'
          +'<div class="att-modern-time-quick">'
          +  '<button type="button" class="att-modern-time-chip" data-att-quick="08:00">08:00</button>'
          +  '<button type="button" class="att-modern-time-chip" data-att-quick="09:00">09:00</button>'
          +  '<button type="button" class="att-modern-time-chip" data-att-quick="12:00">12:00</button>'
          +  '<button type="button" class="att-modern-time-chip" data-att-quick="13:00">13:00</button>'
          +  '<button type="button" class="att-modern-time-chip" data-att-quick="17:00">17:00</button>'
          +'</div>'
          +'<div class="att-modern-time-actions">'
          +  '<button type="button" class="att-modern-time-cancel" data-att-tp="close">@SR["Cancel"]</button>'
          +  '<button type="button" class="att-modern-time-apply" data-att-tp="apply">@Localizer["Apply"]</button>'
          +'</div>';
        document.body.appendChild(box);
        box.addEventListener('mousedown',function(e){e.preventDefault();});
        box.addEventListener('pointerdown',function(e){
            var step=e.target.closest('[data-att-unit][data-att-delta]');
            if(!step) return;
            attModernStartHold(step,e);
        });
        ['pointerup','pointercancel','pointerleave','mouseup','touchend','touchcancel'].forEach(function(evt){
            document.addEventListener(evt,attModernStopHold,{passive:true});
        });
        box.addEventListener('click',function(e){
            var step=e.target.closest('[data-att-unit][data-att-delta]');
            var quick=e.target.closest('[data-att-quick]');
            var cmd=e.target.closest('[data-att-tp]');
            var focus=e.target.closest('[data-att-focus]');
            if(step){
                e.preventDefault();
                e.stopPropagation();

                // Pointer/touch press is handled by attModernStartHold().
                // This prevents the browser click from adding an extra step after release.
                if(attModernHold.suppressClick){
                    attModernHold.suppressClick=false;
                    return false;
                }

                // Keyboard activation still works here.
                var unit=step.getAttribute('data-att-unit');
                var delta=parseInt(step.getAttribute('data-att-delta'),10)||0;
                attModernAdjust(unit,delta);
                return false;
            }
            if(quick){e.preventDefault();attModernSetValue(quick.getAttribute('data-att-quick'));attModernMarkQuick(quick.getAttribute('data-att-quick'));return false;}
            if(focus){
                box.querySelectorAll('.att-modern-time-box').forEach(function(x){x.classList.remove('active');});
                focus.classList.add('active');return false;
            }
            if(cmd){
                var c=cmd.getAttribute('data-att-tp');
                if(c==='close') attModernClose(false);
                if(c==='apply') attModernClose(true);
            }
        });
        attModernPicker.el=box;
        return box;
    }
    function attModernRender(){
        var el=attEnsureModernPicker();
        var h=el.querySelector('[data-att-hour]'),m=el.querySelector('[data-att-minute]');
        if(h)h.textContent=attPad(attModernPicker.hour);
        if(m)m.textContent=attPad(attModernPicker.minute);
    }

    function attModernMarkQuick(v){
        var el=attEnsureModernPicker();
        var current=attNormalizeTime(v)||'';
        el.querySelectorAll('[data-att-quick]').forEach(function(btn){
            var btnTime=attNormalizeTime(btn.getAttribute('data-att-quick'));
            btn.classList.toggle('active', !!current && btnTime===current);
        });
    }
    function attModernSetValue(v){
        v=attNormalizeTime(v)||'08:00';
        var p=v.split(':');
        attModernPicker.hour=parseInt(p[0],10)||0;
        attModernPicker.minute=parseInt(p[1],10)||0;
        attModernRender();
        attModernMarkQuick(v);
    }
    function attModernAdjust(part,delta){
        delta=parseInt(delta,10)||0;
        var h=parseInt(attModernPicker.hour,10);
        var m=parseInt(attModernPicker.minute,10);
        if(isNaN(h)) h=0;
        if(isNaN(m)) m=0;

        if(part==='hour'){
            h=(h+delta)%24;
            if(h<0) h+=24;
            attModernPicker.hour=h;
            attModernPicker.minute=m;
        }

        if(part==='minute'){
            // Minutes buttons must change MINUTES ONLY.
            // No carry to hour, no active-box dependency, no RTL dependency.
            m = m + delta;
            if(m < 0) m = 59;
            if(m > 59) m = 0;
            attModernPicker.hour = h;
            attModernPicker.minute = m;
        }

        attModernRender();
        attModernMarkQuick('');
    }
    function attModernOpen(input){
        if(!input) return;
        var el=attEnsureModernPicker();
        attModernPicker.input=input;
        attModernSetValue(input.value||'08:00');
        el.querySelectorAll('.att-modern-time-box').forEach(function(x){x.classList.remove('active');});
        var first=el.querySelector('[data-att-focus="hour"]');if(first)first.classList.add('active');
        el.classList.add('show');
        var r=input.getBoundingClientRect();
        var top=r.bottom+8;
        var left=Math.min(window.innerWidth-el.offsetWidth-12,Math.max(12,r.left+(r.width/2)-(el.offsetWidth/2)));
        if(top+el.offsetHeight>window.innerHeight-12) top=Math.max(12,r.top-el.offsetHeight-8);
        el.style.top=top+'px';
        el.style.left=left+'px';
    }
    function attModernClose(apply){
        attModernStopHold();
        var el=attEnsureModernPicker();
        if(apply && attModernPicker.input){
            attModernPicker.input.value=attPad(attModernPicker.hour)+':'+attPad(attModernPicker.minute);
            attModernPicker.input.dispatchEvent(new Event('input',{bubbles:true}));
            attModernPicker.input.dispatchEvent(new Event('change',{bubbles:true}));
        }else if(attModernPicker.input){
            var fixed=attNormalizeTime(attModernPicker.input.value);
            if(fixed){attModernPicker.input.value=fixed;attModernPicker.input.dispatchEvent(new Event('change',{bubbles:true}));}
        }
        el.classList.remove('show');
        attModernPicker.input=null;
    }
    function attInitModernTimePickers(scope){
        (scope||document).querySelectorAll('[data-att-modern-time="1"]').forEach(function(input){
            if(input.getAttribute('data-att-modern-ready')==='1') return;
            input.setAttribute('data-att-modern-ready','1');
            input.addEventListener('focus',function(){attModernOpen(input);});
            input.addEventListener('click',function(){attModernOpen(input);});
            input.addEventListener('blur',function(){
                setTimeout(function(){
                    var fixed=attNormalizeTime(input.value);
                    if(fixed && input.value!==fixed){input.value=fixed;input.dispatchEvent(new Event('change',{bubbles:true}));}
                },120);
            });
            input.addEventListener('keydown',function(e){
                if(e.key==='Enter'){e.preventDefault();attModernClose(true);}
                if(e.key==='Escape'){e.preventDefault();attModernClose(false);}
                if(e.key==='ArrowUp'){e.preventDefault();attModernAdjust(e.shiftKey?'hour':'minute',1);}
                if(e.key==='ArrowDown'){e.preventDefault();attModernAdjust(e.shiftKey?'hour':'minute',-1);}
            });
        });
    }
    document.addEventListener('mousedown',function(e){
        var el=attModernPicker.el;
        if(!el||!el.classList.contains('show')) return;
        if(el.contains(e.target)) return;
        if(attModernPicker.input && attModernPicker.input.contains(e.target)) return;
        attModernClose(true);
    });
    window.addEventListener('resize',function(){if(attModernPicker.input)attModernOpen(attModernPicker.input);});
    window.addEventListener('scroll',function(){if(attModernPicker.input)attModernOpen(attModernPicker.input);},true);

    function attSyncWorkTimes(source){
        var s=document.getElementById(source==='copy'?'att_work_start_copy':'att_work_start');
        var e=document.getElementById(source==='copy'?'att_work_end_copy':'att_work_end');
        var s2=document.getElementById(source==='copy'?'att_work_start':'att_work_start_copy');
        var e2=document.getElementById(source==='copy'?'att_work_end':'att_work_end_copy');
        if(s&&s2)s2.value=s.value;
        if(e&&e2)e2.value=e.value;
    }

    function attCalcBreakMinutes(){
        var b1=attTimeToMin((document.getElementById('att_break_start')||{}).value);
        var b2=attTimeToMin((document.getElementById('att_break_end')||{}).value);
        var diff=b2-b1;
        if(diff<0) diff += 1440;
        if(!b1 && !b2) diff=0;
        return diff;
    }

    function attCalcWorkMinutes(){
        var st=attTimeToMin((document.getElementById('att_work_start')||{}).value);
        var en=attTimeToMin((document.getElementById('att_work_end')||{}).value);
        var total=en-st;
        if(total<0) total+=1440;
        total-=attCalcBreakMinutes();
        return Math.max(0,total);
    }


    function attClearPermissionValidation(){
        [
            'att_perm_req_day','att_perm_req_week','att_perm_req_month',
            'att_perm_min_request','att_perm_min_day','att_perm_min_week','att_perm_min_month','att_perm_deduct_rate'
        ].forEach(function(id){
            var el=document.getElementById(id);
            if(el) el.classList.remove('is-invalid');
        });

        [
            'att_err_perm_req_day','att_err_perm_req_week','att_err_perm_req_month',
            'att_err_perm_min_request','att_err_perm_min_day','att_err_perm_min_week','att_err_perm_min_month','att_err_perm_deduct_rate'
        ].forEach(function(id){
            var err=document.getElementById(id);
            if(err) err.style.display='none';
        });
    }
function attValidatePermissionPolicy() {
    var valid = true;
    var firstInvalid = null;

    // Clear previous permission validation errors
    var permFields = [
        'att_perm_req_day',    'att_perm_req_week',    'att_perm_req_month',
        'att_perm_min_request','att_perm_min_day',     'att_perm_min_week',
        'att_perm_min_month',  'att_perm_deduct_rate'
    ];

    permFields.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.classList.remove('is-invalid');
    });

    [
        'att_err_perm_req_day',    'att_err_perm_req_week',    'att_err_perm_req_month',
        'att_err_perm_min_request','att_err_perm_min_day',     'att_err_perm_min_week',
        'att_err_perm_min_month',  'att_err_perm_deduct_rate'
    ].forEach(function (id) {
        var err = document.getElementById(id);
        if (err) err.style.display = 'none';
    });

    function getNum(id) {
        var el  = document.getElementById(id);
        var raw = el ? String(el.value || '').trim() : '';
        if (raw === '') return null;
        var n = Number(raw);
        return isNaN(n) ? null : n;
    }

    function setErr(inputId, errId, cond) {
        var input = document.getElementById(inputId);
        var err   = document.getElementById(errId);

        if (input) input.classList.toggle('is-invalid', cond);
        if (err) err.style.display = cond ? 'block' : 'none';

        if (cond) {
            valid = false;
            if (!firstInvalid && input) firstInvalid = input;
        }
    }

    // Permission policy is mandatory, so saving is blocked when it is not enabled
    var allow = document.getElementById('att_allow_permissions');
    if (!allow || !allow.checked) {
        valid = false;
        firstInvalid = allow || firstInvalid;
    }

    var reqDay     = getNum('att_perm_req_day');
    var reqWeek    = getNum('att_perm_req_week');
    var reqMonth   = getNum('att_perm_req_month');
    var minRequest = getNum('att_perm_min_request');
    var minDay     = getNum('att_perm_min_day');
    var minWeek    = getNum('att_perm_min_week');
    var minMonth   = getNum('att_perm_min_month');
    var deductRate = getNum('att_perm_deduct_rate');

    // Requests count fields are mandatory
    setErr('att_perm_req_day',   'att_err_perm_req_day',
        reqDay === null || reqDay < 1);

    setErr('att_perm_req_week',  'att_err_perm_req_week',
        reqWeek === null || reqWeek < 1 ||
        (reqDay !== null && reqWeek < reqDay));

    setErr('att_perm_req_month', 'att_err_perm_req_month',
        reqMonth === null || reqMonth < 1 ||
        (reqWeek !== null && reqMonth < reqWeek));

    // Permission duration fields are mandatory
    setErr('att_perm_min_request', 'att_err_perm_min_request',
        minRequest === null || minRequest < 1);

    setErr('att_perm_min_day',   'att_err_perm_min_day',
        minDay === null || minDay < 1 ||
        (minRequest !== null && minDay < minRequest));

    setErr('att_perm_min_week',  'att_err_perm_min_week',
        minWeek === null || minWeek < 1 ||
        (minDay !== null && minWeek < minDay));

    setErr('att_perm_min_month', 'att_err_perm_min_month',
        minMonth === null || minMonth < 1 ||
        (minWeek !== null && minMonth < minWeek));

    // Deduction rate is mandatory only when deduction-on-exceed is enabled
    var deductChk = document.getElementById('att_perm_deduct_exceeded');
    if (deductChk && deductChk.checked) {
        setErr('att_perm_deduct_rate', 'att_err_perm_deduct_rate',
            deductRate === null || deductRate <= 0);
    }

    if (!valid) {
        if (window.attShowPolicyTab) window.attShowPolicyTab('permission');

        setTimeout(function () {
            if (firstInvalid && typeof firstInvalid.focus === 'function') {
                firstInvalid.focus();
                return;
            }

            var first = document.querySelector(
                '#kt_attendance_modal .att-tab-pane[data-att-tab-pane="permission"] .is-invalid'
            );
            if (first) first.focus();
        }, 80);

        if (window.KtToast) {
            KtToast.error('@Localizer["You must enable permission and fill its required data correctly"]');
        }
    }

    return valid;
}


