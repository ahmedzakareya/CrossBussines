                                                                                        <td class="ps-6">
                                                                                            <div class="d-flex align-items-center gap-2">
                                                                                                <span class="symbol symbol-35px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-time fs-4 text-primary"></i></span></span>
                                                                                                <div class="d-flex flex-column"><span class="fw-bold text-gray-800">@att.AllowedGraceMinutes @CrossBuy.Resources.SharedResources.Minute</span><span class="text-muted fs-8">مسموح به</span></div>
                                                                                            </div>
                                                                                        </td>
                                                                                        <td>
                                                                                            <div class="d-flex align-items-center gap-2">
                                                                                                <div class="progress h-6px w-60px bg-light-warning"><div class="progress-bar bg-warning" style="width:@(Math.Min(att.WarningThresholdCount * 10, 100))%"></div></div>
                                                                                                <span class="fw-bold text-gray-800">@att.WarningThresholdCount @CrossBuy.Resources.SharedResources.Time</span>
                                                                                            </div>
                                                                                        </td>
                                                                                        <td><span class="badge badge-light-danger fw-bold fs-7">@att.DeductionRatePerOccurrence %</span></td>
                                                                                        <td class="text-center"><span class="badge badge-light-dark fw-bold fs-7">@att.UnexcusedAbsenceThreshold @CrossBuy.Resources.SharedResources.Day</span></td>
                                                                                        <td><span class="badge badge-light-primary fw-bold fs-7">@wStart — @wEnd</span></td>
                                                                                        <td class="text-end pe-6">
                                                                                            <button type="button" class="btn btn-icon btn-sm btn-light btn-active-light-warning"
                                                                                                    data-bs-toggle="modal" data-bs-target="#kt_attendance_modal"
                                                                                                    onclick="openAttendanceModal(
                                                                                                        parseInt(this.closest('tr').dataset.attId),
                                                                                                        parseInt(this.closest('tr').dataset.attPolicy),
                                                                                                        this.closest('tr').dataset.attGrace,
                                                                                                        this.closest('tr').dataset.attWarning,
                                                                                                        this.closest('tr').dataset.attDeduction,
                                                                                                        this.closest('tr').dataset.attAbsence,
                                                                                                        this.closest('tr').dataset.attWstart,
                                                                                                        this.closest('tr').dataset.attWend,
                                                                                                        this.closest('tr').dataset.attHours,
                                                                                                        this.closest('tr').dataset.attDays,
                                                                                                        this.closest('tr').dataset.attSun,
                                                                                                        this.closest('tr').dataset.attMon,
                                                                                                        this.closest('tr').dataset.attTue,
                                                                                                        this.closest('tr').dataset.attWed,
                                                                                                        this.closest('tr').dataset.attThu,
                                                                                                        this.closest('tr').dataset.attFri,
                                                                                                        this.closest('tr').dataset.attSat,
                                                                                                        this.closest('tr').dataset.attBstart,
                                                                                                        this.closest('tr').dataset.attBend,
                                                                                                        this.closest('tr').dataset.attBmin,
                                                                                                        this.closest('tr').dataset.attAllowPermissions,
                                                                                                        this.closest('tr').dataset.attMaxPermReqDay,
                                                                                                        this.closest('tr').dataset.attMaxPermReqWeek,
                                                                                                        this.closest('tr').dataset.attMaxPermReqMonth,
                                                                                                        this.closest('tr').dataset.attMaxPermMinRequest,
                                                                                                        this.closest('tr').dataset.attMaxPermMinDay,
                                                                                                        this.closest('tr').dataset.attMaxPermMinWeek,
                                                                                                        this.closest('tr').dataset.attMaxPermMinMonth,
                                                                                                        this.closest('tr').dataset.attRequirePermApproval,
                                                                                                        this.closest('tr').dataset.attRejectPermExceeded,
                                                                                                        this.closest('tr').dataset.attDeductPermExceeded,
                                                                                                        this.closest('tr').dataset.attAllowLatePerm,
                                                                                                        this.closest('tr').dataset.attAllowEarlyPerm,
                                                                                                        this.closest('tr').dataset.attAllowDuringPerm,
                                                                                                        this.closest('tr').dataset.attLinkPermFingerprint,
                                                                                                        this.closest('tr').dataset.attPermDeductRate
                                                                                                    ); event.stopPropagation();">
                                                                                                <i class="ki-outline ki-pencil fs-4"></i>
                                                                                            </button>
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <tr class="dt-row"><td colspan="6" class="text-center py-10"><div class="d-flex flex-column align-items-center gap-3"><i class="ki-outline ki-information-5 fs-3x text-gray-300"></i><span class="text-muted fs-6 fw-semibold">@Localizer["No items added"]</span></div></td></tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                                <div class="sub-footer"><span>@CrossBuy.Resources.SharedResources.Total: @(item.AttendancePolicies?.Count ?? 0) @CrossBuy.Resources.SharedResources.Record</span></div>
                                                            </div>

                                                            @* ══ TAB 3 — الإجازات ══ *@
                                                            <div class="tab-pane fade" id="leave_rules_@item.ID">
                                                                <div class="sub-toolbar">
                                                                    <div class="d-flex align-items-center position-relative">
                                                                        <i class="ki-outline ki-magnifier fs-4 position-absolute ms-4 text-gray-400"></i>
                                                                        <input type="text" class="form-control form-control-solid form-control-sm w-200px ps-12" placeholder="@Localizer["Search..."]" onkeyup="leaveCardSearch(this,'leave_cards_@item.ID','leave_info_@item.ID')" />
                                                                    </div>
                                                                    <div class="d-flex align-items-center gap-3">
                                                                        <span class="badge badge-light-primary fw-bold fs-7 px-4 py-2" id="leave_info_@item.ID">
                                                                            <i class="ki-outline ki-calendar fs-6 me-1"></i>@(item.LeavePolicies?.Count ?? 0)
                                                                        </span>
                                                                        <button type="button" class="btn btn-sm btn-light-danger" data-bs-toggle="modal" data-bs-target="#kt_leave_modal" onclick="openLeaveModal(0,@item.ID,0,'','','',false)">
                                                                            <i class="ki-outline ki-plus fs-4 me-1"></i>@CrossBuy.Resources.SharedResources.New
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                                <div class="row g-5 p-6" id="leave_cards_@item.ID">
                                                                    @if (item.LeavePolicies != null && item.LeavePolicies.Any())
                                                                    {
                                                                        foreach (var lp in item.LeavePolicies)
                                                                        {
                                                                            string cardTheme = "purple";
                                                                            string cardIcon = "bi bi-people";
                                                                            string typeName = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? (lp.leaveTypes?.NameAr ?? "") : (lp.leaveTypes?.NameEn ?? "");
                                                                            string typeNameEn = (lp.leaveTypes?.NameEn ?? "").ToLower().Trim();

                                                                            if (typeNameEn.Contains("annual")) { cardTheme = "green"; cardIcon = "bi bi-calendar-check"; }
                                                                            else if (typeNameEn.Contains("sick") || typeNameEn.Contains("medical")) { cardTheme = "pink"; cardIcon = "bi bi-heart"; }
                                                                            else { cardTheme = "purple"; cardIcon = "bi bi-people"; }

                                                                            <div class="col-md-6 col-xl-4 leave-card-item" data-search="@typeName @lp.EntitlementDaysPerYear @lp.CarryOverLimit">
                                                                                <div class="leave-modern-card">
                                                                                    <div class="leave-modern-head @cardTheme">
                                                                                        <div class="leave-modern-icon"><i class="@cardIcon"></i></div>
                                                                                        <div class="leave-modern-title">
                                                                                            <h4>@typeName</h4>
                                                                                            <span>@CrossBuy.Resources.SharedResources.Per @lp.EntitlementDaysPerYear @CrossBuy.Resources.SharedResources.Day / @CrossBuy.Resources.SharedResources.Year</span>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="leave-modern-body">
                                                                                        <div class="leave-modern-stats">
                                                                                            <div class="leave-modern-stat">
                                                                                                <span class="num">@lp.NoticePeriodDays</span>
                                                                                                <span class="label">@CrossBuy.Resources.SharedResources.NoticePeriod</span>
                                                                                            </div>
                                                                                            <div class="leave-modern-stat tint-@cardTheme">
                                                                                                <span class="num @cardTheme">@lp.CarryOverLimit</span>
                                                                                                <span class="label">@CrossBuy.Resources.SharedResources.CarryForwardLimit</span>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="leave-modern-row">
                                                                                            <span class="leave-modern-row-label"><i class="bi bi-file-earmark-text"></i>@CrossBuy.Resources.SharedResources.MedicalCertificateRequired</span>
                                                                                            @if (lp.RequiresMedicalCertificate == true) { <span class="leave-modern-badge required">@CrossBuy.Resources.SharedResources.Required</span> }
                                                                                            else { <span class="leave-modern-badge optional">@CrossBuy.Resources.SharedResources.NotRequired</span> }
                                                                                        </div>
                                                                                        <div class="leave-modern-row">
                                                                                            <span class="leave-modern-row-label"><i class="bi bi-calendar3"></i>@CrossBuy.Resources.SharedResources.AnnualLeaveEntitlement</span>
                                                                                            <strong>@lp.EntitlementDaysPerYear @CrossBuy.Resources.SharedResources.Day</strong>
                                                                                        </div>
                                                                                        <div class="leave-modern-actions">
                                                                                            <a href="#" class="leave-modern-details @cardTheme" onclick="event.preventDefault();">
                                                                                                @CrossBuy.Resources.SharedResources.Details <i class="bi bi-eye"></i>
                                                                                            </a>
                                                                                            <a href="#" class="leave-modern-edit @cardTheme" data-bs-toggle="modal" data-bs-target="#kt_leave_modal"
                                                                                               onclick="event.preventDefault(); openLeaveModal(@lp.ID,@item.ID,@(lp.leaveTypes?.ID ?? 0),'@lp.EntitlementDaysPerYear','@lp.CarryOverLimit','@lp.NoticePeriodDays','@(lp.RequiresMedicalCertificate?.ToString().ToLower() ?? "false")')">
                                                                                                <i class="bi bi-pencil"></i>
                                                                                            </a>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="col-12 text-center py-12">
                                                                            <div class="d-flex flex-column align-items-center gap-3">
                                                                                <i class="ki-outline ki-calendar fs-3x text-gray-300"></i>
                                                                                <span class="text-muted fs-6 fw-semibold">@CrossBuy.Resources.SharedResources.NoLeavesAdded</span>
                                                                                <button type="button" class="btn btn-sm btn-light-primary" data-bs-toggle="modal" data-bs-target="#kt_leave_modal" onclick="openLeaveModal(0,@item.ID,0,'','','',false)">
                                                                                    <i class="ki-outline ki-plus fs-5 me-1"></i>@CrossBuy.Resources.SharedResources.New
                                                                                </button>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ══ POLICY MODAL ══ -->
<div class="modal fade" id="kt_policy_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content" style="border-radius:20px;border:none;box-shadow:0 24px 64px rgba(0,0,0,0.12);">
            <div class="modal-header border-0 pb-0 px-7 pt-7">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#0E4A9E,#145DBF);display:flex;align-items:center;justify-content:center;"><i class="ki-outline ki-shield-tick fs-4 text-white"></i></div>
                    <div><h4 class="fw-bold text-gray-900 mb-0 fs-5" id="modalPolicyTitle">@CrossBuy.Resources.SharedResources.New</h4><span class="text-muted fs-7">@CrossBuy.Resources.SharedResources.MainPolicyData</span></div>
                </div>
                <button type="button" style="width:32px;height:32px;border-radius:8px;border:none;background:#E7F0FF;display:flex;align-items:center;justify-content:center;cursor:pointer;" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-4 text-gray-500"></i></button>
            </div>
            <div class="modal-body px-7 py-6">
                <input type="hidden" id="modal_policy_id" value="0" />
                <div class="row g-4 mb-4">
                    <div class="col-12 col-sm-6"><label class="form-label fw-semibold fs-7 text-gray-600 mb-2"><span class="required">@CrossBuy.Resources.SharedResources.NameAr</span></label><input type="text" id="modal_nameAr" class="form-control modal-input" placeholder="@CrossBuy.Resources.SharedResources.NameAr" autocomplete="off" /><div class="text-danger fs-8 mt-1" id="err_nameAr" style="display:none;">@CrossBuy.Resources.SharedResources.NameAr مطلوب</div></div>
                    <div class="col-12 col-sm-6"><label class="form-label fw-semibold fs-7 text-gray-600 mb-2"><span class="required">@CrossBuy.Resources.SharedResources.NameEn</span></label><input type="text" id="modal_nameEn" class="form-control modal-input" placeholder="@CrossBuy.Resources.SharedResources.NameEn" autocomplete="off" /><div class="text-danger fs-8 mt-1" id="err_nameEn" style="display:none;">@CrossBuy.Resources.SharedResources.NameEn مطلوب</div></div>
                </div>
                <div class="mb-2"><label class="form-label fw-semibold fs-7 text-gray-600 mb-2">@CrossBuy.Resources.SharedResources.Notes</label><textarea id="modal_notes" class="form-control modal-input" placeholder="@CrossBuy.Resources.SharedResources.Notes" style="height:90px;resize:none;"></textarea></div>
            </div>
            <div class="modal-footer border-0 px-7 pb-7 pt-2 gap-3">
                <button type="button" class="btn btn-light flex-grow-1" data-bs-dismiss="modal" style="border-radius:10px;font-weight:600;">@CrossBuy.Resources.SharedResources.Cancel</button>
                <button type="button" id="btnModalSave" onclick="savePolicyModal()" style="flex:2;padding:11px 0;border-radius:10px;border:none;background:linear-gradient(135deg,#0E4A9E,#145DBF);color:#fff;font-size:13.5px;font-weight:600;cursor:pointer;box-shadow:0 4px 12px rgba(31,127,82,0.3);display:inline-flex;align-items:center;justify-content:center;gap:8px;">
                    <i class="ki-outline ki-save-2 fs-4"></i>@CrossBuy.Resources.SharedResources.Save
                </button>
            </div>
        </div>
    </div>
</div>

