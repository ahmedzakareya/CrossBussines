function attBuildWeekdayPicker(){
    var container = document.getElementById('att-weekday-picker');
    var preview = document.getElementById('att-weekday-preview');

    function fill(target, readonly){
        if(!target) return;

        target.innerHTML = '';

        ATT_WD.forEach(function(d){

            var on = attWdSelected.has(d.k);

            var btn = document.createElement('div');

            btn.className = 'att-day-btn' + (on ? ' active' : '');

            btn.innerHTML =
                '<span class="day-check">✓</span>' +
                '<span class="day-x">×</span>' +
                '<span class="day-label">' + d.l + '</span>';

            if(!readonly){

                btn.addEventListener('click', function(){

                    if(attWdSelected.has(d.k)){
                        attWdSelected.delete(d.k);
                    }
                    else{
                        attWdSelected.add(d.k);
                    }

                    if(attWdSelected.size < 1){
                        attWdSelected.add(d.k);
                    }

                    attBuildWeekdayPicker();
                    attUpdatePreview();
                });
            }

            target.appendChild(btn);
        });
    }

    fill(container, false);
    fill(preview, true);

    var c = attWdSelected.size;

    var lbl = c + ' ' + resDay;

    if(c === 7){
        lbl += ' — ' + resAllWeek;
    }
    else if(c === 5){
        lbl += ' — ' + resOfficialWorkingHours;
    }
    else{
        lbl += ' — ' + resSpecificDays;
    }

    attText('att-weekday-summary', lbl);
    attText('att-weekday-summary-side', lbl);

    attSetValue('att_work_days', c);
}

   function attFormatTickLabel(min){
    min = ((Math.round(min / 30) * 30) % 1440 + 1440) % 1440;

    var h = Math.floor(min / 60);
    var m = min % 60;

    var suffix = h < 12
        ? '@CrossBuy.Resources.SharedResources.AM'
        : '@CrossBuy.Resources.SharedResources.PM';

    var hh = h % 12;
    if (hh === 0) hh = 12;

    return (hh < 10 ? '0' + hh : '' + hh) +
           (m ? ':' + (m < 10 ? '0' + m : '' + m) : '') +
           ' ' + suffix;
}

    function attSetVisualPos(el, left, width){
        if(!el) return;
        el.style.left = Math.max(0, Math.min(100, left)) + '%';
        if(width !== null && width !== undefined){
            el.style.width = Math.max(0, Math.min(100, width)) + '%';
        }
        el.style.right = 'auto';
    }

    function attSetCalloutPos(selector, pct, isMiddle){
        var el = document.querySelector('#kt_attendance_modal ' + selector);
        if(!el) return;
        pct = Math.max(0, Math.min(100, pct));
        el.style.left = pct + '%';
        el.style.right = 'auto';
        el.style.transform = 'translateX(-50%)';
        if(pct < 8){ el.style.left = '0%'; el.style.transform = 'translateX(0)'; }
        if(pct > 92){ el.style.left = '100%'; el.style.transform = 'translateX(-100%)'; }
        if(isMiddle){ el.style.transform = 'translateX(-50%)'; }
    }

    function attUpdateTimeBar(){
        var start=attTimeToMin((document.getElementById('att_work_start')||{}).value);
        var end=attTimeToMin((document.getElementById('att_work_end')||{}).value);
        var bstart=attTimeToMin((document.getElementById('att_break_start')||{}).value);
        var bend=attTimeToMin((document.getElementById('att_break_end')||{}).value);
        var grace=parseInt((document.getElementById('att_grace_minutes')||{}).value||'0',10)||0;

        var en=end;
        if(en<start) en+=1440;

        var bs=bstart;
        var be=bend;
        if(bs<start) bs+=1440;
        if(be<bs) be+=1440;

        var before=document.getElementById('att-bar-before');
        var work=document.getElementById('att-bar-work');
        var brk=document.getElementById('att-bar-break');
        var after=document.getElementById('att-bar-after');

        var padBefore = Math.max(90, grace + 90);
        var padAfter  = Math.max(90, grace + 90);
        var axisStart = Math.max(0, start - padBefore);
        var axisEnd   = Math.min(1440, en + padAfter);

        if((axisEnd - axisStart) < 720){
            var mid = (start + en) / 2;
            axisStart = Math.max(0, mid - 360);
            axisEnd = Math.min(1440, axisStart + 720);
            axisStart = Math.max(0, axisEnd - 720);
        }

        var span = Math.max(1, axisEnd - axisStart);
        var pct=function(m){ return ((m - axisStart) / span) * 100; };
        var widthPct=function(a,b){ return ((b - a) / span) * 100; };

        var workLeft = pct(start);
        var workWidth = widthPct(start,en);
        var breakLeft = pct(bs);
        var breakWidth = Math.max(8, widthPct(bs,be));
        var afterLeft = pct(en);
        var afterWidth = Math.max(8, widthPct(en, Math.min(axisEnd, en + Math.max(30, grace))));
        var beforeLeft = pct(start);

        attSetVisualPos(work, workLeft, workWidth);
        attSetVisualPos(brk, breakLeft, breakWidth);
        attSetVisualPos(after, afterLeft, afterWidth);
        attSetVisualPos(before, beforeLeft, null);

        attSetCalloutPos('.att-vis-callout.start', workLeft, false);
        attSetCalloutPos('.att-vis-callout.end', afterLeft + afterWidth, false);
        attSetCalloutPos('.att-vis-callout.break', breakLeft + (breakWidth / 2), true);

        var ticks = document.querySelector('#kt_attendance_modal .att-timebar-ticks');
        if(ticks){
            var tickHtml = '';
            for(var i=0;i<5;i++){
                tickHtml += '<span>' + attFormatTickLabel(axisStart + ((span/4) * i)) + '</span>';
            }
            ticks.innerHTML = tickHtml;
        }
    }

    function attDrawDonut(workMin, breakMin, graceMin){
        var canvas=document.getElementById('att-donut-canvas');
        if(!canvas||!canvas.getContext)return;
        var ctx=canvas.getContext('2d'),W=canvas.width,H=canvas.height,cx=W/2,cy=H/2,r=Math.min(W,H)/2-16,lw=10;
        ctx.clearRect(0,0,W,H);
        var total=1440;
        var segs=[
            {v:workMin,c:'#0E4A9E'},
            {v:breakMin,c:'#f59e0b'},
            {v:graceMin*2,c:'#97edc5'},
            {v:Math.max(0,total-workMin-breakMin-(graceMin*2)),c:'#D0E1FF'}
        ];
        var a=-Math.PI/2;
        segs.forEach(function(s){
            if(s.v<=0)return;
            var ang=(s.v/total)*Math.PI*2;
            ctx.beginPath();ctx.arc(cx,cy,r,a,a+ang);ctx.lineWidth=lw;ctx.strokeStyle=s.c;ctx.stroke();a+=ang;
        });
    }
