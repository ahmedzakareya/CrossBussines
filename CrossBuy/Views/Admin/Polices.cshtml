@model List<CrossBuy.ViewModel.PoliciesDto>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    ViewData["Title"] = Localizer["Policies"].Value;
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";

    int totalPolicies   = Model?.Count ?? 0;
    int totalSalary     = Model?.Sum(x => x.SalaryPolicies?.Count    ?? 0) ?? 0;
    int totalAttendance = Model?.Sum(x => x.AttendancePolicies?.Count ?? 0) ?? 0;
    int totalLeave      = Model?.Sum(x => x.LeavePolicies?.Count      ?? 0) ?? 0;
}

<style>
/* ══════════════════════════════════════════
   MIXED WIDGET CARDS
══════════════════════════════════════════ */
.stats-equal-row > [class*="col-"] { display:flex !important; }
.mixed-widget-card{width:100%;min-height:178px;height:100%;border-radius:16px;padding:22px 24px;position:relative;overflow:hidden;border:none!important;box-shadow:0 8px 24px rgba(15,42,29,.10);transition:transform .2s ease,box-shadow .2s ease;display:flex;flex-direction:column;justify-content:space-between;isolation:isolate;}
.mixed-widget-card::after{content:'';position:absolute;inset-inline:-20px;bottom:36px;height:70px;background:radial-gradient(circle at 15% 55%,rgba(255,255,255,.18),transparent 24%),linear-gradient(135deg,transparent 10%,rgba(255,255,255,.14) 45%,transparent 74%);opacity:.55;transform:skewY(-7deg);pointer-events:none;z-index:0;}
.mixed-widget-card:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(15,42,29,.16);}
.mixed-widget-card{cursor:pointer;}
.policy-focus-pulse{animation:policyFocusPulse 1.15s ease-in-out 1;}
@@keyframes policyFocusPulse{0%{box-shadow:0 0 0 0 rgba(31,127,82,.00)}35%{box-shadow:0 0 0 5px rgba(31,127,82,.18)}100%{box-shadow:0 6px 18px rgba(15,42,29,.035)}}
.nested-focus-pulse{animation:nestedFocusPulse 1.15s ease-in-out 1;}
@@keyframes nestedFocusPulse{0%{box-shadow:none}35%{box-shadow:0 0 0 4px rgba(31,127,82,.14)}100%{box-shadow:none}}
.mw-card-main{position:relative;z-index:1;display:grid;grid-template-columns:78px minmax(0,1fr);gap:18px;align-items:start;}
.mw-icon-box{width:76px;height:76px;border-radius:16px;background:rgba(255,255,255,.88);display:inline-flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px rgba(255,255,255,.55),0 10px 22px rgba(15,42,29,.10);flex:0 0 auto;}
.mw-icon-box svg{width:34px;height:34px;stroke-width:2.15;}
.mw-content{min-width:0;color:#fff;}
.mixed-widget-card .mw-label{color:#fff;font-size:15px;line-height:1.35;font-weight:800;margin:0 0 10px 0;white-space:normal!important;overflow:visible!important;text-overflow:unset!important;word-break:normal;}
.mixed-widget-card .mw-number{font-size:38px;font-weight:900;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:12px;}
.mixed-widget-card .mw-view-btn{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:800;color:rgba(255,255,255,.95);text-decoration:none;line-height:1.4;white-space:nowrap;}
.mixed-widget-card .mw-view-btn:hover{color:#fff;}.mixed-widget-card .mw-view-btn i{color:#fff!important;}
.mw-progress-wrap{position:relative;z-index:1;display:grid;grid-template-columns:auto minmax(86px,1fr);align-items:center;gap:12px;margin-top:18px;}
.mw-progress-text{color:rgba(255,255,255,.96);font-size:12.5px;line-height:1.35;font-weight:800;white-space:normal;}
.mw-progress{height:8px;border-radius:99px;background:rgba(255,255,255,.38);overflow:hidden;margin:0;}.mw-progress-fill{height:100%;border-radius:99px;background:rgba(255,255,255,.92);transition:width .8s cubic-bezier(.34,1.56,.64,1);}
.mw-blue{background:linear-gradient(135deg,#0E4A9E 0%,#0E4A9E 100%);}.mw-purple{background:linear-gradient(135deg,#0E4A9E 0%,#0E4A9E 100%);}.mw-green{background:linear-gradient(135deg,#12b76a 0%,#0ea36a 100%);}.mw-pink{background:linear-gradient(135deg,#0E4A9E 0%,#0E4A9E 100%);}
.mw-blue .mw-icon-box{color:#0E4A9E;}.mw-purple .mw-icon-box{color:#0E4A9E;}.mw-green .mw-icon-box{color:#0ea36a;}.mw-pink .mw-icon-box{color:#0E4A9E;}
@@media (max-width:1399px){.mixed-widget-card{padding:20px 18px}.mw-card-main{grid-template-columns:66px minmax(0,1fr);gap:14px}.mw-icon-box{width:64px;height:64px;border-radius:15px}.mw-icon-box svg{width:29px;height:29px}.mixed-widget-card .mw-number{font-size:34px}}
@@media (max-width:767px){.mw-card-main{grid-template-columns:58px minmax(0,1fr)}.mw-icon-box{width:56px;height:56px}.mw-icon-box svg{width:26px;height:26px}.mixed-widget-card{min-height:164px}.mixed-widget-card .mw-label{font-size:14px}.mixed-widget-card .mw-number{font-size:32px}}

/* ══════════════════════════════════════════
   MAIN TABLE
══════════════════════════════════════════ */
#kt_polices_table thead tr { background: #f9f9f9; border-bottom: 2px solid #e9ecef; }
#kt_polices_table thead th { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #a1a5b7; padding: 14px 12px; white-space: nowrap; }
#kt_polices_table tbody tr.main-row { cursor: pointer; transition: background 0.15s ease; border-bottom: 1px solid #f1f1f4; }
#kt_polices_table tbody tr.main-row:hover { background: #F3F7FF !important; }
#kt_polices_table tbody tr.main-row td { padding: 16px 12px; vertical-align: middle; }

.policy-avatar { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 800; flex-shrink: 0; position: relative; overflow: hidden; }
.policy-avatar::after { content: ''; position: absolute; inset: 0; border-radius: 12px; border: 1.5px solid rgba(255,255,255,0.3); pointer-events: none; }
.av-0 { background: linear-gradient(135deg,#0E4A9E,#145DBF); color:#fff; }
.av-1 { background: linear-gradient(135deg,#34c77b,#1a8f52); color:#fff; }
.av-2 { background: linear-gradient(135deg,#7be8b5,#0E4A9E); color:#fff; }
.av-3 { background: linear-gradient(135deg,#f7934f,#d95f10); color:#fff; }
.av-4 { background: linear-gradient(135deg,#2ec4b6,#138f84); color:#fff; }
.av-5 { background: linear-gradient(135deg,#f76f6f,#c43030); color:#fff; }
.av-6 { background: linear-gradient(135deg,#0E4A9E,#145DBF); color:#fff; }
.av-7 { background: linear-gradient(135deg,#78e7b3,#0E4A9E); color:#fff; }

.count-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 28px; border-radius: 8px; font-size: 13px; font-weight: 700; padding: 0 10px; }
.count-pill.salary { background:#e8f5e9; color:#2e7d32; }
.count-pill.attend { background:#e6faf1; color:#0E4A9E; }
.count-pill.leave  { background:#e6faf1; color:#0E4A9E; }

.expand-toggle { width: 32px; height: 32px; border-radius: 8px; background: #E7F0FF; border: none; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; cursor: pointer; padding: 0; }
.expand-toggle:hover { background: #e0f5eb; }
.expand-toggle i { transition: transform 0.25s ease; font-size: 13px; color: #7c7f8e; }
.expand-toggle.is-open { background: #0E4A9E; }
.expand-toggle.is-open i { color: #fff; transform: rotate(90deg); }

.action-btn { width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid transparent; transition: all 0.15s; background: #f5f5f5; color: #7c7f8e; text-decoration: none; cursor: pointer; }
.action-btn:hover.open   { background:#e6faf1; color:#0E4A9E; border-color:#c2f4dd; }
.action-btn:hover.msg    { background:#e8f5e9; color:#2e7d32; border-color:#c8e6c9; }
.action-btn:hover.attach { background:#fff3e0; color:#e65100; border-color:#ffe0b2; }

#mainTableSearch { border-radius: 10px !important; border: 1.5px solid #e4e6ef !important; font-size: 13px !important; height: 40px !important; }
#mainTableSearch:focus { border-color: #0E4A9E !important; box-shadow: 0 0 0 3px rgba(31,127,82,0.12) !important; }

/* ══════════════════════════════════════════
   NESTED CARD
══════════════════════════════════════════ */
.nested-policy-card { border: 1.5px solid #e4e6ef; border-radius: 14px; overflow: visible; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
.nested-policy-card .nav-tabs .nav-link { font-size: 12.5px; font-weight: 600; color: #7c7f8e; padding: 12px 18px; border: none; border-bottom: 2px solid transparent; background: none; border-radius: 0; transition: all 0.15s; }
.nested-policy-card .nav-tabs .nav-link:hover { color: #0E4A9E; }
.nested-policy-card .nav-tabs .nav-link.active { color: #0E4A9E; border-bottom-color: #0E4A9E; background: none; }
.nested-policy-card .nav-tabs .nav-link .badge { font-size: 10px; padding: 2px 7px; border-radius: 20px; background: #ebfbf4; color: #0E4A9E; }
.sub-toolbar { background: #F3F7FF; border-bottom: 1px solid #f1f1f4; padding: 12px 18px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
.sub-toolbar input.form-control { border-radius: 8px !important; border: 1.5px solid #e4e6ef !important; height: 36px !important; font-size: 12.5px !important; }
.sub-toolbar input.form-control:focus { border-color: #0E4A9E !important; box-shadow: 0 0 0 3px rgba(31,127,82,0.1) !important; }
.sub-toolbar .form-select { border-radius: 8px !important; border: 1.5px solid #e4e6ef !important; height: 36px !important; font-size: 12.5px !important; padding-top: 0; padding-bottom: 0; }
.nested-policy-card .table thead th { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #a1a5b7; padding: 10px 14px; background: #f9f9f9; border-bottom: 1px solid #f1f1f4; white-space: nowrap; }
.nested-policy-card .table tbody td { padding: 11px 14px; vertical-align: middle; font-size: 13px; border-bottom: 1px solid #f5f5f5; }
.nested-policy-card .table tbody tr:last-child td { border-bottom: none; }
.nested-policy-card .table tbody tr:hover { background: #F3F7FF; }
.sub-footer { background: #F3F7FF; border-top: 1px solid #f1f1f4; padding: 10px 18px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: #7c7f8e; }
.leave-card-item .card { border-radius: 14px !important; border: 1.5px solid #f1f1f4 !important; transition: box-shadow 0.2s, transform 0.2s; }
.leave-card-item .card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1) !important; transform: translateY(-2px); }
.notes-text { font-size: 12px; color: #7c7f8e; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-block; }
.card-header-modern { background: #fff; border-bottom: 1.5px solid #f1f1f4; padding: 16px 22px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }

/* ══════════════════════════════════════════
   MODAL
══════════════════════════════════════════ */
.modal-input { border-radius: 10px !important; border: 1.5px solid #e4e6ef !important; font-size: 13.5px !important; padding: 10px 14px !important; transition: border-color 0.2s, box-shadow 0.2s !important; }
.modal-input:focus { border-color: #0E4A9E !important; box-shadow: 0 0 0 3px rgba(31,127,82,0.12) !important; outline: none !important; }
.modal-input.is-invalid { border-color: #ef4444 !important; box-shadow: 0 0 0 3px rgba(239,68,68,0.1) !important; }
.required::after { content: ' *'; color: #ef4444; }

/* ══════════════════════════════════════════
   TOAST
══════════════════════════════════════════ */
@@keyframes toastIn  { from { opacity:0; transform:translateY(-16px) scale(0.93); } to { opacity:1; transform:translateY(0) scale(1); } }
@@keyframes toastOut { from { opacity:1; } to { opacity:0; transform:translateY(-10px) scale(0.95); } }
@@keyframes toastPrg { from { width:100%; } to { width:0%; } }
.kt-toast { pointer-events:all; display:flex; align-items:center; gap:14px; padding:14px 18px 14px 16px; border-radius:16px; min-width:340px; max-width:420px; box-shadow:0 8px 32px rgba(0,0,0,0.13); position:relative; overflow:hidden; animation:toastIn 0.36s cubic-bezier(0.34,1.56,0.64,1) forwards; }
.kt-toast.hiding  { animation:toastOut 0.25s ease forwards; }
.kt-toast.success { background:linear-gradient(135deg,#f0fdf4,#dcfce7); border:1.5px solid #86efac; }
.kt-toast.error   { background:linear-gradient(135deg,#fff1f2,#ffe4e6); border:1.5px solid #fca5a5; }
.kt-toast.warning { background:linear-gradient(135deg,#fffbeb,#fef3c7); border:1.5px solid #fcd34d; }
.kt-toast-icon { width:40px; height:40px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:18px; }
.kt-toast.success .kt-toast-icon { background:#22c55e; color:#fff; }
.kt-toast.error   .kt-toast-icon { background:#ef4444; color:#fff; }
.kt-toast.warning .kt-toast-icon { background:#f59e0b; color:#fff; }
.kt-toast-body { flex:1; }
.kt-toast-title { font-size:13.5px; font-weight:700; margin-bottom:2px; }
.kt-toast-msg   { font-size:12.5px; opacity:0.75; }
.kt-toast.success .kt-toast-title { color:#15803d; } .kt-toast.success .kt-toast-msg { color:#166534; }
.kt-toast.error   .kt-toast-title { color:#b91c1c; } .kt-toast.error   .kt-toast-msg { color:#991b1b; }
.kt-toast.warning .kt-toast-title { color:#92400e; } .kt-toast.warning .kt-toast-msg { color:#78350f; }
.kt-toast-close { width:26px; height:26px; border-radius:8px; border:none; background:rgba(255,255,255,0.25); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:13px; flex-shrink:0; }
.kt-toast-close i, .kt-toast-icon i, .btn-confirm-ok i { color:#fff !important; }
.kt-toast-progress { position:absolute; bottom:0; left:0; height:3px; border-radius:0 0 16px 16px; animation:toastPrg linear forwards; }
.kt-toast.success .kt-toast-progress { background:#22c55e; }
.kt-toast.error   .kt-toast-progress { background:#ef4444; }
.kt-toast.warning .kt-toast-progress { background:#f59e0b; }

/* ══════════════════════════════════════════
   CONFIRM
══════════════════════════════════════════ */
#kt_confirm_overlay { position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:999999; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(3px); animation:toastIn 0.2s ease forwards; }
#kt_confirm_box { background:#fff; border-radius:20px; padding:32px 28px 24px; max-width:400px; width:90%; box-shadow:0 24px 64px rgba(0,0,0,0.18); text-align:center; }
.confirm-icon { width:56px; height:56px; border-radius:16px; background:linear-gradient(135deg,#fef3c7,#fde68a); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; font-size:24px; }
.confirm-title { font-size:16px; font-weight:700; color:#1a1a2e; margin-bottom:8px; }
.confirm-msg   { font-size:13.5px; color:#7c7f8e; margin-bottom:24px; line-height:1.5; }
.confirm-actions { display:flex; gap:10px; }
.btn-confirm-cancel { flex:1; padding:11px 0; border-radius:10px; border:1.5px solid #e4e6ef; background:#fff; color:#5e6278; font-size:13.5px; font-weight:600; cursor:pointer; }
.btn-confirm-cancel:hover { background:#F3F7FF; }
.btn-confirm-ok { flex:2; padding:11px 0; border-radius:10px; border:none; background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff; font-size:13.5px; font-weight:600; cursor:pointer; box-shadow:0 4px 12px rgba(245,158,11,0.3); display:inline-flex; align-items:center; justify-content:center; gap:6px; }

/* ══════════════════════════════════════════
   SALARY TABLE & MODALS
══════════════════════════════════════════ */
.salary-flat-wrap { overflow-x:auto; background:#fff; -webkit-overflow-scrolling:touch; }
.salary-flat-table { width:100%; border-collapse:separate; border-spacing:0; margin:0; }
.salary-flat-table thead th { background:#fff; border-bottom:1px solid #E7F0FF; padding:14px 16px; color:#7e8aa8; font-size:11px; font-weight:800; letter-spacing:.035em; text-transform:uppercase; white-space:nowrap; }
.salary-master-row { position:relative; cursor:pointer; transition:background .18s ease; }
.salary-master-row td:first-child::before { content:''; position:absolute; inset-block:0; inset-inline-start:0; width:3px; opacity:.95; }
.salary-master-row.tax-applicable td:first-child::before { background:#ffab00; }
.salary-master-row.tax-free       td:first-child::before { background:#16c784; }
.salary-master-row td { padding:16px !important; border-bottom:1px solid #E7F0FF !important; vertical-align:middle !important; }
.salary-master-row.row-tone-a { background:#fff !important; }
.salary-master-row.row-tone-b { background:#F3F7FF !important; }
.salary-master-row:hover { background:#F3F7FF !important; }
.salary-row-actions { display:inline-flex; align-items:center; gap:10px; }
.salary-icon-btn { width:40px; height:40px; border-radius:9px; border:1px solid #E7F0FF; display:inline-flex; align-items:center; justify-content:center; background:#fff; transition:.18s ease; color:#7b86a4; }
.salary-icon-btn.edit   { background:#fff6d8; border-color:#ffefb8; color:#ffab00; }
.salary-icon-btn.toggle { background:#F3F7FF; color:#0E4A9E; }
.salary-icon-btn:hover  { transform:translateY(-1px); box-shadow:0 6px 16px rgba(15,42,29,.08); }
.salary-details-toggle i { transition:transform .2s ease; }
.salary-master-row.is-open .salary-details-toggle i { transform:rotate(180deg); }
.salary-name-cell { display:flex; align-items:center; gap:12px; min-width:0; }
.salary-status-dot { width:9px; height:9px; border-radius:999px; display:inline-block; flex:0 0 auto; }
.salary-status-dot.tax  { background:#ffab00; }
.salary-status-dot.free { background:#16c784; }
.salary-title-main { color:#0B3D91; font-size:14px; font-weight:800; line-height:1.3; }
.salary-title-sub  { color:#8b94ad; font-size:12px; font-weight:600; margin-top:3px; }
.salary-main-amount { color:#0B3D91; font-weight:800; font-size:15px; }
.salary-pill { display:inline-flex; align-items:center; justify-content:center; min-width:42px; height:28px; padding:0 11px; border-radius:8px; font-size:13px; font-weight:800; white-space:nowrap; }
.salary-pill.payment { background:#ebfcf4; color:#0E4A9E; }
.salary-pill.day     { background:#edfcf5; color:#0E4A9E; }
.salary-pill.exempt  { background:#dff8e8; color:#08a64f; }
.salary-pill.tax     { background:#fff2cc; color:#f59e0b; }
.salary-details-row > td { padding:0 !important; border-bottom:1px solid #E7F0FF !important; overflow:hidden !important; }
.salary-details-panel { width:100% !important; padding:20px 22px !important; border-top:1px solid rgba(226,240,233,.65) !important; }
.salary-details-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; width:100%; }
.salary-detail-card { width:100%; min-height:104px; border-radius:10px; border:1px solid #E7F0FF; background:#fff; display:flex; align-items:center; gap:16px; padding:18px; }
.salary-detail-icon { width:54px; height:54px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; }
.salary-detail-icon.purple { background:#ebfcf4; color:#0E4A9E; }
.salary-detail-icon.blue   { background:#ebfcf4; color:#0E4A9E; }
.salary-detail-icon.green  { background:#e5f8ec; color:#15a65a; }
.salary-detail-icon.orange { background:#fff1dc; color:#f97316; }
.salary-detail-icon.cyan   { background:#e6f7f8; color:#0891a5; }
.salary-detail-icon.red    { background:#ffe8e8; color:#ef4444; }
.salary-detail-icon.violet { background:#ebfcf4; color:#0E4A9E; }
.salary-detail-label { color:#7e8aa8; font-size:13px; font-weight:600; margin-bottom:7px; }
.sal-row { transition:background 0.15s; }
.sal-row:hover { background:var(--bs-gray-100) !important; }

.salary-modal-head { background:#fff !important; border-bottom:0 !important; justify-content:space-between !important; gap:12px !important; }
.salary-modal-body { background:#fff !important; padding:24px 28px 8px !important; overflow-x:hidden !important; }
.salary-section-card { border-radius:14px !important; border:1.5px solid #f1f1f4 !important; box-shadow:none !important; background:#F3F7FF !important; padding:18px; height:100%; }
.salary-section-head { display:flex; align-items:center; gap:10px; margin-bottom:16px; padding-bottom:12px; border-bottom:1px dashed #D0E1FF; }
.salary-section-icon { width:34px; height:34px; border-radius:11px; display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; }
.salary-section-icon.green  { background:#e9f9ef; color:#18a45b; }
.salary-section-icon.blue   { background:#edfcf5; color:#0E4A9E; }
.salary-section-icon.orange { background:#fff2dd; color:#f59e0b; }
.salary-section-icon.purple { background:#ebfcf4; color:#0E4A9E; }
.salary-section-title { color:#0B3D91; font-size:13.5px; font-weight:900; margin:0; }
.salary-section-note  { color:#8b94ad; font-size:11.5px; font-weight:600; margin-top:2px; }
#kt_salary_modal .salary-section-card .row,
#kt_leave_modal .salary-section-card .row { align-items:flex-end !important; }
#kt_salary_modal .salary-section-card .row > [class*="col-"],
#kt_leave_modal .salary-section-card .row > [class*="col-"] { display:flex !important; flex-direction:column !important; justify-content:flex-end !important; }
#kt_salary_modal .salary-section-card .form-label,
#kt_leave_modal .salary-section-card .form-label { color:#64748b !important; font-size:12px !important; font-weight:800 !important; line-height:1.4 !important; margin-bottom:7px !important; display:block !important; }
#kt_salary_modal .modal-input { height:42px !important; border-radius:12px !important; background:#F3F7FF !important; border:1.5px solid #D0E1FF !important; color:#0B3D91 !important; font-size:13px !important; font-weight:700 !important; padding:9px 12px !important; }
#kt_salary_modal textarea.modal-input { height:auto !important; min-height:76px; resize:vertical; }
#kt_salary_modal .modal-input:focus { background:#fff !important; border-color:#34c77b !important; box-shadow:0 0 0 4px rgba(52,199,123,.12) !important; }
#kt_leave_modal .modal-input { height:42px !important; border-radius:12px !important; background:#F3F7FF !important; border:1.5px solid #D0E1FF !important; color:#0B3D91 !important; font-size:13px !important; font-weight:700 !important; padding:9px 12px !important; }
#kt_leave_modal .modal-input:focus { background:#fff !important; border-color:#34c77b !important; box-shadow:0 0 0 4px rgba(52,199,123,.12) !important; }
.salary-tax-box { height:42px; border:1.5px solid #D0E1FF; border-radius:12px; background:#F3F7FF; display:flex; align-items:center; padding:0 12px; width:100%; box-sizing:border-box; }
.salary-modal-footer { padding:8px 28px 24px !important; border-top:0 !important; background:#fff !important; display:flex !important; gap:10px !important; }
.salary-btn-cancel { flex:1 !important; min-width:120px !important; padding:11px 0 !important; border-radius:10px !important; border:1.5px solid #e4e6ef !important; background:#fff !important; color:#5e6278 !important; font-size:13.5px !important; font-weight:600 !important; height:44px; display:inline-flex; align-items:center; justify-content:center; gap:8px; cursor:pointer; }
.salary-btn-cancel:hover { background:#F3F7FF !important; }
.salary-btn-save { flex:2 !important; min-width:160px !important; padding:11px 0 !important; border-radius:10px !important; border:none !important; background:linear-gradient(135deg,#0E4A9E,#145DBF) !important; color:#fff !important; font-size:13.5px !important; font-weight:600 !important; box-shadow:0 4px 12px rgba(31,127,82,0.3) !important; height:44px; display:inline-flex; align-items:center; justify-content:center; gap:8px; cursor:pointer; }
.salary-btn-save:hover { transform:translateY(-1px) !important; }
.salary-btn-save i { color:#fff !important; }

/* ══════════════════════════════════════════
   SALARY DETAILS STATS
══════════════════════════════════════════ */
.salary-details-panel { background:#F3F7FF !important; padding:22px 26px !important; }
.salary-details-grid { display:grid !important; grid-template-columns:repeat(4,minmax(0,1fr)) !important; gap:16px !important; align-items:stretch !important; }
.salary-detail-card { position:relative !important; min-height:112px !important; height:100% !important; padding:18px 20px !important; border-radius:16px !important; border:1px solid #E7F0FF !important; background:linear-gradient(180deg,#ffffff 0%,#F3F7FF 100%) !important; box-shadow:0 8px 24px rgba(15,42,29,.045) !important; display:flex !important; align-items:center !important; justify-content:space-between !important; gap:14px !important; overflow:hidden !important; transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease !important; }
.salary-detail-card:hover { transform:translateY(-2px) !important; border-color:#dcf3e8 !important; box-shadow:0 14px 34px rgba(15,42,29,.08) !important; }
.salary-detail-card > div { min-width:0 !important; flex:1 1 auto !important; position:relative !important; z-index:1 !important; }
.salary-detail-label { color:#7e8aa8 !important; font-size:13px !important; font-weight:800 !important; line-height:1.45 !important; margin-bottom:8px !important; }
.salary-detail-value { color:#0B3D91 !important; font-size:18px !important; font-weight:900 !important; line-height:1.25 !important; }
.salary-detail-icon { width:56px !important; height:56px !important; min-width:56px !important; border-radius:15px !important; display:inline-flex !important; align-items:center !important; justify-content:center !important; flex:0 0 56px !important; position:relative !important; z-index:1 !important; box-shadow:inset 0 0 0 1px rgba(255,255,255,.65) !important; }
.salary-detail-icon i { font-size:24px !important; color:currentColor !important; }
.salary-detail-icon.purple { background:linear-gradient(135deg,#eefcf5,#dff9ed) !important; color:#0E4A9E !important; }
.salary-detail-icon.blue   { background:linear-gradient(135deg,#edfcf5,#e0f9ed) !important; color:#0E4A9E !important; }
.salary-detail-icon.green  { background:linear-gradient(135deg,#e9f9ef,#d8f5e4) !important; color:#15a65a !important; }
.salary-detail-icon.orange { background:linear-gradient(135deg,#fff3df,#ffe8bd) !important; color:#f59e0b !important; }
.salary-detail-icon.cyan   { background:linear-gradient(135deg,#e7f8fa,#d6f3f6) !important; color:#0891a5 !important; }
.salary-detail-icon.red    { background:linear-gradient(135deg,#ffecec,#ffdada) !important; color:#ef4444 !important; }
.salary-detail-icon.violet { background:linear-gradient(135deg,#ebfcf4,#ddf9ec) !important; color:#0E4A9E !important; }

@@media (max-width:1199px) { .salary-details-grid { grid-template-columns:repeat(2,minmax(0,1fr)) !important; } }
@@media (max-width:575px)  { .salary-details-panel { padding:14px !important; } .salary-details-grid { grid-template-columns:1fr !important; gap:12px !important; } .salary-detail-card { min-height:96px !important; padding:16px !important; } .salary-detail-icon { width:48px !important; height:48px !important; min-width:48px !important; flex-basis:48px !important; } .salary-detail-value { font-size:16px !important; } }

/* ══════════════════════════════════════════
   LEAVE MODERN CARDS
══════════════════════════════════════════ */
.leave-card-item .leave-modern-card { border:1px solid #E7F0FF !important; border-radius:18px !important; overflow:hidden !important; background:#fff !important; box-shadow:0 10px 28px rgba(15,42,29,.08) !important; transition:transform .2s ease,box-shadow .2s ease !important; height:100% !important; }
.leave-card-item .leave-modern-card:hover { transform:translateY(-3px); box-shadow:0 16px 36px rgba(15,42,29,.12) !important; }
.leave-modern-head { min-height:112px; padding:22px 24px; color:#fff; display:flex; align-items:flex-start; justify-content:space-between; gap:14px; }
.leave-modern-head.purple { background:linear-gradient(135deg,#6de5ad 0%,#0E4A9E 100%); }
.leave-modern-head.pink   { background:linear-gradient(135deg,#0E4A9E 0%,#0E4A9E 100%); }
.leave-modern-head.green  { background:linear-gradient(135deg,#21c978 0%,#039855 100%); }
.leave-modern-icon { width:58px; height:58px; border-radius:16px; border:1px solid rgba(255,255,255,.25); background:rgba(255,255,255,.10); display:inline-flex; align-items:center; justify-content:center; flex:0 0 58px; color:#fff; box-shadow:inset 0 0 0 1px rgba(255,255,255,.08); }
.leave-modern-icon i { color:#fff !important; font-size:26px !important; line-height:1; }
.leave-modern-title { text-align:right; min-width:0; }
.leave-modern-title h4 { color:#fff !important; font-size:20px; font-weight:800; margin:0 0 8px; line-height:1.35; white-space:normal; overflow-wrap:anywhere; }
.leave-modern-title span { display:inline-flex; align-items:center; border-radius:8px; padding:4px 9px; background:rgba(255,255,255,.16); color:#fff; font-size:13px; font-weight:700; line-height:1.2; }
.leave-modern-body { padding:22px 24px 24px; }
.leave-modern-stats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; margin-bottom:22px; }
.leave-modern-stat { border-radius:14px; background:#F3F7FF; padding:18px 10px; text-align:center; min-height:88px; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.leave-modern-stat.tint-purple { background:#F3F7FF; }
.leave-modern-stat.tint-pink   { background:#F3F7FF; }
.leave-modern-stat.tint-green  { background:#eafaf2; }
.leave-modern-stat .num { display:block; font-size:26px; font-weight:900; line-height:1; color:#1f2937; }
.leave-modern-stat .num.purple { color:#0E4A9E; }
.leave-modern-stat .num.pink   { color:#0E4A9E; }
.leave-modern-stat .num.green  { color:#00a85a; }
.leave-modern-stat .label { display:block; margin-top:10px; color:#7e8aa8; font-size:12px; font-weight:700; line-height:1.35; }
.leave-modern-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; color:#7e8aa8; font-size:13px; font-weight:700; }
.leave-modern-row .leave-modern-row-label { display:inline-flex; align-items:center; gap:8px; min-width:0; white-space:normal; }
.leave-modern-row .leave-modern-row-label i { color:#97a2b8 !important; font-size:16px; }
.leave-modern-row strong { color:#11271d; font-size:14px; font-weight:800; white-space:nowrap; }
.leave-modern-badge { border-radius:9px; padding:5px 12px; font-size:12px; font-weight:800; white-space:nowrap; }
.leave-modern-badge.required { background:#fff4cc; color:#c27803; }
.leave-modern-badge.optional { background:#dff8e8; color:#079455; }
.leave-modern-actions { display:grid; grid-template-columns:1fr 52px; gap:12px; margin-top:20px; }
.leave-modern-details,.leave-modern-edit { border:none; height:44px; border-radius:14px; color:#fff !important; font-size:14px; font-weight:800; text-decoration:none !important; display:inline-flex; align-items:center; justify-content:center; gap:8px; cursor:pointer; transition:.18s ease; }
.leave-modern-edit { width:52px; border-radius:50%; padding:0; }
.leave-modern-details:hover,.leave-modern-edit:hover { transform:translateY(-1px); color:#fff !important; }
.leave-modern-details.purple,.leave-modern-edit.purple { background:linear-gradient(135deg,#6de5ad,#0E4A9E); box-shadow:0 8px 18px rgba(31,127,82,.24); }
.leave-modern-details.pink,.leave-modern-edit.pink { background:linear-gradient(135deg,#0E4A9E,#145DBF); box-shadow:0 8px 18px rgba(31,127,82,.24); }
.leave-modern-details.green,.leave-modern-edit.green { background:linear-gradient(135deg,#32d583,#039855); box-shadow:0 8px 18px rgba(3,152,85,.24); }
.leave-modern-details i,.leave-modern-edit i { color:#fff !important; font-size:17px; }

/* ══════════════════════════════════════════
   MODAL SIZES
══════════════════════════════════════════ */
#kt_policy_modal .modal-dialog { width:min(760px,calc(100vw - 32px)) !important; max-width:min(760px,calc(100vw - 32px)) !important; margin:16px auto !important; }
#kt_salary_modal .modal-dialog { width:min(1180px,calc(100vw - 32px)) !important; max-width:min(1180px,calc(100vw - 32px)) !important; margin:16px auto !important; }
#kt_leave_modal .modal-dialog  { width:min(900px,calc(100vw - 32px)) !important; max-width:min(900px,calc(100vw - 32px)) !important; margin:16px auto !important; }
#kt_attendance_modal .modal-dialog { width:min(1080px,calc(100vw - 32px)) !important; max-width:min(1080px,calc(100vw - 32px)) !important; margin:16px auto !important; }

#kt_policy_modal .modal-content,
#kt_salary_modal .modal-content,
#kt_leave_modal .modal-content,
#kt_attendance_modal .modal-content {
    max-height:calc(100vh - 32px) !important; display:flex !important; flex-direction:column !important;
    border-radius:22px !important; border:0 !important; background:#fff !important;
    overflow:hidden !important; box-shadow:0 24px 70px rgba(15,42,29,.16) !important;
}
#kt_policy_modal .modal-body,
#kt_salary_modal .salary-modal-body,
#kt_leave_modal .salary-modal-body,
#kt_attendance_modal .att-modal-body {
    flex:1 1 auto !important; overflow-y:auto !important; overflow-x:hidden !important;
}

/* ══════════════════════════════════════════
   ATTENDANCE MODAL — COMPLETE REDESIGN
══════════════════════════════════════════ */
.att-modal-body {
    padding:0 !important;
    background:#F3F7FF !important;
}

/* Tab bar */
.att-tab-bar {
    display:flex;
    background:#fff;
    border-bottom:1.5px solid #E7F0FF;
    padding:0 24px;
    gap:0;
}
.att-tab-btn {
    display:inline-flex; align-items:center; gap:8px;
    padding:14px 20px;
    font-size:13px; font-weight:700;
    color:#8b94ad;
    border:none; background:none; cursor:pointer;
    border-bottom:2.5px solid transparent;
    transition:all .18s ease;
    white-space:nowrap;
}
.att-tab-btn:hover { color:#0E4A9E; }
.att-tab-btn.active { color:#0E4A9E; border-bottom-color:#0E4A9E; }
.att-tab-btn i { font-size:15px; }

/* Two-column layout */
.att-layout {
    display:grid;
    grid-template-columns:1fr 260px;
    min-height:520px;
}
.att-main-col {
    padding:24px;
    overflow-y:auto;
}
.att-side-col {
    background:#fff;
    border-right:1.5px solid #E7F0FF;
    padding:20px 18px;
    display:flex;
    flex-direction:column;
    gap:14px;
}

/* Pane */
.att-pane { display:none; }
.att-pane.active { display:block; }

/* Section card */
.att-section {
    background:#fff;
    border-radius:16px;
    border:1.5px solid #E7F0FF;
    padding:18px 20px;
    margin-bottom:16px;
}
.att-section-head {
    display:flex; align-items:center; gap:10px;
    margin-bottom:16px; padding-bottom:12px;
    border-bottom:1px dashed #D0E1FF;
}
.att-section-icon {
    width:36px; height:36px; border-radius:10px;
    display:inline-flex; align-items:center; justify-content:center;
    flex:0 0 auto;
}
.att-section-icon.blue   { background:#edfcf5; color:#0E4A9E; }
.att-section-icon.orange { background:#fff4e0; color:#f59e0b; }
.att-section-icon.green  { background:#e9f9ef; color:#18a45b; }
.att-section-title { font-size:13.5px; font-weight:900; color:#0B3D91; margin:0; }
.att-section-note  { font-size:11.5px; font-weight:600; color:#8b94ad; margin-top:2px; }

/* ═══ TIME PICKER ═══ */
.att-time-grid {
    display:grid;
    grid-template-columns:1fr 28px 1fr;
    gap:10px;
    align-items:center;
    margin-bottom:16px;
}
.att-time-sep {
    text-align:center; font-size:20px; font-weight:300;
    color:#a1aab8; padding-top:22px;
}
.att-time-label {
    font-size:11px; font-weight:700; color:#8b94ad;
    text-align:center; margin-bottom:6px;
    text-transform:uppercase; letter-spacing:.04em;
}
.att-time-box {
    background:#F3F7FF;
    border:1.5px solid #D0E1FF;
    border-radius:14px;
    padding:12px 10px 8px;
    text-align:center;
    cursor:pointer;
    transition:all .18s ease;
    user-select:none;
    position:relative;
}
.att-time-box:hover {
    border-color:#0E4A9E;
    background:#F3F7FF;
}
.att-time-box.active {
    border-color:#0E4A9E;
    box-shadow:0 0 0 3px rgba(31,127,82,.12);
}
.att-time-value {
    font-size:28px; font-weight:900;
    color:#0B3D91; line-height:1;
    letter-spacing:-1px;
}
.att-time-ampm {
    font-size:12px; font-weight:700;
    color:#8b94ad; margin-top:4px;
}
.att-time-edit-hint {
    position:absolute; top:6px; left:8px;
    font-size:10px; color:#a1aab8;
}

/* Time Picker Popup */
.att-tp-popup {
    display:none;
    background:#fff;
    border:1.5px solid #D0E1FF;
    border-radius:18px;
    padding:18px 20px 14px;
    margin-top:8px;
    box-shadow:0 12px 32px rgba(15,42,29,.12);
    position:relative;
    z-index:10;
}
.att-tp-popup.show { display:block; }
.att-tp-popup-title {
    text-align:center; font-size:12px; font-weight:700;
    color:#8b94ad; margin-bottom:14px; text-transform:uppercase; letter-spacing:.04em;
}
.att-tp-inner {
    display:flex; align-items:center; justify-content:center; gap:12px;
}
.att-tp-col { text-align:center; }
.att-tp-col-label {
    font-size:10px; font-weight:700; color:#a1aab8;
    text-transform:uppercase; letter-spacing:.04em; margin-bottom:6px;
}
.att-tp-spin-btn {
    width:36px; height:34px;
    border:1.5px solid #D0E1FF;
    border-radius:8px;
    background:#F3F7FF;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    transition:all .15s ease;
    font-size:12px; color:#5e6278;
}
.att-tp-spin-btn:hover {
    background:#0E4A9E; border-color:#0E4A9E; color:#fff;
}
.att-tp-display {
    font-size:32px; font-weight:900; color:#0B3D91;
    line-height:1; min-width:58px; text-align:center;
    padding:6px 0;
}
.att-tp-colon {
    font-size:34px; font-weight:300; color:#c8cfe0;
    padding-top:4px; line-height:1;
}
.att-tp-ampm-wrap {
    display:flex; flex-direction:column; gap:6px;
}
.att-tp-ampm-btn {
    width:44px; height:36px;
    border:1.5px solid #D0E1FF;
    border-radius:8px;
    background:#F3F7FF;
    cursor:pointer;
    font-size:13px; font-weight:700; color:#8b94ad;
    transition:all .15s ease;
}
.att-tp-ampm-btn.active {
    background:#0E4A9E; border-color:#0E4A9E; color:#fff;
}
.att-tp-actions {
    display:flex; gap:8px; margin-top:14px;
}
.att-tp-cancel {
    flex:1; padding:9px 0;
    border:1.5px solid #D0E1FF; border-radius:10px;
    background:#F3F7FF; cursor:pointer;
    font-size:13px; font-weight:600; color:#5e6278;
}
.att-tp-apply {
    flex:2; padding:9px 0;
    border:none; border-radius:10px;
    background:linear-gradient(135deg,#0E4A9E,#145DBF);
    cursor:pointer; font-size:13px; font-weight:700; color:#fff;
    box-shadow:0 4px 12px rgba(31,127,82,.28);
    transition:transform .15s ease;
}
.att-tp-apply:hover { transform:translateY(-1px); }

/* Time Bar Visualization */
.att-time-bar-wrap {
    background:#F3F7FF;
    border-radius:12px;
    padding:14px 16px 10px;
    margin-bottom:16px;
    border:1.5px solid #E7F0FF;
}
.att-time-bar-title {
    font-size:11px; font-weight:700; color:#8b94ad;
    margin-bottom:10px; text-transform:uppercase; letter-spacing:.04em;
}
.att-time-bar-track {
    position:relative; height:10px;
    background:#ddf0e7; border-radius:5px;
    overflow:hidden;
}
.att-time-bar-seg {
    position:absolute; top:0; height:100%;
    border-radius:0;
    transition:all .4s cubic-bezier(.34,1.56,.64,1);
}
.att-time-bar-seg.seg-before  { background:#FAC775; }
.att-time-bar-seg.seg-work    { background:#0E4A9E; }
.att-time-bar-seg.seg-after   { background:#86eabb; }
.att-time-bar-ticks {
    display:flex; justify-content:space-between;
    margin-top:6px; font-size:10px; color:#a1aab8; font-weight:600;
}
.att-time-bar-legend {
    display:flex; gap:14px; flex-wrap:wrap; margin-top:10px;
}
.att-time-bar-legend-item {
    display:flex; align-items:center; gap:5px;
    font-size:11px; color:#8b94ad; font-weight:600;
}
.att-time-bar-legend-dot {
    width:8px; height:8px; border-radius:2px; flex-shrink:0;
}

/* Input group */
.att-input-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}
.att-field-label {
    font-size:11.5px; font-weight:700; color:#64748b;
    margin-bottom:6px; display:block;
}
.att-field-label .required-star { color:#ef4444; }
.att-number-input {
    width:100%; box-sizing:border-box;
    border:1.5px solid #D0E1FF; border-radius:12px;
    background:#F3F7FF; color:#0B3D91;
    font-size:14px; font-weight:700;
    padding:10px 14px; text-align:center;
    transition:border-color .18s ease, box-shadow .18s ease;
}
.att-number-input:focus {
    outline:none;
    border-color:#0E4A9E;
    box-shadow:0 0 0 3.5px rgba(31,127,82,.12);
    background:#fff;
}
.att-number-input.is-invalid {
    border-color:#ef4444;
    box-shadow:0 0 0 3px rgba(239,68,68,.1);
}
.att-field-unit {
    font-size:11px; color:#a1aab8; font-weight:600;
    margin-top:4px; text-align:center;
}
.att-err-msg {
    display:none; font-size:11px; color:#ef4444;
    margin-top:4px; font-weight:600;
}

/* Weekday Picker */
.att-weekday-grid {
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:6px;
    margin-bottom:8px;
}
.att-day-btn {
    border-radius:10px;
    border:1.5px solid #D0E1FF;
    background:#F3F7FF;
    padding:10px 4px 8px;
    text-align:center;
    cursor:pointer;
    transition:all .18s ease;
    user-select:none;
}
.att-day-btn:hover {
    border-color:#0E4A9E;
    background:#F3F7FF;
}
.att-day-btn.active {
    border-color:#0E4A9E !important;
    background:#0E4A9E !important;
}
.att-day-btn .day-check {
    width:18px; height:18px; border-radius:50%;
    background:#D0E1FF;
    display:flex; align-items:center; justify-content:center;
    margin:0 auto 5px;
    font-size:10px; color:#a1aab8;
    transition:all .18s ease;
}
.att-day-btn.active .day-check {
    background:rgba(255,255,255,.28);
    color:#fff;
}
.att-day-btn .day-label {
    font-size:10.5px; font-weight:700; color:#5e6278; line-height:1;
}
.att-day-btn.active .day-label { color:#fff; }
.att-weekday-summary {
    font-size:12px; font-weight:700;
    color:#18a45b; margin-top:6px;
}

/* Break time */
.att-break-grid {
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:10px;
}
.att-break-time-box {
    background:#F3F7FF;
    border:1.5px solid #D0E1FF;
    border-radius:12px;
    padding:10px;
    text-align:center;
    cursor:pointer;
    transition:all .18s ease;
    font-size:14px; font-weight:700; color:#0B3D91;
}
.att-break-time-box:hover {
    border-color:#f59e0b;
    background:#fffbf0;
}
.att-break-time-box.active {
    border-color:#f59e0b;
    box-shadow:0 0 0 3px rgba(245,158,11,.12);
}
.att-break-label {
    font-size:10px; font-weight:700; color:#a1aab8;
    margin-bottom:4px; text-transform:uppercase; letter-spacing:.04em;
}

/* Side panel summary cards */
.att-summary-header {
    font-size:12px; font-weight:800; color:#0B3D91;
    display:flex; align-items:center; gap:6px; margin-bottom:4px;
}
.att-summary-header i { color:#0E4A9E !important; font-size:14px; }
.att-stat-card {
    background:#F3F7FF;
    border-radius:12px;
    border:1.5px solid #E7F0FF;
    padding:12px 14px;
    display:flex; align-items:center; justify-content:space-between;
}
.att-stat-label { font-size:11.5px; font-weight:700; color:#7e8aa8; }
.att-stat-value { font-size:13.5px; font-weight:900; color:#0B3D91; }
.att-stat-value.blue   { color:#0E4A9E; }
.att-stat-value.green  { color:#18a45b; }
.att-stat-value.amber  { color:#f59e0b; }
.att-stat-value.red    { color:#ef4444; }

/* Donut */
.att-donut-wrap {
    position:relative;
    width:130px; height:130px;
    margin:0 auto 12px;
}
.att-donut-wrap canvas { display:block; }
.att-donut-center {
    position:absolute; inset:0;
    display:flex; flex-direction:column;
    align-items:center; justify-content:center;
}
.att-donut-val { font-size:20px; font-weight:900; color:#0B3D91; line-height:1; }
.att-donut-unit { font-size:10px; font-weight:700; color:#8b94ad; margin-top:3px; }
.att-donut-legend { display:flex; flex-direction:column; gap:6px; }
.att-donut-legend-item {
    display:flex; align-items:center;
    justify-content:space-between; gap:8px;
}
.att-donut-legend-dot {
    width:8px; height:8px; border-radius:2px; flex-shrink:0;
}
.att-donut-legend-label { font-size:11px; color:#8b94ad; font-weight:600; flex:1; }
.att-donut-legend-val { font-size:11px; font-weight:800; color:#0B3D91; }

/* Modal footer */
.att-modal-footer {
    padding:14px 24px 20px !important;
    border-top:1.5px solid #E7F0FF !important;
    background:#fff !important;
    display:flex !important; gap:10px !important;
}

/* Responsive */
@@media (max-width:991px) {
    .att-layout { grid-template-columns:1fr !important; }
    html[dir="rtl"] .att-side-col{
    border-right:1.5px solid #E7F0FF;
    border-left:none;
}

html[dir="ltr"] .att-side-col{
    border-left:1.5px solid #E7F0FF;
    border-right:none;
}
    #kt_attendance_modal .modal-dialog { width:calc(100vw - 20px) !important; max-width:calc(100vw - 20px) !important; }
}
@@media (max-width:767px) {
    .att-input-grid { grid-template-columns:1fr !important; }
    .att-break-grid { grid-template-columns:1fr 1fr !important; }
    .att-weekday-grid { grid-template-columns:repeat(7,1fr) !important; gap:4px !important; }
    .att-day-btn .day-label { font-size:9px !important; }
    .att-time-value { font-size:22px !important; }
}

