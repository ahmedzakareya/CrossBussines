                                                var css='#kt_attendance_modal .att-timebar-track{position:relative}'
                                                  +'#kt_attendance_modal .att-now-line{position:absolute;top:0;bottom:0;width:2px;background:#ef4444;border-radius:2px;z-index:7;box-shadow:0 0 6px rgba(239,68,68,.55);pointer-events:none}'
                                                  +'#kt_attendance_modal .att-now-line:after{content:"";position:absolute;top:3px;right:-4px;width:10px;height:10px;border-radius:50%;background:#ef4444;border:2px solid #fff}';
                                                var st=document.createElement('style'); st.textContent=css; document.head.appendChild(st);
                                                function place(){
                                                    var track=document.querySelector('#kt_attendance_modal .att-timebar-track'); if(!track) return;
                                                    var line=track.querySelector('.att-now-line');
                                                    var n=new Date(), mins=n.getHours()*60+n.getMinutes();
                                                    if(mins<WS||mins>WE){ if(line) line.remove(); return; }
                                                    if(!line){ line=document.createElement('div'); line.className='att-now-line'; track.appendChild(line); }
                                                    line.style.right=(((mins-WS)/(WE-WS))*100)+'%';
                                                }
                                                place(); setInterval(place, 30000);
                                            })();
