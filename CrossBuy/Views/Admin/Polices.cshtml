    var attModernPicker = { el:null, input:null, hour:8, minute:0 };
    var attModernHold = { timeout:null, interval:null, button:null, suppressClick:false };

    function attModernStopHold(){
        if(attModernHold.timeout){ clearTimeout(attModernHold.timeout); attModernHold.timeout=null; }
        if(attModernHold.interval){ clearInterval(attModernHold.interval); attModernHold.interval=null; }
        if(attModernHold.button){ attModernHold.button.classList.remove('is-holding'); attModernHold.button=null; }
    }

    function attModernStartHold(btn,e){
        if(!btn) return;
        if(e){ e.preventDefault(); e.stopPropagation(); }

        attModernStopHold();

        var unit = btn.getAttribute('data-att-unit');
        var delta = parseInt(btn.getAttribute('data-att-delta'),10) || 0;
        if(!unit || !delta) return;

        attModernHold.button = btn;
        attModernHold.suppressClick = true;
        btn.classList.add('is-holding');

        // First step happens immediately, like mobile controls.
        attModernAdjust(unit, delta);

        // Then repeat smoothly while the user keeps pressing.
        attModernHold.timeout = window.setTimeout(function(){
            attModernHold.interval = window.setInterval(function(){
                attModernAdjust(unit, delta);
            }, 95);
        }, 360);
    }
    function attNormalizeTime(v){
        v=String(v||'').trim().replace('.',':').replace('-',':');
        if(/^\d{1,2}$/.test(v)) v=attPad(parseInt(v,10))+':00';
        var m=v.match(/^(\d{1,2}):(\d{1,2})$/);
        if(!m) return '';
        var h=Math.max(0,Math.min(23,parseInt(m[1],10)||0));
        var mi=Math.max(0,Math.min(59,parseInt(m[2],10)||0));
        return attPad(h)+':'+attPad(mi);
    }
    function attEnsureModernPicker(){
