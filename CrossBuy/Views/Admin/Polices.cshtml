    var RequiredConfirm    = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(CrossBuy.Resources.SharedResources.RequiredConfirm))';
window.saveAttendanceModal = function () {
    if (attendanceBusy) return;
 
    /* ── جمع القيم الخام ── */
    var id         = parseInt(document.getElementById('att_modal_id').value        || '0', 10) || 0;
    var policyId   = parseInt(document.getElementById('att_modal_policy_id').value || '0', 10) || 0;
 
    var graceRaw   = document.getElementById('att_grace_minutes').value.trim();
    var warningRaw = document.getElementById('att_warning_threshold').value.trim();
    var deductRaw  = document.getElementById('att_deduction_rate').value.trim();
    var absenceRaw = document.getElementById('att_absence_threshold').value.trim();
 
    var grace      = graceRaw   !== '' ? parseInt(graceRaw,   10) : NaN;
    var warning    = warningRaw !== '' ? parseInt(warningRaw, 10) : NaN;
    var deduction  = deductRaw  !== '' ? parseFloat(deductRaw)    : NaN;
    var absence    = absenceRaw !== '' ? parseInt(absenceRaw, 10) : NaN;
 
    var workStart  = (document.getElementById('att_work_start').value || '').trim();
    var workEnd    = (document.getElementById('att_work_end').value   || '').trim();
    var workHours  = parseFloat(document.getElementById('att_work_hours').value || '0') || 0;
    var workDays   = attWdSelected.size;
    var bmin       = parseInt(document.getElementById('att_break_minutes').value || '0', 10) || 0;
    var bstart     = bmin ? (document.getElementById('att_break_start').value || null) : null;
    var bend       = bmin ? (document.getElementById('att_break_end').value   || null) : null;
 
    /* ── التحقق ── */
    var valid       = true;
    var firstErrTab = null;
 
    function setErrAtt(inputId, errId, cond, tab) {
        var inp = document.getElementById(inputId);
        var err = document.getElementById(errId);
        if (inp) inp.classList.toggle('is-invalid', cond);
        if (err) err.style.display = cond ? 'block' : 'none';
        if (cond) {
            valid = false;
            if (tab && !firstErrTab) firstErrTab = tab;
        }
    }
 
    // تاب "Working hours"
    setErrAtt('att_work_start', 'att_err_hours',
        !workStart || !/^\d{2}:\d{2}$/.test(workStart), 'work');
 
    setErrAtt('att_work_end', 'att_err_hours',
        !workEnd || !/^\d{2}:\d{2}$/.test(workEnd), 'work');
 
    // ساعات العمل المحسوبة > 0
    if (workHours <= 0) {
        var hoursErr = document.getElementById('att_err_hours');
        if (hoursErr) hoursErr.style.display = 'block';
        valid = false;
        if (!firstErrTab) firstErrTab = 'work';
    } else {
        var hoursErrHide = document.getElementById('att_err_hours');
        if (hoursErrHide) hoursErrHide.style.display = 'none';
    }
 
    // تاب "Working days"
    var daysErr = document.getElementById('att_err_days');
    if (workDays < 1) {
        if (daysErr) daysErr.style.display = 'block';
        valid = false;
        if (!firstErrTab) firstErrTab = 'days';
    } else {
        if (daysErr) daysErr.style.display = 'none';
    }
 
    // تاب "Lateness and deductions"
    setErrAtt('att_grace_minutes',      'att_err_grace',
        isNaN(grace)    || grace    < 0, 'rules');
 
    setErrAtt('att_warning_threshold',  'att_err_warning',
        isNaN(warning)  || warning  < 1, 'rules');
 
    setErrAtt('att_deduction_rate',     'att_err_deduction',
        isNaN(deduction)|| deduction < 0, 'rules');
 
    setErrAtt('att_absence_threshold',  'att_err_absence',
        isNaN(absence)  || absence  < 0, 'rules');
 
    // لو فيه أخطاء في التابات الأساسية → اذهب لأول تاب به خطأ
    if (!valid) {
        if (firstErrTab && window.attShowPolicyTab) {
            window.attShowPolicyTab(firstErrTab);
        }
        KtToast.error(RequiredConfirm);
        return;
    }
 
    // تحقق من حقول الاستئذان (لها منطقها الخاص)
    if (!attValidatePermissionPolicy()) return;
 
    /* ── بناء الموديل وإرساله ── */
    var model = {
        ID:                             id,
        LeavePolicyTypeID:              policyId,
        AllowedGraceMinutes:            grace,
        WarningThresholdCount:          warning,
        DeductionRatePerOccurrence:     deduction,
        UnexcusedAbsenceThreshold:      absence,
        WorkStartTime:                  workStart,
        WorkEndTime:                    workEnd,
        WorkHoursPerDay:                workHours,
        WorkDaysPerWeek:                workDays,
        BreakStartTime:                 bstart || null,
        BreakEndTime:                   bend   || null,
        BreakDurationMinutes:           bmin,
        WorkOnSunday:                   attWdSelected.has('sun'),
        WorkOnMonday:                   attWdSelected.has('mon'),
        WorkOnTuesday:                  attWdSelected.has('tue'),
