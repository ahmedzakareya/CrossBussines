    function attPad(n){return String(n).padStart(2,'0');}
    function attTimeToMin(v){
        if(!v || String(v).indexOf(':')<0) return 0;
        var p=String(v).split(':');
        return (parseInt(p[0],10)||0)*60+(parseInt(p[1],10)||0);
    }
    function attMinToText(min){
        min=Math.max(0,parseInt(min||0,10)||0);
        var h=Math.floor(min/60),m=min%60;
        return attPad(h)+':'+attPad(m);
    }
    function attDecimalHours(min){return Math.round((Math.max(0,min)/60)*100)/100;}
