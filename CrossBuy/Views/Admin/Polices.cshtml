                                                                                        data-att-max-perm-min-day="@att.MaxPermissionMinutesPerDay"
                                                                                        data-att-max-perm-min-week="@att.MaxPermissionMinutesPerWeek"
                                                                                        data-att-max-perm-min-month="@att.MaxPermissionMinutesPerMonth"
