/* =========================================================
   ATTENDANCE MODAL — MODERN TIME PICKER PATCH
   Replaces the browser/native clock picker with a clean Metronic inline picker.
========================================================= */
#kt_attendance_modal .att-modern-time-input {
    cursor:pointer !important;
    letter-spacing:.04em !important;
    text-align:center !important;
    direction:ltr !important;
    font-variant-numeric:tabular-nums !important;
}
#kt_attendance_modal .att-modern-time-input::placeholder { color:#9aa4b8 !important; }
.att-modern-time-popover {
    position:fixed;
    z-index:2147483000;
    width:320px;
    max-width:calc(100vw - 24px);
    border:1px solid #e6f5ee;
    border-radius:18px;
    background:#fff;
    box-shadow:0 20px 55px rgba(15,42,29,.18);
    padding:16px;
    direction:ltr;
    display:none;
    transform-origin:top center;
    animation:attModernTimeIn .16s ease-out;
}
.att-modern-time-popover.show { display:block; }
@@keyframes attModernTimeIn { from{opacity:0;transform:translateY(-6px) scale(.98);} to{opacity:1;transform:translateY(0) scale(1);} }
.att-modern-time-head { display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px;direction:rtl; }
.att-modern-time-title { font-size:13px;font-weight:900;color:#0B3D91;line-height:1.2; }
.att-modern-time-sub { font-size:11px;font-weight:700;color:#8b94ad;margin-top:3px; }
.att-modern-time-close { width:30px;height:30px;border:0;border-radius:10px;background:#F3F7FF;color:#64748b;display:flex;align-items:center;justify-content:center;cursor:pointer; }
.att-modern-time-close:hover { background:#edfcf5;color:#0E4A9E; }
.att-modern-time-screen { display:grid;grid-template-columns:1fr 26px 1fr;align-items:center;gap:8px;margin-bottom:14px; }
.att-modern-time-box { border:1.5px solid #dff3ea;background:#F3F7FF;border-radius:16px;padding:12px 8px;text-align:center; }
.att-modern-time-box.active { border-color:#0E4A9E;box-shadow:0 0 0 4px rgba(31,127,82,.10);background:#fff; }
.att-modern-time-num { font-size:36px;font-weight:950;color:#0B3D91;line-height:1;font-variant-numeric:tabular-nums; }
.att-modern-time-lbl { font-size:11px;font-weight:800;color:#8b94ad;margin-top:6px;text-transform:uppercase;letter-spacing:.08em; }
.att-modern-time-colon { color:#9aa4b8;font-size:32px;font-weight:800;text-align:center;margin-top:-12px; }
.att-modern-time-controls { display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px; }
.att-modern-time-step { display:grid;grid-template-columns:1fr 1fr;gap:8px; }
.att-modern-time-btn { height:38px;border:1px solid #e6f5ee;border-radius:12px;background:#F3F7FF;color:#0B3D91;font-size:16px;font-weight:900;cursor:pointer;transition:.14s ease;display:flex;align-items:center;justify-content:center; }
#kt_attendance_modal .att-modern-time-btn.is-holding,
.att-modern-time-popover .att-modern-time-btn.is-holding{
    background:#0E4A9E !important;
    border-color:#0E4A9E !important;
    color:#fff !important;
    transform:translateY(-1px) scale(.98);
}

.att-modern-time-btn:hover { background:#0E4A9E;border-color:#0E4A9E;color:#fff;box-shadow:0 8px 18px rgba(31,127,82,.18); }
.att-modern-time-quick { display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;direction:rtl; }
.att-modern-time-chip { border:1px solid #e6f5ee;background:#F3F7FF;color:#64748b;border-radius:999px;padding:7px 10px;font-size:11.5px;font-weight:800;cursor:pointer;transition:.14s ease; }
.att-modern-time-chip:hover { border-color:#0E4A9E;background:#F3F7FF;color:#0E4A9E; }
.att-modern-time-chip.active { border-color:#0E4A9E;background:#0E4A9E;color:#fff;box-shadow:0 7px 16px rgba(31,127,82,.20); }
.att-modern-time-actions { display:flex;gap:10px;direction:rtl; }
.att-modern-time-cancel,.att-modern-time-apply { height:40px;border-radius:12px;font-size:13px;font-weight:900;cursor:pointer; }
.att-modern-time-cancel { flex:1;border:1.5px solid #e6f5ee;background:#fff;color:#64748b; }
.att-modern-time-cancel:hover { background:#F3F7FF; }
.att-modern-time-apply { flex:1.7;border:0;background:linear-gradient(135deg,#0E4A9E,#145DBF);color:#fff;box-shadow:0 8px 18px rgba(31,127,82,.24); }
.att-modern-time-apply:hover { transform:translateY(-1px); }

/* FIX: Time picker +/- controls must stay LTR even inside RTL modal */
.att-modern-time-popover { direction:ltr !important; unicode-bidi:isolate !important; }
.att-modern-time-screen,
.att-modern-time-controls,
.att-modern-time-step { direction:ltr !important; unicode-bidi:isolate !important; }
