            postJson(endpointAttendanceSave,model,function(res){
                if(res&&res.ok){bootstrap.Modal.getInstance(document.getElementById('kt_attendance_modal'))?.hide();KtToast.success(res.message||resSuccess);setTimeout(function(){location.reload();},1200);}
                else{KtToast.error((res&&res.message)||resError);}
                attendanceBusy=false;btn.disabled=false;btn.innerHTML=oh;
            },function(){KtToast.error(resError);attendanceBusy=false;btn.disabled=false;btn.innerHTML=oh;});
        };
        if(id>0){ktConfirm(ConfirmMSG,doIt);}else doIt();
    };

    attInitModernTimePickers(document);
    attInitEnterpriseUx();

    var attModalEl=document.getElementById('kt_attendance_modal');
    if(attModalEl){
        attModalEl.addEventListener('shown.bs.modal',function(){attInitModernTimePickers(attModalEl);attInitEnterpriseUx();attUpdatePreview();});
        ['input','change'].forEach(function(evt){
            attModalEl.addEventListener(evt,function(e){
                if(!e.target)return;
                if(e.target.id==='att_work_start_copy'||e.target.id==='att_work_end_copy'){attSyncWorkTimes('copy');}
                if(e.target.matches('input')){attMarkFieldUpdated(e.target);attUpdatePreview();}
            });
        });
    }

})();
</script>
