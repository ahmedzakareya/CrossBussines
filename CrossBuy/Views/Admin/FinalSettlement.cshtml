@using CrossBuy.Models.Context.Admin
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var emps = ViewBag.Employees as List<CrossBuy.ViewModel.EmployeeListItemDto> ?? new();
    int? selEmp = ViewBag.SelectedEmployee as int?;
    var pv = ViewBag.Preview as CrossBuy.BL.SettlementPreview;
    var sources = ViewBag.PaySources as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var history = ViewBag.Settlements as List<FinalSettlement> ?? new();
    DateTime termDate = ViewBag.TermDate is DateTime d ? d : DateTime.Today;
    var ci = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal v) => v.ToString("#,##0.00", ci);
    string empName(CrossBuy.ViewModel.EmployeeListItemDto e) => isAr ? (e.FullName ?? "") : (string.IsNullOrEmpty(e.FullNameEn) ? e.FullName : e.FullNameEn) ?? "";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid">
        <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Termination & final settlement"]</h1>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["HrErr"] != null) { <div class="alert alert-danger">@TempData["HrErr"]</div> }

        <div class="card card-flush mb-5"><div class="card-body py-5">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@SR["Employee"]</label>
                    <select name="employeeId" class="form-select form-select-solid" data-control="select2" onchange="this.form.submit()">
                        <option value="">@Localizer["Select employee…"]</option>
                        @foreach (var e in emps) { <option value="@e.ID" selected="@(selEmp == e.ID)">@empName(e)</option> }
                    </select></div>
                <div class="col-md-4"><label class="fw-semibold fs-7 mb-1">@Localizer["Termination date"]</label>
                    <input name="terminationDate" type="date" class="form-control form-control-solid" value="@termDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" /></div>
                <div class="col-md-2"><button class="btn btn-light-primary w-100">@Localizer["Compute"]</button></div>
            </form>
        </div></div>

        @if (selEmp.HasValue && pv != null)
        {
            if (pv.AlreadyTerminated)
            {
                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-4 mb-4">
                    <span class="symbol symbol-40px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-information-5 fs-2 text-primary"></i></span></span>
                    <div class="d-flex align-items-center fw-semibold fs-6 text-gray-700">@Localizer["This employee is already terminated (inactive)."]</div>
                </div>
            }
            <div class="row g-5">
                <div class="col-lg-5">
                    <div class="card card-flush h-100"><div class="card-header"><div class="card-title"><h2>@Localizer["Service summary"]</h2></div></div>
                        <div class="card-body pt-2">
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@Localizer["Join date"]</span><span class="fw-bold">@pv.JoinDate.ToString("yyyy-MM-dd")</span></div>
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@Localizer["Service years"]</span><span class="fw-bold">@Money(pv.ServiceYears)</span></div>
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@Localizer["Daily rate"]</span><span class="fw-bold">@Money(pv.DailyRate)</span></div>
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@Localizer["Encashable leave"]</span><span class="fw-bold">@pv.LeaveDays @Localizer["d"]</span></div>
                            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">@Localizer["Leave value"]</span><span class="fw-bold text-primary">@Money(pv.LeaveValue)</span></div>
                            <div class="d-flex justify-content-between py-3"><span class="text-muted">@Localizer["Suggested gratuity"]<span class="fs-8 d-block">@Localizer["({0} days/yr)", Money(pv.GratuityDaysPerYear)]</span></span><span class="fw-bold" style="color:#145DBF;">@Money(pv.SuggestedGratuity)</span></div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="card card-flush h-100"><div class="card-header"><div class="card-title"><h2>@Localizer["Post settlement"]</h2></div></div>
                        <div class="card-body pt-2">
                            <form asp-action="PostFinalSettlement" method="post" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["This terminates the employee and posts the settlement. Continue?"]">@Html.AntiForgeryToken()
                                <input type="hidden" name="employeeId" value="@selEmp" />
                                <input type="hidden" name="terminationDate" value="@termDate.ToString("yyyy-MM-dd")" />
                                <div class="row g-3">
                                    <div class="col-12"><label class="fw-semibold fs-7 mb-1">@Localizer["Reason"]</label><input name="reason" class="form-control form-control-solid" /></div>
                                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Gratuity"]</label><input name="gratuity" type="number" step="0.01" min="0" class="form-control form-control-solid" value="@pv.SuggestedGratuity.ToString("0.00", ci)" /></div>
                                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Other earnings"]</label><input name="otherEarnings" type="number" step="0.01" min="0" class="form-control form-control-solid" value="0" /></div>
                                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Deductions"]</label><input name="deductions" type="number" step="0.01" min="0" class="form-control form-control-solid" value="0" /></div>
                                    <div class="col-md-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Pay from"]</label><select name="payFromGlAccountId" class="form-select form-select-solid" required>@foreach (var s in sources){<option value="@s.GlAccountId">@s.Name</option>}</select></div>
                                </div>
                                <div class="text-muted fs-8 mt-3">@Localizer["Net = (leave + gratuity + other) − deductions. Dr settlement expenses / Cr bank. The employee is deactivated and their contract closed."]</div>
                                <button class="btn btn-danger w-100 mt-4" @(pv.AlreadyTerminated ? "disabled" : "")><i class="ki-outline ki-exit-right fs-3"></i>@Localizer["Terminate & post settlement"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else { <div class="card card-flush mb-5"><div class="card-body text-center text-muted py-10">@Localizer["Pick an employee to compute their settlement."]</div></div> }

        <div class="card card-flush mt-5"><div class="card-header"><div class="card-title"><h2>@Localizer["Recent settlements"]</h2></div></div>
            <div class="card-body pt-2">
                <div class="table-responsive">
                <table class="table align-middle fs-7 gy-3 mb-0" style="font-variant-numeric:tabular-nums;">
                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                        <th class="ps-4">@SR["Employee"]</th><th>@SR["Date"]</th><th class="text-end">@Localizer["Years"]</th><th class="text-end">@Localizer["Leave"]</th><th class="text-end">@Localizer["Gratuity"]</th><th class="text-end pe-4">@Localizer["Net"]</th></tr></thead>
                    <tbody class="fw-semibold text-gray-700">
                    @foreach (var s in history)
                    {
                        <tr style="border-bottom:1px dashed #eef1f6;">
                            <td class="ps-4 fw-bold text-gray-800">@s.EmployeeName</td>
                            <td class="text-gray-700">@s.TerminationDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@Money(s.ServiceYears)</td>
                            <td class="text-end @(s.LeaveValue > 0 ? "" : "text-gray-300")">@(s.LeaveValue > 0 ? Money(s.LeaveValue) : "—")</td>
                            <td class="text-end @(s.Gratuity > 0 ? "" : "text-gray-300")">@(s.Gratuity > 0 ? Money(s.Gratuity) : "—")</td>
                            <td class="text-end pe-4 fw-bolder" style="color:#0E4A9E;">@Money(s.NetSettlement)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
                @if (!history.Any()) { <div class="text-center text-muted py-5">@Localizer["No settlements yet."]</div> }
            </div>
        </div>
    </div></div>
</div>
