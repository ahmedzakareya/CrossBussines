    $(document).on('click',function(){ $('#treeActionMenu').hide(); });

    /* ── add item ── */
    $('#addItem').on('click',function(){
        var parentId=$('#treeActionMenu').data('nodeId');
        $.ajax({ url:'/Admin/GetParentInfo', method:'GET', data:{parentId:parentId},
            success:function(r){ if(r.success){ $('#parentNameAr').val(r.nameAr); $('#parentNameEn').val(r.nameEn); $('#itemNameAr,#itemNameEn,#notes').val(''); $('#addItemModal').data('parentId',parentId).modal('show'); } else alert('@Localizer["Failed to load parent data."]'); },
            error:function(){ alert('@Localizer["An error occurred."]'); }
        });
    });
    $('#editItem').on('click',function(){ console.log('Edit:',  $('#treeActionMenu').data('nodeId')); });

    /* ── save ── */
    $('#saveItemBtn').on('click',function(){
        var parentId=$('#addItemModal').data('parentId');
        var nameAr=$('#itemNameAr').val(), nameEn=$('#itemNameEn').val(), notes=$('#notes').val();
        if(!nameAr||!nameEn){ alert('@Localizer["Please fill in all required fields."]'); return; }
        $.ajax({ url:'/Admin/AddHierarchicalItem', method:'POST', data:{parentId:parentId,nameAr:nameAr,nameEn:nameEn,notes:notes},
            success:function(r){ if(r.success){ $('#addItemModal').modal('hide'); Swal.fire({icon:'success',title:'@Localizer["Saved"]',showConfirmButton:false,timer:1500}).then(function(){ location.reload(); }); } else Swal.fire({icon:'error',title:'@Localizer["Add failed"]',text:r.message}); },
            error:function(){ Swal.fire({icon:'error',title:'@Localizer["An error occurred"]',text:'@Localizer["Could not save the item."]'}); }
        });
    });

    /* ── tab shown ── */
    $('a[href="#modernOrgTab"]').on('shown.bs.tab',function(){ setTimeout(fitOrgChart,220); });

    /* ── load data ── */
    $.ajax({ url:'/Admin/GetHierarchicals', method:'GET',
        success:function(response){
            hierarchicalItemsCache=response||[];

            var treeData=hierarchicalItemsCache.map(function(item){
                return { id:item.h_ID.toString(), parent:item.h_Parent==null?'#':item.h_Parent.toString(),
                    text:'<a href="javascript:;" class="text-dark fw-bold">'+(item.h_Name||'')+'</a>',
                    icon:getTreeIconClass(item), state:{opened:item.h_Parent==null} };
            });

            $('#kt_docs_jstree_customicons').jstree({
                core:{data:treeData,themes:{responsive:true}},
                types:{default:{icon:'ki-outline ki-folder fs-3 text-muted'},file:{icon:'ki-outline ki-file text-warning'}},
                plugins:['types','search']
            });
            $('#kt_docs_jstree_customicons').on('select_node.jstree',function(e,data){ $('#treeActionMenu').data('nodeId',data.node.id); });
            $('#kt_docs_jstree_customicons').on('contextmenu','.jstree-anchor',function(e){ openTreeActionMenu(e,$('#kt_docs_jstree_customicons').jstree(true).get_node($(this)).id); });

            renderOrgChart(hierarchicalItemsCache);
            renderFlowChart(hierarchicalItemsCache);
        }
    });

});
</script>
