        +'<ellipse cx="40" cy="76" rx="22" ry="4" fill="rgba(0,0,0,0.12)"/>'
        +'<rect x="16" y="20" width="48" height="50" rx="6" fill="'+m+'"/>'
        +'<rect x="16" y="20" width="48" height="11" rx="6" fill="'+li+'" opacity=".5"/>'
        +'<rect x="33" y="13" width="14" height="9" rx="2" fill="'+sh+'"/>'
        +'<circle cx="40" cy="41" r="9" fill="'+li+'"/>'
        +'<path d="M27 62 Q27 50 40 50 Q53 50 53 62 Z" fill="'+li+'"/>'
        +'</svg>';
}
function iconEmployeeSVG(c,sz){
    sz=sz||70; var m=c.main,sh=c.shadow,li=c.light;
    return '<svg width="'+sz+'" height="'+sz+'" viewBox="0 0 80 80" style="display:block">'
        +'<ellipse cx="40" cy="76" rx="22" ry="4" fill="rgba(0,0,0,0.12)"/>'
        +'<circle cx="40" cy="30" r="14" fill="'+m+'"/>'
        +'<circle cx="40" cy="30" r="14" fill="'+li+'" opacity=".25"/>'
        +'<path d="M16 70 Q16 47 40 47 Q64 47 64 70 Z" fill="'+m+'"/>'
        +'<path d="M16 70 Q16 47 40 47 Q64 47 64 70 Z" fill="'+sh+'" opacity=".2"/>'
        +'</svg>';
}
function getIconSVG(item,sz){
    var t=getHType(item),c=getCol(item);
    // a real uploaded photo wins over the generic icon (employee / company / branch)
    var img=item.image||item.Image||item.imageUrl;
    if(img){
        var s=sz||70;
        return '<img src="'+img+'" alt="" style="width:'+s+'px;height:'+s+'px;border-radius:50%;object-fit:cover;display:block;border:2px solid '+c.light+'" onerror="this.style.display=\'none\'" />';
    }
    return t===1?iconCompanySVG(c,sz):t===2?iconBranchSVG(c,sz):t===4?iconPositionSVG(c,sz):t===5?iconEmployeeSVG(c,sz):iconAdminSVG(c,sz);
}
function getLegendIconSVG(type){
    var c=COLORS[type];
    return type===1?iconCompanySVG(c,30):type===2?iconBranchSVG(c,30):iconAdminSVG(c,30);
}
function platformSVG(col,w,h){
    w=w||92;h=h||20;
    var c=col.platform,sh=col.shadow,li=col.light,hw=w*.5,sk=h*.55;
    return '<svg width="'+w+'" height="'+(h+sk)+'" viewBox="0 0 '+w+' '+(h+sk)+'" style="display:block">'
        +'<path d="M'+hw+' 0 L'+w+' '+(sk*.6)+' L'+hw+' '+(h*.7)+' L0 '+(sk*.6)+' Z" fill="'+li+'"/>'
        +'<path d="M'+w+' '+(sk*.6)+' L'+hw+' '+(h*.7)+' L'+hw+' '+(h+sk)+' L'+w+' '+h+' Z" fill="'+sh+'"/>'
        +'<path d="M0 '+(sk*.6)+' L'+hw+' '+(h*.7)+' L'+hw+' '+(h+sk)+' L0 '+h+' Z" fill="'+c+'"/>'
        +'</svg>';
}

/* ══════════════════════════════════════════════════════════
   DATA HELPERS
══════════════════════════════════════════════════════════ */
function getChildren(data,parentId){
    return data.filter(function(x){
        if(parentId===null) return x.h_Parent==null;
        return x.h_Parent!=null && x.h_Parent.toString()===parentId.toString();
    });
}
function escapeHtml(v)          { return $('<div/>').text(v||'').html(); }
function normalizeText(v)        { return (v||'').toString().toLowerCase().trim(); }
function getSearchableText(item) { return [item.h_Name,item.h_NameEn,item.h_Name_en].filter(Boolean).join(' '); }

function collectRelatedIds(data,query){
    var q=normalizeText(query); if(!q) return null;
    var ids=new Set(),byId={};
    data.forEach(function(x){ byId[x.h_ID]=x; });
    function addAncestors(item){ var cur=item; while(cur&&cur.h_Parent!=null){ var par=byId[cur.h_Parent]; if(!par)break; ids.add(par.h_ID); cur=par; } }
    function addChildren(pid) { getChildren(data,pid).forEach(function(c){ ids.add(c.h_ID); addChildren(c.h_ID); }); }
    data.forEach(function(x){ if(normalizeText(getSearchableText(x)).indexOf(q)>-1){ ids.add(x.h_ID); addAncestors(x); addChildren(x.h_ID); } });
    return ids;
}
function getFilteredData(data,query){
    var ids=collectRelatedIds(data,query);
    return ids ? data.filter(function(x){ return ids.has(x.h_ID); }) : data;
}
function updateSearchCounter(total,visible,query){
    var label=query?(visible+' / '+total):'@Localizer["All units"]';
    $('#asSearchCount').html('<i class="ki-outline ki-chart-simple fs-5"></i>'+label);
}

/* ══════════════════════════════════════════════════════════
   ORG CHART — TREE LAYOUT
══════════════════════════════════════════════════════════ */
function treeWidth(data,id){
    var c=getChildren(data,id); if(!c.length) return NW;
    var tot=c.reduce(function(s,x){ return s+treeWidth(data,x.h_ID); },0)+H_GAP*(c.length-1);
    return Math.max(NW,tot);
}
function layoutNode(data,id,x,y){
    ocPositions[id]={x:x,y:y};
    var c=getChildren(data,id); if(!c.length) return;
    var tot=c.reduce(function(s,x){ return s+treeWidth(data,x.h_ID); },0)+H_GAP*(c.length-1);
    var cx=x+NW/2-tot/2;
    c.forEach(function(n){ var w=treeWidth(data,n.h_ID); layoutNode(data,n.h_ID,cx+w/2-NW/2,y+NH+V_GAP); cx+=w+H_GAP; });
}

function getPositionBounds(positions){
    var minX=Infinity,minY=Infinity,maxX=0,maxY=0,has=false;
    Object.keys(positions||{}).forEach(function(k){
        var p=positions[k]; if(!p) return;
        has=true;
        minX=Math.min(minX,p.x);
        minY=Math.min(minY,p.y);
        maxX=Math.max(maxX,p.x+NW);
        maxY=Math.max(maxY,p.y+NH);
    });
    return has ? {minX:minX,minY:minY,maxX:maxX,maxY:maxY} : {minX:0,minY:0,maxX:0,maxY:0};
}

function normalizeChartPositions(positions){
    var b=getPositionBounds(positions);
    var shiftX = b.minX < PAD ? (PAD - b.minX) : 0;
    var shiftY = b.minY < PAD ? (PAD - b.minY) : 0;

    if(shiftX || shiftY){
        Object.keys(positions||{}).forEach(function(k){
            positions[k].x += shiftX;
            positions[k].y += shiftY;
        });
        b=getPositionBounds(positions);
    }

    return b;
}

function updateOrgSummary(data){
    var c1=0,c2=0,c3=0;
    data.forEach(function(x){ var t=getHType(x); if(t===1)c1++;else if(t===2)c2++;else c3++; });
    $('#orgCompanyCount').text(c1); $('#orgBranchCount').text(c2); $('#orgAdminCount').text(c3);
    $('#orgTotalCount').text('@SR["Total"]: '+data.length+' @Localizer["entities"]');
}

function renderOrgChart(data){
    ocPositions={};
    var board  = document.getElementById('ocBoard');
    var canvas = document.getElementById('ocCanvas');
    var svgCon = document.getElementById('ocSvgCon');

    $(canvas).find('.oc-node-wrap').remove();
    $(board).find('.org-empty-msg').remove();
    while(svgCon.firstChild) svgCon.removeChild(svgCon.firstChild);

    updateOrgSummary(data||[]);

    if(!data||!data.length){
        board.style.width='100%'; board.style.height='560px';
        canvas.style.width='100%'; canvas.style.height='560px'; canvas.style.transform='scale(1)';
        $(board).append('<div class="org-empty-msg" style="padding:3rem;text-align:center;color:#9aa4b5">@SR["NoData"]</div>');
        return;
    }

    /* layout in base coords */
    var roots=getChildren(data,null), rx=PAD;
    roots.forEach(function(r){ layoutNode(data,r.h_ID,rx,PAD); rx+=treeWidth(data,r.h_ID)+H_GAP*3; });

    /* Normalize because a wide subtree can extend to negative X.
       Without this, the left side gets clipped and no scroll can reach it. */
    var bounds = normalizeChartPositions(ocPositions);
    var mx=bounds.maxX, my=bounds.maxY;

    var baseW=mx+PAD, baseH=my+PAD+60;

    /* canvas = base size, scaled via transform */
    canvas.style.width  = baseW+'px';
    canvas.style.height = baseH+'px';
    canvas.style.transform = 'scale('+orgZoom+')';

    /* board = actual scrollable footprint */
    setScrollableBoardSize(document.getElementById('orgChartScroll'), board, baseW, baseH, orgZoom);

    svgCon.setAttribute('width',  baseW);
    svgCon.setAttribute('height', baseH);
    svgCon.style.width  = baseW+'px';
    svgCon.style.height = baseH+'px';

    /* connections — base coords only */
    data.forEach(function(d){
        if(!d.h_Parent) return;
        var p=ocPositions[d.h_Parent],c=ocPositions[d.h_ID];
        if(!p||!c) return;
        var px=p.x+NW/2, py=p.y+NH-28;
        var cx=c.x+NW/2, cy=c.y+40;
        var midY=(py+cy)/2;
        var path=document.createElementNS('http://www.w3.org/2000/svg','path');
        path.setAttribute('d','M'+px+','+py+' C'+px+','+midY+' '+cx+','+midY+' '+cx+','+cy);
        path.setAttribute('fill','none'); path.setAttribute('stroke','#b7c0cf');
        path.setAttribute('stroke-width','1.8'); path.setAttribute('stroke-dasharray','5 4');
        path.setAttribute('stroke-linecap','round');
        svgCon.appendChild(path);
        var dot=document.createElementNS('http://www.w3.org/2000/svg','circle');
        dot.setAttribute('cx',(px+cx)/2); dot.setAttribute('cy',(py+cy)/2);
        dot.setAttribute('r','4.5'); dot.setAttribute('fill','#fff');
        dot.setAttribute('stroke','#b7c0cf'); dot.setAttribute('stroke-width','1.5');
        svgCon.appendChild(dot);
    });

    /* nodes — base coords only */
    data.forEach(function(d){
        var p=ocPositions[d.h_ID]; if(!p) return;
        var col=getCol(d), name=getName(d);
        var wrap=document.createElement('div');
        wrap.className='oc-node-wrap'; wrap.dataset.id=d.h_ID;
        wrap.style.left=p.x+'px'; wrap.style.top=p.y+'px'; wrap.style.width=NW+'px';
        wrap.innerHTML='<div class="oc-card-body">'
            +getIconSVG(d,70)
            +'<div style="margin-top:-5px">'+platformSVG(col,92,20)+'</div>'
            +'<div class="oc-info-box">'
            +'<div class="oc-info-name" style="background:'+col.main+'">'+escapeHtml(name)+'</div>'
            +'<div class="oc-info-type">'+escapeHtml(getTypeLabel(d))+'</div>'
            +'</div></div>';
        canvas.appendChild(wrap);
    });
}

/* ══════════════════════════════════════════════════════════
   ZOOM  — pivot-aware (الزووم على نقطة محددة بدون إزاحة)
══════════════════════════════════════════════════════════ */
function getCurrentOrgData(){ return getFilteredData(hierarchicalItemsCache,$('#asGlobalSearch').val()); }

/*
  pivotX, pivotY = الإحداثيات بالـ base coordinates (قبل الزووم)
  التي يجب أن تبقى ثابتة في مركز الـ viewport بعد الزووم
  إذا لم تُعطَ نستخدم مركز الـ viewport الحالي
*/
function clampScrollValue(value, maxValue){
    return Math.max(0, Math.min(value, Math.max(0, maxValue || 0)));
}

function restoreZoomPivot(scroll, zoomValue, pivotX, pivotY){
    if(!scroll || pivotX===undefined || pivotY===undefined) return;

    requestAnimationFrame(function(){
        var maxLeft = scroll.scrollWidth  - scroll.clientWidth;
        var maxTop  = scroll.scrollHeight - scroll.clientHeight;

        scroll.scrollLeft = clampScrollValue((pivotX * zoomValue) - (scroll.clientWidth  / 2), maxLeft);
        scroll.scrollTop  = clampScrollValue((pivotY * zoomValue) - (scroll.clientHeight / 2), maxTop);
    });
}

function setScrollableBoardSize(scroll, board, baseW, baseH, zoomValue){
    if(!board) return;

    var safeZoom = zoomValue || 1;
    var w = Math.ceil(baseW * safeZoom);
    var h = Math.ceil(baseH * safeZoom);

    /* Make the scroll footprint never smaller than the viewport.
       This keeps native scroll/pan available and prevents the chart from being clipped
       after fit/reset/fullscreen rendering. */
    if(scroll){
        w = Math.max(w, scroll.clientWidth  + 2);
        h = Math.max(h, scroll.clientHeight + 2);
    }

    board.style.width = w + 'px';
    board.style.height = h + 'px';
    board.style.minWidth = w + 'px';
    board.style.minHeight = h + 'px';
}

function applyOrgZoom(val, pivotX, pivotY){
    var scroll=document.getElementById('orgChartScroll');
    var oldZoom=orgZoom||1;

    if(!scroll) return;

    /* Keep the same visible point stable. Because the chart scroll area is forced LTR,
       scrollLeft calculations stay consistent even when the page itself is RTL. */
    if(pivotX===undefined || pivotY===undefined){
        pivotX=(scroll.scrollLeft + (scroll.clientWidth  / 2)) / oldZoom;
        pivotY=(scroll.scrollTop  + (scroll.clientHeight / 2)) / oldZoom;
    }

    orgZoom=Math.max(0.3,Math.min(1.8,val));
    $('#orgZoomValue').text(Math.round(orgZoom*100)+'%');

    renderOrgChart(getCurrentOrgData());
    restoreZoomPivot(scroll, orgZoom, pivotX, pivotY);
}

/*
  دبل-كليك: zoom تدريجي على العنصر نفسه
  كل دبل-كليك يزيد 0.3 حتى يصل 1.6 ثم يرجع لـ 0.7
*/
function focusOrgNode(nodeId){
    var scroll=document.getElementById('orgChartScroll');
    if(!scroll) return;
    var p=ocPositions[nodeId]; if(!p) return;

    /* pivot = مركز العنصر بالـ base coords */
    var pivotX=p.x+NW/2;
    var pivotY=p.y+NH/2;

    /* zoom تدريجي */
    var newZoom=orgZoom>=1.5 ? 0.7 : orgZoom+0.3;
    applyOrgZoom(newZoom, pivotX, pivotY);

    /* animation بعد renderOrgChart */
    setTimeout(function(){
        var el=document.querySelector('.oc-node-wrap[data-id="'+nodeId+'"]');
        if(el){
            el.classList.remove('focused');
            void el.offsetWidth;
            el.classList.add('focused');
            setTimeout(function(){ el.classList.remove('focused'); },500);
        }
    },30);
}

function fitOrgChart(){
    var scroll=document.getElementById('orgChartScroll');
    if(!scroll||!scroll.offsetParent) return;
    var data=getCurrentOrgData(), mx=0, my=0;
    data.forEach(function(d){ var p=ocPositions[d.h_ID]; if(p){ mx=Math.max(mx,p.x+NW); my=Math.max(my,p.y+NH); } });
    if(!mx||!my){ renderOrgChart(data); data.forEach(function(d){ var p=ocPositions[d.h_ID]; if(p){ mx=Math.max(mx,p.x+NW); my=Math.max(my,p.y+NH); } }); }
    if(!mx||!my) return;
    var z=Math.min((scroll.clientWidth-70)/(mx+PAD),(scroll.clientHeight-70)/(my+PAD+60),1);
    orgZoom=Math.max(0.35,Math.min(z,1));
    $('#orgZoomValue').text(Math.round(orgZoom*100)+'%');
    renderOrgChart(data);
    setTimeout(function(){ scroll.scrollLeft=Math.max(0,((mx+PAD)*orgZoom-scroll.clientWidth)/2); scroll.scrollTop=0; },60);
}



/* ══════════════════════════════════════════════════════════
   ORG CHART FULLSCREEN MODAL
══════════════════════════════════════════════════════════ */
function layoutNodeInto(data,id,x,y,positions){
    positions[id]={x:x,y:y};
    var c=getChildren(data,id); if(!c.length) return;
    var tot=c.reduce(function(s,x){ return s+treeWidth(data,x.h_ID); },0)+H_GAP*(c.length-1);
    var cx=x+NW/2-tot/2;
    c.forEach(function(n){
        var w=treeWidth(data,n.h_ID);
        layoutNodeInto(data,n.h_ID,cx+w/2-NW/2,y+NH+V_GAP,positions);
        cx+=w+H_GAP;
    });
}

function renderOrgChartModal(data){
    modalOcPositions={};
    var board  = document.getElementById('modalOcBoard');
    var canvas = document.getElementById('modalOcCanvas');
    var svgCon = document.getElementById('modalOcSvgCon');
    if(!board||!canvas||!svgCon) return;

    $(canvas).find('.oc-node-wrap').remove();
    $(board).find('.org-empty-msg').remove();
    while(svgCon.firstChild) svgCon.removeChild(svgCon.firstChild);

    if(!data||!data.length){
        board.style.width='100%'; board.style.height='100%';
        canvas.style.width='100%'; canvas.style.height='100%'; canvas.style.transform='scale(1)';
        $(board).append('<div class="org-empty-msg" style="padding:3rem;text-align:center;color:#9aa4b5">@SR["NoData"]</div>');
        return;
    }

    var roots=getChildren(data,null), rx=PAD;
    roots.forEach(function(r){ layoutNodeInto(data,r.h_ID,rx,PAD,modalOcPositions); rx+=treeWidth(data,r.h_ID)+H_GAP*3; });

    /* Normalize because a wide subtree can extend to negative X.
       Without this, the left side gets clipped and no scroll can reach it. */
    var bounds = normalizeChartPositions(modalOcPositions);
    var mx=bounds.maxX, my=bounds.maxY;

    var baseW=mx+PAD, baseH=my+PAD+60;

    canvas.style.width  = baseW+'px';
    canvas.style.height = baseH+'px';
    canvas.style.transform = 'scale('+modalOrgZoom+')';

    setScrollableBoardSize(document.getElementById('modalOrgChartScroll'), board, baseW, baseH, modalOrgZoom);

    svgCon.setAttribute('width',baseW);
    svgCon.setAttribute('height',baseH);
    svgCon.style.width=baseW+'px';
    svgCon.style.height=baseH+'px';

    data.forEach(function(d){
        if(!d.h_Parent) return;
        var p=modalOcPositions[d.h_Parent], c=modalOcPositions[d.h_ID];
        if(!p||!c) return;
        var px=p.x+NW/2, py=p.y+NH-28;
        var cx=c.x+NW/2, cy=c.y+40;
        var midY=(py+cy)/2;
        var path=document.createElementNS('http://www.w3.org/2000/svg','path');
        path.setAttribute('d','M'+px+','+py+' C'+px+','+midY+' '+cx+','+midY+' '+cx+','+cy);
        path.setAttribute('fill','none');
        path.setAttribute('stroke','#b7c0cf');
        path.setAttribute('stroke-width','1.8');
        path.setAttribute('stroke-dasharray','5 4');
        path.setAttribute('stroke-linecap','round');
        svgCon.appendChild(path);

        var dot=document.createElementNS('http://www.w3.org/2000/svg','circle');
        dot.setAttribute('cx',(px+cx)/2); dot.setAttribute('cy',(py+cy)/2);
        dot.setAttribute('r','4.5'); dot.setAttribute('fill','#fff');
        dot.setAttribute('stroke','#b7c0cf'); dot.setAttribute('stroke-width','1.5');
        svgCon.appendChild(dot);
    });

    data.forEach(function(d){
        var p=modalOcPositions[d.h_ID]; if(!p) return;
        var col=getCol(d), name=getName(d);
        var wrap=document.createElement('div');
        wrap.className='oc-node-wrap'; wrap.dataset.id=d.h_ID;
        wrap.style.left=p.x+'px'; wrap.style.top=p.y+'px'; wrap.style.width=NW+'px';
        wrap.innerHTML='<div class="oc-card-body">'
            +getIconSVG(d,70)
            +'<div style="margin-top:-5px">'+platformSVG(col,92,20)+'</div>'
            +'<div class="oc-info-box">'
            +'<div class="oc-info-name" style="background:'+col.main+'">'+escapeHtml(name)+'</div>'
            +'<div class="oc-info-type">'+escapeHtml(getTypeLabel(d))+'</div>'
            +'</div></div>';
        canvas.appendChild(wrap);
    });
}

function applyModalOrgZoom(val, pivotX, pivotY){
    var scroll=document.getElementById('modalOrgChartScroll');
    var oldZoom=modalOrgZoom||1;

    if(!scroll) return;

    if(pivotX===undefined || pivotY===undefined){
        pivotX=(scroll.scrollLeft + (scroll.clientWidth  / 2)) / oldZoom;
        pivotY=(scroll.scrollTop  + (scroll.clientHeight / 2)) / oldZoom;
    }

    modalOrgZoom=Math.max(0.3,Math.min(1.8,val));
    $('#modalOrgZoomValue').text(Math.round(modalOrgZoom*100)+'%');

    renderOrgChartModal(getCurrentOrgData());
