}

function fitModalOrgChart(){
    var scroll=document.getElementById('modalOrgChartScroll');
    if(!scroll||!scroll.offsetParent) return;
    var data=getCurrentOrgData();
    renderOrgChartModal(data);

    var mx=0,my=0;
    data.forEach(function(d){ var p=modalOcPositions[d.h_ID]; if(p){ mx=Math.max(mx,p.x+NW); my=Math.max(my,p.y+NH); } });
    if(!mx||!my) return;

    var z=Math.min((scroll.clientWidth-90)/(mx+PAD),(scroll.clientHeight-90)/(my+PAD+60),1);
