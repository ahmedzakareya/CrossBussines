/* ══════════════════════════════════════════════════════════
   FLOW CHART  — clean rebuild
══════════════════════════════════════════════════════════ */
var chevSvg='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';

function fcBuildNode(data, item, level){
    var children=getChildren(data,item.h_ID);
    var hasChildren=children.length>0;
    var name=getName(item);

    /* ring colour cycles through type colours */
    var ringColors=['#E7F0FF','#E7F0FF','#E7F0FF'];
    var ci=(getHType(item)-1)%3;

    var html='<div class="fc-node" data-id="'+item.h_ID+'">';
    html+='<div class="fc-item">';
    html+='<div class="fc-card">';
    html+='<div class="fc-ring" style="background:'+ringColors[ci]+'">'+getIconSVG(item,26)+'</div>';
    html+='<div class="fc-info">'
         +'<div class="fc-name">'+escapeHtml(name)+'</div>'
         +'<div class="fc-lbl">'+escapeHtml(getTypeLabel(item))+'</div>'
         +'</div>';
    if(hasChildren) html+='<div class="fc-toggle">'+chevSvg+'</div>';
    html+='</div></div>';

    if(hasChildren){
        html+='<div class="fc-children">';
        children.forEach(function(c){
            html+='<div class="fc-child-wrap">'+fcBuildNode(data,c,level+1)+'</div>';
        });
        html+='</div>';
    }
    html+='</div>';
    return html;
}

function renderFlowChart(data){
    var tree=document.getElementById('fcTree');
    tree.setAttribute('dir',PAGE_DIR);
    if(!data||!data.length){ tree.innerHTML='<div style="padding:3rem;text-align:center;color:#9aa4b5">@SR["NoData"]</div>'; return; }
    tree.innerHTML=getChildren(data,null).map(function(r){ return fcBuildNode(data,r,0); }).join('');
}

/* ══════════════════════════════════════════════════════════
   JSTREE ICON CLASS
══════════════════════════════════════════════════════════ */
function getTreeIconClass(item){
    var t=getHType(item);
    return t===1?'ki-outline ki-bank text-warning fs-4'
        : t===2?'ki-outline ki-shop text-primary fs-4'
        : t===4?'ki-outline ki-briefcase text-primary fs-4'
        : t===5?'ki-outline ki-profile-user text-primary fs-4'
        : 'ki-outline ki-people text-primary fs-4';
}

/* ══════════════════════════════════════════════════════════
   SEARCH
══════════════════════════════════════════════════════════ */
function applyStructureSearch(query){
    var filtered=getFilteredData(hierarchicalItemsCache,query), q=normalizeText(query);
    $('#asClearSearch').css('display',q?'inline-flex':'none');
    updateSearchCounter(hierarchicalItemsCache.length,filtered.length,q);
    var tree=$('#kt_docs_jstree_customicons').jstree(true);
    if(tree){ tree.clear_search(); if(q){ tree.search(query); tree.open_all(); } else tree.close_all(); }
    renderOrgChart(filtered);
    renderFlowChart(filtered);
}

