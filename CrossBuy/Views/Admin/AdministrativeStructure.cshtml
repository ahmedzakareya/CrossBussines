    return '<svg width="'+sz+'" height="'+sz+'" viewBox="0 0 80 80" style="display:block">'
        +'<ellipse cx="40" cy="76" rx="22" ry="4" fill="rgba(0,0,0,0.12)"/>'
        +'<circle cx="60" cy="28" r="8" fill="'+li+'" opacity=".75"/>'
        +'<path d="M50 52 Q52 40 60 40 Q68 40 70 52 L70 66 L50 66 Z" fill="'+m+'" opacity=".65"/>'
        +'<circle cx="20" cy="28" r="8" fill="'+li+'" opacity=".75"/>'
        +'<path d="M10 52 Q12 40 20 40 Q28 40 30 52 L30 66 L10 66 Z" fill="'+m+'" opacity=".65"/>'
        +'<circle cx="40" cy="24" r="10" fill="'+li+'"/>'
        +'<path d="M26 54 Q29 38 40 38 Q51 38 54 54 L54 68 L26 68 Z" fill="'+sh+'"/>'
        +'<circle cx="36" cy="22" r="2" fill="'+sh+'" opacity=".45"/>'
        +'<circle cx="44" cy="22" r="2" fill="'+sh+'" opacity=".45"/>'
        +'<path d="M36 29 Q40 32 44 29" stroke="'+sh+'" stroke-width="1.2" fill="none" opacity=".5"/>'
        +'<path d="M38 38 L40 46 L42 38 L40 40 Z" fill="'+li+'" opacity=".6"/>'
