@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@using System.Text.Json
@using CrossBuy.ViewModel
@{
    ViewData["Title"] = Localizer["Administrative Structure"].Value;
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";

    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    // Both languages inline, the same helper Views/Tasks/Index.cshtml uses. A NEW .resx key needs a
    // satellite assembly, i.e. a build - and IViewLocalizer returns the KEY itself when it cannot
    // resolve one, so a fresh key would print as English text on an Arabic document. The print
    // templates below are all new strings, so they carry their own pair.
    string T(string ar, string en) => isAr ? ar : en;

}

<style>
    :root {
        --as-bg:           #f4f6fb;
        --as-card:         #ffffff;
        --as-border:       #e4e9f2;
        --as-text:         #1a2236;
        --as-muted:        #7b8494;
        --as-primary:      #145DBF;
        --as-primary-soft: #E7F0FF;
        --as-shadow:       0 12px 34px rgba(20,32,55,.09);
        --as-radius:       22px;
        --c1-main:#0E4A9E; --c1-shadow:#0B3D91; --c1-platform:#0E4A9E; --c1-light:#166FE5;
        --c2-main:#145DBF; --c2-shadow:#0E4A9E; --c2-platform:#145DBF; --c2-light:#1877F2;
        --c3-main:#1877F2; --c3-shadow:#145DBF; --c3-platform:#166FE5; --c3-light:#5B8CFF;
    }

    .as-page  { background:var(--as-bg); border-radius:24px; padding:22px; }
    .as-shell { background:var(--as-card); border:1px solid var(--as-border); border-radius:24px; box-shadow:var(--as-shadow); overflow:hidden; }

    /* ── HEADER ── */
    /* The .as-official-* block that used to live here is gone with the markup it styled: a second
       copy of the page title, an eyebrow badge, an explanatory sentence and a 52px icon tile. Its
       one surviving job - the 4px brand rule across the top of the shell - moves onto the command
       bar below as .as-command-bar--lead. */

    /* ── COMMAND BAR ── */
    .as-command-bar    { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:14px 20px; background:#fff; border-bottom:1px solid var(--as-border); }
    /* The lead bar carries the brand rule the removed header used to own. */
    .as-command-bar--lead { position:relative; padding-top:18px; }
    .as-command-bar--lead::before { content:""; position:absolute; inset-inline-start:0; top:0; width:100%; height:4px; background:#145DBF; }
    .as-search-wrap    { flex:1; max-width:640px; }
    .as-search-box     { height:44px; border:1px solid var(--as-border); border-radius:14px; background:#ffffff; display:flex; align-items:center; gap:10px; padding:0 14px; box-shadow:0 4px 12px rgba(20,32,55,.04); }
    .as-search-box:focus-within { border-color:rgba(20,93,191,.45); box-shadow:0 0 0 4px rgba(20,93,191,.08); }
    .as-search-box input { border:0; outline:0; background:transparent; width:100%; font-weight:700; font-size:13px; color:var(--as-text); }
    .as-search-box input::placeholder { color:#9aa4b5; font-weight:600; }
    .as-search-clear   { width:28px; height:28px; border:0; border-radius:8px; background:#f3f6fb; color:#6b7280; display:none; align-items:center; justify-content:center; cursor:pointer; }
    .as-search-clear:hover { background:var(--as-primary-soft); color:var(--as-primary); }
    .as-chip           { display:inline-flex; align-items:center; gap:7px; padding:7px 13px; border-radius:999px; background:#f4f7fb; border:1px solid var(--as-border); color:#5e6a7f; font-size:12px; font-weight:800; }
    .as-command-actions{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }

    /* ── TABS ── */
    .as-tabs { display:flex; gap:10px; padding:16px 20px 0; border-bottom:1px solid var(--as-border); background:#fff; overflow-x:auto; }
    .as-tabs .nav-link { border:1px solid transparent; border-bottom:0; color:#647084; font-weight:800; border-radius:16px 16px 0 0; padding:12px 18px; white-space:nowrap; background:transparent; }
    .as-tabs .nav-link.active { color:var(--as-primary); background:var(--as-bg); border-color:var(--as-border); position:relative; }
    .as-tabs .nav-link.active::after { content:""; position:absolute; left:0; right:0; bottom:-1px; height:1px; background:var(--as-bg); }

    /* ── CONTENT ── */
    .as-content  { background:var(--as-bg); padding:22px; min-height:570px; }
    .as-view-card{ background:var(--as-card); border:1px solid var(--as-border); border-radius:var(--as-radius); min-height:510px; overflow:hidden; }
    .as-view-head{ display:flex; justify-content:space-between; align-items:center; gap:14px; padding:18px 20px; border-bottom:1px solid var(--as-border); background:#ffffff; }
    /* A usage hint plus at most one control - a third of the height the captioned version took. */
    .as-view-head--slim{ padding:8px 20px; }
    .as-view-title{ font-size:15px; font-weight:900; color:var(--as-text); margin:0; }
    .as-view-hint { color:var(--as-muted); font-size:12px; margin-top:3px; }
    .as-tree-area { padding:22px; }

    /* ── ORG CHART ── */
    .org-outer { display:grid; grid-template-columns:270px minmax(0,1fr); min-height:620px; }
    .org-side-panel { border-inline-end:1px solid var(--as-border); background:#ffffff; padding:22px 18px; display:flex; flex-direction:column; gap:16px; }
    .org-legend-card,.org-summary-card { background:#fff; border:1px solid #dfe6f0; border-radius:16px; box-shadow:0 8px 20px rgba(20,32,55,.06); padding:16px; }
    .org-panel-title { font-size:14px; font-weight:900; color:#111827; margin-bottom:12px; padding-bottom:10px; border-bottom:1px solid #edf1f7; }
    .org-legend-item { display:grid; grid-template-columns:44px 1fr 32px; align-items:center; gap:10px; padding:11px 0; border-bottom:1px solid #edf1f7; }
    .org-legend-item:last-child { border-bottom:0; padding-bottom:0; }
    .org-legend-icon { width:42px; height:42px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; }
    .org-legend-title{ font-size:12px; font-weight:900; color:#182235; }
    .org-legend-code { font-size:10px; color:#6b7280; margin-top:2px; font-weight:700; }
    .org-legend-num  { width:28px; height:28px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px; font-weight:900; }
    .ht1{color:var(--c1-main);background:#E7F0FF;} .ht2{color:var(--c2-main);background:#E7F0FF;} .ht3{color:var(--c3-main);background:#E7F0FF;}
    .num1{color:var(--c1-main);background:#E7F0FF;border:1px solid #A8C5FF;} .num2{color:var(--c2-main);background:#E7F0FF;border:1px solid #A8C5FF;} .num3{color:var(--c3-main);background:#E7F0FF;border:1px solid #D0E1FF;}
    .org-summary-grid  { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; text-align:center; }
    .org-summary-num   { font-size:22px; font-weight:950; line-height:1; }
    .org-summary-label { font-size:10px; color:#667085; margin-top:5px; font-weight:800; }
    .org-summary-total { margin-top:12px; border-radius:12px; background:#f4f6fb; color:#475467; font-size:11px; font-weight:900; padding:9px 10px; text-align:center; }

    .org-chart-shell  { position:relative; flex:1; min-width:0; min-height:0; overflow:hidden; }
    .org-chart-scroll {
        width:100%; height:620px; min-height:0; overflow:auto;
        direction:ltr;
        scrollbar-width:thin; scrollbar-color:#cfd8e6 #f8fafc;
        cursor:grab; user-select:none;
        background-color:#F3F7FF;
        background-image:
            linear-gradient(#edf0f5 1px,transparent 1px),
            linear-gradient(90deg,#edf0f5 1px,transparent 1px);
        background-size:28px 28px,28px 28px;
    }
    .org-chart-scroll.is-dragging { cursor:grabbing; }
    .org-chart-scroll.is-dragging * { pointer-events:none; }

    /* oc-board = scroll content; oc-canvas = transform origin */
    .oc-board  { position:relative; }
    .oc-canvas { position:absolute; top:0; left:0; transform-origin:top left; }
    .oc-svg-con{ position:absolute; top:0; left:0; pointer-events:none; overflow:visible; z-index:0; }

    .oc-node-wrap { position:absolute; z-index:1; display:flex; flex-direction:column; align-items:center; cursor:pointer; }
    .oc-card-body { transition:transform .18s; display:flex; flex-direction:column; align-items:center; }
    .oc-node-wrap:hover .oc-card-body { transform:translateY(-6px); }
    .oc-info-box  { margin-top:7px; text-align:center; max-width:148px; }
    .oc-info-name { font-size:11px; font-weight:900; padding:3px 10px; color:#fff; border-radius:3px; display:inline-block; margin-bottom:3px; white-space:nowrap; letter-spacing:.2px; }
    .oc-info-type { font-size:9px; color:#888; margin-bottom:2px; font-weight:700; }

    /* zoom focus ring animation */
    .oc-node-wrap.focused .oc-card-body { animation: focusPop .45s ease; }
    @@keyframes focusPop {
        0%   { transform:translateY(0) scale(1); }
        40%  { transform:translateY(-10px) scale(1.08); }
        70%  { transform:translateY(-5px) scale(1.04); }
        100% { transform:translateY(-6px) scale(1); }
    }

    .org-map-toolbar {
        position:absolute; left:14px; bottom:14px; z-index:20;
        display:inline-flex; align-items:center; gap:7px; padding:7px;
        border-radius:14px; background:rgba(255,255,255,.94);
        border:1px solid #dfe6ef; box-shadow:0 10px 28px rgba(20,32,55,.12);
        backdrop-filter:blur(8px);
    }
    .org-zoom-btn { width:36px; height:36px; border:1px solid #d9e2ee; border-radius:11px; background:#fff; color:#172033; display:inline-flex; align-items:center; justify-content:center; font-weight:900; cursor:pointer; transition:all .16s; }
    .org-zoom-btn:hover { background:#E7F0FF; border-color:#A8C5FF; color:#145DBF; }
    .org-zoom-value { min-width:54px; height:36px; padding:0 9px; border-radius:11px; background:#f4f7fb; color:#475467; font-size:12px; font-weight:900; display:inline-flex; align-items:center; justify-content:center; }



    /* ── ORG FULLSCREEN MODAL ── */
    .org-fullscreen-modal .modal-content { background:#f4f6fb; }
    .org-fullscreen-modal .modal-header {
        min-height:64px; background:#fff; border-bottom:1px solid var(--as-border);
        padding:14px 18px; display:flex; align-items:center; justify-content:space-between;
    }
    .org-fullscreen-title { display:flex; align-items:center; gap:10px; font-weight:900; color:#162033; }
    .org-fullscreen-title i { color:var(--as-primary); }
    .org-fullscreen-body { height:calc(100dvh - 64px); padding:0; overflow:hidden; min-height:0; }
    .org-fullscreen-shell { height:100%; width:100%; position:relative; overflow:hidden; background:#fbfcff; min-height:0; }
    .org-fullscreen-shell .org-chart-scroll { height:100%; width:100%; min-height:0; overflow:auto; }
    .org-fullscreen-shell .org-map-toolbar { left:18px; bottom:18px; }
    .org-open-fullscreen-btn { white-space:nowrap; }

    /* ══════════════════════════════════════════════════════
       FLOW CHART — direction-aware connector lines
       Fixes disconnected right-side lines in RTL/LTR layouts
    ══════════════════════════════════════════════════════ */
    .org-flow-scroll { width:100%; overflow:auto; padding:22px; background:#fbfcff; }
    .fc-board { min-width:760px; padding:8px 8px 24px; }
    .fc-tree  { display:flex; flex-direction:column; gap:0; }
    .fc-node  { position:relative; }
    .fc-item  { display:flex; align-items:center; position:relative; }

    .fc-card  {
        display:inline-flex; align-items:center; gap:12px;
        background:#fff; border-radius:16px; border:1px solid var(--as-border);
        padding:9px 12px; cursor:pointer; min-width:260px; max-width:440px;
        box-shadow:0 5px 14px rgba(20,32,55,.06);
        transition:transform .15s, border-color .15s, box-shadow .15s;
        position:relative; z-index:1;
        min-height:52px;
    }
    .fc-card:hover { border-color:rgba(20,93,191,.28); box-shadow:0 10px 22px rgba(20,32,55,.09); transform:translateX(-3px); }
    .fc-ring  { width:38px; height:38px; border-radius:12px; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
    .fc-info  { flex:1; min-width:0; }
    .fc-name  { font-size:12px; font-weight:900; color:var(--as-text); line-height:1.45; overflow-wrap:anywhere; }
    .fc-lbl   { font-size:10px; color:var(--as-muted); margin-top:2px; font-weight:700; }
    .fc-toggle {
        width:26px; height:26px; border-radius:9px;
        border:1px solid var(--as-border); background:#E7F0FF;
        display:flex; align-items:center; justify-content:center;
        flex-shrink:0; cursor:pointer; transition:background .15s;
    }
    .fc-toggle:hover { background:#E7F0FF; }
    .fc-toggle svg { width:11px; height:11px; color:var(--as-text); transition:transform .2s; }
    .fc-node.collapsed > .fc-item > .fc-card .fc-toggle svg { transform:rotate(-90deg); }
    .fc-node.collapsed > .fc-children { display:none; }

    .fc-children {
        position:relative;
        margin-top:6px;
        margin-bottom:0;
        padding-top:0;
        padding-bottom:0;
    }

    /* LTR connector */
    .fc-tree[dir="ltr"] .fc-children {
        margin-left:56px;
        padding-left:22px;
        border-left:2px solid #c8d3e6;
    }
    .fc-tree[dir="ltr"] .fc-children::before,
    .fc-tree[dir="ltr"] .fc-children::after {
        content:"";
        position:absolute;
        left:-2px;
        width:2px;
        height:26px;
        background:#fbfcff;
        z-index:1;
    }
    .fc-tree[dir="ltr"] .fc-children::before { top:0; }
    .fc-tree[dir="ltr"] .fc-children::after  { bottom:0; }
    .fc-tree[dir="ltr"] .fc-child-wrap::before {
        content:"";
        position:absolute;
        left:-22px;
        top:50%;
        width:22px;
        height:2px;
        background:#c8d3e6;
        transform:translateY(-50%);
        z-index:0;
    }

    /* RTL connector — line stays on the right and connects to the card */
    .fc-tree[dir="rtl"] .fc-children {
        margin-right:56px;
        padding-right:22px;
        border-right:2px solid #c8d3e6;
    }
    .fc-tree[dir="rtl"] .fc-children::before,
    .fc-tree[dir="rtl"] .fc-children::after {
        content:"";
        position:absolute;
        right:-2px;
        width:2px;
        height:26px;
        background:#fbfcff;
        z-index:1;
    }
    .fc-tree[dir="rtl"] .fc-children::before { top:0; }
    .fc-tree[dir="rtl"] .fc-children::after  { bottom:0; }
    .fc-tree[dir="rtl"] .fc-child-wrap::before {
        content:"";
        position:absolute;
        right:-22px;
        top:50%;
        width:22px;
        height:2px;
        background:#c8d3e6;
        transform:translateY(-50%);
        z-index:0;
    }

    .fc-child-wrap {
        position:relative;
        padding-top:6px;
        padding-bottom:6px;
    }

    /* ── MISC ── */
    .as-match     { outline:3px solid rgba(20,93,191,.16); border-color:rgba(20,93,191,.48)!important; }
    /* No print rules and no print markup. This screen does not print; the toolbar links to the
       Admin.OrgStructure.Units report and the platform renders it. */
    @@media (max-width:1199.98px) {
        .org-outer { grid-template-columns:1fr; }
        .org-side-panel { border-inline-end:0; border-bottom:1px solid var(--as-border); display:grid; grid-template-columns:1fr 1fr; }
    }
    @@media (max-width:991.98px) {
        .as-page { padding:12px; }
        .as-command-bar { flex-direction:column; align-items:stretch; }
        .as-search-wrap { max-width:none; }
        .as-content { padding:14px; }
        .org-chart-scroll { height:520px; }
    }
    @@media (max-width:767.98px) { .org-side-panel { grid-template-columns:1fr; } }
</style>


<div class="d-flex flex-column flex-column-fluid">

    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex align-items-stretch">
            <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                    <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">
                        @CrossBuy.Resources.SharedResources.AdministrativeStructure
                    </h1>
                    <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                        <li class="breadcrumb-item text-muted"><a href="/" class="text-muted text-hover-primary">@Localizer["Home"]</a></li>
                        <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                        <li class="breadcrumb-item text-muted">@Localizer["Administrative Structure"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            <div class="as-page">
                <div class="as-shell">

                    @* ================================================================================
                       ONE CONTROL ROW.

                       This screen opened with FIVE stacked bands before any content: the page toolbar
                       (title + breadcrumb), an "official header" that repeated the same title as an
                       h2 with an eyebrow badge and a sentence explaining what the screen is, a
                       command bar, the tabs, and then a per-tab caption. Roughly 450px of chrome
                       above a tree - on a 950px viewport the structure itself started below the fold.

                       What was removed is only duplication: the second copy of the title (the toolbar
                       above already names the page and the breadcrumb names it again), the eyebrow,
                       the "manage the administrative structure" sentence, and the icon tile. What
                       was KEPT is every control - search, the unit counter, expand, collapse, print -
                       now on one line. The 4px brand rule moves onto this bar so the identity band
                       survives the block it used to sit on.
                       ================================================================================ *@
                    <div class="as-command-bar as-command-bar--lead">
                        <div class="as-search-wrap">
                            <div class="as-search-box">
                                <i class="ki-outline ki-magnifier fs-3" style="color:var(--as-primary)"></i>
                                <input type="text" id="asGlobalSearch" autocomplete="off" placeholder="@Localizer["Search by name or entity type..."]" />
                                <button type="button" class="as-search-clear" id="asClearSearch">
                                    <i class="ki-outline ki-cross fs-4"></i>
                                </button>
                            </div>
                        </div>
                        <div class="as-command-actions">
                            <span class="as-chip" id="asSearchCount">
                                <i class="ki-outline ki-chart-simple fs-5"></i>@Localizer["All units"]
                            </span>
                            <div class="btn-group">
                                <button type="button" class="btn btn-light fw-bold" id="btnExpandFlow" title="@Localizer["Expand"]">
                                    <i class="ki-outline ki-plus-square fs-4"></i>
                                </button>
                                <button type="button" class="btn btn-light fw-bold" id="btnCollapseFlow" title="@Localizer["Collapse"]">
                                    <i class="ki-outline ki-minus-square fs-4"></i>
                                </button>
                            </div>

                            @* PRINTING GOES THROUGH REPORT STUDIO, AND ONLY THROUGH IT.

                               This button used to open a menu of five templates this view built and
                               printed itself as HTML. That is deleted. A print template belongs to the
                               reporting platform, where page setup, template versioning, field-level
                               permissions, scheduling, archiving and the PDF renderer already live - a
                               screen that prints its own HTML has none of that and drifts away from the
                               report of the same name.

                               The structure is registered as the dataset Admin.OrgStructure.Units, so
                               this is a link to that report rather than a print routine. *@
                            <a class="btn btn-light-primary fw-bold"
                               href="@Url.Action("Viewer", "Reports", new { id = CrossBuy.BL.Reporting.OrgStructureDatasetCodes.OrgUnits, run = true })">
                                <i class="ki-outline ki-printer fs-4 me-1"></i>@SR["Print"]
                            </a>
                        </div>
                    </div>

                    <!-- TABS -->
                    <ul class="nav nav-tabs as-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" data-bs-toggle="tab" href="#treeViewTab" role="tab">
                                <i class="ki-outline ki-abstract-26 fs-4 me-2"></i>@Localizer["Tree"]
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" data-bs-toggle="tab" href="#modernOrgTab" role="tab">
                                <i class="ki-outline ki-people fs-4 me-2"></i>@Localizer["Org chart"]
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" data-bs-toggle="tab" href="#flowOrgTab" role="tab">
                                <i class="ki-outline ki-data fs-4 me-2"></i>@Localizer["Flow"]
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content as-content">

                        <!-- ① Tree -->
                        <div class="tab-pane fade show active" id="treeViewTab" role="tabpanel">
                            @* No caption band. The tab that is selected is called "Tree", so a heading
                               reading "Tree view" under it, a hint naming the JS library that draws
                               it, and a chip reading "Default" were three restatements and a leaked
                               implementation detail, on top of the tree itself. *@
                            <div class="as-view-card">
                                <div class="as-tree-area"><div id="kt_docs_jstree_customicons"></div></div>
                            </div>
                        </div>

                        <!-- ② Org Chart -->
                        <div class="tab-pane fade" id="modernOrgTab" role="tabpanel">
                            <div class="as-view-card">
                                @* Slimmed: the heading duplicated the tab, and the same "drag to pan"
                                   advice was given twice - once as a hint and once as a chip beside
                                   it. What is left is the one thing a reader cannot guess (the
                                   keyboard/mouse gestures) and the one control that has to live here. *@
                                <div class="as-view-head as-view-head--slim">
                                    <div class="as-view-hint m-0">@Localizer["Drag to pan · Ctrl+wheel to zoom · double-click to focus an item"]</div>
                                    <button type="button" class="btn btn-sm btn-light-primary fw-bold org-open-fullscreen-btn" id="btnOpenOrgFullscreen">
                                        <i class="ki-outline ki-maximize fs-4 me-1"></i>@Localizer["Fullscreen"]
                                    </button>
                                </div>
                                <div class="org-outer">
                                    <aside class="org-side-panel">
                                        <div class="org-legend-card">
                                            <div class="org-panel-title">@Localizer["Legend"]</div>
                                            <div class="org-legend-item">
                                                <span class="org-legend-icon ht1" id="legendIcon1"></span>
                                                <div><div class="org-legend-title">@SR["Company"]</div></div>
                                                <span class="org-legend-num num1">1</span>
                                            </div>
