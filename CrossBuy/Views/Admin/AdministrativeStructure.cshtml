/* ══════════════════════════════════════════════════════════
   CONTEXT MENU
══════════════════════════════════════════════════════════ */
function openTreeActionMenu(e,nodeId){
    e.preventDefault(); e.stopPropagation();
    $('#treeActionMenu').css({top:e.pageY+'px',left:e.pageX+'px'}).show().data('nodeId',nodeId);
}

/* ══════════════════════════════════════════════════════════
   DRAG SCROLL
══════════════════════════════════════════════════════════ */
function enableDragScroll(el){
    if(!el) return;
    var dn=false,sx=0,sy=0,sl=0,st=0;
    el.addEventListener('mousedown',function(e){ if($(e.target).closest('.oc-node-wrap').length) return; dn=true; el.classList.add('is-dragging'); sx=e.pageX-el.offsetLeft; sy=e.pageY-el.offsetTop; sl=el.scrollLeft; st=el.scrollTop; });
    el.addEventListener('mouseleave',function(){ dn=false; el.classList.remove('is-dragging'); });
    window.addEventListener('mouseup',function(){ dn=false; el.classList.remove('is-dragging'); });
    el.addEventListener('mousemove',function(e){ if(!dn) return; e.preventDefault(); el.scrollLeft=sl-(e.pageX-el.offsetLeft-sx); el.scrollTop=st-(e.pageY-el.offsetTop-sy); });
}

/* ══════════════════════════════════════════════════════════
   DOCUMENT READY
══════════════════════════════════════════════════════════ */
