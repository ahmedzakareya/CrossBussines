        +'<rect x="10" y="30" width="50" height="4" fill="'+li+'" opacity=".4"/>'
        +'<rect x="16" y="38" width="10" height="10" rx="1" fill="'+li+'" opacity=".9"/>'
        +'<rect x="35" y="38" width="10" height="10" rx="1" fill="'+li+'" opacity=".9"/>'
        +'<rect x="54" y="38" width="10" height="10" rx="1" fill="'+li+'" opacity=".9"/>'
        +'<rect x="30" y="53" width="8" height="17" rx="1" fill="'+sh+'"/>'
        +'<rect x="42" y="53" width="8" height="17" rx="1" fill="'+sh+'"/>'
        +'<line x1="38" y1="53" x2="38" y2="70" stroke="'+li+'" stroke-width="0.8" opacity=".5"/>'
        +'<path d="M60 30 L70 36 L70 70 L60 70 Z" fill="'+sh+'" opacity=".55"/>'
        +'</svg>';
}
function iconAdminSVG(c,sz){
