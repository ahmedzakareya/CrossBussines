        +'<rect x="30" y="41" width="7" height="6" rx="1" fill="'+li+'" opacity=".7"/>'
        +'<rect x="41" y="41" width="7" height="6" rx="1" fill="'+li+'" opacity=".7"/>'
        +'<rect x="19" y="52" width="7" height="6" rx="1" fill="'+li+'" opacity=".5"/>'
        +'<rect x="30" y="52" width="7" height="6" rx="1" fill="'+li+'" opacity=".5"/>'
        +'<rect x="41" y="52" width="7" height="6" rx="1" fill="'+li+'" opacity=".5"/>'
        +'<rect x="32" y="59" width="12" height="11" rx="1" fill="'+sh+'"/>'
