        var pivotX=(e.clientX-rect.left+scroll.scrollLeft)/orgZoom;
        var pivotY=(e.clientY-rect.top +scroll.scrollTop )/orgZoom;
        applyOrgZoom(orgZoom+(e.deltaY<0?0.1:-0.1), pivotX, pivotY);
    },{passive:false});

    /* ── دبل-كليك: zoom تدريجي مع إبقاء العنصر ثابتاً في الـ viewport ── */
    document.getElementById('orgChartScroll').addEventListener('dblclick',function(e){
        var nodeEl=e.target.closest?e.target.closest('.oc-node-wrap'):$(e.target).closest('.oc-node-wrap')[0];
