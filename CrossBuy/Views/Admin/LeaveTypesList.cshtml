				</div>
				<!--end::Close-->
			</div>
			<!--begin::Modal header-->
			<!--begin::Modal body-->
			<div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
				<!--begin:Form-->
				<form id="kt_modal_new_target_form" class="form" action="#">
					<input type="hidden" id="itemId" value="0" />

					<!--begin::Heading-->
					<div class="mb-13 text-center">
						<!--begin::Title-->
						<h1 class="mb-3 text-primary">@CrossBuy.Resources.SharedResources.AddEditLeaveType</h1>
						<!--end::Title-->

					</div>
					<!--end::Heading-->
					
					<!--begin::Row-->
					<div class="row mb-6">
						<!--begin::Col-->
						<div class="col-md-6">
							<!--begin::Input group-->
							<div class="fv-row">
								<!--begin::Label-->
								<label class="d-flex align-items-center fs-6 fw-semibold mb-2">
									<span class="required">@CrossBuy.Resources.SharedResources.NameAr</span>
									<span class="ms-1" data-bs-toggle="tooltip" title="@Localizer["Specify a target name for future usage and reference"]">
										<i class="ki-outline ki-information-5 text-gray-500 fs-6"></i>
									</span>
								</label>
								<!--end::Label-->
								<input type="text"
									   class="form-control"
									   placeholder="@CrossBuy.Resources.SharedResources.NameAr"
									   name="target_title_ar"
									   id="itemNameAr"
									   required
									   data-fv-notempty="true"
									   data-fv-notempty-message="الرجاء إدخال الاسم العربي" />
							</div>
							<!--end::Input group-->
						</div>
						<!--end::Col-->
						<!--begin::Col-->
						<div class="col-md-6">
							<!--begin::Input group-->
							<div class="fv-row">
								<!--begin::Label-->
								<label class="d-flex align-items-center fs-6 fw-semibold mb-2">
									<span class="required">@CrossBuy.Resources.SharedResources.NameEn</span>
									<span class="ms-1" data-bs-toggle="tooltip" title="@Localizer["Specify a target name for future usage and reference"]">
										<i class="ki-outline ki-information-5 text-gray-500 fs-6"></i>
									</span>
								</label>
								<!--end::Label-->
