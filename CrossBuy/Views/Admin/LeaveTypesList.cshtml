<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script type="text/javascript">
	
		document.addEventListener('DOMContentLoaded', function () {
			const form = document.getElementById('kt_modal_new_target_form');
			const saveBtn = document.getElementById('saveItemBtn');

			// تفعيل التحقق باستخدام FormValidation
			const validator = FormValidation.formValidation(form, {
				fields: {
					'target_title_ar': {
						validators: {
							notEmpty: {
							message: '@CrossBuy.Resources.SharedResources.FillRequiredFields'
							}
						}
					},
					'target_title_en': {
						validators: {
							notEmpty: {
							message: '@CrossBuy.Resources.SharedResources.FillRequiredFields'
							}
						}
					}
				},
				plugins: {
					trigger: new FormValidation.plugins.Trigger(),
					bootstrap5: new FormValidation.plugins.Bootstrap5({
						rowSelector: '.fv-row',
						eleInvalidClass: '',
						eleValidClass: ''
					})
				}
			});

			saveBtn.addEventListener('click', function (e) {
				e.preventDefault();

				validator.validate().then(function (status) {
					if (status === 'Valid') {
						const data = {
							ID: $('#itemId').val() || 0,
							NameAr: $('#itemNameAr').val(),
							NameEn: $('#itemNameEn').val(),
							Notes: $('#notes').val()
						};

						if (data.ID != 0) {
							CB.confirm({ type: 'edit' }).then((ok) => {
								if (ok) {
									saveData(data);
								}
							});
						} else {
							saveData(data);
						}
					}
				});
			});

			function saveData(data) {
				Swal.fire({
				title: '@CrossBuy.Resources.SharedResources.Saving',
				html: '@CrossBuy.Resources.SharedResources.PleaseWaitMoment',
					allowOutsideClick: false,
					allowEscapeKey: false,
					didOpen: () => {
						Swal.showLoading();
					}
				});

				$.ajax({
					type: "POST",
					url: "/Admin/SaveLeaveType",
					data: JSON.stringify(data),
					contentType: "application/json; charset=utf-8",
					success: function (response) {
						setTimeout(function () {
							Swal.close();

							if (response.success) {
							CB.toast.success('@CrossBuy.Resources.SharedResources.Success');
								$('#addItemModal').modal('hide');

								setTimeout(function () {
									location.reload();
								}, 1000);
							} else {
								CB.toast.error(response.message || '@Localizer["An error occurred while saving."]');
							}
						}, 3000);
					},
					error: function () {
						Swal.close();
						CB.toast.error('@Localizer["An error occurred while sending."]');
					}
				});
			}
		});
</script>



<script>
	function openEditModal(id) {
		$.ajax({
			url: '/Admin/GetLeaveTypeById',
			type: 'GET',
			data: { id: id },
			success: function (response) {
				if (response.success) {
					// تعبئة بيانات المودال
					$('#itemId').val(response.data.id);
					$('#itemNameAr').val(response.data.nameAr);
					$('#itemNameEn').val(response.data.nameEn);
					$('#notes').val(response.data.notes);

					// فتح المودال
					$('#addItemModal').modal('show');
				} else {
					toastr.error(response.message || '@Localizer["Failed to load data."]');
				}
			},
			error: function () {
				toastr.error('@Localizer["An error occurred while connecting to the server."]');
			}
		});
	}
</script>


