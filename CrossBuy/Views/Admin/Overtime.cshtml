@model CrossBuy.Controllers.AdminController.OvertimePageModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    // HR5 — overtime approval within the yearly cap (HR prototype design, adopted 2026-11-08).
    ViewData["Title"] = "Overtime";
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Hm(int m) => CrossBuy.BL.Hr.HrOvertimeService.Hm(m);
    var monthsAr = new[] { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var monthsEn = new[] { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    var m = Model.Month;
    string MonthName(DateTime d) => (isAr ? monthsAr[d.Month] : monthsEn[d.Month]) + " " + d.Year;
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("اعتماد العمل الإضافي", "Overtime approval")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index", "Admin")" class="text-muted text-hover-primary">@SR["HumanResources"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@L("الإجازات والحضور", "Leave & attendance")</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Overtime", new { month = m.AddMonths(isAr ? 1 : -1).ToString("yyyy-MM") })" class="btn btn-icon btn-sm btn-light"><i class="ki-outline ki-arrow-right fs-3"></i></a>
                <span class="fw-bold fs-6 px-2">@MonthName(m)</span>
                <a href="@Url.Action("Overtime", new { month = m.AddMonths(isAr ? -1 : 1).ToString("yyyy-MM") })" class="btn btn-icon btn-sm btn-light"><i class="ki-outline ki-arrow-left fs-3"></i></a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            @if (TempData["HrErr"] is string err) { <div class="alert alert-danger d-flex align-items-center py-3 mb-5"><i class="ki-outline ki-information-5 fs-2 me-3 text-danger"></i>@err</div> }
            @if (TempData["HrMsg"] is string msg) { <div class="alert alert-primary d-flex align-items-center py-3 mb-5"><i class="ki-outline ki-check-circle fs-2 me-3 text-primary"></i>@msg</div> }

            <div class="hr-notice mb-5">
                <i class="ki-outline ki-time fs-2"></i>
                <div class="flex-grow-1">
                    <div class="fw-bold">@(Model.RequiresApproval ? L("الصرف بعد الاعتماد: مفعّل", "Paid only once approved: ON") : L("الصرف بعد الاعتماد: غير مفعّل", "Paid only once approved: OFF"))
                        @if (!string.IsNullOrWhiteSpace(Model.Reference)) { <span class="text-muted fs-8 ms-1">@Model.Reference</span> }</div>
                    <div class="fs-7">@(Model.RequiresApproval
                        ? L("الرواتب تصرف فقط العمل الإضافي المعتمد هنا لكل موظف في الشهر؛ الشهر غير المعتمد لا يُصرف عنه إضافي.", "Payroll pays only the overtime approved here, per employee per month; a month nobody approved pays no overtime.")
                        : L("الرواتب تصرف العمل الإضافي كما سجله الحضور. لتشترط الاعتماد فعّل «يُصرف بعد الاعتماد» في حزمة قواعد الدولة.", "Payroll pays overtime as attendance recorded it. To require approval, turn on “Paid only once approved” in the country rule pack."))
                        @L(" السقف السنوي: ", " Yearly cap: ")<span class="hr-num fw-bold">@(Model.YearlyCapMinutes > 0 ? Hm(Model.YearlyCapMinutes) : L("لا يوجد", "none"))</span>@L("؛ يُطبَّق عند الاعتماد بالترتيب: أيام العمل ثم الراحة ثم العطل.", "; applied at approval in order: working days, then rest days, then holidays.")</div>
                </div>
                <a href="@Url.Action("HrRules")" class="btn btn-sm btn-light flex-shrink-0">@L("حزمة قواعد الدولة", "Country rule pack")</a>
            </div>
            @if (Model.Posted) { <div class="hr-notice mb-5"><i class="ki-outline ki-lock fs-2"></i><div><div class="fw-bold">@L("رواتب الشهر مرحّلة", "This month's payroll is posted")</div><div class="fs-7">@L("القرارات مقفلة لأنها صُرفت بالفعل.", "Decisions are locked because they have been paid.")</div></div></div> }

            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] { (L("موظفون لديهم إضافي", "Employees with overtime"), Model.Employees.ToString(), "ki-people"),
                                           (L("الإضافي المسجل", "Overtime recorded"), Hm(Model.Measured), "ki-time"),
                                           (L("المعتمد", "Approved"), Hm(Model.Approved), "ki-check-circle"),
                                           (L("بانتظار الاعتماد", "Awaiting approval"), Model.Undecided.ToString(), "ki-notification-status") })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                        <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div><i class="ki-outline @s.Item3 fs-2 text-gray-400"></i></div>
                        <div class="fs-2hx fw-bold text-gray-900"><span class="hr-num">@s.Item2</span></div>
                    </div></div></div>
                }
            </div>

            <div class="card mb-5">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0">
                        <span class="fw-bold text-gray-900 fs-4">@L("العمل الإضافي للشهر", "The month's overtime")</span>
                        <span class="text-muted fs-7 mt-1">@L("ساعات:دقائق، بعد السقف اليومي", "hours:minutes, after the daily cap") · <span id="resultCount">—</span></span>
                    </div>
                    <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@L("ابحث بالموظف…", "Search employee…")" /></div>
                        <select id="f_status" class="form-select form-select-solid form-select-sm w-auto cb-filter"><option value="">@L("كل الحالات", "All statuses")</option><option value="pending">@L("بانتظار الاعتماد", "Awaiting approval")</option><option value="Approved">@L("معتمد", "Approved")</option><option value="Rejected">@L("مرفوض", "Rejected")</option></select>
                        <select id="f_size" class="form-select form-select-solid form-select-sm w-auto"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@L("إعادة ضبط", "Reset")"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-4">
                    <div class="table-responsive">
                        <table class="table align-middle gy-3 mb-0 hr-table">
                            <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                <th class="ps-4">@L("الموظف", "Employee")</th><th class="text-end">@L("أيام العمل", "Working days")</th><th class="text-end">@L("أيام الراحة", "Rest days")</th><th class="text-end">@L("العطل الرسمية", "Holidays")</th><th class="text-end">@L("المتبقي من السقف السنوي", "Yearly cap left")</th><th>@L("القرار", "Decision")</th><th class="pe-4"></th>
                            </tr></thead>
                            <tbody class="fs-6" id="rows"></tbody>
                        </table>
                    </div>
                    <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ التحميل…", "Loading…")</div>
                    <div class="text-center text-muted py-10 d-none" id="emptyRow">@L("لا عمل إضافي في هذا الشهر", "No overtime this month")</div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/Backend-assets/js/crossbuy-tagify.js" asp-append-version="true"></script>
<script>
cbServerList({
    url: '@Url.Action("OvertimeData", "Admin")',
    isAr: @(isAr ? "true" : "false"),
    addParams: function (p) { p.set('month', '@m.ToString("yyyy-MM")'); var st = document.getElementById('f_status'); if (st && st.value !== '') p.set('status', st.value); },
    onReset: function () { var st = document.getElementById('f_status'); if (st) st.value = ''; }
});
</script>
}
