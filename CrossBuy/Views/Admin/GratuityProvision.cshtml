@model CrossBuy.BL.Hr.GratuityProvisionPreview
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    // The end-of-service gratuity provision (HR prototype design, adopted 2026-11-08).
    ViewData["Title"] = "Gratuity provision";
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal v) => v.ToString("N3", inv);
    bool canPost = ViewBag.CanPost == true;
    var adj = Model.Adjustment;
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("مخصص مكافأة نهاية الخدمة", "End-of-service gratuity provision")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index", "Admin")" class="text-muted text-hover-primary">@SR["HumanResources"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@L("الرواتب والمستحقات", "Pay & entitlements")</li>
                </ul>
            </div>
            <form method="get" class="d-flex align-items-center gap-2">
                <label class="text-muted fs-7 text-nowrap">@L("حتى تاريخ", "As of")</label>
                <input type="date" name="asOf" value="@Model.AsOf.ToString("yyyy-MM-dd")" class="form-control form-control-solid form-control-sm w-auto" onchange="this.form.submit()" />
            </form>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            @if (TempData["HrErr"] is string err) { <div class="alert alert-danger d-flex align-items-center py-3 mb-5"><i class="ki-outline ki-information-5 fs-2 me-3 text-danger"></i>@err</div> }
            @if (TempData["HrMsg"] is string msg) { <div class="alert alert-primary d-flex align-items-center py-3 mb-5"><i class="ki-outline ki-check-circle fs-2 me-3 text-primary"></i>@msg</div> }

            <div class="hr-notice mb-5">
                <i class="ki-outline ki-shield-tick fs-2"></i>
                <div class="flex-grow-1">
                    <div class="fw-bold">@(isAr ? Model.PackNameAr : Model.PackNameEn)</div>
                    <div class="fs-7">@L("المكافأة التي تستحق لكل موظف نشط لو انتهت خدمته من صاحب العمل في هذا التاريخ: حزمة قواعد الدولة على أجره " + (Model.WageIsBasic ? "الأساسي" : "الشامل") + " وسنوات خدمته — نفس حساب شاشة نهاية الخدمة. يُرحَّل الفرق بين المطلوب والرصيد المسجل (مدين مصروف المكافأة ٥٢٠١٠٧ / دائن المخصص ٢١٠٦، أو العكس لتحرير الزائد)؛ ترحيل التاريخ نفسه مرتين لا يكرر شيئاً.",
                        "The gratuity each active employee would be owed on termination by the employer on this date: the country rule pack on their " + (Model.WageIsBasic ? "basic" : "total") + " wage and years of service — the end-of-service screen's own computation. The difference between required and booked is posted (Dr gratuity expense 520107 / Cr provision 2106, or the reverse to release a surplus); posting the same date twice posts nothing.")</div>
                </div>
            </div>
            @if (!Model.HasAccounts) { <div class="alert alert-danger py-3 mb-5">@L("حسابا المخصص (٥٢٠١٠٧ و٢١٠٦) غير معرّفين لهذه الشركة.", "The provision accounts (520107 and 2106) are not defined for this company.")</div> }

            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] { (L("موظفون", "Employees"), Model.Rows.Count.ToString(), "ki-people", ""), (L("المخصص المطلوب", "Required"), Money(Model.Required), "ki-shield-tick", Model.Currency),
                                           (L("المسجل في الدفاتر", "Booked"), Money(Model.Booked), "ki-book", Model.Currency), (L("الفرق للترحيل", "To post"), (adj > 0 ? "+" : "") + Money(adj), "ki-arrows-loop", Model.Currency) })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                        <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div><i class="ki-outline @s.Item3 fs-2 text-gray-400"></i></div>
                        <div class="fs-3 fw-bold text-gray-900 text-nowrap"><span class="hr-num">@s.Item2</span> <span class="fs-8 text-muted">@s.Item4</span></div>
                    </div></div></div>
                }
            </div>

            @if (canPost && Model.HasAccounts && adj != 0)
            {
                <form asp-action="PostGratuityProvision" method="post" class="mb-5" data-cb-confirm data-cb-action="generic"
                      data-cb-text="@L("ترحيل تسوية المخصص بمبلغ " + Money(Math.Abs(adj)) + " حتى " + Model.AsOf.ToString("yyyy-MM-dd") + "؟", "Post the provision adjustment of " + Money(Math.Abs(adj)) + " as of " + Model.AsOf.ToString("yyyy-MM-dd") + "?")">
                    @Html.AntiForgeryToken()<input type="hidden" name="asOf" value="@Model.AsOf.ToString("yyyy-MM-dd")" />
                    <button class="btn btn-primary"><i class="ki-outline ki-check fs-3"></i>@L("ترحيل التسوية", "Post the adjustment")</button>
                </form>
            }
            else if (!canPost && adj != 0) { <div class="text-muted fs-7 mb-5">@L("الترحيل يحتاج صلاحية «إدارة الرواتب».", "Posting needs the payroll-manage right.")</div> }

            <div class="card mb-5">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0">
                        <span class="fw-bold text-gray-900 fs-4">@L("حسب الموظف", "By employee")</span>
                        <span class="text-muted fs-7 mt-1"><span id="resultCount">—</span></span>
                    </div>
                    <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@L("ابحث بالموظف…", "Search employee…")" /></div>
                        <select id="f_size" class="form-select form-select-solid form-select-sm w-auto"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@L("إعادة ضبط", "Reset")"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-4">
                    <div class="table-responsive">
                        <table class="table align-middle gy-3 mb-0 hr-table">
                            <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-4">@L("الموظف", "Employee")</th><th>@L("التعيين", "Joined")</th><th class="text-end">@L("سنوات الخدمة", "Years")</th><th class="text-end">@L("الأجر", "Wage")</th><th class="text-end pe-4">@L("المكافأة المستحقة", "Gratuity owed")</th></tr></thead>
                            <tbody class="fs-6" id="rows"></tbody>
                        </table>
                    </div>
                    <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ التحميل…", "Loading…")</div>
                    <div class="text-center text-muted py-10 d-none" id="emptyRow">@L("لا موظفين", "No employees")</div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/Backend-assets/js/crossbuy-tagify.js" asp-append-version="true"></script>
<script>
cbServerList({
    url: '@Url.Action("GratuityProvisionData", "Admin")',
    isAr: @(isAr ? "true" : "false"),
    addParams: function (p) { p.set('asOf', '@Model.AsOf.ToString("yyyy-MM-dd")'); }
});
</script>
}
