@using CrossBuy.Models.Context.Admin
@model Appraisal
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var criteria = ViewBag.Criteria as List<AppraisalCriterion> ?? new();
    var names = ViewBag.Names as Dictionary<int, string> ?? new();
    var lineByCrit = Model.Lines.ToDictionary(l => l.CriterionId, l => l);
    bool locked = Model.Status >= 1;   // submitted/acknowledged → read-only
    var statusText = new[] { SR["Draft"].Value, Localizer["Submitted"].Value, Localizer["Acknowledged"].Value };
}
<form asp-action="SaveAppraisalScores" method="post" id="scoreForm" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.ID" />
    <input type="hidden" name="scoresJson" id="scoresJson" />
    <input type="hidden" name="submit" id="submitFlag" value="false" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div><h1 class="page-heading fw-bold fs-3 m-0">@Localizer["Appraisal"]</h1>
            <span class="text-muted fs-7">@(names.TryGetValue(Model.EmployeeID, out var en) ? en : ("#" + Model.EmployeeID)) · @statusText[Model.Status]</span></div>
        <div class="d-flex gap-2"><a href="@Url.Action("Appraisals","Admin")" class="btn btn-light">@SR["Back"]</a>
            @if (!locked)
            {
                <button type="button" id="saveBtn" class="btn btn-light-primary"><i class="ki-outline ki-check fs-3"></i>@Localizer["Save draft"]</button>
                <button type="button" id="subBtn" class="btn btn-primary"><i class="ki-outline ki-send fs-3"></i>@SR["Submit"]</button>
            }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (TempData["HrErr"] != null) { <div class="alert alert-danger">@TempData["HrErr"]</div> }
        <div class="card card-flush mb-5"><div class="card-body py-6 d-flex flex-stack">
            <div><div class="text-muted fs-7">@Localizer["Weighted score"]</div><div class="fs-1 fw-bold text-primary"><span id="totalScore">@Model.TotalScore.ToString("0.#")</span>%</div></div>
            @if (locked) { <span class="badge badge-light-primary fs-6">@Localizer["Read-only — submitted"]</span> }
        </div></div>

        <div class="card card-flush"><div class="card-body pt-6"><div class="table-responsive"><table class="table table-row-bordered align-middle gy-3">
            <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;"><th>@Localizer["Criterion"]</th><th class="text-center w-100px">@Localizer["Weight"]</th><th class="text-center w-100px">@Localizer["Max"]</th><th class="text-center w-150px">@Localizer["Score"]</th><th>@SR["Note"]</th></tr></thead>
            <tbody>
            @foreach (var c in criteria)
            {
                var line = lineByCrit.TryGetValue(c.ID, out var l) ? l : null;
                <tr data-cid="@c.ID" data-weight="@c.Weight" data-max="@c.MaxScore">
                    <td class="fw-semibold">@(isAr ? c.Name : (string.IsNullOrEmpty(c.NameEn) ? c.Name : c.NameEn))</td>
                    <td class="text-center">@c.Weight.ToString("0.##")</td>
                    <td class="text-center">@c.MaxScore.ToString("0.##")</td>
                    <td class="text-center"><input class="form-control form-control-solid form-control-sm sc" type="number" step="0.01" min="0" max="@c.MaxScore" value="@(line?.Score ?? 0)" @(locked ? "disabled" : "") /></td>
                    <td><input class="form-control form-control-solid form-control-sm nt" value="@(line?.Note)" @(locked ? "disabled" : "") /></td>
                </tr>
            }
            </tbody>
        </table></div>
            <div class="mt-4"><label class="fw-semibold fs-7 mb-1">@Localizer["Manager comment"]</label><textarea name="managerComment" class="form-control form-control-solid" rows="2" @(locked ? "disabled" : "")>@Model.ManagerComment</textarea></div>
            @if (Model.Status == 2 && !string.IsNullOrEmpty(Model.EmployeeComment)) { <div class="mt-3"><label class="fw-semibold fs-7 mb-1">@Localizer["Employee comment"]</label><div class="text-muted">@Model.EmployeeComment</div></div> }
        </div></div>
    </div></div>
</form>
@section Scripts {
<script>
(function(){
  var rows = Array.prototype.slice.call(document.querySelectorAll('tr[data-cid]'));
  function calc(){ var ws=0,acc=0; rows.forEach(function(r){ var w=parseFloat(r.getAttribute('data-weight'))||0, mx=parseFloat(r.getAttribute('data-max'))||5, s=parseFloat(r.querySelector('.sc').value||'0')||0; if(s<0)s=0; if(s>mx)s=mx; ws+=w; acc+=(s/mx)*w; }); document.getElementById('totalScore').textContent=(ws>0?(acc/ws*100):0).toFixed(1); }
  rows.forEach(function(r){ var sc=r.querySelector('.sc'); if(sc) sc.addEventListener('input',calc); });
  function collect(){ return rows.map(function(r){ return { criterionId: parseInt(r.getAttribute('data-cid')), score: parseFloat(r.querySelector('.sc').value||'0')||0, note: r.querySelector('.nt').value||null }; }); }
  function go(submit){ document.getElementById('scoresJson').value=JSON.stringify(collect()); document.getElementById('submitFlag').value=submit?'true':'false'; document.getElementById('scoreForm').submit(); }
  var sb=document.getElementById('saveBtn'); if(sb) sb.addEventListener('click',function(){go(false);});
  var ub=document.getElementById('subBtn'); if(ub) ub.addEventListener('click',function(){go(true);});
  calc();
})();
</script>
}
