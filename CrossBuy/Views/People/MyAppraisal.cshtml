@using CrossBuy.Models.Context.Admin
@model Appraisal
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutPeople.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var criteria = ViewBag.Criteria as List<AppraisalCriterion> ?? new();
    var lineByCrit = Model.Lines.ToDictionary(l => l.CriterionId, l => l);
    var mgr = ViewBag.Manager as string;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div><h1 class="page-heading fw-bold fs-3 m-0">@Localizer["Performance appraisal"]</h1><span class="text-muted fs-7">@Localizer["Appraiser"]: @mgr</span></div>
        <a href="@Url.Action("MyAppraisals","People")" class="btn btn-light">@SR["Back"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush mb-5"><div class="card-body py-6"><div class="text-muted fs-7">@Localizer["Weighted score"]</div><div class="fs-1 fw-bold text-primary">@Model.TotalScore.ToString("0.#")%</div></div></div>

        <div class="card card-flush mb-5"><div class="card-body pt-6"><div class="table-responsive"><table class="table table-row-bordered align-middle gy-3">
            <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;"><th>@Localizer["Criterion"]</th><th class="text-center">@Localizer["Score"]</th><th class="text-center">@Localizer["Max"]</th><th>@SR["Note"]</th></tr></thead>
            <tbody>
            @foreach (var c in criteria)
            {
                var line = lineByCrit.TryGetValue(c.ID, out var l) ? l : null;
                <tr>
                    <td class="fw-semibold">@(isAr ? c.Name : (string.IsNullOrEmpty(c.NameEn) ? c.Name : c.NameEn))</td>
                    <td class="text-center fw-bold">@(line?.Score.ToString("0.##") ?? "0")</td>
                    <td class="text-center text-muted">@c.MaxScore.ToString("0.##")</td>
                    <td class="text-muted fs-7">@(line?.Note)</td>
                </tr>
            }
            </tbody>
        </table></div>
            @if (!string.IsNullOrEmpty(Model.ManagerComment)) { <div class="mt-3"><label class="fw-semibold fs-7 mb-1">@Localizer["Manager comment"]</label><div class="text-muted">@Model.ManagerComment</div></div> }
        </div></div>

        @if (Model.Status == 1)
        {
            <div class="card card-flush"><div class="card-header"><div class="card-title"><h2>@Localizer["Acknowledgment"]</h2></div></div>
                <div class="card-body pt-2">
                    <form asp-action="AcknowledgeAppraisal" method="post" data-cb-confirm data-cb-action="approve" data-cb-text="@Localizer["Acknowledge this appraisal?"]">@Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ID" />
                        <label class="fw-semibold fs-6 mb-2">@Localizer["Your comment (optional)"]</label>
                        <textarea name="comment" class="form-control form-control-solid mb-4" rows="2"></textarea>
                        <button class="btn btn-primary"><i class="ki-outline ki-check fs-3"></i>@Localizer["I acknowledge"]</button>
                    </form>
                </div>
            </div>
        }
        else if (Model.Status == 2)
        {
            <div class="alert alert-success">@Localizer["You have acknowledged this appraisal"]@(string.IsNullOrEmpty(Model.EmployeeComment) ? "" : " — " + Model.EmployeeComment)</div>
        }
    </div></div>
</div>
