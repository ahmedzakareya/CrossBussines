@using CrossBuy.BL
@using CrossBuy.Models.Context.Admin
@model PeopleDashboardDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutPeople.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var name = isAr ? (ViewBag.NameAr ?? ViewBag.NameEn) : (ViewBag.NameEn ?? ViewBag.NameAr);
    string nm(string? a, string? b) => (isAr ? a : b)?.Trim().Length > 0 ? (isAr ? a : b)! : (b ?? a ?? "-");
    var palette = new[] { "primary", "success", "warning", "info", "danger" };
    var barHex = new[] { "#0E4A9E", "#0d9edc", "#f6c000", "#7239ea", "#f1416c" };
    var recent = ViewBag.Recent as List<LeaveRequest> ?? new List<LeaveRequest>();
    var leaveDays = ViewBag.LeaveDays as HashSet<int> ?? new HashSet<int>();
    DateTime now = ViewBag.Now ?? DateTime.UtcNow;
    var monthStart = new DateTime(now.Year, now.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(now.Year, now.Month);
    var leadBlanks = (int)monthStart.DayOfWeek; // Sunday=0
    var monthNames = new[] { "", Localizer["January"].Value, Localizer["February"].Value, Localizer["March"].Value, Localizer["April"].Value, Localizer["May"].Value, Localizer["June"].Value, Localizer["July"].Value, Localizer["August"].Value, Localizer["September"].Value, Localizer["October"].Value, Localizer["November"].Value, Localizer["December"].Value };
    var dow = new[] { Localizer["Sun"].Value, Localizer["Mon"].Value, Localizer["Tue"].Value, Localizer["Wed"].Value, Localizer["Thu"].Value, Localizer["Fri"].Value, Localizer["Sat"].Value };
    var statusBadge = new[] { "warning", "success", "danger" };
    var statusText = new[] { Localizer["Pending"].Value, Localizer["Approved"].Value, Localizer["Rejected"].Value };
    // chart data
    var donutLabels = string.Join(",", Model.ByType.Select(t => "'" + (nm(t.NameAr, t.NameEn)).Replace("'", " ") + "'"));
    var donutSeries = string.Join(",", Model.ByType.Select(t => t.Count));
    var trendSeries = string.Join(",", Model.Monthly.Select(m => m.Count));
    var trendCats = string.Join(",", Model.Monthly.Select(m => "'" + monthNames[m.Month] + "'"));
}

<style>
    /* Force Cairo on ApexCharts SVG text + HTML legend (beats ApexCharts' internal font on the chart <text> nodes) */
    .apexcharts-canvas text,
    .apexcharts-canvas text tspan,
    .apexcharts-text, .apexcharts-text tspan,
    .apexcharts-datalabel, .apexcharts-datalabel-label, .apexcharts-datalabel-value,
    .apexcharts-legend-text,
    .apexcharts-tooltip,
    .apexcharts-title-text { font-family: 'Cairo', sans-serif !important; }
</style>
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-column justify-content-center">
            <h1 class="page-heading text-gray-900 fw-bold fs-2 m-0">@Localizer["Welcome, {0} 👋", name]</h1>
            <span class="text-muted fw-semibold fs-7 mt-1">@Localizer["A quick look at your balances and requests"]</span>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <!--begin::Total requests + trend-->
            <div class="card mb-6" style="background:linear-gradient(135deg,#0E4A9E,#145DBF);border:0;">
                <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-6">
                    <div class="flex-shrink-0">
                        <div class="text-white-50 fw-semibold fs-6 mb-1">@Localizer["Total requests"]</div>
                        <div class="d-flex align-items-end gap-3">
                            <span class="text-white fw-bold" style="font-size:3rem;line-height:1;">@Model.Total</span>
                            <span class="badge mb-2 fw-bold" style="background:#fff;color:#0E4A9E;"><i class="ki-outline ki-arrow-@(Model.PctChange >= 0 ? "up" : "down") fs-7 me-1" style="color:#0E4A9E;"></i>@Math.Abs(Model.PctChange)%</span>
                        </div>
                        <div class="text-white-50 fs-8 mt-1">@Localizer["vs last month"]</div>
                    </div>
                    <div class="flex-grow-1 w-100"><div id="trend_chart" style="min-height:150px;"></div></div>
                </div>
            </div>
            <!--end::Total requests + trend-->

            <!--begin::Stat tiles-->
            <div class="row g-5 g-xl-8 mb-2">
                @{
                    var tiles = new[] {
                        (Localizer["My pending"].Value, Model.MyPending, "ki-time", "warning"),
                        (Localizer["Approved this year"].Value, Model.MyApprovedThisYear, "ki-check-circle", "success"),
                        (Localizer["Awaiting my approval"].Value, Model.PendingApprovals, "ki-notification-status", "primary"),
                        (Localizer["My team"].Value, Model.TeamSize, "ki-people", "info"),
                    };
                }
                @foreach (var (label, val, icon, col) in tiles)
                {
                    <div class="col-6 col-md-3">
                        <div class="card card-flush h-100">
                            <div class="card-body d-flex flex-column justify-content-center py-6">
                                <div class="symbol symbol-40px mb-3"><span class="symbol-label bg-light-@col"><i class="ki-outline @icon fs-2 text-@col"></i></span></div>
                                <span class="fs-2hx fw-bold text-gray-900 lh-1">@val</span>
                                <span class="text-muted fw-semibold fs-7 mt-1">@label</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!--end::Stat tiles-->

            <!--begin::Balances-->
            <div class="card card-flush mt-6">
                <div class="card-header pt-6">
                    <div class="card-title"><h3 class="fw-bold text-gray-900">@Localizer["Leave Balances"]</h3></div>
                    @if (Model.HasPolicy)
                    {
                        <div class="card-toolbar"><span class="badge badge-light-primary fs-7">@Localizer["Policy: "]@nm(Model.PolicyNameAr, Model.PolicyNameEn)</span></div>
                    }
                </div>
                <div class="card-body pt-2">
                    @if (!Model.HasPolicy)
                    {
                        <div class="text-center text-muted py-8 fs-6"><i class="ki-outline ki-information-5 fs-3x text-muted mb-3 d-block"></i>@Localizer["You are not assigned to a leave policy yet."]</div>
                    }
                    else
                    {
                        <div class="row g-5">
                            @for (var i = 0; i < Model.Balances.Count; i++)
                            {
                                var b = Model.Balances[i];
                                var h = barHex[i % barHex.Length];
                                var pct = b.Entitlement > 0 ? (int)Math.Round(100.0 * b.Remaining / b.Entitlement) : 0; if (pct < 0) pct = 0;
                                <div class="col-md-6 col-xl-4">
                                    <div class="border border-gray-300 border-dashed rounded p-5 h-100">
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="symbol symbol-40px me-3"><span class="symbol-label" style="background:@(h)1a;"><i class="ki-outline ki-calendar-tick fs-2" style="color:@h;"></i></span></div>
                                            <span class="fs-5 fw-bold text-gray-900">@nm(b.NameAr, b.NameEn)</span>
                                        </div>
                                        <div class="d-flex align-items-end flex-stack mb-2">
                                            <span class="fs-2hx fw-bold text-gray-900 lh-1">@b.Remaining</span>
                                            <span class="text-muted fw-semibold fs-7">@Localizer["of {0} days", b.Entitlement]</span>
                                        </div>
                                        <div class="progress h-8px" style="background:@(h)1a;"><div class="progress-bar" style="width:@(pct)%;background:@h;"></div></div>
                                        <div class="d-flex flex-stack mt-2 fs-8 text-muted fw-semibold"><span>@Localizer["Remaining"]</span><span>@Localizer["Used: {0}", b.Used]</span></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <!--end::Balances-->

            <div class="row g-5 g-xl-8 mt-1">
                <!--begin::Recent requests-->
                <div class="col-xl-7">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-6"><div class="card-title"><h3 class="fw-bold text-gray-900">@Localizer["Recent requests"]</h3></div>
                            <div class="card-toolbar"><a href="@Url.Action("Leaves","People")" class="btn btn-sm btn-light-primary">@Localizer["View all"]</a></div>
                        </div>
                        <div class="card-body pt-2">
                            @if (recent.Count == 0)
                            {
                                <div class="text-center text-muted py-8">@Localizer["No requests"]</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                <table class="table align-middle table-row-dashed fs-7 gy-3">
                                    <thead><tr class="text-muted fw-bold fs-8 text-uppercase" style="border-bottom:2px solid #0E4A9E;">
                                        <th>@SR["Type"]</th><th>@SR["From"]</th><th>@SR["To"]</th><th>@Localizer["Days"]</th><th class="text-end">@SR["Status"]</th>
                                    </tr></thead>
                                    <tbody>
                                    @foreach (var r in recent)
                                    {
                                        <tr>
                                            <td class="fw-bold text-gray-900">@nm(r.LeaveType?.NameAr, r.LeaveType?.NameEn)</td>
                                            <td>@r.StartDate.ToString("yyyy/MM/dd")</td>
                                            <td>@r.EndDate.ToString("yyyy/MM/dd")</td>
                                            <td><span class="fw-bold text-primary">@r.Days</span></td>
                                            <td class="text-end"><span class="badge badge-light-@statusBadge[r.Status]">@statusText[r.Status]</span></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <!--end::Recent requests-->

                <!--begin::Donut-->
                <div class="col-xl-5">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-6"><div class="card-title"><h3 class="fw-bold text-gray-900">@Localizer["Requests distribution"]</h3></div></div>
                        <div class="card-body d-flex flex-column align-items-center justify-content-center pt-2">
                            @if (Model.Total == 0)
                            {
                                <div class="text-center text-muted py-8">@SR["NoData"]</div>
                            }
                            else
                            {
                                <div id="donut_chart"></div>
                            }
                        </div>
                    </div>
                </div>
                <!--end::Donut-->
            </div>

            <div class="row g-5 g-xl-8 mt-1 mb-8">
                <!--begin::Manage-->
                <div class="col-xl-5">
                    <div class="card card-flush h-100 bg-light-primary">
                        <div class="card-body d-flex flex-column justify-content-center text-center py-10">
                            <i class="ki-outline ki-calendar-add fs-4x text-primary mb-4"></i>
                            <h3 class="fw-bold text-gray-900 mb-2">@Localizer["Manage your requests easily"]</h3>
                            <div class="text-muted fs-6 mb-5">@Localizer["Submit a new leave request or track your status"]</div>
                            <div><a href="@Url.Action("Leaves","People")" class="btn btn-primary"><i class="ki-outline ki-plus fs-3"></i>@Localizer["New leave request"]</a></div>
                        </div>
                    </div>
                </div>
                <!--end::Manage-->

                <!--begin::Calendar-->
                <div class="col-xl-7">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-6"><div class="card-title"><h3 class="fw-bold text-gray-900">@monthNames[now.Month] @now.Year</h3></div></div>
                        <div class="card-body pt-2">
                            <div class="text-center" style="display:grid;grid-template-columns:repeat(7,1fr);gap:.35rem;align-items:center;justify-items:center;">
                                @for (var i = 0; i < 7; i++)
                                {
                                    <span class="text-muted fw-bold fs-8 py-2">@dow[i]</span>
                                }
                                @for (var i = 0; i < leadBlanks; i++)
                                {
                                    <span>&nbsp;</span>
                                }
                                @for (var day = 1; day <= daysInMonth; day++)
                                {
                                    var isLeave = leaveDays.Contains(day);
                                    var isToday = day == now.Day;
                                    var cls = isLeave ? "text-white" : (isToday ? "text-white" : "text-gray-700");
                                    var bg = isLeave ? "background:#0E4A9E;" : (isToday ? "background:#145DBF;" : "");
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle fw-semibold fs-7 @cls" style="width:36px;height:36px;@bg">@day</span>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-5 mt-5 pt-4 border-top border-gray-200 fs-8 fw-semibold text-gray-700">
                                <span class="d-flex align-items-center"><span class="d-inline-block rounded-circle me-2" style="width:14px;height:14px;background:#0E4A9E;"></span>@Localizer["Leave days"]</span>
                                <span class="d-flex align-items-center"><span class="d-inline-block rounded-circle me-2" style="width:14px;height:14px;background:#145DBF;"></span>@Localizer["Today"]</span>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end::Calendar-->
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var FF = 'Cairo, sans-serif';
            function draw() {
                if (typeof ApexCharts === 'undefined') return;
                // global default so every chart element (labels/legend/tooltip) uses Cairo
                window.Apex = window.Apex || {};
                window.Apex.chart = Object.assign({}, window.Apex.chart, { fontFamily: FF });
                // trend
                var tEl = document.querySelector('#trend_chart');
                if (tEl) {
                    new ApexCharts(tEl, {
                        chart: { type: 'area', height: 150, fontFamily: FF, sparkline: { enabled: false }, toolbar: { show: false }, foreColor: 'rgba(255,255,255,.75)' },
                        series: [{ name: '@Localizer["Requests"]', data: [@Html.Raw(trendSeries)] }],
                        xaxis: { categories: [@Html.Raw(trendCats)], axisBorder: { show: false }, axisTicks: { show: false }, labels: { style: { fontFamily: FF } } },
                        yaxis: { labels: { style: { fontFamily: FF }, formatter: function (v) { return Math.round(v); } } },
                        stroke: { curve: 'smooth', width: 3, colors: ['#ffffff'] },
                        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.45, opacityTo: 0.05 }, colors: ['#ffffff'] },
                        colors: ['#ffffff'], dataLabels: { enabled: false }, grid: { borderColor: 'rgba(255,255,255,.12)' },
                        tooltip: { theme: 'dark', style: { fontFamily: FF } }
                    }).render();
                }
                // donut
                var dEl = document.querySelector('#donut_chart');
                if (dEl) {
                    new ApexCharts(dEl, {
                        chart: { type: 'donut', width: 320, fontFamily: FF },
                        series: [@Html.Raw(donutSeries)],
                        labels: [@Html.Raw(donutLabels)],
                        colors: ['#145DBF', '#2f9e6e', '#F59E0B', '#22CCE2', '#145DBF'],
                        legend: { position: 'bottom', fontSize: '13px', fontFamily: FF },
                        dataLabels: { enabled: true, style: { fontFamily: FF }, formatter: function (v) { return Math.round(v) + '%'; } },
                        tooltip: { style: { fontFamily: FF } },
                        plotOptions: { pie: { donut: { size: '62%', labels: { show: true,
                            name: { fontFamily: FF }, value: { fontFamily: FF },
                            total: { show: true, label: '@SR["Total"]', fontFamily: FF, formatter: function () { return '@Model.Total'; } } } } } }
                    }).render();
                }
            }
            function boot() {
                // render only after Cairo is actually loaded, else ApexCharts measures glyphs with the fallback font
                if (document.fonts && document.fonts.load) {
                    document.fonts.load('700 16px Cairo').then(function () { return document.fonts.load('400 16px Cairo'); }).then(draw).catch(draw);
                } else { draw(); }
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
        })();
    </script>
}
