@using CrossBuy.BL
@using CrossBuy.Models.Context.Admin
@model PeopleDashboardDto
@{
    // HR prototype design (design-output/hr-prototype #/ess), adopted by the owner on 2026-11-08 for every HR
    // screen the prototype shares with the system. Same data as before (LeaveDashboardService.BuildAsync); every
    // tile opens a screen that already exists, and the services that do not exist yet say so.
    Layout = "~/Views/Shared/_LayoutPeople.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    string Pick(string? ar, string? en) => (isAr ? (string.IsNullOrWhiteSpace(ar) ? en : ar) : (string.IsNullOrWhiteSpace(en) ? ar : en)) ?? "—";
    string nameAr = ViewBag.NameAr, nameEn = ViewBag.NameEn;
    var name = Pick(nameAr, nameEn);
    string? photo = ViewBag.Photo;
    var initials = CrossBuy.BL.Hr.PersonTile.Initials(nameAr, nameEn);
    var recent = ViewBag.Recent as List<LeaveRequest> ?? new List<LeaveRequest>();
    var waiting = ViewBag.Waiting as Dictionary<int, string> ?? new Dictionary<int, string>();
    bool IsKind(LeaveBalanceRow b, string word) => (b.NameEn ?? "").Contains(word, StringComparison.OrdinalIgnoreCase);
    var annual = Model.Balances.FirstOrDefault(b => IsKind(b, "annual"));
    var sick = Model.Balances.FirstOrDefault(b => IsKind(b, "sick") || IsKind(b, "medical"));
    var tiles = new List<(string icon, string title, string sub, string? url)> {
        ("ki-calendar-add", L("طلب إجازة", "Request leave"), annual != null ? L("المتاح ", "Available ") + annual.Remaining + L(" يوماً", " days") : L("أرصدتك وطلباتك", "Your balances and requests"), Url.Action("Leaves", "People")),
        ("ki-document", L("شهادات وطلبات", "Letters & requests"), L("شهادة راتب أو خبرة، إذن خروج", "Salary or experience letter, permission"), Url.Action("Requests", "People")),
        ("ki-bill", L("كشف الراتب", "Payslips"), L("كشوفك الشهرية", "Your monthly payslips"), Url.Action("Payslips", "People")),
        ("ki-time", L("حضوري", "My attendance"), L("الدخول والخروج", "Check-in and check-out"), Url.Action("Attendance", "People")),
        ("ki-profile-circle", L("ملفي", "My profile"), L("بياناتي ووثائقي", "My details and documents"), Url.Action("Profile", "People")),
        ("ki-abstract-26", L("الهيكل", "Structure"), L("مديري وفريقي", "My manager and team"), Url.Action("Structure", "People")),
        ("ki-medal-star", L("تقييماتي", "My appraisals"), L("الأهداف والتقييم", "Goals and reviews"), Url.Action("MyAppraisals", "People")),
        ("ki-teacher", L("تدريبي", "My training"), L("الدورات المسجلة", "Enrolled courses"), Url.Action("MyTrainings", "People")),
        ("ki-dollar", L("طلب سلفة", "Request an advance"), L("بسقف من الأجر", "Capped on the wage"), null),
        ("ki-user-edit", L("تعديل بياناتي", "Update my details"), L("IBAN وهاتف وعنوان بموافقة الموارد البشرية", "IBAN, phone, address with HR approval"), null),
        ("ki-arrow-two-diagonals", L("تفويض موافقاتي", "Delegate my approvals"), L("أثناء إجازتي", "While I am on leave"), null) };
}
<link href="~/css/hr.css" rel="stylesheet" asp-append-version="true" />
<style>
    .ess-tile { display: block; height: 100%; padding: 1.25rem; border-radius: .75rem; border: 1px solid var(--bs-gray-200); background: var(--bs-body-bg); transition: border-color .15s, box-shadow .15s; }
    a.ess-tile:hover { border-color: var(--cb-brand, #3A5795); box-shadow: 0 4px 14px rgba(58, 87, 149, .10); }
    .ess-tile.soon { background: var(--bs-gray-100); cursor: default; }
</style>

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("بوابة الموظف", "Employee self-service")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@L("الخدمة الذاتية", "Self-service")</li></ul>
            </div>
            <a href="@Url.Action("Leaves", "People")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-4"></i>@L("طلب إجازة", "Request leave")</a>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            @* ── Welcome ── *@
            <div class="card mb-5">
                <div class="card-body d-flex flex-wrap gap-6 align-items-center py-6">
                    <div class="symbol symbol-80px symbol-circle flex-shrink-0">
                        @if (photo != null) { <img src="@photo" alt="" /> } else { <span class="symbol-label fs-2 fw-bold hr-initials">@initials</span> }
                    </div>
                    <div class="min-w-0">
                        <div class="fs-2 fw-bold text-gray-900">@L("أهلاً ", "Welcome, ")<bdi>@name</bdi></div>
                        <div class="text-muted fw-semibold">@string.Join(" · ", new[] { Pick((string?)ViewBag.TitleAr, (string?)ViewBag.TitleEn), Pick((string?)ViewBag.BranchAr, (string?)ViewBag.BranchEn) }.Where(x => x != "—"))</div>
                        @if (Model.HasPolicy) { <div class="text-muted fs-7 mt-1">@L("سياسة الإجازات", "Leave policy"): <span class="fw-bold text-gray-700">@Pick(Model.PolicyNameAr, Model.PolicyNameEn)</span></div> }
                    </div>
                    <div class="ms-auto d-flex flex-wrap gap-8">
                        @foreach (var s in new[] { (L("إجازة سنوية متاحة", "Annual leave available"), annual?.Remaining.ToString() ?? "—"),
                                                   (L("مرضية مستخدمة", "Sick leave used"), sick?.Used.ToString() ?? "—"),
                                                   (L("طلبات مفتوحة", "Open requests"), Model.MyPending.ToString()),
                                                   (L("معتمدة هذا العام", "Approved this year"), Model.MyApprovedThisYear.ToString()) })
                        {
                            <div class="text-center"><div class="fs-2 fw-bold hr-num text-gray-900">@s.Item2</div><div class="text-muted fs-8">@s.Item1</div></div>
                        }
                    </div>
                </div>
            </div>

            @if (Model.PendingApprovals > 0)
            {
                <div class="hr-notice mb-5">
                    <i class="ki-outline ki-notification-status fs-2"></i>
                    <div class="flex-grow-1"><div class="fw-bold">@L("بانتظار موافقتك", "Waiting for your approval")</div>
                        <div class="fs-7"><span class="hr-num fw-bold">@Model.PendingApprovals</span> @L("طلباً من فريقك", "requests from your team") (<span class="hr-num">@Model.TeamSize</span> @L("في فريقك", "in your team"))</div></div>
                    <a href="@Url.Action("Index", "Approvals")" class="btn btn-sm btn-primary align-self-center">@L("صندوق الموافقات", "Approvals inbox")</a>
                </div>
            }

            @* ── Services ── *@
            <div class="row g-5 mb-5">
                @foreach (var t in tiles)
                {
                    <div class="col-sm-6 col-xl-3">
                        @if (t.url != null)
                        {
                            <a href="@t.url" class="ess-tile text-decoration-none">
                                <i class="ki-outline @t.icon fs-2x text-primary mb-3 d-block"></i>
                                <div class="fw-bold fs-6 text-gray-900">@t.title</div>
                                <div class="text-muted fs-7">@t.sub</div>
                            </a>
                        }
                        else
                        {
                            <div class="ess-tile soon">
                                <div class="d-flex flex-stack mb-3"><i class="ki-outline @t.icon fs-2x text-gray-400"></i><span class="badge badge-light fw-bold fs-8">@L("قادم", "Coming")</span></div>
                                <div class="fw-bold fs-6 text-gray-600">@t.title</div>
                                <div class="text-muted fs-7">@t.sub</div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="row g-5 mb-5">
                @* ── My requests ── *@
                <div class="col-xl-7">
                    <div class="card h-100">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("طلباتي", "My requests")</span>
                            <span class="text-muted fs-7 mt-1">@L("آخر خمسة طلبات إجازة", "Your last five leave requests")</span></div>
                            <div class="card-toolbar"><a href="@Url.Action("Leaves", "People")" class="btn btn-sm btn-light-primary">@L("الكل", "All")</a></div></div>
                        <div class="card-body pt-4">
                            <table class="table align-middle gy-3 mb-0 hr-table">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted"><th class="ps-0">@L("الطلب", "Request")</th><th>@L("الفترة", "Period")</th><th>@L("أين وصل", "Where it is")</th><th class="text-end">@L("الحالة", "Status")</th></tr></thead>
                                <tbody class="fs-6">
                                    @if (recent.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-8">@L("لا طلبات بعد", "No requests yet")</td></tr> }
                                    @foreach (var r in recent)
                                    {
                                        <tr>
                                            <td class="ps-0"><div class="fw-semibold">@Pick(r.LeaveType?.NameAr, r.LeaveType?.NameEn)</div><div class="text-muted fs-8"><span class="hr-num">@r.Days</span> @L("يوم", "days")</div></td>
                                            <td class="text-nowrap hr-num">@r.StartDate.ToString("yyyy-MM-dd")</td>
                                            <td class="fs-7 text-gray-700">
                                                @if (r.Status == 0) { if (r.CurrentApproverEmployeeID is int w && waiting.TryGetValue(w, out var wn)) { <span>@L("بانتظار", "Waiting on") <bdi class="fw-semibold">@wn</bdi></span> } else { <span class="text-danger">@L("بلا معتمِد — راجع الموارد البشرية", "No approver — ask HR")</span> } }
                                                else if (r.DecisionAt.HasValue) { <span class="text-muted hr-num">@r.DecisionAt.Value.ToString("yyyy-MM-dd")</span> }
                                                else { <span class="text-muted">—</span> }
                                            </td>
                                            <td class="text-end">
                                                @switch (r.Status)
                                                {
                                                    case 1: <span class="badge badge-light-primary fw-bold fs-8">@L("معتمدة", "Approved")</span> break;
                                                    case 2: <span class="badge badge-light-danger fw-bold fs-8">@L("مرفوضة", "Rejected")</span> break;
                                                    default: <span class="badge badge-light-primary fw-bold fs-8">@L("قيد الموافقة", "Pending")</span> break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @* ── My balances ── *@
                <div class="col-xl-5">
                    <div class="card h-100">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                            <span class="fw-bold text-gray-900 fs-4">@L("أرصدتي", "My balances")</span>
                            <span class="text-muted fs-7 mt-1">@L("هذا العام", "This year")</span></div></div>
                        <div class="card-body pt-4">
                            @if (Model.Balances.Count == 0) { <div class="text-center text-muted py-8">@L("لا سياسة إجازات مرتبطة بك — راجع الموارد البشرية", "No leave policy is linked to you — ask HR")</div> }
                            @foreach (var b in Model.Balances)
                            {
                                var pct = b.Entitlement > 0 ? (int)Math.Round(100.0 * Math.Min(b.Used, b.Entitlement) / b.Entitlement) : 0;
                                <div class="mb-5">
                                    <div class="d-flex flex-stack mb-2"><span class="fw-semibold text-gray-800">@Pick(b.NameAr, b.NameEn)</span><span class="fs-7 text-muted"><span class="hr-num fw-bold text-gray-900">@b.Remaining</span> @L("متاح من", "left of") <span class="hr-num">@b.Entitlement</span></span></div>
                                    <div class="progress h-6px bg-light-primary"><div class="progress-bar bg-primary" style="width:@(pct)%"></div></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="hr-notice mb-5">
                <i class="ki-outline ki-phone fs-2"></i>
                <div><div class="fw-bold">@L("على الجوال أيضاً", "On mobile too")</div>
                <div class="fs-7">@L("نفس الخدمات في تطبيق الجوال عبر واجهات الموظفين والإجازات الموجودة.", "The same services in the mobile app through the existing employee and leave APIs.")</div></div>
            </div>
        </div>
    </div>
</div>
