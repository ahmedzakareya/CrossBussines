@using CrossBuy.Controllers
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model PeopleStructureVm
@{
    Layout = "~/Views/Shared/_LayoutPeople.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    string nm(string? a, string? b) => (isAr ? a : b)?.Trim().Length > 0 ? (isAr ? a : b)! : (b ?? a ?? "—");
    string? img(string? raw) => string.IsNullOrEmpty(raw) ? null : (raw.StartsWith("http") ? raw : Url.Content("~" + raw));
    string initials(string? name)
    {
        var parts = (name ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return (parts.Length == 1 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)) : $"{parts[0][0]}{parts[1][0]}").ToUpper();
    }
    var typeIcon = new Dictionary<int, string> { { 1, "ki-bank" }, { 2, "ki-shop" }, { 3, "ki-abstract-26" }, { 4, "ki-briefcase" }, { 5, "ki-profile-circle" } };
    var typeColor = new Dictionary<int, string> { { 1, "primary" }, { 2, "info" }, { 3, "warning" }, { 4, "success" }, { 5, "danger" } };
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex align-items-stretch">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Org Structure"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">@Localizer["People"]</li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@Localizer["Org Structure"]</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            @if (!Model.Placed)
            {
                <div class="card"><div class="card-body text-center py-20">
                    <i class="ki-outline ki-abstract-26 fs-3x text-muted mb-5"></i>
                    <div class="fs-5 fw-semibold text-muted">@Localizer["You are not placed in the org structure yet"]</div>
                </div></div>
            }
            else
            {
                <div class="row g-5 g-xl-10">
                    <!--begin::Reporting line-->
                    <div class="col-xl-6">
                        <div class="card mb-5 mb-xl-10">
                            <div class="card-header border-0 pt-5">
                                <h3 class="card-title fw-bold text-gray-900">@Localizer["Reporting Line"]</h3>
                            </div>
                            <div class="card-body pt-2">
                                <div class="timeline timeline-border-dashed">
                                    @foreach (var n in Model.Ancestors)
                                    {
                                        var col = typeColor.GetValueOrDefault(n.Type, "primary");
                                        var ic = typeIcon.GetValueOrDefault(n.Type, "ki-abstract");
                                        var nImg = img(n.Image);
                                        <div class="timeline-item">
                                            <div class="timeline-line"></div>
                                            <div class="timeline-icon">
                                                <i class="ki-outline @ic fs-2 text-@col"></i>
                                            </div>
                                            <div class="timeline-content mb-8 mt-n1">
                                                <div class="pe-3 mb-2">
                                                    <div class="fs-7 text-muted">@nm(n.TypeNameAr, n.TypeNameEn)</div>
                                                    <div class="d-flex align-items-center mt-1">
                                                        @if (nImg != null)
                                                        {
                                                            <div class="symbol symbol-35px me-3"><img src="@nImg" alt="" /></div>
                                                        }
                                                        <span class="fs-5 fw-bold text-gray-900">@nm(n.NameAr, n.NameEn)</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <!--begin::Me-->
                                    <div class="timeline-item">
                                        <div class="timeline-line"></div>
                                        <div class="timeline-icon">
                                            <i class="ki-outline ki-profile-circle fs-2 text-primary"></i>
                                        </div>
                                        <div class="timeline-content mt-n1">
                                            <div class="d-flex align-items-center bg-light-primary rounded border border-primary border-dashed p-4">
                                                <div class="symbol symbol-50px me-4">
                                                    @if (img(Model.MeImage) != null)
                                                    {
                                                        <img src="@img(Model.MeImage)" alt="" />
                                                    }
                                                    else
                                                    {
                                                        <span class="symbol-label bg-primary text-inverse-primary fw-bold">@initials(nm(Model.MeNameAr, Model.MeNameEn))</span>
                                                    }
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fs-7 text-primary fw-semibold">@nm(Model.PositionAr, Model.PositionEn)</div>
                                                    <div class="fs-5 fw-bold text-gray-900">@nm(Model.MeNameAr, Model.MeNameEn)</div>
                                                </div>
                                                <span class="badge badge-primary">@Localizer["You"]</span>
                                            </div>
                                        </div>
                                    </div>
                                    <!--end::Me-->
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Reporting line-->

                    <!--begin::Team-->
                    <div class="col-xl-6">
                        <div class="card mb-5 mb-xl-10">
                            <div class="card-header border-0 pt-5">
                                <h3 class="card-title fw-bold text-gray-900">
                                    @Localizer["Reporting to me"]
                                    <span class="badge badge-light-primary ms-2">@Model.Subordinates.Count</span>
                                </h3>
                            </div>
                            <div class="card-body pt-2">
                                @if (Model.Subordinates.Count == 0)
                                {
                                    <div class="text-center py-10">
                                        <i class="ki-outline ki-people fs-3x text-muted mb-4"></i>
                                        <div class="fw-semibold text-muted">@Localizer["No one reports to you"]</div>
                                    </div>
                                }
                                else
                                {
                                    foreach (var s in Model.Subordinates)
                                    {
                                        var sImg = img(s.Image);
                                        <div class="d-flex align-items-center border border-gray-300 border-dashed rounded p-4 mb-4">
                                            <div class="symbol symbol-45px me-4">
                                                @if (sImg != null)
                                                {
                                                    <img src="@sImg" alt="" />
                                                }
                                                else
                                                {
                                                    <span class="symbol-label bg-light-danger text-danger fw-bold">@initials(nm(s.NameAr, s.NameEn))</span>
                                                }
                                            </div>
                                            <div class="flex-grow-1">
                                                <span class="fs-6 fw-bold text-gray-900">@nm(s.NameAr, s.NameEn)</span>
                                                <div class="fs-7 text-muted">@nm(s.PositionAr, s.PositionEn)</div>
                                            </div>
                                            <i class="ki-outline ki-@(isAr ? "left" : "right") fs-2 text-muted"></i>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!--begin::Total team-->
                        <div class="card bg-primary mb-5 mb-xl-10">
                            <div class="card-body d-flex align-items-center">
                                <div class="symbol symbol-50px me-4">
                                    <span class="symbol-label bg-white bg-opacity-25"><i class="ki-outline ki-abstract-26 fs-2 text-white"></i></span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fs-4 fw-bold text-white">@Localizer["Total Team Size"]</div>
                                    <div class="fs-7 text-white opacity-75">@Localizer["You manage {0} direct reports", Model.Subordinates.Count]</div>
                                </div>
                                <div class="fs-2x fw-bold text-white">@Model.Subordinates.Count</div>
                            </div>
                        </div>
                        <!--end::Total team-->
                    </div>
                    <!--end::Team-->
                </div>
            }
        </div>
    </div>
</div>
