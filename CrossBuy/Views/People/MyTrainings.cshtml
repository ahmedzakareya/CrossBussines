@using CrossBuy.Models.Context.Admin
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<TrainingEnrollment>
@{
    Layout = "~/Views/Shared/_LayoutPeople.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var courses = ViewBag.Courses as System.Collections.IDictionary;
    string stName(string s) => s switch { "Attended" => Localizer["Attended"].Value, "Completed" => Localizer["Completed"].Value, "Cancelled" => Localizer["Cancelled"].Value, _ => Localizer["Planned"].Value };
    // brand-safe status styling (green family + gray; no blue/mint/yellow)
    string stStyle(string s) => s switch {
        "Completed" => "background:#E7F0FF;color:#0E4A9E;",
        "Attended"  => "background:#E7F0FF;color:#145DBF;",
        "Cancelled" => "background:#f2f4f7;color:#98a2b3;",
        _            => "background:#f2f4f7;color:#475467;" };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid">
        <h1 class="page-heading fw-bold fs-3 m-0">@Localizer["My trainings"]</h1>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush"><div class="card-body pt-6"><div class="table-responsive"><table class="table align-middle gy-3 mb-0" style="font-variant-numeric:tabular-nums;">
            <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@Localizer["Course"]</th><th>@Localizer["Provider"]</th><th class="text-center">@Localizer["Hours"]</th><th class="text-center">@SR["Status"]</th><th class="text-center">@Localizer["Score"]</th><th class="pe-4">@Localizer["Certificate"]</th></tr></thead>
            <tbody class="fw-semibold text-gray-700">
            @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-8">@Localizer["No trainings"]</td></tr> }
            @foreach (var e in Model)
            {
                dynamic? c = (courses != null && courses.Contains(e.CourseId)) ? courses[e.CourseId] : null;
                <tr style="border-bottom:1px dashed #eef1f6;">
                    <td class="ps-4 fw-bold text-gray-900">@(c == null ? ("#" + e.CourseId) : (isAr ? c.Title : (string.IsNullOrEmpty((string?)c.TitleEn) ? c.Title : c.TitleEn)))</td>
                    <td class="text-muted fs-7">@(c == null ? "" : (isAr ? c.Provider : (string.IsNullOrEmpty((string?)c.ProviderEn) ? c.Provider : c.ProviderEn)))</td>
                    <td class="text-center">@(c == null ? "" : ((decimal)c.Hours).ToString("0.#"))</td>
                    <td class="text-center"><span class="badge fw-bold" style="@stStyle(e.Status)">@stName(e.Status)</span></td>
                    <td class="text-center fw-bold @(e.Score.HasValue ? "text-gray-900" : "text-gray-300")">@(e.Score?.ToString("0.#") ?? "—")</td>
                    <td class="text-muted fs-7 pe-4">@e.Certificate</td>
                </tr>
            }
            </tbody>
        </table></div></div></div>
    </div></div>
</div>
