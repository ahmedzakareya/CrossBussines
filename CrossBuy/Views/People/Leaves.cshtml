@using CrossBuy.Controllers
@model PeopleLeavesVm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutPeople.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    string nm(string? a, string? b) => (isAr ? a : b)?.Trim().Length > 0 ? (isAr ? a : b)! : (b ?? a ?? "—");
    @* Pending is warning-STRONG, not `warning`. The brand layer already fixes the pale
       yellow's TEXT colour, but the tint itself is the yellow this app has been clearing
       out - and a leave request waiting on somebody is a caution, which is what
       --cb-warning-strong is for. Approved stays `success` (complete) and rejected stays
       `danger` (the one that wants attention); both are already right. *@
    var statusBadge = new[] { "warning-strong", "success", "danger" };
    var statusText = new[] { Localizer["Pending"].Value, Localizer["Approved"].Value, Localizer["Rejected"].Value };
    var stepColor = new[] { "warning-strong", "success", "danger" };
    var stepIcon = new[] { "ki-time", "ki-check", "ki-cross" };
}

@functions {
    // renders the multi-level approval-chain timeline for a request
    Microsoft.AspNetCore.Html.IHtmlContent Chain(CrossBuy.Models.Context.Admin.LeaveRequest r,
        System.Collections.Generic.Dictionary<int, CrossBuy.Controllers.ApproverName> names,
        bool isAr, string[] stepColor, string[] stepIcon)
    {
        if (r.ApprovalSteps == null || !r.ApprovalSteps.Any())
            return new Microsoft.AspNetCore.Html.HtmlString("");
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"separator separator-dashed my-3\"></div>");
        sb.Append("<div class=\"d-flex flex-wrap gap-2 align-items-center\">");
        sb.Append($"<span class=\"text-muted fs-8 fw-semibold\">{Localizer["Approval chain:"].Value}</span>");
        foreach (var s in r.ApprovalSteps.OrderBy(x => x.Level))
        {
            var nm = names.TryGetValue(s.ApproverEmployeeID, out var an) ? (isAr ? an.Ar : an.En) : null;
            var cur = r.Status == 0 && s.Level == r.CurrentLevel;
            sb.Append($"<span class=\"badge badge-light-{stepColor[s.Status]} {(cur ? "border border-primary border-2" : "")}\">");
            sb.Append($"<i class=\"ki-outline {stepIcon[s.Status]} fs-8 me-1\"></i>");
            sb.Append($"{Localizer["L"].Value}{s.Level}: {System.Net.WebUtility.HtmlEncode(nm ?? "—")}");
            sb.Append("</span>");
        }
        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Leaves"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">@Localizer["People"]</li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@Localizer["Leaves"]</li>
                </ul>
            </div>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_new_leave">
                <i class="ki-outline ki-plus fs-2"></i>@Localizer["New Request"]
            </button>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            <div class="card">
                <div class="card-body">
                    <ul class="nav nav-tabs nav-line-tabs fs-6 mb-6">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#tab_mine">@Localizer["My Requests"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#tab_approval">
                                @Localizer["For Approval"]
                                @if (Model.Pending.Count > 0)
                                {
                                    <span class="badge badge-circle badge-danger ms-2">@Model.Pending.Count</span>
                                }
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <!--begin::My requests-->
                        <div class="tab-pane fade show active" id="tab_mine">
                            @if (Model.Mine.Count == 0)
                            {
                                <div class="text-center py-15">
                                    <i class="ki-outline ki-calendar-tick fs-3x text-muted mb-4"></i>
                                    <div class="fw-semibold text-muted">@Localizer["No leave requests yet"]</div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-5">
                                    @foreach (var r in Model.Mine)
                                    {
                                        <div class="col-md-6">
                                            <div class="border border-gray-300 border-dashed rounded p-5 h-100">
                                                <div class="d-flex align-items-center mb-3">
                                                    <div class="symbol symbol-40px me-3"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-calendar-tick fs-2 text-primary"></i></span></div>
                                                    <div class="flex-grow-1">
                                                        <span class="fs-5 fw-bold text-gray-900">@nm(r.LeaveType?.NameAr, r.LeaveType?.NameEn)</span>
                                                    </div>
                                                    <span class="badge badge-light-@statusBadge[r.Status]">@statusText[r.Status]</span>
                                                </div>
                                                <div class="d-flex flex-stack text-gray-600 fs-7 mb-2">
                                                    <span><i class="ki-outline ki-calendar fs-6 me-1"></i>@r.StartDate.ToString("yyyy/MM/dd") → @r.EndDate.ToString("yyyy/MM/dd")</span>
                                                    <span class="fw-bold text-primary">@r.Days @Localizer["days"]</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(r.Reason))
                                                {
                                                    <div class="text-gray-500 fs-7">@r.Reason</div>
                                                }
                                                @Chain(r, Model.ApproverNames, isAr, stepColor, stepIcon)
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <!--end::My requests-->

                        <!--begin::For approval-->
                        <div class="tab-pane fade" id="tab_approval">
                            @if (Model.Pending.Count == 0)
                            {
                                <div class="text-center py-15">
                                    <i class="ki-outline ki-inbox fs-3x text-muted mb-4"></i>
                                    <div class="fw-semibold text-muted">@Localizer["No requests awaiting your approval"]</div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-5">
                                    @foreach (var r in Model.Pending)
                                    {
                                        <div class="col-md-6">
                                            <div class="border border-gray-300 border-dashed rounded p-5 h-100">
                                                <div class="d-flex align-items-center mb-3">
                                                    <div class="symbol symbol-40px me-3"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-calendar-tick fs-2 text-primary"></i></span></div>
                                                    <div class="flex-grow-1">
                                                        <span class="fs-5 fw-bold text-gray-900">@nm(r.LeaveType?.NameAr, r.LeaveType?.NameEn)</span>
                                                        <div class="fs-7 text-muted">@Localizer["Requested by"]: @(isAr ? r.Employee?.FullName : DisplayName.Or(r.Employee?.FullNameEn, r.Employee?.FullName))</div>
                                                    </div>
                                                    <span class="badge badge-light-@statusBadge[r.Status]">@statusText[r.Status]</span>
                                                </div>
                                                <div class="d-flex flex-stack text-gray-600 fs-7 mb-2">
                                                    <span><i class="ki-outline ki-calendar fs-6 me-1"></i>@r.StartDate.ToString("yyyy/MM/dd") → @r.EndDate.ToString("yyyy/MM/dd")</span>
                                                    <span class="fw-bold text-primary">@r.Days @Localizer["days"]</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(r.Reason))
                                                {
                                                    <div class="text-gray-500 fs-7 mb-3">@r.Reason</div>
                                                }
                                                @Chain(r, Model.ApproverNames, isAr, stepColor, stepIcon)
                                                <form asp-action="DecideLeave" method="post" class="d-flex gap-3 mt-3">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@r.ID" />
                                                    <input type="text" name="note" class="form-control form-control-sm form-control-solid" placeholder="@Localizer["Note (optional)"]" />
                                                    <button type="submit" name="approve" value="false" class="btn btn-sm btn-light-danger flex-shrink-0" data-cb-confirm data-cb-action="reject" data-cb-text="@Localizer["Reject this leave request?"]">
                                                        <i class="ki-outline ki-cross fs-3"></i>@SR["Reject"]
                                                    </button>
                                                                                                        @* SAME WEIGHT AS REJECT. This was a solid btn-success beside a light
                                                       btn-light-danger, so the two choices the reviewer has to weigh were
                                                       drawn at different visual weights and the heavier one was "approve".
                                                       Colour and icon tell them apart; weight should not take a side. *@
                                                    <button type="submit" name="approve" value="true" class="btn btn-sm btn-light-success flex-shrink-0" data-cb-confirm data-cb-action="approve" data-cb-text="@Localizer["Approve this leave request?"]">
                                                        <i class="ki-outline ki-check fs-3"></i>@SR["Approve"]
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <!--end::For approval-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!--begin::New leave modal-->
<div class="modal fade" id="kt_modal_new_leave" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-550px">
        <div class="modal-content">
            <form asp-action="CreateLeave" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="fw-bold">@Localizer["New Leave Request"]</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                        <i class="ki-outline ki-cross fs-1"></i>
                    </div>
                </div>
                <div class="modal-body py-8 px-9">
                    <div class="mb-7">
                        <label class="required fw-semibold fs-6 mb-2">@SR["LeaveType"]</label>
                        <select name="leaveTypeId" class="form-select form-select-solid" required>
                            <option value="">@Localizer["Select leave type"]</option>
                            @foreach (var lt in Model.Types)
                            {
                                <option value="@lt.ID">@nm(lt.NameAr, lt.NameEn)</option>
                            }
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="required fw-semibold fs-6 mb-2">@SR["From"]</label>
                            <input type="text" id="leave_start" name="startDate" autocomplete="off" class="form-control form-control-solid" placeholder="@Localizer["Select date"]" required />
                        </div>
                        <div class="col-md-6">
                            <label class="required fw-semibold fs-6 mb-2">@SR["To"]</label>
                            <input type="text" id="leave_end" name="endDate" autocomplete="off" class="form-control form-control-solid" placeholder="@Localizer["Select date"]" required />
                        </div>
                    </div>
                    <div id="leave_days_hint" class="mb-7 fs-7 text-muted d-none">
                        <i class="ki-outline ki-information-5 fs-6 text-primary me-1"></i>
                        <span></span>
                    </div>
                    <div class="mb-2">
                        <label class="fw-semibold fs-6 mb-2">@Localizer["Reason (optional)"]</label>
                        <textarea name="reason" class="form-control form-control-solid" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@SR["Submit"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!--end::New leave modal-->

@section Scripts {
    <script>
        (function () {
            // work-day flags indexed by weekday (0=Sunday … 6=Saturday); null = no restriction
            var workDays = @(Model.WorkDays == null ? "null" : Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkDays)));
            var isAr = @(isAr ? "true" : "false");
            var restPrefix = '@Localizer["Rest days are not counted — working days selected: "]';

            // disable rest days when the policy restricts work days
            function disabledDate(d) {
                if (!workDays) return false;
                return workDays[d.getDay()] !== true;
            }

            function workingDaysBetween(a, b) {
                if (!a || !b || b < a) return 0;
                var n = 0, cur = new Date(a.getFullYear(), a.getMonth(), a.getDate());
                var end = new Date(b.getFullYear(), b.getMonth(), b.getDate());
                while (cur <= end) {
                    if (!workDays || workDays[cur.getDay()] === true) n++;
                    cur.setDate(cur.getDate() + 1);
                }
                return n;
            }

            var startEl = document.getElementById('leave_start');
            var endEl = document.getElementById('leave_end');
            var hint = document.getElementById('leave_days_hint');

            function refreshHint() {
                var a = fpStart && fpStart.selectedDates[0];
                var b = fpEnd && fpEnd.selectedDates[0];
                if (a && b) {
                    var n = workingDaysBetween(a, b);
                    hint.querySelector('span').textContent = restPrefix + n + ' @Localizer["day(s)"]';
                    hint.classList.remove('d-none');
                } else {
                    hint.classList.add('d-none');
                }
            }

            var common = {
                dateFormat: 'Y-m-d',
                disable: [disabledDate],
                locale: { firstDayOfWeek: 6 }
            };

            var fpStart = flatpickr(startEl, Object.assign({}, common, {
                onChange: function (sel) {
                    if (sel[0]) fpEnd.set('minDate', sel[0]);
                    refreshHint();
                }
            }));
            var fpEnd = flatpickr(endEl, Object.assign({}, common, { onChange: refreshHint }));
        })();
    </script>
}
