@using CrossBuy.BL.Reporting
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model ReportStudioModel
@{
    Layout = "~/Views/Shared/_LayoutInventory.cshtml";
    var arabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = arabic ? "استوديو التقارير" : "Report Studio";
    var openDraft = ViewData["StudioOpenDraft"] as StudioDraft;

    // THE TOOLBAR ICON SET, defined once so it can be reviewed AS A SET rather than found one at a
    // time down the file. That is the whole difference between an icon toolbar and a row of pictures:
    // one grid, one stroke weight, one visual language, so a reader learns the vocabulary once.
    //
    // Drawn here rather than taken from the icon font because the font has none of these. A page in
    // landscape, a band at the head of a sheet, a table whose header repeats on the next page - these
    // are report-design ideas, and no general-purpose icon set ships them. The undo and redo arrows a
    // few lines down were already hand-drawn for exactly this reason.
    var ICONS = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        // ---- page ----
        ["portrait"]  = "<rect x='4' y='2' width='8' height='12' rx='1'/>",
        ["landscape"] = "<rect x='2' y='4' width='12' height='8' rx='1'/>",
        ["margins"]   = "<rect x='2' y='2' width='12' height='12' rx='1'/>"
                      + "<rect x='5' y='5' width='6' height='6' stroke-dasharray='1.6 1.4'/>",

        // ---- text direction. The arrow says which way the line grows; the bars are the line. ----
        ["dirauto"]   = "<path d='M3 11h10'/><path d='M5 9l-2 2 2 2'/><path d='M11 9l2 2-2 2'/><path d='M4.5 6h7'/>",
        ["dirrtl"]    = "<path d='M13 4H5'/><path d='M13 8H7'/><path d='M13 12h10'/><path d='M3 12h8'/><path d='M5 10l-2 2 2 2'/>",
        ["dirltr"]    = "<path d='M3 4h8'/><path d='M3 8h6'/><path d='M3 12h8'/><path d='M11 10l2 2-2 2'/>",

        // ---- what prints. A sheet with the band in question filled in. ----
        ["hdr"]       = "<rect x='3' y='2' width='10' height='12' rx='1'/><path d='M3 5.4h10' stroke-width='2.4'/>",
        ["ftr"]       = "<rect x='3' y='2' width='10' height='12' rx='1'/><path d='M3 10.6h10' stroke-width='2.4'/>",
        ["pageno"]    = "<rect x='3' y='2' width='10' height='12' rx='1'/>"
                      + "<path d='M6 11.4h1.4M8.8 11.4h1.2' stroke-width='1.8'/>",
        ["repeat"]    = "<rect x='2' y='2' width='8' height='6' rx='.8'/><path d='M2 4.4h8' stroke-width='2'/>"
                      + "<rect x='6' y='8' width='8' height='6' rx='.8'/><path d='M6 10.4h8' stroke-width='2'/>",

        // ---- canvas ----
        ["grid"]      = "<path d='M2 6h12M2 10h12M6 2v12M10 2v12'/>",
        ["snap"]      = "<path d='M5 2v6a3 3 0 0 0 6 0V2'/><path d='M3.4 2h3.2M9.4 2h3.2'/><path d='M3.4 5.4h3.2M9.4 5.4h3.2'/>",

        // ---- zoom ----
        ["zoomout"]   = "<circle cx='7' cy='7' r='4.6'/><path d='M5 7h4'/><path d='M10.4 10.4 14 14'/>",
        ["zoomin"]    = "<circle cx='7' cy='7' r='4.6'/><path d='M5 7h4M7 5v4'/><path d='M10.4 10.4 14 14'/>",
        ["fit"]       = "<path d='M6 2H2v4'/><path d='M10 2h4v4'/><path d='M6 14H2v-4'/><path d='M10 14h4v-4'/>",

        // ---- actions ----
        ["newdoc"]    = "<path d='M9 2H4.5A1.5 1.5 0 0 0 3 3.5v9A1.5 1.5 0 0 0 4.5 14h7a1.5 1.5 0 0 0 1.5-1.5V6z'/><path d='M9 2v4h4'/>",
        ["clear"]     = "<path d='M4 4l8 8M12 4l-8 8'/>",
        ["eye"]       = "<path d='M1.6 8S4 3.6 8 3.6 14.4 8 14.4 8 12 12.4 8 12.4 1.6 8 1.6 8z'/><circle cx='8' cy='8' r='1.9'/>",
        ["printer"]   = "<path d='M4.5 6V2.6h7V6'/><rect x='2' y='6' width='12' height='5' rx='1'/><path d='M4.5 9.6h7v3.8h-7z'/>",
        ["pdf"]       = "<path d='M9 2H4.5A1.5 1.5 0 0 0 3 3.5v9A1.5 1.5 0 0 0 4.5 14h7a1.5 1.5 0 0 0 1.5-1.5V6z'/><path d='M9 2v4h4'/><path d='M8 8v3.4M6.4 10l1.6 1.6L9.6 10'/>",
        ["export"]    = "<path d='M8 2v7.4'/><path d='M5.4 7.2 8 9.8l2.6-2.6'/><path d='M2.6 11.4v1A1.6 1.6 0 0 0 4.2 14h7.6a1.6 1.6 0 0 0 1.6-1.6v-1'/>",
        ["save"]      = "<path d='M3 12.8V3.2A1.2 1.2 0 0 1 4.2 2h6.2L14 5.6v7.2A1.2 1.2 0 0 1 12.8 14H4.2A1.2 1.2 0 0 1 3 12.8z'/>"
                      + "<path d='M5.4 2v3.6h5V2'/><rect x='5.4' y='9' width='5.2' height='5'/>",
    };

    // `extra` carries per-use attributes (a heavier stroke on a pressed state, say) without the call
    // sites each rebuilding the <svg> wrapper and drifting from one another.
    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> Ico = name => new Microsoft.AspNetCore.Html.HtmlString(
        "<svg class=\"cbd-i\" viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" "
        + "stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" "
        + "stroke-linejoin=\"round\" aria-hidden=\"true\">" + ICONS[name] + "</svg>");
}
@*
    ============================================================================================
    THE REPORT STUDIO — V2, THE VISUAL DESIGNER.

    V1 built a column list. This builds a DOCUMENT: a printable page with margins, seven bands, and
    elements the user places, moves, resizes and styles wherever they want them on it.

    ────────────────────────────────────────────────────────────────────────────────────────────
    THE ONE INVARIANT THIS SCREEN IS BUILT AROUND (§14):

        WHAT IS SAVED IS STRUCTURE, NEVER THIS DOM.

    Every drag, resize and nudge below edits a plain JavaScript object — bands, elements, millimetres —
    and that object is what is POSTed, validated server-side and persisted. The HTML on this page is a
    VIEW of that object and is rebuilt from it after every change. Nothing is ever read back out of the
    DOM to be saved. That is why a saved report survives this file changing, and why the server can
    refuse a layout it does not like without having to parse markup.

    MILLIMETRES, NOT PIXELS. Positions are stored in mm because the output is paper; px would only mean
    something at one zoom on one screen. The canvas multiplies by a scale factor for display and divides
    on the way back, and that is the only place the two units meet.

    ────────────────────────────────────────────────────────────────────────────────────────────
    VISUAL AUTHORITY: THE INVENTORY MODULE, as the corrected Studio contract §0 records. There is no
    Studio theme and no Studio shell — the page chrome, cards, buttons and inputs are Inventory's
    (_LayoutInventory.cshtml, card / card-header / card-body, btn btn-sm btn-light, form-control-sm).

    The CANVAS is the one exception and is deliberately its own thing: a sheet of paper, a ruler and a
    selection handle have no Metronic equivalent, and dressing them as cards would make a design surface
    that lies about what it is. Its styles are scoped under .cbd- and touch nothing else.

    STRINGS ARE INLINE BILINGUAL rather than resx, the same deliberate choice V1 recorded:
    CrossBuy/Resources/** belongs to the integration owner in the ownership registry, and CLAUDE.md
    records that resx edits collide with the plumbing other tabs use.

    RTL IS ONE LAYOUT, NOT TWO. Element X is a distance from the CONTENT START edge and is emitted as
    `inset-inline-start` — here on the canvas and identically in ReportVisualRenderer. The browser
    resolves it against `dir`, so the same saved document is correct in both directions and there is no
    mirrored copy to keep in step. Drag deltas are negated under RTL for the same reason: the pointer
    moves in screen space, the model lives in logical space.

    NO DEMO CONTENT. Every value in the preview comes from a real run of a real dataset the caller is
    permitted to use.
    ============================================================================================
*@

<div class="d-flex flex-column flex-column-fluid">

    @* ---- TOOLBAR ------------------------------------------------------------------------------- *@
    @* pb-5, not pb-2. The action row and the page-setup strip below it are both light surfaces, and 8px
       between them read as ONE block stuck together — the separation has to be visible, not technically
       present. *@
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-5">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">
                    <i class="ki-outline ki-abstract-26 fs-2 me-2 text-primary"></i>@(arabic ? "استوديو التقارير" : "Report Studio")
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index","Inventory")" class="text-muted text-hover-primary">@SR["Inventory"]</a>
                    </li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index","Reports")" class="text-muted text-hover-primary">@(arabic ? "مركز التقارير" : "Reports Center")</a>
                    </li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@(arabic ? "مصمِّم التقارير" : "Report Designer")</li>
                </ul>
            </div>

            @* TEN CONTROLS IN ONE LINE READ AS A WALL, which is what "the header is all crammed
               together" was: same-weight light buttons at a uniform 0.5rem gap, with two hairline
               separators doing all the grouping. They are grouped into btn-groups instead — adjacent
               buttons in a group share a border and read as ONE control with parts, which is Bootstrap's
               own answer to a row of buttons — and the space between GROUPS is widened while the space
               inside them goes to zero. Nothing is hidden and nothing is renamed; only the grouping and
               the gaps change.
               Order: what the DRAFT is (name) · what to START (new, clear) · undo · what to PRODUCE
               (preview, print, pdf, export) · save. *@
            <div class="d-flex align-items-center gap-3 flex-wrap cbd-actions">
                @* TWO NAMES, both always present regardless of the UI language. The saved layout is shown
                   to Arabic and English users alike, so it needs a name in each; one field meant whatever
                   the author happened to type was copied into both columns, and an Arabic name then
                   appeared on the English screens. The field for the CURRENT language comes first. *@
                @if (arabic)
                {
                    <input id="cbd-name" type="text" class="form-control form-control-sm w-175px"
                           placeholder="Report name (Arabic)" aria-label="Report name (Arabic)" />
                    <input id="cbd-name-en" type="text" class="form-control form-control-sm w-175px"
                           placeholder="Report name (EN)" aria-label="Report name (English)" dir="ltr" />
                }
                else
                {
                    <input id="cbd-name-en" type="text" class="form-control form-control-sm w-175px"
                           placeholder="Report name (EN)" aria-label="Report name (English)" dir="ltr" />
                    <input id="cbd-name" type="text" class="form-control form-control-sm w-175px"
                           placeholder="Report name (Arabic)" aria-label="Report name (Arabic)" dir="rtl" />
                }

                @* WHO THE LAYOUT IS FOR — the thing a designer could never say.
                   ReportStudioService saved every draft as Personal, so a layout built here was
                   invisible to the colleague printing the same invoice.

                   PERSONAL and COMPANY only. Team is a real scope and the service supports it, but it
                   needs a team PICKER and the Reports Centre already has that machinery; offering a
                   scope here with no way to name its team would be a control that saves a refusal.
                   Platform is absent because a tenant may never write one — the service refuses it. *@
                <div class="d-flex align-items-center gap-2">
                    <label class="fs-8 fw-semibold text-muted" for="cbd-scope">@(arabic ? "متاح لـ" : "Available to")</label>
                    <select id="cbd-scope" class="form-select form-select-sm w-150px">
                        <option value="3">@(arabic ? "أنا فقط" : "Only me")</option>
                        <option value="1">@(arabic ? "كل الشركة" : "The whole company")</option>
                    </select>
                    <div class="form-check form-check-sm form-check-custom" title="@(arabic ? "النموذج الذي يُطبع تلقائيًا" : "The layout that prints by default")">
                        <input id="cbd-default" class="form-check-input" type="checkbox" />
                        <label class="form-check-label fs-8 fw-semibold" for="cbd-default">@(arabic ? "افتراضي" : "Default")</label>
                    </div>
                </div>

                @* NEW and CLEAR are PAGE-level, and they sit here rather than beside the canvas footer's
                   Delete on purpose: that button removes what is SELECTED, these two remove the DESIGN.
                   Both ask before acting — neither is a click anyone wants to make by accident. *@
                <div class="btn-group">
                    <button type="button" id="cbd-new" class="cbd-tb-btn"
                            title="@(arabic ? "تقرير جديد — يبدأ من صفحة فارغة" : "New report — start from an empty page")"
                            aria-label="@(arabic ? "تقرير جديد" : "New report")">@Ico("newdoc")</button>
                    <button type="button" id="cbd-clear" class="cbd-tb-btn cbd-tb-danger"
                            title="@(arabic ? "مسح كل عناصر الصفحة" : "Clear every element on the page")"
                            aria-label="@(arabic ? "مسح الصفحة" : "Clear the page")">@Ico("clear")</button>
                </div>

                <div class="btn-group">
                    <button type="button" id="cbd-undo" class="cbd-tb-btn" disabled
                            title="@(arabic ? "تراجع" : "Undo") (Ctrl+Z)" aria-label="@(arabic ? "تراجع" : "Undo")">
                        @* A CURVED arrow, drawn here rather than taken from the icon font: the set ships
                           no undo glyph, and the plain ki-arrow-left that stood here reads as "go back"
                           - which in an RTL toolbar points the wrong way as well. *@
                        <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z"/>
                        </svg>
                    </button>
                    <button type="button" id="cbd-redo" class="cbd-tb-btn" disabled
                            title="@(arabic ? "إعادة" : "Redo") (Ctrl+Y)" aria-label="@(arabic ? "إعادة" : "Redo")">
                        @* The same arrow the other way round, so the pair reads as one control. *@
                        <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                        </svg>
                    </button>
                </div>

                <div class="btn-group">
                    <button type="button" id="cbd-preview" class="cbd-tb-btn"
                            title="@(arabic ? "معاينة" : "Preview")"
                            aria-label="@(arabic ? "معاينة" : "Preview")">@Ico("eye")</button>
                    <button type="button" id="cbd-print" class="cbd-tb-btn"
                            title="@(arabic ? "طباعة" : "Print")"
                            aria-label="@(arabic ? "طباعة" : "Print")">@Ico("printer")</button>
                    <button type="button" id="cbd-pdf" class="cbd-tb-btn"
                            title="PDF" aria-label="PDF">@Ico("pdf")</button>
                    <button type="button" class="cbd-tb-btn" data-bs-toggle="dropdown" aria-expanded="false"
                            title="@(arabic ? "تصدير" : "Export")"
                            aria-label="@(arabic ? "تصدير" : "Export")">@Ico("export")</button>
                    <ul class="dropdown-menu">
                        <li><button type="button" class="dropdown-item" data-export="3">CSV</button></li>
                        <li><button type="button" class="dropdown-item" data-export="2">Excel (XLSX)</button></li>
                    </ul>
                </div>

                <button type="button" id="cbd-save" class="cbd-tb-btn cbd-tb-primary"
                        title="@(arabic ? "حفظ التقرير" : "Save the report") (Ctrl+S)">@Ico("save")<span class="cbd-tb-btn-text">@(arabic ? "حفظ" : "Save")</span></button>
            </div>
        </div>
    </div>

    <div class="app-container container-fluid">

        @if (Model.HasNoDatasets)
        {
            @* A REAL STATE, not an error page: nothing this caller may build over. *@
            <div class="card card-flush">
                <div class="card-body text-center py-15">
                    <i class="ki-outline ki-information-5 fs-3x text-gray-400 mb-4 d-block"></i>
                    <div class="fw-bold fs-4 text-gray-800 mb-2">
                        @(arabic ? "لا توجد مجموعات بيانات متاحة لك" : "No data sets are available to you")
                    </div>
                    <div class="text-muted fs-6">
                        @(arabic
                            ? "يحتاج بناء التقارير إلى صلاحية على مجموعة بيانات واحدة على الأقل. تواصل مع مسؤول النظام."
                            : "Building a report needs permission on at least one data set. Ask your administrator.")
                    </div>
                </div>
            </div>
        }
        else
        {
            @* ---- PAGE SETUP STRIP -------------------------------------------------------------- *@
            @* mt-3 ON TOP of the toolbar's own bottom padding. Widening that padding alone took the gap
               from 8px to 21px and it still read as touching, because both surfaces are light and the
               card carries no shadow of its own — so the strip needs a margin that belongs to IT, not
               only space that belongs to the row above. Measured at 37px, which is finally a gap. *@
            <div class="card card-flush mt-3 mb-3">
                @*
                    AN ICON TOOLBAR, not a settings form.

                    What was here was twenty-one controls, each with its own text label, all at the same
                    visual weight, wrapping onto a second row. Nothing in it was wrong and nothing in it
                    was findable: "Repeat table header" took more width than the canvas ruler, and the
                    four margin boxes were four bare numbers with no clue which edge each belonged to.

                    THE RULE APPLIED HERE is the one Crystal Reports and Office follow. The ICON carries
                    the meaning. Text survives only where the value IS a name — a typeface, a paper size —
                    because no glyph can say "Cairo" or "Legal". A boolean is a button that looks pressed,
                    not a tick with a sentence beside it. Related controls sit in a group, and a hairline
                    separates groups, so the eye lands on a region before it lands on a control.

                    AND THE MARKUP UNDERNEATH DID NOT CHANGE ITS CONTRACT. Every toggle is still an
                    <input type="checkbox">, visually hidden behind its own <label for>: the click passes
                    through natively, `change` fires, and .checked reads and writes exactly as before — so
                    bindFlag() and loadPage() are untouched, and the keyboard and the screen reader keep
                    semantics that a <div aria-pressed> would have had to imitate. A segmented choice still
                    drives its original <select>, now hidden, through one delegated handler.
                *@
                <div id="cbd-setup" class="card-body py-2 d-flex flex-wrap align-items-center gap-1">

                    @* ---- PAGE ---- *@
                    <span class="cbd-tb-label">@(arabic ? "الصفحة" : "Page")</span>
                    <select id="cbd-paper" class="form-select form-select-sm cbd-tb-sel w-90px"
                            title="@(arabic ? "مقاس الورق" : "Paper size")" aria-label="@(arabic ? "مقاس الورق" : "Paper size")">
                        <option value="0">A4</option>
                        <option value="1">A5</option>
                        <option value="2">Letter</option>
                        <option value="3">Legal</option>
                        <option value="4">80mm</option>
                    </select>

                    @* The select stays and stays authoritative; these two set it. *@
                    <select id="cbd-orient" class="cbd-hidden-select" aria-hidden="true" tabindex="-1">
                        <option value="0">@(arabic ? "طولي" : "Portrait")</option>
                        <option value="1">@(arabic ? "عرضي" : "Landscape")</option>
                    </select>
                    <div class="cbd-seg" role="group" aria-label="@(arabic ? "اتجاه الورق" : "Page orientation")">
                        <button type="button" class="cbd-tb-btn" data-seg="cbd-orient" data-val="0"
                                title="@(arabic ? "طولي" : "Portrait")">@Ico("portrait")</button>
                        <button type="button" class="cbd-tb-btn" data-seg="cbd-orient" data-val="1"
                                title="@(arabic ? "عرضي" : "Landscape")">@Ico("landscape")</button>
                    </div>

                    @* MARGINS IN A POPOVER. Four bare number boxes in a row could not say which edge each
                       one was; here each carries its own name and they stop competing with the controls
                       either side of them for the reader's attention. *@
                    <div class="cbd-pop-wrap">
                        <button type="button" class="cbd-tb-btn" id="cbd-margins-btn"
                                title="@(arabic ? "الهوامش (مم)" : "Margins (mm)")"
                                aria-haspopup="true" aria-expanded="false">@Ico("margins")</button>
                        <div class="cbd-pop" id="cbd-margins-pop" hidden>
                            <div class="cbd-pop-title">@(arabic ? "الهوامش (مم)" : "Margins (mm)")</div>
                            <div class="cbd-pop-grid">
                                <label for="cbd-mt">@(arabic ? "أعلى" : "Top")</label>
                                <input id="cbd-mt" type="number" step="1" min="0" class="form-control form-control-sm" />
                                <label for="cbd-mb">@(arabic ? "أسفل" : "Bottom")</label>
                                <input id="cbd-mb" type="number" step="1" min="0" class="form-control form-control-sm" />
                                <label for="cbd-ml">@(arabic ? "يسار" : "Left")</label>
                                <input id="cbd-ml" type="number" step="1" min="0" class="form-control form-control-sm" />
                                <label for="cbd-mr">@(arabic ? "يمين" : "Right")</label>
                                <input id="cbd-mr" type="number" step="1" min="0" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>

                    <span class="cbd-tb-sep"></span>

                    @* ---- TEXT ----
                       The document font: a property of the PAGE, not of a selected element. The list is
                       ReportTypography.DesignerFaces, which is also what the validator accepts, so the
                       designer cannot offer a face the save would reject. *@
                    <span class="cbd-tb-label">@(arabic ? "النص" : "Text")</span>
                    <select id="cbd-font" class="form-select form-select-sm cbd-tb-sel w-125px"
                            title="@(arabic ? "خط المستند" : "Document font")" aria-label="@(arabic ? "خط المستند" : "Document font")">
                        <option value="">@(arabic ? "افتراضي" : "Default")</option>
                        @foreach (var face in CrossBuy.BL.Reporting.ReportTypography.DesignerFaces)
                        {
                            <option value="@face">@face</option>
                        }
                    </select>
                    <input id="cbd-fontsize" type="number" step="0.5" min="5" max="30"
                           class="form-control form-control-sm cbd-tb-num"
                           title="@(arabic ? "حجم الخط (نقطة)" : "Font size (pt)")"
                           aria-label="@(arabic ? "حجم خط المستند" : "Document font size")" />

                    @* DIRECTION. "Follow language" is what a document read in both wants and what every
                       existing template gets; forcing one is for a document that must match something
                       outside the system — a pre-printed form, a bank or customs template. *@
                    <select id="cbd-dir" class="cbd-hidden-select" aria-hidden="true" tabindex="-1">
                        <option value="0">@(arabic ? "حسب اللغة" : "Follow language")</option>
                        <option value="1">@(arabic ? "من اليمين" : "Right to left")</option>
                        <option value="2">@(arabic ? "من اليسار" : "Left to right")</option>
                    </select>
                    <div class="cbd-seg" role="group" aria-label="@(arabic ? "اتجاه النص" : "Text direction")">
                        <button type="button" class="cbd-tb-btn" data-seg="cbd-dir" data-val="0"
                                title="@(arabic ? "حسب اللغة" : "Follow the language")">@Ico("dirauto")</button>
                        <button type="button" class="cbd-tb-btn" data-seg="cbd-dir" data-val="1"
                                title="@(arabic ? "من اليمين لليسار" : "Right to left")">@Ico("dirrtl")</button>
                        <button type="button" class="cbd-tb-btn" data-seg="cbd-dir" data-val="2"
                                title="@(arabic ? "من اليسار لليمين" : "Left to right")">@Ico("dirltr")</button>
                    </div>

                    <span class="cbd-tb-sep"></span>

                    @* ---- WHAT PRINTS ---- *@
                    <span class="cbd-tb-label">@(arabic ? "يُطبع" : "Print")</span>
                    <input id="cbd-show-header" class="cbd-tgl-input" type="checkbox" />
                    <label class="cbd-tb-btn" for="cbd-show-header"
                           title="@(arabic ? "ترويسة الصفحة" : "Page header")">@Ico("hdr")</label>

                    <input id="cbd-show-footer" class="cbd-tgl-input" type="checkbox" />
                    <label class="cbd-tb-btn" for="cbd-show-footer"
                           title="@(arabic ? "تذييل الصفحة" : "Page footer")">@Ico("ftr")</label>

                    <input id="cbd-show-pageno" class="cbd-tgl-input" type="checkbox" />
                    <label class="cbd-tb-btn" for="cbd-show-pageno"
                           title="@(arabic ? "أرقام الصفحات" : "Page numbers")">@Ico("pageno")</label>

                    <input id="cbd-repeat-head" class="cbd-tgl-input" type="checkbox" />
                    <label class="cbd-tb-btn" for="cbd-repeat-head"
                           title="@(arabic ? "تكرار رأس الجدول على كل صفحة" : "Repeat the table header on every page")">@Ico("repeat")</label>

                    <span class="cbd-tb-sep"></span>

                    @* ---- CANVAS ---- *@
                    <span class="cbd-tb-label">@(arabic ? "الشبكة" : "Grid")</span>
                    <input id="cbd-showgrid" class="cbd-tgl-input" type="checkbox" checked />
                    <label class="cbd-tb-btn" for="cbd-showgrid"
                           title="@(arabic ? "إظهار الشبكة" : "Show the grid")">@Ico("grid")</label>

                    <input id="cbd-snap" class="cbd-tgl-input" type="checkbox" />
                    <label class="cbd-tb-btn" for="cbd-snap"
                           title="@(arabic ? "المحاذاة للشبكة" : "Snap to the grid")">@Ico("snap")</label>

                    <input id="cbd-grid" type="number" step="1" min="1" max="20"
                           class="form-control form-control-sm cbd-tb-num"
                           title="@(arabic ? "مقاس الشبكة (مم)" : "Grid size (mm)")"
                           aria-label="@(arabic ? "مقاس الشبكة" : "Grid size")" />

                    @* ---- ZOOM, pushed to the far end: it changes how the page LOOKS and nothing the
                           page IS, so it does not belong among the document's own properties. ---- *@
                    <div class="d-flex align-items-center gap-1 ms-auto">
                        <button type="button" class="cbd-tb-btn" data-zoom="-10"
                                title="@(arabic ? "تصغير" : "Zoom out")">@Ico("zoomout")</button>
                        <input id="cbd-zoom" type="range" min="40" max="200" step="10" value="100"
                               class="cbd-tb-range" aria-label="@(arabic ? "تكبير" : "Zoom")" />
                        <button type="button" class="cbd-tb-btn" data-zoom="10"
                                title="@(arabic ? "تكبير" : "Zoom in")">@Ico("zoomin")</button>
                        <span id="cbd-zoom-label" class="cbd-tb-pct">100%</span>
                        <button type="button" id="cbd-fit" class="cbd-tb-btn"
                                title="@(arabic ? "ملاءمة العرض" : "Fit to width")">@Ico("fit")</button>
                    </div>
                </div>
            </div>

            @* ---- THE THREE RAILS --------------------------------------------------------------- *@
            <div class="cbd-wrap">

                @* ---------------- THE DOCK BAR: tools, and saved reports ---------------------- *@
                @*
                    ONE 34px TAB STRIP ON THE EDGE, the way Visual Studio stacks its auto-hide tabs, with
                    the panel flying out OVER the canvas instead of taking a column of the row away from
                    it. Both panels were docked columns before: the toolbox rail held 290px permanently
                    even while nobody was adding an element, and the saved-reports list was a card at the
                    bottom of that rail with no scrollbar of its own — 53 saved reports made the page
                    1682px tall on a phone with the list itself far below the fold.

                    ONE OPEN AT A TIME, and they differ in ONE way on purpose: the reports list is a
                    PICKER, so it dismisses itself as soon as you click anywhere else; the toolbox is a
                    PALETTE you add from repeatedly, so it stays until you close it. An auto-hiding
                    toolbox would shut on the first canvas click after every single element.
                *@
                <div class="cbd-dockbar">
                    <div class="cbd-dockbar-tabs">
                    <button type="button" id="cbd-tools-tab" class="cbd-dock-tab" aria-expanded="false"
                            aria-controls="cbd-tools-panel"
                            title="@(arabic ? "الأدوات والبيانات والأقسام" : "Tools, data and bands")">
                        <i class="ki-outline ki-abstract-25 fs-6"></i>
                        <span>@(arabic ? "الأدوات" : "Tools")</span>
                    </button>

                    @if (Model.Saved.Count > 0)
                    {
                        <button type="button" id="cbd-saved-tab" class="cbd-dock-tab" aria-expanded="false"
                                aria-controls="cbd-saved-panel"
                                title="@(arabic ? "تقاريري المحفوظة" : "My saved reports")">
                            <i class="ki-outline ki-folder fs-6"></i>
                            <span>@(arabic ? "تقاريري" : "My reports")</span>
                            <span class="cbd-dock-count">@Model.Saved.Count</span>
                        </button>
                    }
                    </div>

                    @* ---- THE TOOLS PANEL (was a permanent 290px rail) ------------------------- *@
                    <div id="cbd-tools-panel" class="cbd-dock-panel cbd-dock-panel-wide" data-autohide="false" hidden>
                    <div class="card card-flush">
                        <div class="card-header min-h-40px px-3">
                            <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-0 fs-8 fw-bold">
                                <li class="nav-item"><a class="nav-link active py-2" data-bs-toggle="tab" href="#cbd-tab-toolbox">@(arabic ? "الأدوات" : "Toolbox")</a></li>
                                <li class="nav-item"><a class="nav-link py-2" data-bs-toggle="tab" href="#cbd-tab-data">@(arabic ? "البيانات" : "Data")</a></li>
                                <li class="nav-item"><a class="nav-link py-2" data-bs-toggle="tab" href="#cbd-tab-bands">@(arabic ? "الأقسام" : "Bands")</a></li>
                            </ul>
                            <div class="card-toolbar">
                                <button type="button" id="cbd-tools-close" class="btn btn-sm btn-icon btn-light w-25px h-25px"
                                        title="@(arabic ? "إغلاق" : "Close")" aria-label="@(arabic ? "إغلاق" : "Close")">
                                    <i class="ki-outline ki-cross fs-6"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-3 cbd-rail-body">
                            <div class="tab-content">

                                @* ---- TOOLBOX ---- *@
                                <div class="tab-pane fade show active" id="cbd-tab-toolbox">
                                    <div class="text-muted fs-8 mb-2">
                                        @(arabic ? "اسحب أداة إلى الصفحة، أو انقر لإضافتها إلى القسم المحدد." : "Drag a tool onto the page, or click to add it to the selected band.")
                                    </div>
                                    <div id="cbd-toolbox" class="d-flex flex-column gap-1"></div>

                                    <div class="separator my-3"></div>

                                    <div class="fs-8 fw-bold text-gray-700 mb-2">@(arabic ? "الصور" : "Images")</div>
                                    <div id="cbd-assets" class="d-flex flex-wrap gap-2 mb-2"></div>
                                    <div class="d-flex align-items-center gap-2">
                                        <select id="cbd-asset-role" class="form-select form-select-sm w-100px" aria-label="@(arabic ? "دور الصورة" : "Image role")">
                                            <option value="1">@(arabic ? "شعار" : "Logo")</option>
                                            <option value="2">@(arabic ? "توقيع" : "Signature")</option>
                                            <option value="3">@(arabic ? "ختم" : "Stamp")</option>
                                            <option value="0">@(arabic ? "أخرى" : "Other")</option>
                                        </select>
                                        <label class="btn btn-sm btn-light-primary mb-0">
                                            <i class="ki-outline ki-cloud-add fs-5 me-1"></i>@(arabic ? "رفع" : "Upload")
                                            <input id="cbd-asset-file" type="file" accept="image/*" class="d-none" />
                                        </label>
                                    </div>
                                </div>

                                @* ---- DATA ---- *@
                                <div class="tab-pane fade" id="cbd-tab-data">
                                    <label class="fs-8 fw-bold text-gray-700 mb-1" for="cbd-dataset">@(arabic ? "مجموعة البيانات" : "Data set")</label>
                                    <select id="cbd-dataset" class="form-select form-select-sm mb-3">
                                        <option value="">@(arabic ? "— اختر —" : "— choose —")</option>
                                        @foreach (var d in Model.Datasets)
                                        {
                                            <option value="@d.DatasetCode" title="@d.Description">@d.Title (@d.Module)</option>
                                        }
                                    </select>

                                    <div class="fs-8 fw-bold text-gray-700 mb-1">@(arabic ? "الحقول" : "Fields")</div>
                                    <div class="text-muted fs-8 mb-2">@(arabic ? "اسحب حقلًا إلى الصفحة." : "Drag a field onto the page.")</div>
                                    <div id="cbd-fields" class="d-flex flex-column gap-1 mb-3"></div>

                                    <div class="separator my-3"></div>

                                    @* §9 — the parameters the dataset itself declares. *@
                                    <div class="fs-8 fw-bold text-gray-700 mb-1">@(arabic ? "المعاملات" : "Parameters")</div>
                                    <div id="cbd-params" class="d-flex flex-column gap-2 mb-2"></div>
                                    <div id="cbd-params-empty" class="text-muted fs-8">@(arabic ? "لا توجد معاملات." : "No parameters.")</div>

                                    <div class="separator my-3"></div>

                                    <div class="d-flex flex-stack mb-1">
                                        <span class="fs-8 fw-bold text-gray-700">@(arabic ? "المرشِّحات" : "Filters")</span>
                                        <button type="button" id="cbd-add-filter" class="btn btn-sm btn-icon btn-light" aria-label="@(arabic ? "إضافة مرشِّح" : "Add filter")"><i class="ki-outline ki-plus fs-5"></i></button>
                                    </div>
                                    <div id="cbd-filters" class="d-flex flex-column gap-2 mb-3"></div>

                                    <div class="d-flex flex-stack mb-1">
                                        <span class="fs-8 fw-bold text-gray-700">@(arabic ? "الترتيب" : "Sorting")</span>
                                        <button type="button" id="cbd-add-sort" class="btn btn-sm btn-icon btn-light" aria-label="@(arabic ? "إضافة ترتيب" : "Add sort")"><i class="ki-outline ki-plus fs-5"></i></button>
                                    </div>
                                    <div id="cbd-sorts" class="d-flex flex-column gap-2"></div>
                                </div>

                                @* ---- BANDS ---- *@
                                <div class="tab-pane fade" id="cbd-tab-bands">
                                    <div class="text-muted fs-8 mb-2">
                                        @(arabic ? "ارتفاع كل قسم بالمليمتر. القسم بارتفاع صفر لا يُطبع." : "Each band's height in millimetres. A band of height zero does not print.")
                                    </div>
                                    <div id="cbd-bandlist" class="d-flex flex-column gap-2"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    </div>

                    @* ---- THE SAVED-REPORTS PANEL --------------------------------------------- *@
                    @if (Model.Saved.Count > 0)
                    {
                        <div id="cbd-saved-panel" class="cbd-dock-panel card card-flush" data-autohide="true" hidden>
                            <div class="card-header min-h-40px px-3">
                                <h3 class="card-title fs-8 fw-bold text-gray-700 m-0">@(arabic ? "تقاريري" : "My reports")</h3>
                                <div class="card-toolbar">
                                    <button type="button" id="cbd-saved-close" class="btn btn-sm btn-icon btn-light w-25px h-25px"
                                            title="@(arabic ? "إغلاق" : "Close")" aria-label="@(arabic ? "إغلاق" : "Close")">
                                        <i class="ki-outline ki-cross fs-6"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3 d-flex flex-column gap-1 cbd-rail-body">
                                @foreach (var saved in Model.Saved)
                                {
                                    <button type="button" class="btn btn-sm btn-light justify-content-start fw-semibold fs-8 py-2 text-start"
                                            data-open="@saved.TemplateId" title="@saved.Name">
                                        <i class="ki-outline ki-file fs-5 me-2"></i>@saved.Name
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                @* ---------------- CANVAS -------------------------------------------------------- *@
                <div class="cbd-stage">
                    <div class="cbd-ruler-corner"></div>
                    <div id="cbd-ruler-h" class="cbd-ruler-h" aria-hidden="true"></div>
                    <div id="cbd-ruler-v" class="cbd-ruler-v" aria-hidden="true"></div>

                    <div id="cbd-scroll" class="cbd-scroll">
                        <div id="cbd-page" class="cbd-page">
                            <div id="cbd-content" class="cbd-content"></div>
                        </div>
                    </div>

                    <div class="cbd-statusbar">
                        <span id="cbd-status" class="fs-8 text-muted"></span>
                        <span class="ms-auto d-flex gap-1">
                            <button type="button" id="cbd-front" class="btn btn-sm btn-light py-1 px-2 fs-8" title="@(arabic ? "إلى الأمام" : "Bring to front")">
                                <i class="ki-outline ki-up-square fs-6"></i>
                            </button>
                            <button type="button" id="cbd-back" class="btn btn-sm btn-light py-1 px-2 fs-8" title="@(arabic ? "إلى الخلف" : "Send to back")">
                                <i class="ki-outline ki-down-square fs-6"></i>
                            </button>
                            <button type="button" id="cbd-dup" class="btn btn-sm btn-light py-1 px-2 fs-8" title="@(arabic ? "تكرار" : "Duplicate") (Ctrl+D)">
                                <i class="ki-outline ki-copy fs-6"></i>
                            </button>
                            <button type="button" id="cbd-del" class="btn btn-sm btn-light-danger py-1 px-2 fs-8" title="@(arabic ? "حذف" : "Delete") (Del)">
                                <i class="ki-outline ki-trash fs-6"></i>
                            </button>
                        </span>
                    </div>
                </div>

                @* ---------------- RIGHT RAIL: properties ---------------------------------------- *@
                <div class="cbd-rail">
                    <div class="card card-flush">
                        <div class="card-header min-h-40px px-3">
                            <h3 class="card-title fs-8 fw-bold text-gray-700 m-0">@(arabic ? "الخصائص" : "Properties")</h3>
                        </div>
                        <div class="card-body p-3 cbd-rail-body">
                            <div id="cbd-props"></div>
                            <div id="cbd-props-empty" class="text-muted fs-8 text-center py-10">
                                @(arabic ? "اختر عنصرًا لعرض خصائصه." : "Select an element to edit it.")
                            </div>
                        </div>
                    </div>

                    <div id="cbd-errors" class="alert alert-danger d-none mt-3 py-3 px-4 fs-8 mb-0"></div>
                </div>
            </div>
        }
    </div>
</div>

@* ---- PREVIEW MODAL ----------------------------------------------------------------------------- *@
<div class="modal fade" id="cbd-preview-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen-lg-down modal-xl">
        <div class="modal-content">
            <div class="modal-header py-3">
                <h3 class="modal-title fs-5">@(arabic ? "معاينة الطباعة" : "Print preview")</h3>
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="@(arabic ? "إغلاق" : "Close")">
                    <i class="ki-outline ki-cross fs-2"></i>
                </div>
            </div>
            <div class="modal-body bg-light-secondary" id="cbd-preview-body" style="max-height:75vh;overflow:auto"></div>
            <div class="modal-footer py-2">
                <span id="cbd-preview-meta" class="fs-8 text-muted me-auto"></span>
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">@(arabic ? "إغلاق" : "Close")</button>
            </div>
        </div>
    </div>
</div>

@* The antiforgery token every POST below carries: the Studio endpoints sit behind
   [AutoValidateAntiforgeryToken] because they authenticate by session cookie. *@
@Html.AntiForgeryToken()

@section Styles {
<style>
    /* ---------------------------------------------------------------------------------------------
       THE CANVAS. Scoped under .cbd- and used nowhere else on the site.

       Colours come from Metronic's own CSS variables so the designer follows the active theme instead
       of hardcoding a light-mode palette — a designer that stayed white in dark mode would be the one
       screen in the product that ignored the user's choice.
       --------------------------------------------------------------------------------------------- */
    .cbd-wrap { display: flex; gap: .75rem; align-items: flex-start; }
    .cbd-rail { width: 290px; flex: 0 0 290px; }
    .cbd-rail-body { max-height: calc(100vh - 330px); overflow-y: auto; }

    /* THE DOCK BAR — one 34px strip of stacked vertical tabs, panels flying out OVER the canvas.
       Docking the panels as flex items was the first attempt and it cost too much: with the toolbox rail
       and a 250px list both in the row, the canvas dropped from 607px to 350px. As overlays the canvas
       keeps its width whatever is open, which is what an auto-hide tab promises in the first place. */
    .cbd-dockbar { display: flex; flex-direction: row; align-items: flex-start; gap: .5rem; flex: 0 0 auto; }
    .cbd-dockbar-tabs { display: flex; flex-direction: column; align-items: stretch; gap: .35rem; flex: 0 0 auto; }
    .cbd-dock-tab {
        writing-mode: vertical-rl; display: flex; align-items: center; gap: 8px;
        padding: 12px 7px; cursor: pointer; font-size: 11px; font-weight: 600;
        background: var(--bs-card-bg); color: var(--bs-gray-700);
        border: 1px solid var(--bs-border-color); border-radius: .475rem;
    }
    .cbd-dock-tab:hover { color: var(--bs-primary); border-color: var(--bs-primary); }
    .cbd-dock-tab.on {
        color: var(--bs-primary); border-color: var(--bs-primary);
        background: rgba(var(--bs-primary-rgb), .08);
    }
    .cbd-dock-count {
        writing-mode: horizontal-tb; font-size: 9px; line-height: 1; padding: 2px 4px;
        border-radius: 6px; background: var(--bs-gray-200); color: var(--bs-gray-700);
    }
    /* THE PANEL PUSHES, IT DOES NOT COVER. Flying out over the canvas was the first attempt and it was
       rejected for the obvious reason: the panel was sitting on top of the design being worked on. So a
       panel takes its own column of the row and the canvas gives up that width while it is open — the
       point of the tab strip is that closing it hands all of that width straight back (34px of tabs
       instead of a permanent 290px rail: the canvas goes from 607px to 906px). */
    .cbd-dock-panel { flex: 0 0 250px; width: 250px; }
    /* The toolbox keeps the width it was designed at: the tool buttons, the field list and the band
       rows were all laid out for a 290px rail. */
    .cbd-dock-panel-wide { flex: 0 0 290px; width: 290px; }

    .cbd-stage {
        flex: 1 1 auto; min-width: 0;
        display: grid;
        grid-template-columns: 22px 1fr;
        grid-template-rows: 22px 1fr 34px;
        background: var(--bs-card-bg); border-radius: .475rem; border: 1px solid var(--bs-border-color);
        overflow: hidden;
    }
    .cbd-ruler-corner { grid-column: 1; grid-row: 1; background: var(--bs-gray-200); }
    .cbd-ruler-h { grid-column: 2; grid-row: 1; background: var(--bs-gray-200); position: relative; overflow: hidden; }
    .cbd-ruler-v { grid-column: 1; grid-row: 2; background: var(--bs-gray-200); position: relative; overflow: hidden; }
    .cbd-tick { position: absolute; font-size: 8px; color: var(--bs-gray-600); }
    .cbd-tick-h { top: 0; border-inline-start: 1px solid var(--bs-gray-400); height: 100%; padding-inline-start: 2px; }
    .cbd-tick-v { inset-inline-start: 0; border-top: 1px solid var(--bs-gray-400); width: 100%; padding-inline-start: 2px; }

    .cbd-scroll { grid-column: 2; grid-row: 2; overflow: auto; background: var(--bs-gray-200); padding: 14px; min-height: 420px; max-height: calc(100vh - 330px); }
    .cbd-statusbar { grid-column: 1 / -1; grid-row: 3; display: flex; align-items: center; gap: .5rem; padding: 0 .75rem; border-top: 1px solid var(--bs-border-color); }

    .cbd-page { background: #fff; position: relative; margin: 0 auto; box-shadow: 0 2px 14px rgba(0,0,0,.15); }
    .cbd-content { position: absolute; }

    /* ============================================================================================
           THE ICON TOOLBAR.

           One button shape for every control in both bars, which is what makes a set of icons read as
           a toolbar rather than as a row of pictures. 30px square, the same hairline border, the same
           hover, and exactly three states: resting, hovered, and ON.

           "ON" IS A REAL STATE AND LOOKS LIKE ONE. A toggle that only darkens on hover cannot tell you
           whether the page footer prints — which was the actual complaint about the checkboxes it
           replaces, in a different form: they could be read, but only by reading.
           ============================================================================================ */
        .cbd-tb-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;
                    min-width:30px;height:30px;padding:0 7px;border-radius:6px;cursor:pointer;
                    border:1px solid var(--bs-gray-300);background:var(--bs-body-bg);
                    color:var(--bs-gray-700);line-height:1;transition:background .12s,border-color .12s,color .12s;}
        .cbd-tb-btn:hover{background:var(--bs-gray-100);border-color:var(--bs-gray-400);color:var(--bs-gray-900);}
        .cbd-tb-btn:active{background:var(--bs-gray-200);}
        .cbd-tb-btn:focus-visible{outline:2px solid var(--bs-primary);outline-offset:1px;}
        .cbd-tb-btn[disabled]{opacity:.4;cursor:default;pointer-events:none;}
        .cbd-i{display:block;flex:0 0 auto;}

        /* The pressed state of a toggle and of a segment are the SAME state, so they are the same
           treatment: tinted ground, brand border, brand ink. */
        .cbd-tgl-input:checked + .cbd-tb-btn,
        .cbd-tb-btn.on{background:var(--bs-primary-light);border-color:var(--bs-primary);
                       color:var(--bs-primary);}
        .cbd-tgl-input:checked + .cbd-tb-btn:hover,
        .cbd-tb-btn.on:hover{background:var(--bs-primary-light);border-color:var(--bs-primary);}

        /* The checkbox still exists and still carries the state - it is only not drawn. Kept in the
           layout rather than display:none so focus can land on it and the label still follows it. */
        .cbd-tgl-input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;margin:0;}
        .cbd-tgl-input:focus-visible + .cbd-tb-btn{outline:2px solid var(--bs-primary);outline-offset:1px;}

        .cbd-tb-primary{background:var(--bs-primary);border-color:var(--bs-primary);color:#fff;
                        padding:0 12px;font-weight:600;font-size:.85rem;}
        .cbd-tb-primary:hover{background:var(--bs-primary-active);border-color:var(--bs-primary-active);color:#fff;}
        .cbd-tb-danger:hover{background:var(--bs-danger-light);border-color:var(--bs-danger);color:var(--bs-danger);}

        /* A group reads as one control: inner corners squared, one shared border. */
        .cbd-seg{display:inline-flex;}
        .cbd-seg .cbd-tb-btn{border-radius:0;margin-inline-start:-1px;}
        .cbd-seg .cbd-tb-btn:first-child{border-start-start-radius:6px;border-end-start-radius:6px;margin-inline-start:0;}
        .cbd-seg .cbd-tb-btn:last-child{border-start-end-radius:6px;border-end-end-radius:6px;}
        .cbd-seg .cbd-tb-btn.on{position:relative;z-index:1;}

        .cbd-tb-label{font-size:.7rem;font-weight:600;color:var(--bs-gray-500);
                      text-transform:uppercase;letter-spacing:.04em;margin-inline-end:2px;}
        .cbd-tb-sep{width:1px;height:22px;background:var(--bs-gray-300);margin:0 6px;flex:0 0 auto;}
        .cbd-tb-sel{height:30px;padding-block:0;}
        .cbd-tb-num{width:58px;height:30px;padding-block:0;text-align:center;}
        .cbd-tb-range{width:96px;}
        .cbd-tb-pct{font-size:.75rem;font-weight:600;color:var(--bs-gray-700);
                    width:38px;text-align:center;font-variant-numeric:tabular-nums;}

        /* The select a segmented control speaks for. Not display:none — it stays the element the
           load path writes to and the change handler listens on. */
        .cbd-hidden-select{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;}

        .cbd-pop-wrap{position:relative;display:inline-flex;}
        .cbd-pop{position:absolute;top:calc(100% + 6px);inset-inline-start:0;z-index:60;
                 min-width:200px;padding:12px;border-radius:8px;
                 background:var(--bs-body-bg);border:1px solid var(--bs-gray-300);
                 box-shadow:0 6px 24px rgba(0,0,0,.12);}
        .cbd-pop-title{font-size:.7rem;font-weight:700;color:var(--bs-gray-500);
                       text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px;}
        .cbd-pop-grid{display:grid;grid-template-columns:auto 72px;gap:6px 10px;align-items:center;}
        .cbd-pop-grid label{font-size:.78rem;font-weight:600;color:var(--bs-gray-700);margin:0;}

    /* The drag-select box. Pointer-events off so the drag keeps reaching the band underneath it -
           with them on, the box swallows its own mousemove the instant it gains a pixel of size. */
        .cbd-marquee{position:absolute;z-index:40;pointer-events:none;
                     border:1px solid var(--bs-primary);background:rgba(24,119,242,.12);border-radius:2px;}
    .cbd-band { position: relative; border-bottom: 1px dashed var(--bs-gray-400); }
    .cbd-band.sel { background: rgba(var(--bs-primary-rgb), .04); }
    .cbd-band-tag {
        position: absolute; top: 1px; inset-inline-start: 1px; z-index: 0;
        font-size: 8px; line-height: 1; padding: 2px 4px; border-radius: 2px;
        background: var(--bs-gray-200); color: var(--bs-gray-700); pointer-events: none; user-select: none;
    }
    .cbd-band.drop { background: rgba(var(--bs-primary-rgb), .10); }

    /* THE BAND SPLITTER. 6px along the band's bottom edge — the boundary itself is what the user aims at,
       so the grip is drawn on it rather than beside it. It lies over the last 6px of the band, which is
       the one cost: an element sitting flush against the bottom is grabbed from slightly higher up.
       z-index sits above elements (theirs come from e.z, which counts up from 1) but below the element
       resize handles at 999, so a selected element's corner still wins where the two meet. */
    .cbd-band-resize {
        position: absolute; inset-inline: 0; bottom: 0; height: 6px; z-index: 500;
        cursor: row-resize; background: transparent;
    }
    /* .on is re-applied to THIS grip after every frame of the drag: renderCanvas rebuilds the node, so
       :hover alone goes dark the instant the element it was hovering is replaced. */
    .cbd-band-resize:hover, .cbd-band-resize.on { background: rgba(var(--bs-primary-rgb), .45); }

    .cbd-el {
        position: absolute; box-sizing: border-box; overflow: hidden; cursor: move;
        display: flex; user-select: none;

        /* EVERY ELEMENT SHOWS ITS BOX, not just the selected one.
           A chart is 85x64mm on the page and its design-time face is one short line of text, so with
           no outline the canvas showed a title and then bare grid where the chart was - it read as a
           missing element, and the only way to find out otherwise was to click where it should be.
           A hairline says "something occupies this space" without competing with the real borders an
           author sets, which are drawn from the element's own style and sit inside this one. */
        outline: 1px dashed var(--bs-gray-400); outline-offset: -1px;
    }
    /* A label, a bound field or a system field is text on a line; an outline round each one turns a
       header into a wireframe. The hairline is for the elements whose SIZE is the point. */
    .cbd-el[data-kind="0"], .cbd-el[data-kind="1"], .cbd-el[data-kind="5"], .cbd-el[data-kind="6"] {
        outline: none;
    }
    .cbd-el:hover { outline-color: var(--bs-primary); }
    /* overflow:visible ONLY while selected. The element clips its own content (a long value must not
       spill across the page), but the resize handles sit half-outside its box — with the clip on they
       were invisible AND unclickable, so nothing could be resized with the mouse. Found by the probe. */
    .cbd-el.sel { outline: 2px solid var(--bs-primary); outline-offset: -1px; overflow: visible; }
    .cbd-el-body { flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: pre-wrap; word-break: break-word; }
    .cbd-el img { display: block; width: 100%; height: 100%; }

    /* AN IMAGE MUST FIT ITS FRAME, and without this rule it does the opposite: it SETS its own height and
       the frame is ignored.
       The body span is a flex item whose cross size comes from `align-items` on the element — flex-start,
       centre or flex-end, never stretch — so its height is AUTO. `height:100%` on a child of an
       auto-height parent is an indefinite percentage, which computes to `auto`: the picture keeps its
       intrinsic aspect ratio at width:100% and a portrait photo becomes several times taller than the
       box. `object-fit` cannot help, because it only has an effect on a box with a definite size — which
       is why "احتواء / Contain" appeared to do nothing at all.
       Unselected, .cbd-el's overflow:hidden hid the damage by cropping. SELECTED, that clip is off (the
       resize handles need it off) — so the picture visibly spilled out of its own frame, which is how
       this was reported.
       align-self:stretch gives the span the element's own content height, and a stretched flex item's
       cross size IS definite, so the percentage resolves and object-fit finally applies. Stretch also
       matches what the print renderer emits, where the img is a direct child of a box with an explicit
       height in mm — so the canvas and the printed page now size images the same way. */
    .cbd-el-img > .cbd-el-body { align-self: stretch; min-height: 0; }

    .cbd-handle {
        position: absolute; width: 9px; height: 9px; background: #fff;
        border: 1px solid var(--bs-primary); border-radius: 1px; z-index: 999;
    }
    .cbd-handle.nw { inset-inline-start: -5px; top: -5px; cursor: nwse-resize; }
    .cbd-handle.ne { inset-inline-end: -5px; top: -5px; cursor: nesw-resize; }
    .cbd-handle.sw { inset-inline-start: -5px; bottom: -5px; cursor: nesw-resize; }
    .cbd-handle.se { inset-inline-end: -5px; bottom: -5px; cursor: nwse-resize; }

    /* THE FOUR EDGE HANDLES. Each sits at the middle of its side and resizes ONE axis, which is the
       whole reason they exist: a corner cannot change a height without dragging the width along with
       it. Centred with a translate rather than a calc on inset, so the element's own RTL mirroring
       keeps working - inset-inline-* flips, and a hard-coded left would not. */
    .cbd-handle.n { inset-inline-start: 50%; top: -5px;    transform: translateX(-50%); cursor: ns-resize; }
    .cbd-handle.s { inset-inline-start: 50%; bottom: -5px; transform: translateX(-50%); cursor: ns-resize; }
    .cbd-handle.w { inset-inline-start: -5px; top: 50%;    transform: translateY(-50%); cursor: ew-resize; }
    .cbd-handle.e { inset-inline-end: -5px;   top: 50%;    transform: translateY(-50%); cursor: ew-resize; }

    .cbd-guide { position: absolute; background: #f1416c; z-index: 998; pointer-events: none; }

    .cbd-tool { cursor: grab; }
    .cbd-asset { border: 1px solid var(--bs-border-color); border-radius: .3rem; padding: 2px; cursor: grab; background: #fff; }
    .cbd-asset img { width: 46px; height: 34px; object-fit: contain; display: block; }

    /* AN ASSET ROW CAN OUTLIVE ITS FILE. The row is in the database and the bytes are on the application's
       own disk, so an instance that was re-published — or a second instance pointed at the same database —
       lists images whose GET answers 404. Left alone that reads as "the picture will not import": an empty
       box and no reason given. These two rules make it say so instead. */
    .cbd-asset.missing { border: 1px dashed var(--bs-danger); position: relative; width: 52px; height: 40px; }
    .cbd-asset.missing::after {
        content: "!"; position: absolute; inset: 0; display: grid; place-items: center;
        color: var(--bs-danger); font-weight: 700; font-size: 15px; line-height: 1;
    }
    .cbd-img-missing { color: var(--bs-danger); font-size: 10px; line-height: 1.1; text-align: center; }

    /* The preview pane hosts the RENDERER's own markup. It is given room and left alone: restyling it
       here would make the preview disagree with the print, which is the one thing this design forbids. */
    #cbd-preview-body .cbv-page { margin: 0 auto 14px; }

    /* Tablet: the rails collapse under the canvas rather than squeezing it to nothing. */
    @@media (max-width: 1199.98px) {
        .cbd-wrap { flex-wrap: wrap; }
        .cbd-rail { width: 100%; flex: 1 1 100%; order: 2; }
        .cbd-stage { order: 1; flex: 1 1 100%; width: 100%; }
        .cbd-rail-body { max-height: 300px; }

        /* The tab strip stops holding a whole row to itself: with the rails wrapped it was the only
           thing on its line, 34px of content in a 101px band. */
        .cbd-dockbar { order: 0; flex-direction: row; }
    }

    /* ---- PHONE ----------------------------------------------------------------------------------
       Nothing here was overflowing — the complaint was the SPRAWL. Measured at 390 x 844: the page ran
       1682px tall, of which 400px was chrome before any of the design was visible; the page-setup strip
       alone took 217px as five nearly-empty right-aligned rows, and the saved-reports tab sat sideways
       on a line of its own. Below is that same content, laid out for the width it actually has. */
    @@media (max-width: 767.98px) {

        /* The setup strip becomes a two-column grid: label and control on one line, each pair filling
           half the width, instead of one pair per row with a wide empty gutter beside it. */
        /* minmax(0, 1fr), NOT 1fr. A bare 1fr track has an automatic MINIMUM of min-content, so the row
           of four margin boxes widened both tracks to ~300px each, the full-width groups then measured
           612px inside a 348px card, and the whole document picked up 270px of horizontal scroll — the
           header included, because it is laid out against the widened canvas. min-width:0 on the groups
           is the same rule one level down: a grid item has that automatic minimum too. */
        #cbd-setup { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem .75rem; align-items: center; }
        #cbd-setup > div { display: flex; align-items: center; gap: .4rem; justify-content: space-between; min-width: 0; }
        #cbd-setup > div > label, #cbd-setup > div > span { white-space: nowrap; }
        #cbd-setup > div > select, #cbd-setup > div > input { width: auto !important; min-width: 0; flex: 1 1 auto; }
        /* The margins, the grid group and the zoom slider need the full width — four boxes, three
           controls and a range slider do not survive being squeezed into half a phone. Marked with a
           class rather than selected with :has(), which is recent enough that a browser without it
           would silently squeeze them anyway. */
        #cbd-setup > .cbd-setup-wide { grid-column: 1 / -1; margin-inline-start: 0 !important; }

        /* A sideways tab is a desktop affordance. On a phone the dock is a plain full-width button with
           the list dropping underneath it, in the flow, where a phone user expects it. */
        .cbd-dockbar { flex: 1 1 100%; width: 100%; flex-wrap: wrap; }
        .cbd-dockbar-tabs { flex-direction: row; flex: 1 1 100%; }
        .cbd-dock-tab { writing-mode: horizontal-tb; flex: 1 1 auto; justify-content: center; padding: 8px; }
        .cbd-dock-panel, .cbd-dock-panel-wide { width: 100%; flex: 1 1 100%; margin-top: .5rem; }

        /* The canvas gets the height back that the chrome above it was taking. */
        .cbd-stage { grid-template-columns: 16px 1fr; grid-template-rows: 16px 1fr 34px; }
        .cbd-rail-body { max-height: 260px; }

        /* Buttons that carry both an icon and a word wrap to three rows at this width; the label is what
           makes them findable, so the padding goes rather than the text. */
        #kt_app_toolbar .btn { padding-inline: .5rem; }
    }
</style>
}

@section Scripts {
@* ---------------------------------------------------------------------------------------------
    THE DESIGNER'S ONLY SERVER CONTRACT.

    Everything the script needs from the server is here, in one object, emitted before the script
    loads. The designer itself is a static file - see report-studio.js for why it stopped being
    inline. Adding a fifth value means adding it here and reading it there; it does not mean moving
    JavaScript back into a view.
--------------------------------------------------------------------------------------------- *@
<script>
    window.CBD = {
        arabic: @(arabic ? "true" : "false"),

        // The faces the RENDERERS will accept, not a list typed here. A designer offering a font the
        // renderer refuses shows one thing in the browser and another on paper, with nothing to
        // explain the difference.
        fonts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            CrossBuy.BL.Reporting.ReportTypography.DesignerFaces)),

        // A report opened from a link, resolved and re-validated server-side. null covers both
        // "nothing to open" and "not yours", which is one answer on purpose.
        openDraft: @Html.Raw(openDraft == null
            ? "null"
            : System.Text.Json.JsonSerializer.Serialize(openDraft, new System.Text.Json.JsonSerializerOptions
              { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
    };
</script>
<script src="@Url.Content("~/Backend-assets/js/report-studio.js")" asp-append-version="true"></script>
}
