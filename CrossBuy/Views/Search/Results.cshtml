@model string
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    ViewData["Title"] = L("نتائج البحث", "Search results");
}
@*
    A LIST SCREEN LIKE EVERY OTHER ONE IN THE PRODUCT.

    This page used to be served whole: changing the search meant a full navigation, so the shell,
    the menu and every script were fetched again to change a table. The other ninety-six list
    screens load their shell once and then fetch rows — cbServerList, with a fixed set of element
    ids and a Data action that answers with a partial of rows plus X-Total / X-Page / X-Pages.
    This is now one of them, so it searches without reloading and it looks like the rest of the
    product because it is built the same way, not because its styling was copied.

    The grouping moved from cards into a Type column: cbServerList injects into one tbody, and a
    table is also what someone arriving from the header box expects to be able to page and resize.
*@
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("نتائج البحث", "Search results")</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted" id="searchScope">@L("ابحث عبر كل ما تملك صلاحية رؤيته", "Search across everything you may view")</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <div class="card mb-5">
                <div class="card-body py-5">
                    <div class="row g-4 align-items-end">
                        <div class="col-md-10">
                            <label class="form-label fs-7 text-muted">@L("كلمات البحث", "Search terms")</label>
                            <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off"
                                   placeholder="@L("أضف كلمات للبحث…", "Add search terms…")" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" id="f_reset" class="btn btn-light w-100" title="@L("إعادة تعيين", "Reset")">
                                <i class="ki-outline ki-arrows-circle fs-3"></i> @L("إعادة تعيين", "Reset")
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header border-0 pt-6">
                    <div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
                    <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                        <select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true">
                            <option value="25">25</option><option value="50">50</option><option value="100">100</option>
                        </select>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <table class="table table-row-bordered align-middle gy-3" id="t">
                            <thead>
                                <tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                                    <th>@L("النوع", "Type")</th>
                                    <th>@L("السجل", "Record")</th>
                                    <th class="text-end">@L("إجراء", "Action")</th>
                                </tr>
                            </thead>
                            <tbody id="rows"></tbody>
                        </table>
                    </div>
                    <div class="text-center text-muted py-10 d-none" id="loadingRow">
                        <span class="spinner-border spinner-border-sm me-2"></span>@L("جارٍ البحث…", "Searching…")
                    </div>
                    @*
                        NOTHING MATCHED IS NOT THE SAME CLAIM AS NOTHING EXISTS. Every type is filtered
                        by what this person may see, so the sentence names that limit rather than
                        implying the record is absent from the system.
                    *@
                    @*
                        TWO DIFFERENT EMPTY TABLES, AND THEY MUST NOT SAY THE SAME THING.
                        Arriving from the menu with nothing typed, the list loads once and comes back
                        with no rows — which is not "nothing matched", it is "nothing was asked". The
                        first version told someone who had just opened the page that their search had
                        failed, before they had made one.
                    *@
                    <div class="text-center text-muted py-10 d-none" id="emptyRow">
                        <div id="emptyPrompt">
                            <div class="fs-6 fw-semibold text-gray-700">@L("اكتب كلمتين على الأقل للبحث", "Type at least two characters to search")</div>
                            <div class="fs-7 mt-1">@L("يبحث عبر العملاء والموردين والفواتير والقيود والمهام والمشاريع وكل كيان لديك صلاحية رؤيته.", "Across customers, suppliers, invoices, journals, tasks, projects and every entity you may view.")</div>
                        </div>
                        <div id="emptyNoMatch" class="d-none">
                            <div class="fs-6 fw-semibold text-gray-700">@L("لا نتائج ضمن ما تملك صلاحية رؤيته", "Nothing matched within what you may view")</div>
                            <div class="fs-7 mt-1">@L("جرّب جزءًا من الاسم أو الكود بدل الكلمة كاملة.", "Try part of the name or the code rather than the whole word.")</div>
                        </div>
                    </div>
                    <div class="d-flex flex-stack flex-wrap pt-5">
                        <div class="fs-7 text-muted" id="pageInfo"></div>
                        <ul class="pagination" id="pager"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@*
    The list helper, loaded here rather than assumed. _LayoutAccounting ships it for its own list
    screens; _LayoutBackend does not, so on this page cbServerList was simply undefined and the
    table stayed empty with nothing in the console to say why. Loading it from the page that needs
    it keeps the five shared layouts untouched; it only defines functions, so a layout that later
    includes it as well costs nothing.
*@
<script src="~/Backend-assets/js/crossbuy-tagify.js" asp-append-version="true"></script>
<script>
(function () {
    // The term in the address bar is NOT seeded here: cbServerList already reads ?q= before its
    // first load, so arriving from the header box, a link or a bookmark lands already searching.
    // Doing it again here would fire a second identical request for the same rows.
    var scope = document.getElementById('searchScope');
    var idle = '@L("ابحث عبر كل ما تملك صلاحية رؤيته", "Search across everything you may view")';

    cbServerList({
        url: '@Url.Action("ResultsData", "Search")',
        isAr: @(isAr ? "true" : "false"),

        // HOW WIDE THE SEARCH WAS, SAID OUT LOUD.
        //
        // "12 results" leaves a real doubt unanswered: twelve matches, or only one place looked?
        // Only types WITH hits come back, so the breadth is invisible exactly when the answer is
        // thin and the doubt is sharpest. The rows cannot carry this, so the Data action reports it
        // in headers — how many types were actually searched, and whether any hit its own ceiling.
        onLoaded: function (headers) {
            // Which empty table this is — from the server, which knows what it was asked.
            var asked = headers.get('X-Asked') === '1';
            var prompt = document.getElementById('emptyPrompt'), noMatch = document.getElementById('emptyNoMatch');
            if (prompt && noMatch) {
                prompt.classList.toggle('d-none', asked);
                noMatch.classList.toggle('d-none', !asked);
            }

            if (!scope) return;
            var types = parseInt(headers.get('X-Types') || '0', 10);
            var cut = headers.get('X-Truncated') === '1';
            var bits = [];
            if (types > 0) bits.push(@Html.Raw(isAr ? "'بحثنا في ' + types + ' نوعًا من السجلات'" : "'across ' + types + ' record types'"));
            if (cut) bits.push('@L("أول النتائج فقط — ضيّق البحث لرؤية غيرها", "first matches only — narrow the search to reach the rest")');
            scope.textContent = bits.length ? bits.join(' · ') : idle;
        }
    });
})();
</script>
}
