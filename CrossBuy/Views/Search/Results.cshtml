@model CrossBuy.BL.Platform.GlobalSearchResponse
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string L(string ar, string en) => isAr ? ar : en;
    ViewData["Title"] = L("نتائج البحث", "Search results");
    var typed = !string.IsNullOrWhiteSpace(Model.Term) && Model.Term.Length >= 2;
    var anyTruncated = Model.Groups.Any(g => g.Truncated);
}
@*
    THE RESULTS READ DOWN ONE COLUMN, NOT ACROSS TWO.

    This page used to lay the groups out two-across on a full-width container. With the one or two
    groups a real search usually returns, that put a half-width card in the top corner of an empty
    page — which is what made it look unfinished rather than merely sparse. Search results are read
    in order of relevance, so a single column is both the better scan and the layout that does not
    collapse when there is one answer. The column is capped at a readable width instead of being
    stretched across the screen, because a result line that runs the width of a monitor is harder
    to read, not more generous.
*@
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@L("نتائج البحث", "Search results")</h1>
                @*
                    THE TERM IS ISOLATED. An Arabic term inside an English sentence — or the reverse —
                    reorders around the punctuation and the count, and the line came out as
                    `for "1 · "موز result(s)`: the number had jumped inside the quotes. <bdi> isolates
                    the term so the sentence around it keeps its own direction whatever was typed.
                *@
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">
                        @if (!typed)
                        {
                            @L("اكتب كلمة للبحث", "Type a term to search")
                        }
                        else
                        {
                            @L("عن", "for")<text>&nbsp;</text><bdi class="text-gray-800 fw-bold">@Model.Term</bdi>
                            <text>&nbsp;·&nbsp;</text>
                            @* The figure is what is SHOWN, and says so, because each type is capped twice. *@
                            <span>@(anyTruncated
                                     ? L($"أول {Model.Total} نتيجة", $"first {Model.Total} shown")
                                     : L($"{Model.Total} نتيجة", $"{Model.Total} result(s)"))</span>
                            @*
                                HOW WIDE THE SEARCH WAS. "1 result" on its own leaves the reader unable to
                                tell a single match from a search that only looked in one place — and only
                                types WITH hits appear below, so the breadth is otherwise invisible exactly
                                when the answer is thin and the doubt is sharpest.
                            *@
                            @if (Model.TypesSearched > 0)
                            {
                                <text>&nbsp;·&nbsp;</text>
                                <span>@L($"بحثنا في {Model.TypesSearched} نوعًا من السجلات", $"across {Model.TypesSearched} record types")</span>
                            }
                        }
                    </li>
                </ul>
            </div>
            <form method="get" asp-action="Results" class="d-flex align-items-center position-relative">
                <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                <input type="text" name="q" value="@Model.Term" class="form-control form-control-solid w-250px ps-12"
                       placeholder="@L("ابحث في كل شيء…", "Search everything…")" autofocus />
            </form>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            <div class="mw-900px">
                @if (!typed)
                {
                    <div class="notice d-flex align-items-center bg-light-primary rounded border-primary border border-dashed p-4 mb-5">
                        <i class="ki-outline ki-information-5 fs-2tx text-primary me-4"></i>
                        <div class="fs-7 text-gray-700">@L("اكتب حرفين على الأقل للبحث عبر العملاء والموردين والفواتير والقيود والمهام والمشاريع وكل كيان لديك صلاحية رؤيته.", "Type at least two characters to search across customers, suppliers, invoices, journals, tasks, projects and every entity you may view.")</div>
                    </div>
                }
                else if (Model.Total == 0)
                {
                    @*
                        NOTHING MATCHED IS NOT THE SAME CLAIM AS NOTHING EXISTS. Every type here is
                        filtered by what this person may see, so the honest sentence names that limit
                        rather than implying the record is not in the system.
                    *@
                    <div class="notice d-flex align-items-center bg-light-primary rounded border-primary border border-dashed p-4 mb-5">
                        <i class="ki-outline ki-information-5 fs-2tx text-primary me-4"></i>
                        <div>
                            <div class="fs-6 fw-bold text-gray-800 mb-1">
                                @L("لا نتائج لـ", "Nothing matched")&nbsp;<bdi>@Model.Term</bdi>
                            </div>
                            <div class="fs-7 text-gray-600">@L("ضمن ما تملك صلاحية رؤيته. جرّب جزءًا من الاسم أو الكود بدل الكلمة كاملة.", "within what you may view. Try part of the name or the code rather than the whole word.")</div>
                        </div>
                    </div>
                }
                else
                {
                    foreach (var g in Model.Groups)
                    {
                        <div class="card card-flush mb-5">
                            <div class="card-header align-items-center pt-5 min-h-auto pb-3">
                                <div class="card-title d-flex align-items-center gap-3 m-0">
                                    <span class="symbol symbol-35px">
                                        @* g.Icon already carries its own `ki-outline` prefix — every one of the
                                           registry's definitions does — so the class must not be added again. *@
                                        <span class="symbol-label bg-light-primary"><i class="@g.Icon fs-4 text-primary"></i></span>
                                    </span>
                                    <h3 class="m-0 fs-5 text-gray-900">@(isAr ? g.LabelAr : g.LabelEn)</h3>
                                    <span class="badge badge-light-primary">@g.Hits.Count</span>
                                </div>
                            </div>
                            <div class="card-body pt-0 pb-3">
                                @foreach (var h in g.Hits)
                                {
                                    @*
                                        A whole row is the target, not the few words of the label: a link
                                        you have to hit exactly is a link you miss. The chevron follows the
                                        UI direction, and the label is isolated so an Arabic name on an
                                        English screen does not drag the chevron across it.
                                    *@
                                    if (!string.IsNullOrEmpty(h.Url))
                                    {
                                        <a href="@h.Url" class="d-flex align-items-center justify-content-between gap-3 px-3 py-3 rounded text-gray-800 text-hover-primary bg-hover-light-primary">
                                            <bdi class="fw-semibold fs-7">@h.Label</bdi>
                                            <i class="ki-outline @(isAr ? "ki-left" : "ki-right") fs-5 text-muted flex-shrink-0"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        @*
                                            NO URL MEANS THE RECORD HAS NO SCREEN TO OPEN, which is a fact
                                            about the product rather than a fault. It is shown, not hidden,
                                            and it is plainly not a link.
                                        *@
                                        <div class="d-flex align-items-center gap-3 px-3 py-3 text-gray-600">
                                            <bdi class="fw-semibold fs-7">@h.Label</bdi>
                                        </div>
                                    }
                                }
                                @if (g.Truncated)
                                {
                                    <div class="d-flex align-items-center gap-2 px-3 pt-3 border-top border-gray-200 mt-2">
                                        <i class="ki-outline ki-information-5 fs-6 text-muted"></i>
                                        <span class="fs-8 text-muted">@L($"هذه أول {g.Hits.Count} فقط — ضيّق البحث لرؤية غيرها.", $"These are the first {g.Hits.Count} only — narrow the search to reach the rest.")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
