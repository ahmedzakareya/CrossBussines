@using CrossBuy.Models.Menu
@model CrossBuy.Controllers.PortalController.LauncherModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    Layout = null;
    // The opening screen after sign-in (approved prototype rev. 3: design-output/hospital-prototype/launcher.html, 2026-11-15).
    // Order: header with a real search · brand hero · what waits for you · pinned + continue · every system by domain.
    // Palette: the brand only (primary #3A5795, ink #1F2D4D, surface #E7F0FF); red marks only what is urgent. No per-system
    // colour (SystemEntry.Color is not used here) and no yellow — the owner's standing rule.
    var cur = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName ?? "en";
    bool isAr = cur == "ar";
    var langs = new[] { ("ar", "العربية"), ("en", "English"), ("fr", "Français") };
    var curLang = langs.FirstOrDefault(l => l.Item1 == cur).Item2 ?? "English";
    string Name(SystemEntry s) => isAr ? s.NameAr : s.NameEn;
    string Desc(SystemEntry s) => isAr ? s.DescAr : s.DescEn;
    var hour = DateTime.Now.Hour;
    var greet = hour < 12 ? Localizer["Good morning"] : hour < 18 ? Localizer["Good afternoon"] : Localizer["Good evening"];
    var first = (Model.Name ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
    string Face(string cls) => first.Length > 0
        ? "<span class=\"symbol-label fw-bold " + cls + "\" style=\"background:#E7F0FF;color:#3A5795\">" + System.Net.WebUtility.HtmlEncode(first[..1]) + "</span>"
        : "<span class=\"symbol-label\" style=\"background:#E7F0FF\"><i class=\"ki-outline ki-user fs-2\" style=\"color:#3A5795\"></i></span>";
    var today = DateTime.Now.ToString("dddd d MMMM yyyy", System.Globalization.CultureInfo.CurrentUICulture);
    var domainIcons = new Dictionary<string, string> { ["ops"] = "ki-handcart", ["fin"] = "ki-dollar", ["people"] = "ki-people", ["cust"] = "ki-message-text-2", ["work"] = "ki-briefcase", ["pack"] = "ki-category" };
    var domains = SystemCatalog.Domains.Where(d => Model.Systems.Any(s => s.Entry.Domain == d.Key)).ToList();
    // What waits for the user: the controller's signals, the urgent ones first.
    string SignalIcon(string url) => url.Contains("/Approvals", StringComparison.OrdinalIgnoreCase) ? "ki-check-circle"
                                   : url.Contains("/Tasks", StringComparison.OrdinalIgnoreCase) ? "ki-time" : "ki-sms";
    var signals = Model.Signals.OrderByDescending(s => s.Urgent).ThenByDescending(s => s.Count).ToList();
    int waitTotal = signals.Sum(s => s.Count), waitUrgent = signals.Where(s => s.Urgent).Sum(s => s.Count);
    var arrow = isAr ? "ki-arrow-left" : "ki-arrow-right";
    var data = new
    {
        systems = Model.Systems.Select(s => new { k = s.Entry.Key, g = s.Entry.Domain, name = Name(s.Entry), desc = Desc(s.Entry), url = s.Url, icon = s.Entry.Icon, count = s.Count, countText = isAr ? s.CountAr : s.CountEn, isNew = s.Entry.IsNew }),
        screens = Model.Screens.Select(x => new { k = x.System, name = isAr ? x.Ar : x.En, alt = isAr ? x.En : x.Ar, url = x.Url }),
        domains = domains.Select(d => new { k = d.Key, name = isAr ? d.Ar : d.En, icon = domainIcons.GetValueOrDefault(d.Key, "ki-category") }),
    };
}
<!DOCTYPE html>
<html lang="@cur" dir="@(isAr ? "rtl" : "ltr")" data-bs-theme="light">
<head>
    <title>@Localizer["Choose destination"] - @CrossBuy.BL.Platform.ProductIdentity.Name</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="@CrossBuy.BL.Platform.ProductIdentity.Assets.FaviconIco" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="@CrossBuy.BL.Platform.ProductIdentity.Assets.Icon" asp-append-version="true" />
    @if (isAr)
    {
        <link href="~/Backend-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="~/Backend-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="~/Backend-assets/fonts/cairo/cairo.css" rel="stylesheet" asp-append-version="true" />
    }
    else
    {
        <link href="~/Backend-assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="~/Backend-assets/css/style.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="~/Backend-assets/fonts/inter/inter.css" rel="stylesheet">
    }
    <link href="~/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" asp-append-version="true" />
    <style>
        :root { --lx-ink: #1F2D4D; --lx-brand: #3A5795; --lx-surface: #E7F0FF; --lx-radius: 1.25rem;
            --lx-shadow: 0 1px 2px rgba(31,45,77,.04), 0 8px 24px rgba(31,45,77,.06); --lx-shadow-hi: 0 2px 4px rgba(31,45,77,.05), 0 18px 40px rgba(31,45,77,.12); }
        body { font-family: Inter, Cairo, sans-serif; background: #F4F6FA; }
        html[dir=rtl] body { font-family: Cairo, Inter, sans-serif; }
        .num { direction: ltr; unicode-bidi: isolate; font-variant-numeric: tabular-nums; }

        /* header: translucent, sticky, a pill search */
        .lx-head { position: sticky; top: 0; z-index: 105; background: rgba(255,255,255,.82); backdrop-filter: blur(14px) saturate(160%); -webkit-backdrop-filter: blur(14px) saturate(160%); border-bottom: 1px solid rgba(31,45,77,.06); }
        .lx-head .lx-bar { min-height: 72px; }
        .lx-search { position: relative; }
        .lx-search input { border-radius: 999px; background: #EEF1F6; border: 1px solid transparent; transition: background .15s, border-color .15s, box-shadow .15s; }
        .lx-search input:focus { background: #fff; border-color: var(--bs-primary-border-subtle, #C8D1E3); box-shadow: 0 0 0 4px rgba(58,87,149,.10); }
        .lx-drop { position: absolute; top: calc(100% + 8px); inset-inline: 0; z-index: 110; display: none; max-height: 70vh; overflow: auto; border-radius: var(--lx-radius); box-shadow: var(--lx-shadow-hi); }
        .lx-search.open .lx-drop { display: block; }
        .lx-kbd { font-size: .7rem; border: 1px solid var(--bs-gray-300); border-radius: 6px; padding: 1px 7px; color: var(--bs-gray-600); background: #fff; }
        .lx-hit { display: flex; align-items: center; gap: .85rem; padding: .6rem .75rem; border-radius: .85rem; cursor: pointer; color: inherit; }
        .lx-hit.act, .lx-hit:hover { background: var(--lx-surface); }
        .lx-round { width: 42px; height: 42px; border-radius: 50%; }
        .lx-round:hover { background: var(--lx-surface) !important; }

        /* every card: borderless, soft shadow, a generous radius */
        .lx-card { border: 0 !important; border-radius: var(--lx-radius) !important; box-shadow: var(--lx-shadow) !important; }
        .lx-lift { transition: transform .18s ease, box-shadow .18s ease; }
        .lx-lift:hover { transform: translateY(-4px); box-shadow: var(--lx-shadow-hi) !important; }

        /* hero: the brand gradient, the theme's wave faint on top, a soft ring for depth */
        .lx-hero { position: relative; overflow: hidden; border-radius: 1.5rem; color: #fff; background: linear-gradient(120deg, #1F2D4D 0%, #2B4170 55%, #3A5795 100%); }
        .lx-hero::before { content: ''; position: absolute; inset: 0; background: url('@Url.Content("~/Backend-assets/media/svg/shapes/wave-bg-dark.svg")') center / cover no-repeat; opacity: .35; }
        .lx-hero::after { content: ''; position: absolute; width: 420px; height: 420px; border-radius: 50%; inset-inline-end: -120px; top: -180px; background: radial-gradient(circle, rgba(255,255,255,.14) 0%, rgba(255,255,255,0) 70%); }
        .lx-hero > * { position: relative; z-index: 1; }
        .lx-hero .lx-eyebrow { color: rgba(255,255,255,.65); letter-spacing: .04em; }
        .lx-hero .lx-chip { background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.16); color: #fff; border-radius: 999px; }
        .lx-hero .lx-face { box-shadow: 0 0 0 4px rgba(255,255,255,.18); }
        .lx-glass { background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.18); border-radius: 1.1rem; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
        .lx-bar-track { height: 6px; border-radius: 999px; background: rgba(255,255,255,.16); overflow: hidden; display: flex; }
        .lx-bar-track span { display: block; height: 100%; }
        .lx-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .lx-hero .btn-light { border-radius: 999px; }

        /* squircle icons in the approved palette; they fill with the brand on hover */
        .lx-ic { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 30%; background: var(--lx-surface); color: var(--lx-brand); transition: background .18s ease, color .18s ease; }
        .lx-ic i { color: inherit !important; font-size: inherit !important; line-height: 1; }
        .lx-ic.solid { background: linear-gradient(135deg, #3A5795 0%, #1F2D4D 100%); color: #fff; box-shadow: 0 8px 18px rgba(31,45,77,.22); }
        .lx-ic.red.solid { background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%); color: #fff; box-shadow: 0 8px 18px rgba(185,28,28,.22); }
        .lx-sys:hover .lx-ic { background: var(--lx-brand); color: #fff; }
        .lx-ic-35 { width: 35px; height: 35px; font-size: 1.15rem; } .lx-ic-40 { width: 40px; height: 40px; font-size: 1.25rem; }
        .lx-ic-48 { width: 48px; height: 48px; font-size: 1.5rem; } .lx-ic-56 { width: 56px; height: 56px; font-size: 1.75rem; } .lx-ic-64 { width: 64px; height: 64px; font-size: 2rem; }

        /* what waits for you */
        .lx-stat .lx-go { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #F1F3F8; color: var(--bs-gray-500); transition: background .18s, color .18s; }
        .lx-stat .lx-go i { color: inherit !important; }
        .lx-stat:hover .lx-go { background: var(--lx-brand); color: #fff; }
        .lx-stat.red:hover .lx-go { background: var(--bs-danger, #DC2626); }
        .lx-stat.red { background: linear-gradient(180deg, #fff 55%, #FFF6F6 100%); }

        /* pinned: app tiles */
        .lx-fav { border-radius: 1.1rem; background: #F6F8FB; transition: background .18s ease, box-shadow .18s ease, transform .18s ease; }
        .lx-fav:hover { background: #fff; box-shadow: var(--lx-shadow-hi); transform: translateY(-3px); }
        .lx-fav .lx-count { position: absolute; top: -7px; inset-inline-end: -7px; border: 2px solid #fff; }

        /* continue where you left off */
        .lx-row { border-radius: .9rem; padding: .7rem .75rem; transition: background .15s ease; }
        .lx-row:hover { background: #F6F8FB; }

        /* all systems: demo39's icon tiles (dashboards/delivery) as the domain filter */
        .lx-tabs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-bottom: .25rem; }
        .lx-tabs::-webkit-scrollbar { display: none; }
        .lx-tabs .nav-link { min-width: 96px; height: 92px; border-radius: 1rem !important; white-space: nowrap; border-color: var(--bs-gray-200) !important; }
        .lx-tabs .nav-link.active { background: var(--lx-surface) !important; border-color: var(--bs-primary-border-subtle, #C8D1E3) !important; }
        .lx-tabs .nav-link.active .nav-text { color: var(--lx-ink) !important; }
        .lx-tabs .nav-link .bullet-custom { display: none; }
        .lx-tabs .nav-link.active .bullet-custom { display: block; }
        .lx-sys { color: inherit; }
        .lx-sys .lx-pin { opacity: 0; transition: opacity .12s ease; }
        .lx-sys:hover .lx-pin, .lx-sys:focus-within .lx-pin, .lx-pin.on { opacity: 1; }
        .lx-sys .lx-open { opacity: 0; transform: translateX(var(--lx-nudge, 6px)); transition: opacity .18s ease, transform .18s ease; }
        html[dir=rtl] .lx-sys .lx-open { --lx-nudge: -6px; }
        .lx-sys:hover .lx-open { opacity: 1; transform: none; }
        .lx-desc { min-height: 2.7em; }

        @@media (max-width: 575.98px) {
            .lx-sys .card-body { padding: 1.1rem !important; }
            .lx-sys .lx-desc, .lx-sys .lx-foot { display: none !important; }
            .lx-sys .fs-4 { font-size: 1rem !important; }
            .lx-hero .lx-hero-body { padding: 1.5rem !important; }
            .lx-hero .fs-2qx { font-size: 1.6rem !important; }
            .lx-hero .lx-face { display: none; }
        }
        @@media (max-width: 991.98px) { .lx-search { order: 9; width: 100%; } .lx-head .lx-bar { flex-wrap: wrap; padding-block: .75rem; } }
    </style>
</head>
<body>
    <!--begin::Header-->
    <div class="lx-head">
        <div class="container-xxl lx-bar d-flex align-items-center gap-3 gap-lg-6">
            <img src="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.LogoOnLight)" alt="@CrossBuy.BL.Platform.ProductIdentity.Name" class="h-25px h-lg-30px" />
            <div class="lx-search flex-lg-grow-1 mw-lg-560px mx-lg-auto" id="srch">
                <i class="ki-outline ki-magnifier fs-2 text-gray-500 position-absolute top-50 translate-middle-y ms-5"></i>
                <input type="text" id="q" class="form-control h-48px ps-13 pe-15 fs-6" autocomplete="off" placeholder="@Localizer["Search a system or a screen… journal, invoice, patient"]" />
                <span class="lx-kbd num position-absolute top-50 end-0 translate-middle-y me-4 d-none d-lg-inline">Ctrl K</span>
                <div class="lx-drop card"><div class="card-body p-3" id="qOut"></div></div>
            </div>
            <div class="d-flex align-items-center gap-1 gap-lg-2 ms-auto ms-lg-0">
                <!--begin::Language (theme menu)-->
                <div>
                    <button type="button" class="btn btn-sm btn-light-primary fw-bold rounded-pill px-4" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end"><i class="ki-outline ki-flag fs-5 me-1"></i>@curLang</button>
                    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-3 fs-6 w-175px" data-kt-menu="true">
                        @foreach (var (code, label) in langs)
                        {
                            <div class="menu-item px-3"><a class="menu-link px-5 @(code == cur ? "active" : "")" href="@Url.Action("SetLanguage", "Account", new { culture = code, returnUrl = Url.Action("Choose", "Portal") })">@label</a></div>
                        }
                    </div>
                </div>
                <!--end::Language-->
                <a class="btn btn-icon lx-round position-relative" href="@Url.Action("Index", "Chat")" title="@Localizer["Messages"]">
                    <i class="ki-outline ki-notification-on fs-1 text-gray-700"></i>
                    @if (Model.Unread > 0) {<span class="position-absolute top-0 start-100 translate-middle badge badge-circle badge-danger w-18px h-18px ms-n4 mt-3 fs-9 num">@Model.Unread</span>}
                </a>
                <!--begin::User menu (demo39 header)-->
                <div class="ms-1 ms-lg-2">
                    <div class="cursor-pointer symbol symbol-circle symbol-35px symbol-lg-42px" data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                        @if (!string.IsNullOrEmpty(Model.Photo)) { <img src="@Url.Content(Model.Photo)" alt="" style="object-fit:cover" data-face="@Face("")" onerror="this.outerHTML=this.getAttribute('data-face')" /> } else { @Html.Raw(Face("")) }
                    </div>
                    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-4 fs-6 w-275px" data-kt-menu="true">
                        <div class="menu-item px-3">
                            <div class="menu-content d-flex align-items-center px-3">
                                <div class="symbol symbol-50px symbol-circle me-5">
                                    @if (!string.IsNullOrEmpty(Model.Photo)) { <img src="@Url.Content(Model.Photo)" alt="" style="object-fit:cover" data-face="@Face("")" onerror="this.outerHTML=this.getAttribute('data-face')" /> } else { @Html.Raw(Face("")) }
                                </div>
                                <div class="d-flex flex-column min-w-0">
                                    <div class="fw-bold fs-5 text-truncate">@Model.Name</div>
                                    @if (!string.IsNullOrEmpty(Model.CompanyName)) {<span class="fw-semibold text-muted fs-7">@Model.CompanyName</span>}
                                </div>
                            </div>
                        </div>
                        <div class="separator my-2"></div>
                        <div class="menu-item px-5"><a href="@Url.Action("Dashboard", "People")" class="menu-link px-5">@Localizer["My profile"]</a></div>
                        <div class="menu-item px-5"><a href="@Url.Action("Index", "Chat")" class="menu-link px-5"><span class="menu-text">@Localizer["Messages"]</span>@if (Model.Unread > 0) {<span class="menu-badge"><span class="badge badge-light-danger badge-circle fw-bold fs-7 num">@Model.Unread</span></span>}</a></div>
                        <div class="separator my-2"></div>
                        <div class="menu-item px-5"><a href="@Url.Action("Logout", "Account")" class="menu-link px-5">@Localizer["Sign out"]</a></div>
                    </div>
                </div>
                <!--end::User menu-->
            </div>
        </div>
    </div>
    <!--end::Header-->

    <div class="container-xxl py-6 py-lg-8">
        <!--begin::Hero-->
        <div class="lx-hero mb-6 mb-xl-8">
            <div class="lx-hero-body d-flex flex-column flex-lg-row align-items-lg-center gap-7 px-8 px-lg-12 py-10">
                <div class="d-flex align-items-center gap-6 flex-grow-1 min-w-0">
                    <div class="symbol symbol-80px symbol-circle lx-face flex-shrink-0">
                        @if (!string.IsNullOrEmpty(Model.Photo)) { <img src="@Url.Content(Model.Photo)" alt="" style="object-fit:cover" data-face="@Face("fs-1")" onerror="this.outerHTML=this.getAttribute('data-face')" /> } else { @Html.Raw(Face("fs-1")) }
                    </div>
                    <div class="min-w-0">
                        <div class="lx-eyebrow fw-semibold fs-7 mb-1">@Localizer["Your workspace"]</div>
                        <div class="fw-bolder fs-2qx lh-sm mb-4">@greet@(first.Length > 0 ? (isAr ? "، " : ", ") + first : "")</div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="lx-chip fs-7 fw-semibold px-4 py-2"><i class="ki-outline ki-calendar fs-6 text-white me-2"></i>@today</span>
                            @if (!string.IsNullOrEmpty(Model.CompanyName)) {<span class="lx-chip fs-7 fw-semibold px-4 py-2"><i class="ki-outline ki-office-bag fs-6 text-white me-2"></i>@Model.CompanyName</span>}
                        </div>
                    </div>
                </div>
                <div class="lx-glass p-6 flex-shrink-0 w-lg-325px">
                    <div class="d-flex align-items-end justify-content-between mb-4">
                        <div>
                            <div class="text-white opacity-75 fw-semibold fs-7 mb-1">@Localizer["Waiting for you today"]</div>
                            <div class="text-white fw-bolder fs-3x lh-1 num">@waitTotal</div>
                        </div>
                        <div class="lx-ic lx-ic-48" style="background:rgba(255,255,255,.14);color:#fff"><i class="ki-outline ki-notification-status"></i></div>
                    </div>
                    @if (waitTotal > 0)
                    {
                        <div class="lx-bar-track mb-3"><span style="width:@((waitUrgent * 100.0 / waitTotal).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;background:#F87171"></span><span style="width:@(((waitTotal - waitUrgent) * 100.0 / waitTotal).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;background:rgba(255,255,255,.75)"></span></div>
                        <div class="d-flex gap-5 fs-8 fw-semibold text-white opacity-75 mb-5">
                            <span><span class="lx-dot me-2" style="background:#F87171"></span>@Localizer["Urgent"] <span class="num">@waitUrgent</span></span>
                            <span><span class="lx-dot me-2" style="background:rgba(255,255,255,.75)"></span>@Localizer["Other"] <span class="num">@(waitTotal - waitUrgent)</span></span>
                        </div>
                        <a href="@signals[0].Url" class="btn btn-sm btn-light fw-bold w-100">@Localizer["Start:"] @(isAr ? signals[0].Ar : signals[0].En)<i class="ki-outline @arrow fs-5 ms-2"></i></a>
                    }
                    else
                    {
                        <div class="text-white opacity-75 fw-semibold fs-7">@Localizer["Nothing is waiting for you"]</div>
                    }
                </div>
            </div>
        </div>
        <!--end::Hero-->

        @if (signals.Count > 0)
        {
            <!--begin::Waiting for you-->
            <div class="row g-5 g-xl-6 mb-6 mb-xl-8">
                @foreach (var s in signals)
                {
                    <div class="col-sm-6 col-lg">
                        <a href="@s.Url" class="card lx-card lx-lift lx-stat h-100 @(s.Urgent ? "red" : "")">
                            <div class="card-body d-flex align-items-center gap-5 p-6">
                                <span class="lx-ic lx-ic-56 solid @(s.Urgent ? "red" : "")"><i class="ki-outline @SignalIcon(s.Url)"></i></span>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center gap-2"><span class="fs-2hx fw-bolder text-gray-900 lh-1 num">@s.Count</span>@if (s.Urgent) {<span class="badge badge-light-danger rounded-pill fs-9 fw-bold">@Localizer["Urgent"]</span>}</div>
                                    <div class="fw-bold text-gray-700 fs-6 mt-2">@(isAr ? s.Ar : s.En)</div>
                                </div>
                                <span class="lx-go"><i class="ki-outline @arrow fs-5"></i></span>
                            </div>
                        </a>
                    </div>
                }
            </div>
            <!--end::Waiting for you-->
        }

        <div class="row g-5 g-xl-6 mb-6 mb-xl-8">
            <!--begin::Pinned-->
            <div class="col-xl-8">
                <div class="card lx-card h-100">
                    <div class="card-header border-0 pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Pinned"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@Localizer["Your everyday systems — up to 8, star any system"]</span>
                        </h3>
                    </div>
                    <div class="card-body pt-4"><div class="row g-4" id="favs"></div></div>
                </div>
            </div>
            <!--end::Pinned-->
            <!--begin::Continue-->
            <div class="col-xl-4">
                <div class="card lx-card h-100">
                    <div class="card-header border-0 pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Continue where you left off"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@Localizer["What you opened last"]</span>
                        </h3>
                    </div>
                    <div class="card-body pt-2 px-6" id="recent"></div>
                </div>
            </div>
            <!--end::Continue-->
        </div>

        <!--begin::All systems-->
        <div class="card lx-card">
            <div class="card-header border-0 pt-7 align-items-center">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-900">@Localizer["All systems"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7"><span class="num">@Model.Systems.Count</span> @Localizer["systems available to you"]</span>
                </h3>
            </div>
            <div class="px-9 pt-4"><ul class="nav lx-tabs gap-3" id="tabs"></ul></div>
            <div class="card-body pt-6"><div class="row g-5" id="grid"></div></div>
        </div>
        <!--end::All systems-->

        <div class="text-center text-gray-500 fs-7 mt-8">@Localizer["Only the systems you are allowed to open appear here"] · @CrossBuy.BL.Platform.ProductIdentity.Name @DateTime.Now.Year</div>
    </div>

    <script type="application/json" id="lxData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(data))</script>
    <script src="~/Backend-assets/plugins/global/plugins.bundle.js" asp-append-version="true"></script>
    <script src="~/Backend-assets/js/scripts.bundle.js" asp-append-version="true"></script>
    <script>
    (function () {
        'use strict';
        var D = JSON.parse(document.getElementById('lxData').textContent);
        var W = {
            all: @Json.Serialize(Localizer["All"].Value), pinHint: @Json.Serialize(Localizer["Star any system to pin it here"].Value), pin: @Json.Serialize(Localizer["Pin"].Value),
            max: @Json.Serialize(Localizer["At most 8 pinned systems"].Value), isNew: @Json.Serialize(Localizer["New"].Value), systems: @Json.Serialize(Localizer["Systems"].Value),
            screens: @Json.Serialize(Localizer["Screens"].Value), none: @Json.Serialize(Localizer["No results"].Value), system: @Json.Serialize(Localizer["System"].Value),
            recent: @Json.Serialize(Localizer["Recent"].Value), open: @Json.Serialize(Localizer["Open"].Value), noRecent: @Json.Serialize(Localizer["The screens you open will appear here"].Value)
        };
        var arrow = @Json.Serialize(arrow), lang = document.documentElement.lang || 'en';
        function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
        // Pins, the open tab and the recent screens are per-viewer conveniences: this browser only, and the screen works without them.
        var store = { get: function (k, d) { try { var v = localStorage.getItem(k); return v == null ? d : JSON.parse(v); } catch (e) { return d; } }, set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { } } };
        var BY = {}; D.systems.forEach(function (s) { BY[s.k] = s; });
        var DOM = {}; D.domains.forEach(function (d) { DOM[d.k] = d; });
        var pins = store.get('cb.launch.pins', []).filter(function (k) { return BY[k]; });
        var recent = store.get('cb.launch.recent', []).filter(function (r) { return BY[r.k]; });
        var tab = store.get('cb.launch.tab', 'all');

        function remember(k, name, url) {
            recent = [{ k: k, name: name, url: url, t: Date.now() }].concat(recent.filter(function (r) { return r.url !== url; })).slice(0, 5);
            store.set('cb.launch.recent', recent);
        }
        var rtf = null; try { rtf = new Intl.RelativeTimeFormat(lang, { numeric: 'auto' }); } catch (e) { }
        function ago(t) {
            if (!t || !rtf) return '';
            var m = Math.round((Date.now() - t) / 60000);
            if (m < 60) return rtf.format(-Math.max(m, 1), 'minute');
            var h = Math.round(m / 60); if (h < 24) return rtf.format(-h, 'hour');
            return rtf.format(-Math.round(h / 24), 'day');
        }
        function ic(icon, size, extra) { return '<span class="lx-ic lx-ic-' + size + ' ' + (extra || '') + '"><i class="ki-outline ' + esc(icon) + '"></i></span>'; }

        /* a system: identity, name, the description in full, what waits there, a star to pin, "open" on hover */
        function card(s) {
            var pinned = pins.indexOf(s.k) !== -1, dom = DOM[s.g];
            return '<div class="col-6 col-lg-4 col-xxl-3"><a class="card lx-card lx-lift lx-sys h-100" href="' + esc(s.url) + '" data-k="' + s.k + '">' +
                '<div class="card-body d-flex flex-column p-6">' +
                '<div class="d-flex align-items-start justify-content-between mb-5">' + ic(s.icon, '56') +
                '<div class="d-flex align-items-center gap-1">' +
                (s.isNew ? '<span class="badge badge-light-primary rounded-pill fw-bold fs-8 px-3">' + esc(W.isNew) + '</span>' : '') +
                '<button type="button" class="btn btn-icon btn-sm btn-active-light-primary rounded-circle w-32px h-32px lx-pin ' + (pinned ? 'on' : '') + '" data-pin="' + s.k + '" title="' + esc(W.pin) + '"><i class="ki-' + (pinned ? 'solid text-primary' : 'outline') + ' ki-star fs-3"></i></button>' +
                '</div></div>' +
                '<div class="fs-4 fw-bold text-gray-900 mb-1">' + esc(s.name) + '</div>' +
                '<div class="text-gray-600 fw-semibold fs-7 lx-desc">' + esc(s.desc) + '</div>' +
                '<div class="lx-foot d-flex align-items-center justify-content-between mt-auto pt-5">' +
                (s.count ? '<span class="badge badge-light-danger rounded-pill fw-bold fs-8 px-3 py-2"><span class="num me-1">' + s.count + '</span>' + esc(s.countText) + '</span>'
                    : '<span class="fs-8 fw-semibold text-gray-500">' + esc(dom ? dom.name : '') + '</span>') +
                '<span class="lx-open text-primary fw-bold fs-7 d-flex align-items-center gap-1">' + esc(W.open) + '<i class="ki-outline ' + arrow + ' fs-5 text-primary"></i></span>' +
                '</div></div></a></div>';
        }

        function render() {
            /* pinned: app tiles */
            var fav = pins.map(function (k) { return BY[k]; });
            document.getElementById('favs').innerHTML = fav.length ? fav.map(function (s) {
                return '<div class="col-6 col-md-3"><a href="' + esc(s.url) + '" class="lx-fav d-flex flex-column align-items-center text-center gap-3 h-100 px-3 py-7" data-k="' + s.k + '">' +
                    '<div class="position-relative">' + ic(s.icon, '64', 'solid') + (s.count ? '<span class="lx-count badge badge-circle badge-danger num">' + s.count + '</span>' : '') + '</div>' +
                    '<span class="fw-bold fs-6 text-gray-900 lh-sm">' + esc(s.name) + '</span>' +
                    (s.count ? '<span class="fw-semibold fs-8 text-danger lh-sm">' + esc(s.countText) + '</span>' : '<span class="fw-semibold fs-8 text-gray-500 lh-sm">' + esc(DOM[s.g] ? DOM[s.g].name : '') + '</span>') + '</a></div>';
            }).join('') : '<div class="col-12"><div class="d-flex align-items-center gap-4 rounded-4 border border-dashed border-gray-300 p-6"><i class="ki-outline ki-star fs-2x text-gray-400"></i><span class="text-gray-600 fw-semibold fs-6">' + esc(W.pinHint) + '</span></div></div>';

            /* continue where you left off */
            document.getElementById('recent').innerHTML = recent.length ? recent.map(function (r) {
                var s = BY[r.k];
                return '<a href="' + esc(r.url) + '" class="lx-row d-flex align-items-center gap-4 mb-1">' + ic(s.icon, '40') +
                    '<div class="flex-grow-1 min-w-0"><div class="text-gray-900 fw-bold fs-6 text-truncate">' + esc(r.name) + '</div>' +
                    '<div class="text-gray-500 fw-semibold fs-7">' + esc(s.name) + '</div></div>' +
                    '<span class="text-gray-500 fs-8 fw-semibold text-nowrap">' + esc(ago(r.t)) + '</span></a>';
            }).join('') : '<div class="d-flex align-items-center gap-4 rounded-4 border border-dashed border-gray-300 p-6"><i class="ki-outline ki-time fs-2x text-gray-400"></i><span class="text-gray-600 fw-semibold fs-6">' + esc(W.noRecent) + '</span></div>';

            /* all systems, filtered by domain */
            var tabs = [['all', W.all, D.systems.length, 'ki-element-11']].concat(D.domains.map(function (d) { return [d.k, d.name, D.systems.filter(function (s) { return s.g === d.k; }).length, d.icon]; }));
            if (!tabs.some(function (t) { return t[0] === tab; })) tab = 'all';
            document.getElementById('tabs').innerHTML = tabs.map(function (t) {
                return '<li class="nav-item"><a class="nav-link btn btn-outline btn-flex btn-color-muted btn-active-color-primary flex-column overflow-hidden position-relative pt-5 pb-3 px-5 ' + (t[0] === tab ? 'active' : '') + '" href="#" data-tab="' + t[0] + '">' +
                    '<div class="nav-icon mb-2"><i class="ki-outline ' + t[3] + ' fs-1 p-0"></i></div>' +
                    '<span class="nav-text text-gray-700 fw-bold fs-7 lh-1">' + esc(t[1]) + ' <span class="num text-gray-500 fw-semibold">' + t[2] + '</span></span>' +
                    '<span class="bullet-custom position-absolute bottom-0 start-0 w-100 h-3px bg-primary"></span></a></li>';
            }).join('');
            var list = tab === 'all' ? D.systems : D.systems.filter(function (s) { return s.g === tab; });
            document.getElementById('grid').innerHTML = list.map(card).join('');
        }
        render();

        document.addEventListener('click', function (e) {
            var t;
            if ((t = e.target.closest('[data-tab]'))) { e.preventDefault(); tab = t.getAttribute('data-tab'); store.set('cb.launch.tab', tab); render(); return; }
            if ((t = e.target.closest('[data-pin]'))) {
                e.preventDefault(); e.stopPropagation();
                var k = t.getAttribute('data-pin'), i = pins.indexOf(k);
                if (i !== -1) pins.splice(i, 1); else if (pins.length >= 8) { if (window.toastr) toastr.warning(W.max); return; } else pins.push(k);
                store.set('cb.launch.pins', pins); render(); return;
            }
            if ((t = e.target.closest('[data-k]'))) { var s = BY[t.getAttribute('data-k')]; if (s) remember(s.k, s.name, s.url); }
        });

        /* ---- the header search: every system and every screen the systems publish, keyboard first ---- */
        var box = document.getElementById('srch'), qIn = document.getElementById('q'), out = document.getElementById('qOut'), hits = [], cur = 0;
        function norm(s) { return String(s).toLowerCase().replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي'); }
        // Arabic singular ↔ broken plural for the words people type most, so "فاتورة" finds "الفواتير".
        var FORMS = [['فاتوره', 'فواتير'], ['قيد', 'قيود'], ['صنف', 'اصناف'], ['مريض', 'مرضي'], ['موظف', 'موظفين'], ['طلب', 'طلبات'], ['حساب', 'حسابات'], ['عميل', 'عملاء'],
            ['مورد', 'موردين'], ['امر', 'اوامر'], ['تقرير', 'تقارير'], ['مستودع', 'مستودعات'], ['مهمه', 'مهام'], ['مشروع', 'مشاريع'], ['غرفه', 'غرف'], ['سرير', 'اسره'], ['موعد', 'مواعيد']];
        function matches(text, v) {
            var t = norm(text);
            return v.split(/\s+/).every(function (w) {
                if (t.indexOf(w) !== -1) return true;
                var bare = w.replace(/^ال/, '');
                return FORMS.some(function (f) { return (f[0] === bare || f[1] === bare) && (t.indexOf(f[0]) !== -1 || t.indexOf(f[1]) !== -1); });
            });
        }
        function search() {
            var v = norm(qIn.value.trim());
            hits = [];
            if (!v) recent.forEach(function (r) { hits.push({ s: BY[r.k], name: r.name, url: r.url, grp: 'rec' }); });
            D.systems.forEach(function (s) { if (!v || matches(s.name + ' ' + s.desc, v)) hits.push({ s: s, name: s.name, url: s.url, grp: 'sys' }); });
            if (v) D.screens.forEach(function (x) { if (BY[x.k] && matches(x.name + ' ' + x.alt, v)) hits.push({ s: BY[x.k], name: x.name, url: x.url, grp: 'scr' }); });
            hits = hits.slice(0, 40); cur = 0; draw();
        }
        function draw() {
            var heads = { rec: W.recent, sys: W.systems, scr: W.screens }, html = '', last = '';
            hits.forEach(function (h, i) {
                if (h.grp !== last) { html += '<div class="text-gray-500 fw-bold fs-8 text-uppercase px-3 pt-3 pb-2">' + esc(heads[h.grp]) + '</div>'; last = h.grp; }
                html += '<a class="lx-hit ' + (i === cur ? 'act' : '') + '" data-i="' + i + '" href="' + esc(h.url) + '">' + ic(h.s.icon, '35') +
                    '<div class="flex-grow-1 min-w-0"><div class="fw-semibold fs-6 text-gray-800 text-truncate">' + esc(h.name) + '</div><div class="text-gray-500 fs-7">' + esc(h.grp === 'sys' ? W.system : h.s.name) + '</div></div>' +
                    (i === cur ? '<span class="lx-kbd num">Enter</span>' : '') + '</a>';
            });
            out.innerHTML = html || '<div class="text-gray-500 fs-6 p-5 text-center">' + esc(W.none) + '</div>';
            var a = out.querySelector('.lx-hit.act'); if (a) a.scrollIntoView({ block: 'nearest' });
        }
        function go(h) { remember(h.s.k, h.name, h.url); location.href = h.url; }
        function show() { box.classList.add('open'); search(); }
        function hide() { box.classList.remove('open'); }
        qIn.addEventListener('focus', show);
        qIn.addEventListener('input', search);
        document.addEventListener('mousedown', function (e) { if (!box.contains(e.target)) hide(); });
        document.addEventListener('keydown', function (e) { if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); qIn.focus(); qIn.select(); show(); } });
        qIn.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') { cur = Math.min(hits.length - 1, cur + 1); draw(); e.preventDefault(); }
            else if (e.key === 'ArrowUp') { cur = Math.max(0, cur - 1); draw(); e.preventDefault(); }
            else if (e.key === 'Enter' && hits[cur]) { e.preventDefault(); go(hits[cur]); }
            else if (e.key === 'Escape') { hide(); qIn.blur(); }
        });
        out.addEventListener('click', function (e) { var it = e.target.closest('.lx-hit'); if (it) { e.preventDefault(); go(hits[+it.getAttribute('data-i')]); } });
    })();
    </script>
    @await Html.PartialAsync("_LabCriticalAlerts")
</body>
</html>
