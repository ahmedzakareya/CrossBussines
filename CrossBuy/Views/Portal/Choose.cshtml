@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = null;
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var name = isAr ? (ViewBag.NameAr ?? ViewBag.NameEn) : (ViewBag.NameEn ?? ViewBag.NameAr);
    // language picker: show ALL supported languages, highlight the current one (click to switch)
    var _cur = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName ?? "en";
    var _langs = new[] { ("ar", "العربية"), ("en", "English"), ("fr", "Français") };
    // orbs mirror the side panels. START side = left in LTR / right in RTL; the grid flips panels in RTL so the orbs flip too.
    // top/bottom orbs sit closer to centre (…TB), middle orbs bulge outward (…MID).
    var sTB  = isAr ? "72%" : "28%";   var sMID = isAr ? "92%" : "8%";    // start side (Back-office / People / Reports)
    var eTB  = isAr ? "28%" : "72%";   var eMID = isAr ? "8%"  : "92%";   // end side  (Inventory / Accounting / Support)
    var arrow = isAr ? "left" : "right";
    // numeric versions (viewBox 0-100) for the SVG connector lines from the hub to each orb
    int sTBn = isAr ? 72 : 28, sMIDn = isAr ? 92 : 8, eTBn = isAr ? 28 : 72, eMIDn = isAr ? 8 : 92;
    var _links = new (int x, int y)[] { (sTBn,14),(eTBn,14),(sMIDn,50),(eMIDn,50),(sTBn,86),(eTBn,86) };
}
<!DOCTYPE html>
<html lang="@_cur" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <title>@Localizer["Choose destination"] - CrossBuy</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="~/Backend-assets/media/logos/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/Backend-assets/media/logos/crossbuy-favicon.svg" asp-append-version="true" />
    @if (isAr)
    {
        <link href="~/Backend-assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="~/Backend-assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@@400;600;700;800;900&display=swap" rel="stylesheet">
    }
    else
    {
        <link href="~/Backend-assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="~/Backend-assets/css/style.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&display=swap" rel="stylesheet">
    }
    <style>
        *{ box-sizing:border-box; }
        body{ margin:0; min-height:100vh; color:#E7F0FF; overflow-x:hidden; font-family:'Inter',system-ui,Tahoma,sans-serif;
            background:#0B3D91;
            background-image:
              radial-gradient(60% 50% at 50% 0%, rgba(251,191,36,.10), transparent 60%),
              radial-gradient(40% 40% at 95% 5%, rgba(56,189,248,.18), transparent 60%),
              radial-gradient(120% 120% at 50% 40%, #0E4A9E 0%, #0B3D91 45%, #0B3D91 100%); }
        html[lang="ar"] body{ font-family:'Cairo',system-ui,Tahoma,sans-serif; }
        a{ text-decoration:none; }
        .dots{ position:fixed; width:120px; height:90px; z-index:0; opacity:.5;
            background-image:radial-gradient(rgba(255,255,255,.18) 1.4px, transparent 1.4px); background-size:16px 16px; }
        .dots.tl{ top:120px; left:40px; } .dots.bl{ bottom:160px; left:30px; }
        .glow-corner{ position:fixed; bottom:-80px; left:-60px; width:420px; height:240px; z-index:0; pointer-events:none;
            background:radial-gradient(closest-side, rgba(251,191,36,.20), transparent 70%); filter:blur(8px); transform:rotate(-12deg); }

        .langbar{ position:fixed; top:22px; left:28px; z-index:6; display:inline-flex; align-items:center; gap:4px;
            background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18); border-radius:30px; padding:5px 6px; }
        .langbar .gl{ display:flex; align-items:center; color:#A8C5FF; margin:0 4px; }
        .langopt{ color:#D0E1FF; font-weight:600; font-size:13px; padding:5px 12px; border-radius:22px; line-height:1; transition:background .2s ease, color .2s ease; }
        .langopt:hover{ color:#fff; background:rgba(255,255,255,.12); }
        .langopt.on{ color:#0B3D91; background:linear-gradient(90deg,#FBBF24,#F59E0B); font-weight:800; }
        .shieldtop{ position:fixed; top:22px; right:28px; z-index:6; width:44px; height:44px; border-radius:14px;
            background:rgba(255,255,255,.06); border:1px solid rgba(251,191,36,.35); display:flex; align-items:center; justify-content:center; color:#FBBF24; }

        .head{ text-align:center; padding:16px 20px 2px; position:relative; z-index:3; }
        .logo{ height:34px; margin-bottom:10px; }
        .hello{ font-size:1.9rem; font-weight:900; margin:0 0 4px; color:#ffffff; }
        .hello span{ color:#FBBF24; }
        .sub{ color:#A8C5FF; font-size:1.05rem; margin:0; }
        .dash{ display:flex; align-items:center; justify-content:center; gap:7px; margin-top:14px; }
        .dash i{ width:34px; height:5px; border-radius:5px; background:rgba(255,255,255,.18); display:block; }
        .dash i.on{ width:42px; background:linear-gradient(90deg,#FBBF24,#F59E0B); }

        /* 3-column stage: left panels | center hub-orbit | right panels — 3 systems each side, aligned to the orbs */
        .stage{ position:relative; z-index:2; width:100%; max-width:1280px; margin:4px auto 0; padding:0 20px;
            display:grid; grid-template-columns:1fr 540px 1fr; align-items:stretch; gap:48px; }
        .side{ display:flex; flex-direction:column; justify-content:space-between; gap:12px; z-index:3; padding:4px 0; }
        .core{ position:relative; height:540px; z-index:2; }
        .links{ position:absolute; inset:0; width:100%; height:100%; z-index:1; pointer-events:none; overflow:visible; }
        .orbit{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:452px; height:452px;
            border:1.5px dashed rgba(251,191,36,.55); border-radius:50%; z-index:1;
            box-shadow: 0 0 40px -18px rgba(251,191,36,.6); }
        .orbit.two{ width:312px; height:312px; border-color:rgba(251,191,36,.18); box-shadow:none; }

        /* soft translucent glass spheres sitting on the ring (subtle colour halo — no hard neon rim) */
        .orb{ position:absolute; width:118px; height:118px; border-radius:50%; transform:translate(-50%,-50%); z-index:3; display:grid; place-items:center; cursor:pointer;
            background:
              radial-gradient(circle at 38% 28%, rgba(255,255,255,.14), rgba(255,255,255,0) 42%),
              radial-gradient(circle at 50% 52%, var(--glow), rgba(20,16,36,0) 72%),
              radial-gradient(circle at 50% 50%, rgba(18,20,30,.62), rgba(12,14,24,.66));
            border:2px solid var(--c);
            box-shadow: 0 0 15px 0 var(--c), inset 0 0 18px -5px var(--glow), inset 0 7px 16px rgba(255,255,255,.08);
            transition:transform .25s ease, box-shadow .25s ease; }
        .orb:hover{ transform:translate(-50%,-50%) scale(1.05); box-shadow: 0 0 22px 1px var(--c), inset 0 0 22px -5px var(--glow), inset 0 7px 16px rgba(255,255,255,.12); }
        .orb i{ font-size:54px; color:var(--c); filter:drop-shadow(0 6px 12px rgba(0,0,0,.45)); }
        .orb .orbsvg{ width:56px; height:56px; color:var(--c); filter:drop-shadow(0 6px 12px rgba(0,0,0,.45)); }
        .orb .num{ position:absolute; top:-4px; inset-inline-end:-4px; width:30px; height:30px; border-radius:50%;
            display:flex; align-items:center; justify-content:center; font-size:.74rem; font-weight:800; color:#fff;
            background: radial-gradient(circle at 40% 32%, rgba(255,255,255,.40), rgba(255,255,255,0) 58%), var(--c);
            box-shadow:0 0 14px 1px var(--glow), 0 2px 7px rgba(0,0,0,.45);
            border:1.5px solid rgba(255,255,255,.5); }
        .dotn{ position:absolute; width:9px; height:9px; border-radius:50%; transform:translate(-50%,-50%); z-index:2; background:var(--c); box-shadow:0 0 10px var(--glow); }

        .hub{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:196px; height:196px; border-radius:50%; z-index:4;
            display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; cursor:pointer;
            background:
              radial-gradient(circle at 38% 24%, rgba(255,255,255,.16), rgba(255,255,255,0) 42%),
              radial-gradient(circle at 50% 120%, rgba(251,191,36,.30), rgba(0,0,0,.4) 72%), #0B3D91;
            border:2px solid rgba(251,191,36,.45);
            box-shadow:0 30px 60px rgba(0,0,0,.55), inset 0 2px 14px rgba(255,255,255,.14), 0 0 50px rgba(251,191,36,.28); }
        .hub:hover{ box-shadow:0 30px 60px rgba(0,0,0,.6), inset 0 2px 14px rgba(255,255,255,.18), 0 0 70px rgba(251,191,36,.4); }
        .hubmark{ display:grid; grid-template-columns:1fr 1fr; gap:6px; width:60px; margin-bottom:12px; }
        .hubmark span{ width:27px; height:27px; border-radius:8px; }
        .hubmark .g{ background:linear-gradient(135deg,#FBBF24,#F59E0B); } .hubmark .e{ background:linear-gradient(135deg,#38BDF8,#0E4A9E); }
        .hub b{ font-size:1.12rem; font-weight:800; color:#fff; }
        .hub small{ font-size:.78rem; color:#A8C5FF; margin-top:2px; }

        .panel{ z-index:3; text-align:start; display:flex; flex-direction:column; }
        .panel .t{ font-weight:800; font-size:1.16rem; margin:0 0 4px; }
        .panel .d{ color:#A8C5FF; font-size:.85rem; line-height:1.55; margin:0 0 9px; }
        .panel ul{ list-style:none; margin:0 0 12px; padding:0; display:flex; flex-direction:column; gap:5px; }
        .panel li{ position:relative; color:#D0E1FF; font-size:.83rem; padding-inline-start:16px; }
        .panel li::before{ content:""; position:absolute; inset-inline-start:0; top:.5em; width:7px; height:7px; border-radius:50%; background:var(--c); box-shadow:0 0 8px var(--c); }
        .cta{ display:inline-flex; align-items:center; gap:9px; align-self:flex-start; padding:8px 18px; border-radius:30px; font-weight:700; font-size:.88rem; border:1.5px solid var(--c); color:#fff; transition:background .2s ease, color .2s ease; }
        .cta .ic{ width:23px; height:23px; border-radius:50%; background:#fff; display:flex; align-items:center; justify-content:center; font-size:.75rem; color:#0B3D91; }
        .panel:hover .cta{ background:var(--c); color:#0B3D91; }
        /* on hover the pill fills with the accent, so the badge inverts to stay
           readable: a white circle on a light accent would be ~2:1. */
        .panel:hover .cta .ic{ background:#0B3D91; color:#fff; }
        /* bottom wide systems (Manufacturing, CRM) */
        .morsys{ position:relative; z-index:3; max-width:980px; margin:6px auto 0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; padding:0 16px; }
        .msys{ display:flex; align-items:center; gap:14px; padding:16px 20px; border-radius:18px;
            background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.10); transition:background .2s ease, transform .2s ease, border-color .2s ease; }
        .msys:hover{ background:rgba(255,255,255,.09); transform:translateY(-2px); border-color:var(--c); }
        .msys-ic{ width:50px; height:50px; flex:none; border-radius:13px; display:flex; align-items:center; justify-content:center;
            background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); box-shadow:0 0 22px -6px var(--c); }
        .msys-ic i{ font-size:26px; color:var(--c); }
        .msys-t{ font-weight:800; font-size:1.05rem; color:#fff; }
        .msys-d{ color:#A8C5FF; font-size:.82rem; }

        .features{ position:relative; z-index:3; max-width:1180px; margin:10px auto 14px; background:rgba(255,255,255,.05);
            border:1px solid rgba(255,255,255,.10); border-radius:20px; padding:12px 24px; display:flex; align-items:center; gap:18px; flex-wrap:wrap; justify-content:center; }
        .features .lead{ display:flex; align-items:center; gap:14px; padding-inline-end:22px; border-inline-end:1px solid rgba(255,255,255,.12); }
        .features .lead .sh{ width:62px; height:62px; border-radius:16px; background:radial-gradient(circle at 40% 30%, rgba(255,255,255,.25), transparent 60%), linear-gradient(135deg,#FBBF24,#b88a12); display:flex; align-items:center; justify-content:center; color:#3a2c05; flex:none; }
        .features .lead .sh i{ font-size:34px; line-height:1; }
        .features .lead b{ color:#FBBF24; font-size:1.05rem; } .features .lead small{ display:block; color:#A8C5FF; font-size:.82rem; max-width:230px; }
        .feat{ display:flex; align-items:center; gap:12px; }
        .feat .fi{ width:50px; height:50px; border-radius:13px; background:rgba(255,255,255,.08); border:1px solid rgba(168,197,255,.18); display:flex; align-items:center; justify-content:center; color:#A8C5FF; font-size:26px; flex:none; }
        .feat .fi i{ font-size:26px; line-height:1; }
        .feat b{ font-size:.95rem; color:#E7F0FF; } .feat small{ display:block; color:#7DA9FF; font-size:.78rem; }

        /* tablet & down: hide the decorative orbit; the 6 systems become clean stacked cards (2-col then 1-col) */
        @@media (max-width:1024px){
            .stage{ grid-template-columns:1fr 1fr; max-width:760px; gap:16px; align-items:stretch; }
            .core{ display:none; }
            .side{ justify-content:flex-start; gap:16px; padding:0; }
            .panel{ background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.10); border-radius:20px; padding:20px 22px; }
        }
        /* phone: single column, stack everything */
        @@media (max-width:640px){
            .stage{ grid-template-columns:1fr; max-width:460px; }
            .hello{ font-size:1.6rem; } .sub{ font-size:.95rem; }
            .langbar{ position:static; margin:12px auto 0; }
            .morsys{ grid-template-columns:1fr; }
            .features{ padding:16px; gap:16px; } .features .lead{ border-inline-end:none; padding-inline-end:0; }
        }
    </style>
</head>
<body>
    <span class="dots tl"></span><span class="dots bl"></span><span class="glow-corner"></span>

    <div class="langbar">
        <span class="gl"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"></path></svg></span>
        @foreach (var (code, label) in _langs)
        {
            <a asp-controller="Account" asp-action="SetLanguage" asp-route-culture="@code" asp-route-returnUrl="@Context.Request.Path" class="langopt @(_cur == code ? "on" : "")">@label</a>
        }
    </div>
    <div class="shieldtop"><i class="ki-outline ki-shield-tick fs-2"></i></div>

    <div class="head">
        <img class="logo" src="~/Backend-assets/media/logos/crossbuy-logo-light.svg" alt="CrossBuy" asp-append-version="true" />
        <h1 class="hello">@Localizer["Welcome, "]<span>@name</span></h1>
        <p class="sub">@Localizer["Choose the portal that fits your needs today"]</p>
        <div class="dash"><i></i><i class="on"></i><i></i></div>
    </div>

    <div class="stage">
        <!-- start-side panels: Back-office · People · Reports & Analytics -->
        <div class="side start">
            <div class="panel" style="--c:#22D3EE;">
                <div class="t" style="color:#22D3EE;">@Localizer["Administrative system"]</div>
                <div class="d">@Localizer["Companies, employees, roles & data"]</div>
                <ul><li>@Localizer["Users & permissions"]</li><li>@Localizer["System settings & data"]</li><li>@Localizer["Reports & statistics"]</li></ul>
                <a class="cta" href="@Url.Action("Index","Service")"><span class="ic"><i class="ki-outline ki-entrance-@arrow"></i></span>@Localizer["Enter"]</a>
            </div>
            <div class="panel" style="--c:#A8C5FF;">
                <div class="t" style="color:#A8C5FF;">@Localizer["Employees portal"]</div>
                <div class="d">@Localizer["Profile, leaves, payslips & alerts"]</div>
                <ul><li>@Localizer["Personal profile & data"]</li><li>@Localizer["Leaves & attendance"]</li><li>@Localizer["Requests & notifications"]</li></ul>
                <a class="cta" href="@Url.Action("Dashboard","People")"><span class="ic"><i class="ki-outline ki-entrance-@arrow"></i></span>@Localizer["Enter"]</a>
            </div>
            <div class="panel" style="--c:#5EEAD4;">
                <div class="t" style="color:#5EEAD4;">@Localizer["Reports & Analytics"]</div>
                <div class="d">@Localizer["Comprehensive reports & analytics for better decisions"]</div>
                <ul><li>@Localizer["Custom reports"]</li><li>@Localizer["Key performance indicators"]</li><li>@Localizer["Analytics & charts"]</li></ul>
                <a class="cta" href="@Url.Action("Executive","Accounting")"><span class="ic"><i class="ki-outline ki-entrance-@arrow"></i></span>@Localizer["Enter"]</a>
            </div>
        </div>

        <!-- centre hub + orbiting systems -->
        <div class="core">
            <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                @foreach (var p in _links)
                {
                    <line x1="50" y1="50" x2="@p.x" y2="@p.y" stroke="rgba(251,191,36,.34)" stroke-width="1" stroke-dasharray="2 5" vector-effect="non-scaling-stroke"></line>
                    <circle cx="@(((50 + p.x) / 2))" cy="@(((50 + p.y) / 2))" r="0.9" fill="rgba(251,191,36,.85)"></circle>
                    <circle cx="@(((50 + p.x * 3) / 4))" cy="@(((50 + p.y * 3) / 4))" r="0.7" fill="rgba(251,191,36,.6)"></circle>
                }
            </svg>
            <div class="orbit"></div>
            <div class="orbit two"></div>
            <a class="hub" href="@Url.Action("Index", "Service")">
                <div class="hubmark"><span class="g"></span><span class="e"></span><span class="e"></span><span class="g"></span></div>
                <b>@Localizer["Control panel"]</b>
                <small>@Localizer["Quick access to all systems"]</small>
            </a>
            <a class="orb" href="@Url.Action("Index","Service")"      style="--c:#22D3EE; --glow:rgba(34,211,238,.42);  left:@sTB;  top:14%;"><span class="num">01</span><i class="ki-solid ki-setting-2"></i></a>
            <a class="orb" href="@Url.Action("Index","Inventory")"    style="--c:#FBBF24; --glow:rgba(251,191,36,.45);  left:@eTB;  top:14%;"><span class="num">02</span><i class="ki-solid ki-handcart"></i></a>
            <a class="orb" href="@Url.Action("Dashboard","People")"   style="--c:#A8C5FF; --glow:rgba(168,197,255,.42); left:@sMID; top:50%;"><span class="num">03</span><i class="ki-solid ki-people"></i></a>
            <a class="orb" href="@Url.Action("Index","Accounting")"   style="--c:#38BDF8; --glow:rgba(56,189,248,.45);  left:@eMID; top:50%;"><span class="num">04</span><i class="ki-solid ki-bill"></i></a>
            <a class="orb" href="@Url.Action("Executive","Accounting")" style="--c:#5EEAD4; --glow:rgba(94,234,212,.42); left:@sTB;  top:86%;"><span class="num">03</span><i class="ki-solid ki-chart-line-up"></i></a>
            <a class="orb" href="@Url.Action("Tickets","Crm")"        style="--c:#D8B4FE; --glow:rgba(216,180,254,.45); left:@eTB;  top:86%;"><span class="num">04</span><svg class="orbsvg" viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-1a8 8 0 0 1 16 0v1"></path><rect x="2.4" y="12.8" width="4.3" height="6.6" rx="1.9" fill="currentColor" fill-opacity=".16"></rect><rect x="17.3" y="12.8" width="4.3" height="6.6" rx="1.9" fill="currentColor" fill-opacity=".16"></rect><path d="M19.45 19.4v.7a3 3 0 0 1-3 3H13.5"></path><circle cx="12" cy="23.1" r="1.15" fill="currentColor" stroke="none"></circle></svg></a>
        </div>

        <!-- end-side panels: Inventory · Accounting · Technical support -->
        <div class="side end">
            <div class="panel" style="--c:#FBBF24;">
                <div class="t" style="color:#FBBF24;">@SR["Inventory"]</div>
                <div class="d">@Localizer["Items, stock & movements"]</div>
                <ul><li>@Localizer["Items & warehouses"]</li><li>@Localizer["Stock movements & purchases"]</li><li>@Localizer["Counting & receiving"]</li></ul>
                <a class="cta" href="@Url.Action("Index","Inventory")"><span class="ic"><i class="ki-outline ki-entrance-@arrow"></i></span>@Localizer["Enter"]</a>
            </div>
            <div class="panel" style="--c:#38BDF8;">
                <div class="t" style="color:#38BDF8;">@SR["Accounting"]</div>
                <div class="d">@Localizer["Accounts, journals & reports"]</div>
                <ul><li>@Localizer["Journals & accounts"]</li><li>@Localizer["Invoices & payments"]</li><li>@Localizer["Financial reports"]</li></ul>
                <a class="cta" href="@Url.Action("Index","Accounting")"><span class="ic"><i class="ki-outline ki-entrance-@arrow"></i></span>@Localizer["Enter"]</a>
            </div>
            <div class="panel" style="--c:#D8B4FE;">
                <div class="t" style="color:#D8B4FE;">@Localizer["Technical support"]</div>
                <div class="d">@Localizer["Reach our support & assistance team"]</div>
                <ul><li>@Localizer["Support tickets & follow-up"]</li><li>@Localizer["Knowledge base"]</li><li>@Localizer["Direct contact"]</li></ul>
                <a class="cta" href="@Url.Action("Tickets","Crm")"><span class="ic"><i class="ki-outline ki-entrance-@arrow"></i></span>@Localizer["Enter"]</a>
            </div>
        </div>
    </div>

    <!--begin::Bottom wide systems (Manufacturing · CRM) -->
    <div class="morsys">
        <a class="msys" href="@Url.Action("WorkOrders","Inventory")" style="--c:#38BDF8;">
            <span class="msys-ic"><i class="ki-solid ki-gear"></i></span>
            <div><div class="msys-t">@SR["Manufacturing"]</div>
            <div class="msys-d">@Localizer["Work orders & production tracking (WIP)"]</div></div>
        </a>
        <a class="msys" href="@Url.Action("Index","Crm")" style="--c:#D8B4FE;">
            <span class="msys-ic"><i class="ki-solid ki-people"></i></span>
            <div><div class="msys-t">@SR["CRM"]</div>
