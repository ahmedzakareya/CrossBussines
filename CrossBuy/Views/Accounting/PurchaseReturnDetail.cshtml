@using CrossBuy.Models.Context.Accounting
@model PurchaseReturn
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var itemNames = ViewBag.ItemNames as Dictionary<int, string> ?? new();
    string M(decimal v) => v.ToString("N2");
    var ven = ViewBag.Vendor as Vendor;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Debit Note"] @Model.ReturnNo</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("PurchaseReturns","Accounting")" class="text-muted">@Localizer["Purchase returns"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Model.ReturnNo</li></ul></div>
        <div class="d-flex gap-2"><a href="@Url.Action("PurchaseReturns","Accounting")" class="btn btn-light btn-sm">@SR["Back"]</a>@* PRINTED FROM A TEMPLATE, NEVER FROM THE SCREEN. This was window.print(), which prints
               the page — the toolbar, the sidebar and all — and cannot be redesigned without a
               deployment. Every layout bound to this screen is read live; a second design authored
               in Report Studio appears here on its own. *@
            @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
            {
                ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.AccountingPurchaseReturnDetail,
                DocumentId = Model.ID.ToString(),
            })</div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body py-6"><div class="row g-6">
            <div class="col-md-4"><div class="text-muted fs-7">@SR["Vendor"]</div><div class="fw-bold fs-5 text-gray-900">@(ven == null ? "—" : (isAr ? ven.Name : (ven.NameEn ?? ven.Name)))</div></div>
            <div class="col-md-2"><div class="text-muted fs-7">@SR["Date"]</div><div class="fw-bold fs-5">@Model.ReturnDate.ToString("yyyy-MM-dd")</div></div>
            <div class="col-md-3"><div class="text-muted fs-7">@Localizer["Original invoice"]</div><div class="fw-bold fs-5">@(Model.OriginalInvoiceId.HasValue ? "#" + Model.OriginalInvoiceId : "—")</div></div>
            <div class="col-md-3 text-md-end"><div class="text-muted fs-7">@Localizer["Return total (at cost)"]</div><div class="fw-bold fs-3 text-danger">@M(Model.GrandTotal) <span class="fs-7 text-muted">EGP</span></div></div>
        </div>
        @if (Model.JournalEntryId != null) { <div class="mt-4"><a href="@Url.Action("JournalEntry","Accounting", new { id = Model.JournalEntryId })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-document fs-4"></i>@Localizer["Journal entry"] #@Model.JournalEntryId</a></div> }
        @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="text-muted fs-7 mt-3">@Model.Notes</div> }
        </div></div>
        <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@Localizer["Returned lines"]</h3></div>
            <div class="card-body pt-2"><div class="table-responsive">
                <table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                    <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">#</th><th>@SR["Item"]</th><th class="text-end">@Localizer["Qty"]</th><th class="text-end">@Localizer["Unit cost"]</th><th class="text-end">@Localizer["Tax%"]</th><th class="text-end pe-4">@SR["Total"]</th></tr></thead>
                    <tbody>
                    @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
                    {
                        <tr style="border-bottom:1px dashed #eef1f6;"><td class="ps-4 text-muted">@l.LineNo</td><td class="fw-semibold text-gray-800">@(itemNames.ContainsKey(l.ItemId) ? itemNames[l.ItemId] : l.ItemDescription)</td><td class="text-end">@l.Qty.ToString("0.##")</td><td class="text-end">@M(l.UnitCost)</td><td class="text-end text-muted">@l.TaxRate.ToString("0.##")%</td><td class="text-end fw-bold pe-4">@M(l.LineTotal)</td></tr>
                    }
                    </tbody>
                    <tfoot><tr class="fw-bolder fs-6" style="background:#E7F0FF;border-top:2px solid #0E4A9E;"><td colspan="5" class="ps-4 text-end" style="color:#145DBF;">@Localizer["Sub / Tax / Total"]</td><td class="text-end pe-4" style="color:#0E4A9E;">@M(Model.SubTotal) / @M(Model.TaxTotal) / @M(Model.GrandTotal)</td></tr></tfoot>
                </table>
            </div></div>
        </div>
        @* THE SAME THREE PANELS AS THE INVOICE THIS DOCUMENT REVERSES. A return is the document a
           customer argues about, so leaving it without a discussion thread while its invoice has one
           is the gap people work around by emailing each other. Both key off the same canonical
           IEntityRegistry code. *@
        @{
            ViewBag.TimelineEntityType = CrossBuy.BL.Platform.EntityRegistry.PurchaseReturn;
            ViewBag.TimelineEntityId = Model.ID;
        }
        @await Html.PartialAsync("_DocEventTimeline")

        @* The conversation endpoints are named HERE, not inside the shared partial: the panel is
           module-neutral and each screen names the actions its own module answers on. These are the
           invoice endpoints — they take the entity code and resolve it through one gate, so a family
           added to that map is served without three more actions. *@
        @{
            ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.PurchaseReturn;
            ViewBag.ConversationEntityId = Model.ID;
            ViewBag.ConversationListUrl = Url.Action("InvoiceConversation", "Accounting");
            ViewBag.ConversationAddUrl = Url.Action("InvoiceConversationAdd", "Accounting");
            ViewBag.ConversationReactUrl = Url.Action("InvoiceConversationReact", "Accounting");
        }
        @await Html.PartialAsync("_EntityConversation")
    </div></div>
</div>

@* The shared report dialog — see Views/Shared/_ReportPreviewModal.cshtml. *@
@await Html.PartialAsync("_ReportPreviewModal", (object)"Purchase return")
