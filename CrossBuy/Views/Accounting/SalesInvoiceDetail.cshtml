@using CrossBuy.Models.Context.Accounting
@model SalesInvoice
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var cust = ViewBag.Customer as Customer;
    // Communication Hub P4 — prefill the "Send by email" action for this invoice
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Sales Invoice"] @Model.InvoiceNo</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("SalesInvoices","Accounting")" class="text-muted">@Localizer["Sales"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Model.InvoiceNo</li></ul></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("SalesInvoices","Accounting")" class="btn btn-sm btn-light">@SR["Back"]</a>
            @if (Model.JournalEntryId.HasValue) { <a href="@Url.Action("JournalEntry","Accounting", new { id = Model.JournalEntryId })" class="btn btn-sm btn-light-primary">@Localizer["Linked entry"]</a> }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body py-5"><div class="row g-5">
            <div class="col-md-4"><div class="fs-7 text-muted">@SR["Customer"]</div><div class="fw-bold fs-5">@(cust == null ? "—" : (isAr ? cust.Name : (cust.NameEn ?? cust.Name)))</div></div>
            <div class="col-md-3"><div class="fs-7 text-muted">@SR["Date"]</div><div class="fw-bold fs-5">@Model.InvoiceDate.ToString("yyyy/MM/dd")</div></div>
            <div class="col-md-2"><div class="fs-7 text-muted">@SR["Status"]</div><div><span class="badge fw-bold" style="@(Model.Status == "Posted" ? "background:#E7F0FF;color:#0E4A9E;" : "background:#f2f4f7;color:#475467;")">@Model.Status</span></div></div>
            <div class="col-md-3"><div class="fs-7 text-muted">@Localizer["E-Invoice"]</div><div>@(string.IsNullOrEmpty(Model.EtaStatus) ? Localizer["Not sent"].Value : Model.EtaStatus)</div></div>
        </div></div></div>
        <div class="card"><div class="card-body">
            <div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">#</th><th>@SR["Description"]</th><th class="text-end">@Localizer["Qty"]</th><th class="text-end">@SR["Price"]</th><th class="text-end">@Localizer["Disc"]</th><th class="text-end">@Localizer["Tax%"]</th><th class="text-end pe-4">@SR["Total"]</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
                {
                    <tr style="border-bottom:1px dashed #eef1f6;"><td class="ps-4 text-muted">@l.LineNo</td><td class="fw-semibold text-gray-800">@(!isAr && !string.IsNullOrWhiteSpace(l.ItemDescriptionEn) ? l.ItemDescriptionEn : l.ItemDescription)</td><td class="text-end">@l.Qty.ToString("N2")</td><td class="text-end">@l.UnitPrice.ToString("N2")</td><td class="text-end text-muted">@l.DiscountAmount.ToString("N2")</td><td class="text-end text-muted">@l.TaxRate.ToString("N0")%</td><td class="text-end fw-bold pe-4">@l.LineTotal.ToString("N2")</td></tr>
                }
                </tbody>
            </table></div>
            <div class="d-flex justify-content-end mt-5"><div class="w-300px">
                <div class="d-flex flex-stack mb-2"><span class="text-muted">@SR["Subtotal"]</span><span class="fw-bold">@Model.SubTotal.ToString("N2")</span></div>
                <div class="d-flex flex-stack mb-2"><span class="text-muted">@SR["Tax"]</span><span class="fw-bold">@Model.TaxTotal.ToString("N2")</span></div>
                <div class="separator my-2"></div>
                <div class="d-flex flex-stack fs-4"><span class="fw-bold">@SR["GrandTotal"]</span><span class="fw-bold text-primary">@Model.GrandTotal.ToString("N2")</span></div>
            </div></div>
        </div></div>
        @{
            // Platform Kernel slice 1 — pilot screen. The business-event timeline sits above the existing
            // comments widget; both key off the same canonical IEntityRegistry code.
            ViewBag.TimelineEntityType = CrossBuy.BL.Platform.EntityRegistry.SalesInvoice;
            ViewBag.TimelineEntityId = Model.ID;
        }
        @await Html.PartialAsync("_DocEventTimeline")
        @* BUSINESS CONVERSATION. This replaces the _DocTimeline widget rather than sitting beside it.
           _DocTimeline posts to /Comments/* and stores rows in the legacy DocComments table — a SECOND
           comment store for the same (EntityType, EntityId) pair the Communication Platform already
           owns. Two widgets writing two stores on one screen is how a conversation ends up half in each,
           and it is the same duplicate-producer defect that had to be removed from the Workspace reports
           panel. The platform is the authoritative store (EntityRegistry declares SalesInvoice
           SupportsComments = true), so it keeps the screen and the legacy widget gives it up.
           Nothing was migrated because there was nothing to migrate: DocComments held 0 rows. *@
        @* The conversation endpoints are named HERE, not inside the shared partial. Accounting keeps
           the two actions it has always used; the partial no longer resolves them on its behalf. *@
        @{
            ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.SalesInvoice;
            ViewBag.ConversationEntityId = Model.ID;
            ViewBag.ConversationListUrl = Url.Action("InvoiceConversation", "Accounting");
            ViewBag.ConversationAddUrl = Url.Action("InvoiceConversationAdd", "Accounting");
        }
        @await Html.PartialAsync("_EntityConversation")
    </div></div>
</div>
