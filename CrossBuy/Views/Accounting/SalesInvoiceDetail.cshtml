@using CrossBuy.Models.Context.Accounting
@model SalesInvoice
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var cust = ViewBag.Customer as Customer;
    var customerName = cust == null ? "—" : (isAr ? cust.Name : (cust.NameEn ?? cust.Name));
    var lineCount = Model.Lines?.Count ?? 0;
}
@*  THE RECORD HEADER, built on the theme's own record page (demo39 apps/projects/project.html):
    an icon tile, the title with its status beside it, the owning party underneath, the actions on
    the far side, a row of dashed stat boxes, then line tabs across the foot of the card.

    The toolbar above keeps only the page title and the breadcrumb, exactly as that page does - the
    actions belong to the record, not to the chrome, so they move into the card with it. *@
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Sales Invoice"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("SalesInvoices","Accounting")" class="text-muted text-hover-primary">@Localizer["Sales"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><bdi dir="ltr">@Model.InvoiceNo</bdi></li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <div class="card mb-6">
            <div class="card-body pt-9 pb-0">
                <div class="d-flex flex-wrap flex-sm-nowrap mb-6">
                    <div class="d-flex flex-center flex-shrink-0 bg-light-primary rounded w-100px h-100px me-7 mb-4">
                        <i class="ki-outline ki-bill fs-3x text-primary" aria-hidden="true"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                            <div class="d-flex flex-column">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="text-gray-900 fs-2 fw-bold me-3"><bdi dir="ltr">@Model.InvoiceNo</bdi></span>
                                    @*  The accounting status palette is deliberate and is NOT the generic badge
                                        vocabulary - it is kept exactly as it was so this screen keeps agreeing
                                        with the rest of the module. *@
                                    <span class="badge fw-bold" style="@(Model.Status == "Posted" ? "background:#E7F0FF;color:#0E4A9E;" : "background:#f2f4f7;color:#475467;")">@Model.Status</span>
                                </div>
                                <div class="d-flex flex-wrap fw-semibold mb-4 fs-5 text-gray-500">
                                    <span class="d-flex align-items-center text-gray-500 me-5">
                                        <i class="ki-outline ki-profile-circle fs-4 me-1" aria-hidden="true"></i>@customerName
                                    </span>
                                    <span class="d-flex align-items-center text-gray-500">
                                        <i class="ki-outline ki-calendar fs-4 me-1" aria-hidden="true"></i>
                                        @*  InvariantCulture on purpose: the Arabic culture injects RIGHT-TO-LEFT MARKs (U+200F) around
                                            the separators, and those marks inside an isolated run still reorder it on screen -
                                            "2026/08/04" was rendering as "202604/08/". A machine-format date carries no language. *@
                                        <bdi dir="ltr">@Model.InvoiceDate.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture)</bdi>
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-4">
                                @*  Every layout bound to THIS screen, read live - see Views/Shared/_ReportPrintMenu.cshtml.
                                    A second design is authored in Report Studio and appears here on its own; nothing in
                                    this file names a report or a template. *@
                                @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
                                {
                                    ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.AccountingSalesInvoiceDetail,
                                    DocumentId = Model.ID.ToString(),
                                })
                                @if (Model.JournalEntryId.HasValue)
                                {
                                    <a href="@Url.Action("JournalEntry","Accounting", new { id = Model.JournalEntryId })" class="btn btn-sm btn-primary">@Localizer["Linked entry"]</a>
                                }
                                <a href="@Url.Action("SalesInvoices","Accounting")" class="btn btn-sm btn-bg-light btn-active-color-primary">@SR["Back"]</a>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap">
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center"><div class="fs-4 fw-bold" dir="ltr">@Model.GrandTotal.ToString("N2")</div></div>
                                <div class="fw-semibold fs-6 text-gray-500">@SR["GrandTotal"]</div>
                            </div>
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center"><div class="fs-4 fw-bold" dir="ltr">@Model.SubTotal.ToString("N2")</div></div>
                                <div class="fw-semibold fs-6 text-gray-500">@SR["Subtotal"]</div>
                            </div>
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center"><div class="fs-4 fw-bold" dir="ltr">@Model.TaxTotal.ToString("N2")</div></div>
                                <div class="fw-semibold fs-6 text-gray-500">@SR["Tax"]</div>
                            </div>
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center"><div class="fs-4 fw-bold" dir="ltr">@lineCount</div></div>
                                <div class="fw-semibold fs-6 text-gray-500">@Localizer["Lines"]</div>
                            </div>
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 mb-3">
                                <div class="d-flex align-items-center"><div class="fs-4 fw-bold">@(string.IsNullOrEmpty(Model.EtaStatus) ? Localizer["Not sent"].Value : Model.EtaStatus)</div></div>
                                <div class="fw-semibold fs-6 text-gray-500">@Localizer["E-Invoice"]</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

                <div class="card">
                    <div class="card-header align-items-center">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-900">@Localizer["Lines"]</span>
                            <span class="text-muted mt-1 fw-semibold fs-7">@Localizer["Invoice lines and totals"]</span>
                        </h3>
                        <div class="card-toolbar"><span class="badge badge-light-primary fs-8 fw-bold">@lineCount</span></div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table align-middle gy-4" style="font-variant-numeric:tabular-nums;">
                                <thead>
                                    <tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                        <th class="ps-4">#</th><th>@SR["Description"]</th>
                                        <th class="text-end">@Localizer["Qty"]</th><th class="text-end">@SR["Price"]</th>
                                        <th class="text-end">@Localizer["Disc"]</th><th class="text-end">@Localizer["Tax%"]</th>
                                        <th class="text-end pe-4">@SR["Total"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
                                {
                                    <tr class="cb-row">
                                        <td class="ps-4 text-muted">@l.LineNo</td>
                                        <td class="fw-semibold text-gray-800">@(!isAr && !string.IsNullOrWhiteSpace(l.ItemDescriptionEn) ? l.ItemDescriptionEn : l.ItemDescription)</td>
                                        <td class="text-end" dir="ltr">@l.Qty.ToString("N2")</td>
                                        <td class="text-end" dir="ltr">@l.UnitPrice.ToString("N2")</td>
                                        <td class="text-end text-muted" dir="ltr">@l.DiscountAmount.ToString("N2")</td>
                                        <td class="text-end text-muted" dir="ltr">@l.TaxRate.ToString("N0")%</td>
                                        <td class="text-end fw-bold pe-4" dir="ltr">@l.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-end mt-5"><div class="w-300px">
                            <div class="d-flex flex-stack mb-2"><span class="text-muted">@SR["Subtotal"]</span><span class="fw-bold" dir="ltr">@Model.SubTotal.ToString("N2")</span></div>
                            <div class="d-flex flex-stack mb-2"><span class="text-muted">@SR["Tax"]</span><span class="fw-bold" dir="ltr">@Model.TaxTotal.ToString("N2")</span></div>
                            <div class="separator separator-dashed my-3"></div>
                            <div class="d-flex flex-stack fs-4"><span class="fw-bold">@SR["GrandTotal"]</span><span class="fw-bold text-primary" dir="ltr">@Model.GrandTotal.ToString("N2")</span></div>
                        </div></div>
                    </div>
                </div>

            @*  The timeline and the conversation stay VISIBLE, stacked, exactly as they were.
                They were briefly put behind tabs here; that hid two sections the screen has always
                shown, which is a behaviour change nobody asked for. The theme look is in the header
                card and the card headers, not in hiding content. *@
                @{
                    // Platform Kernel slice 1 — pilot screen. The business-event timeline sits above the existing
                    // comments widget; both key off the same canonical IEntityRegistry code.
                    ViewBag.TimelineEntityType = CrossBuy.BL.Platform.EntityRegistry.SalesInvoice;
                    ViewBag.TimelineEntityId = Model.ID;
                }
                @await Html.PartialAsync("_DocEventTimeline")

                @* BUSINESS CONVERSATION. This replaces the _DocTimeline widget rather than sitting beside it.
                   _DocTimeline posts to /Comments/* and stores rows in the legacy DocComments table — a SECOND
                   comment store for the same (EntityType, EntityId) pair the Communication Platform already
                   owns. Two widgets writing two stores on one screen is how a conversation ends up half in each,
                   and it is the same duplicate-producer defect that had to be removed from the Workspace reports
                   panel. The platform is the authoritative store (EntityRegistry declares SalesInvoice
                   SupportsComments = true), so it keeps the screen and the legacy widget gives it up.
                   Nothing was migrated because there was nothing to migrate: DocComments held 0 rows. *@
                @* The conversation endpoints are named HERE, not inside the shared partial. Accounting keeps
                   the two actions it has always used; the partial no longer resolves them on its behalf. *@
                @{
                    ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.SalesInvoice;
                    ViewBag.ConversationEntityId = Model.ID;
                    ViewBag.ConversationListUrl = Url.Action("InvoiceConversation", "Accounting");
                    ViewBag.ConversationMentionUrl = Url.Action("InvoiceConversationMentions", "Accounting");
                    ViewBag.ConversationAddUrl = Url.Action("InvoiceConversationAdd", "Accounting");
                    ViewBag.ConversationReactUrl = Url.Action("InvoiceConversationReact", "Accounting");

                    @* COMMUNICATION PHASE 3. Both endpoints live on the TASKS controller, not this module:
                       the conversation is this screen's, the work is Tasks'. Naming them here is what opts
                       this screen in - the shared partial resolves no url on a caller's behalf, so a screen
                       that omits these two keeps exactly its previous behaviour.

                       This record type is EligibleForTaskLink in the entity registry, which is the other half
                       of the opt-in: a url on a type the registry refuses would offer work that cannot be
                       linked. *@
                    ViewBag.ConversationCreateTaskUrl = Url.Action("CreateFromMessage", "Tasks");
                    ViewBag.ConversationTasksUrl = Url.Action("ForConversation", "Tasks");
                    ViewBag.ConversationApprovalsUrl = Url.Action("ConversationApprovals", "Tasks");
                    @* LINKING AN EXISTING TASK. Three endpoints, named by the HOST because the partial
                       resolves none on a caller's behalf - the SHF rule on this file says so, and the
                       reason is that a second module including the panel would otherwise post its
                       messages at this module's controller, against a permission gate written for this
                       record. The panel reveals the button only when all three are present AND the
                       service reports LinkingAvailable, so a deployment without the CommTaskLinks table
                       shows nothing rather than a button that refuses. *@
                    ViewBag.ConversationLinkUrl = Url.Action("LinkConversation", "Tasks");
                    ViewBag.ConversationUnlinkUrl = Url.Action("UnlinkConversation", "Tasks");
                    ViewBag.ConversationLinkSearchUrl = Url.Action("LinkCandidates", "Tasks");
                }
                @await Html.PartialAsync("_EntityConversation")
        </div>
    </div>
</div>

@* The shared report dialog — see Views/Shared/_ReportPreviewModal.cshtml. *@
@await Html.PartialAsync("_ReportPreviewModal", (object)"Sales invoice")
