@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model IncomeStatement
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var from = (DateTime)ViewBag.From; var to = (DateTime)ViewBag.To;
    var profit = Model.NetProfit >= 0;
}
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Income Statement"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted text-hover-primary">@SR["Accounting"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Income Statement"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <form method="get" class="d-flex align-items-end gap-2">
                <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control form-control-solid form-control-sm w-150px" />
                <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control form-control-solid form-control-sm w-150px" />
                <button class="btn btn-sm btn-primary">@SR["Show"]</button>
            </form>
            <button onclick="window.print()" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-printer fs-4"></i>@SR["Print"]</button>
        </div>
    </div></div>
    <!--end::Toolbar-->

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Summary card-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body py-10">
                <h2 class="mb-2">@Localizer["Income Statement"]</h2>
                <p class="fs-6 fw-semibold text-gray-600 py-1 m-0">@Localizer["For the period"] @from.ToString("yyyy/MM/dd") &mdash; @Localizer["to"] @to.ToString("yyyy/MM/dd")</p>

                @{ string Raw(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture); }
                <div class="row mt-6">
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-info pb-1 px-2">@Localizer["Total Revenue"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.Revenue.Total)" data-kt-countup-decimal-places="2">@Model.Revenue.Total.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-danger pb-1 px-2">@Localizer["Total Expenses"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.Expenses.Total)" data-kt-countup-decimal-places="2">@Model.Expenses.Total.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold pb-1 px-2 @(profit?"":"text-danger")" style="@(profit?"color:#0E4A9E":"")">@(profit ? Localizer["Net Profit"] : Localizer["Net Loss"])</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.NetProfit)" data-kt-countup-decimal-places="2">@Model.NetProfit.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                @if (profit)
                {
                    <div class="notice d-flex rounded border border-dashed p-6 mt-4" style="background:#E7F0FF;border-color:#0E4A9E !important;">
                        <span class="symbol symbol-45px me-5"><span class="symbol-label" style="background:#0E4A9E;"><i class="ki-outline ki-chart-line-up fs-2x text-white"></i></span></span>
                        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                                <h4 class="text-gray-900 fw-bold mb-1">@SR["The period achieved a net profit"]</h4>
                                <div class="fs-6 text-gray-700">@SR["Net profit detail"]</div>
                            </div>
                            <span class="badge fs-7 fw-bold px-4 py-2 flex-shrink-0" style="background:#0E4A9E;color:#fff;"><i class="ki-outline ki-arrow-up fs-6 text-white me-1"></i>@SR["Profit"]: @Model.NetProfit.ToString("N2")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mt-4">
                        <span class="symbol symbol-45px me-5"><span class="symbol-label bg-danger"><i class="ki-outline ki-chart-line-down fs-2x text-white"></i></span></span>
                        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                                <h4 class="text-gray-900 fw-bold mb-1">@SR["The period incurred a net loss"]</h4>
                                <div class="fs-6 text-gray-700">@SR["Net loss detail"]</div>
                            </div>
                            <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0"><i class="ki-outline ki-arrow-down fs-6 text-white me-1"></i>@SR["Loss"]: @Math.Abs(Model.NetProfit).ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
        <!--end::Summary card-->

        <!--begin::Details card-->
        <div class="card">
            <div class="card-header card-header-stretch">
                <div class="card-title"><h3>@Localizer["Income Statement"]</h3></div>
            </div>
            <div class="card-body px-0 pt-0 pb-4">
                <div class="table-responsive">
                    <table class="table table-row-dashed align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                        <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th class="ps-9">@SR["Account"]</th><th class="text-end pe-9">@SR["Amount"]</th></tr></thead>
                        <tbody class="fs-6 fw-semibold text-gray-700">
                            <tr><td colspan="2" class="ps-9 py-3 fw-bold text-gray-800 fs-6" style="background:#f4f6f8;">@Localizer["Revenue"]</td></tr>
                            @foreach (var l in Model.Revenue.Lines)
                            {
                                <tr>
                                    <td class="ps-9"><span class="badge fs-8 fw-bold me-2" style="background:#E7F0FF;color:#145DBF;">@l.Code</span>@(isAr ? l.NameAr : DisplayName.Or(l.NameEn, l.NameAr))</td>
                                    <td class="text-end pe-9 text-gray-900 fw-bold">@l.Amount.ToString("N2")</td>
                                </tr>
                            }
                            @if (Model.Revenue.Lines.Count == 0) { <tr><td class="ps-9 text-muted">@Localizer["No revenue"]</td><td class="text-end pe-9 text-muted">0.00</td></tr> }
                            <tr style="border-top:1px solid #e9edf2;"><td class="ps-9 fw-bold text-gray-600">@Localizer["Total Revenue"]</td><td class="text-end pe-9 fw-bold text-gray-800">@Model.Revenue.Total.ToString("N2")</td></tr>

                            <tr><td colspan="2" class="ps-9 py-3 fw-bold text-gray-800 fs-6" style="background:#f4f6f8;">@Localizer["Expenses"]</td></tr>
                            @foreach (var l in Model.Expenses.Lines)
                            {
                                <tr>
                                    <td class="ps-9"><span class="badge fs-8 fw-bold me-2" style="background:#E7F0FF;color:#145DBF;">@l.Code</span>@(isAr ? l.NameAr : DisplayName.Or(l.NameEn, l.NameAr))</td>
                                    <td class="text-end pe-9 text-gray-900 fw-bold">(@l.Amount.ToString("N2"))</td>
                                </tr>
                            }
                            @if (Model.Expenses.Lines.Count == 0) { <tr><td class="ps-9 text-muted">@Localizer["No expenses"]</td><td class="text-end pe-9 text-muted">0.00</td></tr> }
                            <tr style="border-top:1px solid #e9edf2;"><td class="ps-9 fw-bold text-gray-600">@Localizer["Total Expenses"]</td><td class="text-end pe-9 fw-bold text-gray-800">(@Model.Expenses.Total.ToString("N2"))</td></tr>

                            <tr style="@(profit?"background:#E7F0FF":"")" class="@(profit?"":"bg-light-danger")">
                                <td class="ps-9 fw-bold fs-5 text-gray-900">@(profit ? Localizer["Net Profit"] : Localizer["Net Loss"])</td>
                                <td class="text-end pe-9 fw-bolder fs-4" style="@(profit?"color:#0E4A9E":"")"><span class="@(profit?"":"text-danger")">@Model.NetProfit.ToString("N2")</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!--end::Details card-->
    </div></div>
</div>
