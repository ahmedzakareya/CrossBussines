@using CrossBuy.Models.Context.Accounting
@model List<TaxCode>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Tax Codes"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Tax Codes"]</li></ul></div>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#mNew"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New code"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><div class="d-flex align-items-center position-relative my-1">
                <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                <input type="text" id="s" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search..."]" autocomplete="off" />
            </div></div></div>
            <div class="card-body pt-0 pb-4"><div class="table-responsive"><table class="table table-row-dashed align-middle gy-4 mb-0" id="t" style="font-variant-numeric:tabular-nums;">
                <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th>@SR["Code"]</th><th>@SR["Name"]</th><th class="text-center">@Localizer["Kind"]</th><th class="text-end">@Localizer["Rate"]</th><th class="text-center">@Localizer["Default"]</th><th class="text-center">@SR["Status"]</th><th class="text-end"></th></tr></thead>
                <tbody>
                @foreach (var c in Model) {
                    <tr class="r" data-s="@c.Code @c.Name @c.NameEn @c.Kind">
                        <td><span class="badge fs-8 fw-bold" style="background:#E7F0FF;color:#0E4A9E;">@c.Code</span></td>
                        <td class="fw-bold text-gray-900">@(isAr ? c.Name : (c.NameEn ?? c.Name))</td>
                        <td class="text-center">@if (c.Kind=="VAT") { <span class="badge badge-light-primary fw-bold">@Localizer["VAT"]</span> } else { <span class="badge fw-bold" style="background:#f1f3f7;color:#7e8299;">@Localizer["WHT"]</span> }</td>
                        <td class="text-end fw-bold text-gray-900">@c.Rate.ToString("0.##")%</td>
                        <td class="text-center">@if (c.IsDefault) { <i class="ki-outline ki-check-circle fs-4 text-primary"></i> } else { <span class="text-gray-300">—</span> }</td>
                        <td class="text-center">@if (c.IsActive) { <span class="badge badge-light-primary fw-bold">@SR["Active"]</span> } else { <span class="badge fw-bold" style="background:#f1f3f7;color:#7e8299;">@SR["Inactive"]</span> }</td>
                        <td class="text-end">
                            <button class="btn btn-icon btn-sm btn-light-primary me-1" title="@SR["Edit"]"
                                    data-bs-toggle="modal" data-bs-target="#mEdit"
                                    data-id="@c.ID" data-code="@c.Code" data-name="@c.Name" data-nameen="@c.NameEn"
                                    data-kind="@(c.Kind=="VAT"?Localizer["VAT"].Value:Localizer["WHT"].Value)"
                                    data-rate="@c.Rate.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)"
                                    data-default="@(c.IsDefault?"1":"0")"><i class="ki-outline ki-pencil fs-6"></i></button>
                            <form asp-action="ToggleTaxCode" method="post" class="d-inline" data-cb-confirm data-cb-action="generic" data-cb-text="@(c.IsActive?Localizer["Deactivate this tax code?"].Value:Localizer["Activate this tax code?"].Value)">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.ID" />
                                @if (c.IsActive)
                                {
                                    <button class="btn btn-icon btn-sm btn-light-primary" title="@Localizer["Deactivate"]"><i class="ki-outline ki-toggle-on fs-3"></i></button>
                                }
                                else
                                {
                                    <button class="btn btn-icon btn-sm" style="background:#f1f3f7;" title="@Localizer["Activate"]"><i class="ki-outline ki-toggle-off fs-3" style="color:#7e8299;"></i></button>
                                }
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-10">@Localizer["No tax codes"]</td></tr> }
                </tbody>
            </table></div></div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="mNew" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="CreateTaxCode" method="post">@Html.AntiForgeryToken()
        <div class="modal-header"><h2 class="fw-bold">@Localizer["New tax code"]</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <div class="row"><div class="col-6 mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Code"]</label><input name="code" class="form-control form-control-solid" required /></div>
            <div class="col-6 mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Kind"]</label><select name="kind" class="form-select form-select-solid"><option value="VAT">@Localizer["Value Added Tax"]</option><option value="WHT">@Localizer["Withholding"]</option></select></div></div>
            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Name (AR)"]</label><input name="name" class="form-control form-control-solid" required /></div>
            <div class="mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Name (EN)"]</label><input name="nameEn" class="form-control form-control-solid" /></div>
            <div class="row"><div class="col-6 mb-2"><label class="required fw-semibold fs-6 mb-2">@Localizer["Rate %"]</label><input name="rate" type="number" step="0.01" class="form-control form-control-solid" required /></div>
            <div class="col-6 mb-2 d-flex align-items-end"><label class="form-check form-check-custom"><input type="checkbox" name="isDefault" value="true" class="form-check-input" /><span class="form-check-label fw-semibold ms-2">@Localizer["Default for kind"]</span></label></div></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@SR["Save"]</button></div>
    </form>
</div></div></div>

<div class="modal fade" id="mEdit" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="UpdateTaxCode" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" id="e_id" />
        <div class="modal-header"><h2 class="fw-bold">@Localizer["Edit tax code"]</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <div class="row"><div class="col-6 mb-4"><label class="fw-semibold fs-6 mb-2">@SR["Code"]</label><input id="e_code" class="form-control form-control-solid" disabled /></div>
            <div class="col-6 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Kind"]</label><input id="e_kind" class="form-control form-control-solid" disabled /></div></div>
            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Name (AR)"]</label><input name="name" id="e_name" class="form-control form-control-solid" required /></div>
            <div class="mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Name (EN)"]</label><input name="nameEn" id="e_nameen" class="form-control form-control-solid" /></div>
            <div class="row"><div class="col-6 mb-2"><label class="required fw-semibold fs-6 mb-2">@Localizer["Rate %"]</label><input name="rate" id="e_rate" type="number" step="0.01" class="form-control form-control-solid" required /></div>
            <div class="col-6 mb-2 d-flex align-items-end"><label class="form-check form-check-custom"><input type="checkbox" name="isDefault" value="true" id="e_default" class="form-check-input" /><span class="form-check-label fw-semibold ms-2">@Localizer["Default for kind"]</span></label></div></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@SR["Save"]</button></div>
    </form>
</div></div></div>

@section Scripts { <script>
(function(){var i=document.getElementById('s');var rows=[].slice.call(document.querySelectorAll('#t tbody tr.r'));i.addEventListener('input',function(e){var q=(e.target.value||'').trim().toLowerCase();rows.forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});})();
(function(){var m=document.getElementById('mEdit');if(!m)return;m.addEventListener('show.bs.modal',function(ev){var b=ev.relatedTarget;if(!b)return;
  document.getElementById('e_id').value=b.getAttribute('data-id');
  document.getElementById('e_code').value=b.getAttribute('data-code')||'';
  document.getElementById('e_kind').value=b.getAttribute('data-kind')||'';
  document.getElementById('e_name').value=b.getAttribute('data-name')||'';
  document.getElementById('e_nameen').value=b.getAttribute('data-nameen')||'';
  document.getElementById('e_rate').value=b.getAttribute('data-rate')||'';
  document.getElementById('e_default').checked=(b.getAttribute('data-default')==='1');
});})();
</script> }
