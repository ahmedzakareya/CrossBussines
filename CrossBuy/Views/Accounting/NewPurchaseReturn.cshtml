@using CrossBuy.Models.Context.Accounting
@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var vendors = ViewBag.Vendors as List<Vendor> ?? new();
    var invItems = ViewBag.InvItems as List<Item> ?? new();
    var invWh = ViewBag.InvWarehouses as List<Warehouse> ?? new();
    var edit = ViewBag.EditReturn as PurchaseReturn;
    bool isEdit = edit != null;
    var itemBc = ViewBag.ItemBarcodes as Dictionary<int, string> ?? new();
    var editLines = isEdit ? edit!.Lines.OrderBy(l => l.LineNo).Select(l => new {
        itemId = l.ItemId, name = l.ItemDescription, wh = l.WarehouseId, q = l.Qty, tax = l.TaxRate,
        barcode = (itemBc.ContainsKey(l.ItemId)) ? itemBc[l.ItemId] : ""
    }).ToList<object>() : new List<object>();
}
<form asp-action="@(isEdit ? "UpdatePurchaseReturn" : "CreatePurchaseReturn")" method="post" id="f" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="id" value="@edit!.ID" /> }
    <input type="hidden" name="linesJson" id="linesJson" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isEdit ? SR["Edit invoice"].Value + " " + edit!.ReturnNo : Localizer["New Purchase Return / Debit Note"].Value)</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("PurchaseReturns","Accounting")" class="text-muted">@Localizer["Purchase returns"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@(isEdit ? SR["Edit"].Value : Localizer["New"].Value)</li></ul></div>
        <div class="d-flex gap-2"><a href="@Url.Action("PurchaseReturns","Accounting")" class="btn btn-light">@SR["Cancel"]</a><button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@(isEdit ? SR["Save changes"].Value : Localizer["Post return"].Value)</button></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="alert alert-light-warning border border-warning d-flex align-items-center mb-5"><i class="ki-outline ki-information fs-2 text-warning me-3"></i>@Localizer["Issues goods out, reverses the vendor payable & input VAT. Value is computed at the item's cost."]</div>
            <div class="card mb-5"><div class="card-body"><div class="row g-5">
                <div class="col-md-4"><label class="required fw-semibold fs-6 mb-2">@SR["Vendor"]</label>
                    <select name="vendorId" class="form-select form-select-solid" required><option value="">@Localizer["Select vendor"]</option>@foreach (var v in vendors) { <option value="@v.ID" selected="@(isEdit && edit!.VendorId == v.ID)">@(isAr ? v.Name : (v.NameEn ?? v.Name))</option> }</select></div>
                <div class="col-md-3"><label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label><input type="date" name="returnDate" class="form-control form-control-solid" value="@(isEdit ? edit!.ReturnDate.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" required /></div>
                <div class="col-md-2"><label class="fw-semibold fs-6 mb-2">@Localizer["Original inv."]</label><input type="number" name="originalInvoiceId" class="form-control form-control-solid" placeholder="#" value="@(isEdit ? edit!.OriginalInvoiceId?.ToString() : "")" /></div>
                <div class="col-md-3"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" value="@(isEdit ? edit!.Notes : "")" /></div>
            </div></div></div>
            <div class="card"><div class="card-header"><h3 class="card-title fw-bold">@Localizer["Lines (items)"]</h3><div class="card-toolbar d-flex gap-2"><button type="button" class="btn btn-sm btn-light-primary" id="newItem"><i class="ki-outline ki-plus fs-3"></i>@SR["New item"]</button><button type="button" class="btn btn-sm btn-light-primary" id="add"><i class="ki-outline ki-plus fs-3"></i>@Localizer["Add line"]</button></div></div>
            <div class="card-body"><div class="table-responsive"><table class="table table-row-bordered align-middle"><thead><tr class="fw-bold fs-7 text-uppercase text-muted">
                <th style="min-width:240px">@SR["Item"]</th><th style="min-width:150px">@SR["Warehouse"]</th><th style="width:110px">@Localizer["Qty"]</th><th style="width:100px">@Localizer["Tax%"]</th><th style="min-width:160px">@Localizer["Est. cost"]</th><th style="width:40px"></th>
            </tr></thead><tbody id="rows"></tbody></table></div>
            <div class="text-muted fs-8 mt-2">@Localizer["Final value is computed at the item's average cost on posting."]</div>
            </div></div>
    </div></div>
</form>
<partial name="~/Views/Shared/_QuickAdd.cshtml" />
@section Scripts {
<script>
var ITEMS=[]; var itemPickUrl='@Url.Action("ItemPickData","Inventory")';
var WH=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(invWh.Select(w=>new{iD=w.ID,code=w.Code})));
function iopts(){var o='<option value="">@Localizer["Select"]</option>';ITEMS.forEach(function(i){o+='<option value="'+i.iD+'" data-cost="'+(i.cost||0)+'" data-name="'+(i.name||'').replace(/"/g,'&quot;')+'">'+i.itemCode+' — '+i.name+'</option>';});return o;}
function wopts(){var o='<option value="">—</option>';WH.forEach(function(w){o+='<option value="'+w.iD+'">'+w.code+'</option>';});return o;}
function addRow(){var tr=document.createElement('tr');tr.innerHTML=
 '<td><select class="form-select form-select-solid it">'+iopts()+'</select></td>'+
 '<td><select class="form-select form-select-solid wh">'+wopts()+'</select></td>'+
 '<td><input type="number" step="0.01" class="form-control form-control-solid q text-end" value="1"></td>'+
 '<td><input type="number" step="0.01" class="form-control form-control-solid tax text-end" value="14"></td>'+
 '<td class="text-end est fw-bold text-muted">—</td>'+
 '<td class="text-center"><button type="button" class="btn btn-icon btn-light-danger btn-sm del"><i class="ki-outline ki-trash fs-5"></i></button></td>';
 document.getElementById('rows').appendChild(tr);cbItemSelect(tr.querySelector('.it'), itemPickUrl);}
function est(tr){var o=tr.querySelector('.it').options[tr.querySelector('.it').selectedIndex];var c=o?parseFloat(o.getAttribute('data-cost'))||0:0;var q=parseFloat(tr.querySelector('.q').value)||0;tr.querySelector('.est').textContent=(c*q).toFixed(2);}
document.getElementById('add').addEventListener('click',addRow);
document.getElementById('rows').addEventListener('input',function(e){est(e.target.closest('tr'));});
document.getElementById('rows').addEventListener('change',function(e){var tr=e.target.closest('tr');if(e.target.classList.contains('it')){var o=e.target.options[e.target.selectedIndex];var wh=tr.querySelector('.wh');if(wh&&!wh.value&&WH.length)wh.value=WH[0].iD;}est(tr);});
document.getElementById('rows').addEventListener('click',function(e){if(e.target.closest('.del')){e.target.closest('tr').remove();}});
document.getElementById('save').addEventListener('click',function(){
 var lines=[];document.querySelectorAll('#rows tr').forEach(function(tr){var it=tr.querySelector('.it').value,wh=tr.querySelector('.wh').value,q=parseFloat(tr.querySelector('.q').value)||0;
  if(it&&wh&&q>0)lines.push({itemId:parseInt(it),warehouseId:parseInt(wh),qty:q,taxRate:parseFloat(tr.querySelector('.tax').value)||0});});
 if(!lines.length){alert('@Localizer["Add at least one item line"]');return;}
 document.getElementById('linesJson').value=JSON.stringify(lines);var _f=document.getElementById('f');
 if(window.CB&&CB.submitForm){CB.submitForm(_f,{type:'@(isEdit ? "edit" : "save")'@Html.Raw(isEdit ? ",text:(window.CB?CB.L('سيتم عكس القيد الأصلي للمرتجع وإعادة ترحيله بالقيم الجديدة — هل تريد المتابعة؟','The original entry will be reversed and the return re-posted with the new values — continue?'):null)" : "")});}else{_f.submit();}});
// P3 edit prefill
var EDIT_LINES=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(editLines));
function fillRow(l){ addRow(); var tr=document.querySelector('#rows tr:last-child'); if(!tr)return;
  if(l.barcode) tr.setAttribute('data-cb-bcval', l.barcode);
  if(l.itemId){ cbItemSelectSet(tr.querySelector('.it'), {id:l.itemId, code:'', name:l.name||''}); }
  var wh=tr.querySelector('.wh'); if(wh && l.wh) wh.value=String(l.wh);
  tr.querySelector('.q').value=l.q; tr.querySelector('.tax').value=l.tax; est(tr); }
if(EDIT_LINES && EDIT_LINES.length){ EDIT_LINES.forEach(fillRow); } else { addRow(); }
</script>
}
