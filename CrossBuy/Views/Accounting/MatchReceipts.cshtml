@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var vendors = ViewBag.Vendors as IEnumerable<CrossBuy.Models.Context.Accounting.Vendor> ?? Enumerable.Empty<CrossBuy.Models.Context.Accounting.Vendor>();
    var selVendor = ViewBag.SelVendor as int?;
    var receipts = ViewBag.OpenReceipts as IEnumerable<CrossBuy.Models.Context.Inventory.GoodsReceipt> ?? Enumerable.Empty<CrossBuy.Models.Context.Inventory.GoodsReceipt>();
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Match vendor invoice to goods receipt"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Purchases"]</li></ul></div>
        <a href="@Url.Action("PurchaseInvoices","Accounting")" class="btn btn-sm btn-light">@Localizer["Purchase Invoices"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        @if (TempData["AccMsg"] != null) { <div class="alert alert-success">@TempData["AccMsg"]</div> }
        @if (TempData["AccErr"] != null) { <div class="alert alert-danger">@TempData["AccErr"]</div> }

        <div class="card card-flush mb-5"><div class="card-body py-5">
            <form method="get" action="@Url.Action("MatchReceipts","Accounting")" class="row g-4 align-items-end">
                <div class="col-md-8"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Vendor"]</label>
                    <select name="vendorId" class="form-select form-select-solid" onchange="this.form.submit()">
                        <option value="">@Localizer["Choose a vendor…"]</option>
                        @foreach (var v in vendors)
                        { <option value="@v.ID" selected="@(selVendor == v.ID)">@v.Name</option> }
                    </select></div>
                <div class="col-md-4"><button type="submit" class="btn btn-primary w-100">@Localizer["Show open receipts"]</button></div>
            </form>
        </div></div>

        @if (selVendor != null)
        {
            <div class="card"><div class="card-header border-0 pt-6"><div class="card-title">
                <h3 class="fw-bold m-0">@Localizer["Open goods receipts (posted, not yet invoiced)"]</h3></div></div>
                <div class="card-body pt-2">
                @if (!receipts.Any())
                {
                    <div class="text-muted fs-6 py-5 text-center">@Localizer["No open goods receipts for this vendor. A receipt that is already invoiced will not appear here."]</div>
                }
                else
                {
                    <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-4 mb-5">
                        <span class="fs-8 text-gray-700">@Localizer["The invoice clears GRNI at the received value (Dr GRNI / Cr AP), with no second stock movement. Price/tax variance is not supported — an amount different from the received value is rejected."]</span></div>
                    <div class="d-flex fw-bold fs-8 text-uppercase text-muted px-4 pb-2" style="border-bottom:2px solid #13433a;">
                        <div class="flex-grow-1">@Localizer["Receipt No"]</div><div style="width:120px;">@SR["Date"]</div>
                        <div style="width:140px;" class="text-end">@Localizer["Received value"]</div><div style="width:160px;" class="ps-4">@Localizer["Invoice date"]</div>
                        <div style="width:160px;" class="text-end">@Localizer["Invoice amount"]</div><div style="width:130px;" class="text-center">@SR["Action"]</div></div>
                    @foreach (var g in receipts)
                    {
                        <form method="post" action="@Url.Action("CreateInvoiceFromReceipt","Accounting")" class="d-flex align-items-center px-4 py-3" style="border-bottom:1px solid #eff2f5; font-variant-numeric:tabular-nums;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="goodsReceiptId" value="@g.ID" />
                            <div class="flex-grow-1 fw-bold">@g.ReceiptNo</div>
                            <div style="width:120px;">@g.ReceiptDate.ToString("yyyy-MM-dd")</div>
                            <div style="width:140px;" class="text-end fw-bold">@g.TotalCost.ToString("N2")</div>
                            <div style="width:160px;" class="ps-4"><input type="date" name="invoiceDate" value="@today" class="form-control form-control-sm form-control-solid" required /></div>
                            <div style="width:160px;"><input type="number" step="0.001" name="invoiceAmount" value="@g.TotalCost.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm form-control-solid text-end" required /></div>
                            <div style="width:130px;" class="text-center"><button type="submit" class="btn btn-sm btn-primary">@Localizer["Match & post"]</button></div>
                        </form>
                    }
                }
                </div>
            </div>
        }
    </div></div>
</div>
