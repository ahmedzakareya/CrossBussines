@using CrossBuy.BL
@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<AssetCategory>
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var accounts = ViewBag.Accounts as List<AccountNode> ?? new();
    var assetAccs = accounts.Where(a => a.Code.StartsWith("12")).ToList();
    var expAccs = accounts.Where(a => a.TypeCode == "EXP").ToList();
    var byId = accounts.ToDictionary(a => a.Id, a => a);
    string AccName(int id) => byId.TryGetValue(id, out var a) ? a.Code + " — " + (isAr ? a.Name : DisplayName.Or(a.NameEn, a.Name)) : "—";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Asset Categories"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Asset Categories"]</li></ul></div>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#mNew"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New category"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><div class="d-flex align-items-center position-relative my-1">
                <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                <input type="text" id="s" class="form-control form-control-solid w-300px ps-12" placeholder="@SR["Search"]" autocomplete="off" />
            </div></div></div>
            <div class="card-body pt-0 pb-4"><div class="table-responsive"><table class="table table-row-dashed align-middle gy-4 mb-0" id="t" style="font-variant-numeric:tabular-nums;">
                <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th>@Localizer["Category"]</th><th class="text-center">@Localizer["Default life"]</th><th>@Localizer["Cost account"]</th><th>@Localizer["Accum. dep."]</th><th>@Localizer["Dep. expense"]</th></tr></thead>
                <tbody>
                @foreach (var c in Model) {
                    <tr class="r" data-s="@c.Name @c.NameEn">
                        <td class="fw-bold text-gray-900">@(isAr ? c.Name : (c.NameEn ?? c.Name))</td>
                        <td class="text-center"><span class="badge fw-bold" style="background:#E7F0FF;color:#145DBF;">@c.DefaultUsefulLifeMonths @Localizer["mo"]</span></td>
                        <td class="text-muted">@AccName(c.CostAccountId)</td>
                        <td class="text-muted">@AccName(c.AccumDepAccountId)</td>
                        <td class="text-muted">@AccName(c.DepExpenseAccountId)</td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-10">@Localizer["No categories"]</td></tr> }
                </tbody>
            </table></div></div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="mNew" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="CreateAssetCategory" method="post">@Html.AntiForgeryToken()
        <div class="modal-header"><h2 class="fw-bold">@Localizer["New asset category"]</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <div class="row"><div class="col-7 mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Name (AR)"]</label><input name="name" class="form-control form-control-solid" required /></div>
            <div class="col-5 mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Life (months)"]</label><input name="defaultUsefulLifeMonths" type="number" value="60" class="form-control form-control-solid" required /></div></div>
            <div class="mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Name (EN)"]</label><input name="nameEn" class="form-control form-control-solid" /></div>
            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Cost account"]</label><select name="costAccountId" class="form-select form-select-solid" required>@foreach (var a in assetAccs) { <option value="@a.Id">@a.Code — @(isAr ? a.Name : DisplayName.Or(a.NameEn, a.Name))</option> }</select></div>
            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Accum. depreciation"]</label><select name="accumDepAccountId" class="form-select form-select-solid" required>@foreach (var a in assetAccs) { <option value="@a.Id">@a.Code — @(isAr ? a.Name : DisplayName.Or(a.NameEn, a.Name))</option> }</select></div>
            <div class="mb-2"><label class="required fw-semibold fs-6 mb-2">@Localizer["Depreciation expense"]</label><select name="depExpenseAccountId" class="form-select form-select-solid" required>@foreach (var a in expAccs) { <option value="@a.Id">@a.Code — @(isAr ? a.Name : DisplayName.Or(a.NameEn, a.Name))</option> }</select></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@SR["Save"]</button></div>
    </form>
</div></div></div>
