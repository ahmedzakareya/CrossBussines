@using CrossBuy.BL
@model List<CostCenterNode>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
}

@functions {
    void RenderRows(List<CostCenterNode> nodes, bool isAr)
    {
        foreach (var n in nodes)
        {
            var pad = 14 + n.Level * 24;
            var hasChildren = n.Children.Count > 0;
            <tr class="cc-row" data-id="@n.Id" data-parent="@(n.ParentId?.ToString() ?? "")"
                data-search="@(n.Code) @(n.Name) @(n.NameEn)">
                <td>
                    <div style="padding-inline-start:@(2 + n.Level * 22)px" class="d-flex align-items-center">
                        @if (hasChildren)
                        {
                            <i class="ki-outline ki-down fs-7 text-gray-600 me-2 cc-toggle" style="cursor:pointer"></i>
                        }
                        else
                        {
                            <span class="me-2" style="width:13px;display:inline-block"></span>
                        }
                        <span class="badge fs-8 fw-bold" style="background:#E7F0FF;color:#0E4A9E;">@n.Code</span>
                    </div>
                </td>
                <td><i class="ki-outline ki-abstract-26 fs-6 text-primary me-2"></i><span class="fw-semibold text-gray-800">@(isAr ? n.Name : DisplayName.Or(n.NameEn, n.Name))</span></td>
                <td class="text-center">
                    @if (n.SourceHierarchicalId.HasValue)
                    {
                        <span class="badge badge-light-primary fw-bold" title="@Localizer["Linked to org tree"]"><i class="ki-outline ki-abstract-44 fs-7 me-1"></i>@Localizer["Org node"]</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td class="text-center">
                    @if (n.IsActive) { <span class="badge badge-light-primary fw-bold">@SR["Active"]</span> } else { <span class="badge fw-bold" style="background:#f1f3f7;color:#7e8299;">@SR["Inactive"]</span> }
                </td>
            </tr>
            if (hasChildren) { RenderRows(n.Children, isAr); }
        }
    }
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Cost Centers"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@Localizer["Cost Centers"]</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            <div class="card">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <div class="d-flex align-items-center position-relative my-1">
                            <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                            <input type="text" id="ccSearch" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search by code or name..."]" autocomplete="off" />
                        </div>
                    </div>
                    <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-light-primary me-2" id="ccExpand"><i class="ki-outline ki-plus-square fs-4"></i>@Localizer["Expand all"]</button>
                        <button type="button" class="btn btn-sm btn-light" id="ccCollapse"><i class="ki-outline ki-minus-square fs-4"></i>@Localizer["Collapse all"]</button>
                    </div>
                </div>
                <div class="card-body pt-0 pb-4">
                    @if (Model == null || Model.Count == 0)
                    {
                        <div class="text-center py-15">
                            <i class="ki-outline ki-abstract-26 fs-3x text-muted mb-4"></i>
                            <div class="fw-semibold text-muted">@Localizer["No cost centers. They are derived from branches/departments in the org tree."]</div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-row-dashed align-middle gy-3 mb-0" id="ccTable">
                                <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                    <tr style="border-bottom:2px solid #0E4A9E;">
                                        <th style="width:140px">@SR["Code"]</th>
                                        <th>@Localizer["Cost Center"]</th>
                                        <th class="text-center" style="width:140px">@Localizer["Source"]</th>
                                        <th class="text-center" style="width:110px">@SR["Status"]</th>
                                    </tr>
                                </thead>
                                <tbody>@{ RenderRows(Model, isAr); }</tbody>
                            </table>
                        </div>
                        <div id="ccNoResult" class="text-center py-10 text-muted d-none">@Localizer["No matching results"]</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var rows = Array.prototype.slice.call(document.querySelectorAll('#ccTable tbody tr.cc-row'));
            if (!rows.length) return;
            var byParent = {};
            rows.forEach(function (r) { var p = r.getAttribute('data-parent') || ''; (byParent[p] = byParent[p] || []).push(r); });
            var collapsed = {};
            function hasKids(id) { return !!byParent[id]; }
            function setIcon(r, c) { var ic = r.querySelector('.cc-toggle'); if (ic) { ic.classList.toggle('ki-down', !c); ic.classList.toggle('ki-right', c); } }
            function refresh() {
                rows.forEach(function (r) {
                    var cur = r.getAttribute('data-parent') || '', vis = true;
                    while (cur) { if (collapsed[cur]) { vis = false; break; } var pr = document.querySelector('#ccTable tr[data-id="' + cur + '"]'); cur = pr ? (pr.getAttribute('data-parent') || '') : ''; }
                    r.style.display = vis ? '' : 'none'; setIcon(r, !!collapsed[r.getAttribute('data-id')]);
                });
            }
            document.querySelector('#ccTable tbody').addEventListener('click', function (e) {
                var ic = e.target.closest('.cc-toggle'); if (!ic) return;
                var id = ic.closest('tr').getAttribute('data-id'); collapsed[id] = !collapsed[id]; refresh();
            });
            document.getElementById('ccExpand').addEventListener('click', function () { collapsed = {}; refresh(); });
            document.getElementById('ccCollapse').addEventListener('click', function () { collapsed = {}; rows.forEach(function (r) { if (hasKids(r.getAttribute('data-id'))) collapsed[r.getAttribute('data-id')] = true; }); refresh(); });
            var noRes = document.getElementById('ccNoResult');
            document.getElementById('ccSearch').addEventListener('input', function (e) {
                var q = (e.target.value || '').trim().toLowerCase();
                if (!q) { noRes.classList.add('d-none'); refresh(); return; }
                var show = {}, any = false;
                rows.forEach(function (r) {
                    if ((r.getAttribute('data-search') || '').toLowerCase().indexOf(q) !== -1) {
                        any = true; show[r.getAttribute('data-id')] = true;
                        var pid = r.getAttribute('data-parent') || '';
                        while (pid) { show[pid] = true; var pr = document.querySelector('#ccTable tr[data-id="' + pid + '"]'); pid = pr ? (pr.getAttribute('data-parent') || '') : ''; }
                    }
                });
                rows.forEach(function (r) { r.style.display = show[r.getAttribute('data-id')] ? '' : 'none'; });
                noRes.classList.toggle('d-none', any);
            });
            refresh();
        })();
    </script>
}
