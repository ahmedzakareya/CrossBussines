@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var employees = ViewBag.Employees as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var assignments = ViewBag.Assignments as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var roles = new (string v, string ar, string en)[] {
        ("ChiefAccountant","رئيس حسابات","Chief Accountant"),
        ("Accountant","محاسب","Accountant"),
        ("Cashier","أمين صندوق","Cashier"),
        ("Auditor","مدقّق (قراءة)","Auditor (read)"),
    };
    string roleName(string r) => roles.FirstOrDefault(x => x.v == r) is var m && m.v != null ? m.en : r;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Accounting roles"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted text-hover-primary">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Roles"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row">
            <div class="col-lg-5">
                <div class="card card-flush mb-5">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Assign role"]</h2></div></div>
                    <div class="card-body pt-2">
                        <form asp-action="AssignAccRole" method="post">@Html.AntiForgeryToken()
                            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@SR["Employee"]</label>
                                <select name="employeeId" class="form-select form-select-solid" data-control="select2" required><option value="">@Localizer["Select"]</option>@foreach (var e in employees) { <option value="@e.ID">@CrossBuy.BL.EmployeeNames.Of(e.FullName, e.FullNameEn)</option> }</select></div>
                            <div class="mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Role"]</label>
                                <select name="role" class="form-select form-select-solid" data-control="select2" data-hide-search="true" required>@foreach (var r in roles) { <option value="@r.v">@Localizer[r.en]</option> }</select></div>
                            <button type="submit" class="btn btn-primary w-100"><i class="ki-outline ki-plus fs-3"></i>@Localizer["Assign"]</button>
                        </form>
                    </div>
                </div>
                <div class="card card-flush mb-5">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Approval threshold"]</h2></div></div>
                    <div class="card-body pt-2">
                        <form asp-action="SaveAccSettings" method="post">@Html.AntiForgeryToken()
                            <label class="fw-semibold fs-6 mb-2">@Localizer["Threshold (EGP)"]</label>
                            <input name="approvalThreshold" type="number" step="0.01" min="0" class="form-control form-control-solid mb-3" value="@(((decimal)(ViewBag.Threshold ?? 0m)).ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                            <div class="text-muted fs-8 mb-3">@Localizer["Journals/payments at or above this amount need ChiefAccountant approval (and SoD: a creator can't approve own). 0 = off."]</div>
                            <button class="btn btn-light-primary w-100">@Localizer["Save threshold"]</button>
                        </form>
                    </div>
                </div>
                <div class="card card-flush"><div class="card-body py-5">
                    <div class="text-gray-700 fw-semibold fs-7">
                        <div class="mb-2"><span class="badge badge-light-primary me-2">@Localizer["Chief"]</span>@Localizer["Full access incl. period close, large-entry approval & roles."]</div>
                        <div class="mb-2"><span class="badge badge-light-primary me-2">@Localizer["Accountant"]</span>@Localizer["Post journals & invoices + receipts/payments."]</div>
                        <div class="mb-2"><span class="badge badge-light-secondary me-2">@Localizer["Cashier"]</span>@Localizer["Receipts, payments & cash transfers only."]</div>
                        <div><span class="badge badge-light-dark me-2">@Localizer["Auditor"]</span>@Localizer["Read-only."]</div>
                    </div>
                </div></div>
            </div>
            <div class="col-lg-7">
                <div class="card card-flush">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Assigned roles"]</h2></div></div>
                    <div class="card-body pt-2">
                        <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3">
                            <thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;"><th>@SR["Employee"]</th><th>@Localizer["Role"]</th><th class="text-end"></th></tr></thead>
                            <tbody class="fw-semibold text-gray-700">
                            @foreach (var a in assignments)
                            {
                                <tr>
                                    <td class="fw-bold text-gray-800">@a.EmployeeName</td>
                                    <td><span class="badge badge-light-primary">@Localizer[roleName((string)a.Role)]</span></td>
                                    <td class="text-end"><form asp-action="RemoveAccRole" method="post" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Remove role?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.ID" /><button class="btn btn-icon btn-light-danger btn-sm"><i class="ki-outline ki-trash fs-6"></i></button></form></td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                        @if (!assignments.Any()) { <div class="text-center text-muted py-10">@Localizer["No roles assigned — accounting is open until the first role is set."]</div> }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
