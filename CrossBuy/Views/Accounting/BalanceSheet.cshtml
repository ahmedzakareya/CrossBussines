@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model BalanceSheet
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var asOf = (DateTime)ViewBag.AsOf;
    var totalEquity = Model.Equity.Total + Model.NetProfit;
    var bsDiff = Model.TotalAssets - Model.TotalLiabAndEquity;
}
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Balance Sheet"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted text-hover-primary">@SR["Accounting"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Balance Sheet"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <form method="get" class="d-flex align-items-center gap-2">
                <div class="position-relative d-flex align-items-center">
                    <i class="ki-outline ki-calendar-8 fs-3 position-absolute ms-4"></i>
                    <input type="date" name="asOf" value="@asOf.ToString("yyyy-MM-dd")" class="form-control form-control-solid form-control-sm w-175px ps-11" />
                </div>
                <button class="btn btn-sm btn-primary">@SR["Show"]</button>
            </form>
            <button onclick="window.print()" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-printer fs-4"></i>@SR["Print"]</button>
        </div>
    </div></div>
    <!--end::Toolbar-->
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Financial position card-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body py-10">
                <h2 class="mb-2">@Localizer["Balance Sheet"]</h2>
                <p class="fs-6 fw-semibold text-gray-600 py-1 m-0">@Localizer["As of"] @asOf.ToString("yyyy/MM/dd")</p>

                @{ string Raw(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture); }
                <!--begin::Stats (card-dashed + countup)-->
                <div class="row mt-6">
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-info pb-1 px-2">@Localizer["Total Assets"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.TotalAssets)" data-kt-countup-decimal-places="2">@Model.TotalAssets.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-danger pb-1 px-2">@Localizer["Total Liabilities"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.Liabilities.Total)" data-kt-countup-decimal-places="2">@Model.Liabilities.Total.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-success pb-1 px-2">@Localizer["Total Equity"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(totalEquity)" data-kt-countup-decimal-places="2">@totalEquity.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold @(Model.NetProfit>=0?"text-primary":"text-danger") pb-1 px-2">@Localizer["Period result"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.NetProfit)" data-kt-countup-decimal-places="2">@Model.NetProfit.ToString("N2")</span>
                        </div>
                    </div>
                </div>
                <!--end::Stats-->

                <!--begin::Notice (balanced state)-->
                @if (Model.IsBalanced)
                {
                    <div class="notice d-flex rounded border border-dashed p-6 mt-4" style="background:#E7F0FF;border-color:#0E4A9E !important;">
                        <span class="symbol symbol-45px me-5"><span class="symbol-label" style="background:#0E4A9E;"><i class="ki-outline ki-shield-tick fs-2x text-white"></i></span></span>
                        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                                <h4 class="text-gray-900 fw-bold mb-1">@SR["The balance sheet is balanced"]</h4>
                                <div class="fs-6 text-gray-700">@SR["Balance sheet balanced detail"]</div>
                            </div>
                            <span class="badge fs-7 fw-bold px-4 py-2 flex-shrink-0" style="background:#0E4A9E;color:#fff;"><i class="ki-outline ki-check fs-6 text-white me-1"></i>@SR["Matched"]</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mt-4">
                        <span class="symbol symbol-45px me-5"><span class="symbol-label bg-danger"><i class="ki-outline ki-information-5 fs-2x text-white"></i></span></span>
                        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                                <h4 class="text-gray-900 fw-bold mb-1">@SR["The balance sheet is not balanced"]</h4>
                                <div class="fs-6 text-gray-700">@SR["Balance sheet not balanced detail"]</div>
                            </div>
                            <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0">@SR["Difference"]: @bsDiff.ToString("N2")</span>
                        </div>
                    </div>
                }
                <!--end::Notice-->
            </div>
        </div>
        <!--end::Financial position card-->

        <div class="row g-5 g-xl-10">
            <!--begin::Assets-->
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header card-header-stretch">
                        <div class="card-title"><h3>@Localizer["Assets"]</h3></div>
                    </div>
                    <div class="card-body px-0 pt-0 pb-4">
                        <div class="table-responsive">
                            <table class="table table-row-dashed align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                                <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th class="ps-9">@SR["Account"]</th><th class="text-end pe-9">@SR["Amount"]</th></tr></thead>
                                <tbody class="fs-6 fw-semibold text-gray-700">
                                    @foreach (var l in Model.Assets.Lines)
                                    {
                                        <tr>
                                            <td class="ps-9"><span class="badge fs-8 fw-bold me-2" style="background:#E7F0FF;color:#145DBF;">@l.Code</span>@(isAr ? l.NameAr : DisplayName.Or(l.NameEn, l.NameAr))</td>
                                            <td class="text-end pe-9 text-gray-900 fw-bold">@l.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    @if (Model.Assets.Lines.Count == 0) { <tr><td class="ps-9 text-muted">&mdash;</td><td class="text-end pe-9 text-muted">0.00</td></tr> }
                                    <tr style="background:#E7F0FF;"><td class="ps-9 fw-bold fs-5" style="color:#145DBF;">@Localizer["Total Assets"]</td><td class="text-end pe-9 fw-bolder fs-4" style="color:#0E4A9E;">@Model.TotalAssets.ToString("N2")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Assets-->
            <!--begin::Liabilities & Equity-->
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header card-header-stretch">
                        <div class="card-title"><h3>@Localizer["Liabilities"] &amp; @Localizer["Equity"]</h3></div>
                    </div>
                    <div class="card-body px-0 pt-0 pb-4">
                        <div class="table-responsive">
                            <table class="table table-row-dashed align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                                <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th class="ps-9">@SR["Account"]</th><th class="text-end pe-9">@SR["Amount"]</th></tr></thead>
                                <tbody class="fs-6 fw-semibold text-gray-700">
                                    <tr><td colspan="2" class="ps-9 py-3 fw-bold text-gray-800 fs-6" style="background:#f4f6f8;">@Localizer["Liabilities"]</td></tr>
                                    @foreach (var l in Model.Liabilities.Lines)
                                    {
                                        <tr>
                                            <td class="ps-9"><span class="badge fs-8 fw-bold me-2" style="background:#E7F0FF;color:#145DBF;">@l.Code</span>@(isAr ? l.NameAr : DisplayName.Or(l.NameEn, l.NameAr))</td>
                                            <td class="text-end pe-9 text-gray-900 fw-bold">@l.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr style="border-top:1px solid #e9edf2;"><td class="ps-9 fw-bold text-gray-600">@Localizer["Total Liabilities"]</td><td class="text-end pe-9 fw-bold text-gray-800">@Model.Liabilities.Total.ToString("N2")</td></tr>

                                    <tr><td colspan="2" class="ps-9 py-3 fw-bold text-gray-800 fs-6" style="background:#f4f6f8;">@Localizer["Equity"]</td></tr>
                                    @foreach (var l in Model.Equity.Lines)
                                    {
                                        <tr>
                                            <td class="ps-9"><span class="badge fs-8 fw-bold me-2" style="background:#E7F0FF;color:#145DBF;">@l.Code</span>@(isAr ? l.NameAr : DisplayName.Or(l.NameEn, l.NameAr))</td>
                                            <td class="text-end pe-9 text-gray-900 fw-bold">@l.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr><td class="ps-9">@Localizer["Period result"]</td><td class="text-end pe-9 fw-bold @(Model.NetProfit>=0?"text-success":"text-danger")">@Model.NetProfit.ToString("N2")</td></tr>
                                    <tr style="border-top:1px solid #e9edf2;"><td class="ps-9 fw-bold text-gray-600">@Localizer["Total Equity"]</td><td class="text-end pe-9 fw-bold text-gray-800">@totalEquity.ToString("N2")</td></tr>

                                    <tr style="background:#E7F0FF;"><td class="ps-9 fw-bold fs-5" style="color:#145DBF;">@Localizer["Total Liab. & Equity"]</td><td class="text-end pe-9 fw-bolder fs-4" style="color:#0E4A9E;">@Model.TotalLiabAndEquity.ToString("N2")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Liabilities & Equity-->
        </div>
    </div></div>
</div>
