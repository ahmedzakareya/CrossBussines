@using CrossBuy.Models.Context.Accounting
@model List<VatReturn>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["VAT Returns"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["VAT Returns"]</li></ul></div>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#mNew"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New return"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><div class="d-flex align-items-center position-relative my-1">
                <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                <input type="text" id="s" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search..."]" autocomplete="off" />
            </div></div></div>
            <div class="card-body pt-0 pb-4"><div class="table-responsive"><table class="table table-row-dashed align-middle gy-4 mb-0" id="t" style="font-variant-numeric:tabular-nums;">
                <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th>@Localizer["Period"]</th><th class="text-end">@Localizer["Output VAT"]</th><th class="text-end">@Localizer["Input VAT"]</th><th class="text-end">@Localizer["Net due"]</th><th class="text-center">@SR["Status"]</th><th class="text-center">@Localizer["Open"]</th></tr></thead>
                <tbody>
                @foreach (var r in Model) {
                    <tr class="r" data-s="@r.PeriodStart.ToString("yyyy/MM/dd") @r.PeriodEnd.ToString("yyyy/MM/dd")">
                        <td class="fw-bold text-gray-900">@r.PeriodStart.ToString("yyyy/MM/dd") — @r.PeriodEnd.ToString("yyyy/MM/dd")</td>
                        <td class="text-end fw-bold text-gray-900">@r.OutputVat.ToString("N2")</td>
                        <td class="text-end text-muted">@r.InputVat.ToString("N2")</td>
                        <td class="text-end fw-bold @(r.NetDue>=0?"text-danger":"text-primary")">@r.NetDue.ToString("N2")</td>
                        <td class="text-center">@if (r.Status=="Settled") { <span class="badge badge-light-primary fw-bold">@Localizer["Settled"]</span> } else { <span class="badge fw-bold" style="background:#f1f3f7;color:#7e8299;">@Localizer["Filed"]</span> }</td>
                        <td class="text-center"><a href="@Url.Action("VatReturnDetail","Accounting", new { id = r.ID })" class="btn btn-sm btn-icon btn-light-primary" title="@Localizer["Open"]"><i class="ki-outline ki-eye fs-6"></i></a></td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10">@Localizer["No returns"]</td></tr> }
                </tbody>
            </table></div></div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="mNew" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="FileVatReturn" method="post">@Html.AntiForgeryToken()
        <div class="modal-header"><h2 class="fw-bold">@Localizer["New VAT return"]</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <div class="alert alert-light-primary fs-7">@Localizer["Output and input VAT are computed from movement on the VAT accounts during the period."]</div>
            <div class="row"><div class="col-6 mb-2"><label class="required fw-semibold fs-6 mb-2">@Localizer["Period start"]</label><input name="periodStart" type="date" class="form-control form-control-solid" value="2026-01-01" required /></div>
            <div class="col-6 mb-2"><label class="required fw-semibold fs-6 mb-2">@Localizer["Period end"]</label><input name="periodEnd" type="date" class="form-control form-control-solid" value="2026-06-30" required /></div></div>
            <div class="mt-4"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" /></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@Localizer["File return"]</button></div>
    </form>
</div></div></div>

@section Scripts { <script>(function(){var i=document.getElementById('s');var rows=[].slice.call(document.querySelectorAll('#t tbody tr.r'));i.addEventListener('input',function(e){var q=(e.target.value||'').trim().toLowerCase();rows.forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});})();</script> }
