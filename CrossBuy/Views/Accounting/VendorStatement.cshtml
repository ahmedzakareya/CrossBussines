@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var ven = ViewBag.Vendor as Vendor;
    var invoices = ViewBag.Invoices as List<PurchaseInvoice> ?? new();
    var payments = ViewBag.Payments as List<Payment> ?? new();
    // vendor balance is a credit balance: invoice = credit (+ payable), payment = debit (− payable)
    var rows = new List<(DateTime Date, string Doc, string Desc, decimal Debit, decimal Credit)>();
    foreach (var i in invoices) rows.Add((i.InvoiceDate, i.InvoiceNo ?? "", Localizer["Purchase invoice"].Value, 0, i.GrandTotal));
    foreach (var p in payments) rows.Add((p.PaymentDate, p.PaymentNo ?? "", Localizer["Payment"].Value, p.Amount, 0));
    rows = rows.OrderBy(x => x.Date).ThenBy(x => x.Doc).ToList();
    decimal bal = 0;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Vendor Statement"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Vendors","Accounting")" class="text-muted">@Localizer["Vendors"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@(ven == null ? "" : (isAr ? ven.Name : (ven.NameEn ?? ven.Name)))</li></ul></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Vendors","Accounting")" class="btn btn-sm btn-light">@SR["Back"]</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card"><div class="card-header pt-6 align-items-center">
            <h3 class="card-title fw-bold">@(ven == null ? "" : (isAr ? ven.Name : (ven.NameEn ?? ven.Name)))</h3>
            <div class="card-toolbar"><div class="position-relative"><i class="ki-outline ki-magnifier fs-4 position-absolute ms-3 mt-3 text-muted"></i><input type="text" class="form-control form-control-solid form-control-sm w-250px ps-10" placeholder="@SR["Search"]" autocomplete="off" /></div></div>
        </div>
        <div class="card-body">
            <div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@SR["Date"]</th><th>@Localizer["Document"]</th><th>@SR["Description"]</th><th class="text-end">@SR["Debit"]</th><th class="text-end">@SR["Credit"]</th><th class="text-end pe-4">@SR["Balance"]</th></tr></thead>
                <tbody>
                @if (rows.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10">@Localizer["No movements"]</td></tr> }
                @foreach (var r in rows)
                {
                    bal += r.Credit - r.Debit;
                    <tr data-s="@r.Date.ToString("yyyy/MM/dd") @r.Doc @r.Desc" style="border-bottom:1px dashed #eef1f6;">
                        <td class="ps-4 text-muted">@r.Date.ToString("yyyy/MM/dd")</td>
                        <td class="fw-bold text-gray-800">@r.Doc</td>
                        <td class="text-muted">@r.Desc</td>
                        <td class="text-end @(r.Debit>0?"fw-bold text-gray-900":"text-gray-300")">@(r.Debit>0?r.Debit.ToString("N2"):"—")</td>
                        <td class="text-end @(r.Credit>0?"fw-bold text-gray-900":"text-gray-300")">@(r.Credit>0?r.Credit.ToString("N2"):"—")</td>
                        <td class="text-end fw-bold pe-4">@bal.ToString("N2")</td>
                    </tr>
                }
                </tbody>
                <tfoot><tr class="fw-bolder fs-5" style="background:#E7F0FF;border-top:2px solid #0E4A9E;"><td colspan="5" class="text-end ps-4" style="color:#145DBF;">@Localizer["Outstanding balance"]</td><td class="text-end pe-4" style="color:@(bal>0?"#d92d20":"#0E4A9E");">@bal.ToString("N2")</td></tr></tfoot>
            </table></div>
        </div></div>
    </div></div>
</div>
