@using CrossBuy.Models.Context.Accounting
@model CrossBuy.Controllers.AccountingController.PartyStatementModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var vend = ViewBag.Vendor as Vendor;

    // THE TRIAL BALANCE IS THE HOUSE IDENTITY for an accounting screen, and this one wears it exactly:
    // a summary card holding the title, the period, dashed KPI tiles and a notice banner; then a data
    // card whose header carries the count and the controls; then `table align-middle gy-4 mb-0` with
    // tabular numerals, a 2px #0E4A9E rule under the head, dashed row separators, a #E7F0FF/#145DBF
    // badge for the document, a hairline before the figures, and the #E7F0FF totals band.
    // Every value below was read off /Accounting/TrialBalance rather than approximated.
    var settled = Model.Closing == 0;

    // A PAYABLE READS AS A CREDIT — the mirror of the customer statement. Every balance is shown as
    // what WE owe, so a positive figure is a debt of ours rather than an asset.
    var owedLabel = Localizer["Owed to the vendor"].Value;
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@SR["Account statement"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Vendors","Accounting")" class="text-muted">@Localizer["Vendors"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@Model.PartyName</li>
                </ul>
            </div>
            <div class="d-flex gap-2 d-print-none">
                <a href="@Url.Action("VendorStatement","Accounting")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-people fs-3"></i>@Localizer["Another party"]</a>
                <a href="@Url.Action("Vendors","Accounting")" class="btn btn-sm btn-light">@SR["Back"]</a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Summary card-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body py-10">
                <h2 class="mb-2">@Model.PartyName</h2>
                <p class="fs-6 fw-semibold text-gray-600 py-1 m-0">
                    @if (Model.From.HasValue || Model.To.HasValue)
                    {
                        <span>@SR["From"] @(Model.From?.ToString("yyyy/MM/dd") ?? "—") &mdash; @SR["To"] @(Model.To?.ToString("yyyy/MM/dd") ?? "—")</span>
                    }
                    else
                    {
                        <span>@Localizer["Whole history"]</span>
                    }
                </p>
                @{ string Raw(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture); }
                <div class="row mt-6">
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-gray-600 pb-1 px-2">@SR["Opening balance"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(-Model.Opening)" data-kt-countup-decimal-places="2">@((-Model.Opening).ToString("N2"))</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-info pb-1 px-2">@SR["Debit"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.TotalDebit)" data-kt-countup-decimal-places="2">@Model.TotalDebit.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-primary pb-1 px-2">@SR["Credit"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.TotalCredit)" data-kt-countup-decimal-places="2">@Model.TotalCredit.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold @(settled ? "text-success" : "text-danger") pb-1 px-2">@SR["Closing balance"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(-Model.Closing)" data-kt-countup-decimal-places="2">@((-Model.Closing).ToString("N2"))</span>
                        </div>
                    </div>
                </div>

                @* The banner says what the closing figure MEANS. The trial balance uses the same shape to
                   answer "is it balanced"; the question here is "does this party owe anything". *@
                @if (settled)
                {
                    <div class="notice d-flex rounded border border-dashed p-6 mt-4" style="background:#E7F0FF;border-color:#0E4A9E !important;">
                        <span class="symbol symbol-45px me-5"><span class="symbol-label" style="background:#0E4A9E;"><i class="ki-outline ki-shield-tick fs-2x text-white"></i></span></span>
                        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                                <h4 class="text-gray-900 fw-bold mb-1">@Localizer["The account is settled"]</h4>
                                <div class="fs-6 text-gray-700">@Localizer["Every movement in this period is matched: nothing is outstanding on this account."]</div>
                            </div>
                            <span class="badge fs-7 fw-bold px-4 py-2 flex-shrink-0" style="background:#0E4A9E;color:#fff;"><i class="ki-outline ki-check fs-6 text-white me-1"></i>@SR["Matched"]</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="notice d-flex rounded border border-dashed p-6 mt-4" style="background:#E7F0FF;border-color:#0E4A9E !important;">
                        <span class="symbol symbol-45px me-5"><span class="symbol-label" style="background:#0E4A9E;"><i class="ki-outline ki-information-5 fs-2x text-white"></i></span></span>
                        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                                <h4 class="text-gray-900 fw-bold mb-1">@owedLabel</h4>
                                <div class="fs-6 text-gray-700">@Localizer["This is the balance after every posted document in the period. Open the documents below to see what makes it up."]</div>
                            </div>
                            <span class="badge fs-7 fw-bold px-4 py-2 flex-shrink-0" style="background:#0E4A9E;color:#fff;">@((-Model.Closing).ToString("N2"))</span>
                        </div>
                    </div>
                }
            </div>
        </div>
        <!--end::Summary card-->

        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title"><span class="text-muted fs-7">@Localizer["Movements"]: @Model.TotalRows.ToString("N0")</span></div>
                <div class="card-toolbar">
                    <form method="get" class="d-flex flex-wrap align-items-end gap-3 d-print-none">
                        <input type="hidden" name="id" value="@Model.PartyId" />
                        <div>
                            <label class="fw-semibold fs-8 text-muted mb-1 d-block">@SR["From"]</label>
                            <input type="date" name="from" class="form-control form-control-sm form-control-solid w-140px" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <label class="fw-semibold fs-8 text-muted mb-1 d-block">@SR["To"]</label>
                            <input type="date" name="to" class="form-control form-control-sm form-control-solid w-140px" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <label class="fw-semibold fs-8 text-muted mb-1 d-block">@Localizer["Rows"]</label>
                            <select name="pageSize" class="form-select form-select-sm form-select-solid w-100px">
                                @foreach (var n in new[] { 25, 50, 100, 200 })
                                {
                                    <option value="@n" selected="@(Model.PageSize == n)">@n</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-sm btn-primary"><i class="ki-outline ki-filter fs-4"></i>@SR["Apply"]</button>
                        <a href="@Url.Action("VendorStatement","Accounting", new { id = Model.PartyId })" class="btn btn-sm btn-light"><i class="ki-outline ki-arrows-circle fs-4"></i>@SR["Reset"]</a>
                    </form>
                </div>
            </div>

            <div class="card-body pt-0 pb-5">
                <div class="table-responsive">
                    <table class="table align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                        <thead>
                            <tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                <th class="ps-4" style="width:120px;">@SR["Date"]</th>
                                <th style="width:150px;">@Localizer["Movement"]</th>
                                <th style="width:160px;">@Localizer["Document"]</th>
                                <th>@SR["Notes"]</th>
                                <th class="text-end" style="width:150px;border-inline-start:1px solid #e4e6ef;">@SR["Debit"]</th>
                                <th class="text-end" style="width:150px;">@SR["Credit"]</th>
                                <th class="text-end pe-4" style="width:160px;">@SR["Balance"]</th>
                            </tr>
                        </thead>
                        <tbody class="fs-6">
                            @* The first row says what this page starts from: the period's opening on page one,
                               the previous page's closing after it. Without it the balance column on page two
                               begins at a number with no visible origin. *@
                            <tr class="tb-row" style="border-bottom:1px dashed #eef1f6;background:#F9F9F9;">
                                <td class="ps-4 text-muted">@(Model.From?.ToString("yyyy/MM/dd") ?? "—")</td>
                                <td colspan="3" class="fw-bold text-gray-700">@(Model.Page > 1 ? Localizer["Carried forward"].Value : SR["Opening balance"].Value)</td>
                                <td class="text-end text-gray-300" style="border-inline-start:1px solid #eff2f5;">—</td>
                                <td class="text-end text-gray-300">—</td>
                                <td class="text-end pe-4 fw-bold text-gray-900">@((-Model.CarriedForward).ToString("N2"))</td>
                            </tr>
                            @foreach (var r in Model.Rows)
                            {
                                <tr class="tb-row" style="border-bottom:1px dashed #eef1f6;">
                                    <td class="ps-4 text-muted">@r.Date.ToString("yyyy/MM/dd")</td>
                                    <td><span class="badge fw-bold fs-8" style="background:#f2f4f7;color:#475467;">@r.Kind</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(r.Url))
                                        {
                                            <a href="@r.Url" class="badge fw-bold fs-8 text-hover-white" style="background:#E7F0FF;color:#145DBF;">@r.DocNo</a>
                                        }
                                        else
                                        {
                                            <span class="badge fw-bold fs-8" style="background:#E7F0FF;color:#145DBF;">@r.DocNo</span>
                                        }
                                    </td>
                                    <td class="text-gray-700 fs-7">@r.Note</td>
                                    <td class="text-end fw-bold @(r.Debit > 0 ? "text-gray-900" : "text-gray-300")" style="border-inline-start:1px solid #eff2f5;">@(r.Debit > 0 ? r.Debit.ToString("N2") : "—")</td>
                                    <td class="text-end fw-bold @(r.Credit > 0 ? "text-gray-900" : "text-gray-300")">@(r.Credit > 0 ? r.Credit.ToString("N2") : "—")</td>
                                    <td class="text-end pe-4 fw-bold text-gray-900">@((-r.Balance).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            @* THE PERIOD's totals, not the page's, and it says so. A totals row whose meaning
                               changed with the page number would stop the statement being reconcilable. *@
                            <tr class="fw-bolder fs-5" style="background:#E7F0FF;border-top:2px solid #0E4A9E;">
                                <td colspan="4" class="ps-4 text-end" style="color:#145DBF;">@SR["Total"] <span class="fw-normal fs-8">(@Localizer["whole period"])</span></td>
                                <td class="text-end" style="color:#0E4A9E;border-inline-start:1px solid #cfe7db;">@Model.TotalDebit.ToString("N2")</td>
                                <td class="text-end" style="color:#0E4A9E;">@Model.TotalCredit.ToString("N2")</td>
                                <td class="text-end pe-4" style="color:#0E4A9E;">@((-Model.Closing).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (!Model.Rows.Any())
                {
                    <div class="text-center text-muted py-15">
                        <i class="ki-outline ki-book fs-3x text-muted mb-4 d-block"></i>@SR["No movements in this period"]
                    </div>
                }

                @if (Model.PageCount > 1)
                {
                    <div class="d-flex flex-stack flex-wrap pt-5 d-print-none">
                        <div class="fs-7 text-muted">
                            @Localizer["Showing"] @(((Model.Page - 1) * Model.PageSize) + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalRows)) @Localizer["of"] @Model.TotalRows
                        </div>
                        <ul class="pagination mb-0">
                            @{
                                // The period and the page size ride along in every link: a pager that drops them
                                // silently changes what the reader is looking at on the second click.
                                Func<int, string> link = p => Url.Action("VendorStatement", "Accounting",
                                    new { id = Model.PartyId, from = Model.From?.ToString("yyyy-MM-dd"),
                                          to = Model.To?.ToString("yyyy-MM-dd"), page = p, pageSize = Model.PageSize })!;
                                int first = Math.Max(1, Model.Page - 2), last = Math.Min(Model.PageCount, first + 4);
                                first = Math.Max(1, last - 4);
                            }
                            <li class="page-item previous @(Model.Page <= 1 ? "disabled" : "")"><a href="@link(Model.Page - 1)" class="page-link"><i class="previous"></i></a></li>
                            @if (first > 1)
                            {
                                <li class="page-item"><a href="@link(1)" class="page-link">1</a></li>
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            @for (int p = first; p <= last; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")"><a href="@link(p)" class="page-link">@p</a></li>
                            }
                            @if (last < Model.PageCount)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                                <li class="page-item"><a href="@link(Model.PageCount)" class="page-link">@Model.PageCount</a></li>
                            }
                            <li class="page-item next @(Model.Page >= Model.PageCount ? "disabled" : "")"><a href="@link(Model.Page + 1)" class="page-link"><i class="next"></i></a></li>
                        </ul>
                    </div>
                }

                @* HONEST ABOUT WHAT THIS CANNOT SHOW. The journal line carries no customer, and the control
                   account is shared by every customer, so a manual entry posted straight to it belongs to no
                   one here. Saying so is what stops the statement being trusted for something it cannot answer. *@
                <div class="text-muted fs-8 mt-5">
                    <i class="ki-outline ki-information-2 fs-7 me-1"></i>@Localizer["Built from posted documents. A manual journal posted directly to the control account does not appear here, because the journal line does not record which party it belongs to."]
                </div>
            </div>
        </div>
    </div></div>
</div>
