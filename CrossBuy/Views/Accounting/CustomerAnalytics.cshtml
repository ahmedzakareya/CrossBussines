@using CrossBuy.BL
@model CustomerAnalytics
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var totalMarginPct = Model.TotalRevenue != 0 ? Math.Round(Model.TotalMargin / Model.TotalRevenue * 100, 1) : 0;
    // invariant number for the countUp value attribute (Arabic culture would emit Arabic digits and break countUp)
    string Raw(decimal v) => v.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Customer analytics"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Customer analytics"]</li></ul>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CustomerAnalyticsExport","Accounting")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-file-down fs-3"></i>@Localizer["Export Excel"]</a>
            <a href="@Url.Action("Customers","Accounting")" class="btn btn-sm btn-light"><i class="ki-outline ki-people fs-3"></i>@SR["Customers"]</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::KPIs-->
        <div class="row g-4 mb-5">
            <div class="col-md-3"><div class="card card-flush h-100"><div class="card-body py-6 text-center"><i class="ki-outline ki-dollar fs-3x mb-3" style="color:#13433a;"></i><div class="fs-2 fw-bold text-gray-900" data-kt-countup="true" data-kt-countup-value="@Raw(Model.TotalRevenue)">@Model.TotalRevenue.ToString("N0")</div><div class="fs-7 text-muted">@Localizer["Net revenue (ex-tax)"]</div></div></div></div>
            <div class="col-md-3"><div class="card card-flush h-100"><div class="card-body py-6 text-center"><i class="ki-outline ki-chart-pie-simple fs-3x mb-3" style="color:#13433a;"></i><div class="fs-2 fw-bold text-gray-900" data-kt-countup="true" data-kt-countup-value="@Raw(Model.TotalMargin)">@Model.TotalMargin.ToString("N0")</div><div class="fs-7 text-muted">@Localizer["Gross margin"] · <span class="fw-bold" style="color:@(totalMarginPct>=0?"#1f7d57":"#d92d20")">@totalMarginPct%</span></div></div></div></div>
            <div class="col-md-3"><div class="card card-flush h-100"><div class="card-body py-6 text-center"><i class="ki-outline ki-wallet fs-3x mb-3" style="color:#b96a00;"></i><div class="fs-2 fw-bold text-gray-900" data-kt-countup="true" data-kt-countup-value="@Raw(Model.TotalOutstanding)">@Model.TotalOutstanding.ToString("N0")</div><div class="fs-7 text-muted">@Localizer["Total outstanding"]</div></div></div></div>
            <div class="col-md-3"><div class="card card-flush h-100"><div class="card-body py-6 text-center"><i class="ki-outline ki-profile-user fs-3x mb-3" style="color:#13433a;"></i><div class="fs-2 fw-bold text-gray-900" data-kt-countup="true" data-kt-countup-value="@Model.ActiveCustomers">@Model.ActiveCustomers</div><div class="fs-7 text-muted">@Localizer["Customers with sales"]</div></div></div></div>
        </div>
        <!--end::KPIs-->

        <!--begin::Segment analysis-->
        <div class="card card-flush mb-5"><div class="card-header pt-6"><div class="card-title fw-bold">@Localizer["Segment analysis"]</div></div>
            <div class="card-body pt-2">
                @if (Model.Segments.Count == 0) { <div class="text-center text-muted py-6">@SR["NoData"]</div> }
                else {
                    <div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                        <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #13433a;"><th class="ps-4">@Localizer["Segment"]</th><th class="text-center">@SR["Customers"]</th><th class="text-end">@Localizer["Revenue"]</th><th class="text-end">@Localizer["Margin"]</th><th class="text-end">@Localizer["Margin %"]</th><th class="text-end pe-4">@Localizer["Outstanding"]</th></tr></thead>
                        <tbody>
                        @foreach (var s in Model.Segments)
                        {
                            var mp = s.Revenue != 0 ? Math.Round(s.Margin / s.Revenue * 100, 1) : 0;
                            <tr style="border-bottom:1px dashed #eef1f6;"><td class="ps-4">@if (string.IsNullOrEmpty(s.Segment)) { <span class="text-muted">—</span> } else { <span class="badge fw-bold" style="background:#eaf3ef;color:#13433a;">@s.Segment</span> }</td><td class="text-center">@s.Customers</td><td class="text-end fw-bold">@s.Revenue.ToString("N2")</td><td class="text-end">@s.Margin.ToString("N2")</td><td class="text-end fw-bold" style="color:@(mp>=0?"#1f7d57":"#d92d20")">@mp%</td><td class="text-end text-muted pe-4">@s.Outstanding.ToString("N2")</td></tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
        <!--end::Segment analysis-->

        <!--begin::Per-customer-->
        <div class="card card-flush"><div class="card-header pt-6"><div class="card-title fw-bold">@Localizer["Customers (by revenue)"]</div>
            <div class="card-title"><div class="d-flex align-items-center position-relative my-1"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" id="s" class="form-control form-control-solid w-250px ps-12" placeholder="@Localizer["Search customer"]" autocomplete="off" /></div></div>
        </div>
            <div class="card-body pt-2"><div class="table-responsive"><table class="table align-middle gy-3" id="t" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #13433a;">
                    <th class="ps-4">@SR["Customer"]</th><th>@Localizer["Segment"]</th><th class="text-end">@Localizer["Revenue"]</th><th class="text-end">@Localizer["COGS"]</th><th class="text-end">@Localizer["Margin"]</th><th class="text-end">@Localizer["Margin %"]</th><th class="text-end">@Localizer["Outstanding"]</th><th class="text-center">@Localizer["Invoices"]</th><th class="text-end">@Localizer["Avg"]</th><th class="pe-4">@Localizer["Last"]</th>
                </tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="rr" data-s="@r.Name @r.Segment" style="border-bottom:1px dashed #eef1f6;">
                        <td class="ps-4 fw-semibold text-gray-800"><a href="@Url.Action("CustomerStatement","Accounting", new { id = r.CustomerId })" class="text-gray-800 text-hover-primary">@r.Name</a></td>
                        <td>@if (string.IsNullOrEmpty(r.Segment)) { <span class="text-muted">—</span> } else { <span class="badge fw-bold" style="background:#eaf3ef;color:#13433a;">@r.Segment</span> }</td>
                        <td class="text-end fw-bold">@r.Revenue.ToString("N2")</td>
                        <td class="text-end text-muted">@r.Cogs.ToString("N2")</td>
                        <td class="text-end fw-bold" style="color:@(r.Margin>=0?"#1f7d57":"#d92d20")">@r.Margin.ToString("N2")</td>
                        <td class="text-end" style="color:@(r.MarginPct>=0?"#1f7d57":"#d92d20")">@r.MarginPct%</td>
                        <td class="text-end text-muted">@r.Outstanding.ToString("N2")</td>
                        <td class="text-center">@r.InvoiceCount</td>
                        <td class="text-end text-muted">@r.AvgInvoice.ToString("N2")</td>
                        <td class="text-muted fs-7 pe-4">@(r.LastInvoice?.ToString("yyyy-MM-dd") ?? "—")</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0) { <tr><td colspan="10" class="text-center text-muted py-10">@Localizer["No sales yet"]</td></tr> }
                </tbody>
            </table></div></div>
        </div>
        <!--end::Per-customer-->
    </div></div>
</div>
@section Scripts {
<script>
(function(){var i=document.getElementById('s');if(!i)return;var rows=[].slice.call(document.querySelectorAll('#t tbody tr.rr'));
i.addEventListener('input',function(e){var q=(e.target.value||'').trim().toLowerCase();rows.forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});})();
</script>
}
