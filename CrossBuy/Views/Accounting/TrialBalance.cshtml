@using CrossBuy.BL
@using CrossBuy.Models.Context.Accounting
@model TrialBalanceResult
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
    var costCenters = ViewBag.CostCenters as List<CostCenter> ?? new List<CostCenter>();
    var ccId = ViewBag.CostCenterId as int?;
    var diff = Model.TotalDebit - Model.TotalCredit;
}
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Trial Balance"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted text-hover-primary">@SR["Accounting"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Trial Balance"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <button onclick="window.print()" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-printer fs-4"></i>@SR["Print"]</button>
        </div>
    </div></div>
    <!--end::Toolbar-->

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Summary card-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body py-10">
                <h2 class="mb-2">@Localizer["Trial Balance"]</h2>
                <p class="fs-6 fw-semibold text-gray-600 py-1 m-0">
                    @if (from.HasValue || to.HasValue)
                    {
                        <span>@SR["From"] @(from?.ToString("yyyy/MM/dd") ?? "—") &mdash; @SR["To"] @(to?.ToString("yyyy/MM/dd") ?? "—")</span>
                    }
                </p>
                @{ string Raw(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture); }
                <div class="row mt-6">
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-info pb-1 px-2">@SR["Debit"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.TotalDebit)" data-kt-countup-decimal-places="2">@Model.TotalDebit.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold text-primary pb-1 px-2">@SR["Credit"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(Model.TotalCredit)" data-kt-countup-decimal-places="2">@Model.TotalCredit.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                            <span class="fs-4 fw-semibold @(Model.IsBalanced?"text-success":"text-danger") pb-1 px-2">@SR["Difference"]</span>
                            <span class="fs-lg-2tx fw-bold d-flex justify-content-center" data-kt-countup="true" data-kt-countup-value="@Raw(diff)" data-kt-countup-decimal-places="2">@diff.ToString("N2")</span>
                        </div>
                    </div>
                </div>
                @if (Model.IsBalanced)
                {
                    <div class="notice d-flex rounded border border-dashed p-6 mt-4" style="background:#E7F0FF;border-color:#0E4A9E !important;">
                        <span class="symbol symbol-45px me-5"><span class="symbol-label" style="background:#0E4A9E;"><i class="ki-outline ki-shield-tick fs-2x text-white"></i></span></span>
                        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                                <h4 class="text-gray-900 fw-bold mb-1">@SR["The trial balance is balanced"]</h4>
                                <div class="fs-6 text-gray-700">@SR["Balanced notice detail"]</div>
                            </div>
                            <span class="badge fs-7 fw-bold px-4 py-2 flex-shrink-0" style="background:#0E4A9E;color:#fff;"><i class="ki-outline ki-check fs-6 text-white me-1"></i>@SR["Matched"]</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mt-4">
                        <span class="symbol symbol-45px me-5"><span class="symbol-label bg-danger"><i class="ki-outline ki-information-5 fs-2x text-white"></i></span></span>
                        <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                            <div class="mb-3 mb-md-0 fw-semibold pe-5">
                                <h4 class="text-gray-900 fw-bold mb-1">@SR["The trial balance is not balanced"]</h4>
                                <div class="fs-6 text-gray-700">@SR["Not balanced notice detail"]</div>
                            </div>
                            <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0">@SR["Difference"]: @diff.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
        <!--end::Summary card-->

        <!--begin::List card-->
        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                        <input type="text" id="tbSearch" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search by code or account..."]" autocomplete="off" />
                    </div>
                </div>
                <div class="card-toolbar">
                    <form method="get" class="d-flex flex-wrap align-items-end gap-3 d-print-none">
                        <div>
                            <label class="fw-semibold fs-8 text-muted mb-1 d-block">@SR["From"]</label>
                            <input type="date" name="from" class="form-control form-control-sm form-control-solid w-140px" value="@(from?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <label class="fw-semibold fs-8 text-muted mb-1 d-block">@SR["To"]</label>
                            <input type="date" name="to" class="form-control form-control-sm form-control-solid w-140px" value="@(to?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <label class="fw-semibold fs-8 text-muted mb-1 d-block">@Localizer["Cost center"]</label>
                            <select name="costCenterId" class="form-select form-select-sm form-select-solid w-175px">
                                <option value="">@SR["All"]</option>
                                @foreach (var c in costCenters)
                                {
                                    <option value="@c.ID" selected="@(ccId == c.ID)">@c.Code — @(isAr ? c.Name : DisplayName.Or(c.NameEn, c.Name))</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-sm btn-primary"><i class="ki-outline ki-filter fs-4"></i>@Localizer["Apply"]</button>
                    </form>
                </div>
            </div>
            <div class="card-body pt-0 pb-5">
                <div class="table-responsive">
                    <table class="table align-middle gy-4 mb-0" id="tbTable" style="font-variant-numeric:tabular-nums;">
                        <thead>
                            <tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                <th class="ps-4" style="width:130px;">@SR["Code"]</th>
                                <th>@SR["Account"]</th>
                                <th class="text-end" style="width:180px;border-inline-start:1px solid #e4e6ef;">@SR["Debit"]</th>
                                <th class="text-end pe-4" style="width:180px;">@SR["Credit"]</th>
                            </tr>
                        </thead>
                        <tbody class="fs-6">
                            @foreach (var r in Model.Rows)
                            {
                                <tr class="tb-row" data-search="@(r.Code) @(r.NameAr) @(r.NameEn)" style="border-bottom:1px dashed #eef1f6;">
                                    <td class="ps-4"><span class="badge fw-bold fs-8" style="background:#E7F0FF;color:#145DBF;">@r.Code</span></td>
                                    <td><a href="@Url.Action("Ledger","Accounting", new { accountId = r.AccountId })" class="fw-bold text-gray-900 text-hover-primary">@(isAr ? r.NameAr : DisplayName.Or(r.NameEn, r.NameAr))</a></td>
                                    <td class="text-end fw-bold @(r.Debit > 0 ? "text-gray-900" : "text-gray-300")" style="border-inline-start:1px solid #eff2f5;">@(r.Debit > 0 ? r.Debit.ToString("N2") : "—")</td>
                                    <td class="text-end pe-4 fw-bold @(r.Credit > 0 ? "text-gray-900" : "text-gray-300")">@(r.Credit > 0 ? r.Credit.ToString("N2") : "—")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bolder fs-5" style="background:#E7F0FF;border-top:2px solid #0E4A9E;">
                                <td colspan="2" class="ps-4 text-end" style="color:#145DBF;">@SR["Total"]</td>
                                <td class="text-end" style="color:#0E4A9E;border-inline-start:1px solid #cfe7db;">@Model.TotalDebit.ToString("N2")</td>
                                <td class="text-end pe-4" style="color:#0E4A9E;">@Model.TotalCredit.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                @if (Model.Rows.Count == 0)
                {
                    <div class="text-center py-10 text-muted">@Localizer["No movements in the period"]</div>
                }
            </div>
        </div>
        <!--end::List card-->
    </div></div>
</div>
