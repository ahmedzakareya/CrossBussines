@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<AgingRow>
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["AP Aging"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["AP Aging"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><div class="d-flex align-items-center position-relative my-1"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" id="s" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search vendor..."]" autocomplete="off" /></div></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table align-middle gy-3" id="t" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@SR["Vendor"]</th><th class="text-end">@Localizer["Current"]</th><th class="text-end">@Localizer["31-60"]</th><th class="text-end">@Localizer["61-90"]</th><th class="text-end">@Localizer["90+"]</th><th class="text-end pe-4">@SR["Total"]</th></tr></thead>
                <tbody>
                @foreach (var r in Model) { <tr class="r" data-s="@r.Name" style="border-bottom:1px dashed #eef1f6;"><td class="ps-4 fw-semibold text-gray-800">@r.Name</td><td class="text-end @(r.Current>0?"":"text-gray-300")">@(r.Current>0?r.Current.ToString("N2"):"—")</td><td class="text-end @(r.D30>0?"":"text-gray-300")">@(r.D30>0?r.D30.ToString("N2"):"—")</td><td class="text-end @(r.D60>0?"":"text-gray-300")">@(r.D60>0?r.D60.ToString("N2"):"—")</td><td class="text-end @(r.D90>0?"text-danger fw-bold":"text-gray-300")">@(r.D90>0?r.D90.ToString("N2"):"—")</td><td class="text-end fw-bold text-gray-900">@r.Total.ToString("N2")</td></tr> }
                @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10">@Localizer["No outstanding balances"]</td></tr> }
                </tbody>
                <tfoot><tr class="fw-bolder fs-6" style="background:#E7F0FF;border-top:2px solid #0E4A9E;"><td class="ps-4" style="color:#145DBF;">@Localizer["Totals"]</td><td class="text-end" style="color:#0E4A9E;">@Model.Sum(x=>x.Current).ToString("N2")</td><td class="text-end" style="color:#0E4A9E;">@Model.Sum(x=>x.D30).ToString("N2")</td><td class="text-end" style="color:#0E4A9E;">@Model.Sum(x=>x.D60).ToString("N2")</td><td class="text-end" style="color:@(Model.Sum(x=>x.D90)>0?"#d92d20":"#0E4A9E");">@Model.Sum(x=>x.D90).ToString("N2")</td><td class="text-end pe-4" style="color:#0E4A9E;">@Model.Sum(x=>x.Total).ToString("N2")</td></tr></tfoot>
            </table></div></div>
        </div>
    </div></div>
</div>
@section Scripts { <script>(function(){var i=document.getElementById('s');var rows=[].slice.call(document.querySelectorAll('#t tbody tr.r'));i.addEventListener('input',function(e){var q=(e.target.value||'').trim().toLowerCase();rows.forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});})();</script> }
