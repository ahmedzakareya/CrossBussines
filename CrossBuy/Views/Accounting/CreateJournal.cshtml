            var L = '<th class="xl-rn"></th>', N = '<th class="xl-rn"></th>', j;
            for (j = 0; j < XLCOLS.length; j++) {
                var w = ' style="width:' + XLCOLS[j].w + 'px"';
                L += '<th' + w + '>' + String.fromCharCode(65 + j) + '</th>';
                N += '<th' + w + '>' + xlEsc(ths[j] ? ths[j].textContent.trim() : '') + '</th>';
            }
            document.getElementById('xlHeadLetters').innerHTML = L;
            document.getElementById('xlHeadNames').innerHTML = N;
            /* The table needs its own width for table-layout:fixed to honour the column widths;
               max-content did not resolve to the sum, so the container's width won and the account
               column lost half of itself. */
            var total = 42; for (j = 0; j < XLCOLS.length; j++) total += XLCOLS[j].w;
            document.getElementById('xlGrid').style.width = total + 'px';
        }
        function xlRender() {
