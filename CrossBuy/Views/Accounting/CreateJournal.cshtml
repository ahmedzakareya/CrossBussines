            var b = document.getElementById('xlArrow'), td = xlTd(XL.r, XL.c);
            if (!b) return;
            document.querySelectorAll('#xlBody td.xl-hasdd').forEach(function (x) { x.classList.remove('xl-hasdd'); });
            if (!XL.on || XL.editing || !td || XLCOLS[XL.c].type !== 'lookup') { b.classList.add('d-none'); return; }
            td.classList.add('xl-hasdd');
            var rtl = getComputedStyle(document.documentElement).direction === 'rtl';
            b.classList.remove('d-none');
            var bw = b.offsetWidth || 24, pad = 5;
            b.style.top = (td.offsetTop + pad) + 'px';
            b.style.left = (rtl ? td.offsetLeft + pad : td.offsetLeft + td.offsetWidth - bw - pad) + 'px';
            b.style.height = (td.offsetHeight - pad * 2) + 'px';
        }
        /* The proxy holds the focus and the selection's TSV, already selected. Ctrl+C and Ctrl+X then
           need no handler of their own — the browser copies exactly what is in it — and Ctrl+V arrives
           as a genuine paste event, which is the only way to read a clipboard without a permission
           prompt. preventScroll keeps the 1px element from yanking the grid around. */
        function xlSyncProxy() {
