                if (!row.acc.id && !row.dr && !row.cr && !row.note && !row.cc.id && !row.prj.id) return;
                addRow();
                var tr = body.lastElementChild;
                if (row.acc.id) tr.querySelector('.acc').value = row.acc.id;
                tr.querySelector('.dr').value = row.dr || 0;
                tr.querySelector('.cr').value = row.cr || 0;
                if (row.cc.id) tr.querySelector('.cc').value = row.cc.id;
                if (row.prj.id && tr.querySelector('.prj')) tr.querySelector('.prj').value = row.prj.id;
                tr.querySelector('.desc').value = row.note || '';
            });
            if (!body.children.length) { addRow(); addRow(); }
