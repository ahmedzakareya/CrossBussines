            var vals = [], r, c;
            for (r = r1; r <= r2; r++) for (c = c1; c <= c2; c++) if (XLCOLS[c].type === 'num') { var v = parseFloat(xlCell(r, c)); if (!isNaN(v)) vals.push(v); }
            var sum = vals.reduce(function (a, b) { return a + b; }, 0);
            var sel = vals.length
                ? '<span>' + xlEsc(XLT.count) + ': <b>' + vals.length + '</b></span>' +
                  '<span>' + xlEsc(XLT.avg) + ': <b>' + xlFmt(sum / vals.length) + '</b></span>' +
                  '<span>' + xlEsc(XLT.sum) + ': <b>' + xlFmt(sum) + '</b></span>'
                : '';
