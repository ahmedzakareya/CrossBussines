            for (r = 0; r < XL.rows.length; r++) { d += parseFloat(XL.rows[r].dr) || 0; cr += parseFloat(XL.rows[r].cr) || 0; }
            var balanced = Math.abs(d - cr) < 0.005 && d > 0;
            var hD = document.querySelector('#classicPane thead th:nth-child(2)').textContent.trim();
            var hC = document.querySelector('#classicPane thead th:nth-child(3)').textContent.trim();
