        }

        /* --- the two views hold the same lines ----------------------------------------------------- */
        function xlPick(src, id) { return XLSRC[src].filter(function (x) { return String(x.id) === String(id); })[0]; }
        function xlFromClassic() {
            XL.rows = [];
