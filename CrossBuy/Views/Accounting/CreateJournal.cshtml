            if (a) { a.classList.add('xl-active'); a.classList.remove('xl-sel'); a.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
            document.getElementById('xlRef').textContent = String.fromCharCode(65 + XL.c) + (XL.r + 1);
