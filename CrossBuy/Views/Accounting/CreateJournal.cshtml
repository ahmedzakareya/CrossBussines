                var row = xlBlank();
                var a = tr.querySelector('.acc'), cc = tr.querySelector('.cc'), pj = tr.querySelector('.prj');
                var o;
                if (a && a.value && (o = xlPick('acc', a.value))) row.acc = { id: o.id, t: o.text };
                if (cc && cc.value && (o = xlPick('cc', cc.value))) row.cc = { id: o.id, t: o.text };
                if (pj && pj.value && (o = xlPick('prj', pj.value))) row.prj = { id: o.id, t: o.text };
                var dr = parseFloat(tr.querySelector('.dr').value) || 0, cr = parseFloat(tr.querySelector('.cr').value) || 0;
                row.dr = dr ? String(dr) : ''; row.cr = cr ? String(cr) : '';
                row.note = tr.querySelector('.desc').value || '';
