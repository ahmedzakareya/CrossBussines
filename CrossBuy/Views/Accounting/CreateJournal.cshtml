        /* --- formulas ------------------------------------------------------------------------
           No eval: a recursive-descent parser over + - * / ( ) % and unary sign. Cell references
           and the range functions are substituted to plain numbers before it runs, so the parser
           only ever sees arithmetic. */
        function xlNumberAt(r, c) {
            if (!XL.rows[r] || !XLCOLS[c] || XLCOLS[c].type !== 'num') return 0;
            var n = parseFloat(XL.rows[r][XLCOLS[c].key]); return isNaN(n) ? 0 : n;
        }
        function xlRangeVals(a, b) {
            var m1 = /^([A-Za-z])(\d+)$/.exec(a), m2 = /^([A-Za-z])(\d+)$/.exec(b);
            if (!m1 || !m2) return [];
            var c1 = m1[1].toUpperCase().charCodeAt(0) - 65, r1 = parseInt(m1[2], 10) - 1;
            var c2 = m2[1].toUpperCase().charCodeAt(0) - 65, r2 = parseInt(m2[2], 10) - 1;
            var out = [];
            for (var r = Math.min(r1, r2); r <= Math.max(r1, r2); r++)
                for (var c = Math.min(c1, c2); c <= Math.max(c1, c2); c++) out.push(xlNumberAt(r, c));
