        }
        function xlPaint() {
            var r1 = Math.min(XL.r, XL.ar), r2 = Math.max(XL.r, XL.ar);
            var c1 = Math.min(XL.c, XL.ac), c2 = Math.max(XL.c, XL.ac);
            document.querySelectorAll('#xlBody td').forEach(function (td) { td.classList.remove('xl-sel', 'xl-active', 'xl-rn-on'); });
