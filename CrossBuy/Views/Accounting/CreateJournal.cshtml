@using CrossBuy.BL
@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var accounts = ViewBag.Accounts as List<AccountNode> ?? new List<AccountNode>();
    var costCenters = ViewBag.CostCenters as List<CostCenter> ?? new List<CostCenter>();
    var projects = ViewBag.Projects as List<(int id, string text)> ?? new List<(int id, string text)>();
    var CamelCase = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    // EDIT MODE. The same view serves the create and the edit of a draft; only these four differ.
    var editId = ViewBag.EditId as int?;
    var isEdit = editId != null;
    var entryDateValue = ((DateTime?)ViewBag.EntryDate)?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
    /* The grid's surface is the app's, not Excel's: the palette below is this page's own tokens
       (primary #1877F2, border #F1F1F4, gray-600 #78829D, card radius 11px) read off the running
       page. Sizes are in px because the root font-size here is 13px — a rem lands at 81% of intent. */
    .xl-pane { --xg-line:#F1F1F4; --xg-edge:#DBDFE9; --xg-head:#FCFCFD; --xg-mute:#78829D;
               --xg-ink:#252F4A; --xg-pri:#1877F2; --xg-pri-soft:#E7F0FF;
               border:1px solid var(--xg-edge); border-radius:11px; overflow:hidden; background:#fff; }

    .xl-bar { display:flex; align-items:center; gap:10px; padding:8px 10px;
              background:#fff; border-bottom:1px solid var(--xg-line); }
    .xl-ref { flex:none; min-width:74px; height:32px; display:flex; align-items:center; justify-content:center;
              font-size:12.5px; font-weight:700; color:var(--xg-ink);
              background:#F9F9F9; border:1px solid var(--xg-line); border-radius:7px; }
    .xl-formula { flex:1 1 auto; min-width:0; height:32px; padding:0 12px;
                  border:1px solid var(--xg-line); border-radius:7px; background:#F9F9F9;
                  font-size:13px; color:var(--xg-ink); outline:0;
                  transition:border-color .15s ease, background .15s ease; }
    .xl-formula:focus { background:#fff; border-color:var(--xg-pri); }
    .xl-tools { flex:none; display:flex; align-items:center; gap:4px; }
    .xl-btn { border:0; background:transparent; color:var(--xg-mute); width:32px; height:32px;
              border-radius:7px; display:flex; align-items:center; justify-content:center;
              transition:background .15s ease, color .15s ease; }
    .xl-btn:hover { background:var(--xg-pri-soft); color:var(--xg-pri); }

    .xl-scroll { position:relative; max-height:58vh; overflow:auto; outline:0; background:#fff; }
    .xl-grid { border-collapse:separate; border-spacing:0; min-width:100%;
               font-size:13px; color:var(--xg-ink); table-layout:fixed; }
    .xl-grid th, .xl-grid td { border-inline-end:1px solid var(--xg-line);
                               border-bottom:1px solid var(--xg-line);
                               padding:0 10px; height:34px; white-space:nowrap;
                               overflow:hidden; text-overflow:ellipsis; background:#fff; }

    /* Both header rows stick: the letters so a formula's reference stays readable while scrolling,
       the names so the column keeps its meaning. */
    .xl-grid thead th { position:sticky; z-index:3; background:var(--xg-head); color:var(--xg-mute);
                        font-weight:600; text-align:center; user-select:none; }
    .xl-grid thead tr:first-child th { top:0; height:22px; font-size:10.5px; letter-spacing:.04em;
                                       color:#A1A5B7; }
    .xl-grid thead tr:last-child th { top:22px; height:36px; font-size:12.5px; color:var(--xg-ink);
                                      border-bottom:1px solid var(--xg-edge); }

    .xl-rn { position:sticky; inset-inline-start:0; z-index:2; width:44px; min-width:44px; max-width:44px;
             background:var(--xg-head) !important; color:var(--xg-mute); text-align:center;
             font-size:11px; font-weight:600; user-select:none;
             border-inline-end:1px solid var(--xg-edge); }
    .xl-grid thead .xl-rn { z-index:4; }

    .xl-cell { cursor:cell; }
    .xl-num  { text-align:end; font-variant-numeric:tabular-nums; direction:ltr; }
    .xl-sel  { background:var(--xg-pri-soft) !important; }
    /* The ring plus a soft halo — a 2px line alone disappears against a hairline grid. */
    .xl-active { background:#fff !important;
                 box-shadow:inset 0 0 0 2px var(--xg-pri), 0 0 0 3px rgba(24,119,242,.12);
                 border-radius:3px; }
    .xl-rn.xl-rn-on { background:var(--xg-pri-soft) !important; color:var(--xg-pri); }
    /* Room for the arrow, only on the cell that has one. */
    .xl-hasdd { padding-inline-end:36px !important; }
    .xl-err { color:#F8285A; }

    .xl-proxy { position:absolute; z-index:1; opacity:0; width:1px; height:1px; padding:0; margin:0;
                border:0; resize:none; overflow:hidden; white-space:pre; }
    .xl-editor { position:absolute; z-index:6; border:2px solid var(--xg-pri); border-radius:4px;
                 outline:0; padding:0 8px; font-size:13px; background:#fff; color:var(--xg-ink);
                 box-shadow:0 0 0 3px rgba(24,119,242,.12); }

    .xl-arrow { position:absolute; z-index:7; width:24px; padding:0; border:0; border-radius:5px;
                background:var(--xg-pri-soft); color:var(--xg-pri);
                display:flex; align-items:center; justify-content:center; cursor:pointer;
                transition:background .15s ease, color .15s ease; }
    .xl-arrow:hover { background:var(--xg-pri); color:#fff; }

    .xl-list { position:absolute; z-index:8; background:#fff; border:1px solid var(--xg-line);
               border-radius:9px; box-shadow:0 12px 30px rgba(37,47,74,.14); padding:5px;
               max-height:250px; overflow-y:auto; overflow-x:hidden;
               width:max-content; max-width:440px; }
    .xl-list div { padding:7px 10px; font-size:12.5px; border-radius:6px; cursor:pointer;
                   white-space:nowrap; color:var(--xg-ink); }
    .xl-list div.on, .xl-list div:hover { background:var(--xg-pri-soft); color:var(--xg-pri); font-weight:600; }

    .xl-status { display:flex; align-items:center; gap:8px; padding:9px 12px; background:#FCFCFD;
                 border-top:1px solid var(--xg-line); font-size:12px; color:var(--xg-mute); }
    .xl-hint { opacity:.9; }
    .xl-stat { margin-inline-start:auto; display:flex; gap:6px; align-items:center;
               font-variant-numeric:tabular-nums; }
    /* Each figure in its own chip: a run of numbers separated only by spaces is a wall of digits. */
    .xl-stat span { background:#F9F9F9; border:1px solid var(--xg-line); border-radius:20px;
                    padding:3px 11px; white-space:nowrap; }
    .xl-stat b { color:var(--xg-ink); font-weight:700; }
    .xl-ok  { background:#EAFBF1 !important; border-color:#C7EED8 !important; color:#16A34A !important; font-weight:700; }
    .xl-bad { background:#FFF0F3 !important; border-color:#FFD4DD !important; color:#F8285A !important; font-weight:700; }
</style>

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isEdit ? Localizer["Edit Draft Entry"] : Localizer["New Journal Entry"])</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("Journals","Accounting")" class="text-muted">@Localizer["Journals"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@(isEdit ? SR["Edit"] : Localizer["New"])</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            <form asp-action="@(isEdit ? "EditJournal" : "CreateJournal")" method="post" id="jeForm">
                @Html.AntiForgeryToken()
                @if (isEdit) { <input type="hidden" name="id" value="@editId" /> }
                <input type="hidden" name="linesJson" id="linesJson" />
                <input type="hidden" name="action" id="jeAction" value="post" />

                <div class="card mb-5">
                    <div class="card-body">
                        <div class="row g-5">
                            <div class="col-md-4">
                                <label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label>
                                <input type="date" name="entryDate" id="entryDate" class="form-control form-control-solid" value="@entryDateValue" required />
                            </div>
                            <div class="col-md-8">
                                <label class="fw-semibold fs-6 mb-2">@SR["Description"]</label>
                                <input type="text" name="description" class="form-control form-control-solid" placeholder="@Localizer["Entry description"]" value="@(ViewBag.EntryDescription as string)" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title fw-bold">@Localizer["Entry Lines"]</h3>
                        <div class="card-toolbar gap-2">
                            <button type="button" class="btn btn-sm btn-light-primary" id="addRow"><i class="ki-outline ki-plus fs-3"></i>@Localizer["Add line"]</button>
                            @* The mode switch. It carries the state in its own dataset so the label and icon
                               have exactly one source of truth. *@
                            <button type="button" class="btn btn-sm btn-light-success" id="xlToggle" data-on="0">
                                <i class="ki-outline ki-grid-frame fs-3"></i><span id="xlToggleText">@Localizer["Excel mode"]</span>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive" id="classicPane">
                            <table class="table table-row-bordered align-middle">
                                <thead>
                                    <tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                                        <th style="min-width:260px">@SR["Account"]</th>
                                        <th style="width:140px" class="text-end">@SR["Debit"]</th>
                                        <th style="width:140px" class="text-end">@SR["Credit"]</th>
                                        <th style="min-width:180px">@Localizer["Cost center"]</th>
                                        <th style="min-width:170px">@Localizer["Project"]</th>
                                        <th style="min-width:150px">@Localizer["Line note"]</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody id="rows"></tbody>
                                <tfoot>
                                    <tr class="fw-bold fs-5 border-top border-2">
                                        <td class="text-end">@SR["Total"]</td>
                                        <td class="text-end" id="totD">0.00</td>
                                        <td class="text-end" id="totC">0.00</td>
                                        <td colspan="4">
                                            <span id="balPill" class="badge badge-light-danger fs-7"></span>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        @* ===== EXCEL MODE =========================================================
                           A grid driven by the keyboard, not by form controls. The three things that
                           decide whether an accountant actually leaves the spreadsheet:
                             - the keyboard behaves as Excel's does (arrows, Enter, Tab, F2, Ctrl+D,
                               Ctrl+Z, type-to-replace),
                             - a range PASTED from a real sheet lands in the right cells and grows the
                               grid to fit,
                             - a range COPIED here pastes back into a real sheet.
                           Everything else is presentation. ======================================== *@
                        <div id="xlPane" class="xl-pane d-none">
                            <div class="xl-bar">
                                <span class="xl-ref" id="xlRef">A1</span>
                                <input type="text" class="xl-formula" id="xlFormula" autocomplete="off" spellcheck="false" />
                                <div class="xl-tools">
                                    <button type="button" class="xl-btn" id="xlInsert" title="@Localizer["Insert row"]"><i class="ki-outline ki-plus-square fs-4"></i></button>
                                    <button type="button" class="xl-btn" id="xlDelete" title="@Localizer["Delete row"]"><i class="ki-outline ki-minus-square fs-4"></i></button>
                                    <button type="button" class="xl-btn" id="xlFill" title="@Localizer["Fill down"]"><i class="ki-outline ki-arrow-down fs-4"></i></button>
                                    <button type="button" class="xl-btn" id="xlUndo" title="@SR["Undo"]"><i class="ki-outline ki-arrow-circle-left fs-4"></i></button>
                                </div>
                            </div>

                            <div class="xl-scroll" id="xlScroll" tabindex="0">
                                <table class="xl-grid" id="xlGrid">
                                    <thead>
                                        <tr id="xlHeadLetters"></tr>
                                        <tr id="xlHeadNames"></tr>
                                    </thead>
                                    <tbody id="xlBody"></tbody>
                                </table>
                                @* The focus proxy — see the comment on xlSyncProxy. It must be a real
                                   editable element or the browser raises no clipboard events at all. *@
                                <textarea id="xlProxy" class="xl-proxy" aria-hidden="true" tabindex="-1"></textarea>
                                <input type="text" id="xlEditor" class="xl-editor d-none" autocomplete="off" spellcheck="false" />
                                @* Excel's validation arrow: it sits on the ACTIVE cell of a list column,
                                   which is the only place Excel shows one. Alt+Down opens it too. *@
                                <button type="button" id="xlArrow" class="xl-arrow d-none" tabindex="-1" aria-hidden="true">
                                    <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M0 0h10L5 6z" fill="currentColor"/></svg>
                                </button>
                                <div id="xlList" class="xl-list d-none"></div>
                            </div>

                            <div class="xl-status">
                                <span id="xlHint" class="xl-hint">@Localizer["Paste a range from Excel with Ctrl+V, and type = for a formula"]</span>
                                <span id="xlStat" class="xl-stat"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-6">
                            @if (isEdit)
                            {
                                @* An edit saves the draft and stops there. Posting stays one action in one
                                   place — the list's Post button — rather than becoming a second path that
                                   has to repeat the approval threshold and the segregation-of-duties rule. *@
                                <a href="@Url.Action("Journals","Accounting")" class="btn btn-light">@SR["Cancel"]</a>
                                <button type="button" class="btn btn-primary" id="postBtn" onclick="submitJe('draft')">@SR["Save"]</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-light" onclick="submitJe('draft')">@Localizer["Save draft"]</button>
                                <button type="button" class="btn btn-primary" id="postBtn" onclick="submitJe('post')">@SR["Post"]</button>
                            }
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @* camelCase, explicitly. Serialize's default keeps the declared names (Id, Code, ID), which is
           why every code read back as undefined and every option value was the literal string
           "undefined" — so parseInt gave NaN and no line carried an account id at all. *@
        var ACCOUNTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(accounts.Select(a => new { a.Id, a.Code, name = (isAr ? a.Name : DisplayName.Or(a.NameEn, a.Name)) }), CamelCase));
        var COSTCENTERS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(costCenters.Select(c => new { c.ID, c.Code, name = (isAr ? c.Name : DisplayName.Or(c.NameEn, c.Name)) }), CamelCase));
        var PROJECTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(projects.Select(p => new { id = p.id, text = p.text })));
        var isAr = @(isAr ? "true" : "false");

        function accountOptions(sel) {
            var o = '<option value="">' + '@Localizer["Select account"]' + '</option>';
            ACCOUNTS.forEach(function (a) { o += '<option value="' + a.id + '"' + (a.id == sel ? ' selected' : '') + '>' + a.code + ' — ' + a.name + '</option>'; });
            return o;
        }
        function ccOptions() {
            var o = '<option value="">' + (isAr ? '—' : '—') + '</option>';
            COSTCENTERS.forEach(function (c) { o += '<option value="' + c.id + '">' + c.code + ' — ' + c.name + '</option>'; });
            return o;
        }
        function prjOptions() {
            var o = '<option value="">' + (isAr ? '—' : '—') + '</option>';
            PROJECTS.forEach(function (p) { o += '<option value="' + p.id + '">' + p.text + '</option>'; });
            return o;
        }
        function addRow() {
            var tr = document.createElement('tr');
            tr.innerHTML =
                '<td><select class="form-select form-select-solid acc">' + accountOptions() + '</select></td>' +
                '<td><input type="number" step="0.01" min="0" class="form-control form-control-solid text-end dr" value="0"></td>' +
                '<td><input type="number" step="0.01" min="0" class="form-control form-control-solid text-end cr" value="0"></td>' +
                '<td><select class="form-select form-select-solid cc">' + ccOptions() + '</select></td>' +
                '<td><select class="form-select form-select-solid prj">' + prjOptions() + '</select></td>' +
                '<td><input type="text" class="form-control form-control-solid desc"></td>' +
                '<td class="text-center"><button type="button" class="btn btn-icon btn-light-danger btn-sm del"><i class="ki-outline ki-trash fs-5"></i></button></td>';
            document.getElementById('rows').appendChild(tr);
            recalc();
        }
        function recalc() {
            var d = 0, c = 0;
            document.querySelectorAll('#rows tr').forEach(function (tr) {
                var dr = parseFloat(tr.querySelector('.dr').value) || 0;
                var cr = parseFloat(tr.querySelector('.cr').value) || 0;
                d += dr; c += cr;
            });
            document.getElementById('totD').textContent = d.toFixed(2);
            document.getElementById('totC').textContent = c.toFixed(2);
            var pill = document.getElementById('balPill');
            var balanced = Math.abs(d - c) < 0.005 && d > 0;
            pill.className = 'badge fs-7 badge-light-' + (balanced ? 'success' : 'danger');
            pill.textContent = balanced ? '@Localizer["Balanced ✓"]' : ('@Localizer["Diff:"] ' + (d - c).toFixed(2));
            /* The button is NOT disabled. While a cell is mid-edit the totals are stale, and a disabled
               button takes no mousedown — so it never commits the cell and never submits, and the press
               does nothing at all with nothing said. submitJe refuses instead, and says why. */
            JE_BALANCED = balanced; JE_DIFF = d - c;
        }
        document.getElementById('addRow').addEventListener('click', addRow);
        document.getElementById('rows').addEventListener('input', function (e) {
            // a debit and a credit can't both be > 0 on the same line
            if (e.target.classList.contains('dr') && parseFloat(e.target.value) > 0) {
                e.target.closest('tr').querySelector('.cr').value = 0;
            } else if (e.target.classList.contains('cr') && parseFloat(e.target.value) > 0) {
                e.target.closest('tr').querySelector('.dr').value = 0;
            }
            recalc();
        });
        document.getElementById('rows').addEventListener('click', function (e) {
            if (e.target.closest('.del')) { e.target.closest('tr').remove(); recalc(); }
        });
        var IS_EDIT = @(isEdit ? "true" : "false");
        var JE_BALANCED = false, JE_DIFF = 0;
        function submitJe(mode) {
            /* The grid is the source of truth while it is the mode on screen: without this, lines
               typed in Excel mode never reached the hidden table and an empty entry was posted. */
            /* Commit an open cell BEFORE reading the grid. blur normally does this, but a submit must
               not depend on a focus event having fired first. */
            if (typeof XL !== 'undefined' && XL.editing) xlEndEdit(true);
            if (typeof XL !== 'undefined' && XL.on) xlToClassic();
            var lines = [];
            document.querySelectorAll('#rows tr').forEach(function (tr) {
                var acc = tr.querySelector('.acc').value;
                var dr = parseFloat(tr.querySelector('.dr').value) || 0;
                var cr = parseFloat(tr.querySelector('.cr').value) || 0;
                var cc = tr.querySelector('.cc').value;
                var prj = tr.querySelector('.prj') ? tr.querySelector('.prj').value : '';
                if (acc && (dr > 0 || cr > 0)) lines.push({ accountId: parseInt(acc), debit: dr, credit: cr, costCenterId: cc ? parseInt(cc) : null, projectId: prj ? parseInt(prj) : null, description: tr.querySelector('.desc').value });
            });
            /* Re-read the totals AFTER the open cell was committed above — that commit is usually the
               very thing that balances the entry. */
            if (typeof XL !== 'undefined' && XL.on) xlStatus(); else recalc();
            if (!JE_BALANCED) {
                var why = '@Localizer["The entry is not balanced"]' + ' — ' + '@Localizer["Diff:"] ' + JE_DIFF.toFixed(2);
                if (window.CB && CB.toast) CB.toast.error(why); else alert(why);
                return;
            }
            document.getElementById('linesJson').value = JSON.stringify(lines);
            document.getElementById('jeAction').value = mode;
            var go = function () { document.getElementById('jeForm').submit(); };
            /* An EDIT changes a record that already exists, so it is gated the same way post, reverse
               and delete are — through the project's own confirm flow, which carries the Arabic copy,
               the brand buttons and the RTL button order. A CREATE is not gated: there is nothing yet
               to change. CB.confirm resolves false on cancel, so nothing is submitted. */
            if (IS_EDIT && window.CB && CB.confirm) {
                CB.confirm({ type: 'edit' }).then(function (ok) { if (ok === true || (ok && ok.confirmed)) go(); });
            } else { go(); }
        }
        /* ===================================================================================
           EXCEL MODE
           A grid driven by the keyboard rather than by form controls. Three behaviours decide
           whether an accountant actually stops opening the .xlsx, and they are the ones built
           first: the keyboard matches Excel's, a range pasted FROM a sheet lands correctly and
           grows the grid, and a range copied here pastes back INTO a sheet.
           =================================================================================== */
        var XLT = {
            modeOn:  '@Localizer["Classic mode"]',
            modeOff: '@Localizer["Excel mode"]',
            sum:     '@Localizer["Sum"]',
            count:   '@Localizer["Count"]',
            avg:     '@Localizer["Average"]',
            nomatch: '@Localizer["No match"]'
        };
        var BALTXT = '@Localizer["Balanced ✓"]', DIFFTXT = '@Localizer["Diff:"]';
        var XLCOLS = [
            { key: 'acc',  type: 'lookup', src: 'acc', w: 300 },
            { key: 'dr',   type: 'num',                w: 120 },
            { key: 'cr',   type: 'num',                w: 120 },
            { key: 'cc',   type: 'lookup', src: 'cc',  w: 180 },
            { key: 'prj',  type: 'lookup', src: 'prj', w: 170 },
            { key: 'note', type: 'text',               w: 230 }
        ];
        var XLSRC = {
            acc: ACCOUNTS.map(function (a) { return { id: a.id, code: String(a.code || ''), name: a.name || '', text: a.code + ' — ' + a.name }; }),
            cc:  COSTCENTERS.map(function (c) { return { id: c.id, code: String(c.code || ''), name: c.name || '', text: c.code + ' — ' + c.name }; }),
            prj: PROJECTS.map(function (p) { return { id: p.id, code: '', name: p.text || '', text: p.text }; })
        };
        var XL = { rows: [], r: 0, c: 0, ar: 0, ac: 0, on: false, editing: false, undo: [], li: -1 };
        var MINROWS = 12;

        function xlEsc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (m) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]; }); }
