            var px = document.getElementById('xlProxy');
            xlHead();

            btn.addEventListener('click', function () {
                XL.on = btn.dataset.on !== '1';
                btn.dataset.on = XL.on ? '1' : '0';
                document.getElementById('xlToggleText').textContent = XL.on ? XLT.modeOn : XLT.modeOff;
                btn.classList.toggle('btn-light-success', !XL.on);
                btn.classList.toggle('btn-success', XL.on);
                document.getElementById('classicPane').classList.toggle('d-none', XL.on);
                document.getElementById('addRow').classList.toggle('d-none', XL.on);
                document.getElementById('xlPane').classList.toggle('d-none', !XL.on);
