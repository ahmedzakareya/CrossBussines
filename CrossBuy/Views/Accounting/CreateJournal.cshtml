            for (i = 0; i < XL.rows.length; i++) {
                h += '<tr><td class="xl-rn" data-r="' + i + '">' + (i + 1) + '</td>';
                for (j = 0; j < XLCOLS.length; j++) {
                    var col = XLCOLS[j], bad = col.type === 'lookup' && xlRaw(i, j) && !xlCell(i, j).id;
                    h += '<td class="xl-cell' + (col.type === 'num' ? ' xl-num' : '') + (bad ? ' xl-err' : '') +
                         '" data-r="' + i + '" data-c="' + j + '">' + xlEsc(xlDisplay(i, j)) + '</td>';
                }
                h += '</tr>';
            }
