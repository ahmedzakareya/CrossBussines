        }

        /* --- the grid ---------------------------------------------------------------------------- */
        function xlSnapshot() { XL.undo.push(JSON.stringify(XL.rows)); if (XL.undo.length > 60) XL.undo.shift(); }
        function xlPad() { while (XL.rows.length < MINROWS) XL.rows.push(xlBlank()); }
        function xlTd(r, c) { return document.querySelector('#xlBody td[data-r="' + r + '"][data-c="' + c + '"]'); }

        function xlHead() {
