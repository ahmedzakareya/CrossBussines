            var c1 = Math.min(XL.c, XL.ac), c2 = Math.max(XL.c, XL.ac), out = [];
            for (var r = r1; r <= r2; r++) { var line = []; for (var c = c1; c <= c2; c++) line.push(xlRaw(r, c)); out.push(line.join('\t')); }
