            function factor() { ws(); if (s[i] === '(') { i++; var v = expr(); ws(); if (s[i] !== ')') throw 0; i++; return post(v); } if (s[i] === '-') { i++; return -factor(); } if (s[i] === '+') { i++; return factor(); } return post(num()); }
            function term() { var v = factor(); for (;;) { ws(); if (s[i] === '*') { i++; v *= factor(); } else if (s[i] === '/') { i++; var d = factor(); v = d === 0 ? NaN : v / d; } else return v; } }
