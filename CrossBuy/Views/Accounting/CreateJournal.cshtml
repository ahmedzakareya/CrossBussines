                    xlSnapshot();
                    var a1 = Math.min(XL.r, XL.ar), a2 = Math.max(XL.r, XL.ar), b1 = Math.min(XL.c, XL.ac), b2 = Math.max(XL.c, XL.ac);
                    for (c = b1; c <= b2; c++) for (r = a1 + 1; r <= a2; r++) xlSet(r, c, xlRaw(a1, c), false);
                    xlRender(); e.preventDefault(); return;
                }
                if (ctrl && (k === 'a' || k === 'A')) { XL.ar = 0; XL.ac = 0; XL.r = XL.rows.length - 1; XL.c = XLCOLS.length - 1; xlPaint(); xlStatus(); e.preventDefault(); return; }
                /* Ctrl+C is NOT intercepted: the proxy already holds the selection's TSV, selected, so
                   the browser's own copy takes exactly the right text. Ctrl+X is the same copy plus a
                   clear, so only the clear is ours — and it has to run after the browser has read the
                   proxy, hence the timeout. */
                if (ctrl && (k === 'x' || k === 'X')) {
                    var x1 = Math.min(XL.r, XL.ar), x2 = Math.max(XL.r, XL.ar), y1 = Math.min(XL.c, XL.ac), y2 = Math.max(XL.c, XL.ac);
                    setTimeout(function () {
                        xlSnapshot();
                        for (var r = x1; r <= x2; r++) for (var c = y1; c <= y2; c++) xlSet(r, c, '', false);
                        xlRender();
                    }, 0);
                    return;
                }
                if (ctrl && (k === 'c' || k === 'C')) return;
                switch (k) {
                    case 'ArrowUp':    xlGo(XL.r - 1, XL.c, e.shiftKey); e.preventDefault(); return;
                    case 'ArrowDown':  if (e.altKey) { xlBeginEdit(''); } else { xlGo(XL.r + 1, XL.c, e.shiftKey); } e.preventDefault(); return;
                    case 'ArrowLeft':  xlGo(XL.r, XL.c - 1, e.shiftKey); e.preventDefault(); return;
                    case 'ArrowRight': xlGo(XL.r, XL.c + 1, e.shiftKey); e.preventDefault(); return;
                    case 'Tab':        xlGo(XL.r, XL.c + (e.shiftKey ? -1 : 1), false); e.preventDefault(); return;
                    case 'Enter':      xlGo(XL.r + (e.shiftKey ? -1 : 1), XL.c, false); e.preventDefault(); return;
                    case 'F2':         xlBeginEdit(); e.preventDefault(); return;
                    case 'Home':       xlGo(ctrl ? 0 : XL.r, 0, e.shiftKey); e.preventDefault(); return;
                    case 'End':        xlGo(ctrl ? XL.rows.length - 1 : XL.r, XLCOLS.length - 1, e.shiftKey); e.preventDefault(); return;
                    case 'Delete':
                    case 'Backspace': {
                        xlSnapshot();
                        var d1 = Math.min(XL.r, XL.ar), d2 = Math.max(XL.r, XL.ar), e1 = Math.min(XL.c, XL.ac), e2 = Math.max(XL.c, XL.ac);
                        for (r = d1; r <= d2; r++) for (c = e1; c <= e2; c++) xlSet(r, c, '', false);
                        xlRender(); e.preventDefault(); return;
                    }
                }
                /* type-to-replace, exactly as Excel does */
                if (!ctrl && !e.altKey && k.length === 1) { xlBeginEdit(k); e.preventDefault(); }
            });

            ed.addEventListener('input', function () { XL.li = -1; xlList(); });
            /* Excel commits a cell when the focus leaves it. Without this, anything typed was lost the
               moment the user clicked elsewhere — including on Save. The list and the dropdown arrow
               both cancel their mousedown, so choosing from either does not count as leaving. */
            ed.addEventListener('blur', function () { if (XL.editing) xlEndEdit(true); });
            ed.addEventListener('keydown', function (e) {
                var box = document.getElementById('xlList'), hits = box._hits || [];
                if (!box.classList.contains('d-none') && hits.length) {
                    if (e.key === 'ArrowDown') { XL.li = Math.min(XL.li + 1, hits.length - 1); xlList(); e.preventDefault(); return; }
                    if (e.key === 'ArrowUp') { XL.li = Math.max(XL.li - 1, 0); xlList(); e.preventDefault(); return; }
                    if ((e.key === 'Enter' || e.key === 'Tab') && XL.li >= 0) { ed.value = hits[XL.li].text; }
                }
                if (e.key === 'Enter') { xlEndEdit(true, e.shiftKey ? -1 : 1, 0); e.preventDefault(); }
                else if (e.key === 'Tab') { xlEndEdit(true, 0, e.shiftKey ? -1 : 1); e.preventDefault(); }
                else if (e.key === 'Escape') { xlEndEdit(false); e.preventDefault(); }
            });
            document.getElementById('xlList').addEventListener('mousedown', function (e) {
                var d = e.target.closest('div[data-text]'); if (!d) return;
                ed.value = d.dataset.text; xlEndEdit(true, 1, 0); e.preventDefault();
            });

            document.getElementById('xlFormula').addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                xlSet(XL.r, XL.c, this.value); xlRender(); xlSyncProxy(); e.preventDefault();
            });
            document.getElementById('xlInsert').addEventListener('click', function () { xlSnapshot(); XL.rows.splice(XL.r, 0, xlBlank()); xlRender(); xlSyncProxy(); });
            document.getElementById('xlDelete').addEventListener('click', function () { xlSnapshot(); XL.rows.splice(XL.r, 1); xlPad(); xlRender(); xlSyncProxy(); });
            document.getElementById('xlFill').addEventListener('click', function () {
                xlSnapshot();
                var a1 = Math.min(XL.r, XL.ar), a2 = Math.max(XL.r, XL.ar), b1 = Math.min(XL.c, XL.ac), b2 = Math.max(XL.c, XL.ac);
                for (var c = b1; c <= b2; c++) for (var r = a1 + 1; r <= a2; r++) xlSet(r, c, xlRaw(a1, c), false);
                xlRender(); xlSyncProxy();
            });
            document.getElementById('xlUndo').addEventListener('click', function () { if (XL.undo.length) { XL.rows = JSON.parse(XL.undo.pop()); xlRender(); } xlSyncProxy(); });

            /* Paste lands on the proxy because the proxy holds the focus and is editable. Copy and
               cut are deliberately absent: the browser's own handling of the proxy is already right. */
            px.addEventListener('paste', function (e) {
                if (!XL.on || XL.editing) return;
                var t = (e.clipboardData || window.clipboardData).getData('text'); if (!t) return;
                xlPaste(t); e.preventDefault();
            });
            /* A click lands on the cell, not on the proxy, so the focus has to be handed back. */
            sc.addEventListener('click', function () { if (!XL.editing) xlSyncProxy(); });
            /* An empty seed means the filter matches everything, so the arrow opens the whole list
               while typing still narrows it. */
            document.getElementById('xlArrow').addEventListener('mousedown', function (e) { e.preventDefault(); xlBeginEdit(''); });
        })();

        // An edit starts with the entry's own lines; a create starts with two empty ones.
        var EXISTING = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ExistingLines ?? new List<object>(), CamelCase));
        if (EXISTING && EXISTING.length) {
            EXISTING.forEach(function (l) {
                addRow();
                var tr = document.getElementById('rows').lastElementChild;
                tr.querySelector('.acc').value = l.accountId;
                tr.querySelector('.dr').value = l.debit;
                tr.querySelector('.cr').value = l.credit;
                if (l.costCenterId) tr.querySelector('.cc').value = l.costCenterId;
                if (l.projectId && tr.querySelector('.prj')) tr.querySelector('.prj').value = l.projectId;
                tr.querySelector('.desc').value = l.description || '';
            });
            recalc();
        } else { addRow(); addRow(); }
    </script>
}
