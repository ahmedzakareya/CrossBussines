                if (f === 'SUM') return String(v.reduce(function (x, y) { return x + y; }, 0));
                if (f === 'COUNT') return String(v.filter(function (x) { return x !== 0; }).length);
                if (f === 'MIN') return String(Math.min.apply(null, v));
