@using CrossBuy.BL
@using CrossBuy.Models.Context.Accounting
@model List<ReconLine>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var banks = ViewBag.Banks as List<BankAccount> ?? new();
    var bankId = ViewBag.BankAccountId as int?;
    var stDate = ViewBag.StatementDate as DateTime?;
    var bank = ViewBag.Bank as BankAccount;
    var book = (decimal?)ViewBag.BookBalance ?? 0;
}
<style>
    /* selected (cleared) row highlight */
    #reconTable tbody tr.recon-selected { background: #E7F0FF !important; }
    #reconTable tbody tr.recon-selected td:first-child { box-shadow: inset 3px 0 0 #0E4A9E; }
    #reconTable tbody tr { cursor: pointer; }
    /* inset first/last column so content doesn't hug the edges */
    #reconTable > :not(caption) > * > *:first-child { padding-inline-start: 1.25rem; }
    #reconTable > :not(caption) > * > *:last-child { padding-inline-end: 1.25rem; }
</style>
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Bank Reconciliation"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Reconcile"]</li></ul></div>
        <a href="@Url.Action("Reconciliations","Accounting")" class="btn btn-sm btn-light">@Localizer["Past reconciliations"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body py-4">
            <form method="get" class="d-flex flex-wrap align-items-end gap-3">
                <div><label class="fw-semibold fs-7 text-muted mb-1 d-block">@Localizer["Bank account"]</label>
                    <select name="bankAccountId" class="form-select form-select-sm form-select-solid w-250px" required>
                        <option value="">@Localizer["Select"]</option>
                        @foreach (var b in banks) { <option value="@b.ID" selected="@(bankId == b.ID)">@(isAr ? b.BankName : (b.BankNameEn ?? b.BankName))</option> }
                    </select></div>
                <div><label class="fw-semibold fs-7 text-muted mb-1 d-block">@Localizer["Statement date"]</label><input type="date" name="statementDate" class="form-control form-control-sm form-control-solid" value="@((stDate ?? new DateTime(2026,5,31)).ToString("yyyy-MM-dd"))" /></div>
                <button class="btn btn-sm btn-primary">@Localizer["Load"]</button>
            </form>
        </div></div>

        @if (bank != null)
        {
            <form asp-action="DoReconcile" method="post">@Html.AntiForgeryToken()
                <input type="hidden" name="bankAccountId" value="@bank.ID" />
                <input type="hidden" name="statementDate" value="@((stDate ?? new DateTime(2026,5,31)).ToString("yyyy-MM-dd"))" />
                <div class="card">
                    <div class="card-header pt-6 pb-4 d-flex justify-content-between align-items-end flex-wrap gap-4 min-h-auto">
                        <div class="d-flex flex-column justify-content-center">
                            <h3 class="card-title fw-bold m-0">@(isAr ? bank.BankName : (bank.BankNameEn ?? bank.BankName))</h3>
                            <span class="text-muted fs-7">@Localizer["Book balance"]: <b id="bookBal" data-book="@book">@book.ToString("N2")</b></span>
                        </div>
                        <div class="d-flex align-items-end gap-3">
                            <div><label class="fw-semibold fs-7 text-muted mb-1 d-block">@Localizer["Statement balance"]</label><input name="statementBalance" id="stBal" type="number" step="0.01" class="form-control form-control-sm form-control-solid w-160px" value="0" /></div>
                            <button class="btn btn-sm btn-primary"><i class="ki-outline ki-check fs-5"></i>@Localizer["Save reconciliation"]</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-6 mb-5">
                            <div class="border border-gray-300 border-dashed rounded py-3 px-5"><div class="fs-7 text-muted">@Localizer["Cleared balance"]</div><div class="fs-3 fw-bold" id="clearedBal" style="color:#0E4A9E;">@bank.OpeningBalance.ToString("N2")</div></div>
                            <div class="border border-gray-300 border-dashed rounded py-3 px-5"><div class="fs-7 text-muted">@Localizer["Difference"]</div><div class="fs-3 fw-bold" id="diff">0.00</div></div>
                        </div>
                        <div class="table-responsive"><table class="table table-row-dashed align-middle gy-3 mb-0" id="reconTable" style="font-variant-numeric:tabular-nums;">
                            <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th style="width:60px" class="text-center">@Localizer["Cleared"]</th><th>@Localizer["Entry No"]</th><th>@SR["Date"]</th><th>@SR["Description"]</th><th class="text-end">@SR["Debit"]</th><th class="text-end">@SR["Credit"]</th></tr></thead>
                            <tbody>
                            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-10">@Localizer["No transactions up to this date"]</td></tr> }
                            @foreach (var l in Model)
                            {
                                <tr>
                                    <td class="text-center"><div class="form-check form-check-custom form-check-solid form-check-sm d-inline-flex"><input type="checkbox" class="form-check-input clr" name="clearedLineIds" value="@l.LineId" data-amt="@((l.Debit - l.Credit).ToString(System.Globalization.CultureInfo.InvariantCulture))" @(l.Cleared ? "checked" : "") /></div></td>
                                    <td><span class="badge fs-8 fw-bold" style="background:#E7F0FF;color:#0E4A9E;">@l.EntryNo</span></td>
                                    <td class="text-muted">@l.Date.ToString("yyyy/MM/dd")</td>
                                    <td class="text-gray-700">@l.Description</td>
                                    <td class="text-end @(l.Debit>0?"fw-bold":"text-muted")">@l.Debit.ToString("N2")</td>
                                    <td class="text-end @(l.Credit>0?"fw-bold":"text-muted")">@l.Credit.ToString("N2")</td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                    </div>
                </div>
            </form>
            @section Scripts {
                <script>
                (function(){
                    var opening = @bank.OpeningBalance.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    function recompute(){
                        var cleared = opening;
                        document.querySelectorAll('.clr:checked').forEach(function(c){ cleared += parseFloat(c.getAttribute('data-amt'))||0; });
                        var st = parseFloat(document.getElementById('stBal').value)||0;
                        document.getElementById('clearedBal').textContent = cleared.toFixed(2);
                        var diff = st - cleared;
                        var d = document.getElementById('diff'); d.textContent = diff.toFixed(2);
                        d.className = 'fs-3 fw-bold ' + (Math.abs(diff)<0.005 ? 'text-primary' : 'text-danger');
                    }
                    function mark(c){ var tr = c.closest('tr'); if (tr) tr.classList.toggle('recon-selected', c.checked); }
                    document.querySelectorAll('.clr').forEach(function(c){
                        mark(c);
                        c.addEventListener('change', function(){ mark(c); recompute(); });
                    });
                    // click anywhere on the row to toggle its checkbox
                    document.querySelectorAll('#reconTable tbody tr').forEach(function(tr){
                        tr.addEventListener('click', function(e){
                            if (e.target.closest('input, label, a, button')) return;
                            var c = tr.querySelector('.clr'); if (!c) return;
                            c.checked = !c.checked; mark(c); recompute();
                        });
                    });
                    document.getElementById('stBal').addEventListener('input', recompute);
                    recompute();
                })();
                </script>
            }
        }
    </div></div>
</div>
