@using CrossBuy.Models.Context.Accounting
@model DepreciationRun
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var assets = ViewBag.AssetNames as Dictionary<int, FixedAsset> ?? new();
    string AssetName(int id) => assets.TryGetValue(id, out var a) ? (a.AssetNo + " — " + (isAr ? a.Name : (a.NameEn ?? a.Name))) : id.ToString();
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Depreciation"] @Model.PeriodDate.ToString("yyyy/MM")</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("DepreciationRuns","Accounting")" class="text-muted">@Localizer["Monthly Depreciation"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Model.PeriodDate.ToString("yyyy/MM")</li></ul></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("DepreciationRuns","Accounting")" class="btn btn-sm btn-light">@SR["Back"]</a>
            @if (Model.JournalEntryId.HasValue) { <a href="@Url.Action("JournalEntry","Accounting", new { id = Model.JournalEntryId })" class="btn btn-sm" style="background:#E7F0FF;color:#0E4A9E;"><i class="ki-outline ki-document fs-5" style="color:#0E4A9E;"></i>@Localizer["Depreciation JV"]</a> }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body py-5"><div class="row g-5">
            <div class="col-md-3"><div class="fs-7 text-muted">@Localizer["Period"]</div><div class="fw-bold fs-4">@Model.PeriodDate.ToString("yyyy/MM")</div></div>
            <div class="col-md-3"><div class="fs-7 text-muted">@Localizer["Run date"]</div><div class="fw-bold fs-4">@Model.RunDate.ToString("yyyy/MM/dd")</div></div>
            <div class="col-md-3"><div class="fs-7 text-muted">@Localizer["Assets"]</div><div class="fw-bold fs-4">@Model.AssetCount</div></div>
            <div class="col-md-3"><div class="fs-7 text-muted">@SR["Total"]</div><div class="fw-bold fs-4" style="color:#0E4A9E;">@Model.TotalAmount.ToString("N2")</div></div>
        </div></div></div>
        <div class="card"><div class="card-body">
            <div class="table-responsive"><table class="table table-row-dashed align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th>@Localizer["Asset"]</th><th class="text-end">@SR["Amount"]</th><th class="text-end">@Localizer["Accumulated"]</th><th class="text-end">@Localizer["Net book value"]</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lines) {
                    <tr><td><a href="@Url.Action("FixedAssetDetail","Accounting", new { id = l.FixedAssetId })" class="fw-bold text-gray-900 text-hover-primary">@AssetName(l.FixedAssetId)</a></td><td class="text-end fw-bold text-gray-900">@l.Amount.ToString("N2")</td><td class="text-end text-muted">@l.AccumulatedAfter.ToString("N2")</td><td class="text-end fw-bold">@l.NetBookValueAfter.ToString("N2")</td></tr>
                }
                </tbody>
                <tfoot><tr class="fw-bolder fs-5" style="background:#E7F0FF;border-top:2px solid #0E4A9E;"><td class="text-end" style="color:#145DBF;">@SR["Total"]</td><td class="text-end" style="color:#0E4A9E;">@Model.TotalAmount.ToString("N2")</td><td colspan="2"></td></tr></tfoot>
            </table></div>
        </div></div>
    </div></div>
</div>
