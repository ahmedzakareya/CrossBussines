@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<PurchaseInvoice>
@foreach (var i in Model)
{
    <tr class="r" style="border-bottom:1px dashed #eef1f6;">
        <td class="ps-4 fw-bold text-gray-800">@i.InvoiceNo</td>
        <td class="text-muted">@i.InvoiceDate.ToString("yyyy/MM/dd")</td>
        <td class="text-end">@i.SubTotal.ToString("N2")</td>
        <td class="text-end text-muted">@i.TaxTotal.ToString("N2")</td>
        <td class="text-end fw-bold">@i.GrandTotal.ToString("N2")</td>
        <td class="text-center"><span class="badge fw-bold" style="@(i.Status=="Posted"?"background:#eaf3ef;color:#13433a;":"background:#f2f4f7;color:#475467;")">@i.Status</span></td>
        <td class="text-center pe-4"><div class="d-flex justify-content-center gap-1">
            <a href="@Url.Action("PurchaseInvoiceDetail","Accounting", new { id = i.ID })" class="btn btn-sm btn-icon btn-light-primary" title="@Localizer["Open"]"><i class="ki-outline ki-eye fs-6"></i></a>
            @if (i.Status == "Posted") { <a href="@Url.Action("EditPurchaseInvoice","Accounting", new { id = i.ID })" class="btn btn-sm btn-icon" style="background:#eaf3ef;color:#13433a;" title="@SR["Edit"]"><i class="ki-outline ki-pencil fs-6"></i></a> }
        </div></td>
    </tr>
}
