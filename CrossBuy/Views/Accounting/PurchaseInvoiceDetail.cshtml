@using CrossBuy.Models.Context.Accounting
@model PurchaseInvoice
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var ven = ViewBag.Vendor as Vendor;
    var vendorName = ven == null ? "—" : (isAr ? ven.Name : (ven.NameEn ?? ven.Name));
    var lineCount = Model.Lines?.Count ?? 0;
    // The item name is the primary text and the description sits under it. A blank description
    // simply does not render, rather than leaving an empty second line on every row.
    var lineItemNames = ViewBag.LineItemNames as Dictionary<int, string[]> ?? new Dictionary<int, string[]>();
    Func<int?, string> itemName = id =>
    {
        if (id == null || !lineItemNames.TryGetValue(id.Value, out var pair)) return "";
        var ar = pair.Length > 0 ? pair[0] : "";
        var en = pair.Length > 1 ? pair[1] : "";
        return isAr ? (string.IsNullOrWhiteSpace(ar) ? en : ar) : (string.IsNullOrWhiteSpace(en) ? ar : en);
    };
    Func<PurchaseInvoiceLine, string> lineDesc = l =>
        !isAr && !string.IsNullOrWhiteSpace(l.ItemDescriptionEn) ? l.ItemDescriptionEn : (l.ItemDescription ?? "");
    @* The legacy CommentEntityType/CommentEntityId pair fed _DocTimeline and is dead now that the
       conversation comes from the Communication Platform. Note it also hardcoded the string
       "PurchaseInvoice" rather than the frozen EntityRegistry constant — a literal that could drift
       away from the registry silently. The replacement below uses the constant. *@
}
<div class="d-flex flex-column flex-column-fluid">

    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Purchase Invoice"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="@Url.Action("PurchaseInvoices","Accounting")" class="text-muted text-hover-primary">@Localizer["Purchases"]</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted"><bdi dir="ltr">@Model.InvoiceNo</bdi></li>
                </ul>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

            @*  THE RECORD HEADER, built on the theme's own record page (demo39 apps/projects/project.html):
                an icon tile, the title with its status beside it, the owning party underneath, the actions
                on the far side, and a row of dashed stat boxes. The sales invoice carries the same head -
                the two screens are the same kind of record and should not read as two designs. *@
            <div class="card mb-6">
                <div class="card-body py-8">
                    <div class="d-flex flex-wrap flex-sm-nowrap">
                        <div class="d-flex flex-center flex-shrink-0 bg-light-primary rounded w-100px h-100px me-7 mb-4">
                            <i class="ki-outline ki-bill fs-3x text-primary" aria-hidden="true"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                                <div class="d-flex flex-column">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="text-gray-900 fs-2 fw-bold me-3"><bdi dir="ltr">@Model.InvoiceNo</bdi></span>
                                        @*  The accounting status palette is deliberate and is NOT the generic badge
                                            vocabulary - kept exactly as it was so this screen keeps agreeing with the
                                            rest of the module. *@
                                        <span class="badge fw-bold" style="@(Model.Status == "Posted" ? "background:#E7F0FF;color:#0E4A9E;" : "background:#f2f4f7;color:#475467;")">@Model.Status</span>
                                    </div>
                                    <div class="d-flex flex-wrap fw-semibold mb-4 fs-6 text-gray-500">
                                        <span class="d-flex align-items-center text-gray-500 me-5">
                                            <i class="ki-outline ki-profile-circle fs-4 me-1" aria-hidden="true"></i>@vendorName
                                        </span>
                                        <span class="d-flex align-items-center text-gray-500">
                                            <i class="ki-outline ki-calendar fs-4 me-1" aria-hidden="true"></i>
                                            @*  InvariantCulture on purpose: the Arabic culture injects RIGHT-TO-LEFT MARKs
                                                (U+200F) around the separators, and those marks inside an isolated run still
                                                reorder it on screen. A machine-format date carries no language. *@
                                            <bdi dir="ltr">@Model.InvoiceDate.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture)</bdi>
                                        </span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-4">
                                    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
                                    {
                                        ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.AccountingPurchaseInvoiceDetail,
                                        DocumentId = Model.ID.ToString(),
                                    })
                                    @if (Model.JournalEntryId.HasValue)
                                    {
                                        <a href="@Url.Action("JournalEntry","Accounting", new { id = Model.JournalEntryId })" class="btn btn-sm btn-primary">@Localizer["Linked entry"]</a>
                                    }
                                    <a href="@Url.Action("PurchaseInvoices","Accounting")" class="btn btn-sm btn-bg-light btn-active-color-primary">@SR["Back"]</a>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap">
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                    <div class="fs-4 fw-bold" dir="ltr">@Model.GrandTotal.ToString("N2")</div>
                                    <div class="fw-semibold fs-6 text-gray-500">@SR["GrandTotal"]</div>
                                </div>
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                    <div class="fs-4 fw-bold" dir="ltr">@Model.SubTotal.ToString("N2")</div>
                                    <div class="fw-semibold fs-6 text-gray-500">@SR["Subtotal"]</div>
                                </div>
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                    <div class="fs-4 fw-bold" dir="ltr">@Model.TaxTotal.ToString("N2")</div>
                                    <div class="fw-semibold fs-6 text-gray-500">@SR["Tax"]</div>
                                </div>
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 mb-3">
                                    <div class="fs-4 fw-bold" dir="ltr">@lineCount</div>
                                    <div class="fw-semibold fs-6 text-gray-500">@Localizer["Lines"]</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-6">
                <div class="card-header align-items-center">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-900">@Localizer["Lines"]</span>
                        <span class="text-muted mt-1 fw-semibold fs-7">@Localizer["Invoice lines and totals"]</span>
                    </h3>
                    <div class="card-toolbar"><span class="badge badge-light-primary fs-8 fw-bold">@lineCount</span></div>
                </div>
                <div class="card-body">
            <div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">#</th><th>@SR["Item name"]</th><th>@SR["Description"]</th><th class="text-end">@Localizer["Qty"]</th><th class="text-end">@SR["Price"]</th><th class="text-end">@Localizer["Tax%"]</th><th class="text-end pe-4">@SR["Total"]</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
                {
                    <tr class="cb-row"><td class="ps-4 text-muted">@l.LineNo</td><td class="fw-semibold text-gray-800">@{ var __n = itemName(l.ItemId); var __d = lineDesc(l); }@(string.IsNullOrWhiteSpace(__n) ? "—" : __n)</td><td class="text-gray-700">@(string.IsNullOrWhiteSpace(__d) ? "—" : __d)</td><td class="text-end">@l.Qty.ToString("N2")</td><td class="text-end">@l.UnitPrice.ToString("N2")</td><td class="text-end text-muted">@l.TaxRate.ToString("N0")%</td><td class="text-end fw-bold pe-4">@l.LineTotal.ToString("N2")</td></tr>
                }
                </tbody>
            </table></div>
            <div class="d-flex justify-content-end mt-5"><div class="w-300px">
                <div class="d-flex flex-stack mb-2"><span class="text-muted">@SR["Subtotal"]</span><span class="fw-bold">@Model.SubTotal.ToString("N2")</span></div>
                <div class="d-flex flex-stack mb-2"><span class="text-muted">@SR["Tax"]</span><span class="fw-bold">@Model.TaxTotal.ToString("N2")</span></div>
                <div class="separator my-2"></div>
                <div class="d-flex flex-stack fs-4"><span class="fw-bold">@SR["GrandTotal"]</span><span class="fw-bold text-primary">@Model.GrandTotal.ToString("N2")</span></div>
            </div></div>
        </div></div>
        @{
            // Platform Kernel slice 2 — the business-event timeline sits above the existing comments widget,
            // exactly as on the sales invoice. Both key off the same canonical IEntityRegistry code.
            ViewBag.TimelineEntityType = CrossBuy.BL.Platform.EntityRegistry.PurchaseInvoice;
            ViewBag.TimelineEntityId = Model.ID;
        }
        @await Html.PartialAsync("_DocEventTimeline")
        @* BUSINESS CONVERSATION — see the note in SalesInvoiceDetail. Same panel, same platform, only
           the entity code differs; that is the whole point of routing through CommEntityRef instead of
           writing a per-module comment widget. Replaces _DocTimeline so one store stays authoritative. *@
        @* The conversation endpoints are named HERE, not inside the shared partial. Accounting keeps
           the two actions it has always used; the partial no longer resolves them on its behalf. *@
        @{
            ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.PurchaseInvoice;
            ViewBag.ConversationEntityId = Model.ID;
            ViewBag.ConversationListUrl = Url.Action("InvoiceConversation", "Accounting");
            ViewBag.ConversationMentionUrl = Url.Action("InvoiceConversationMentions", "Accounting");
            ViewBag.ConversationAddUrl = Url.Action("InvoiceConversationAdd", "Accounting");
            ViewBag.ConversationReactUrl = Url.Action("InvoiceConversationReact", "Accounting");

            @* COMMUNICATION PHASE 3. Both endpoints live on the TASKS controller, not this module:
               the conversation is this screen's, the work is Tasks'. Naming them here is what opts
               this screen in - the shared partial resolves no url on a caller's behalf, so a screen
               that omits these two keeps exactly its previous behaviour.

               This record type is EligibleForTaskLink in the entity registry, which is the other half
               of the opt-in: a url on a type the registry refuses would offer work that cannot be
               linked. *@
            ViewBag.ConversationCreateTaskUrl = Url.Action("CreateFromMessage", "Tasks");
            ViewBag.ConversationTasksUrl = Url.Action("ForConversation", "Tasks");
            ViewBag.ConversationApprovalsUrl = Url.Action("ConversationApprovals", "Tasks");
            @* LINKING AN EXISTING TASK. Three endpoints, named by the HOST because the partial
               resolves none on a caller's behalf - the SHF rule on this file says so, and the
               reason is that a second module including the panel would otherwise post its
               messages at this module's controller, against a permission gate written for this
               record. The panel reveals the button only when all three are present AND the
               service reports LinkingAvailable, so a deployment without the CommTaskLinks table
               shows nothing rather than a button that refuses. *@
            ViewBag.ConversationLinkUrl = Url.Action("LinkConversation", "Tasks");
            ViewBag.ConversationUnlinkUrl = Url.Action("UnlinkConversation", "Tasks");
            ViewBag.ConversationLinkSearchUrl = Url.Action("LinkCandidates", "Tasks");
        }
        @await Html.PartialAsync("_EntityConversation")
    </div></div>
</div>

@* The shared report dialog — see Views/Shared/_ReportPreviewModal.cshtml. *@
@await Html.PartialAsync("_ReportPreviewModal", (object)"Purchase invoice")

