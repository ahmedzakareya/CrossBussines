@using CrossBuy.Models.Context.Accounting
@model PurchaseInvoice
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var ven = ViewBag.Vendor as Vendor;
    @* The legacy CommentEntityType/CommentEntityId pair fed _DocTimeline and is dead now that the
       conversation comes from the Communication Platform. Note it also hardcoded the string
       "PurchaseInvoice" rather than the frozen EntityRegistry constant — a literal that could drift
       away from the registry silently. The replacement below uses the constant. *@
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Purchase Invoice"] @Model.InvoiceNo</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("PurchaseInvoices","Accounting")" class="text-muted">@Localizer["Purchases"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Model.InvoiceNo</li></ul></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("PurchaseInvoices","Accounting")" class="btn btn-sm btn-light">@SR["Back"]</a>
            @if (Model.JournalEntryId.HasValue) { <a href="@Url.Action("JournalEntry","Accounting", new { id = Model.JournalEntryId })" class="btn btn-sm btn-light-primary">@Localizer["Linked entry"]</a> }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body py-5"><div class="row g-5">
            <div class="col-md-5"><div class="fs-7 text-muted">@SR["Vendor"]</div><div class="fw-bold fs-5">@(ven == null ? "—" : (isAr ? ven.Name : (ven.NameEn ?? ven.Name)))</div></div>
            <div class="col-md-4"><div class="fs-7 text-muted">@SR["Date"]</div><div class="fw-bold fs-5">@Model.InvoiceDate.ToString("yyyy/MM/dd")</div></div>
            <div class="col-md-3"><div class="fs-7 text-muted">@SR["Status"]</div><div><span class="badge fw-bold" style="@(Model.Status == "Posted" ? "background:#eaf3ef;color:#13433a;" : "background:#f2f4f7;color:#475467;")">@Model.Status</span></div></div>
        </div></div></div>
        <div class="card"><div class="card-body">
            <div class="table-responsive"><table class="table align-middle gy-3" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #13433a;"><th class="ps-4">#</th><th>@SR["Description"]</th><th class="text-end">@Localizer["Qty"]</th><th class="text-end">@SR["Price"]</th><th class="text-end">@Localizer["Tax%"]</th><th class="text-end pe-4">@SR["Total"]</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
                {
                    <tr style="border-bottom:1px dashed #eef1f6;"><td class="ps-4 text-muted">@l.LineNo</td><td class="fw-semibold text-gray-800">@(!isAr && !string.IsNullOrWhiteSpace(l.ItemDescriptionEn) ? l.ItemDescriptionEn : l.ItemDescription)</td><td class="text-end">@l.Qty.ToString("N2")</td><td class="text-end">@l.UnitPrice.ToString("N2")</td><td class="text-end text-muted">@l.TaxRate.ToString("N0")%</td><td class="text-end fw-bold pe-4">@l.LineTotal.ToString("N2")</td></tr>
                }
                </tbody>
            </table></div>
            <div class="d-flex justify-content-end mt-5"><div class="w-300px">
                <div class="d-flex flex-stack mb-2"><span class="text-muted">@SR["Subtotal"]</span><span class="fw-bold">@Model.SubTotal.ToString("N2")</span></div>
                <div class="d-flex flex-stack mb-2"><span class="text-muted">@SR["Tax"]</span><span class="fw-bold">@Model.TaxTotal.ToString("N2")</span></div>
                <div class="separator my-2"></div>
                <div class="d-flex flex-stack fs-4"><span class="fw-bold">@SR["GrandTotal"]</span><span class="fw-bold text-primary">@Model.GrandTotal.ToString("N2")</span></div>
            </div></div>
        </div></div>
        @{
            // Platform Kernel slice 2 — the business-event timeline sits above the existing comments widget,
            // exactly as on the sales invoice. Both key off the same canonical IEntityRegistry code.
            ViewBag.TimelineEntityType = CrossBuy.BL.Platform.EntityRegistry.PurchaseInvoice;
            ViewBag.TimelineEntityId = Model.ID;
        }
        @await Html.PartialAsync("_DocEventTimeline")
        @* BUSINESS CONVERSATION — see the note in SalesInvoiceDetail. Same panel, same platform, only
           the entity code differs; that is the whole point of routing through CommEntityRef instead of
           writing a per-module comment widget. Replaces _DocTimeline so one store stays authoritative. *@
        @* The conversation endpoints are named HERE, not inside the shared partial. Accounting keeps
           the two actions it has always used; the partial no longer resolves them on its behalf. *@
        @{
            ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.PurchaseInvoice;
            ViewBag.ConversationEntityId = Model.ID;
            ViewBag.ConversationListUrl = Url.Action("InvoiceConversation", "Accounting");
            ViewBag.ConversationAddUrl = Url.Action("InvoiceConversationAdd", "Accounting");
        }
        @await Html.PartialAsync("_EntityConversation")
    </div></div>
</div>
