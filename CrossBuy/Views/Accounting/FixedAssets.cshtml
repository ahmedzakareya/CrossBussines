@using CrossBuy.BL
@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<FixedAsset>
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var cats = ViewBag.Categories as List<AssetCategory> ?? new();
    var ccs = ViewBag.CostCenters as List<CostCenter> ?? new();
    var funding = ViewBag.FundingAccounts as List<AccountNode> ?? new();
    // brand-safe: green active / amber fully-depreciated / gray disposed (no mint/yellow)
    string StatusStyle(string s) => s switch { "Active" => "background:#E7F0FF;color:#0E4A9E;", "FullyDepreciated" => "background:#fef3e2;color:#b96a00;", _ => "background:#f2f4f7;color:#475467;" };
    string StatusName(string s) => s switch { "Active" => SR["Active"].Value, "FullyDepreciated" => Localizer["Fully dep."].Value, "Disposed" => Localizer["Disposed"].Value, _ => s };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Fixed Assets"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Fixed Assets"]</li></ul></div>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#mNew"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New asset"]</button>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><div class="d-flex align-items-center position-relative my-1">
                <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                <input type="text" id="s" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search..."]" autocomplete="off" />
            </div></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table align-middle gy-3" id="t" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                    <th class="ps-4">@SR["Number"]</th><th>@Localizer["Asset"]</th><th>@Localizer["Acquired"]</th>
                    <th class="text-end">@Localizer["Cost"]</th><th class="text-end">@Localizer["Accum. dep."]</th>
                    <th class="text-end">@Localizer["Net book value"]</th><th class="text-center">@SR["Status"]</th><th class="text-center pe-4">@Localizer["Open"]</th>
                </tr></thead>
                <tbody>
                @foreach (var a in Model) {
                    <tr class="r" data-s="@a.AssetNo @a.Name @a.NameEn" style="border-bottom:1px dashed #eef1f6;">
                        <td class="ps-4 fw-bold text-gray-800">@a.AssetNo</td>
                        <td class="fw-semibold text-gray-800">@(isAr ? a.Name : (a.NameEn ?? a.Name))</td>
                        <td class="text-muted">@a.AcquisitionDate.ToString("yyyy/MM/dd")</td>
                        <td class="text-end fw-bold">@a.Cost.ToString("N2")</td>
                        <td class="text-end text-muted">@a.AccumulatedDepreciation.ToString("N2")</td>
                        <td class="text-end fw-bold" style="color:#0E4A9E;">@a.NetBookValue.ToString("N2")</td>
                        <td class="text-center"><span class="badge fw-bold" style="@StatusStyle(a.Status)">@StatusName(a.Status)</span></td>
                        <td class="text-center pe-4"><a href="@Url.Action("FixedAssetDetail","Accounting", new { id = a.ID })" class="btn btn-sm btn-icon btn-light-primary" title="@Localizer["Open"]"><i class="ki-outline ki-eye fs-6"></i></a></td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-10">@Localizer["No assets"]</td></tr> }
                </tbody>
            </table></div></div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="mNew" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
    <form asp-action="CreateFixedAsset" method="post">@Html.AntiForgeryToken()
        <div class="modal-header"><h2 class="fw-bold">@Localizer["New fixed asset"]</h2><div class="btn btn-icon btn-sm" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-8">
            <div class="row">
                <div class="col-md-6 mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Name (AR)"]</label><input name="name" class="form-control form-control-solid" required /></div>
                <div class="col-md-6 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Name (EN)"]</label><input name="nameEn" class="form-control form-control-solid" /></div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Category"]</label>
                    <select name="categoryId" id="catSel" class="form-select form-select-solid"><option value="">—</option>@foreach (var c in cats) { <option value="@c.ID" data-life="@c.DefaultUsefulLifeMonths">@(isAr ? c.Name : (c.NameEn ?? c.Name))</option> }</select></div>
                <div class="col-md-6 mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Acquisition date"]</label><input name="acquisitionDate" type="date" class="form-control form-control-solid" value="2026-01-01" required /></div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Cost"]</label><input name="cost" type="number" step="0.01" class="form-control form-control-solid" required /></div>
                <div class="col-md-4 mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Salvage value"]</label><input name="salvageValue" type="number" step="0.01" value="0" class="form-control form-control-solid" /></div>
                <div class="col-md-4 mb-4"><label class="required fw-semibold fs-6 mb-2">@Localizer["Useful life (months)"]</label><input name="usefulLifeMonths" id="lifeInp" type="number" value="60" class="form-control form-control-solid" required /></div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-2"><label class="fw-semibold fs-6 mb-2">@Localizer["Cost center"]</label>
                    <select name="costCenterId" class="form-select form-select-solid"><option value="">—</option>@foreach (var cc in ccs) { <option value="@cc.ID">@(isAr ? cc.Name : (string.IsNullOrEmpty(cc.NameEn) ? cc.Name : cc.NameEn))</option> }</select></div>
                <div class="col-md-6 mb-2"><label class="required fw-semibold fs-6 mb-2">@Localizer["Funded from"]</label>
                    <select name="fundingAccountId" class="form-select form-select-solid" required><option value="">@Localizer["Select"]</option>@foreach (var f in funding) { <option value="@f.Id">@f.Code — @(isAr ? f.Name : DisplayName.Or(f.NameEn, f.Name))</option> }</select></div>
            </div>
            <div class="mb-2"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" /></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@SR["Cancel"]</button><button class="btn btn-primary">@Localizer["Save & post"]</button></div>
    </form>
</div></div></div>

@section Scripts {
<script>
(function(){
  var i=document.getElementById('s');var rows=[].slice.call(document.querySelectorAll('#t tbody tr.r'));
  i.addEventListener('input',function(e){var q=(e.target.value||'').trim().toLowerCase();rows.forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});
  var cat=document.getElementById('catSel');var life=document.getElementById('lifeInp');
  if(cat){cat.addEventListener('change',function(){var o=cat.options[cat.selectedIndex];var l=o&&o.getAttribute('data-life');if(l)life.value=l;});}
})();
</script>
}
