@model List<CrossBuy.Models.Context.Accounting.PayrollTaxBracket>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var s = ViewBag.Settings as CrossBuy.Models.Context.Accounting.PayrollSettings ?? new CrossBuy.Models.Context.Accounting.PayrollSettings();
    var ci = System.Globalization.CultureInfo.InvariantCulture;
    string N(decimal v) => v.ToString("0.####", ci);
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Payroll tax & insurance"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted text-hover-primary">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Payroll tax"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row">
            <div class="col-lg-4">
                <div class="card card-flush mb-5">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Calculation settings"]</h2></div></div>
                    <div class="card-body pt-2">
                        <form asp-action="SavePayrollSettings" method="post">@Html.AntiForgeryToken()
                            <div class="mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Annual personal exemption"]</label>
                                <input name="personalExemptionAnnual" type="number" step="0.01" min="0" class="form-control form-control-solid" value="@N(s.PersonalExemptionAnnual)" /></div>
                            <div class="mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Min insurable wage (monthly)"]</label>
                                <input name="siMinMonthly" type="number" step="0.01" min="0" class="form-control form-control-solid" value="@N(s.SiMinMonthly)" /></div>
                            <div class="mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Max insurable wage (monthly)"]</label>
                                <input name="siMaxMonthly" type="number" step="0.01" min="0" class="form-control form-control-solid" value="@N(s.SiMaxMonthly)" />
                                <div class="text-muted fs-8 mt-1">@Localizer["0 = no limit."]</div></div>
                            <div class="form-check form-switch mb-4">
                                <input class="form-check-input" type="checkbox" name="taxBaseExcludesEmployeeSI" value="true" id="excSi" @(s.TaxBaseExcludesEmployeeSI ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="excSi">@Localizer["Deduct employee SI before tax"]</label></div>
                            <div class="mb-4"><label class="fw-semibold fs-6 mb-2">@Localizer["Standard monthly hours (manufacturing)"]</label>
                                <input name="standardMonthlyHours" type="number" step="0.01" min="0" class="form-control form-control-solid" value="@N(s.StandardMonthlyHours)" />
                                <div class="text-muted fs-8 mt-1">@Localizer["Used to derive an employee's manufacturing hour-rate = base salary ÷ these hours (when no explicit rate is set)."]</div></div>
                            <button class="btn btn-light-primary w-100">@Localizer["Save settings"]</button>
                        </form>
                    </div>
                </div>
                <div class="card card-flush">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Add bracket"]</h2></div></div>
                    <div class="card-body pt-2">
                        <form asp-action="SavePayrollBracket" method="post">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="0" />
                            <div class="row g-3">
                                <div class="col-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Order"]</label><input name="ordinal" type="number" min="1" class="form-control form-control-solid" value="@((Model?.Count ?? 0) + 1)" required /></div>
                                <div class="col-6"><label class="fw-semibold fs-7 mb-1">@Localizer["Rate %"]</label><input name="rate" type="number" step="0.01" min="0" class="form-control form-control-solid" required /></div>
                                <div class="col-6"><label class="fw-semibold fs-7 mb-1">@Localizer["From (annual)"]</label><input name="fromAmount" type="number" step="0.01" min="0" class="form-control form-control-solid" required /></div>
                                <div class="col-6"><label class="fw-semibold fs-7 mb-1">@Localizer["To (annual)"]</label><input name="toAmount" type="number" step="0.01" min="0" class="form-control form-control-solid" placeholder="@Localizer["blank = open"]" /></div>
                            </div>
                            <button class="btn btn-primary w-100 mt-4"><i class="ki-outline ki-plus fs-3"></i>@SR["Add"]</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card card-flush">
                    <div class="card-header"><div class="card-title"><h2>@Localizer["Income-tax brackets (progressive, annual)"]</h2></div></div>
                    <div class="card-body pt-2">
                        <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3">
                            <thead class="fs-8 fw-bold text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><tr style="border-bottom:2px solid #0E4A9E;"><th>#</th><th>@SR["From"]</th><th>@SR["To"]</th><th>@Localizer["Rate"]</th><th class="text-end"></th></tr></thead>
                            <tbody class="fw-semibold text-gray-700">
                            @foreach (var b in Model ?? new())
                            {
                                <tr>
                                    <td style="width:70px"><input form="bkf_@b.ID" name="ordinal" type="number" class="form-control form-control-sm form-control-solid" value="@b.Ordinal" /></td>
                                    <td><input form="bkf_@b.ID" name="fromAmount" type="number" step="0.01" class="form-control form-control-sm form-control-solid" value="@N(b.FromAmount)" /></td>
                                    <td><input form="bkf_@b.ID" name="toAmount" type="number" step="0.01" class="form-control form-control-sm form-control-solid" value="@(b.ToAmount.HasValue ? N(b.ToAmount.Value) : "")" placeholder="@Localizer["open"]" /></td>
                                    <td style="width:120px"><div class="d-flex align-items-center gap-2"><input form="bkf_@b.ID" name="rate" type="number" step="0.01" class="form-control form-control-sm form-control-solid" value="@N(b.Rate)" /><span class="text-muted fw-semibold">%</span></div></td>
                                    <td class="text-end" style="width:120px">
                                        <button form="bkf_@b.ID" class="btn btn-icon btn-light-primary btn-sm" title="@SR["Save"]"><i class="ki-outline ki-check fs-5"></i></button>
                                        <button form="bkd_@b.ID" class="btn btn-icon btn-light-danger btn-sm" title="@SR["Delete"]"><i class="ki-outline ki-trash fs-6"></i></button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                        @foreach (var b in Model ?? new())
                        {
                            <form id="bkf_@b.ID" asp-action="SavePayrollBracket" method="post" class="d-none">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.ID" /></form>
                            <form id="bkd_@b.ID" asp-action="DeletePayrollBracket" method="post" class="d-none" data-cb-confirm data-cb-action="delete" data-cb-text="@Localizer["Delete bracket?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.ID" /></form>
                        }
                        @if (!(Model?.Any() ?? false)) { <div class="text-center text-muted py-10">@Localizer["No brackets — the flat policy rate is used until brackets are added."]</div> }
                        <div class="text-muted fs-8 mt-3">@Localizer["Taxable base = (monthly gross × 12) − employee SI (if enabled) − personal exemption. Tax computed annually then ÷ 12."]</div>
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
