@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model AccountingDashboardDto
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var monthsAr = new[] { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var monthsEn = new[] { "", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    string Money(decimal v) => v.ToString("N2");
    string StatusBadge(string s) => s switch { "Posted" => "success", "Reversed" => "dark", _ => "secondary" };
    var vatPayable = Model.VatNetDue >= 0;
    var depPct = Model.AssetCost > 0 ? (int)Math.Min(100, Math.Round(Model.AssetAccumDep / Model.AssetCost * 100)) : 0;
}

<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center gap-1">
                <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@SR["Accounting"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">@Localizer["Home"]</li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@Localizer["Financial Dashboard"]</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <span class="badge badge-light-@(Model.FiscalYearStatus == "Closed" ? "danger" : "success") fs-7 py-2 px-3">
                    <i class="ki-outline ki-calendar fs-6 me-1"></i>@Localizer["FY"] @Model.FiscalYearName · @(Model.FiscalYearStatus == "Closed" ? Localizer["Closed"] : Localizer["Open"])
                </span>
                <a href="@Url.Action("BalanceSheet","Accounting")" class="btn btn-sm btn-flex btn-light fw-bold">@Localizer["Balance Sheet"]</a>
                <a href="@Url.Action("CreateJournal","Accounting")" class="btn btn-sm btn-flex btn-primary fw-bold"><i class="ki-outline ki-plus fs-3"></i>@Localizer["New entry"]</a>
            </div>
        </div>
    </div>
    <!--end::Toolbar-->

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div class="app-container container-fluid">

            <!--begin::Row 1 — trend chart + financial-position card-->
            <div class="row g-5 gx-xl-10 mb-5 mb-xl-10">
                <!--begin::Revenue vs Expense-->
                <div class="col-xl-8">
                    <div class="card card-flush h-lg-100">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-900">@Localizer["Revenue vs Expense"]</span>
                                <span class="text-gray-500 pt-2 fw-semibold fs-6">@Localizer["Last 6 months"]</span>
                            </h3>
                            <div class="card-toolbar">
                                <a href="@Url.Action("IncomeStatement","Accounting")" class="btn btn-sm btn-light">@Localizer["Income Statement"]</a>
                            </div>
                        </div>
                        <div class="card-body pt-0 px-3 pb-3">
                            <div id="acc_trend_chart" class="min-h-auto" style="height:330px"></div>
                            <div class="d-flex align-items-center justify-content-center gap-8 pb-2">
                                <div class="d-flex align-items-center"><span class="rounded-1 bg-success me-2 h-10px w-10px"></span><span class="fw-semibold fs-7 text-gray-600">@Localizer["Revenue"]</span></div>
                                <div class="d-flex align-items-center"><span class="rounded-1 bg-danger me-2 h-10px w-10px"></span><span class="fw-semibold fs-7 text-gray-600">@Localizer["Expense"]</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end::trend-->
                <!--begin::Financial position card (social.html campaign-card pattern: boxes + chart)-->
                <div class="col-xl-4">
                    <div class="card card-flush border-0 h-lg-100" data-bs-theme="light" style="background-color:#145DBF">
                        <div class="card-header pt-5">
                            <h3 class="card-title">
                                <span class="text-white fs-3 fw-bold me-2">@Localizer["Financial Position"]</span>
                                <span class="badge badge-@(Model.IsBalanced ? "success" : "light-danger")">@(Model.IsBalanced ? Localizer["Balanced"] : Localizer["Unbalanced"])</span>
                            </h3>
                            <div class="card-toolbar">
                                <a href="@Url.Action("BalanceSheet","Accounting")" class="btn btn-icon bg-white bg-opacity-10 btn-color-white w-25px h-25px"><i class="ki-outline ki-black-right fs-5"></i></a>
                            </div>
                        </div>
                        <div class="card-body d-flex justify-content-between flex-column pt-1 px-0 pb-0">
                            <!--begin::Stat boxes-->
                            <div class="d-flex flex-wrap px-9 mb-4">
                                <div class="rounded min-w-125px py-3 px-4 my-1 me-6" style="border:1px dashed rgba(255,255,255,0.3)">
                                    <div class="text-white fs-2 fw-bold">@Money(Model.TotalAssets)</div>
                                    <div class="fw-semibold fs-7 text-white opacity-75">@Localizer["Total Assets"]</div>
                                </div>
                                <div class="rounded min-w-125px py-3 px-4 my-1" style="border:1px dashed rgba(255,255,255,0.3)">
                                    <div class="text-white fs-2 fw-bold">@Money(Model.TotalLiabilities + Model.TotalEquity)</div>
                                    <div class="fw-semibold fs-7 text-white opacity-75">@Localizer["Liab. + Equity"]</div>
                                </div>
                            </div>
                            <!--end::Stat boxes-->
                            <!--begin::Detail rows-->
                            <div class="px-9">
                                <div class="d-flex flex-stack text-white opacity-75 mb-2"><span class="fw-semibold fs-7">@Localizer["Liabilities"]</span><span class="fw-bold fs-7">@Money(Model.TotalLiabilities)</span></div>
                                <div class="d-flex flex-stack text-white opacity-75 mb-2"><span class="fw-semibold fs-7">@Localizer["Equity"]</span><span class="fw-bold fs-7">@Money(Model.TotalEquity)</span></div>
                                <div class="d-flex flex-stack text-white"><span class="fw-bold fs-7">@Localizer["Net result"]</span><span class="fw-bold fs-7">@Money(Model.NetIncome)</span></div>
                            </div>
                            <!--end::Detail rows-->
                            <!--begin::Chart (fills the base, like the template)-->
                            <div id="acc_pos_chart" style="height:120px"></div>
                            <!--end::Chart-->
                        </div>
                    </div>
                </div>
                <!--end::Financial position-->
            </div>
            <!--end::Row 1-->

            <!--begin::Row 2 — brand-style stat cards-->
            <div class="row g-5 g-xl-10 mb-5 mb-xl-10">
                @{
                    var stats = new (string label, string value, string icon, string color, string href, string badge, string badgeColor)[] {
                        (Localizer["Cash & Banks"].Value, Money(Model.Cash), "ki-wallet", "primary", Url.Action("BankAccounts","Accounting"), Localizer["Liquid"].Value, "primary"),
                        (Localizer["Receivables"].Value, Money(Model.Receivables), "ki-people", "success", Url.Action("ArAging","Accounting"), Localizer["AR"].Value, "success"),
                        (Localizer["Payables"].Value, Money(Model.Payables), "ki-handcart", "danger", Url.Action("ApAging","Accounting"), Localizer["AP"].Value, "danger"),
                        (Localizer["Net Income {0}", Model.Year].Value, Money(Model.NetIncome), "ki-chart-line-up", Model.NetIncome >= 0 ? "info" : "warning", Url.Action("IncomeStatement","Accounting"), Model.NetIncome >= 0 ? Localizer["Profit"].Value : Localizer["Loss"].Value, Model.NetIncome >= 0 ? "success" : "danger"),
                        (Localizer["Fixed Assets NBV"].Value, Money(Model.AssetNbv), "ki-delivery-3", "dark", Url.Action("FixedAssets","Accounting"), $"{Model.AssetCount}", "dark"),
                        (vatPayable ? Localizer["VAT Payable"].Value : Localizer["VAT Credit"].Value, Money(Math.Abs(Model.VatNetDue)), "ki-percentage", vatPayable ? "warning" : "success", Url.Action("VatReturns","Accounting"), vatPayable ? Localizer["Due"].Value : SR["Credit"].Value, vatPayable ? "warning" : "success"),
                    };
                }
                @foreach (var s in stats)
                {
                    <div class="col-6 col-md-4 col-xl-2">
                        <a href="@s.href" class="card h-100 text-decoration-none">
                            <div class="card-body d-flex justify-content-between align-items-start flex-column p-5">
                                <div class="d-flex flex-stack w-100 mb-4">
                                    <div class="symbol symbol-40px">
                                        <span class="symbol-label bg-light-@s.color"><i class="ki-outline @s.icon fs-2x text-@s.color"></i></span>
                                    </div>
                                    <span class="badge badge-light-@s.badgeColor fs-8 fw-bold">@s.badge</span>
                                </div>
                                <span class="fw-bold fs-2x text-gray-900 lh-1 ls-n2">@s.value</span>
                                <div class="m-0 mt-2"><span class="fw-semibold fs-7 text-gray-500">@s.label</span></div>
                            </div>
                        </a>
                    </div>
                }
            </div>
            <!--end::Row 2-->

            <!--begin::Row 3 — recent entries table + top expenses (Notable Channels style)-->
            <div class="row g-5 g-xl-10 mb-5 mb-xl-10">
                <!--begin::Recent entries-->
                <div class="col-xl-8">
                    <div class="card card-flush h-lg-100">
                        <div class="card-header pt-7">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-900">@Localizer["Recent Journal Entries"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-6">@Model.PostedCount @Localizer["posted"] · @Model.DraftCount @Localizer["draft"]</span>
                            </h3>
                            <div class="card-toolbar"><a href="@Url.Action("Journals","Accounting")" class="btn btn-sm btn-light">@Localizer["View all"]</a></div>
                        </div>
                        <div class="card-body pt-2">
                            <div class="table-responsive"><table class="table table-row-dashed align-middle fs-6 gy-3 my-0">
                                <thead>
                                    <tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                                        <th>@Localizer["Entry"]</th><th>@SR["Date"]</th>
                                        <th class="text-end">@SR["Total"]</th><th class="text-center">@SR["Type"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Recent.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-10">@Localizer["No entries yet"]</td></tr>
                                    }
                                    @foreach (var e in Model.Recent)
                                    {
                                        var bc = StatusBadge(e.Status);
                                        <tr>
                                            <td class="min-w-200px">
                                                <div class="position-relative ps-5">
                                                    <div class="position-absolute start-0 top-0 w-4px h-100 rounded-2 bg-@bc"></div>
                                                    <span class="d-block fw-bold text-gray-900">@e.EntryNo</span>
                                                    <span class="fs-7 text-muted fw-semibold text-truncate d-block mw-250px">@e.Description</span>
                                                </div>
                                            </td>
                                            <td class="text-muted fw-semibold">@e.Date.ToString("yyyy/MM/dd")</td>
                                            <td class="text-end fw-bold text-gray-800">@Money(e.Amount)</td>
                                            <td class="text-center"><span class="badge badge-light-@bc">@e.JournalType</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        </div>
                    </div>
                </div>
                <!--end::recent-->
                <!--begin::Top expenses (Notable Channels progress list)-->
                <div class="col-xl-4">
                    <div class="card card-flush h-lg-100">
                        <div class="card-header pt-7">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-900">@Localizer["Expense Distribution"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@Localizer["Top 5 accounts"]</span>
                            </h3>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between pt-2 pb-0">
                            <div class="mb-3">
                                @if (Model.TopExpenses.Count == 0)
                                {
                                    <div class="text-center text-muted py-15">@Localizer["No expenses yet"]</div>
                                }
                                else
                                {
                                    var barColors = new[] { "success", "primary", "warning", "danger", "info" };
                                    var idx = 0;
                                    foreach (var e in Model.TopExpenses)
                                    {
                                        var bc = barColors[idx % barColors.Length]; idx++;
                                        <div class="d-flex flex-stack mb-2">
                                            <span class="text-gray-700 fw-semibold flex-grow-1 text-truncate me-3">@(isAr ? e.NameAr : DisplayName.Or(e.NameEn, e.NameAr))</span>
                                            <span class="text-gray-900 fw-bold me-3">@Money(e.Amount)</span>
                                        </div>
                                        <div class="d-flex align-items-center w-100 mb-4">
                                            <div class="progress h-6px w-100 me-2 bg-light-@bc"><div class="progress-bar bg-@bc" style="width:@(e.Pct)%"></div></div>
                                            <span class="text-gray-500 fw-semibold fs-7">@e.Pct%</span>
                                        </div>
                                    }
                                }
                            </div>
                            <div id="acc_exp_chart" style="height:90px"></div>
                        </div>
                    </div>
                </div>
                <!--end::top expenses-->
            </div>
            <!--end::Row 3-->

            <!--begin::Row 4 — fixed assets + VAT + quick access-->
            <div class="row g-5 g-xl-10 mb-5 mb-xl-10">
                <!--begin::Fixed assets-->
                <div class="col-xl-4">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-7">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-900">@Localizer["Fixed Assets"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@Model.AssetCount @Localizer["active assets"]</span>
                            </h3>
                            <div class="card-toolbar"><a href="@Url.Action("FixedAssets","Accounting")" class="btn btn-sm btn-light">@SR["View"]</a></div>
                        </div>
                        <div class="card-body pt-2">
                            <div class="d-flex flex-stack py-2"><span class="text-gray-600 fw-semibold">@Localizer["Cost"]</span><span class="fw-bold text-gray-900">@Money(Model.AssetCost)</span></div>
                            <div class="separator separator-dashed my-1"></div>
                            <div class="d-flex flex-stack py-2"><span class="text-gray-600 fw-semibold">@Localizer["Accum. dep."]</span><span class="fw-bold text-warning">(@Money(Model.AssetAccumDep))</span></div>
                            <div class="separator separator-dashed my-1"></div>
                            <div class="d-flex flex-stack py-2"><span class="text-gray-800 fw-bold">@Localizer["Net book value"]</span><span class="fw-bold fs-4 text-primary">@Money(Model.AssetNbv)</span></div>
                            <div class="progress h-6px mt-3"><div class="progress-bar bg-warning" style="width:@depPct%"></div></div>
                            <div class="text-muted fs-8 mt-1">@Localizer["Depreciated"] @depPct%</div>
                        </div>
                    </div>
                </div>
                <!--end::Fixed assets-->
                <!--begin::VAT-->
                <div class="col-xl-4">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-7">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-900">@Localizer["VAT"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@Model.Year</span>
                            </h3>
                            <div class="card-toolbar"><a href="@Url.Action("VatReturns","Accounting")" class="btn btn-sm btn-light">@Localizer["Returns"]</a></div>
                        </div>
                        <div class="card-body pt-2">
                            <div class="d-flex flex-stack py-2"><span class="text-gray-600 fw-semibold">@Localizer["Output VAT"]</span><span class="fw-bold text-gray-900">@Money(Model.VatOutput)</span></div>
                            <div class="separator separator-dashed my-1"></div>
                            <div class="d-flex flex-stack py-2"><span class="text-gray-600 fw-semibold">@Localizer["Input VAT"]</span><span class="fw-bold text-gray-900">(@Money(Model.VatInput))</span></div>
                            <div class="separator separator-dashed my-1"></div>
                            <div class="d-flex flex-stack py-2"><span class="text-gray-800 fw-bold">@(vatPayable ? Localizer["Net payable"] : Localizer["Credit balance"])</span><span class="fw-bold fs-4 text-@(vatPayable ? "danger" : "success")">@Money(Math.Abs(Model.VatNetDue))</span></div>
                        </div>
                    </div>
                </div>
                <!--end::VAT-->
                <!--begin::Quick access-->
                <div class="col-xl-4">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-7"><h3 class="card-title fw-bold text-gray-900">@Localizer["Quick Access"]</h3></div>
                        <div class="card-body pt-2">
                            <div class="row g-3">
                                @{
                                    var links = new (string action, string label, string icon, string color)[] {
                                        ("ChartOfAccounts", Localizer["Accounts"].Value, "ki-chart-pie-simple", "primary"),
                                        ("Journals", Localizer["Journals"].Value, "ki-book", "info"),
                                        ("FixedAssets", Localizer["Fixed Assets"].Value, "ki-delivery-3", "dark"),
                                        ("TaxCodes", Localizer["Taxes"].Value, "ki-percentage", "danger"),
                                        ("BalanceSheet", Localizer["Balance Sheet"].Value, "ki-chart-pie-3", "primary"),
                                        ("CashFlow", Localizer["Cash Flow"].Value, "ki-dollar", "success"),
                                        ("CostCenters", Localizer["Cost Centers"].Value, "ki-abstract-26", "warning"),
                                        ("Payroll", Localizer["Payroll"].Value, "ki-wallet", "info"),
                                        ("YearEndClose", Localizer["Year-end Close"].Value, "ki-lock-2", "dark"),
                                    };
                                }
                                @foreach (var l in links)
                                {
                                    <div class="col-4">
                                        <a href="@Url.Action(l.action,"Accounting")" class="d-flex flex-column flex-center bg-hover-light rounded h-100 py-5 border border-gray-200 text-decoration-none">
                                            <i class="ki-outline @l.icon fs-2x text-@l.color mb-2"></i>
                                            <span class="fs-8 fw-semibold text-gray-800 text-center px-1">@l.label</span>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <!--end::quick access-->
            </div>
            <!--end::Row 4-->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var isAr = @(isAr ? "true" : "false");
            var months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months.Select(m => (isAr ? monthsAr : monthsEn)[m.Month] + " " + m.Year)));
            var revenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months.Select(m => m.Revenue)));
            var expense = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months.Select(m => m.Expense)));
            var netTrend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months.Select(m => m.Revenue - m.Expense)));
            if (!window.ApexCharts) return;

            new ApexCharts(document.querySelector('#acc_trend_chart'), {
                chart: { type: 'area', height: 330, fontFamily: 'inherit', toolbar: { show: false } },
                series: [
                    { name: '@Localizer["Revenue"]', data: revenue },
                    { name: '@Localizer["Expense"]', data: expense }
                ],
                colors: ['#2f9e6e', '#F8285A'],
                xaxis: { categories: months, labels: { style: { colors: '#99A1B7' } } },
                yaxis: { labels: { style: { colors: '#99A1B7' }, formatter: function (v) { return v.toLocaleString(); } } },
                stroke: { curve: 'smooth', width: 3 },
                fill: { type: 'gradient', gradient: { opacityFrom: 0.4, opacityTo: 0.05 } },
                dataLabels: { enabled: false }, legend: { show: false },
                grid: { borderColor: '#E4E6EF', strokeDashArray: 4 },
                tooltip: { y: { formatter: function (v) { return v.toLocaleString() + ' @Localizer["EGP"]'; } } }
            }).render();

            // mini net-trend chart on the blue financial-position card
            new ApexCharts(document.querySelector('#acc_pos_chart'), {
                chart: { type: 'area', height: 120, sparkline: { enabled: true } },
                series: [{ name: '@Localizer["Net"]', data: netTrend }],
                colors: ['#FFFFFF'],
                stroke: { curve: 'smooth', width: 2 },
                fill: { type: 'gradient', gradient: { opacityFrom: 0.35, opacityTo: 0 } },
                tooltip: { theme: 'dark', y: { formatter: function (v) { return v.toLocaleString() + ' @Localizer["EGP"]'; } } }
            }).render();

            var expLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopExpenses.Select(e => isAr ? e.NameAr : DisplayName.Or(e.NameEn, e.NameAr))));
            var expData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopExpenses.Select(e => e.Amount)));
            if (expData.length) {
                new ApexCharts(document.querySelector('#acc_exp_chart'), {
                    chart: { type: 'bar', height: 90, sparkline: { enabled: true } },
                    series: [{ name: '@Localizer["Expense"]', data: expData }],
                    colors: ['#145DBF'],
                    plotOptions: { bar: { borderRadius: 4, columnWidth: '45%' } },
                    xaxis: { categories: expLabels },
                    tooltip: { y: { formatter: function (v) { return v.toLocaleString() + ' @Localizer["EGP"]'; } } }
                }).render();
            }
        })();
    </script>
}
