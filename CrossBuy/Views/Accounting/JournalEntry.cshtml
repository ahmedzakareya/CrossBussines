@using CrossBuy.Models.Context.Accounting
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model JournalEntry
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var accs = ViewBag.Accounts as Dictionary<int, string[]> ?? new();
    var ccs = ViewBag.CostCenters as Dictionary<int, string> ?? new();
    string AccName(int id) => accs.TryGetValue(id, out var a) ? a[0] + " — " + (isAr ? a[1] : a[2]) : id.ToString();
    var totD = Model.Lines.Sum(l => l.Debit); var totC = Model.Lines.Sum(l => l.Credit);
    string StatusBadge(string s) => s switch { "Posted" => "success", "Reversed" => "dark", "Draft" => "secondary", _ => "warning" };
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading fw-bold fs-3 m-0 d-flex align-items-center gap-2"><span class="text-muted fw-semibold">@Localizer["Entry"]</span><span class="text-gray-900 fw-bolder">@Model.EntryNo</span></h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Journals","Accounting")" class="text-muted">@Localizer["Journals"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Model.EntryNo</li></ul></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Journals","Accounting")" class="btn btn-sm btn-light">@SR["Back"]</a>
            @if (Model.Status == "Posted")
            {
                <form asp-action="ReverseJournal" method="post" data-cb-confirm data-cb-action="generic" data-cb-text="@Localizer["Reverse?"]">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ID" /><button class="btn btn-sm btn-light-danger"><i class="ki-outline ki-arrows-circle fs-5"></i>@Localizer["Reverse"]</button></form>
            }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Summary card-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body py-10">
                <div class="d-flex flex-stack flex-wrap gap-3 mb-2">
                    <h2 class="m-0 d-flex align-items-center gap-2"><span class="text-muted fw-semibold fs-4">@Localizer["Entry"]</span><span class="fw-bolder text-gray-900">@Model.EntryNo</span></h2>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge badge-light-info fs-7 fw-bold px-3 py-2">@Model.JournalType</span>
                        <span class="badge badge-light-@StatusBadge(Model.Status) fs-7 fw-bold px-3 py-2">@Model.Status</span>
                    </div>
                </div>
                <p class="fs-6 fw-semibold text-gray-600 py-1 m-0"><i class="ki-outline ki-calendar-8 fs-6 me-1"></i>@Model.EntryDate.ToString("yyyy/MM/dd")</p>

                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mt-6">
                    <span class="symbol symbol-45px me-5"><span class="symbol-label bg-primary"><i class="ki-outline ki-notepad fs-2x text-white"></i></span></span>
                    <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                        <div class="mb-3 mb-md-0 fw-semibold pe-5">
                            <h4 class="text-gray-900 fw-bold mb-1">@SR["Description"]</h4>
                            <div class="fs-6 text-gray-700">@(isAr ? Model.Description : (Model.DescriptionEn ?? Model.Description))</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.SourceType))
                        {
                            <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0"><i class="ki-outline ki-abstract-26 fs-6 text-white me-1"></i>@Localizer["Source"]: @Model.SourceType #@Model.SourceId</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!--end::Summary card-->

        <!--begin::Lines (double-entry journal)-->
        @{ var balanced = totD == totC; }
        <div class="card">
            <div class="card-header">
                <div class="card-title"><h3>@Localizer["Entry lines"]</h3></div>
                <div class="card-toolbar">
                    @if (balanced)
                    {
                        <span class="badge fw-bold fs-7 py-2 px-3" style="background:#E7F0FF;color:#0E4A9E;"><i class="ki-outline ki-check-circle fs-7 me-1" style="color:#0E4A9E;"></i>@(isAr ? "متوازن" : "Balanced")</span>
                    }
                    else
                    {
                        <span class="badge badge-light-danger fw-bold fs-7 py-2 px-3"><i class="ki-outline ki-cross-circle fs-7 me-1 text-danger"></i>@(isAr ? "غير متوازن" : "Unbalanced")</span>
                    }
                </div>
            </div>
            <div class="card-body pt-2 pb-5">
                <div class="table-responsive">
                    <table class="table align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                        <thead>
                            <tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;">
                                <th class="ps-4" style="width:44px;">#</th>
                                <th>@SR["Account"]</th>
                                <th>@Localizer["Cost Center"] · @SR["Note"]</th>
                                <th class="text-end" style="width:160px;border-inline-start:1px solid #e4e6ef;">@SR["Debit"]</th>
                                <th class="text-end pe-4" style="width:160px;">@SR["Credit"]</th>
                            </tr>
                        </thead>
                        <tbody class="fs-6">
                        @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
                        {
                            var a = accs.TryGetValue(l.AccountId, out var av) ? av : null;
                            var cc = l.CostCenterId.HasValue && ccs.ContainsKey(l.CostCenterId.Value) ? ccs[l.CostCenterId.Value] : "";
                            var lnote = isAr ? l.Description : (string.IsNullOrWhiteSpace(l.DescriptionEn) ? l.Description : l.DescriptionEn);
                            var meta = string.Join(" · ", new[] { cc, lnote }.Where(s => !string.IsNullOrWhiteSpace(s)));
                            <tr style="border-bottom:1px dashed #eef1f6;">
                                <td class="ps-4 text-muted fw-semibold">@l.LineNo</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="badge fw-bold fs-8 me-2" style="background:#E7F0FF;color:#145DBF;">@(a != null ? a[0] : "")</span>
                                        <span class="fw-bold text-gray-900">@(a != null ? (isAr ? a[1] : a[2]) : l.AccountId.ToString())</span>
                                    </div>
                                </td>
                                <td class="text-muted fs-7">@(string.IsNullOrEmpty(meta) ? "—" : meta)</td>
                                <td class="text-end fw-bold @(l.Debit>0?"text-gray-900":"text-gray-300")" style="border-inline-start:1px solid #eff2f5;">@(l.Debit>0 ? l.Debit.ToString("N2") : "—")</td>
                                <td class="text-end pe-4 fw-bold @(l.Credit>0?"text-gray-900":"text-gray-300")">@(l.Credit>0 ? l.Credit.ToString("N2") : "—")</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bolder fs-5" style="background:#E7F0FF;border-top:2px solid #0E4A9E;">
                                <td colspan="3" class="ps-4 text-end" style="color:#145DBF;">@SR["Total"]</td>
                                <td class="text-end" style="color:#0E4A9E;border-inline-start:1px solid #cfe7db;">@totD.ToString("N2")</td>
                                <td class="text-end pe-4" style="color:#0E4A9E;">@totC.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <!--end::Lines-->
    </div></div>
</div>
