@using CrossBuy.Models.Context.Accounting
@model List<PurchaseReturn>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var vends = (ViewBag.Vendors as List<Vendor> ?? new()).ToDictionary(v => v.ID, v => v);
    string vName(int id) => vends.TryGetValue(id, out var v) ? (isAr ? v.Name : (v.NameEn ?? v.Name)) : "—";
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Purchase Returns / Debit Notes"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@Localizer["Payables"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Returns"]</li></ul></div>
        <a href="@Url.Action("NewPurchaseReturn","Accounting")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New return"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><div class="d-flex align-items-center position-relative my-1">
                <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                <input type="text" id="s" class="form-control form-control-solid w-300px ps-12" placeholder="@Localizer["Search no / vendor..."]" autocomplete="off" />
            </div></div></div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table align-middle gy-3" id="t" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@Localizer["Note No"]</th><th>@SR["Date"]</th><th>@SR["Vendor"]</th><th>@Localizer["Orig. invoice"]</th><th class="text-end">@SR["Total"]</th><th class="text-center">@Localizer["JE"]</th><th class="text-center pe-4">@Localizer["Open"]</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr class="r" data-s="@r.ReturnNo @vName(r.VendorId)" style="border-bottom:1px dashed #eef1f6;">
                        <td class="ps-4 fw-bold text-gray-800">@r.ReturnNo</td>
                        <td class="text-muted">@r.ReturnDate.ToString("yyyy-MM-dd")</td>
                        <td>@vName(r.VendorId)</td>
                        <td class="text-muted">@(r.OriginalInvoiceId.HasValue ? "#" + r.OriginalInvoiceId : "—")</td>
                        <td class="text-end fw-bold text-danger">-@r.GrandTotal.ToString("N2")</td>
                        <td class="text-center">@if (r.JournalEntryId != null) { <a href="@Url.Action("JournalEntry","Accounting", new { id = r.JournalEntryId })" class="badge fw-bold" style="background:#E7F0FF;color:#0E4A9E;">#@r.JournalEntryId</a> } else { <span class="text-muted">—</span> }</td>
                        <td class="text-center pe-4"><div class="d-flex justify-content-center gap-1">
                            <a href="@Url.Action("PurchaseReturnDetail","Accounting", new { id = r.ID })" class="btn btn-sm btn-icon btn-light-primary" title="@Localizer["Open"]"><i class="ki-outline ki-eye fs-5"></i></a>
                            @if (r.Status == "Posted") { <a href="@Url.Action("EditPurchaseReturn","Accounting", new { id = r.ID })" class="btn btn-sm btn-icon" style="background:#E7F0FF;color:#0E4A9E;" title="@SR["Edit"]"><i class="ki-outline ki-pencil fs-6"></i></a> }
                        </div></td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-10">@Localizer["No returns"]</td></tr> }
                </tbody>
            </table></div></div>
        </div>
    </div></div>
</div>
@section Scripts {
<script>
(function(){var i=document.getElementById('s');var rows=[].slice.call(document.querySelectorAll('#t tbody tr.r'));
i.addEventListener('input',function(e){var q=(e.target.value||'').trim().toLowerCase();rows.forEach(function(r){r.style.display=(!q||(r.getAttribute('data-s')||'').toLowerCase().indexOf(q)!==-1)?'':'none';});});})();
</script>
}
