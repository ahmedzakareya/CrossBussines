@using CrossBuy.BL
@using CrossBuy.Models.Context.Accounting
@using CrossBuy.Models.Context.Inventory
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var vendors = ViewBag.Vendors as List<Vendor> ?? new();
    var expAccts = ViewBag.ExpenseAccounts as List<AccountNode> ?? new();
    var costCenters = ViewBag.CostCenters as List<CostCenter> ?? new();
    var invItems = ViewBag.InvItems as List<Item> ?? new();
    var invWh = ViewBag.InvWarehouses as List<Warehouse> ?? new();
    var currencies = ViewBag.Currencies as List<Currency> ?? new();
    int funcCur = (int)(ViewBag.FunctionalCurrencyId ?? 0);
    var edit = ViewBag.EditInvoice as PurchaseInvoice;   // P3: edit mode reuses this screen
    bool isEdit = edit != null;
    var itemBc = ViewBag.ItemBarcodes as Dictionary<int, string> ?? new();
    var editLines = isEdit ? edit!.Lines.OrderBy(l => l.LineNo).Select(l => new {
        itemId = l.ItemId, name = l.ItemDescription, wh = l.WarehouseId, bin = l.BinLocationId, d = l.ItemDescription,
        q = l.Qty, p = l.UnitPrice, disc = l.DiscountAmount, tax = l.TaxRate, acc = l.ExpenseAccountId, cc = l.CostCenterId,
        barcode = (l.ItemId != null && itemBc.ContainsKey(l.ItemId.Value)) ? itemBc[l.ItemId.Value] : ""
    }).ToList<object>() : new List<object>();
}
<style>
    /* line items laid out over TWO rows (labels above each field) — no cramped single-row horizontal scroll */
    .cb-2row thead{display:none}
    /* 6 equal columns × 2 rows — fields keep their natural order; total is second-to-last, delete last; every control the same height */
    .cb-2row #rows tr{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.55rem .75rem;padding:.9rem .5rem;border-bottom:1px solid var(--bs-gray-200)}
    .cb-2row #rows tr:last-child{border-bottom:0}
    /* THE LOCATION CELL HOLDS TWO CONTROLS, so it takes two of the six columns. At one column
       each select was about 55px wide and showed a single character - the controls existed and
       were unreadable, which is indistinguishable from not being there. */
    .cb-2row #rows tr td.loc-cell{grid-column:span 2}
    .cb-2row #rows tr td.loc-cell select{min-width:0}
    .cb-2row #rows td{display:flex;flex-direction:column;justify-content:flex-end;border:0!important;padding:0!important}
    .cb-2row #rows td::before{content:attr(data-l);font-size:.72rem;line-height:1;color:var(--bs-gray-500);font-weight:600;margin-bottom:.35rem;min-height:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .cb-2row #rows td.cb-bc-cell::before{content:"@SR["Barcode"]"}
    .cb-2row #rows td.cb-desc{grid-column:span 2}
    .cb-2row #rows td .form-control,.cb-2row #rows td .form-select,.cb-2row #rows td .select2-container{min-width:0!important;width:100%!important}
    .cb-2row #rows td .form-control{height:42px}
    .cb-2row #rows td .select2-container .select2-selection{height:42px!important;display:flex;align-items:center}
    .cb-2row #rows td.lt-cell .lt{display:flex;align-items:center;justify-content:center;height:42px;background:var(--bs-gray-100);border-radius:.475rem;font-weight:700}
    .cb-2row #rows td.cb-del-cell{align-items:stretch}
    .cb-2row #rows td.cb-del-cell .del{height:42px;width:100%}
</style>
<form asp-action="@(isEdit ? "UpdatePurchaseInvoice" : "CreatePurchaseInvoice")" method="post" id="f" class="d-flex flex-column flex-column-fluid">@Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="id" value="@edit!.ID" /> }
    <input type="hidden" name="linesJson" id="linesJson" />
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(isEdit ? SR["Edit invoice"].Value + " " + edit!.InvoiceNo : Localizer["New Purchase Invoice"].Value)</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("PurchaseInvoices","Accounting")" class="text-muted">@Localizer["Purchases"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@(isEdit ? SR["Edit"].Value : Localizer["New"].Value)</li></ul></div>
        <div class="d-flex gap-2"><a href="@Url.Action("PurchaseInvoices","Accounting")" class="btn btn-light">@SR["Cancel"]</a><button type="button" class="btn btn-primary" id="save"><i class="ki-outline ki-check fs-2"></i>@(isEdit ? SR["Save changes"].Value : Localizer["Record & post"].Value)</button></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
            <div class="card mb-5"><div class="card-body"><div class="row g-5">
                <div class="col-md-4"><label class="required fw-semibold fs-6 mb-2">@SR["Vendor"]</label>
                    <select name="vendorId" class="form-select form-select-solid" required><option value="">@Localizer["Select vendor"]</option>
                        @foreach (var v in vendors) { <option value="@v.ID" selected="@(isEdit && edit!.VendorId == v.ID)">@(isAr ? v.Name : (v.NameEn ?? v.Name))</option> }
                    </select></div>
                <div class="col-md-2"><label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label><input type="date" name="invoiceDate" class="form-control form-control-solid" value="@(isEdit ? edit!.InvoiceDate.ToString("yyyy-MM-dd") : "2026-05-01")" required /></div>
                <div class="col-md-2"><label class="fw-semibold fs-6 mb-2">@SR["Currency"]</label>
                    <select name="currencyId" id="curSel" class="form-select form-select-solid">
                        @foreach (var c in currencies) { <option value="@c.ID" selected="@(isEdit ? edit!.CurrencyId == c.ID : c.ID == funcCur)">@c.Code</option> }
                    </select></div>
                <div class="col-md-2" id="rateWrap" style="display:none"><label class="fw-semibold fs-6 mb-2">@Localizer["FX rate"]</label>
                    <input type="number" step="0.0001" min="0" name="exchangeRate" class="form-control form-control-solid" placeholder="@Localizer["Auto"]" /></div>
                <div class="col-md-2"><label class="fw-semibold fs-6 mb-2">@Localizer["Project"]</label><select name="projectId" class="form-select form-select-solid" data-control="select2" data-placeholder="@Localizer["None"]"><option value="">@Localizer["None"]</option>@foreach (var p in (ViewBag.Projects as List<(int id, string text)> ?? new())) { <option value="@p.id" selected="@(isEdit && edit!.ProjectId == p.id)">@p.text</option> }</select></div>
                <div class="col-md-2"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" value="@(isEdit ? edit!.Notes : "")" /></div>
            </div></div></div>
            <div class="card"><div class="card-header">@*  The theme pairs a card label with a muted descriptor (demo39 widgets/lists.html),
                                   so the header says what the card is AND what it holds. *@
                               <h3 class="card-title align-items-start flex-column">
                                   <span class="card-label fw-bold text-gray-900">@Localizer["Lines"]</span>
                                   <span class="text-muted mt-1 fw-semibold fs-7">@Localizer["Invoice lines"]</span>
                               </h3><div class="card-toolbar d-flex gap-2 align-items-center flex-wrap"><div class="position-relative d-flex align-items-center"><i class="ki-outline ki-barcode fs-2 position-absolute ms-3"></i><input class="form-control form-control-solid form-control-sm w-220px ps-10 js-barcode-scan" placeholder="@Localizer["Scan barcode + Enter"]" autocomplete="off" /></div><button type="button" class="btn btn-sm btn-light-primary" id="newItem"><i class="ki-outline ki-plus fs-3"></i>@SR["New item"]</button>@* Disabled until a vendor is picked, because the list it opens is that vendor's history - an enabled button whose only answer is "choose a vendor first" teaches people to ignore it. *@<button type="button" class="btn btn-sm btn-light-primary" id="copyInv" disabled><i class="ki-outline ki-copy fs-3"></i>@Localizer["Copy from invoice"]</button><button type="button" class="btn btn-sm btn-light-primary" id="add"><i class="ki-outline ki-plus fs-3"></i>@Localizer["Add line"]</button></div></div>
            <div class="card-body"><div class="table-responsive"><table class="table align-middle cb-2row"><thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                <th style="min-width:200px">@Localizer["Item (stock)"]</th><th style="min-width:130px">@SR["Warehouse"]</th><th style="min-width:150px">@Localizer["Location"]</th><th style="min-width:160px">@SR["Description"]</th><th style="width:80px">@Localizer["Qty"]</th><th style="width:110px">@SR["Price"]</th><th style="width:100px">@Localizer["Disc"]</th><th style="width:80px">@Localizer["Tax%"]</th><th style="min-width:170px">@Localizer["Expense acct"]</th><th style="min-width:140px">@Localizer["Cost ctr"]</th><th class="text-end" style="width:110px">@SR["Total"]</th><th style="width:40px"></th>
            </tr></thead><tbody id="rows"></tbody><tfoot><tr class="fw-bold"><td colspan="9" class="text-end">@Localizer["Sub / Tax / Total"]</td><td class="text-end" id="tot">0.00</td><td></td></tr></tfoot></table></div>
            </div></div>
    </div></div>
</form>
<partial name="~/Views/Shared/_DocumentLineGuard.cshtml" />
<partial name="~/Views/Inventory/_ItemScanModal.cshtml" />
<partial name="~/Views/Accounting/_CopyFromInvoiceModal.cshtml" model="@("purchase")" />
<partial name="~/Views/Shared/_QuickAdd.cshtml" />
@section Scripts {
<script>
var EXP=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(expAccts.Select(a=>new{id=a.Id,code=a.Code,name=(isAr?a.Name:DisplayName.Or(a.NameEn, a.Name))})));
var CC=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(costCenters.Select(c=>new{iD=c.ID,code=c.Code,name=(isAr?c.Name:DisplayName.Or(c.NameEn, c.Name))})));
var ITEMS=[]; var itemPickUrl='@Url.Action("ItemPickData","Inventory")';
var WH=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(invWh.Select(w=>new{iD=w.ID,code=w.Code,name=(isAr?w.Name:DisplayName.Or(w.NameEn, w.Name))})));
// SECTIONS AND RACKS, flat, with the warehouse each belongs to. A rack is listed under its
// section's code so the two read as one path (S-DRY / R-D2) instead of two unrelated codes.
var BINS=@Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.InvBins as List<CrossBuy.Models.Context.Inventory.BinLocation> ?? new()).Select(b=>new{iD=b.ID,wh=b.WarehouseId,code=b.Code,parent=b.ParentId,name=(isAr?b.Name:DisplayName.Or(b.NameEn, b.Name))})));
var BINBY={}; BINS.forEach(function(b){ BINBY[b.iD]=b; });
// TWO CONTROLS, NOT ONE LIST.
// The first version put sections and racks in a single dropdown, indented, and the owner read
// the screen as having no rack at all - which is the only verdict that matters, because that is
// what a user would have concluded too. A rack is a CHOICE INSIDE a section and an optional one;
// a flat list says neither. Two selects say both without a word of help text.
//
// The blank option on each is the point, not an empty state: a line left alone is not unlocated,
// it takes the item's own default at posting time. Saying so is what stops somebody picking a
// section 'just to be safe' and overriding a setup they did not know existed.
function label(b,p){
  var head=(p?p.code+' / ':'')+b.code;
  // a name that merely repeats the code adds nothing - 'R-D2 — رف R-D2'
  return (b.name && b.name.indexOf(b.code)<0) ? head+' — '+b.name : head;}
function secOpts(whId){
  var o='<option value="">— @(isAr ? "الافتراضي للصنف" : "item default") —</option>';
  if(!whId) return o;
  BINS.filter(function(b){return String(b.wh)===String(whId) && !b.parent;})
      .sort(function(a,b){return a.code<b.code?-1:1;})
      .forEach(function(sec){ o+='<option value="'+sec.iD+'">'+label(sec,null)+'</option>'; });
  return o;}
// A RACK ONLY EXISTS INSIDE A SECTION, so this list is driven by the section and is empty
// before one is chosen. 'the whole section' is a real answer, not a placeholder: goods put in
// a section without naming a rack are located, just less precisely.
function rackOpts(secId){
  var o='<option value="">— @(isAr ? "كل السيكشن" : "whole section") —</option>';
  if(!secId) return o;
  BINS.filter(function(r){return String(r.parent)===String(secId);})
      .sort(function(a,b){return a.code<b.code?-1:1;})
      .forEach(function(r){ o+='<option value="'+r.iD+'">'+label(r,null)+'</option>'; });
  return o;}
// Warehouse drives the section, section drives the rack. A choice already made is kept when it
// still belongs to its new parent and dropped when it does not - silently keeping a rack after
// the warehouse changed would post goods into another warehouse's rack.
function syncRack(tr){
  var sec=tr.querySelector('.sec'), rck=tr.querySelector('.rck'); if(!sec||!rck) return;
  var keep=rck.value, r=keep?BINBY[keep]:null;
  rck.innerHTML=rackOpts(sec.value);
  rck.value=(r && String(r.parent)===String(sec.value)) ? keep : '';
  // nothing to choose from until a section is named, and a disabled control says so
  rck.disabled = !sec.value;}
function syncLoc(tr){
  var wh=tr.querySelector('.wh'), sec=tr.querySelector('.sec'); if(!wh||!sec) return;
  var keep=sec.value, b=keep?BINBY[keep]:null;
  sec.innerHTML=secOpts(wh.value);
  sec.value=(b && String(b.wh)===String(wh.value)) ? keep : '';
  syncRack(tr);}
function eopts(){var o='';EXP.forEach(function(a){o+='<option value="'+a.id+'">'+a.code+' — '+a.name+'</option>';});return o;}
function copts(){var o='<option value="">—</option>';CC.forEach(function(c){o+='<option value="'+c.iD+'">'+c.code+' — '+c.name+'</option>';});return o;}
function iopts(){var o='<option value="">@Localizer["— None —"]</option>';ITEMS.forEach(function(i){o+='<option value="'+i.iD+'" data-cost="'+(i.cost||0)+'" data-name="'+(i.name||'').replace(/"/g,'&quot;')+'">'+i.itemCode+' — '+i.name+'</option>';});return o;}
function wopts(){var o='<option value="">—</option>';WH.forEach(function(w){o+='<option value="'+w.iD+'">'+w.code+'</option>';});return o;}
function addRow(){var tr=document.createElement('tr');tr.innerHTML=
 '<td data-l="@Localizer["Item (stock)"]"><select class="form-select form-select-solid it">'+iopts()+'</select></td>'+
 '<td data-l="@SR["Warehouse"]"><select class="form-select form-select-solid wh">'+wopts()+'</select></td>'+
 // ONE COLUMN, TWO CONTROLS - the grid is six columns wide and a thirteenth cell would have
 // broken it into a ragged third row. Section leads because the rack depends on it.
 '<td class="loc-cell" data-l="@(isAr ? "الموقع" : "Location")"><div class="d-flex gap-1">'+
   '<select class="form-select form-select-solid sec" style="flex:1 1 58%" title="@(isAr ? "سيكشن" : "Section")">'+secOpts('')+'</select>'+
   '<select class="form-select form-select-solid rck" style="flex:1 1 42%" title="@(isAr ? "رف (اختياري)" : "Rack (optional)")" disabled>'+rackOpts('')+'</select>'+
 '</div></td>'+
 '<td data-l="@SR["Description"]"><input class="form-control form-control-solid d"></td>'+
 '<td data-l="@Localizer["Qty"]"><input type="number" step="0.01" class="form-control form-control-solid q text-end" value="1"></td>'+
 '<td data-l="@SR["Price"]"><input type="number" step="0.01" class="form-control form-control-solid p text-end" value="0"></td>'+
 '<td data-l="@Localizer["Disc"]"><input type="number" step="0.01" class="form-control form-control-solid disc text-end" value="0"></td>'+
 '<td data-l="@Localizer["Tax%"]"><input type="number" step="0.01" class="form-control form-control-solid tax text-end" value="14"></td>'+
 '<td data-l="@Localizer["Expense acct"]"><select class="form-select form-select-solid acc">'+eopts()+'</select></td>'+
 '<td data-l="@Localizer["Cost ctr"]"><select class="form-select form-select-solid cc">'+copts()+'</select></td>'+
 '<td data-l="@SR["Total"]" class="lt-cell"><span class="lt">0.00</span></td>'+
 '<td class="cb-del-cell"><button type="button" class="btn btn-light-danger del"><i class="ki-outline ki-trash fs-5"></i></button></td>';
 document.getElementById('rows').appendChild(tr);cbItemSelect(tr.querySelector('.it'), itemPickUrl);
 // _QuickAdd may turn these into select2, whose picks never reach a native 'change' listener.
 var _wh=tr.querySelector('.wh'), _sec=tr.querySelector('.sec');
 if(window.CB&&CB.onSelectChange){ CB.onSelectChange(_wh,function(){syncLoc(tr);});
                                   CB.onSelectChange(_sec,function(){syncRack(tr);}); }
 else { _wh.addEventListener('change',function(){syncLoc(tr);});
        _sec.addEventListener('change',function(){syncRack(tr);}); }
 calc();}
function calc(){var sub=0,tax=0;document.querySelectorAll('#rows tr').forEach(function(tr){var q=parseFloat(tr.querySelector('.q').value)||0,p=parseFloat(tr.querySelector('.p').value)||0,d=parseFloat(tr.querySelector('.disc').value)||0,t=parseFloat(tr.querySelector('.tax').value)||0;var lt=q*p-d;tr.querySelector('.lt').textContent=lt.toFixed(2);sub+=lt;tax+=lt*t/100;});document.getElementById('tot').textContent=sub.toFixed(2)+' / '+tax.toFixed(2)+' / '+(sub+tax).toFixed(2);}
document.getElementById('add').addEventListener('click',addRow);
document.getElementById('rows').addEventListener('input',calc);
// when an inventory item is chosen: fill description + default purchase price (cost), and the expense account becomes optional (server uses the inventory account)
document.getElementById('rows').addEventListener('change',function(e){
  if(e.target.classList.contains('it')){var tr=e.target.closest('tr');var opt=e.target.options[e.target.selectedIndex];
    if(e.target.value){var nm=opt.getAttribute('data-name')||'';var c=parseFloat(opt.getAttribute('data-cost'))||0;
      if(!tr.querySelector('.d').value)tr.querySelector('.d').value=nm;
      if((parseFloat(tr.querySelector('.p').value)||0)===0&&c>0)tr.querySelector('.p').value=c;
      var wh=tr.querySelector('.wh');if(wh&&!wh.value&&WH.length)wh.value=WH[0].iD;
      calc();}}
});
document.getElementById('rows').addEventListener('click',function(e){if(e.target.closest('.del')){e.target.closest('tr').remove();calc();}});
// ---- WHICH ROWS ARE REAL, AND WHICH ARE A MISTAKE ----------------------------------------
//
// THIS USED TO LOSE WORK SILENTLY. The whole collection was one filter - `(acc||it) && q*p>0` -
// and every row that failed it was simply not sent. The filter exists for a good reason: the
// screen opens with one empty row and "Add line" leaves another behind, and neither is a
// purchase. But it cannot tell an EMPTY row from an UNFINISHED one, so a line you typed a
// description and a quantity into and had not priced yet was dropped on the floor. The server
// then saved the rest, reported success, and the line was never mentioned again.
//
// That is the worst shape a bug can take: the system says the thing you asked for happened.
//
// So the two cases are now separated. An untouched row is skipped exactly as before. A row with
// ANYTHING in it that cannot be saved REFUSES the save and says which row and why - nothing is
// sent, nothing is lost, and the fix is one field away.
document.getElementById('save').addEventListener('click',function(){
  // The empty-vs-unfinished decision and the refusal live in _DocumentLineGuard, shared with every
  // other document screen. What is local here is only what a PURCHASE line is made of.
  var lines = CBLines.gather({
    // UNTOUCHED: no item, no description, no price, no discount, and the quantity still the 1 the
    // row is born with. Comparing against that default rather than ignoring quantity is what keeps
    // the narrower case closed - a row carrying only a quantity is unfinished, not empty.
    touched: function(tr){
      return !!(CBLines.str(tr,'.it') || CBLines.str(tr,'.d')
             || CBLines.num(tr,'.p') !== 0 || CBLines.num(tr,'.disc') !== 0
             || CBLines.num(tr,'.q') !== 1);
    },
    problem: function(tr){
      if(!CBLines.str(tr,'.it') && !CBLines.str(tr,'.acc')) return CBLines.T.itemOrAccount;
      if(CBLines.num(tr,'.q') <= 0) return CBLines.T.qty;
      if(CBLines.num(tr,'.p') <= 0) return CBLines.T.price;
      return null;
    },
    build: function(tr){
      var acc=CBLines.str(tr,'.acc'), cc=CBLines.str(tr,'.cc'),
          it=CBLines.str(tr,'.it'),  wh=CBLines.str(tr,'.wh'),
          // THE MOST SPECIFIC ANSWER WINS, which is the same rule the item's own default uses
          // (DefaultBinLocationId ?? DefaultSectionId) and the same shape the column stores.
          loc=CBLines.str(tr,'.rck') || CBLines.str(tr,'.sec');
      return { itemDescription: tr.querySelector('.d').value,
               qty: CBLines.num(tr,'.q'), unitPrice: CBLines.num(tr,'.p'),
               discountAmount: CBLines.num(tr,'.disc'), taxRate: CBLines.num(tr,'.tax'),
               expenseAccountId: acc?parseInt(acc):0, costCenterId: cc?parseInt(cc):null,
               itemId: it?parseInt(it):null, warehouseId: wh?parseInt(wh):null,
               binLocationId: loc?parseInt(loc):null };
    }
  });
  if(!lines) return;   // refused, and nothing was sent
  document.getElementById('linesJson').value=JSON.stringify(lines);var _f=document.getElementById('f');
if(window.CB&&CB.submitForm){CB.submitForm(_f,{type:'@(isEdit ? "edit" : "save")'@Html.Raw(isEdit ? ",text:(window.CB?CB.L('سيتم عكس القيد الأصلي للفاتورة وإعادة ترحيلها بالقيم الجديدة — هل تريد المتابعة؟','The original entry will be reversed and the invoice re-posted with the new values — continue?'):null)" : "")});}else{_f.submit();}});
// ---- copy lines from an earlier invoice by the same vendor -------------------------------
// The vendor drives the button: the dialog lists THAT vendor's invoices, so before one is chosen
// there is nothing for it to open. _QuickAdd may turn this select into select2, whose picks never
// reach a native 'change' listener - CB.onSelectChange binds both channels and collapses the
// duplicate, so this works whether select2 claimed the control or not.
(function(){
  var vSel=document.querySelector('select[name=vendorId]'), btn=document.getElementById('copyInv');
  if(!vSel||!btn) return;
  function sync(){ btn.disabled = !vSel.value; }
  if(window.CB&&CB.onSelectChange) CB.onSelectChange(vSel, sync); else vSel.addEventListener('change', sync);
  btn.addEventListener('click', function(){ if(window.cbCopyFromInvoice) cbCopyFromInvoice(vSel.value); });
  sync();   // edit mode arrives with a vendor already chosen
})();
var FUNC=@funcCur; var curSel=document.getElementById('curSel'); var rateWrap=document.getElementById('rateWrap');
function toggleRate(){ if(rateWrap) rateWrap.style.display=(parseInt(curSel.value)!==FUNC)?'':'none'; }
if(curSel){ curSel.addEventListener('change',toggleRate); toggleRate(); }
// Vendor "+" and "New item" are auto-wired by _QuickAdd (uses the global addRow/cbItemSelectSet/calc)
// P3 edit mode: prefill the existing lines
var EDIT_LINES=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(editLines));
function fillRow(l){ addRow(); var tr=document.querySelector('#rows tr:last-child'); if(!tr)return;
  if(l.barcode) tr.setAttribute('data-cb-bcval', l.barcode);   // recall the item's barcode into the (async-added) barcode cell
  if(l.itemId){ cbItemSelectSet(tr.querySelector('.it'), {id:l.itemId, code:'', name:l.name||''}); }
  var wh=tr.querySelector('.wh'); if(wh && l.wh) wh.value=String(l.wh);
  // the location list depends on the warehouse, so it is rebuilt before the stored value is set
  // The column stores ONE id. Which control it belongs in depends on whether it has a parent:
  // a rack goes in the rack box with its section above it, a section goes in the section box.
  syncLoc(tr);
  if(l.bin){
    var stored=BINBY[l.bin], sec=tr.querySelector('.sec'), rck=tr.querySelector('.rck');
    if(stored && stored.parent){ sec.value=String(stored.parent); syncRack(tr); rck.value=String(l.bin); }
    else if(stored){ sec.value=String(l.bin); syncRack(tr); }
  }
  tr.querySelector('.d').value=l.d||''; tr.querySelector('.q').value=l.q; tr.querySelector('.p').value=l.p;
  tr.querySelector('.disc').value=l.disc; tr.querySelector('.tax').value=l.tax;
  var acc=tr.querySelector('.acc'); if(acc && l.acc) acc.value=String(l.acc);
  var cc=tr.querySelector('.cc'); if(cc && l.cc) cc.value=String(l.cc);
  calc(); }
if(EDIT_LINES && EDIT_LINES.length){ EDIT_LINES.forEach(fillRow); } else { addRow(); }
window.onItemScanned=function(p){ addRow(); var tr=document.querySelector('#rows tr:last-child'); if(!tr)return;
  cbItemSelectSet(tr.querySelector('.it'), {id:p.id, code:p.code, name:p.name, nameEn:p.nameEn, price:p.salesPrice, cost:p.cost, baseUom:p.baseUom});
  tr.querySelector('.q').value=(p.qty*(p.factor||1));
  var wh=tr.querySelector('.wh'); if(wh&&!wh.value&&WH.length)wh.value=String(WH[0].iD);
  calc(); };
</script>
}
