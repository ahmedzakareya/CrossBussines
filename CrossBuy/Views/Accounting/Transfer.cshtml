@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
    var cash = ViewBag.CashAccounts as List<AccountNode> ?? new();
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1"><h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Internal Transfer"]</h1>
        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Transfer"]</li></ul></div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mw-650px">
            <div class="card-body">
                <form asp-action="DoTransfer" method="post">@Html.AntiForgeryToken()
                    <div class="row g-5">
                        <div class="col-md-6"><label class="required fw-semibold fs-6 mb-2">@Localizer["From account"]</label><select name="fromGlAccountId" class="form-select form-select-solid" required><option value="0">@Localizer["Select"]</option>@foreach (var a in cash) { <option value="@a.Id">@a.Code — @(isAr ? a.Name : a.NameEn)</option> }</select></div>
                        <div class="col-md-6"><label class="required fw-semibold fs-6 mb-2">@Localizer["To account"]</label><select name="toGlAccountId" class="form-select form-select-solid" required><option value="0">@Localizer["Select"]</option>@foreach (var a in cash) { <option value="@a.Id">@a.Code — @(isAr ? a.Name : a.NameEn)</option> }</select></div>
                        <div class="col-md-6"><label class="required fw-semibold fs-6 mb-2">@SR["Amount"]</label><input name="amount" type="number" step="0.01" class="form-control form-control-solid" required /></div>
                        <div class="col-md-6"><label class="required fw-semibold fs-6 mb-2">@SR["Date"]</label><input name="date" type="date" class="form-control form-control-solid" value="2026-05-01" required /></div>
                        <div class="col-12"><label class="fw-semibold fs-6 mb-2">@SR["Notes"]</label><input name="notes" class="form-control form-control-solid" /></div>
                    </div>
                    <div class="d-flex justify-content-end mt-6"><button class="btn btn-primary">@Localizer["Execute transfer"]</button></div>
                    <div class="text-muted fs-7 mt-4"><i class="ki-outline ki-information-5 fs-6 text-primary me-1"></i>@Localizer["Journal: Dr destination / Cr source."]</div>
                </form>
            </div>
        </div>
    </div></div>
</div>
