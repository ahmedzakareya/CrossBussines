@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@{
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
    var isAr = (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar");
}
<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["Sales Invoices"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted"><a href="@Url.Action("Index","Accounting")" class="text-muted">@SR["Accounting"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@Localizer["Sales"]</li></ul>
        </div>
        <a href="@Url.Action("NewSalesInvoice","Accounting")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-2"></i>@Localizer["New invoice"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <div class="card card-flush mb-5"><div class="card-body py-5"><div class="row g-4 align-items-end">
            <div class="col-md-7"><label class="fw-semibold fs-7 text-muted mb-1"><i class="ki-outline ki-magnifier fs-5 me-1"></i>@Localizer["Multi-search (invoice no / notes)"]</label>
                <input type="text" id="f_q" class="form-control form-control-solid" autocomplete="off" placeholder="@Localizer["Add search terms…"]" /></div>
            <div class="col-md-3"><label class="fw-semibold fs-7 text-muted mb-1">@SR["Status"]</label>
                <select id="f_status" class="form-select form-select-solid cb-filter" data-control="select2" data-hide-search="true"><option value="">@SR["All"]</option><option value="Posted">@Localizer["Posted"]</option><option value="Draft">@SR["Draft"]</option></select></div>
            <div class="col-md-2"><button type="button" id="f_reset" class="btn btn-light w-100"><i class="ki-outline ki-arrows-circle fs-3"></i> @SR["Reset"]</button></div>
        </div></div></div>

        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title"><span class="text-muted fs-7" id="resultCount">—</span></div>
                <div class="card-toolbar d-flex align-items-center gap-2 flex-wrap">
                    @* The register for this list — every layout bound to the screen, read live. *@
                    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
                    {
                        ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.AccountingSalesInvoices,
                        ExtraParameters = new Dictionary<string, string>(StringComparer.Ordinal)
                        {
                            ["Search"] = Context.Request.Query["q"].ToString(),
                            ["Status"] = Context.Request.Query["status"].ToString(),
                        },
                    })
<select id="f_size" class="form-select form-select-solid form-select-sm w-auto" data-hide-search="true"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
            </div>
            <div class="card-body pt-0"><div class="table-responsive"><table class="table align-middle gy-3" id="t" style="font-variant-numeric:tabular-nums;">
                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid #0E4A9E;"><th class="ps-4">@Localizer["Invoice No"]</th><th>@SR["Date"]</th><th class="text-end">@SR["Subtotal"]</th><th class="text-end">@SR["Tax"]</th><th class="text-end">@SR["Total"]</th><th class="text-center">@SR["Status"]</th><th class="text-center pe-4">@Localizer["Open"]</th></tr></thead>
                <tbody id="rows"></tbody>
            </table></div>
                <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Loading…"]</div>
                <div class="text-center text-muted py-10 d-none" id="emptyRow">@Localizer["No matching invoices"]</div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>

@* The shared report dialog — see Views/Shared/_ReportPreviewModal.cshtml. *@
@await Html.PartialAsync("_ReportPreviewModal", (object)(
    System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
        ? "سجل فواتير المبيعات" : "Sales invoice register"))

@section Scripts {
<script>
/* THE REGISTER FOLLOWS THE FILTERS THE READER CAN SEE.
   cbServerList applies the filters over AJAX and never touches the address bar, so the print control —
   rendered server-side from the query string — would otherwise print whatever the url happened to say.

   CAPTURE PHASE: the dialog's own listener is bound on `document` in the bubble phase and reads the
   attributes this rewrites, so bubbling here would be a race that usually loses. */
(function () {
    var val = function (id) { var el = document.getElementById(id); return el ? (el.value || '') : ''; };
    document.addEventListener('click', function (e) {
        var link = e.target.closest ? e.target.closest('[data-report-view]') : null;
        if (!link) { return; }
        ['data-report-view', 'data-report-download'].forEach(function (attr) {
            var raw = link.getAttribute(attr);
            if (!raw) { return; }
            /* Parsed as a url, not string-replaced: a search term can contain an ampersand, and a regex
               over a query string is how that becomes two parameters. */
            var u = new URL(raw, window.location.origin);
            u.searchParams.set('Search', val('f_q'));
            u.searchParams.set('Status', val('f_status'));
            link.setAttribute(attr, u.pathname + u.search);
        });
    }, true);
})();
</script>

<script>
cbServerList({ url:'@Url.Action("SalesInvoicesData","Accounting")', exportUrl:'@Url.Action("SalesInvoicesExport","Accounting")', isAr:@(isAr ? "true" : "false"),
  addParams:function(p){ var s=document.getElementById('f_status'); if(s&&s.value)p.set('status',s.value); } });
</script>
}
