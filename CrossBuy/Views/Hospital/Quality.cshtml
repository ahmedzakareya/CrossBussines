@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalQualityPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H81 — the month's quality indicators, each computed from the records, against the hospital's target (a setting), with
    the five months before it. Met is green, not met is red, no data is grey — there is no third colour.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Quality indicators"].Value;
    bool canManage = ViewBag.CanManage == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string F(decimal? v, string unit) => v == null ? "—" : unit switch
    {
        "%" => v.Value.ToString("0.#", inv) + "%",
        "per1000" => v.Value.ToString("0.##", inv),
        "of5" => v.Value.ToString("0.0#", inv),
        "score" => (v.Value > 0 ? "+" : "") + v.Value.ToString("0", inv),
        _ => v.Value.ToString("0.#", inv),
    };
    string Cmp(HospitalQualityValue q) => (q.LowerBetter ? "≤ " : "≥ ") + F(q.Target, q.Unit);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Quality indicators"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Computed from the hospital's own records"]</li></ul>
        </div>
        <input type="month" id="f_month" class="form-control form-control-solid form-control-sm w-175px" dir="ltr" value="@($"{Model.Year:0000}-{Model.Month:00}")" />
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.TargetsReady)
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="fw-semibold"><div class="fs-6 text-gray-700">@T["Targets cannot be changed until hospital_h81_quality_targets.sql is installed; the published defaults apply."]</div></div>
            </div>
        }
        @* H128: stat tiles (demo39 dashboards/logistics) *@
        <div class="row g-5 mb-5">
            @foreach (var (st, icon, tone) in new[] { ("Met", "ki-check-circle", "primary"), ("NotMet", "ki-cross-circle", "danger"), ("NoData", "ki-question", "gray") })
            {
                <div class="col-md-4"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2 hp-num" dir="ltr">@Model.Values.Count(v => v.Status == st)</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@T["qs:" + st]</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@(tone == "gray" ? "secondary" : tone)"><i class="ki-outline @icon fs-2x text-@(tone == "gray" ? "gray-600" : tone)"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500"><div class="bullet w-8px h-6px rounded-2 bg-@(tone == "gray" ? "gray-400" : tone) me-3"></div>@T["{0} of {1}", Model.Values.Count(v => v.Status == st), Model.Values.Count]</div>
                    </div>
                </div></div>
            }
        </div>
        <div class="row g-5">
            @foreach (var q in Model.Values)
            {
                string tone = q.Status == "Met" ? "primary" : q.Status == "NotMet" ? "danger" : "gray-500";
                string badge = q.Status == "Met" ? "primary" : q.Status == "NotMet" ? "danger" : "primary";
                <div class="col-md-6 col-xl-4"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800 fs-6">@T["qi:" + q.Code]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["qd:" + q.Code]</span></h3>
                        <div class="card-toolbar"><span class="badge @(q.Status == "NoData" ? "badge-light" : "badge-light-" + badge) fs-7 fw-bold">@T["qs:" + q.Status]</span></div>
                    </div>
                    <div class="card-body pt-2">
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <span class="fs-2hx fw-bold hp-num lh-1 text-@(q.Status == "NoData" ? "gray-400" : tone)" dir="ltr">@F(q.Value, q.Unit)</span>
                            <span class="text-gray-500 fw-semibold fs-7">@T["qu:" + q.Unit]</span>
                        </div>
                        @if (q.Denominator != null) {<div class="text-gray-500 fw-semibold fs-7 mb-4 hp-num">@if (q.Numerator != null) {@T["{0} of {1}", q.Numerator, q.Denominator]} else {<bdi dir="ltr">@q.Denominator</bdi>}</div>} else {<div class="mb-4"></div>}
                        <div class="d-flex flex-stack fs-7 mb-3">
                            <span class="text-gray-700 fw-semibold">@T["Target"]: <bdi class="hp-num fw-bold" dir="ltr">@Cmp(q)</bdi>@if (q.TargetIsDefault) {<span class="text-muted"> (@T["Default"])</span>}</span>
                            @if (canManage && Model.TargetsReady) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary w-30px h-30px" title="@T["Change"]" data-bs-toggle="tooltip" data-target="@q.Code" data-current="@q.Target.ToString("0.##", inv)" data-what="@T["qi:" + q.Code]"><i class="ki-outline ki-pencil fs-5"></i></button>}
                        </div>
                        <div class="d-flex gap-1 align-items-end" dir="ltr" title="@T["The last six months"]">
                            @for (int i = 0; i < q.Trend.Count; i++)
                            {
                                var v = q.Trend[i]; var mm = Model.TrendMonths[i];
                                string st = HospitalQualityRules.Status(v, q.Target, q.LowerBetter);
                                <div class="flex-grow-1 text-center rounded py-1 @(st == "Met" ? "bg-light-primary" : st == "NotMet" ? "bg-light-danger" : "bg-light") @(i == q.Trend.Count - 1 ? "border border-gray-400" : "")">
                                    <div class="fs-9 fw-bold hp-num">@F(v, q.Unit)</div><div class="fs-9 text-muted hp-num">@($"{mm.Month:00}/{mm.Year % 100:00}")</div></div>
                            }
                        </div>
                    </div>
                </div></div>
            }
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var m = document.getElementById('f_month');
            m.addEventListener('change', function () { var v = (m.value || '').split('-'); if (v.length === 2) location.href = @Json.Serialize(Url.Action("Quality")) + '?year=' + v[0] + '&month=' + Number(v[1]); });
            var tok = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { title: @Json.Serialize(T["The hospital's target"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), num: @Json.Serialize(T["Write a number"].Value) };
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-target]'); if (!t) return;
                cbPrompt(t.getAttribute('data-what') || '', { title: W.title, value: t.getAttribute('data-current'), number: true, numberText: W.num }).then(function (v) { if (v == null) return;
                    fetch(@Json.Serialize(Url.Action("SetQualityTarget")), { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok },
                        body: JSON.stringify({ indicator: t.getAttribute('data-target'), target: Number(String(v).replace(',', '.')) }) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }); });
            });
        })();
    </script>
}
