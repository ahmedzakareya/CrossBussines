@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalPriceListView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — one price list, composed from the theme (demo39): the profile card with its detail rows (apps/customers/view),
    list-widget rows for the versions and the patients (widgets/lists), the table widget for the lines (widgets/tables),
    notices, and the form modal (utilities/modals/forms/new-target).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var l = Model.List;
    ViewData["Title"] = DisplayName.Of(l.Name, l.NameEn);
    bool canManage = ViewBag.CanManage == true;
    string tab = (ViewBag.Tab as string) ?? HospitalPriceGroups.Service;
    var versions = (ViewBag.Versions as List<HospitalPriceList>) ?? new();
    var patients = (ViewBag.Patients as List<CrossBuy.Controllers.HospitalController.HospitalListPatient>) ?? new();
    var cur = Model.Currency; var fac = Model.Facility;
    bool foreign = l.CurrencyId != null, draft = l.Status == HospitalPriceListStatus.Draft, archived = l.Status == HospitalPriceListStatus.Archived;
    bool editable = canManage && !archived;
    string Pct(decimal v) => (v > 0 ? "+" : "") + v.ToString("0.##") + "%";
    string StatusBadge(string s) => s == HospitalPriceListStatus.Active ? "primary" : s == HospitalPriceListStatus.Draft ? "secondary" : "danger";
    string SrcBadge(string s) => s switch { "rule" => "primary", "override" => "info", "ceiling" => "primary", _ => "danger" };
    string GroupIcon(string g) => g == HospitalPriceGroups.Medicine ? "capsule" : g == HospitalPriceGroups.Consumable ? "parcel" : "pulse";
    var lineRows = Model.Lines.Select(x => new { id = x.Line!.ID, key = x.Entry.Key, code = x.Entry.Code, name = DisplayName.Of(x.Entry.Name, x.Entry.NameEn), group = x.Entry.Group,
        main = fac.Format(x.Entry.MainPrice), rule = cur.Format(HospitalPricingService.Rule(x.Entry.MainPrice, l.FrozenRate, HospitalPricingService.AdjFor(l, x.Entry.Group), cur.Decimals, l.RoundingStep, x.Entry.Group == HospitalPriceGroups.Service)),
        fixedPrice = x.Line.FixedPrice, excluded = x.Line.IsExcluded, cap = x.Entry.PublicPrice is decimal pp ? cur.Format(Math.Round(pp * l.FrozenRate, cur.Decimals)) : null });
    int stale = Model.StaleCount;
    var categories = (ViewBag.Categories as IReadOnlyList<HospitalCategoryChoice>) ?? Array.Empty<HospitalCategoryChoice>();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@DisplayName.Of(l.Name, l.NameEn)</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("PriceLists")" class="text-muted text-hover-primary">@T["Price lists"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><bdi class="hp-num" dir="ltr">@l.Code v@(l.Version)</bdi></li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("PriceLists")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline @(DisplayName.IsArabic ? "ki-arrow-right" : "ki-arrow-left") fs-4"></i>@T["All lists"]</a>
            @if (canManage)
            {
                if (draft) { <button type="button" class="btn btn-sm btn-light btn-active-light-primary" data-edit-list><i class="ki-outline ki-pencil fs-4"></i>@T["Edit"]</button> }
                if (l.Status == HospitalPriceListStatus.Active) { <button type="button" class="btn btn-sm btn-light btn-active-light-primary" data-post="Copy"><i class="ki-outline ki-copy fs-4"></i>@T["Copy as a new version"]</button> }
                if (!archived)
                {
                    <button type="button" class="btn btn-sm btn-light-primary" data-pick-category><i class="ki-outline ki-category fs-4"></i>@T["Add a category"]</button>
                    <button type="button" class="btn btn-sm btn-primary" data-pick><i class="ki-outline ki-plus fs-4"></i>@T["Add items"]</button>
                }
                if (draft)
                {
                    if (stale > 0) { <span title="@T["Review the not-updated prices first"]" data-bs-toggle="tooltip"><button type="button" class="btn btn-sm btn-light" disabled><i class="ki-outline ki-lock fs-4"></i>@T["Approve the list"]</button></span> }
                    else { <button type="button" class="btn btn-sm btn-primary" data-post="Approve"><i class="ki-outline ki-check fs-4"></i>@T["Approve the list"]</button> }
                }
                if (l.Status == HospitalPriceListStatus.Active) { <button type="button" class="btn btn-sm btn-light btn-active-light-danger" data-post="Archive" data-confirm="@T["Archive this list? Patients must be moved off it first."]"><i class="ki-outline ki-archive fs-4"></i>@T["Archive"]</button> }
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (stale > 0 && !archived)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mb-5">
                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-3">
                    <div class="fw-semibold">
                        <h4 class="text-gray-900 fw-bold mb-1">@(draft && l.ApprovedAt == null && Model.Lines.All(x => x.Stale) ? T["A new list — prices not updated:"] : T["Prices not updated:"]) <span class="hp-num">@stale</span></h4>
                        <div class="fs-6 text-gray-700">@(Model.Lines.All(x => x.Stale) ? T["Every item was copied at the main list's latest prices through the discount rule. Review each line and approve it, or approve them all; the list prices no bill before that."] : T["They await review, or their main price changed after they were confirmed. The price shown is the rule applied to the current main price."])</div>
                    </div>
                    @if (canManage) { <button type="button" class="btn btn-sm btn-danger flex-shrink-0" data-approve-all><i class="ki-outline ki-check-square fs-4"></i>@T["Approve all"]</button> }
                </div>
            </div>
        }
        @if (Model.Pending.Count > 0 && !archived)
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-3">
                    <div class="fw-semibold">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["New main-list items not added here:"] <span class="hp-num">@Model.Pending.Count</span></h4>
                        <div class="fs-6 text-gray-700">@string.Join(DisplayName.IsArabic ? "، " : ", ", Model.Pending.Take(8).Select(e => DisplayName.Of(e.Name, e.NameEn)))@(Model.Pending.Count > 8 ? "…" : "")</div>
                    </div>
                    @if (canManage) { <button type="button" class="btn btn-sm btn-primary flex-shrink-0" data-add-all><i class="ki-outline ki-plus fs-4"></i>@T["Add by the rule"]</button> }
                </div>
            </div>
        }

        <div class="row g-5 g-xl-8">
            <div class="col-xl-4">
                @* the list's profile card — demo39 apps/customers/view *@
                <div class="card card-flush mb-5">
                    <div class="card-body pt-8">
                        <div class="d-flex flex-center flex-column mb-5">
                            <div class="symbol symbol-75px mb-5"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-price-tag fs-2hx text-primary"></i></span></div>
                            <div class="fs-3 text-gray-800 fw-bold mb-1 text-center">@DisplayName.Of(l.Name, l.NameEn)</div>
                            <div class="fs-6 fw-semibold text-muted mb-4"><bdi class="hp-num" dir="ltr">@l.Code · v@(l.Version)</bdi> · @T["kind:" + l.Kind]</div>
                            <div class="d-flex flex-wrap flex-center gap-2">
                                <span class="badge badge-light-@StatusBadge(l.Status) fs-7 fw-bold">@T["plst:" + l.Status]</span>
                                <span class="badge @(foreign ? "badge-light-info" : "badge-light-primary") fs-7 fw-bold hp-num">@cur.Code</span>
                                @if (foreign) {<span class="badge badge-light fs-7 fw-bold">@T["foreign"]</span>}
                            </div>
                        </div>
                        <div class="separator separator-dashed my-5"></div>
                        @{ var kv = new List<(string, string)> {
                            (T["Price source"].Value, T["The main list through the discount rule"].Value),
                            (T["Discount rule"].Value, T["Services (group)"].Value + " <bdi class=\"hp-num text-gray-800 fw-bold\" dir=\"ltr\">" + Pct(l.ServicesAdjPct) + "</bdi><br/>" + T["Medicines"].Value + " <bdi class=\"hp-num text-gray-800 fw-bold\" dir=\"ltr\">" + Pct(l.MedicinesAdjPct) + "</bdi><br/>" + T["Consumables"].Value + " <bdi class=\"hp-num text-gray-800 fw-bold\" dir=\"ltr\">" + Pct(l.ConsumablesAdjPct) + "</bdi>"),
                            (T["Rounding"].Value, l.RoundingStep is decimal st ? T["Services to the nearest"].Value + " <span class=\"hp-num\">" + cur.Format(st) + "</span>" : T["The currency's decimals"].Value) };
                           if (foreign) kv.Add((T["Frozen rate"].Value, "<span class=\"hp-num\" dir=\"ltr\">1 " + fac.Code + " = " + l.FrozenRate.ToString("0.####") + " " + cur.Code + "</span>"));
                           kv.Add((T["Validity"].Value, "<span class=\"hp-num text-nowrap\">" + l.ValidFrom.ToString("yyyy-MM-dd") + (DisplayName.IsArabic ? " ← " : " → ") + (l.ValidTo?.ToString("yyyy-MM-dd") ?? T["Open"].Value) + "</span>"));
                           kv.Add((T["Approved"].Value, l.ApprovedAt is DateTime ap ? "<span class=\"hp-num\">" + ap.ToString("yyyy-MM-dd") + "</span>" : "<span class=\"text-muted\">" + T["Not approved yet"].Value + "</span>")); }
                        @foreach (var (k, v) in kv)
                        {
                            <div class="fw-bold text-gray-800 fs-7 mt-4">@k</div>
                            <div class="text-gray-600 fw-semibold fs-7">@Html.Raw(v)</div>
                        }
                    </div>
                </div>

                @if (foreign)
                {
                    <div class="notice d-flex bg-light-info rounded border-info border border-dashed p-5 mb-5">
                        <i class="ki-outline ki-dollar fs-2tx text-info me-4"></i>
                        <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["The foreign currency in the books"]</h4>
                            <div class="fs-7 text-gray-700">@T["The bill is in"] <span class="hp-num">@cur.Code</span>@T["; the journal entry is in"] <span class="hp-num">@fac.Code</span> @T["at the rate of the day it closes. It is paid after closing, and a different rate on payment posts to the exchange-difference account."]</div></div>
                    </div>
                }

                @* versions — demo39 widgets/lists *@
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Versions"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@versions.Count</span></h3>
                    </div>
                    <div class="card-body pt-2">
                        @for (int i = 0; i < versions.Count; i++)
                        {
                            var vv = versions[i]; bool me = vv.ID == l.ID;
                            <a href="@Url.Action("PriceList", new { id = vv.ID })" class="d-flex flex-stack">
                                <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@(me ? "primary" : "secondary")"><i class="ki-outline ki-copy fs-3 text-@(me ? "primary" : "gray-600")"></i></span></div>
                                <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                    <div class="me-3"><span class="text-gray-800 text-hover-primary fw-bold fs-6 hp-num" dir="ltr">v@(vv.Version)</span><span class="text-gray-500 fw-semibold fs-7 d-block hp-num">@vv.ValidFrom.ToString("yyyy-MM-dd")</span></div>
                                    <span class="badge badge-light-@StatusBadge(vv.Status) fs-7 fw-bold">@T["plst:" + vv.Status]</span>
                                </div>
                            </a>
                            if (i < versions.Count - 1) { <div class="separator separator-dashed my-3"></div> }
                        }
                    </div>
                </div>

                @* the patients on the list — demo39 widgets/lists, with their photos *@
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Patients on this list"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7"><span class="hp-num">@Model.Patients</span> @T["patients (count)"]</span></h3>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Patients == 0)
                        {
                            <div class="text-center py-8"><i class="ki-outline ki-people fs-3x text-gray-300 mb-4 d-block"></i>
                                <div class="fs-7 text-gray-500">@T["Put a patient on this list from the patient's file."]</div></div>
                        }
                        @for (int i = 0; i < patients.Count; i++)
                        {
                            var p = patients[i]; string nm = DisplayName.Of(p.Name, p.NameEn);
                            <a href="@Url.Action("Patient", new { id = p.Id })" class="d-flex align-items-center">
                                <div class="symbol symbol-35px symbol-circle me-4">@if (!string.IsNullOrEmpty(p.PhotoPath)) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label fs-7 fw-bold hp-initials">@HospitalUi.Initials(p.NameEn)</span>}</div>
                                <div class="d-flex flex-column"><span class="text-gray-800 text-hover-primary fw-bold fs-6">@nm</span><bdi class="text-gray-500 fw-semibold fs-7 hp-num">@p.Mrn</bdi></div>
                            </a>
                            if (i < patients.Count - 1) { <div class="separator separator-dashed my-3"></div> }
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-8">
                @* the lines — demo39 widgets/tables, one tab per group *@
                <div class="card card-flush">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Lines"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Main"] <bdi class="hp-num">@fac.Code</bdi> · @T["This list"] <bdi class="hp-num">@cur.Code</bdi></span></h3>
                        <div class="card-toolbar">
                            <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-6 fw-bold">
                                @foreach (var g in HospitalPriceGroups.All)
                                {
                                    int n = Model.Lines.Count(x => x.Entry.Group == g), ns = Model.Lines.Count(x => x.Entry.Group == g && x.Stale);
                                    <li class="nav-item"><a class="nav-link text-active-primary py-4 me-6 @(g == tab ? "active" : "")" data-bs-toggle="tab" href="#pl_@g">@T["group:" + g] <span class="badge badge-light-primary ms-1 hp-num">@n</span>@if (ns > 0) {<span class="badge badge-light-danger ms-1 hp-num">@ns</span>}</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="card-body pt-4"><div class="tab-content">
                        @foreach (var g in HospitalPriceGroups.All)
                        {
                            var rows = Model.Lines.Where(x => x.Entry.Group == g).ToList();
                            <div class="tab-pane fade @(g == tab ? "show active" : "")" id="pl_@g" role="tabpanel">
                                @if (g == HospitalPriceGroups.Medicine)
                                {
                                    <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                                        <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                                        <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["The public price is a ceiling"]</h4><div class="fs-7 text-gray-700">@T["A medicine's price in any list never exceeds its approved public price. The item and its selling price come from the Inventory item card."]</div></div>
                                    </div>
                                }
                                @if (rows.Count == 0)
                                {
                                    <div class="text-center py-10"><i class="ki-outline ki-@GroupIcon(g) fs-3x text-gray-300 mb-4 d-block"></i>
                                        <div class="fs-6 fw-bold text-gray-700">@T["Nothing on this list in this group."]</div></div>
                                }
                                else
                                {
                                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                        <thead><tr class="fw-bold text-muted bg-light">
                                            <th class="ps-4 rounded-start">@T["Item"]</th><th class="text-end">@T["Main"] <bdi class="hp-num">@fac.Code</bdi></th><th class="text-end">@T["This list"] <bdi class="hp-num">@cur.Code</bdi></th><th class="text-end">@T["Change"]</th><th>@T["Source"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th>
                                        </tr></thead>
                                        <tbody>
                                            @foreach (var x in rows)
                                            {
                                                decimal mainIn = x.Entry.MainPrice * l.FrozenRate;
                                                int? diff = x.Price is decimal pr && mainIn > 0 ? (int)Math.Round((pr / mainIn - 1) * 100) : null;
                                                <tr class="@(x.Stale ? "bg-light-danger" : "")">
                                                    <td class="ps-4"><div class="d-flex align-items-center">
                                                        <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-@(x.Stale ? "danger" : "primary")"><i class="ki-outline ki-@GroupIcon(x.Entry.Group) fs-3 text-@(x.Stale ? "danger" : "primary")"></i></span></div>
                                                        <div class="d-flex flex-column">
                                                            <a href="@Url.Action("CatalogEntry", new { key = x.Entry.Key })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(x.Entry.Name, x.Entry.NameEn)</a>
                                                            <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num" dir="ltr">@x.Entry.Code</bdi> · @(x.Entry.Group == HospitalPriceGroups.Service ? T["cat:" + x.Entry.Category].Value : T["group:" + x.Entry.Group].Value)</span>
                                                        </div>
                                                    </div></td>
                                                    <td class="text-end"><span class="text-gray-700 fw-bold fs-6 hp-num">@fac.Format(x.Entry.MainPrice)</span>@if (x.Stale && x.Line!.ConfirmedMainPrice is decimal was && was != x.Entry.MainPrice) {<span class="text-muted fw-semibold d-block fs-7 hp-num"><s>@fac.Format(was)</s></span>}</td>
                                                    <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@(x.Price is decimal p ? cur.Format(p) : "—")</span></td>
                                                    <td class="text-end">@if (diff == null) {<span class="text-muted">—</span>} else {<span class="badge badge-light-@(diff < 0 ? "primary" : diff > 0 ? "primary" : "secondary") fs-7 fw-bold"><bdi class="hp-num" dir="ltr">@((diff > 0 ? "+" : "") + diff + "%")</bdi></span>}</td>
                                                    <td><span class="badge badge-light-@SrcBadge(x.Source) fs-7 fw-bold">@T["src:" + x.Source]</span></td>
                                                    <td>@if (x.Stale) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Not updated"]</span>} else {<span class="badge badge-light-primary fs-7 fw-bold">@T["Up to date"]</span>}</td>
                                                    <td class="text-end pe-4 text-nowrap">
                                                        @if (editable)
                                                        {
                                                            if (x.Stale) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" data-approve="@x.Line!.ID" title="@T["Approve"]" data-bs-toggle="tooltip"><i class="ki-outline ki-check fs-3"></i></button> }
                                                            <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" data-line="@x.Line!.ID" title="@T["Own price"]" data-bs-toggle="tooltip"><i class="ki-outline ki-pencil fs-3"></i></button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table></div>
                                }
                            </div>
                        }
                    </div></div>
                </div>
            </div>
        </div>
        <script type="application/json" id="lineRows">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(lineRows))</script>
    </div></div>
</div>

@if (canManage)
{
    @* the form modals — demo39 utilities/modals/forms/new-target *@
    <div class="modal fade" id="lineModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <form class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10" id="lineForm" autocomplete="off"><input type="hidden" name="id" />
            <div class="mb-8 text-center"><h1 class="mb-3" data-title></h1>
                <div class="text-muted fw-semibold fs-5">@T["Own price"]</div></div>
            <div class="d-flex flex-stack"><span class="text-gray-600 fw-semibold fs-6">@T["Main list price"] <bdi class="hp-num">@fac.Code</bdi></span><span class="text-gray-800 fw-bold fs-6 hp-num" dir="ltr" data-main></span></div>
            <div class="separator separator-dashed my-3"></div>
            <div class="d-flex flex-stack"><span class="text-gray-600 fw-semibold fs-6">@T["By this list's rule"] <bdi class="hp-num">@cur.Code</bdi></span><span class="text-gray-800 fw-bold fs-6 hp-num" dir="ltr" data-rule></span></div>
            <div data-cap-row><div class="separator separator-dashed my-3"></div>
                <div class="d-flex flex-stack"><span class="text-gray-600 fw-semibold fs-6">@T["Public price (ceiling)"]</span><span class="text-danger fw-bold fs-6 hp-num" dir="ltr" data-cap></span></div></div>
            <div class="fv-row mt-8"><label class="fs-6 fw-semibold mb-2">@T["Own price"] <bdi class="hp-num text-muted">@cur.Code</bdi></label><input name="fixedPrice" type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" placeholder="@T["Empty = by the rule"]" /></div>
            <label class="form-check form-switch form-check-custom form-check-solid mt-6"><input class="form-check-input" type="checkbox" name="isExcluded" /><span class="form-check-label text-gray-700 fw-semibold">@T["Not covered by this list (billed from the main list)"]</span></label>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-line>@T["Save and approve"]</button></div>
        </form>
    </div></div></div>

    <div class="modal fade" id="pickModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-8 text-center"><h1 class="mb-3">@T["Add items"]</h1>
                <div class="text-muted fw-semibold fs-5"><bdi>@DisplayName.Of(l.Name, l.NameEn)</bdi></div></div>
            <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x nav-stretch fs-6 fw-bold border-0 mb-6">
                <li class="nav-item"><a class="nav-link text-active-primary active" data-bs-toggle="tab" href="#pick_inv">@T["From the inventory"]</a></li>
                <li class="nav-item"><a class="nav-link text-active-primary" data-bs-toggle="tab" href="#pick_new">@T["New on the main list"] <span class="badge badge-light-info ms-1 hp-num" data-pending-count>@Model.Pending.Count</span></a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="pick_inv">
                    <div class="text-gray-600 fw-semibold fs-7 mb-4">@T["Any item already in the inventory, whatever its category. Choose whether it is a medicine or a consumable: that decides which of the list's percentages prices it."]</div>
                    <div class="d-flex align-items-center position-relative mb-5"><i class="ki-outline ki-magnifier fs-3 text-gray-500 position-absolute ms-4"></i>
                        <input type="text" class="form-control form-control-solid ps-12" data-inv-q autocomplete="off" placeholder="@T["Search by code, barcode or name"]" /></div>
                    <div class="table-responsive mh-350px overflow-auto"><table class="table align-middle gs-0 gy-3 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 w-40px rounded-start"></th><th>@T["Item"]</th><th>@T["Category"]</th><th class="text-end">@T["Main price"] <bdi class="hp-num">@fac.Code</bdi></th><th class="w-175px pe-4 rounded-end">@T["Type"]</th></tr></thead>
                        <tbody data-inv-rows><tr><td colspan="5"><div class="text-center py-8"><i class="ki-outline ki-magnifier fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-7 text-gray-500">@T["Type at least two letters to search."]</div></div></td></tr></tbody>
                    </table></div>
                    <div class="text-gray-600 fw-semibold fs-7 mt-4"><span class="badge badge-light-primary fs-7 fw-bold hp-num me-1" data-inv-count>0</span> @T["items selected"]</div>
                </div>
                <div class="tab-pane fade" id="pick_new">
                    <div class="text-gray-600 fw-semibold fs-7 mb-4">@T["Items on the main list that are not on this one. They come in at the rule's price and show not updated until you approve them."]</div>
                    <div class="table-responsive mh-400px overflow-auto"><table class="table align-middle gs-0 gy-3 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 w-40px rounded-start"><div class="form-check form-check-sm form-check-custom form-check-solid"><input type="checkbox" class="form-check-input" data-pick-all checked /></div></th><th>@T["Item"]</th><th>@T["Type"]</th><th class="text-end pe-4 rounded-end">@T["By the rule"] <bdi class="hp-num">@cur.Code</bdi></th></tr></thead>
                        <tbody data-pending-rows>
                            @if (Model.Pending.Count == 0) { <tr><td colspan="4"><div class="text-center py-8"><i class="ki-outline ki-check-circle fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-7 text-gray-500">@T["Every main-list item is on this list."]</div></div></td></tr> }
                            @foreach (var e in Model.Pending)
                            {
                                <tr><td class="ps-4"><div class="form-check form-check-sm form-check-custom form-check-solid"><input type="checkbox" class="form-check-input" data-pick-key="@e.Key" checked /></div></td>
                                    <td><span class="text-gray-900 fw-bold fs-6 d-block">@DisplayName.Of(e.Name, e.NameEn)</span><bdi class="text-muted fw-semibold fs-7 hp-num" dir="ltr">@e.Code</bdi></td>
                                    <td><span class="badge badge-light-primary fs-7 fw-bold">@T["group:" + e.Group]</span></td>
                                    <td class="text-end pe-4"><span class="text-gray-900 fw-bold fs-6 hp-num">@cur.Format(HospitalPricingService.Rule(e.MainPrice, l.FrozenRate, HospitalPricingService.AdjFor(l, e.Group), cur.Decimals, l.RoundingStep, e.Group == HospitalPriceGroups.Service))</span></td></tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-add-picked>@T["Add selected"]</button></div>
        </div>
    </div></div></div>

    <div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Add a category"]</h1>
                <div class="text-muted fw-semibold fs-5"><bdi>@DisplayName.Of(l.Name, l.NameEn)</bdi></div></div>
            <div class="d-flex flex-column mb-8 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Inventory category"]</label>
                <select class="form-select form-select-solid" data-cat-id data-control="select2" data-dropdown-parent="#categoryModal" data-placeholder="@T["Inventory category"]"><option value=""></option>
                    @foreach (var c in categories) { <option value="@c.Id" data-kind="@c.MappedKind" disabled="@(c.NotOnList == 0)">@(string.IsNullOrWhiteSpace(c.Code) ? "" : c.Code + " · ")@DisplayName.Of(c.Name, c.NameEn) — @string.Format(T["{0} items, {1} not on this list"].Value, c.Items, c.NotOnList)</option> }
                </select></div>
            <div class="d-flex flex-column mb-8 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Type"]</label>
                <div class="d-flex gap-3">@foreach (var k in HospitalPriceGroups.ItemKinds) { <label class="flex-fill"><input type="radio" class="btn-check" name="cat-kind" value="@k" @(k == HospitalPriceGroups.Medicine ? "checked" : "") /><span class="btn btn-outline btn-outline-dashed btn-active-light-primary w-100 d-flex align-items-center justify-content-center gap-2 fw-bold"><i class="ki-outline ki-@GroupIcon(k) fs-2"></i>@T["group:" + k]</span></label> }</div></div>
            <label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-cat-linked checked /><span class="form-check-label text-gray-700 fw-semibold">@T["Keep it linked: items added to this category later show as new on every list"]</span></label>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-add-category>@T["Add the category"]</button></div>
        </div>
    </div></div></div>

    @if (draft)
    {
        <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-750px"><div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
            <form class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10" id="editForm" autocomplete="off">
                <div class="mb-10 text-center"><h1 class="mb-3">@T["Edit the list"]</h1>
                    <div class="text-muted fw-semibold fs-5">@T["Changing the rule sends every rule-priced line back to review."]</div></div>
                <div class="row g-6">
                    <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Name (Arabic)"]</label><input name="name" value="@l.Name" maxlength="200" class="form-control form-control-solid" dir="rtl" /></div>
                    <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Name (English)"]</label><input name="nameEn" value="@l.NameEn" maxlength="200" class="form-control form-control-solid" dir="ltr" /></div>
                    <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Kind"]</label>
                        <select name="kind" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-dropdown-parent="#editModal">@foreach (var k in HospitalPriceListKinds.All) { <option value="@k" selected="@(k == l.Kind)">@T["kind:" + k]</option> }</select></div>
                    <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Currency"]</label><input class="form-control form-control-solid hp-num" value="@cur.Code" disabled /></div>
                </div>
                <div class="separator separator-dashed my-8"></div>
                <div class="fs-5 fw-bold text-gray-900 mb-5">@T["Discount rule"]</div>
                <div class="row g-6">
                    <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Services (group)"]</label><div class="input-group input-group-solid"><input name="servicesAdjPct" type="number" step="0.01" value="@l.ServicesAdjPct.ToString("0.##", inv)" class="form-control form-control-solid hp-num" dir="ltr" /><span class="input-group-text">%</span></div></div>
                    <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Medicines"]</label><div class="input-group input-group-solid"><input name="medicinesAdjPct" type="number" step="0.01" value="@l.MedicinesAdjPct.ToString("0.##", inv)" class="form-control form-control-solid hp-num" dir="ltr" /><span class="input-group-text">%</span></div></div>
                    <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Consumables"]</label><div class="input-group input-group-solid"><input name="consumablesAdjPct" type="number" step="0.01" value="@l.ConsumablesAdjPct.ToString("0.##", inv)" class="form-control form-control-solid hp-num" dir="ltr" /><span class="input-group-text">%</span></div></div>
                    <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Rounding step"]</label><input name="roundingStep" type="number" min="0" step="0.001" value="@(l.RoundingStep?.ToString("0.###", inv))" placeholder="@T["None"]" class="form-control form-control-solid hp-num" dir="ltr" /></div>
                    <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Valid from"]</label><input name="validFrom" type="date" value="@l.ValidFrom.ToString("yyyy-MM-dd")" class="form-control form-control-solid hp-num" /></div>
                    <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Valid to"]</label><input name="validTo" type="date" value="@(l.ValidTo?.ToString("yyyy-MM-dd"))" class="form-control form-control-solid hp-num" /></div>
                </div>
                <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-list>@T["Save"]</button></div>
            </form>
        </div></div></div>
    }
}

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), choose: @Json.Serialize(T["Choose the items to add"].Value),
                chooseCat: @Json.Serialize(T["Choose the category"].Value), addCat: @Json.Serialize(T["Add every item of {0} to this list?"].Value),
                none: @Json.Serialize(T["Nothing matches."].Value), onList: @Json.Serialize(T["On the list"].Value), notIn: @Json.Serialize(T["Not in the hospital catalogue yet"].Value),
                kinds: { Medicine: @Json.Serialize(T["group:Medicine"].Value), Consumable: @Json.Serialize(T["group:Consumable"].Value) } };
            // H22: search the whole inventory; what is ticked survives a new search, each with its kind
            var inv = { picked: {}, last: [], timer: null };
            function esc(v) { var d = document.createElement('div'); d.textContent = v == null ? '' : String(v); return d.innerHTML; }
            inv.render = function () {
                var tb = document.querySelector('[data-inv-rows]'); if (!tb) return;
                document.querySelector('[data-inv-count]').textContent = Object.keys(inv.picked).length;
                if (!inv.last.length) { if (inv.searched) tb.innerHTML = '<tr><td colspan="5"><div class="text-center py-8"><i class="ki-outline ki-magnifier fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-7 text-gray-500">' + esc(W.none) + '</div></div></td></tr>'; return; }
                tb.innerHTML = inv.last.map(function (h) {
                    var kind = inv.picked[h.id] || h.kind || 'Medicine', on = h.onList;
                    var opts = ['Medicine', 'Consumable'].map(function (k) { return '<option value="' + k + '"' + (k === kind ? ' selected' : '') + '>' + esc(W.kinds[k]) + '</option>'; }).join('');
                    return '<tr><td class="ps-4"><div class="form-check form-check-sm form-check-custom form-check-solid"><input type="checkbox" class="form-check-input" data-inv-pick="' + h.id + '"' + (on ? ' disabled' : '') + (inv.picked[h.id] ? ' checked' : '') + ' /></div></td>' +
                        '<td><span class="text-gray-900 fw-bold fs-6 d-block">' + esc(h.name) + (on ? ' <span class="badge badge-light-primary fs-8 fw-bold">' + esc(W.onList) + '</span>' : !h.kind ? ' <span class="badge badge-light-info fs-8 fw-bold">' + esc(W.notIn) + '</span>' : '') + '</span>' +
                        '<bdi class="text-muted fw-semibold fs-7 hp-num" dir="ltr">' + esc(h.code) + '</bdi></td>' +
                        '<td class="text-gray-600 fw-semibold fs-7">' + esc(h.category) + '</td><td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">' + Number(h.price).toFixed(3) + '</span></td>' +
                        '<td class="pe-4"><select class="form-select form-select-sm form-select-solid" data-no-select2 data-inv-kind="' + h.id + '"' + (on ? ' disabled' : '') + '>' + opts + '</select></td></tr>';
                }).join('');
                // H127: the kind is the theme's select2, never the browser's popup; its jQuery change is relayed to the
                // native 'change' listener below (guarded, as the layout's enhancer does).
                var $j = window.jQuery, pm = document.getElementById('pickModal');
                if ($j && $j.fn.select2) tb.querySelectorAll('[data-inv-kind]').forEach(function (el) {
                    $j(el).select2({ width: '100%', dir: document.documentElement.dir === 'rtl' ? 'rtl' : 'ltr', minimumResultsForSearch: Infinity, dropdownParent: $j(pm) })
                        .on('change.relay', function () { if (el.__relaying) return; el.__relaying = true; el.dispatchEvent(new Event('change', { bubbles: true })); el.__relaying = false; });
                });
            };
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-inv-q]')) return;
                clearTimeout(inv.timer); var q = e.target.value.trim();
                inv.timer = setTimeout(function () {
                    if (q.length < 2) { inv.last = []; inv.searched = false; inv.render(); return; }
                    fetch(base + '/ItemSearch?q=' + encodeURIComponent(q), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); })
                        .then(function (res) { inv.last = res.items || []; inv.searched = true; inv.render(); });
                }, 300);
            });
            document.addEventListener('change', function (e) {
                var c = e.target.closest('[data-inv-pick]');
                if (c) { var id = c.getAttribute('data-inv-pick'); if (c.checked) inv.picked[id] = document.querySelector('[data-inv-kind="' + id + '"]').value; else delete inv.picked[id]; inv.render(); return; }
                var k = e.target.closest('[data-inv-kind]');
                if (k) { var kid = k.getAttribute('data-inv-kind'); if (inv.picked[kid]) inv.picked[kid] = k.value; }
            });
            // a category already mapped brings its kind
            if (window.jQuery) jQuery(document).on('change', '[data-cat-id]', function () {
                var o = this.options[this.selectedIndex], k = o && o.getAttribute('data-kind');
                if (k) { var r = document.querySelector('#categoryModal [name=cat-kind][value=' + k + ']'); if (r) r.checked = true; }
            });
            var base = @Json.Serialize(Url.Action("PriceList", new { id = l.ID })), lineUrl = @Json.Serialize(Url.Action("SavePriceListLine", new { id = 0 }));
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function rows() { var el = document.getElementById('lineRows'); return el ? JSON.parse(el.textContent) : []; }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the server renders the page again and the content and toolbar are swapped,
            // keeping the open tab.
            function swap() {
                var active = document.querySelector('.nav-line-tabs .nav-link.active'), tab = active ? active.getAttribute('href').replace('#pl_', '') : '';
                return fetch(base + (tab ? '?tab=' + tab : ''), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    var fresh = doc.getElementById('kt_app_content'); if (fresh) document.getElementById('kt_app_content').innerHTML = fresh.innerHTML;
                    var tb = doc.querySelector('.app-toolbar .d-print-none'), cur = document.querySelector('.app-toolbar .d-print-none'); if (tb && cur) cur.innerHTML = tb.innerHTML;
                    var pick = doc.querySelector('[data-pending-rows]'), pickCur = document.querySelector('[data-pending-rows]'); if (pick && pickCur) pickCur.innerHTML = pick.innerHTML;
                    var pc = doc.querySelector('[data-pending-count]'), pcCur = document.querySelector('[data-pending-count]'); if (pc && pcCur) pcCur.textContent = pc.textContent;
                    var cs = doc.querySelector('[data-cat-id]'), csCur = document.querySelector('[data-cat-id]'); if (cs && csCur) { csCur.innerHTML = cs.innerHTML; if (window.jQuery) jQuery(csCur).trigger('change.select2'); }
                });
            }
            function done(res, modal) {
                if (!res.ok) { toast('error', res.error || W.failed); return false; }
                if (modal) bootstrap.Modal.getInstance(modal).hide();
                toast('success', W.saved); swap(); return true;
            }
            var lineModal = document.getElementById('lineModal'), lineForm = document.getElementById('lineForm');
            document.addEventListener('click', function (e) {
                var t;
                if ((t = e.target.closest('[data-approve-all]'))) { t.disabled = true; post(base + '/ApproveLines', { ids: null }).then(function (r) { t.disabled = false; done(r); }); }
                else if ((t = e.target.closest('[data-approve]'))) { t.disabled = true; post(base + '/ApproveLines', { ids: [+t.getAttribute('data-approve')] }).then(function (r) { t.disabled = false; done(r); }); }
                else if ((t = e.target.closest('[data-add-all]'))) { t.disabled = true; post(base + '/AddLines', { keys: null }).then(function (r) { t.disabled = false; done(r); }); }
                else if ((t = e.target.closest('[data-pick]'))) bootstrap.Modal.getOrCreateInstance(document.getElementById('pickModal')).show();
                else if ((t = e.target.closest('[data-pick-all]'))) document.querySelectorAll('[data-pick-key]').forEach(function (c) { c.checked = t.checked; });
                else if ((t = e.target.closest('[data-add-picked]'))) {
                    var pm = document.getElementById('pickModal');
                    if (document.getElementById('pick_inv').classList.contains('active')) {
                        var items = Object.keys(inv.picked).map(function (id) { return { itemId: +id, kind: inv.picked[id] }; });
                        if (!items.length) { toast('error', W.choose); return; }
                        t.disabled = true; post(base + '/AddItems', { items: items }).then(function (r) { t.disabled = false; if (done(r, pm)) { inv.picked = {}; inv.render(); } });
                        return;
                    }
                    var keys = [].slice.call(document.querySelectorAll('[data-pick-key]:checked')).map(function (c) { return c.getAttribute('data-pick-key'); });
                    if (!keys.length) { toast('error', W.choose); return; }
                    t.disabled = true; post(base + '/AddLines', { keys: keys }).then(function (r) { t.disabled = false; done(r, pm); });
                }
                else if ((t = e.target.closest('[data-pick-category]'))) bootstrap.Modal.getOrCreateInstance(document.getElementById('categoryModal')).show();
                else if ((t = e.target.closest('[data-add-category]'))) {
                    var cm = document.getElementById('categoryModal'), sel = cm.querySelector('[data-cat-id]');
                    if (!sel.value) { toast('error', W.chooseCat); return; }
                    var kind = (cm.querySelector('[name=cat-kind]:checked') || {}).value, linked = cm.querySelector('[data-cat-linked]').checked;
                    var label = sel.options[sel.selectedIndex].textContent.split(' — ')[0];
                    cbConfirm(W.addCat.replace('{0}', label)).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post(base + '/AddCategory', { categoryId: +sel.value, kind: kind, keepLinked: linked }).then(function (r) { t.disabled = false; done(r, cm); });
                    });
                }
                else if ((t = e.target.closest('[data-line]'))) {
                    var r = rows().filter(function (x) { return x.id === +t.getAttribute('data-line'); })[0]; if (!r) return;
                    lineModal.querySelector('[data-title]').textContent = r.name;
                    lineModal.querySelector('[data-main]').textContent = r.main; lineModal.querySelector('[data-rule]').textContent = r.rule;
                    lineModal.querySelector('[data-cap-row]').style.display = r.cap ? '' : 'none'; lineModal.querySelector('[data-cap]').textContent = r.cap || '';
                    lineForm.elements.id.value = r.id; lineForm.elements.fixedPrice.value = r.fixedPrice == null ? '' : r.fixedPrice; lineForm.elements.isExcluded.checked = r.excluded;
                    bootstrap.Modal.getOrCreateInstance(lineModal).show();
                }
                else if ((t = e.target.closest('[data-save-line]'))) {
                    var f = lineForm.elements;
                    t.disabled = true;
                    post(lineUrl.replace(/0\/Save$/, f.id.value + '/Save'), { fixedPrice: f.fixedPrice.value === '' ? null : +f.fixedPrice.value, isExcluded: f.isExcluded.checked })
                        .then(function (r) { t.disabled = false; done(r, lineModal); });
                }
                else if ((t = e.target.closest('[data-post]'))) {
                    var msg = t.getAttribute('data-confirm');
                    if (msg && !t.hasAttribute('data-confirmed')) { cbConfirm(msg, { kind: t.getAttribute('data-confirm-kind') || 'primary' }).then(function (ok) { if (ok) { t.setAttribute('data-confirmed', ''); t.click(); } }); return; }
                    t.removeAttribute('data-confirmed');
                    var what = t.getAttribute('data-post'); t.disabled = true;
                    post(base + '/' + what).then(function (r) {
                        t.disabled = false;
                        if (!r.ok) { toast('error', r.error || W.failed); return; }
                        if (what === 'Copy') location.href = base.replace(/\/\d+$/, '/' + r.id); else { toast('success', W.saved); swap(); }
                    });
                }
                else if ((t = e.target.closest('[data-edit-list]'))) bootstrap.Modal.getOrCreateInstance(document.getElementById('editModal')).show();
                else if ((t = e.target.closest('[data-save-list]'))) {
                    var g = document.getElementById('editForm').elements, num = function (n) { return g[n].value === '' ? null : +g[n].value; };
                    t.disabled = true;
                    post(base + '/Update', { name: g.name.value, nameEn: g.nameEn.value, kind: g.kind.value, servicesAdjPct: num('servicesAdjPct') || 0, medicinesAdjPct: num('medicinesAdjPct') || 0,
                        consumablesAdjPct: num('consumablesAdjPct') || 0, roundingStep: num('roundingStep'), validFrom: g.validFrom.value || null, validTo: g.validTo.value || null })
                        .then(function (r) { t.disabled = false; done(r, document.getElementById('editModal')); });
                }
            });
        })();
    </script>
}
