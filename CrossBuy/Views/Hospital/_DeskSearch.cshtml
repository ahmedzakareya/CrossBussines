@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalDeskCandidate>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H139/H140: the one search's candidates, ranked, as the prototype lays them out: face, name, file, age and sex,
   mobile; the ID; what matched; today's visit; and the acts (check in today's visit, or a walk-in; open at the counter).
   Registering a new patient is offered only after a search, as the desk should. *@
@{ bool canBook = ViewBag.CanBook == true;
   var whereOf = ViewBag.Where as Dictionary<int, IReadOnlyList<HospitalWhere>> ?? new(); var hidden = ViewBag.Restricted as HashSet<int> ?? new(); }
@if (Model.Count == 0)
{
    <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6">
        <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label bg-primary"><i class="ki-outline ki-user-tick fs-2x text-white"></i></span></span>
        <div class="d-flex flex-stack flex-grow-1 flex-wrap gap-3"><div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["No file matches"]</h4>
            <div class="fs-6 text-gray-700">@T["Check the spelling or search by the national ID or phone before opening a new file."]</div></div>
            <button type="button" class="btn btn-sm btn-primary" data-desk-register data-q="@ViewBag.Query"><i class="ki-outline ki-plus fs-4"></i>@T["Register a patient"]</button></div>
    </div>
}
else
{
    <div class="border border-gray-300 border-dashed rounded">
        @for (int i = 0; i < Model.Count; i++)
        {
            var c = Model[i];
            <div class="d-flex flex-wrap align-items-center gap-4 px-5 py-4 @(i > 0 ? "border-top border-dashed border-gray-300" : "") bg-hover-light">
                <a href="#" class="d-flex align-items-center flex-grow-1 min-w-250px text-hover-primary" data-open-patient="@c.PatientId">
                    <div class="symbol symbol-50px symbol-circle me-4 flex-shrink-0">@if (c.Photo != null) {<img src="@c.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-6 hp-initials">@HospitalUi.Initials(c.NameEn ?? c.Name)</span>}</div>
                    <div class="d-flex flex-column min-w-0">
                        <span class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(c.Name, c.NameEn)</bdi></span>
                        <span class="text-muted fs-7"><span class="hp-num">@c.Mrn</span> · @T["sex:" + c.Sex]@if (c.Age is int ag) {<text> · @string.Format(T["{0} years"].Value, ag)</text>}@if (c.Phone != null) {<text> · </text><span class="hp-num" dir="ltr">@c.Phone</span>}</span>
                        @* H154: where they are now — the answer a visitor asks for *@
                        @if (hidden.Contains(c.PatientId)) {<span class="fs-8 text-gray-600 mt-1" data-where><i class="ki-outline ki-lock-2 fs-8 me-1"></i>@T["Confidential file"]</span>}
                        else if (whereOf.GetValueOrDefault(c.PatientId) is { Count: > 0 } here) {<span class="fs-7 fw-bold text-primary mt-1" data-where><i class="ki-outline ki-geolocation fs-7 text-primary me-1"></i><bdi>@DisplayName.Of(here[0].Place, here[0].PlaceEn)</bdi>@if (here[0].Detail != null) {<span class="text-gray-600 fw-semibold"> · <bdi>@DisplayName.Of(here[0].Detail, here[0].DetailEn)</bdi></span>}</span>}
                    </div>
                </a>
                <div class="min-w-150px"><div class="text-muted fs-8">@T["match:id"]</div><div class="fw-bold hp-num fs-7">@(c.NationalId ?? "—")</div></div>
                <div class="min-w-125px"><div class="text-muted fs-8">@T["Matched by"]</div><span class="badge badge-light-@(c.Score >= 90 ? "success" : "primary") fs-8 fw-bold">@T["match:" + c.Reason] · <span class="hp-num">@c.Score%</span></span></div>
                <div class="min-w-150px">@if (c.TodayStatus != null) {<div class="text-muted fs-8">@T["Today"]</div><span class="badge badge-light-info fs-8 fw-bold">@T["desk:" + HospitalFrontDeskRules.Stage(c.TodayStatus)]@if (c.QueueNumber is int q) {<text> · </text><span class="hp-num">#@q</span>}</span>}</div>
                <div class="d-flex gap-1 ms-auto">
                    @if (canBook && c.TodayAppointmentId is int ap && c.TodayStatus == CrossBuy.Models.Context.Hospital.HospitalAppointmentStatus.Booked)
                    {
                        <button type="button" class="btn btn-sm btn-primary text-nowrap" data-move="Arrived" data-appt="@ap"><i class="ki-outline ki-check fs-5"></i>@T["Check in"]</button>
                    }
                    else if (canBook && c.TodayStatus == null)
                    {
                        <button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-desk-walkin="@c.PatientId"><i class="ki-outline ki-entrance-right fs-5"></i>@T["Walk-in"]</button>
                    }
                    <button type="button" class="btn btn-sm btn-icon btn-light btn-active-light-primary" data-open-patient="@c.PatientId" title="@T["Open at the counter"]" data-bs-toggle="tooltip"><i class="ki-outline ki-profile-circle fs-4"></i></button>
                </div>
            </div>
        }
    </div>
    <div class="d-flex justify-content-end mt-3"><button type="button" class="btn btn-sm btn-light btn-active-light-primary" data-desk-register data-q="@ViewBag.Query"><i class="ki-outline ki-plus fs-5"></i>@T["Not here? Register a patient"]</button></div>
}
