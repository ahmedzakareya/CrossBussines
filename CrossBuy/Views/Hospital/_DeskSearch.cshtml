@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalDeskCandidate>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H139: the one search's candidates, ranked. Each shows the face, name, file, age and sex, phone, what matched and
   today's appointment. Below them, registering a new patient: offered only after a search, as the desk should. *@
@if (Model.Count == 0)
{
    <div class="notice d-flex bg-light rounded border border-dashed border-gray-300 p-5">
        <i class="ki-outline ki-user-tick fs-2tx text-primary me-4"></i>
        <div class="d-flex flex-stack flex-grow-1 flex-wrap gap-3"><div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["No file matches"]</h4>
            <div class="fs-7 text-gray-600">@T["Check the spelling or search by the national ID or phone before opening a new file."]</div></div>
            <a href="@Url.Action("RegisterPatient", "Hospital")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-4"></i>@T["Register a patient"]</a></div>
    </div>
}
else
{
    <div class="border border-gray-300 border-dashed rounded">
        @for (int i = 0; i < Model.Count; i++)
        {
            var c = Model[i];
            <a href="#" class="d-flex align-items-center px-5 py-3 bg-hover-light-primary" data-open-patient="@c.PatientId">
                <div class="symbol symbol-45px symbol-circle me-4 flex-shrink-0">@if (c.Photo != null) {<img src="@c.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-7 hp-initials">@HospitalUi.Initials(c.NameEn ?? c.Name)</span>}</div>
                <div class="d-flex flex-column flex-grow-1 min-w-0">
                    <span class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(c.Name, c.NameEn)</bdi></span>
                    <span class="text-muted fs-7"><span class="hp-num">@c.Mrn</span> · @T["sex:" + c.Sex]@if (c.Age is int ag) {<text> · @string.Format(T["{0} years"].Value, ag)</text>}@if (c.Phone != null) {<text> · </text><span class="hp-num" dir="ltr">@c.Phone</span>}</span>
                </div>
                <div class="d-flex flex-column align-items-end gap-1 ms-3">
                    <span class="badge badge-light-@(c.Score >= 90 ? "success" : "primary") fs-8 fw-bold">@T["match:" + c.Reason] · <span class="hp-num">@c.Score%</span></span>
                    @if (c.TodayStatus != null) {<span class="badge badge-light-info fs-8 fw-bold">@T["Today"]: @T["desk:" + HospitalFrontDeskRules.Stage(c.TodayStatus)]@if (c.QueueNumber is int q) {<text> · </text><span class="hp-num">#@q</span>}</span>}
                </div>
            </a>
            if (i < Model.Count - 1) { <div class="separator separator-dashed"></div> }
        }
    </div>
    <div class="d-flex justify-content-end mt-3"><a href="@Url.Action("RegisterPatient", "Hospital")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-plus fs-5"></i>@T["Not here? Register a patient"]</a></div>
}
