@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model (bool Ready, IReadOnlyList<HospitalPortalThreadRow> Rows, int Total, int Awaiting, int Overdue)
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H249 — the clinic's inbox of portal messages: conversations waiting for a reply first (overdue past two days), the
    chosen conversation with every message and who answered (photo), reply and close. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Portal messages"].Value;
    string q = ViewBag.Q as string ?? "", view = ViewBag.View as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    var open = ViewBag.Open as HospitalPortalThreadView;
    string Link(int p, string? v = null, int? id = null) => Url.Action("PortalMessages", new { q, view = v ?? view, page = p, id })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string When(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("dd/MM HH:mm", inv);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Portal messages"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Patient portal"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["Portal messages"]</li></ul>
        </div>
        <div class="d-flex gap-2">
            @foreach (var (v, label) in new[] { ("", T["Awaiting reply"].Value + " (" + Model.Awaiting + ")"), ("mine", T["Mine"].Value), ("all", T["All open"].Value), ("closed", T["Closed"].Value) })
            {<a href="@Link(1, v)" class="btn btn-sm @(view == v ? "btn-primary" : "btn-light")">@label</a>}
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalPortalMessageService.NoTables]</div></div>
        }
        @if (Model.Overdue > 0) {<div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["{0} conversations are past the two-day reply time", Model.Overdue]</div></div>}
        <div class="row g-5">
            <div class="col-xl-5">
                <div class="card card-flush h-100">
                    <div class="card-header pt-5">
                        <form class="card-title gap-2 w-100" method="get" action="@Url.Action("PortalMessages")"><input type="hidden" name="view" value="@view" />
                            <div class="position-relative flex-grow-1"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                                <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid ps-12" placeholder="@T["Search a patient or subject"]" /></div>
                            <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button></form>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Rows.Count == 0) {<div class="text-center py-15"><i class="ki-outline ki-messages fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No conversation here."]</div></div>}
                        @foreach (var r in Model.Rows)
                        {
                            var t = r.Thread;
                            <a href="@Link(page, null, t.ID)" class="d-flex align-items-center gap-3 py-3 border-bottom border-gray-200 border-bottom-dashed text-hover-primary @(open?.Thread.ID == t.ID ? "bg-light-primary rounded px-2" : "")">
                                @HospitalUi.Avatar(r.Photo, DisplayName.Of(r.PatientName, r.PatientNameEn), 35)
                                <div class="flex-grow-1 min-w-0"><div class="fw-bold text-gray-900 text-truncate">@DisplayName.Of(r.PatientName, r.PatientNameEn) <span class="text-muted fw-semibold fs-8">· @T["pt:" + t.Topic]</span></div>
                                    <div class="text-gray-700 fs-7 text-truncate" dir="auto">@t.Subject</div>
                                    <div class="text-muted fs-8 hp-num" dir="ltr" style="text-align:start">@When(t.LastMessageAt)</div></div>
                                <div class="d-flex flex-column align-items-end gap-1">
                                    @if (r.Unread > 0) {<span class="badge badge-circle badge-primary hp-num">@r.Unread</span>}
                                    @if (r.Overdue) {<span class="badge badge-light-danger fs-9">@T["Overdue"]</span>} else if (t.AwaitingClinic && t.Status == HospitalPortalThreadStatus.Open) {<span class="badge badge-light-info fs-9">@T["Awaiting reply"]</span>}
                                    @if (r.Assigned != null) {<span title="@DisplayName.Of(r.Assigned.Name ?? "", r.Assigned.NameEn)" data-bs-toggle="tooltip">@HospitalUi.Avatar(r.Assigned.Photo, DisplayName.Of(r.Assigned.Name ?? "", r.Assigned.NameEn), 22)</span>}
                                </div>
                            </a>
                        }
                        @if (pages > 1)
                        {
                            <ul class="pagination mt-6">
                                <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                                @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                                <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-7">
                <div class="card card-flush h-100">
                    @if (open == null)
                    {
                        <div class="card-body d-flex flex-column flex-center text-center py-20"><i class="ki-outline ki-messages fs-5x text-gray-300 mb-5"></i><div class="text-muted fs-6">@T["Choose a conversation."]</div></div>
                    }
                    else
                    {
                        <div class="card-header pt-5">
                            <div class="card-title d-flex align-items-center gap-3">@HospitalUi.Avatar(open.Photo, DisplayName.Of(open.PatientName, open.PatientNameEn), 40)
                                <div><div class="fw-bold text-gray-900 fs-5"><a href="@Url.Action("Patient", new { id = open.Thread.PatientId })" class="text-gray-900 text-hover-primary">@DisplayName.Of(open.PatientName, open.PatientNameEn)</a></div>
                                    <div class="text-muted fs-7" dir="auto">@T["pt:" + open.Thread.Topic] · @open.Thread.Subject</div></div></div>
                            @if (open.Thread.Status == HospitalPortalThreadStatus.Open) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-light" data-pmc-close="@open.Thread.ID">@T["Close the conversation"]</button></div>}
                        </div>
                        <div class="card-body pt-2">
                            @foreach (var (m, staff) in open.Messages)
                            {
                                <div class="d-flex mb-6 @(m.FromPatient ? "justify-content-start" : "justify-content-end")">
                                    <div class="d-flex flex-column @(m.FromPatient ? "align-items-start" : "align-items-end") mw-75">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            @if (!m.FromPatient && staff != null) {@HospitalUi.Avatar(staff.Photo, DisplayName.Of(staff.Name ?? "", staff.NameEn), 25)<span class="fw-bold fs-8 text-gray-800">@DisplayName.Of(staff.Name ?? "", staff.NameEn)</span>}
                                            <span class="text-muted fs-8 hp-num" dir="ltr">@When(m.At)</span>
                                        </div>
                                        <div class="p-4 rounded @(m.FromPatient ? "bg-light" : "bg-light-primary") text-gray-900 fw-semibold fs-6" dir="auto" style="white-space:pre-line">@m.Body</div>
                                    </div>
                                </div>
                            }
                            @if (open.Thread.Status == HospitalPortalThreadStatus.Open)
                            {
                                <div class="mt-6"><textarea class="form-control form-control-solid" rows="3" maxlength="2000" dir="auto" placeholder="@T["Write your reply"]" data-pmc-body></textarea>
                                    <div class="d-flex justify-content-end gap-2 mt-3"><button type="button" class="btn btn-light-primary" data-pmc-send="@open.Thread.ID" data-close="1">@T["Reply and close"]</button><button type="button" class="btn btn-primary" data-pmc-send="@open.Thread.ID">@T["Reply"]</button></div></div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/PortalMessages/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), close: @Json.Serialize(T["Close this conversation without a reply?"].Value) };
            function post(id, b) { return fetch(root + id, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function after(res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-pmc-send],[data-pmc-close]'); if (!t) return;
                if (t.hasAttribute('data-pmc-close')) { cbConfirm(W.close).then(function (ok) { if (ok) post(t.getAttribute('data-pmc-close'), { close: true }).then(after); }); return; }
                t.disabled = true;
                post(t.getAttribute('data-pmc-send'), { body: document.querySelector('[data-pmc-body]').value, close: t.getAttribute('data-close') === '1' }).then(function (r) { t.disabled = false; after(r); });
            });
        })();
    </script>
}
