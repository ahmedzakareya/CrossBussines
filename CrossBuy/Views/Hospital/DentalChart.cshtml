@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDentalChartView?
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Dental & perio chart"].Value;
    bool canConsult = ViewBag.CanConsult == true;
    var procs = (ViewBag.Procedures as IReadOnlyList<HospitalDentalProcedureRow>) ?? Array.Empty<HospitalDentalProcedureRow>();
    var dentists = (ViewBag.Dentists as IReadOnlyList<HospitalDentist>) ?? Array.Empty<HospitalDentist>();
    var m = Model;
    // the chart's own words for the marks (the renderer reads cond / plan / done / exist) — HospitalDentalChartData,
    // shared with the patient's dental report on the portal
    string Key(string status) => HospitalDentalChartData.MarkKey(status);
    string[] Lines(string? s) => (s ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    int? age = m == null ? null : HospitalPatientService.AgeOn(m.Patient.BirthDate, DateTime.UtcNow);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/hospital-dental-chart.css" rel="stylesheet" asp-append-version="true" />
@* The chart as the approved prototype draws it. No amber/yellow (house rule): red, red hatch, blue, green. *@
<style>
    .dn-pick svg polygon, .dn-pick svg rect { cursor: pointer; }
    /* the perio entry grid: a fixed label column, one line per measure, the arch scrolls under it */
    .pe-wrap { display: flex; border: 1px solid #E2E8F0; border-radius: 8px; overflow: hidden; }
    .pe-scroll { overflow-x: auto; flex: 1 1 auto; width: 0; }
    .pe-labels { flex: 0 0 auto; background: #fff; }
    .pe-labels.pe-end { border-left: 1px solid #E2E8F0; } .pe-labels.pe-start { border-right: 1px solid #E2E8F0; }
    .pe-table, .pe-labels table { border-collapse: separate; border-spacing: 0; margin: 0; }
    .pe-table th, .pe-table td, .pe-labels th, .pe-labels td { padding: 0 6px !important; white-space: nowrap; vertical-align: middle; }
    /* the same height for a row in both tables, so a label always sits on its row */
    .pe-h { height: 34px; } .pe-r { height: 38px; } .pe-s { height: 30px; }
    .pe-lbl { min-width: 120px; font-size: .8rem; }
    .pe-cell { text-align: center; border-left: 1px solid #EEF0F4; }
    .pe-s td, .pe-s th { background: #F7FAFF; }
    .pe-in { width: 28px; height: 28px; padding: 0; margin: 0 1px; text-align: center; font-size: 12px; border: 1px solid #E2E8F0; border-radius: 4px; }
    .pe-in:focus { border-color: var(--cb-brand, #3A5795); outline: none; }
    .pe-site { display: inline-flex; width: 30px; justify-content: center; }
    .pe-bop { width: 16px; height: 16px; accent-color: #DC2626; }
</style>
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Dental & perio chart"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("DentalPlans")" class="text-muted text-hover-primary">@T["Dentistry"]</a></li>
                @if (m != null)
                {
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">@DisplayName.Of(m.Patient.Name, m.Patient.NameEn)</li>
                }
            </ul>
        </div>
        @if (m != null)
        {
            <div class="d-flex gap-2">
                @* printing — Report Studio layouts, see _ReportPrintMenu: the prescription of the latest visit, the plan's claim form *@
                @if (ViewBag.PrintEncounterId is int rxVisit)
                {
                    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalConsult, ButtonLabel = T["Prescription"].Value, DocumentId = rxVisit.ToString(), DocumentTitle = T["Prescription"].Value })
                }
                @if (m.LatestPlanId is int lpPrint)
                {
                    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDentalPlan, ButtonLabel = T["Dental claim"].Value, DocumentId = lpPrint.ToString(), DocumentTitle = T["Treatment plan"].Value })
                }
                @if (m.LatestPlanId is int lp) { <a href="@Url.Action("DentalPlan", new { id = lp })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-document fs-4"></i>@T["Treatment plan"]</a> }
                @if (canConsult) { <button type="button" class="btn btn-sm btn-primary" data-mark-open><i class="ki-outline ki-plus fs-4"></i>@T["Procedure on a tooth"]</button> }
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (m == null)
        {
            <div class="card"><div class="card-body py-15"><div class="mw-500px mx-auto text-center">
                <i class="ki-outline ki-emoji-happy fs-3x text-gray-300 d-block mb-4"></i>
                <div class="fw-bold fs-5 text-gray-900 mb-2">@T["Open a patient's chart"]</div>
                <div class="text-muted fs-7 mb-6">@T["Search by name, file number or phone"]</div>
                <select class="form-select form-select-solid" data-dn-patient data-person-select data-person-ajax="@Url.Action("SearchDentalPatients")" data-searching="@T["Searching…"]" data-no-results="@T["No patient matches"]" data-placeholder="@T["Patient"]"><option value=""></option></select>
            </div></div></div>
        }
        else
        {
            var p = m.Patient;
            <div class="card mb-5"><div class="card-body d-flex flex-wrap align-items-center gap-5 py-6">
                <div class="d-flex align-items-center gap-4">
                    <div class="symbol symbol-55px symbol-circle flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(p.NameEn)</span>}</div>
                    <div><a href="@Url.Action("Patient", new { id = p.ID })" class="fw-bold fs-5 text-gray-900 text-hover-primary">@DisplayName.Of(p.Name, p.NameEn)</a>
                        <div class="text-muted fs-7"><span class="hp-num">@p.Mrn</span>@if (age != null) {<text> · </text><span class="hp-num">@age</span> @T["y"]} · @(p.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])</div></div>
                </div>
                @* the medical alerts a dentist must see before any procedure, from the patient's own record *@
                <div class="ms-auto d-flex flex-wrap gap-2">
                    @foreach (var a in Lines(p.Allergies)) { <span class="badge badge-danger fs-8">@T["Allergy:"] @a</span> }
                    @foreach (var c in Lines(p.ChronicConditions)) { <span class="badge badge-primary fs-8">@c</span> }
                    @if (age is < 18) { <span class="badge badge-primary fs-8">@T["Child — guardian attends"]</span> }
                    <span class="badge badge-info fs-8">@(m.Payer == null ? T["Self-pay"].Value : DisplayName.Of(m.Payer, m.PayerEn ?? m.Payer))</span>
                </div>
            </div></div>

            @* the four tabs are shared with the patient's dental report on the portal (the same drawing, data and words) *@
            <partial name="_HospitalDentalTabs" model="@(new HospitalDentalTabsModel(m, Staff: true, Edit: canConsult, Photo: d => d.Photo, ImageLink: x => Url.Action("RadOrder", new { id = x.Id }),
                Pictures: ViewBag.Pictures as Dictionary<int, IReadOnlyList<HospitalRadImageRow>>, PictureSrc: i => Url.Action("RadImage", new { id = i })))" />
        }
    </div></div>
</div>

@if (m != null && canConsult)
{
    <div class="modal fade" id="markModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0 fs-4">@T["Procedure on a tooth"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10">
            <div class="d-flex gap-2 mb-5">
                @foreach (var k in new[] { "plan", "cond", "exist", "state" })
                {
                    <label class="flex-fill"><input type="radio" class="btn-check" name="mk-kind" value="@k" @(k == "plan" ? "checked" : "") /><span class="btn btn-sm btn-light w-100 fw-bold">@T["mk:" + k]</span></label>
                }
            </div>
            <div class="row g-4">
                <div class="col-md-4"><label class="form-label">@T["Tooth"]</label><select class="form-select form-select-solid" data-mk="tooth"></select></div>
                <div class="col-md-8" data-mk-for="plan"><label class="form-label required">@T["Plan phase"]</label>
                    <select class="form-select form-select-solid" data-mk="phase">
                        @foreach (var op in m.OpenPlans) { foreach (var ph in op.PendingPhases) { <option value="@ph.Id">@op.PlanNo · @T["Phase"] @ph.Seq — @DisplayName.Of(ph.Title, ph.TitleEn)</option> } }
                        <option value="new">@T["A new treatment plan…"]</option>
                    </select></div>
                <div class="col-12" data-mk-for="plan"><label class="form-label required">@T["Procedure"]</label>
                    <select class="form-select form-select-solid" data-mk="service" data-control="select2" data-dropdown-parent="#markModal">
                        @foreach (var pr in procs) { <option value="@pr.Procedure.ServiceId" data-surf="@pr.Procedure.Surfaces" data-work="@pr.Procedure.ToothWork" data-tooth="@(pr.Procedure.NeedsTooth ? "1" : "0")">@pr.Code — @DisplayName.Of(pr.Name, pr.NameEn)</option> }
                    </select></div>
                <div class="col-md-6" data-mk-for="exist"><label class="form-label">@T["Whole tooth"]</label>
                    <select class="form-select form-select-solid" data-mk="work"><option value="">@T["— on surfaces —"]</option>@foreach (var w in new[] { HospitalToothWork.Crown, HospitalToothWork.RootCanal, HospitalToothWork.Implant }) { <option value="@w">@T["work:" + w]</option> }</select></div>
                <div class="col-md-6" data-mk-for="state"><label class="form-label">@T["State of the tooth"]</label>
                    <select class="form-select form-select-solid" data-mk="state"><option value="Missing">@T["Missing"]</option><option value="Impacted">@T["Impacted"]</option></select></div>
                <div class="col-12" data-mk-surf-wrap>
                    <label class="form-label">@T["Surfaces"] <span class="text-muted fs-8">@T["click them on the top view"]</span></label>
                    <div class="d-flex align-items-center gap-5"><div class="dn-pick" data-mk-pick></div><div><div class="fs-2 fw-bold hp-num text-gray-900" data-mk-surf-text>—</div><div class="text-muted fs-8" data-mk-surf-need></div></div></div>
                </div>
                <div class="col-md-6" data-mk-for="plan"><label class="form-label">@T["Done by"] <span class="text-muted fs-8">@T["when not the plan's dentist"]</span></label>
                    <select class="form-select form-select-solid" data-mk="provider" data-person-select data-allow-clear data-placeholder="@T["The plan's dentist"]"><option value=""></option>@foreach (var d in dentists) { <option value="@d.Id" data-photo="@d.Photo" data-initials="@HospitalUi.Initials(d.NameEn)">@DisplayName.Of(d.Name, d.NameEn)</option> }</select></div>
                @* H33: the patient reads the note in their language — both are written; English is optional *@
                <div class="col-md-6" data-mk-for="cond exist state"><label class="form-label">@T["Note"] — @T["Arabic"]</label><input class="form-control form-control-solid" maxlength="300" dir="auto" data-mk="note" /></div>
                <div class="col-md-6" data-mk-for="cond exist state"><label class="form-label">@T["Note"] — @T["English"]</label><input class="form-control form-control-solid" maxlength="300" dir="auto" data-mk="noteEn" /></div>
            </div>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-mk-save>@T["Record"]</button></div>
    </div></div></div>

    <div class="modal fade" id="planModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0 fs-4">@T["New treatment plan"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-12"><label class="form-label">@T["Dentist"]</label>
                <select class="form-select form-select-solid" data-pl="dentist" data-person-select data-allow-clear data-placeholder="@T["Dentist"]"><option value=""></option>@foreach (var d in dentists) { <option value="@d.Id" data-photo="@d.Photo" data-initials="@HospitalUi.Initials(d.NameEn)">@DisplayName.Of(d.Name, d.NameEn)</option> }</select></div>
            <div class="col-md-6"><label class="form-label required">@T["First phase (Arabic)"]</label><input class="form-control form-control-solid" maxlength="150" dir="rtl" data-pl="title" placeholder="عاجل — الألم والعدوى" /></div>
            <div class="col-md-6"><label class="form-label required">@T["First phase (English)"]</label><input class="form-control form-control-solid" maxlength="150" dir="ltr" data-pl="titleEn" placeholder="Urgent — pain and infection" /></div>
        </div></div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-pl-save>@T["Open the plan"]</button></div>
    </div></div></div>

    <div class="modal fade" id="perioModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-lg-down"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0 fs-4">@T["Record a perio exam"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10">
            <div class="row g-4 mb-5">
                <div class="col-sm-5 col-lg-3"><label class="form-label required">@T["Date"]</label><input type="date" class="form-control form-control-solid" data-pe="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" max="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
                <div class="col-sm-7 col-lg-5"><label class="form-label">@T["Examiner"]</label>
                    <select class="form-select form-select-solid" data-pe="examiner" data-person-select data-allow-clear data-placeholder="@T["Examiner"]"><option value=""></option>@foreach (var d in dentists) { <option value="@d.Id" data-photo="@d.Photo" data-initials="@HospitalUi.Initials(d.NameEn)">@DisplayName.Of(d.Name, d.NameEn)</option> }</select></div>
                <div class="col-lg-4 d-flex align-items-end"><div class="text-muted fs-8">@T["Leave a tooth's depths empty to skip it. Opens with the last exam's values."]</div></div>
            </div>
            <div id="pe_grid"></div>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-pe-save>@T["Save the exam"]</button></div>
    </div></div></div>
}

@if (m != null) { @await Html.PartialAsync("_ReportPreviewModal", (object)(T["Dental chart"].Value)) }

@section Scripts {
    <partial name="_PersonSelect" />
    <partial name="_HospitalPrompt" />
    <script src="~/js/hospital/hospital-dental.js" asp-append-version="true"></script>
    <partial name="_HospitalDentalText" />
    <script>
        (function () {
            var HD = window.HospitalDental, tokenEl = document.querySelector('input[name="__RequestVerificationToken"]'), token = tokenEl ? tokenEl.value : '';
            // the renderer's words are the shared ones (the patient's dental report uses the same); these are the dentist's own
            var W = Object.assign({}, window.HospitalDentalText, { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                add: @Json.Serialize(T["Add a procedure to this tooth"].Value),
                voidQ: @Json.Serialize(T["Take this mark off the chart? It stays in the record as made in error."].Value), noTooth: @Json.Serialize(T["— no tooth —"].Value),
                need: @Json.Serialize(T["this code bills {0} surfaces"].Value), recordQ: @Json.Serialize(T["Record this on tooth {0}?"].Value), planQ: @Json.Serialize(T["Add {0} to the plan?"].Value),
                openQ: @Json.Serialize(T["Open a treatment plan for this patient?"].Value), searching: @Json.Serialize(T["Searching…"].Value), noResults: @Json.Serialize(T["No patient matches"].Value), perioQ: @Json.Serialize(T["Save the perio exam of {0} teeth?"].Value), dentQ: @Json.Serialize(T["Draw the chart in this dentition from now on?"].Value) });
            function toast(k, msg) { if (window.toastr) toastr[k](msg); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

            // Plain script with no Razor text blocks (Razor would parse the HTML inside the JS strings): the page branches on its own data.
            if (!document.getElementById('dn_data')) {
                // the shared picker (photos, the first page on open); choosing a patient opens their chart
                var pick = document.querySelector('[data-dn-patient]');
                if (pick && window.$) $(pick).on('select2:select', function (e) { location.href = @Json.Serialize(Url.Action("DentalChart")) + '/' + e.params.data.id; });
            } else {
            var patientId = @(m?.Patient.ID ?? 0), root = @Json.Serialize(Url.Content("~/Hospital/Dental"));
            var teeth, marks, perio, mob, furc;
            function load() { var d = JSON.parse(document.getElementById('dn_data').textContent); teeth = d.teeth; marks = d.marks; perio = d.perio; mob = d.mob; furc = d.furc; }
            load();
            var procs = @Json.Serialize(procs.ToDictionary(x => x.Procedure.ServiceId.ToString(), x => new { code = x.Code, name = DisplayName.Of(x.Name, x.NameEn), fee = x.Price }));
            var canConsult = @(canConsult ? "true" : "false");
            var dentition = @Json.Serialize(m?.Dentition);
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html'), f = doc.getElementById('kt_app_content');
                    if (f) {
                        var active = document.querySelector('.nav-tabs .nav-link.active'), href = active && active.getAttribute('href');
                        document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                        var tb = doc.getElementById('kt_app_toolbar'); if (tb) { document.getElementById('kt_app_toolbar').innerHTML = tb.innerHTML; if (window.KTMenu) KTMenu.createInstances(); }   // a new plan's button; the print menu is a KTMenu
                        load();
                        if (href) { var a = document.querySelector('.nav-tabs [href="' + href + '"]'); if (a && window.bootstrap) bootstrap.Tab.getOrCreateInstance(a).show(); }
                        // a new plan's phase arrives with the page: the window's phase list follows it
                        var ph = doc.querySelector('[data-mk=phase]'); if (ph) document.querySelector('[data-mk=phase]').innerHTML = ph.innerHTML;
                        wire();
                    }
                });
            }
            function done(btn, modal) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); if (modal) bootstrap.Modal.getOrCreateInstance(modal).hide(); swap(); }; }

            function drawChart() {
                var box = document.getElementById('dn_chart_box'); if (!box) return;
                box.innerHTML = HD.DEFS + HD.chart(teeth, dentition, W);
                box.querySelectorAll('.dn-tooth').forEach(function (el) { el.addEventListener('click', function () { select(+el.getAttribute('data-tooth'), el); }); });
            }
            function badge(st) { return '<span class="badge fs-8" style="background:' + HD.MARK_SOLID[st] + ';color:#fff">' + W.st[st] + '</span>'; }
            function select(n, el) {
                document.querySelectorAll('.dn-tooth.sel').forEach(function (x) { x.classList.remove('sel'); });
                if (el) el.classList.add('sel');
                // the panel is the shared renderer's (the patient's dental report shows the same one, without the buttons)
                document.getElementById('dn_tooth_panel').innerHTML = HD.toothPanel(n, teeth, marks, procs, W, { edit: canConsult });
            }
            function drawPerio() {
                var up = document.getElementById('dn_perio_up'), lo = document.getElementById('dn_perio_lo');
                if (up) up.innerHTML = HD.perioArch(perio, mob, furc, HD.UPPER, true, W);
                if (lo) lo.innerHTML = HD.perioArch(perio, mob, furc, HD.LOWER, false, W);
                perioToLabels();
            }
            // in Arabic the labels are the table's right-hand edge: open the scroll there, so they are never cut
            function perioToLabels() {
                if (document.documentElement.dir !== 'rtl') return;
                document.querySelectorAll('#dn_perio_up .table-responsive, #dn_perio_lo .table-responsive').forEach(function (e) { e.scrollLeft = e.scrollWidth; });
            }
            document.addEventListener('shown.bs.tab', function (e) { if (e.target.getAttribute('href') === '#dch_p') perioToLabels(); });
            function wire() {
                drawChart(); drawPerio();
                var sel = document.getElementById('dn_dent');
                if (sel && window.$ && $.fn.select2 && !$(sel).data('select2')) $(sel).select2({ minimumResultsForSearch: -1, width: '100%' });
                if (sel && window.CB && CB.onSelectChange) CB.onSelectChange(sel, function () {
                    dentition = sel.value; drawChart();
                    if (canConsult) cbConfirm(W.dentQ).then(function (ok) { if (ok) post(root + '/Chart/' + patientId + '/Dentition', { dentition: dentition }).then(function (r) { if (!r.ok) toast('error', r.error || W.failed); }); });
                });
            }
            wire();

            if (canConsult) {
                // ---------------- a mark, or a procedure into a plan ----------------
                var mk = document.getElementById('markModal'), pickT = null, picked = '';
                var q = function (k) { return mk.querySelector('[data-mk=' + k + ']'); };
                function kindNow() { return (mk.querySelector('[name=mk-kind]:checked') || {}).value; }
                function procNow() { var o = q('service').selectedOptions[0]; return o ? { surf: o.getAttribute('data-surf') ? +o.getAttribute('data-surf') : null, work: o.getAttribute('data-work') || null, tooth: o.getAttribute('data-tooth') === '1', name: o.textContent } : null; }
                function surfacesShown() {
                    var k = kindNow(), p = procNow();
                    if (k === 'state') return false;
                    if (k === 'exist') return !q('work').value;
                    if (k === 'plan') return !!(p && p.surf);
                    return true;
                }
                function drawPick() {
                    var n = +q('tooth').value, wrap = mk.querySelector('[data-mk-surf-wrap]');
                    wrap.classList.toggle('d-none', !n || !surfacesShown());
                    if (!n) return;
                    mk.querySelector('[data-mk-pick]').innerHTML = HD.DEFS + HD.topView(n, teeth[n] || {}, 110, picked.split(''));
                    mk.querySelector('[data-mk-surf-text]').textContent = picked || '—';
                    var p = procNow();
                    mk.querySelector('[data-mk-surf-need]').textContent = kindNow() === 'plan' && p && p.surf ? W.need.replace('{0}', p.surf) : '';
                }
                function refresh() {
                    var k = kindNow();
                    mk.querySelectorAll('[data-mk-for]').forEach(function (el) { el.classList.toggle('d-none', el.getAttribute('data-mk-for').split(' ').indexOf(k) === -1); });
                    // the tooth list follows the drawn dentition; a plan's procedure may be done on no tooth (a scaling)
                    var set = HD.SETS[dentition] || HD.SETS.Permanent, cur = q('tooth').value;
                    var opts = (k === 'plan' ? '<option value="">' + W.noTooth + '</option>' : '') + set[0].concat(set[1]).map(function (n) { return '<option value="' + n + '">' + n + '</option>'; }).join('');
                    q('tooth').innerHTML = opts; if (cur && q('tooth').querySelector('[value="' + cur + '"]')) q('tooth').value = cur;
                    toothSelect();
                    drawPick();
                }
                // the tooth list shows each tooth's own picture (its side view, as the chart draws it now), its number and kind
                function toothTpl(o, h) {
                    if (!o.id) return o.text;
                    var n = +o.id;
                    return $('<span class="d-flex align-items-center gap-3"><span class="d-inline-flex" style="width:20px;justify-content:center">' + HD.toothIcon(n, teeth[n], h || 50) + '</span>' +
                        '<span class="hp-num fw-bold fs-6 text-gray-900">' + n + '</span><span class="text-muted fs-8">' + W.kind[HD.kind(n)] + (HD.isPrimary(n) ? W.primary : '') + '</span></span>');
                }
                function toothSelect() {
                    var s = q('tooth'); if (!window.$ || !$.fn.select2) return;
                    if ($(s).data('select2')) $(s).select2('destroy');
                    $(s).select2({ width: '100%', dir: document.documentElement.dir === 'rtl' ? 'rtl' : 'ltr', dropdownParent: $(mk), templateResult: function (o) { return toothTpl(o, 50); }, templateSelection: function (o) { return toothTpl(o, 24); }, minimumResultsForSearch: 0 });
                }
                function openMark(n) {
                    picked = ''; q('note').value = ''; q('work').value = '';
                    if (window.$) $(q('provider')).val(null).trigger('change');
                    refresh(); if (n) { q('tooth').value = String(n); if (window.$) $(q('tooth')).trigger('change.select2'); }
                    drawPick(); bootstrap.Modal.getOrCreateInstance(mk).show();
                }
                mk.addEventListener('change', function (e) { if (e.target.name === 'mk-kind' || e.target === q('work')) refresh(); });
                if (window.$) $(q('tooth')).on('select2:select', function () { picked = ''; drawPick(); });
                if (window.CB && CB.onSelectChange) CB.onSelectChange(q('service'), function () { picked = ''; drawPick(); });
                mk.querySelector('[data-mk-pick]').addEventListener('click', function (e) {
                    var s = e.target.closest('[data-surf]'); if (!s) return;
                    var k = s.getAttribute('data-surf');
                    picked = picked.indexOf(k) === -1 ? picked + k : picked.replace(k, '');
                    picked = 'MOIDBL'.split('').filter(function (c) { return picked.indexOf(c) !== -1; }).join('');
                    drawPick();
                });
                mk.querySelector('[data-mk-save]').addEventListener('click', function (e) {
                    var btn = e.currentTarget, k = kindNow(), n = q('tooth').value ? +q('tooth').value : null;
                    if (k === 'plan') {
                        if (q('phase').value === 'new') { bootstrap.Modal.getOrCreateInstance(mk).hide(); bootstrap.Modal.getOrCreateInstance(document.getElementById('planModal')).show(); return; }
                        var p = procNow(), body = { phaseId: +q('phase').value, serviceId: +q('service').value, tooth: n, surfaces: p && p.surf ? picked : null, providerId: q('provider').value ? +q('provider').value : null };
                        cbConfirm(W.planQ.replace('{0}', p ? p.name : '')).then(function (ok) { if (!ok) return; btn.disabled = true; post(root + '/Line', body).then(done(btn, mk)); });
                        return;
                    }
                    var b = { patientId: patientId, tooth: n, note: q('note').value.trim() || null, noteEn: q('noteEn').value.trim() || null, status: k === 'cond' ? 'Condition' : 'Existing' };
                    if (k === 'state') b.work = q('state').value;
                    else if (k === 'exist' && q('work').value) b.work = q('work').value;
                    else b.surfaces = picked;
                    cbConfirm(W.recordQ.replace('{0}', n || '')).then(function (ok) { if (!ok) return; btn.disabled = true; post(root + '/Finding', b).then(done(btn, mk)); });
                });

                // ---------------- a new plan ----------------
                var plM = document.getElementById('planModal');
                plM.querySelector('[data-pl-save]').addEventListener('click', function (e) {
                    var btn = e.currentTarget, d = plM.querySelector('[data-pl=dentist]').value;
                    var body = { patientId: patientId, practitionerId: d ? +d : null, title: plM.querySelector('[data-pl=title]').value.trim(), titleEn: plM.querySelector('[data-pl=titleEn]').value.trim() };
                    cbConfirm(W.openQ).then(function (ok) { if (!ok) return; btn.disabled = true; post(root + '/Plan', body).then(done(btn, plM)); });
                });

                // ---------------- the perio exam ----------------
                var peM = document.getElementById('perioModal');
                function peGrid() {
                    // the same layout as the chart it fills: per side, one row each for pocket depth, recession and
                    // bleeding, three sites per tooth on one line; the label column stays put while the arch scrolls
                    // The teeth stay in the dentist's order (18 on the left) in both languages. The labels are a column of
                    // their own beside the scrolling teeth — on the right in Arabic — so no input can ever run into a word.
                    var rtl = document.documentElement.dir === 'rtl';
                    function sites(n, side) { var idx = side === 'b' ? [0, 1, 2] : [3, 4, 5]; return HD.patientRight(n) ? idx : idx.slice().reverse(); }
                    function measure(list, side, k) {
                        return list.map(function (n) {
                            var x = perio[n];
                            return '<td class="pe-cell">' + sites(n, side).map(function (i) {
                                if (k === 'bop') return '<span class="pe-site"><input type="checkbox" class="pe-bop" data-t="' + n + '" data-k="bop" data-i="' + i + '"' + (x && x[2][i] ? ' checked' : '') + ' /></span>';
                                return '<input class="pe-in hp-num" data-t="' + n + '" data-k="' + k + '" data-i="' + i + '" value="' + (x ? x[k === 'pd' ? 0 : 1][i] : '') + '" inputmode="numeric" />';
                            }).join('') + '</td>';
                        }).join('');
                    }
                    function perTooth(list, k) {
                        return list.map(function (n) {
                            var v = (k === 'mob' ? mob : furc)[n];
                            return '<td class="pe-cell"><input class="pe-in hp-num" data-t="' + n + '" data-k="' + k + '" value="' + (v == null ? '' : v) + '" inputmode="numeric" maxlength="1" ' + (k === 'furc' && HD.roots(n) < 2 ? 'disabled' : '') + ' /></td>';
                        }).join('');
                    }
                    function arch(list, upper, title) {
                        var a = upper ? 'b' : 'l', b = upper ? 'l' : 'b';
                        var rows = [{ h: 'pe-s', label: '<span class="fw-bold text-gray-900 fs-7">' + (upper ? W.buccal : W.lingual) + '</span>', cells: '<td colspan="' + list.length + '"></td>' },
                            { h: 'pe-r', label: W.pd, cells: measure(list, a, 'pd') }, { h: 'pe-r', label: W.recession, cells: measure(list, a, 'rec') }, { h: 'pe-r', label: W.bleeding, cells: measure(list, a, 'bop') },
                            { h: 'pe-s', label: '<span class="fw-bold text-gray-900 fs-7">' + (upper ? W.palatal : W.buccal) + '</span>', cells: '<td colspan="' + list.length + '"></td>' },
                            { h: 'pe-r', label: W.pd, cells: measure(list, b, 'pd') }, { h: 'pe-r', label: W.recession, cells: measure(list, b, 'rec') }, { h: 'pe-r', label: W.bleeding, cells: measure(list, b, 'bop') },
                            { h: 'pe-r', label: W.mobility, cells: perTooth(list, 'mob') }, { h: 'pe-r', label: W.furcation + ' (1–3)', cells: perTooth(list, 'furc') }];
                        var labels = '<div class="pe-labels ' + (rtl ? 'pe-end' : 'pe-start') + '"><table><thead><tr class="pe-h"><th></th></tr></thead><tbody>' +
                            rows.map(function (r) { return '<tr class="' + r.h + '"><td class="pe-lbl fw-semibold text-gray-700" dir="' + (rtl ? 'rtl' : 'ltr') + '" style="text-align:' + (rtl ? 'right' : 'left') + '">' + r.label + '</td></tr>'; }).join('') + '</tbody></table></div>';
                        var teeth = '<div class="pe-scroll" data-pe-scroll><table class="pe-table"><thead><tr class="pe-h">' +
                            list.map(function (n) { return '<th class="text-center hp-num fs-7 fw-bold">' + n + '</th>'; }).join('') + '</tr></thead><tbody>' +
                            rows.map(function (r) { return '<tr class="' + r.h + '">' + r.cells + '</tr>'; }).join('') + '</tbody></table></div>';
                        return '<div class="fw-bold text-gray-900 fs-6 mb-2">' + title + '</div><div class="pe-wrap mb-6" dir="ltr">' + (rtl ? teeth + labels : labels + teeth) + '</div>';
                    }
                    document.getElementById('pe_grid').innerHTML = arch(HD.UPPER, true, W.upper) + arch(HD.LOWER, false, W.lower);
                }
                // in Arabic the teeth beside the labels (the patient's left) show first — once the window is laid out
                peM.addEventListener('shown.bs.modal', function () { if (document.documentElement.dir === 'rtl') peM.querySelectorAll('[data-pe-scroll]').forEach(function (e) { e.scrollLeft = e.scrollWidth; }); });
                peM.querySelector('[data-pe-save]').addEventListener('click', function (e) {
                    var btn = e.currentTarget, list = [];
                    HD.UPPER.concat(HD.LOWER).forEach(function (n) {
                        var g = function (k, i) { var el = peM.querySelector('[data-t="' + n + '"][data-k="' + k + '"]' + (i == null ? '' : '[data-i="' + i + '"]')); return el ? el : null; };
                        var pd = [0, 1, 2, 3, 4, 5].map(function (i) { return g('pd', i).value.trim(); });
                        if (pd.every(function (v) { return v === ''; })) return;
                        var rec = [0, 1, 2, 3, 4, 5].map(function (i) { return g('rec', i).value.trim() || '0'; });
                        var bop = [0, 1, 2, 3, 4, 5].map(function (i) { return g('bop', i).checked ? '1' : '0'; }).join('');
                        var mo = g('mob').value.trim(), fu = g('furc').value.trim();
                        list.push({ tooth: n, depths: pd.join(','), recession: rec.join(','), bleeding: bop, mobility: mo === '' ? null : +mo, furcation: fu === '' ? null : +fu });
                    });
                    var ex = peM.querySelector('[data-pe=examiner]').value;
                    var body = { patientId: patientId, examDate: peM.querySelector('[data-pe=date]').value || null, practitionerId: ex ? +ex : null, teeth: list };
                    cbConfirm(W.perioQ.replace('{0}', list.length)).then(function (ok) { if (!ok) return; btn.disabled = true; post(root + '/Perio', body).then(done(btn, peM)); });
                });

                document.addEventListener('click', function (e) {
                    var t = e.target.closest('[data-mark-open],[data-void],[data-perio-open]'); if (!t) return;
                    if (t.hasAttribute('data-void')) {
                        cbConfirm(W.voidQ, { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Finding/' + t.getAttribute('data-void') + '/Void').then(done(t)); });
                        return;
                    }
                    if (t.hasAttribute('data-perio-open')) { peGrid(); bootstrap.Modal.getOrCreateInstance(peM).show(); return; }
                    openMark(t.getAttribute('data-mark-open') ? +t.getAttribute('data-mark-open') : null);
                });
            }
            }
        })();
    </script>
}
