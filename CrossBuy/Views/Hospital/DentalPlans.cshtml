@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalDentalPlanRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Treatment plans"].Value;
    var s = ViewBag.Stats as HospitalDentalPlanStats;
    string N(decimal v, int dec) => v.ToString("N" + dec, System.Globalization.CultureInfo.InvariantCulture);
    string St(string state) => state switch { "Accepted" => "primary", "Partial" => "info", "Declined" => "secondary", _ => "primary" };
    // H127: a stat tile of the theme (demo39 dashboards/logistics) — the figure over its label, an icon, a line under it
    void Stat(string label, string value, string? unit, object? sub, string icon, string tone)
    {
        <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
            <div class="card-header pt-5 flex-nowrap gap-3">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-baseline flex-wrap"><span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2 hp-num">@value</span>@if (unit != null) {<span class="fs-6 fw-semibold text-gray-500 hp-num">@unit</span>}</div>
                    <span class="text-gray-500 pt-1 fw-semibold fs-6">@label</span>
                </div>
                <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-2x text-@tone"></i></span></div></div>
            </div>
            <div class="card-body d-flex align-items-end pt-0">
                <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500">@if (sub != null) {<span class="bullet w-8px h-6px rounded-2 bg-@tone me-3"></span>@sub} else {<span>&nbsp;</span>}</div>
            </div>
        </div></div>
    }
    void Person(string? photo, string nameEn, int size)
    {
        <div class="symbol symbol-@(size)px symbol-circle flex-shrink-0 me-3">@if (photo != null) {<img src="@photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(nameEn)" />} else {<span class="symbol-label fw-bold fs-7 hp-initials">@HospitalUi.Initials(nameEn)</span>}</div>
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Treatment plans"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Dental")" class="text-muted text-hover-primary">@T["Dentistry"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Treatment plans"]</li>
            </ul>
        </div>
        <a href="@Url.Action("DentalChart")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-emoji-happy fs-4"></i>@T["Patient chart"]</a>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (s != null)
        {
            @* H127: the month's figures — demo39 dashboards/logistics stat tiles *@
            <div class="row g-5 g-xl-8 mb-5">
                @{
                    Stat(T["Plans presented"].Value, s.PresentedThisMonth.ToString(), null, T["this month"], "document", "primary");
                    Stat(T["Acceptance rate"].Value, s.AcceptanceRate == null ? "—" : s.AcceptanceRate + "%", null, T["by value"], "check-square", "primary");
                    Stat(T["Accepted, not done"].Value, N(s.AcceptedNotDone, s.Decimals), s.Currency, T["accepted work not yet done"], "time", "info");
                    Stat(T["Yearly dental limit"].Value, s.YearlyLimitMin == null ? "—" : s.YearlyLimitMin == s.YearlyLimitMax ? N(s.YearlyLimitMin.Value, s.Decimals) : N(s.YearlyLimitMin.Value, 0) + "–" + N(s.YearlyLimitMax!.Value, 0), null, T["per the payer contract"], "shield-tick", "primary");
                }
            </div>
        }

        @* H127: the plans — demo39 widgets/tables *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Treatment plans"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@Model.Count</span>
                </h3>
                <div class="card-toolbar"><div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Search"]" data-filter /></div></div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-document fs-3x text-gray-300 mb-4 d-block"></i>
                        <div class="fs-6 fw-bold text-gray-700">@T["No treatment plans yet: a plan is opened from the patient's chart."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Plan"]</th><th>@T["Dentist"]</th><th class="text-end">@T["Phases"]</th><th class="text-end">@T["Value"]</th><th class="text-end">@T["Patient share"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr data-row="@r.Plan.PlanNo @r.PatientName @r.PatientNameEn @r.Mrn">
                                    <td class="ps-4"><a href="@Url.Action("DentalChart", new { patientId = r.Plan.PatientId })" class="d-flex align-items-center text-hover-primary">
                                        @{ Person(r.PatientPhoto, r.PatientNameEn, 40); }
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(r.PatientName, r.PatientNameEn)</span><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi></div></a></td>
                                    <td><bdi class="text-gray-900 fw-bold fs-6 hp-num">@r.Plan.PlanNo</bdi></td>
                                    <td>@if (r.Dentist != null)
                                        {
                                            <div class="d-flex align-items-center">@{ Person(r.Dentist.Photo, r.Dentist.NameEn, 30); }<span class="text-gray-800 fw-semibold fs-7">@DisplayName.Of(r.Dentist.Name, r.Dentist.NameEn)</span></div>
                                        } else {<span class="text-muted">—</span>}</td>
                                    <td class="text-end"><span class="text-gray-800 fw-bold hp-num">@r.Phases</span></td>
                                    <td class="text-end text-nowrap"><span class="text-gray-900 fw-bold fs-6 hp-num">@N(r.Quote.Gross, r.Decimals)</span>&nbsp;<span class="text-muted fs-8">@r.Currency</span></td>
                                    <td class="text-end"><span class="badge badge-light-primary fs-7 fw-bold hp-num">@N(r.Quote.PatientShare, r.Decimals)</span></td>
                                    <td><span class="badge badge-light-@St(r.State) fs-7 fw-bold">@T["plan:" + r.State]</span></td>
                                    <td class="text-end pe-4"><a href="@Url.Action("DentalPlan", new { id = r.Plan.ID })" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Open"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrow-left fs-3"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var f = document.querySelector('[data-filter]'); if (!f) return;
            f.addEventListener('input', function () {
                var q = f.value.trim().toLowerCase();
                document.querySelectorAll('[data-row]').forEach(function (r) { r.classList.toggle('d-none', q && r.getAttribute('data-row').toLowerCase().indexOf(q) === -1); });
            });
        })();
    </script>
}
