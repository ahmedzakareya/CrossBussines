@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalIcuBoard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H40 — intensive care, as the approved prototype draws it (#/icu): the chosen ICU patient's banner, the unit's four
    figures, and the hourly flowsheet. The nurse enters an hour (until the bedside monitors are connected); the day's
    assessment holds SOFA, ventilator and vasopressors. Every change swaps in place.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Intensive care"].Value;
    bool ready = ViewBag.Ready == true, canAdmit = ViewBag.CanAdmit == true, canAssess = ViewBag.CanAssess == true;
    var b = Model;
    var p = b.Selected;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string[] Lines(string? s) => (s ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var allergies = Lines(p?.Allergies);
    var age = p == null ? null : HospitalPatientService.AgeOn(p.BirthDate, DateTime.UtcNow);
    HospitalIcuObservation? At(DateTime hourWard) => b.Flow.FirstOrDefault(o => HospitalNursingService.UtcToWard(o.HourAt) == hourWard);
    var rows = new (string Label, Func<HospitalIcuObservation, string?> Value, string Unit)[]
    {
        ("HR", o => o.HeartRate?.ToString(inv), "bpm"), ("MAP", o => o.Map?.ToString(inv), "mmHg"), ("SpO₂", o => o.SpO2?.ToString(inv), "%"),
        ("RR", o => o.RespRate?.ToString(inv), "/min"), (T["Temp"].Value, o => o.TempC?.ToString("0.0", inv), "°C"), (T["Urine output"].Value, o => o.UrineMl?.ToString(inv), "ml"),
    };
    int? sofa = b.Today?.Sofa, sofaY = b.Yesterday?.Sofa;
    string sofaSub = sofa is int s1 && sofaY is int s0
        ? (s1 < s0 ? string.Format(T["Improved from {0} yesterday"].Value, s0) : s1 > s0 ? string.Format(T["Worse than {0} yesterday"].Value, s0) : T["Same as yesterday"].Value)
        : sofa != null ? T["No score yesterday"].Value : T["Not scored today"].Value;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Intensive care"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Inpatient"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["crumb:ICU"]</li>
            </ul>
        </div>
        @if (b.Patients.Count > 1)
        {
            <div class="d-print-none" style="width:280px">
                <select class="form-select form-select-sm form-select-solid" data-icu-pick>
                    @foreach (var x in b.Patients) { <option value="@x.AdmissionId" selected="@(p?.AdmissionId == x.AdmissionId)" data-photo="@x.Photo" data-initials="@HospitalUi.Initials(x.NameEn)">@("⁦" + x.Bed + "⁩") · @DisplayName.Of(x.Name, x.NameEn)</option> }
                </select>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid" data-icu="@(p?.AdmissionId ?? 0)">
        @if (!ready)
        {
            <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalIcuService.NoTables]</div></div>
        }
        @if (p == null)
        {
            <div class="card card-flush mb-5"><div class="card-body"><div class="text-center py-10"><i class="ki-outline ki-graph-up fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No patient is in an intensive-care bed now."]</div></div></div></div>
        }
        else
        {
            <div class="hp-pbanner p-6 mb-5"><div class="d-flex flex-wrap align-items-center gap-5">
                <div class="symbol symbol-75px symbol-circle flex-shrink-0">@if (p.Photo != null) {<img src="@p.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label fs-2 fw-bold hp-initials">@HospitalUi.Initials(p.NameEn)</span>}</div>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1"><a href="@Url.Action("Patient", new { id = p.PatientId })" class="fs-2 fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(p.Name, p.NameEn)</a><span class="badge hp-code fw-bold fs-8 hp-num">@p.Mrn</span></div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="hp-chip"><i class="ki-outline ki-user fs-7"></i>@if (age != null) {<span class="hp-num">@age</span> @T["y"] <text> · </text>}@(p.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])</span>
                        @if (p.BloodGroup != null) { <span class="hp-chip"><i class="ki-outline ki-drop fs-7"></i>@T["Blood group"] <span class="hp-num">@p.BloodGroup</span></span> }
                        <span class="hp-chip"><i class="ki-outline ki-home-2 fs-7"></i>@T["Bed"] <span class="hp-num">@p.Bed</span></span>
                        @if (p.Diagnosis != null) { <span class="hp-chip" dir="auto"><i class="ki-outline ki-notepad fs-7"></i>@p.Diagnosis</span> }
                    </div>
                </div>
            </div></div>

            @if (allergies.Length > 0)
            {
                <div class="notice d-flex rounded border border-danger border-dashed bg-light-danger p-6 mb-5">
                    <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                    <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                        <div class="mb-3 mb-md-0 fw-semibold pe-5">
                            <h4 class="text-gray-900 fw-bold mb-1">@T["Recorded allergy"]</h4>
                            <div class="fs-6 text-gray-700">@string.Join(DisplayName.IsArabic ? "، " : ", ", allergies) — @T["check every prescription against it."]</div>
                        </div>
                        <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0">@T["Allergy"]</span>
                    </div>
                </div>
            }
        }

        @* H128: the unit's four figures — the theme's stat tiles (demo39 dashboards/logistics) *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var st in new[] {
                (T["ICU beds"].Value, b.Patients.Count.ToString(inv), string.Format(T["{0} of {1}"].Value, b.Patients.Count, b.Beds) + " " + T["beds:occupied"].Value, "text-gray-900", "home-2", "primary"),
                (T["Ventilated"].Value, b.Ventilated.ToString(inv), "", "text-gray-900", "wind", "info"),
                (T["On vasopressors"].Value, b.Vasopressors.ToString(inv), "", b.Vasopressors > 0 ? "text-danger" : "text-gray-900", "pulse", "danger"),
                ("SOFA", sofa?.ToString(inv) ?? "—", p == null ? "" : sofaSub, sofa is int a1 && sofaY is int a0 && a1 > a0 ? "text-danger" : "text-gray-900", "graph-up", sofa is int a2 && sofaY is int a3 && a2 > a3 ? "danger" : "primary") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold lh-1 hp-num @st.Item4" dir="ltr">@st.Item2</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@st.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@st.Item6"><i class="ki-outline ki-@st.Item5 fs-2x text-@st.Item6"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        @if (st.Item3 != "") { <span class="d-flex align-items-center text-gray-600 fw-semibold fs-7"><span class="bullet bullet-dot bg-@st.Item6 me-2 h-6px w-6px"></span><span class="hp-num">@st.Item3</span></span> }
                    </div>
                </div></div>
            }
        </div>

        @if (p != null)
        {
            <div class="card card-flush mb-5">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@T["Hourly flowsheet"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Values stream from bedside monitors once connected; until then the nurse enters each hour"]</span>
                    </h3>
                    @if (ready)
                    {
                        <div class="card-toolbar gap-2 d-print-none">
                            @if (canAssess) { <button type="button" class="btn btn-sm btn-light" data-icu-assess><i class="ki-outline ki-clipboard fs-4"></i>@T["Day's assessment"]</button> }
                            @if (canAdmit) { <button type="button" class="btn btn-sm btn-light-primary" data-icu-hour><i class="ki-outline ki-plus fs-4"></i>@T["Record an hour"]</button> }
                        </div>
                    }
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Parameter"]</th>
                            @foreach (var h in b.Hours) { <th class="text-center"><span class="hp-num">@h.ToString("HH:mm", inv)</span></th> }
                            <th class="pe-4 rounded-end">@T["Unit"]</th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in rows)
                            {
                                <tr>
                                    <td class="ps-4"><span class="text-gray-900 fw-bold fs-6">@r.Label</span></td>
                                    @foreach (var h in b.Hours)
                                    {
                                        var o = At(h); var v = o == null ? null : r.Value(o);
                                        <td class="text-center">@if (v != null) {<span class="text-gray-800 fw-bold hp-num">@v</span>} else {<span class="text-gray-400">—</span>}</td>
                                    }
                                    <td class="pe-4"><span class="text-muted fw-semibold fs-7" dir="ltr">@r.Unit</span></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    @if (b.Today != null)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-5">
                            @if (b.Today.Ventilated) { <span class="badge badge-light-primary fs-8"><i class="ki-outline ki-cloud-change fs-7 me-1 text-primary"></i>@T["Ventilated"]</span> }
                            @if (b.Today.Vasopressors) { <span class="badge badge-light-danger fs-8"><i class="ki-outline ki-pulse fs-7 me-1 text-danger"></i>@T["On vasopressors"]</span> }
                        </div>
                    }
                </div>
            </div>
            @if (ViewBag.Care is HospitalIcuCare care) { ViewData["IcuCarePart"] = "cards"; <partial name="_IcuCare" model="care" /> }
        }
    </div></div>
</div>
@if (ViewBag.Care is HospitalIcuCare careM) { ViewData["IcuCarePart"] = "modals"; <partial name="_IcuCare" model="careM" /> }

@if (p != null && ready && canAdmit)
{
    <div class="modal fade" id="icuHourModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-600px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Record an hour"]</h1>
                <div class="text-muted fw-semibold fs-6">@DisplayName.Of(p.Name, p.NameEn) · @T["Bed"] <bdi class="hp-num">@p.Bed</bdi></div></div>
            <div class="row g-6">
            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Hour"]</label>
                <select class="form-select form-select-solid hp-num" data-h="hour" data-control="select2" data-hide-search="true" data-dropdown-parent="#icuHourModal">
                    @foreach (var h in b.Hours.Reverse()) { <option value="@h.ToString("yyyy-MM-ddTHH:mm", inv)">@h.ToString("HH:mm", inv)</option> }
                </select></div>
            @foreach (var (key, label, unit, step) in new[] { ("heartRate", "HR", "bpm", "1"), ("map", "MAP", "mmHg", "1"), ("spO2", "SpO₂", "%", "1"), ("respRate", "RR", "/min", "1"), ("tempC", T["Temp"].Value, "°C", "0.1"), ("urineMl", T["Urine output"].Value, "ml", "1") })
            {
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@label <span class="text-muted fs-8" dir="ltr">(@unit)</span></label>
                    <input type="number" step="@step" class="form-control form-control-solid hp-num" dir="ltr" data-h="@key" /></div>
            }
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-icu-hour-save><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div>
        </div>
    </div></div></div>
}
@if (p != null && ready && canAssess)
{
    <div class="modal fade" id="icuAssessModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-500px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Day's assessment"]</h1>
                <div class="text-muted fw-semibold fs-6">@DisplayName.Of(p.Name, p.NameEn) · @T["Bed"] <bdi class="hp-num">@p.Bed</bdi></div></div>
            <div class="row g-6">
            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2 required">@T["Day"]</label>
                <select class="form-select form-select-solid" data-a="day" data-control="select2" data-hide-search="true" data-dropdown-parent="#icuAssessModal">
                    <option value="@b.WardNow.Date.ToString("yyyy-MM-dd", inv)">@T["Today"]</option>
                    <option value="@b.WardNow.Date.AddDays(-1).ToString("yyyy-MM-dd", inv)">@T["Yesterday"]</option>
                </select></div>
            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">SOFA <span class="text-muted fs-8">(<bdi class="hp-num" dir="ltr">0–24</bdi>)</span></label>
                <input type="number" min="0" max="24" step="1" class="form-control form-control-solid hp-num" dir="ltr" data-a="sofa" value="@(b.Today?.Sofa?.ToString(inv))" /></div>
            <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-a="ventilated" @(b.Today?.Ventilated == true ? "checked" : "") /><span class="form-check-label fs-6 text-gray-800">@T["Ventilated"]</span></label></div>
            <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-a="vasopressors" @(b.Today?.Vasopressors == true ? "checked" : "") /><span class="form-check-label fs-6 text-gray-800">@T["On vasopressors"]</span></label></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-icu-assess-save><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Icu"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function adm() { var c = document.querySelector('[data-icu]'); return c ? +c.getAttribute('data-icu') : 0; }
            function post(url, body) {
                return fetch(root + url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                var url = root + (adm() ? '?admission=' + adm() : '');
                return fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function face(o) {
                if (!o.id || !o.element) return o.text;
                var ph = o.element.getAttribute('data-photo'), s = document.createElement('span'); s.className = 'd-flex align-items-center';
                var sym = document.createElement('span'); sym.className = 'symbol symbol-25px symbol-circle me-2';
                var lb = document.createElement('span'); lb.className = 'symbol-label fw-bold fs-9 hp-initials'; lb.textContent = o.element.getAttribute('data-initials') || '';
                if (ph) { var im = document.createElement('img'); im.alt = ''; im.style.objectFit = 'cover'; im.onerror = function () { sym.replaceChild(lb, im); }; im.src = ph; sym.appendChild(im); }
                else sym.appendChild(lb);
                s.appendChild(sym); s.appendChild(document.createTextNode(o.text)); return s;
            }
            // choosing another ICU patient opens their page (the address names the admission)
            var pick = document.querySelector('[data-icu-pick]');
            if (pick && window.jQuery) {
                jQuery(pick).select2({ minimumResultsForSearch: Infinity, templateResult: face, templateSelection: face });
                CB.onSelectChange(pick, function () { location.href = root + '?admission=' + pick.value; });
            }
            function num(m, k) { var v = m.querySelector('[data-h=' + k + '],[data-a=' + k + ']').value; return v === '' ? null : +v; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-icu-hour],[data-icu-hour-save],[data-icu-assess],[data-icu-assess-save]'); if (!t) return;
                var hm = document.getElementById('icuHourModal'), am = document.getElementById('icuAssessModal');
                if (t.hasAttribute('data-icu-hour')) { hm.querySelectorAll('input').forEach(function (i) { i.value = ''; }); bootstrap.Modal.getOrCreateInstance(hm).show(); return; }
                if (t.hasAttribute('data-icu-assess')) { bootstrap.Modal.getOrCreateInstance(am).show(); return; }
                if (t.hasAttribute('data-icu-hour-save')) {
                    t.disabled = true;
                    post('/Hour', { admissionId: adm(), hour: hm.querySelector('[data-h=hour]').value, heartRate: num(hm, 'heartRate'), map: num(hm, 'map'), spO2: num(hm, 'spO2'),
                        respRate: num(hm, 'respRate'), tempC: num(hm, 'tempC'), urineMl: num(hm, 'urineMl') })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } bootstrap.Modal.getOrCreateInstance(hm).hide(); toast('success', W.saved); swap(); });
                    return;
                }
                t.disabled = true;
                post('/Assess', { admissionId: adm(), day: am.querySelector('[data-a=day]').value, sofa: num(am, 'sofa'),
                    ventilated: am.querySelector('[data-a=ventilated]').checked, vasopressors: am.querySelector('[data-a=vasopressors]').checked })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } bootstrap.Modal.getOrCreateInstance(am).hide(); toast('success', W.saved); swap(); });
            });
        })();
    </script>
}
