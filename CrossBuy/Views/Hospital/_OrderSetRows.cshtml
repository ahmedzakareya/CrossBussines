@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model List<HospitalOrderSetRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ bool canManage = ViewBag.CanManage == true; }
@foreach (var r in Model)
{
    var s = r.Set;
    @* H127: the theme's table rows (demo39 widgets/tables) — the set's icon, name over its code, counts and state as badges, icon actions *@
    <tr class="@(s.IsActive ? "" : "opacity-50")">
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-45px me-4 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-questionnaire-tablet fs-2 text-primary"></i></span></div>
            <div class="d-flex flex-column"><a href="@Url.Action("OrderSet", new { id = s.ID })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(s.Name, s.NameEn)</a>
                <bdi class="text-muted fw-semibold d-block fs-7" dir="ltr">@s.Code</bdi></div>
        </div></td>
        <td><span class="text-gray-800 fw-semibold fs-7">@(r.Department != null ? DisplayName.Of(r.Department, r.DepartmentEn ?? r.Department) : T["Any department"].Value)</span></td>
        <td class="text-center"><span class="badge badge-light-primary fs-7 fw-bold hp-num">@r.Items</span></td>
        <td class="text-center"><span class="text-gray-900 fw-bold fs-6 hp-num">@r.Uses</span></td>
        <td>@if (s.IsActive) {<span class="badge badge-light-success fs-7 fw-bold">@T["In use"]</span>} else {<span class="badge badge-light fs-7 fw-bold">@T["Not in use"]</span>}</td>
        <td class="text-end pe-4 text-nowrap">
            <a href="@Url.Action("OrderSet", new { id = s.ID })" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" title="@T["Open"]" data-bs-toggle="tooltip"><i class="ki-outline ki-eye fs-3"></i></a>
            @if (canManage) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Edit"]" data-bs-toggle="tooltip" data-edit-set="@s.ID" data-row="@System.Text.Json.JsonSerializer.Serialize(new { code = s.Code, name = s.Name, nameEn = s.NameEn, departmentId = s.DepartmentId, diagnosisCodes = s.DiagnosisCodes, isActive = s.IsActive })"><i class="ki-outline ki-pencil fs-3"></i></button> }
        </td>
    </tr>
}
