@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalDuplicatePair>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H57 — duplicate patient files: the suspected pairs (and why each looks like one patient), each opened side by side
    in a window; the hospital administrator merges from there (it asks first). Below, the merges already done.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Duplicate files"].Value;
    bool ready = ViewBag.Ready == true, canMerge = ViewBag.CanMerge == true;
    var history = (ViewBag.History as IReadOnlyList<HospitalMergeRow>) ?? Array.Empty<HospitalMergeRow>();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Duplicate files"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Patients"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Medical records"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5"><i class="ki-outline ki-information fs-2tx text-primary me-4"></i><div class="fs-6 fw-semibold text-gray-700">@T[HospitalPatientMergeService.NoTables]</div></div> }
        <div class="notice d-flex rounded border border-primary border-dashed bg-light-primary p-6 mb-5">
            <i class="ki-outline ki-abstract-26 fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="mb-3 mb-md-0 fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["One patient, one file"]</h4>
                    <div class="fs-6 text-gray-700">@T["Two files of one patient split the history: a doctor may miss an allergy recorded on the other. Files that share a mobile and a birth date, or a name and a birth date, are listed here; the hospital administrator merges them."]</div>
                </div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0"><bdi class="hp-num" dir="ltr">@Model.Count</bdi>&nbsp;@T["suspected pairs"]</span>
            </div>
        </div>

        @* H128: the theme's table widget (demo39 widgets/tables) — each file with its photo (initials only when none) *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Suspected duplicates"]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7"><bdi class="hp-num" dir="ltr">@Model.Count</bdi>&nbsp;@T["suspected pairs"]</span></h3></div>
            <div class="card-body pt-2">
                @if (Model.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-abstract-26 fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No suspected duplicate."]</div></div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["File"]</th><th>@T["File"]</th><th>@T["Why"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr data-dup-row="@p.A.ID-@p.B.ID">
                                    @foreach (var (x, first) in new[] { (p.A, true), (p.B, false) })
                                    {
                                        <td class="@(first ? "ps-4" : "")"><div class="d-flex align-items-center">
                                            <div class="symbol symbol-45px symbol-circle me-4 flex-shrink-0">@if (x.PhotoPath != null) {<img src="@x.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(x.NameEn ?? x.Name)" />} else {<span class="symbol-label fw-bold bg-light-primary text-primary">@HospitalUi.Initials(x.NameEn ?? x.Name)</span>}</div>
                                            <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = x.ID })" class="text-gray-900 text-hover-primary fw-bold fs-6">@DisplayName.Of(x.Name, x.NameEn ?? x.Name)</a>
                                                <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num" dir="ltr">@x.Mrn</bdi>@if (x.BirthDate != null) {<text> · </text><span class="hp-num" dir="ltr">@x.BirthDate?.ToString("yyyy-MM-dd", inv)</span>}@if (!string.IsNullOrEmpty(x.Phone)) {<text> · </text><bdi class="hp-num" dir="ltr">@x.Phone</bdi>}</span></div>
                                        </div></td>
                                    }
                                    <td>@foreach (var w in p.Reasons) { <span class="badge badge-light-primary fs-7 fw-bold me-1 mb-1">@T["dupwhy:" + w]</span> }</td>
                                    <td class="text-end pe-4"><button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-dup-open data-a="@p.A.ID" data-b="@p.B.ID"><i class="ki-outline ki-switch fs-4"></i>@T["Compare"]</button></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        @* H128: the merges as the theme's list widget (demo39 widgets/lists) *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Merges done"]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@history.Count</span></h3></div>
            <div class="card-body pt-2" data-dup-history>
                @if (history.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-abstract-26 fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No merge yet."]</div></div> }
                @for (int hi = 0; hi < history.Count; hi++)
                {
                    var h = history[hi];
                    var moved = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(h.Merge.Moved) ?? new();
                    <div class="d-flex flex-stack">
                        <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-abstract-26 fs-3 text-primary"></i></span></div>
                        <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                            <div class="me-3 min-w-0">
                                <div class="text-gray-800 fw-bold fs-6"><span class="badge badge-light fs-7 fw-bold hp-num" dir="ltr">@h.Merge.MergedMrn</span> → <a href="@Url.Action("Patient", new { id = h.Merge.SurvivorPatientId })" class="text-gray-900 text-hover-primary">@DisplayName.Of(h.SurvivorName ?? "", h.SurvivorNameEn ?? h.SurvivorName ?? "")</a> <span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@h.SurvivorMrn</span></div>
                                <span class="text-gray-600 fw-semibold fs-7 d-block" dir="auto">@h.Merge.Reason</span>
                                <span class="text-gray-500 fw-semibold fs-7 d-block">@DisplayName.Of(h.By ?? "", h.ByEn ?? h.By ?? "") · <span class="hp-num" dir="ltr">@HospitalNursingService.UtcToWard(h.Merge.MergedAt).ToString("yyyy-MM-dd HH:mm", inv)</span></span>
                            </div>
                            <span class="badge badge-light-primary fs-7 fw-bold text-nowrap">@T["records moved"]&nbsp;<span class="hp-num">@moved.Values.Sum()</span></span>
                        </div>
                    </div>
                    if (hi < history.Count - 1) {<div class="separator separator-dashed my-3"></div>}
                }
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="dupModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-900px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Compare two files"]</h1><div class="text-muted fw-semibold fs-6">@T["One patient, one file"]</div></div>
        <div data-dup-body></div>
    </div>
</div></div></div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), merged: @Json.Serialize(T["The files are merged"].Value),
                ask: @Json.Serialize(T["Merge file {0} into file {1}? Everything of {0} moves to {1}, and {0} is closed. This cannot be undone from the screen."].Value),
                compare: @Json.Serialize(Url.Action("DuplicatesCompare")), merge: @Json.Serialize(Url.Action("DuplicatesMerge")) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function swap() {
                return fetch(location.pathname, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-dup-open],[data-dup-merge]'); if (!t) return;
                var body = document.querySelector('[data-dup-body]');
                if (t.hasAttribute('data-dup-open')) {
                    fetch(W.compare + '?a=' + t.getAttribute('data-a') + '&b=' + t.getAttribute('data-b'), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(function (r) { return r.ok ? r.text() : ''; })
                        .then(function (html) { body.innerHTML = html; bootstrap.Modal.getOrCreateInstance(document.getElementById('dupModal')).show(); });
                    return;
                }
                var c = body.querySelector('[data-dup-compare]'), keep = body.querySelector('input[name=dupKeep]:checked');
                var a = c.getAttribute('data-a'), b = c.getAttribute('data-b'), survivor = keep ? keep.value : a, merged = survivor === a ? b : a;
                var mrn = function (id) { var r = body.querySelector('input[name=dupKeep][value="' + id + '"]'); return r ? r.closest('label').querySelector('.hp-num').textContent : id; };
                cbConfirm(W.ask.split('{0}').join(mrn(merged)).split('{1}').join(mrn(survivor)), { kind: 'danger' }).then(function (ok) {
                    if (!ok) return; t.disabled = true;
                    fetch(W.merge, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token },
                        body: JSON.stringify({ survivorId: +survivor, mergedId: +merged, reason: body.querySelector('[data-dup-reason]').value }) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; }
                            bootstrap.Modal.getOrCreateInstance(document.getElementById('dupModal')).hide(); toast('success', W.merged); swap(); });
                });
            });
        })();
    </script>
}
