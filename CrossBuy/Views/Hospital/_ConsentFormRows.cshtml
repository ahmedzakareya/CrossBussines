@using CrossBuy.BL
@using CrossBuy.Models.Context.Hospital
@model List<HospitalConsentForm>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@foreach (var f in Model)
{
    @* H127: the theme's table widget row (demo39 widgets/tables) — symbol · title over its kind · values as badges · an icon action *@
    <tr data-form-row="@f.ID">
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-45px me-4"><span class="symbol-label bg-light-@(f.IsActive ? "primary" : "secondary")"><i class="ki-outline ki-notepad-edit fs-2 text-@(f.IsActive ? "primary" : "gray-500")"></i></span></div>
            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(f.Title, f.TitleEn)</span><span class="text-muted fw-semibold d-block fs-7">@T["ck:" + f.Kind]</span></div>
        </div></td>
        <td><bdi class="badge badge-light fs-7 fw-bold hp-num" dir="ltr">@f.Code</bdi></td>
        <td><span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">v@(f.Version)</span></td>
        <td>@if (f.IsActive) {<span class="badge badge-light-primary fs-7 fw-bold">@T["cf:active"]</span>} else {<span class="badge badge-light fs-7 fw-bold">@T["cf:inactive"]</span>}</td>
        <td><span class="text-gray-600 fw-semibold fs-7 hp-num" dir="ltr">@HospitalNursingServiceTime(f.UpdatedAt)</span></td>
        <td class="pe-4 text-end"><button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Edit"]" data-bs-toggle="tooltip" data-form-edit='@Json.Serialize(new { id = f.ID, code = f.Code, kind = f.Kind, title = f.Title, titleEn = f.TitleEn, body = f.Body, bodyEn = f.BodyEn, isActive = f.IsActive })'><i class="ki-outline ki-pencil fs-4"></i></button></td>
    </tr>
}
@functions {
    private static string HospitalNursingServiceTime(DateTime utc) => CrossBuy.BL.Hospital.HospitalNursingService.UtcToWard(utc).ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);
}
