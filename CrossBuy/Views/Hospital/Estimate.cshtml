@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalEstimateView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — one estimate: the lines as the table widget with the invoice's total (demo39 widgets/tables, apps/invoices/view),
    the deposit as list-widget rows (dashboards/logistics).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var e = Model.Row.Estimate;
    ViewData["Title"] = e.EstimateNo;
    string? cur = ViewBag.Currency as string;
    bool canBill = ViewBag.CanBill == true;
    string Money(decimal v) => v.ToString("N3", System.Globalization.CultureInfo.InvariantCulture);
    string St(string s) => s switch { HospitalEstimateStatus.Issued => "primary", HospitalEstimateStatus.Cancelled => "secondary", _ => "primary" };
    var who = DisplayName.Of(Model.Row.PatientName, Model.Row.PatientNameEn);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0 d-flex align-items-center gap-3"><bdi class="hp-num">@e.EstimateNo</bdi> <span class="badge badge-light-@St(e.Status) fs-7 fw-bold">@T["est:" + e.Status]</span>
                @if (Model.Expired && e.Status == HospitalEstimateStatus.Issued) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Expired — re-price it"]</span>}</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Estimates")" class="text-muted text-hover-primary">@T["Estimates & deposits"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><bdi>@who</bdi>&nbsp;·&nbsp;<bdi class="hp-num">@Model.Row.Mrn</bdi></li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @if (canBill && e.Status == HospitalEstimateStatus.Draft)
            {
                <button type="button" class="btn btn-sm btn-light-danger" data-step="Cancel" data-kind="danger" data-ask="@string.Format(T["Cancel estimate {0}? It stays on record, cancelled."].Value, e.EstimateNo)"><i class="ki-outline ki-cross-circle fs-4"></i>@T["Cancel estimate"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-step="Issue" data-ask="@string.Format(T["Issue {0} to {1}? It no longer changes, and the payer is asked for approval when its contract needs it."].Value, e.EstimateNo, who)"><i class="ki-outline ki-send fs-4"></i>@T["Issue estimate"]</button>
            }
            else if (canBill && e.Status == HospitalEstimateStatus.Issued)
            {
                <button type="button" class="btn btn-sm btn-light-danger" data-step="Cancel" data-kind="danger" data-ask="@string.Format(T["Cancel estimate {0}? It stays on record, cancelled."].Value, e.EstimateNo)"><i class="ki-outline ki-cross-circle fs-4"></i>@T["Cancel estimate"]</button>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8">
            <div class="col-xl-8"><div class="card card-flush h-100">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@(Model.Row.Package == null ? T["Services only"].Value : DisplayName.Of(Model.Row.Package, Model.Row.PackageEn ?? Model.Row.Package))</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@(Model.Row.Payer == null ? T["Self-pay"].Value : DisplayName.Of(Model.Row.Payer, Model.Row.PayerEn ?? Model.Row.Payer)) · @T["Expected stay (nights)"] <span class="hp-num">@e.ExpectedNights</span></span>
                    </h3>
                    <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-calculator fs-2 text-primary"></i></span></div></div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Item"]</th><th class="text-end">@T["Qty"]</th><th class="text-end">@T["Estimate"]</th><th class="text-end pe-4 rounded-end">@T["Payer's share"]</th></tr></thead>
                        <tbody>
                            @foreach (var l in Model.Lines)
                            {
                                <tr><td class="ps-4"><span class="text-gray-900 fw-bold fs-6 d-block">@DisplayName.Of(l.Description, l.DescriptionEn)</span>
                                        <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num">@l.Code</bdi>@if (e.PayerId != null && !l.Covered) {<text> · </text><span class="badge badge-light-danger fs-8 fw-bold">@T["Not covered"]</span>}</span></td>
                                    <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@l.Quantity.ToString("0.##", inv)</span></td>
                                    <td class="text-end"><span class="text-gray-900 fw-bold hp-num" dir="ltr">@Money(l.Amount)</span></td>
                                    <td class="text-end pe-4"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@(l.PayerAmount > 0 ? Money(l.PayerAmount) : "—")</span></td></tr>
                            }
                        </tbody>
                        <tfoot><tr class="border-top border-gray-200"><td class="ps-4" colspan="2"><span class="text-primary fw-bolder fs-5">@T["Estimated total"]</span> <span class="text-muted fs-8">@cur</span></td>
                            <td class="text-end"><span class="text-gray-900 fw-bolder fs-5 hp-num" dir="ltr">@Money(e.Gross)</span></td><td class="text-end pe-4"><span class="text-gray-900 fw-bolder fs-5 hp-num" dir="ltr">@Money(e.PayerShare)</span></td></tr></tfoot>
                    </table></div>
                    @if (e.Note != null) {<div class="text-gray-700 fw-semibold fs-6 mt-4"><bdi>@e.Note</bdi></div>}
                    <div class="text-gray-500 fw-semibold fs-7 mt-4">@T["A package has a fixed price; anything beyond its limits (extra nights, complications, a second implant) is billed outside it."]</div>
                </div>
            </div></div>
            <div class="col-xl-4"><div class="card card-flush h-100">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Required deposit"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@cur</span></h3>
                </div>
                <div class="card-body pt-2">
                    <div class="d-flex flex-stack">
                        <div class="d-flex align-items-center"><div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-shield-tick fs-3 text-primary"></i></span></div><span class="text-gray-800 fw-bold fs-6">@T["Payer share"]</span></div>
                        <span class="text-gray-800 fw-bold fs-5 hp-num" dir="ltr">@Money(e.PayerShare)</span>
                    </div>
                    <div class="separator separator-dashed my-3"></div>
                    <div class="d-flex flex-stack">
                        <div class="d-flex align-items-center"><div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-info"><i class="ki-outline ki-user fs-3 text-info"></i></span></div><span class="text-gray-800 fw-bold fs-6">@T["Expected patient share"]</span></div>
                        <span class="text-gray-800 fw-bold fs-5 hp-num" dir="ltr">@Money(e.PatientShare)</span>
                    </div>
                    <div class="separator separator-dashed my-3"></div>
                    <div class="d-flex flex-stack mb-6">
                        <div class="d-flex align-items-center"><div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-wallet fs-3 text-primary"></i></span></div>
                            <div><span class="text-gray-900 fw-bold fs-6 d-block">@T["Deposit required"]</span><span class="text-gray-500 fw-semibold fs-7">+<span class="hp-num" dir="ltr">@e.MarginPct.ToString("0.##", inv)%</span></span></div></div>
                        <span class="text-primary fw-bolder fs-2 hp-num" dir="ltr">@Money(e.Deposit)</span>
                    </div>
                    @if (Model.PreauthNo != null)
                    {
                        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                            <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                                <h4 class="text-gray-900 fw-bold mb-1">@T["Approval request"] <bdi class="hp-num">@Model.PreauthNo</bdi></h4>
                                <div class="fs-6 text-gray-700">@T["pa:" + Model.PreauthStatus] · <a href="@Url.Action("Insurance")" class="fw-bold">@T["Approvals & claims"]</a></div>
                            </div></div>
                        </div>
                    }
                    <div class="text-gray-500 fw-semibold fs-7">@T["Collecting the deposit is done on the patient's bill; the estimate only states it."]</div>
                    @if (e.IssuedAt != null) {<div class="text-gray-500 fw-semibold fs-7 mt-2">@T["Issued"] <span class="hp-num" dir="ltr" data-fmt data-utc="@e.IssuedAt.Value.ToString("o")">@e.IssuedAt.Value.ToString("yyyy-MM-dd HH:mm")</span> · @string.Format(T["valid {0} days"].Value, HospitalEstimateRules.ValidDays)</div>}
                </div>
            </div></div>
        </div>
        @* the record's conversation (owner 2026-11-24): comments, replies, @-mentions, files and tasks, as on Inventory's documents *@
        <partial name="_RecordConversation" model="@(new CrossBuy.Controllers.HospitalConversationRef(CrossBuy.BL.Platform.EntityRegistry.HospitalEstimate, Model.Row.Estimate.ID))" />
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            var base = @Json.Serialize(Url.Action("Estimate", new { id = e.ID }));
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            // In place, never a reload: the page is rendered again and its toolbar and content swapped.
            function swap() {
                return fetch(base, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    ['kt_app_content', 'kt_app_toolbar'].forEach(function (id) { var f = doc.getElementById(id); if (f) document.getElementById(id).innerHTML = f.innerHTML; });
                });
            }
            document.addEventListener('click', function (ev) {
                var t = ev.target.closest('[data-step]'); if (!t) return;
                cbConfirm(t.getAttribute('data-ask'), { kind: t.getAttribute('data-kind') || 'primary' }).then(function (ok) {
                    if (!ok) return;
                    t.disabled = true;
                    fetch(base + '/' + t.getAttribute('data-step'), { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token } })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); });
                });
            });
        })();
    </script>
}
