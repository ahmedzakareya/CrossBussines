@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H73 — the hospital's drug-safety knowledge base, kept by the pharmacy: the medicines that interact (a pair, its
    severity, the effect in Arabic and English) and the dose limits (single and daily, by route); and the record of the
    alerts doctors went past, with their reasons. Each list is searched and paged on the server; every write asks first.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Drug interactions & doses"].Value;
    bool ready = ViewBag.Ready == true, canKeep = ViewBag.CanKeep == true;
    string tab = ViewBag.Tab as string ?? "interactions";
    var counts = ViewBag.Counts is ValueTuple<int, int, int> c ? c : (0, 0, 0);
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    int cols = tab == "limits" ? 7 : tab == "overrides" ? 5 : 5;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Drug interactions & doses"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Pharmacy"]</li></ul>
        </div>
        @if (canKeep && ready && tab != "overrides")
        {
            <button type="button" class="btn btn-sm btn-primary" data-ds-new><i class="ki-outline ki-plus fs-4"></i>@(tab == "limits" ? T["Add a dose limit"] : T["Add an interaction"])</button>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalDrugSafetyService.NoTables]</div></div> }
        else
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-shield-tick fs-2tx text-primary me-4"></i>
                <div class="fs-6 fw-semibold text-gray-700 align-self-center">@T["A doctor's order that meets a contraindication, a major interaction or a dose above its limit stops until the doctor writes why it is still right. A moderate interaction is shown and does not stop the order. The pharmacist sees every interaction in the review."]</div>
            </div>
            @* H128: the theme's list page (demo39 apps/ecommerce, widgets/tables): one tab row of stat tiles, then the list with its title over a muted count *@
            <div class="row g-5 mb-5">
                @foreach (var (k, label, n, icon, tone) in new[] { ("interactions", T["Interactions"].Value, counts.Item1, "abstract-24", "danger"), ("limits", T["Dose limits"].Value, counts.Item2, "capsule", "primary"), ("overrides", T["Alerts gone past"].Value, counts.Item3, "shield-cross", "info") })
                {
                    <div class="col-md-4"><a href="@Url.Action("DrugSafety", new { tab = k })" class="card card-flush h-100 @(tab == k ? "border border-2 border-primary" : "")">
                        <div class="card-header py-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column"><span class="fs-2hx fw-bold lh-1 hp-num text-gray-900">@n</span><span class="text-gray-500 pt-1 fw-semibold fs-6">@label</span></div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-2x text-@tone"></i></span></div></div>
                        </div>
                    </a></div>
                }
            </div>
            <div class="card card-flush">
                <div class="card-header pt-5 flex-wrap gap-3">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@(tab == "limits" ? T["Dose limits"] : tab == "overrides" ? T["Alerts gone past"] : T["Interactions"])</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="d-flex align-items-center position-relative w-300px"><i class="ki-outline ki-magnifier fs-4 position-absolute ms-4"></i><input type="text" id="f_q" class="form-control form-control-solid form-control-sm ps-12" autocomplete="off" placeholder="@T["Search by medicine or text…"]" /></div>
                        @if (tab == "interactions")
                        {
                            <div class="w-175px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_sev"><option value="">@T["All severities"]</option>@foreach (var s in HospitalInteractionSeverity.All) { <option value="@s">@T["sev:" + s]</option> }</select></div>
                        }
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-icon btn-light btn-active-light-primary" title="@T["Reset"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            @if (tab == "limits") { <th class="ps-4 rounded-start">@T["Medicine"]</th><th>@T["Route"]</th><th>@T["Single dose limit"]</th><th>@T["Daily limit"]</th><th>@T["Note"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th> }
                            else if (tab == "overrides") { <th class="ps-4 rounded-start">@T["Time"]</th><th>@T["Patient"]</th><th>@T["Alert"]</th><th class="min-w-250px">@T["Reason"]</th><th class="pe-4 rounded-end">@T["By"]</th> }
                            else { <th class="ps-4 rounded-start">@T["Medicines"]</th><th>@T["Severity"]</th><th class="min-w-300px">@T["Effect"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th> }
                        </tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="@cols" class="text-center text-muted py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="@cols"><div class="text-center py-10"><i class="ki-outline ki-shield-search fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Nothing yet."]</div></div></td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (canKeep && tab == "interactions")
{
    <div class="modal fade" id="dsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Interaction"]</h1><div class="text-muted fw-semibold fs-6">@T["Write the generic name as it appears in the medicine's name (three letters at least); it matches any name that contains it."]</div></div>
            <div class="row g-6">
            <div class="col-6"><label class="fs-6 fw-semibold mb-2 required">@T["First medicine"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="80" data-m="drugA" placeholder="warfarin" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2 required">@T["Second medicine"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="80" data-m="drugB" placeholder="aspirin" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2 required">@T["Severity"]</label><select class="form-select form-select-solid" data-m="severity">@foreach (var s in HospitalInteractionSeverity.All) { <option value="@s">@T["sev:" + s]</option> }</select></div>
            <div class="col-6 d-flex align-items-end pb-3"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-m="isActive" checked /><span class="form-check-label fw-semibold text-gray-700">@T["In use"]</span></label></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Effect (Arabic)"]</label><textarea class="form-control form-control-solid" rows="2" dir="rtl" maxlength="400" data-m="effectAr"></textarea></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Effect (English)"]</label><textarea class="form-control form-control-solid" rows="2" dir="ltr" maxlength="400" data-m="effectEn"></textarea></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-ds-save>@T["Save"]</button></div>
        </div>
    </div></div></div>
}
@if (canKeep && tab == "limits")
{
    <div class="modal fade" id="dsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-750px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-0">@T["Dose limit"]</h1></div>
            <div class="row g-6">
            <div class="col-6"><label class="fs-6 fw-semibold mb-2 required">@T["Medicine"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="80" data-m="drug" placeholder="paracetamol" /></div>
            <div class="col-3"><label class="fs-6 fw-semibold mb-2">@T["Route"]</label><select class="form-select form-select-solid" data-m="route"><option value="">@T["Any route"]</option>@foreach (var r in HospitalMedRoute.All) { <option value="@r">@T["route:" + r]</option> }</select></div>
            <div class="col-3"><label class="fs-6 fw-semibold mb-2 required">@T["Unit"]</label><select class="form-select form-select-solid" data-m="unit">@foreach (var u in HospitalDoseUnit.All) { <option value="@u">@u</option> }</select></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Single dose limit"]</label><input type="number" step="0.001" min="0" class="form-control form-control-solid hp-num" data-m="maxSingle" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Daily limit"]</label><input type="number" step="0.001" min="0" class="form-control form-control-solid hp-num" data-m="maxDaily" /></div>
            <div class="col-12"><div class="separator separator-dashed mb-5"></div><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-user fs-3 text-primary"></i></span></div>
                <div class="d-flex flex-column"><span class="fw-bold fs-6 text-gray-800">@T["A child's dose by weight (optional)"]</span><span class="text-muted fw-semibold fs-7">@T["Computed from the child's last weight and never above the single limit."]</span></div></div></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["mg per kg per dose"]</label><input type="number" step="0.001" min="0" class="form-control form-control-solid hp-num" data-m="perKgMg" /></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["Every (hours)"]</label><input type="number" step="1" min="1" max="72" class="form-control form-control-solid hp-num" data-m="everyHours" /></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["Liquid strength mg/mL"]</label><input type="number" step="0.001" min="0" class="form-control form-control-solid hp-num" data-m="strengthMgPerMl" /></div>
            <div class="col-12"><div class="separator separator-dashed mb-5"></div><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3"><span class="symbol-label bg-light-info"><i class="ki-outline ki-drop fs-3 text-info"></i></span></div>
                <div class="d-flex flex-column"><span class="fw-bold fs-6 text-gray-800">@T["By the kidney (optional)"]</span><span class="text-muted fw-semibold fs-7">@T["Read against the patient's last stored eGFR; a rule by the kidney alone needs no dose limit."]</span></div></div></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Review the dose below eGFR"]</label><input type="number" step="0.1" min="5" max="120" class="form-control form-control-solid hp-num" data-m="renalReviewBelow" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Stop below eGFR"]</label><input type="number" step="0.1" min="5" max="120" class="form-control form-control-solid hp-num" data-m="renalStopBelow" /></div>
            <div class="col-12"><div class="separator separator-dashed mb-5"></div><label class="fs-6 fw-semibold mb-2">@T["Note"]</label><input class="form-control form-control-solid" dir="auto" maxlength="300" data-m="note" /></div>
            <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-m="isActive" checked /><span class="form-check-label fw-semibold text-gray-700">@T["In use"]</span></label></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-ds-save>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            var tab = @Json.Serialize(tab);
            var list = cbServerList({ url: @Json.Serialize(Url.Action("DrugSafetyData")), isAr: @(isAr ? "true" : "false"),
                addParams: function (p) { p.set('tab', tab); var s = document.getElementById('f_sev'); if (s) p.set('severity', s.value); } });
            var mEl = document.getElementById('dsModal'); if (!mEl) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, editing = null;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), ask: @Json.Serialize(T["Save this to the drug-safety list?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function fill(data) { mEl.querySelectorAll('[data-m]').forEach(function (i) { var k = i.getAttribute('data-m'), v = data ? data[k] : null;
                if (i.type === 'checkbox') i.checked = data ? !!v : true; else i.value = v == null ? (i.tagName === 'SELECT' && !data ? i.options[0].value : '') : v;
                if (i.tagName === 'SELECT' && window.jQuery) jQuery(i).trigger('change.select2'); }); }   // the theme's dropdown shows the value set
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-ds-new],[data-ds-edit],[data-ds-save]'); if (!t) return;
                if (t.hasAttribute('data-ds-save')) {
                    var body = editing ? { id: editing } : {};
                    mEl.querySelectorAll('[data-m]').forEach(function (i) { var k = i.getAttribute('data-m'); body[k] = i.type === 'checkbox' ? i.checked : i.type === 'number' ? (i.value === '' ? null : Number(i.value)) : (i.value.trim() || null); });
                    cbConfirm(W.ask).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Content("~/Hospital/DrugSafety/"))+ (tab === 'limits' ? 'Limits' : 'Interactions'), body).then(function (res) { t.disabled = false;
                            if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(mEl).hide(); list.reload(); }); });
                    return;
                }
                editing = t.hasAttribute('data-ds-edit') ? Number(t.getAttribute('data-ds-edit')) : null;
                fill(editing ? JSON.parse(t.getAttribute('data-row')) : null);
                bootstrap.Modal.getOrCreateInstance(mEl).show();
            });
        })();
    </script>
}
