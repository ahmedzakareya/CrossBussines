@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalEncounterView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var e = Model.Encounter;
    var p = (HospitalPatient)ViewBag.Patient;
    var doctor = ViewBag.Doctor as HospitalPractitionerView;
    var departments = (ViewBag.Departments as IReadOnlyList<HospitalDepartment>) ?? Array.Empty<HospitalDepartment>();
    var history = (ViewBag.History as List<HospitalEncounterSummary>) ?? new();
    var doctors = (ViewBag.Doctors as Dictionary<int, HospitalPractitionerView>) ?? new();
    bool canEdit = ViewBag.CanEdit == true, canManage = ViewBag.CanManage == true;
    int codeCount = ViewBag.CodeCount;
    var name = DisplayName.Of(p.Name, p.NameEn);
    ViewData["Title"] = T["Consultation"].Value + " — " + name;
    var age = HospitalPatientService.AgeOn(p.BirthDate, DateTime.UtcNow);
    string[] Lines(string? s) => (s ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var allergies = Lines(p.Allergies);
    var chronic = Lines(p.ChronicConditions);
    string ro = canEdit ? "" : "disabled";
    var vitals = new (string Key, string Label, string? Value, string Step)[] {
        ("bpSystolic", T["BP systolic"].Value, e.BpSystolic?.ToString(), "1"), ("bpDiastolic", T["BP diastolic"].Value, e.BpDiastolic?.ToString(), "1"),
        ("heartRate", T["Heart rate"].Value, e.HeartRate?.ToString(), "1"), ("temperatureC", T["Temperature °C"].Value, e.TemperatureC?.ToString("0.0"), "0.1"),
        ("spO2", "SpO₂ %", e.SpO2?.ToString(), "1"), ("weightKg", T["Weight kg"].Value, e.WeightKg?.ToString("0.0"), "0.1"), ("heightCm", T["Height cm"].Value, e.HeightCm?.ToString("0.0"), "0.1") };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Consultation"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Worklist", new { doctor = e.PractitionerId })" class="text-muted text-hover-primary">@T["Doctor worklist"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@name</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @if (canEdit)
            {
                <button type="button" class="btn btn-sm btn-light" data-save><i class="ki-outline ki-save-2 fs-4"></i>@T["Save draft"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-sign><i class="ki-outline ki-check-square fs-4"></i>@T["Sign & close visit"]</button>
            }
            else if (e.Status == HospitalEncounterStatus.Signed)
            {
                <span class="badge badge-light-success fs-7 px-4 py-3"><i class="ki-outline ki-check-circle fs-5 text-success me-1"></i>@T["Signed"] <span class="hp-num ms-1" data-utc="@e.SignedAt?.ToString("o")">@e.SignedAt?.ToString("yyyy-MM-dd HH:mm")</span></span>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="hp-pbanner p-6 mb-5"><div class="d-flex flex-wrap align-items-center gap-5">
            <div class="symbol symbol-75px symbol-circle flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label fs-2 fw-bold hp-initials">@HospitalUi.Initials(p.NameEn)</span>}</div>
            <div class="flex-grow-1 min-w-0">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1"><a href="@Url.Action("Patient", new { id = p.ID })" class="fs-2 fw-bold text-gray-900 text-hover-primary">@name</a><span class="badge hp-code fw-bold fs-8 hp-num">@p.Mrn</span></div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <span class="hp-chip"><i class="ki-outline ki-user fs-7"></i>@if (age != null) {<span class="hp-num">@age</span> @T["y"] <text> · </text>}@(p.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])</span>
                    @if (p.BloodGroup != null) { <span class="hp-chip"><i class="ki-outline ki-drop fs-7"></i>@T["Blood group"] <span class="hp-num">@p.BloodGroup</span></span> }
                    @if (doctor != null) { <span class="hp-chip"><i class="ki-outline ki-briefcase fs-7"></i>@DisplayName.Of(doctor.Row.Name, doctor.Row.NameEn)</span> }
                </div>
            </div>
        </div></div>

        @if (allergies.Length > 0)
        {
            <div class="notice d-flex rounded border border-danger border-dashed bg-light-danger p-6 mb-5">
                <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                    <div class="mb-3 mb-md-0 fw-semibold pe-5">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["Recorded allergy"]</h4>
                        <div class="fs-6 text-gray-700">@string.Join(DisplayName.IsArabic ? "، " : ", ", allergies) — @T["check every prescription against it."]</div>
                    </div>
                    <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0">@T["Allergy"]</span>
                </div>
            </div>
        }

        <form id="encForm" autocomplete="off">
        <div class="row g-5 g-xl-8">
            <div class="col-xl-8">
                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title align-items-start flex-column m-0">
                        <span class="card-label fw-bold text-gray-900 fs-4">@T["Clinical note"]</span><span class="text-muted mt-1 fw-semibold fs-7">SOAP</span>
                    </div></div>
                    <div class="card-body pt-4">
                        <div class="row g-6">
                            <div class="col-12"><label class="fw-semibold fs-7 text-gray-700 mb-2 required">@T["Chief complaint"]</label><input name="chiefComplaint" value="@e.ChiefComplaint" maxlength="400" class="form-control form-control-solid" @ro /></div>
                            <div class="col-md-6"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["History (S)"]</label><textarea name="history" rows="4" maxlength="4000" class="form-control form-control-solid" @ro>@e.History</textarea></div>
                            <div class="col-md-6"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["Examination (O)"]</label><textarea name="examination" rows="4" maxlength="4000" class="form-control form-control-solid" @ro>@e.Examination</textarea></div>
                        </div>
                        <div class="row g-4 mt-2">
                            @foreach (var v in vitals)
                            {
                                <div class="col-4 col-md"><label class="fw-semibold fs-8 text-muted mb-1 d-block">@v.Label</label><input name="@v.Key" type="number" step="@v.Step" value="@v.Value" class="form-control form-control-sm form-control-solid hp-num" @ro /></div>
                            }
                            <div class="col-4 col-md"><label class="fw-semibold fs-8 text-muted mb-1 d-block">BMI</label><div class="form-control form-control-sm form-control-solid hp-num bg-transparent border-0 fw-bold" data-bmi>@(e.Bmi?.ToString("0.0") ?? "—")</div></div>
                        </div>
                    </div>
                </div>

                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Assessment (A)"]</span></div>
                        @if (codeCount == 0 && canManage) { <div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-seed-codes><i class="ki-outline ki-arrow-down fs-4"></i>@T["Load standard ICD-10 codes"]</button></div> }
                    </div>
                    <div class="card-body pt-2">
                        @if (canEdit)
                        {
                            <div class="mb-4"><select class="form-select form-select-solid" data-no-select2 data-dx-picker data-placeholder="@T["Search code or description..."]"></select></div>
                        }
                        <div data-dx-list></div>
                        <div class="text-muted fs-8 mt-3">@T["Coding system"]: <span class="hp-num">ICD-10</span></div>
                    </div>
                </div>

                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title align-items-start flex-column m-0">
                        <span class="card-label fw-bold text-gray-900 fs-4">@T["Orders (P)"]</span>
                        <span class="text-muted mt-1 fw-semibold fs-7">@T["Lab, imaging and procedures — billed to the visit when it is signed"]</span>
                    </div></div>
                    <div class="card-body pt-2">
                        @if (canEdit) { <div class="mb-4"><select class="form-select form-select-solid" data-no-select2 data-order-picker data-placeholder="@T["Search a test, scan or procedure..."]"></select></div> }
                        <table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                            <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0"><th>@T["Service"]</th><th class="text-end">@T["Price"]</th><th>@T["Coverage"]</th><th class="w-40px"></th></tr></thead>
                            <tbody data-order-body></tbody>
                        </table>
                    </div>
                </div>

                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title align-items-start flex-column m-0">
                        <span class="card-label fw-bold text-gray-900 fs-4">@T["Prescription"]</span>
                        <span class="text-muted mt-1 fw-semibold fs-7">@T["Linked to the pharmacy stock when the pharmacy unit lands"]</span>
                    </div></div>
                    <div class="card-body pt-2">
                        <table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                            <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0"><th>@T["Drug"]</th><th>@T["Dose & duration"]</th><th class="w-100px">@T["Qty"]</th><th class="w-40px"></th></tr></thead>
                            <tbody data-rx-body></tbody>
                        </table>
                        @if (canEdit) { <button type="button" class="btn btn-sm btn-light-primary mt-4" data-rx-add><i class="ki-outline ki-plus fs-4"></i>@T["Add drug"]</button> }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Plan (P)"]</span></div></div>
                    <div class="card-body pt-2"><textarea name="planNote" rows="3" maxlength="4000" class="form-control form-control-solid" @ro>@e.PlanNote</textarea></div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["At a glance"]</span></div></div>
                    <div class="card-body pt-2">
                        <div class="mb-5"><div class="text-muted fs-7 fw-semibold mb-1">@T["Last visit"]</div>
                            @if (history.FirstOrDefault() is HospitalEncounterSummary last)
                            {
                                <div class="fw-bold text-gray-800"><span class="hp-num">@last.StartedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>@if (doctors.TryGetValue(last.PractitionerId, out var ld)) {<text> · </text>@DisplayName.Of(ld.Row.Name, ld.Row.NameEn)}</div>
                                @if (last.PrimaryCode != null) { <div class="text-muted fs-7"><span class="badge hp-code fs-9 hp-num">@last.PrimaryCode</span> @DisplayName.Of(last.PrimaryName, last.PrimaryNameEn)</div> }
                            }
                            else { <div class="fw-bold text-gray-800">@T["First visit"]</div> }
                        </div>
                        <div><div class="text-muted fs-7 fw-semibold mb-1">@T["Chronic conditions"]</div><div class="fw-bold text-gray-800">@(chronic.Length == 0 ? T["None recorded"].Value : string.Join(DisplayName.IsArabic ? "، " : ", ", chronic))</div></div>
                        @if (history.Count > 1)
                        {
                            <div class="separator separator-dashed my-5"></div>
                            <div class="text-muted fs-7 fw-semibold mb-2">@T["Earlier visits"]</div>
                            @foreach (var h in history.Skip(1))
                            {
                                <a href="@Url.Action("Consult", new { id = h.Id })" class="d-flex align-items-center py-2 text-hover-primary"><span class="hp-num text-gray-700 fs-7 me-3">@h.StartedAt.ToLocalTime().ToString("yyyy-MM-dd")</span><span class="text-gray-800 fs-7 text-truncate">@(h.PrimaryCode == null ? h.ChiefComplaint : DisplayName.Of(h.PrimaryName, h.PrimaryNameEn))</span></a>
                            }
                        }
                    </div>
                </div>
                @if (ViewBag.Lab is HospitalLabHistory lab) { <partial name="_HospitalLabResults" model="lab" /> }
                @if (ViewBag.Rad is HospitalRadHistory rad) { <partial name="_HospitalRadResults" model="rad" /> }
                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Referral & follow-up"]</span></div></div>
                    <div class="card-body pt-2"><div class="row g-4">
                        <div class="col-12"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["Follow-up in"]</label>
                            <select name="followUpDays" class="form-select form-select-solid" @ro>
                                <option value="">—</option>
                                @foreach (var f in new[] { (7, T["1 week"].Value), (14, T["2 weeks"].Value), (30, T["1 month"].Value), (90, T["3 months"].Value), (180, T["6 months"].Value) })
                                { <option value="@f.Item1" selected="@(e.FollowUpDays == f.Item1)">@f.Item2</option> }
                            </select></div>
                        <div class="col-12"><label class="fw-semibold fs-7 text-gray-700 mb-2">@T["Refer to"]</label>
                            <select name="referToDepartmentId" class="form-select form-select-solid" @ro>
                                <option value="">—</option>
                                @foreach (var dep in departments) { <option value="@dep.ID" selected="@(e.ReferToDepartmentId == dep.ID)">@DisplayName.Of(dep.Name, dep.NameEn)</option> }
                            </select></div>
                    </div></div>
                </div>
                <div class="notice d-flex rounded border border-dashed p-6 hp-notice">
                    <span class="symbol symbol-45px me-4 flex-shrink-0"><span class="symbol-label"><i class="ki-outline ki-check-square fs-2x text-white"></i></span></span>
                    <div class="fw-semibold">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["On signing"]</h4>
                        <div class="fs-7 text-gray-700">@T["The visit is locked, the appointment is finished, and the consultation fee and the orders go to the visit's bill."]</div>
                    </div>
                </div>
            </div>
        </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var $ = window.jQuery, isAr = @Json.Serialize(DisplayName.IsArabic), canEdit = @Json.Serialize(canEdit);
            var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
            var form = document.getElementById('encForm');
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var dx = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Diagnoses.Select(d => new { code = d.Code, name = DisplayName.Of(d.Name, d.NameEn), primary = d.IsPrimary })));
            var rx = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Prescription.Select(r => new { drug = r.Drug, itemId = r.ItemId, instructions = r.Instructions, quantity = r.Quantity })));
            // H10: what the pharmacy stocks — the doctor picks from it, or types a drug the hospital does not stock.
            var formulary = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IReadOnlyList<(int Id, string Code, string Name, string NameEn, decimal? Price)>?)ViewBag.Formulary ?? Array.Empty<(int, string, string, string, decimal?)>()).Select(f => new { id = f.Id, name = DisplayName.Of(f.Name, f.NameEn), other = DisplayName.IsArabic ? f.NameEn : f.Name, code = f.Code, price = f.Price })));
            var orders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.Orders ?? Array.Empty<HospitalEncounterOrder>()).Select(o => new { id = o.ServiceId, code = o.Code, name = DisplayName.Of(o.Name, o.NameEn), price = o.Price })));
            var money = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { dp = (ViewBag.Currency as HospitalCurrency)?.Decimals ?? 2, label = (ViewBag.Currency as HospitalCurrency)?.Label(DisplayName.IsArabic) ?? "" }));
            var W = {
                primary: @Json.Serialize(T["Primary"].Value), secondary: @Json.Serialize(T["Secondary"].Value), makePrimary: @Json.Serialize(T["Make primary"].Value),
                none: @Json.Serialize(T["No diagnosis yet."].Value), noRx: @Json.Serialize(T["No drug prescribed."].Value),
                saved: @Json.Serialize(T["Saved"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), confirm: @Json.Serialize(T["Sign and close this visit? It cannot be changed afterwards."].Value),
                drug: @Json.Serialize(T["Drug name and strength"].Value), stocked: @Json.Serialize(T["In the pharmacy"].Value), dose: @Json.Serialize(T["e.g. 1 tab twice daily · 30 days"].Value),
                noOrder: @Json.Serialize(T["Nothing ordered."].Value), cash: @Json.Serialize(T["Cash"].Value)
            };
            var urls = { services: @Json.Serialize(Url.Action("SearchServices", new { orderable = true })), codes: @Json.Serialize(Url.Action("SearchDiagnosisCodes")), save: @Json.Serialize(Url.Action("SaveConsultation", new { id = e.ID })), sign: @Json.Serialize(Url.Action("SignConsultation", new { id = e.ID })), seed: @Json.Serialize(Url.Action("SeedDiagnosisCodes")), worklist: @Json.Serialize(Url.Action("Worklist", new { doctor = e.PractitionerId })) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }

            // ---- diagnoses ------------------------------------------------------------------
            var dxList = document.querySelector('[data-dx-list]');
            function drawDx() {
                if (!dx.length) { dxList.innerHTML = '<div class="text-muted fs-7 py-3">' + esc(W.none) + '</div>'; return; }
                dxList.innerHTML = dx.map(function (d, i) {
                    return '<div class="d-flex align-items-center py-3 border-bottom border-gray-200 border-bottom-dashed"><span class="badge hp-code fw-bold fs-8 hp-num">' + esc(d.code) + '</span>' +
                        '<span class="ms-3 fw-semibold text-gray-800 flex-grow-1">' + esc(d.name) + '</span>' +
                        (d.primary ? '<span class="badge hp-badge fs-8">' + esc(W.primary) + '</span>' : (canEdit ? '<button type="button" class="btn btn-sm btn-light py-1 px-3 fs-8" data-dx-primary="' + i + '">' + esc(W.makePrimary) + '</button>' : '<span class="badge badge-light fs-8">' + esc(W.secondary) + '</span>')) +
                        (canEdit ? '<button type="button" class="btn btn-icon btn-sm btn-light w-30px h-30px ms-2" data-dx-remove="' + i + '"><i class="ki-outline ki-trash fs-5"></i></button>' : '') + '</div>';
                }).join('');
            }
            var picker = document.querySelector('[data-dx-picker]');
            if (picker && $ && $.fn.select2) {
                $(picker).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', placeholder: picker.getAttribute('data-placeholder'),
                    ajax: { url: urls.codes, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
                $(picker).on('select2:select', function (ev) {
                    var c = ev.params.data;
                    if (!dx.some(function (x) { return x.code === c.id; })) dx.push({ code: c.id, name: c.name, primary: dx.length === 0 });
                    $(picker).val(null).trigger('change'); drawDx();
                });
            }
            dxList.addEventListener('click', function (ev) {
                var p = ev.target.closest('[data-dx-primary]'), r = ev.target.closest('[data-dx-remove]');
                if (p) { var i = +p.getAttribute('data-dx-primary'); dx.forEach(function (d, j) { d.primary = j === i; }); drawDx(); }
                if (r) { var k = +r.getAttribute('data-dx-remove'), was = dx[k].primary; dx.splice(k, 1); if (was && dx.length) dx[0].primary = true; drawDx(); }
            });

            // ---- prescription ---------------------------------------------------------------
            var rxBody = document.querySelector('[data-rx-body]');
            function drawRx() {
                if (!rx.length) { rxBody.innerHTML = '<tr><td colspan="4" class="text-muted fs-7 py-3">' + esc(W.noRx) + '</td></tr>'; return; }
                rxBody.innerHTML = rx.map(function (r, i) {
                    if (!canEdit) return '<tr><td class="fw-semibold text-gray-800">' + esc(r.drug) + (r.itemId ? ' <span class="badge badge-light-success fs-9">' + esc(W.stocked) + '</span>' : '') + '</td><td class="fs-7">' + esc(r.instructions || '') + '</td><td class="hp-num">' + r.quantity + '</td><td></td></tr>';
                    var opts = '<option value=""></option>' + formulary.map(function (f) { return '<option value="i:' + f.id + '"' + (r.itemId === f.id ? ' selected' : '') + '>' + esc(f.name + ' · ' + f.other + ' · ' + f.code) + '</option>'; }).join('') +
                        (!r.itemId && r.drug ? '<option value="t:' + esc(r.drug) + '" selected>' + esc(r.drug) + '</option>' : '');
                    return '<tr><td class="min-w-250px"><select class="form-select form-select-sm form-select-solid" data-rx-drug data-i="' + i + '" data-placeholder="' + esc(W.drug) + '">' + opts + '</select></td>' +
                        '<td><input class="form-control form-control-sm form-control-solid" data-rx="instructions" data-i="' + i + '" value="' + esc(r.instructions || '') + '" placeholder="' + esc(W.dose) + '" maxlength="400" /></td>' +
                        '<td><input type="number" min="1" class="form-control form-control-sm form-control-solid hp-num" data-rx="quantity" data-i="' + i + '" value="' + r.quantity + '" /></td>' +
                        '<td><button type="button" class="btn btn-icon btn-sm btn-light w-30px h-30px" data-rx-remove="' + i + '"><i class="ki-outline ki-trash fs-5"></i></button></td></tr>';
                }).join('');
                // The house select2, with tags: a stocked item, or any name typed (not stocked). select2's change only reaches jQuery.
                if (canEdit && window.jQuery && jQuery.fn.select2) jQuery(rxBody).find('[data-rx-drug]').each(function () {
                    var $s = jQuery(this);
                    $s.select2({ tags: true, insertTag: function (data, tag) { data.push(tag); }, width: '100%', placeholder: $s.data('placeholder'), allowClear: true, dir: document.documentElement.dir || 'ltr',
                        templateResult: function (o) { var f = /^i:/.test(o.id || '') ? formulary.filter(function (x) { return 'i:' + x.id === o.id; })[0] : null;
                            return f ? jQuery('<span><span class="fw-semibold">' + esc(f.name) + '</span> <span class="text-muted fs-8" dir="auto">' + esc(f.other) + '</span>' + (f.price != null ? ' <span class="text-muted fs-8 hp-num">' + esc(f.price) + '</span>' : '') + ' <span class="badge badge-light-success fs-9">' + esc(W.stocked) + '</span></span>') : o.text; },
                        // the search matches the Arabic name, the English name and the code; the chosen line shows the reader's name
                        templateSelection: function (o) { var f = /^i:/.test(o.id || '') ? formulary.filter(function (x) { return 'i:' + x.id === o.id; })[0] : null; return f ? f.name : o.text; } })
                      .on('change', function () {
                        var r = rx[+$s.attr('data-i')], v = $s.val() || '';
                        if (/^i:/.test(v)) { var f = formulary.filter(function (x) { return 'i:' + x.id === v; })[0]; r.itemId = f ? f.id : null; r.drug = f ? f.name : ''; }
                        else { r.itemId = null; r.drug = v.replace(/^t:/, ''); }
                      });
                });
            }
            rxBody.addEventListener('input', function (ev) { var el = ev.target.closest('[data-rx]'); if (!el) return; var r = rx[+el.getAttribute('data-i')], k = el.getAttribute('data-rx'); r[k] = k === 'quantity' ? (+el.value || 1) : el.value; });
            rxBody.addEventListener('click', function (ev) { var b = ev.target.closest('[data-rx-remove]'); if (b) { rx.splice(+b.getAttribute('data-rx-remove'), 1); drawRx(); } });
            var add = document.querySelector('[data-rx-add]');
            if (add) add.addEventListener('click', function () { rx.push({ drug: '', instructions: '', quantity: 1 }); drawRx(); var inputs = rxBody.querySelectorAll('[data-rx="drug"]'); if (inputs.length) inputs[inputs.length - 1].focus(); });

            // ---- orders -------------------------------------------------------------------------
            var orderBody = document.querySelector('[data-order-body]');
            function fmtMoney(v) { return Number(v).toLocaleString('en-US', { minimumFractionDigits: money.dp, maximumFractionDigits: money.dp }); }
            function drawOrders() {
                if (!orders.length) { orderBody.innerHTML = '<tr><td colspan="4" class="text-muted fs-7 py-3">' + esc(W.noOrder) + '</td></tr>'; return; }
                orderBody.innerHTML = orders.map(function (o, i) {
                    return '<tr><td><div class="fw-semibold text-gray-800">' + esc(o.name) + '</div><div class="text-muted fs-8 hp-num">' + esc(o.code) + '</div></td>' +
                        '<td class="text-end hp-num">' + fmtMoney(o.price) + ' <span class="text-muted fs-8">' + esc(money.label) + '</span></td>' +
                        '<td><span class="badge badge-light fs-8">' + esc(W.cash) + '</span></td>' +
                        '<td>' + (canEdit ? '<button type="button" class="btn btn-icon btn-sm btn-light w-30px h-30px" data-order-remove="' + i + '"><i class="ki-outline ki-trash fs-5"></i></button>' : '') + '</td></tr>';
                }).join('');
            }
            var op = document.querySelector('[data-order-picker]');
            if (op && $ && $.fn.select2) {
                $(op).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', placeholder: op.getAttribute('data-placeholder'),
                    ajax: { url: urls.services, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
                $(op).on('select2:select', function (ev) {
                    var s = ev.params.data;
                    if (!orders.some(function (o) { return o.id === s.id; })) orders.push({ id: s.id, code: s.code, name: s.name, price: s.price });
                    $(op).val(null).trigger('change'); drawOrders();
                });
            }
            orderBody.addEventListener('click', function (ev) { var b = ev.target.closest('[data-order-remove]'); if (b) { orders.splice(+b.getAttribute('data-order-remove'), 1); drawOrders(); } });

            // ---- BMI as the vitals are typed ---------------------------------------------------
            function bmi() {
                var w = +form.elements.weightKg.value, h = +form.elements.heightCm.value / 100;
                document.querySelector('[data-bmi]').textContent = w > 0 && h > 0 ? (w / (h * h)).toFixed(1) : '—';
            }
            form.elements.weightKg.addEventListener('input', bmi); form.elements.heightCm.addEventListener('input', bmi);

            // ---- save / sign -------------------------------------------------------------------
            function num(n) { var v = form.elements[n].value; return v === '' ? null : +v; }
            function payload() {
                return {
                    chiefComplaint: form.elements.chiefComplaint.value, history: form.elements.history.value, examination: form.elements.examination.value, planNote: form.elements.planNote.value,
                    bpSystolic: num('bpSystolic'), bpDiastolic: num('bpDiastolic'), heartRate: num('heartRate'), temperatureC: num('temperatureC'), spO2: num('spO2'), weightKg: num('weightKg'), heightCm: num('heightCm'),
                    followUpDays: num('followUpDays'), referToDepartmentId: num('referToDepartmentId'),
                    diagnoses: dx.map(function (d) { return { code: d.code, primary: d.primary }; }),
                    prescription: rx.filter(function (r) { return (r.drug || '').trim(); }),
                    orderServiceIds: orders.map(function (o) { return o.id; })
                };
            }
            function send(url, after) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(payload()) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { if (!res.ok) { toast('error', res.error || W.failed); return false; } toast('success', W.saved); if (after) after(); return true; });
            }
            var s = document.querySelector('[data-save]'); if (s) s.addEventListener('click', function () { s.disabled = true; send(urls.save).then(function () { s.disabled = false; }); });
            var g = document.querySelector('[data-sign]');
            if (g) g.addEventListener('click', function () {
                cbConfirm(W.confirm).then(function (yes) {
                    if (!yes) return;
                    g.disabled = true;
                    send(urls.sign, function () { location.href = urls.worklist; }).then(function (ok) { if (!ok) g.disabled = false; });
                });
            });
            var seed = document.querySelector('[data-seed-codes]');
            if (seed) seed.addEventListener('click', function () {
                seed.disabled = true;
                var fd = new FormData(); fd.append('__RequestVerificationToken', token);
                fetch(urls.seed, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (res) {
                    if (res.ok) { toast('success', W.saved); seed.remove(); } else { seed.disabled = false; toast('error', res.error || W.failed); }
                });
            });
            document.querySelectorAll('[data-utc]').forEach(function (el) { var d = new Date(el.getAttribute('data-utc').replace(/Z?$/, 'Z')); if (!isNaN(d)) el.textContent = d.toISOString().slice(0, 10) + ' ' + d.toTimeString().slice(0, 5); });
            drawDx(); drawRx(); drawOrders();
        })();
    </script>
}
