                if (!form.elements.chiefComplaint.value.trim()) bad = fieldError('Enter the chief complaint before signing', W.needComplaint) || bad;
                if (!dx.length) bad = fieldError('Add at least one diagnosis before signing', W.needDx) || bad;
                else if (dx.filter(function (d) { return d.primary; }).length !== 1) bad = fieldError('Mark exactly one diagnosis as primary', W.needPrimary) || bad;
                if (rxIncomplete()) bad = fieldError('rx-no-drug', W.rxNoDrug) || bad;
                var firstBad = document.querySelector('[data-fe]'); if (firstBad) firstBad.scrollIntoView({ block: 'center', behavior: 'smooth' });
                return bad;
            }
            document.querySelectorAll('[data-sign]').forEach(function (g) { g.addEventListener('click', function () {
                if (signGaps()) return;
                var hit = [].concat.apply([], rx.map(function (r) { return r.hits || []; })).filter(function (h, i, a) { return a.indexOf(h) === i; });
                (hit.length ? cbConfirm(W.allergySign.replace('{0}', hit.join(', '))) : Promise.resolve(true)).then(function (go) { return go ? cbConfirm(W.confirm) : false; }).then(function (yes) {
                    if (!yes) return;
                    g.disabled = true;
                    send(urls.sign, function () { HospitalJourney.after(@e.PatientId, 'consult', { root: @Json.Serialize(Url.Content("~/Hospital")), onStay: function () { location.href = urls.worklist; } }); }).then(function (ok) { if (!ok) g.disabled = false; });
                });
            }); });
            var seed = document.querySelector('[data-seed-codes]');
            if (seed) seed.addEventListener('click', function () {
                seed.disabled = true;
                var fd = new FormData(); fd.append('__RequestVerificationToken', token);
                fetch(urls.seed, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (res) {
                    if (res.ok) { toast('success', W.saved); seed.remove(); } else { seed.disabled = false; toast('error', res.error || W.failed); }
                });
            });
            document.querySelectorAll('[data-utc]').forEach(function (el) { var d = new Date(el.getAttribute('data-utc').replace(/Z?$/, 'Z')); if (!isNaN(d)) el.textContent = d.toISOString().slice(0, 10) + ' ' + d.toTimeString().slice(0, 5); });
            drawDx(); drawRx(); drawOrders();
            rx.forEach(function (r) { if ((r.drug || '').trim()) checkRx(r, false); });
        })();
    </script>
}
