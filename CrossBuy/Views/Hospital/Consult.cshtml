@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalEncounterView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@functions {
    // the Arabic example for the Arabic directions box on an English screen: the same key, read in Arabic
    string DoseInArabic() { var ui = System.Globalization.CultureInfo.CurrentUICulture; try { System.Globalization.CultureInfo.CurrentUICulture = new System.Globalization.CultureInfo("ar"); return T["e.g. 1 tab twice daily · 30 days"].Value; } finally { System.Globalization.CultureInfo.CurrentUICulture = ui; } }
}
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var e = Model.Encounter;
    var p = (HospitalPatient)ViewBag.Patient;
    var doctor = ViewBag.Doctor as HospitalPractitionerView;
    var departments = (ViewBag.Departments as IReadOnlyList<HospitalDepartment>) ?? Array.Empty<HospitalDepartment>();
    var history = (ViewBag.History as List<HospitalEncounterSummary>) ?? new();
    var doctors = (ViewBag.Doctors as Dictionary<int, HospitalPractitionerView>) ?? new();
    bool canEdit = ViewBag.CanEdit == true, canManage = ViewBag.CanManage == true;
    int codeCount = ViewBag.CodeCount;
    var name = DisplayName.Of(p.Name, p.NameEn);
    ViewData["Title"] = T["Consultation"].Value + " — " + name;
    var age = HospitalPatientService.AgeOn(p.BirthDate, DateTime.UtcNow);
    string[] Lines(string? s) => (s ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var allergies = Lines(p.Allergies).Select(x => HospitalAllergyText.Display(x)).ToArray();
    var chronic = Lines(p.ChronicConditions).Select(x => HospitalConditionText.Display(x)).ToArray();
    string ro = canEdit ? "" : "disabled";
    var vitals = new (string Key, string Label, string? Value, string Step)[] {
        ("bpSystolic", T["BP systolic"].Value, e.BpSystolic?.ToString(), "1"), ("bpDiastolic", T["BP diastolic"].Value, e.BpDiastolic?.ToString(), "1"),
        ("heartRate", T["Heart rate"].Value, e.HeartRate?.ToString(), "1"), ("temperatureC", T["Temperature °C"].Value, e.TemperatureC?.ToString("0.0"), "0.1"),
        ("spO2", "SpO₂ %", e.SpO2?.ToString(), "1"), ("weightKg", T["Weight kg"].Value, e.WeightKg?.ToString("0.0"), "0.1"), ("heightCm", T["Height cm"].Value, e.HeightCm?.ToString("0.0"), "0.1") };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Consultation"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Worklist", new { doctor = e.PractitionerId })" class="text-muted text-hover-primary">@T["Doctor worklist"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@name</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @* the prescription is a Report Studio layout of this visit — see _ReportPrintMenu *@
            @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
            {
                ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalConsult,
                DocumentId = e.ID.ToString(),
                DocumentTitle = name,
            })
            <a href="@Url.Action("SpecialtyVisit", new { id = e.ID })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-abstract-26 fs-4"></i>@T["Specialty forms"]</a>
            @if (canEdit)
            {
                <button type="button" class="btn btn-sm btn-light" data-save><i class="ki-outline ki-save-2 fs-4"></i>@T["Save draft"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-sign><i class="ki-outline ki-check-square fs-4"></i>@T["Sign & close visit"]</button>
            }
            else if (e.Status == HospitalEncounterStatus.Signed)
            {
                <span class="badge badge-light-primary fs-7 px-4 py-3"><i class="ki-outline ki-check-circle fs-5 text-primary me-1"></i>@T["Signed"] <span class="hp-num ms-1" data-utc="@e.SignedAt?.ToString("o")">@e.SignedAt?.ToString("yyyy-MM-dd HH:mm")</span></span>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H126: the patient strip — demo39 apps/customers/view: photo, name over the file number, the facts as badges *@
        <div class="card card-flush mb-5"><div class="card-body py-6"><div class="d-flex flex-wrap align-items-center gap-5">
            <div class="symbol symbol-75px symbol-circle flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label fs-2 fw-bold bg-light-primary text-primary">@HospitalUi.Initials(p.NameEn)</span>}</div>
            <div class="flex-grow-1 min-w-0">
                <a href="@Url.Action("Patient", new { id = p.ID })" class="fs-2 fw-bold text-gray-900 text-hover-primary d-block mb-1">@name</a>
                <div class="d-flex flex-wrap align-items-center fw-semibold fs-6 text-gray-500 gap-4">
                    <span class="d-flex align-items-center"><i class="ki-outline ki-profile-circle fs-4 me-1"></i><bdi class="hp-num" dir="ltr">@p.Mrn</bdi></span>
                    <span class="d-flex align-items-center"><i class="ki-outline ki-user fs-4 me-1"></i>@if (age != null) {<span class="hp-num">@age</span><text>&nbsp;@T["y"] · </text>}@(p.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])</span>
                    @if (p.BloodGroup != null) { <span class="d-flex align-items-center"><i class="ki-outline ki-drop fs-4 me-1"></i>@T["Blood group"]&nbsp;<bdi class="hp-num" dir="ltr">@p.BloodGroup</bdi></span> }
                    @if (doctor != null) { <span class="d-flex align-items-center"><i class="ki-outline ki-briefcase fs-4 me-1"></i>@DisplayName.Of(doctor.Row.Name, doctor.Row.NameEn)</span> }
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (allergies.Length > 0) { <span class="badge badge-light-danger fs-7 fw-bold py-3 px-4"><i class="ki-outline ki-shield-cross fs-5 text-danger me-1"></i>@T["Allergy"]</span> }
                <span class="badge badge-light-@(e.Status == HospitalEncounterStatus.Signed ? "primary" : "primary") fs-7 fw-bold py-3 px-4">@(e.Status == HospitalEncounterStatus.Signed ? T["Signed"] : T["Draft"])</span>
            </div>
        </div></div></div>

        @if (allergies.Length > 0)
        {
            <div class="notice d-flex rounded border border-danger border-dashed bg-light-danger p-6 mb-5">
                <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                    <div class="mb-3 mb-md-0 fw-semibold pe-5">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["Recorded allergy"]</h4>
                        <div class="fs-6 text-gray-700">@string.Join(DisplayName.IsArabic ? "، " : ", ", allergies) — @T["check every prescription against it."]</div>
                    </div>
                    <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0">@T["Allergy"]</span>
                </div>
            </div>
        }

        <form id="encForm" autocomplete="off">
        <div class="row g-5 g-xl-8">
            <div class="col-xl-8">
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800"><span class="badge badge-circle badge-primary fs-7 me-2">1</span>@T["Clinical note"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7" dir="ltr">SOAP</span>
                    </h3>
                    @* H254: ambient documentation — record the visit, the hospital's own speech service drafts the note *@
                    @if (canEdit) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-scribe data-rec="@T["Record the visit"]" data-stop="@T["Stop and draft"]"><i class="ki-outline ki-microphone-2 fs-4"></i><span>@T["Record the visit"]</span></button></div>}
                    </div>
                    <div class="px-9 d-none" data-scribe-out><div class="notice d-flex rounded border border-dashed p-4 hp-notice"><div class="fs-7 text-gray-700"><div class="fw-bold mb-1">@T["Heard"]</div><div dir="auto" data-scribe-text></div><div class="text-muted fs-8 mt-2">@T["The draft filled the empty fields and was added to the others: read and correct before saving."]</div></div></div></div>
                    <div class="card-body pt-4">
                        <div class="row g-6">
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Chief complaint"]</label><input name="chiefComplaint" value="@e.ChiefComplaint" maxlength="400" class="form-control form-control-solid" @ro /></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["History (S)"]</label><textarea name="history" rows="4" maxlength="4000" class="form-control form-control-solid" @ro>@e.History</textarea></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Examination (O)"]</label><textarea name="examination" rows="4" maxlength="4000" class="form-control form-control-solid" @ro>@e.Examination</textarea></div>
                        </div>
                        <div class="separator separator-dashed my-6"></div>
                        <div class="d-flex align-items-center mb-4"><span class="symbol symbol-30px me-3"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-heart fs-4 text-danger"></i></span></span><span class="fs-6 fw-bold text-gray-800">@T["Vitals"]</span></div>
                        <div class="row g-4">
                            @foreach (var v in vitals)
                            {
                                <div class="col-6 col-md-3"><label class="fw-semibold fs-7 text-gray-600 mb-1 d-block">@v.Label</label><input name="@v.Key" type="number" step="@v.Step" value="@v.Value" class="form-control form-control-sm form-control-solid hp-num" dir="ltr" @ro /></div>
                            }
                            <div class="col-4 col-md"><label class="fw-semibold fs-7 text-gray-600 mb-1 d-block" dir="ltr">BMI</label><div class="d-flex align-items-center h-35px"><span class="badge badge-light-primary fs-6 fw-bold hp-num" data-bmi>@(e.Bmi?.ToString("0.0") ?? "—")</span></div></div>
                        </div>
                    </div>
                </div>

                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800"><span class="badge badge-circle badge-primary fs-7 me-2">2</span>@T["Assessment (A)"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Coding system"]: <bdi dir="ltr">ICD-10</bdi></span></h3>
                        @if (codeCount == 0 && canManage) { <div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-seed-codes><i class="ki-outline ki-arrow-down fs-4"></i>@T["Load standard ICD-10 codes"]</button></div> }
                    </div>
                    <div class="card-body pt-2">
                        @if (canEdit)
                        {
                            <div class="mb-4"><select class="form-select form-select-solid" data-no-select2 data-dx-picker data-placeholder="@T["Search code or description..."]"></select></div>
                        }
                        <div data-dx-list></div><div data-fe-at="dx"></div>
                    </div>
                </div>

                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title"><span class="card-label fw-bold text-gray-800"><span class="badge badge-circle badge-primary fs-7 me-2">3</span>@T["Plan (P)"]</span></h3></div>
                    <div class="card-body pt-2"><textarea name="planNote" rows="3" maxlength="4000" class="form-control form-control-solid" @ro>@e.PlanNote</textarea></div>
                </div>

                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800"><span class="badge badge-circle badge-primary fs-7 me-2">4</span>@T["Orders (P)"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Lab, imaging and procedures — billed to the visit when it is signed"]</span>
                    </h3></div>
                    <div class="card-body pt-2">
                        @if (canEdit) { <div class="mb-5"><select class="form-select form-select-solid" data-no-select2 data-order-picker data-placeholder="@T["Search a test, scan or procedure..."]"></select></div> }
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Service"]</th><th class="text-end">@T["Price"]</th><th>@T["Coverage"]</th><th class="w-50px pe-4 rounded-end"></th></tr></thead>
                            <tbody data-order-body></tbody>
                        </table></div>
                        <div data-fe-at="orders"></div>
                    </div>
                </div>

                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800"><span class="badge badge-circle badge-primary fs-7 me-2">5</span>@T["Prescription"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Pick from the pharmacy's medicines — a drug it does not stock is marked"]</span>
                    </h3>
                        @if (canEdit) { <div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-rx-add><i class="ki-outline ki-plus fs-4"></i>@T["Add drug"]</button></div> }
                    </div>
                    <div class="card-body pt-2">
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Drug"]</th><th>@T["Dose & duration"]</th><th class="w-100px">@T["Qty"]</th><th class="w-50px pe-4 rounded-end"></th></tr></thead>
                            <tbody data-rx-body></tbody>
                        </table></div>
                        <div data-fe-at="rx"></div>
                    </div>
                </div>

                @* H271: the save and the sign follow the doctor down the page (the owner: they were only at the top of a
                   2,600px page) *@
                @if (canEdit)
                {
                    <div class="position-sticky bottom-0 mt-5 d-print-none" style="z-index:5">
                        <div class="card card-flush shadow-sm border border-gray-300"><div class="card-body py-4 d-flex flex-wrap align-items-center gap-3">
                            <span class="text-gray-600 fs-7 fw-semibold"><i class="ki-outline ki-information-5 fs-6 text-primary me-1"></i>@T["Save the draft as you go; sign when the visit is done"]</span>
                            <div class="d-flex gap-2 ms-auto">
                                <button type="button" class="btn btn-sm btn-light" data-save><i class="ki-outline ki-save-2 fs-4"></i>@T["Save draft"]</button>
                                <button type="button" class="btn btn-sm btn-primary" data-sign><i class="ki-outline ki-check-square fs-4"></i>@T["Sign & close visit"]</button>
                            </div>
                        </div></div>
                    </div>
                }
            </div>

            <div class="col-xl-4">
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title"><span class="card-label fw-bold text-gray-800">@T["At a glance"]</span></h3></div>
                    <div class="card-body pt-2">
                        <div class="d-flex align-items-start">
                            <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-calendar fs-3 text-primary"></i></span></div>
                            <div class="flex-grow-1 min-w-0"><span class="text-gray-500 fw-semibold fs-7 d-block">@T["Last visit"]</span>
                            @if (history.FirstOrDefault() is HospitalEncounterSummary last)
                            {
                                <div class="text-gray-800 fw-bold fs-6"><bdi class="hp-num">@last.StartedAt.ToLocalTime().ToString("yyyy-MM-dd")</bdi>@if (doctors.TryGetValue(last.PractitionerId, out var ld)) {<text> · </text>@DisplayName.Of(ld.Row.Name, ld.Row.NameEn)}</div>
                                @if (last.PrimaryCode != null) { <div class="text-gray-600 fs-7 mt-1"><span class="badge badge-light-primary fs-8 fw-bold hp-num" dir="ltr">@last.PrimaryCode</span> @DisplayName.Of(last.PrimaryName, last.PrimaryNameEn)</div> }
                            }
                            else { <div class="text-gray-800 fw-bold fs-6">@T["First visit"]</div> }
                            </div>
                        </div>
                        <div class="separator separator-dashed my-3"></div>
                        <div class="d-flex align-items-start">
                            <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@(chronic.Length == 0 ? "primary" : "danger")"><i class="ki-outline ki-pulse fs-3 text-@(chronic.Length == 0 ? "primary" : "danger")"></i></span></div>
                            <div class="flex-grow-1 min-w-0"><span class="text-gray-500 fw-semibold fs-7 d-block">@T["Chronic conditions"]</span>
                                @if (chronic.Length == 0) { <div class="text-gray-800 fw-bold fs-6">@T["None recorded"]</div> }
                                else { <div class="d-flex flex-wrap gap-1 mt-1">@foreach (var c in chronic) {<span class="badge badge-light-danger fs-7 fw-bold">@c</span>}</div> }
                            </div>
                        </div>
                        @if (history.Count > 1)
                        {
                            <div class="separator separator-dashed my-3"></div>
                            <div class="text-gray-500 fw-semibold fs-7 mb-2">@T["Earlier visits"]</div>
                            @foreach (var h in history.Skip(1))
                            {
                                <a href="@Url.Action("Consult", new { id = h.Id })" class="d-flex align-items-center py-2 rounded bg-hover-light-primary px-2">
                                    <div class="symbol symbol-30px me-3"><span class="symbol-label bg-light"><i class="ki-outline ki-document fs-5 text-gray-600"></i></span></div>
                                    <div class="min-w-0 flex-grow-1"><span class="text-gray-800 fw-bold fs-7 d-block text-truncate">@(h.PrimaryCode == null ? h.ChiefComplaint : DisplayName.Of(h.PrimaryName, h.PrimaryNameEn))</span><bdi class="text-gray-500 fs-8 hp-num">@h.StartedAt.ToLocalTime().ToString("yyyy-MM-dd")</bdi></div>
                                </a>
                            }
                        }
                    </div>
                </div>
                @if (ViewBag.Lab is HospitalLabHistory lab) { <partial name="_HospitalLabResults" model="lab" /> }
                @if (ViewBag.Rad is HospitalRadHistory rad) { <partial name="_HospitalRadResults" model="rad" /> }
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title"><span class="card-label fw-bold text-gray-800">@T["Referral & follow-up"]</span></h3></div>
                    <div class="card-body pt-2"><div class="row g-6">
                        <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Follow-up in"]</label>
                            <select name="followUpDays" class="form-select form-select-solid" data-control="select2" data-hide-search="true" @ro>
                                <option value="">—</option>
                                @foreach (var f in new[] { (7, T["1 week"].Value), (14, T["2 weeks"].Value), (30, T["1 month"].Value), (90, T["3 months"].Value), (180, T["6 months"].Value) })
                                { <option value="@f.Item1" selected="@(e.FollowUpDays == f.Item1)">@f.Item2</option> }
                            </select></div>
                        <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Refer to"]</label>
                            <select name="referToDepartmentId" class="form-select form-select-solid" data-control="select2" @ro>
                                <option value="">—</option>
                                @foreach (var dep in departments) { <option value="@dep.ID" selected="@(e.ReferToDepartmentId == dep.ID)">@DisplayName.Of(dep.Name, dep.NameEn)</option> }
                            </select></div>
                    </div></div>
                </div>
                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6">
                    <i class="ki-outline ki-check-square fs-2tx text-primary me-4"></i>
                    <div class="fw-semibold">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["On signing"]</h4>
                        <div class="fs-7 text-gray-700">@T["The visit is locked, the appointment is finished, and the consultation fee and the orders go to the visit's bill."]</div>
                    </div>
                </div>
            </div>
        </div>
        </form>
        @* H177: addenda and corrections on the locked record *@
        @if (ViewBag.Addenda is CrossBuy.BL.Hospital.HospitalAddendaBlock adb) { <partial name="_Addenda" model="adb" /> }
        @* the record's conversation (owner 2026-11-24): comments, replies, @-mentions, files and tasks, as on Inventory's documents *@
        <partial name="_RecordConversation" model="@(new CrossBuy.Controllers.HospitalConversationRef(CrossBuy.BL.Platform.EntityRegistry.HospitalEncounter, Model.Encounter.ID))" />
    </div></div>
</div>

@await Html.PartialAsync("_ReportPreviewModal", (object)(T["Prescription"].Value + " " + name))

@section Scripts {
    <script src="~/js/hospital/hospital-journey.js" asp-append-version="true"></script>
    <script>
        (function () {
            var btn = document.querySelector('[data-scribe]'); if (!btn || !navigator.mediaDevices || !window.MediaRecorder) { if (btn) btn.classList.add('d-none'); return; }
            var url = @Json.Serialize(Url.Content("~/Hospital/Consult/" + e.ID + "/Scribe")), rec = null, chunks = [], label = btn.querySelector('span');
            var W = { failed: @Json.Serialize(T["The visit could not be transcribed"].Value), off: @Json.Serialize(T["The speech service is not available now"].Value), long: @Json.Serialize(T["The recording is too long: record the visit in parts of about a minute"].Value) };
            function put(name, v, append) {
                var el = document.querySelector('#encForm [name=' + name + ']'); if (!el || v == null || v === '') return;
                if (!el.value) el.value = v; else if (append) el.value = el.value + '\n' + v;
                el.dispatchEvent(new Event('input', { bubbles: true }));
            }
            btn.addEventListener('click', function () {
                if (rec && rec.state === 'recording') { rec.stop(); return; }
                navigator.mediaDevices.getUserMedia({ audio: true }).then(function (stream) {
                    chunks = []; rec = new MediaRecorder(stream);
                    rec.ondataavailable = function (ev) { if (ev.data.size) chunks.push(ev.data); };
                    rec.onstop = function () {
                        stream.getTracks().forEach(function (t) { t.stop(); });
                        label.textContent = btn.getAttribute('data-rec'); btn.classList.remove('btn-danger'); btn.disabled = true;
                        var fd = new FormData(); fd.append('audio', new Blob(chunks, { type: rec.mimeType || 'audio/webm' }), 'visit.webm');
                        fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }, body: fd })
                            .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                            .then(function (res) {
                                btn.disabled = false;
                                if (!res.ok) { toastr.error(res.code === 'not_available' ? W.off : res.code === 'too_long' ? W.long : W.failed); return; }
                                var d = res.draft || {};
                                put('chiefComplaint', d.chiefComplaint, false); put('history', d.history, true); put('examination', d.examination, true); put('planNote', d.plan, true);
