@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalMorgueCasePage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H90 — one body in the mortuary register: who (or the description), the certificate, where it lies and for how long,
    what still holds it (each with the step that lifts it), the belongings, and the release or the transfer.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Mortuary case"].Value;
    bool canWork = ViewBag.CanWork == true;
    var c = Model.Case; bool inside = c.Status == HospitalMorgueStatus.InStorage;
    string Who(int? id) => id is int i && Model.People.TryGetValue(i, out var n) ? n : "";
    string L(DateTime? utc) => utc == null ? "—" : HospitalNursingService.UtcToWard(utc.Value).ToString("yyyy-MM-dd HH:mm");
    bool policeOpen = c.MedicoLegal && c.PoliceClearedAt == null;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Mortuary case"] <span class="badge hp-code fs-7 hp-num ms-2">@c.CaseNo</span></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("Morgue")" class="text-muted text-hover-primary">@T["Mortuary"]</a></li></ul>
        </div>
        @if (inside && canWork)
        {
            <div class="d-flex gap-2">
                @if (Model.FreeCompartments.Count > 0) {<button type="button" class="btn btn-sm btn-light" data-move><i class="ki-outline ki-arrows-loop fs-4"></i>@T["Move"]</button>}
                <button type="button" class="btn btn-sm btn-light-primary" data-modal="relModal" data-transfer="1"><i class="ki-outline ki-delivery fs-4"></i>@T["Transfer"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-modal="relModal" data-transfer="0" @(Model.Holds.Count > 0 ? "disabled" : "")><i class="ki-outline ki-exit-right fs-4"></i>@T["Release the body"]</button>
            </div>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5">
            @* H128: the deceased's profile card (demo39 apps/user-management/users/view): photo, name, state, the figures in dashed boxes, then the details list *@
            <div class="col-xl-4"><div class="card card-flush h-100"><div class="card-body pt-10">
                <div class="d-flex flex-center flex-column mb-5">
                    <div class="symbol symbol-100px symbol-circle mb-5">@if (Model.Photo != null) {<img src="@Model.Photo" alt="" style="object-fit:cover;filter:grayscale(1)" />} else {<span class="symbol-label fs-2x fw-bold hp-initials">@(Model.NameEn == null ? "?" : HospitalUi.Initials(Model.NameEn))</span>}</div>
                    @if (c.PatientId != null) {<a href="@Url.Action("Patient", new { id = c.PatientId })" class="fs-3 text-gray-800 text-hover-primary fw-bold mb-1">@DisplayName.Of(Model.Name!, Model.NameEn ?? Model.Name!)</a><div class="fs-6 fw-semibold text-gray-500 mb-4"><bdi class="hp-num">@Model.Mrn</bdi></div>}
                    else {<div class="fs-3 text-gray-800 fw-bold mb-1">@T["Unknown"]</div><div class="fs-6 fw-semibold text-gray-500 mb-4 text-center"><bdi>@c.Description</bdi></div>}
                    <span class="badge badge-lg badge-light-@(inside ? "primary" : "secondary") mb-6">@T["mgs:" + c.Status]</span>
                    <div class="d-flex flex-wrap flex-center gap-3">
                        <div class="border border-gray-300 border-dashed rounded py-3 px-4 text-center min-w-100px">
                            <div class="fs-2 fw-bold text-gray-800 hp-num"><bdi>@Model.Compartment</bdi></div><div class="fw-semibold fs-7 text-gray-500">@T["Compartment"]</div></div>
                        <div class="border border-@(inside && Model.Hours >= HospitalMorgueRules.AlertHours ? "danger" : "gray-300") border-dashed rounded py-3 px-4 text-center min-w-100px">
                            <div class="fs-2 fw-bold hp-num text-@(inside && Model.Hours >= HospitalMorgueRules.AlertHours ? "danger" : "gray-800")">@T["{0} h", Model.Hours]</div><div class="fw-semibold fs-7 text-gray-500">@T["Kept"]</div></div>
                    </div>
                </div>
                <div class="d-flex flex-stack fs-4 py-3"><div class="fw-bold">@T["Details"]</div></div>
                <div class="separator separator-dashed"></div>
                <div class="pb-2 fs-6">
                    <div class="fw-bold mt-5">@T["Tag number"]</div><div class="text-gray-600 hp-num"><bdi>@c.TagNo</bdi></div>
                    <div class="fw-bold mt-5">@T["Received"]</div><div class="text-gray-600"><span class="hp-num">@L(c.ReceivedAt)</span> · @Who(c.ReceivedByEmployeeId)</div>
                    @if (c.BroughtFrom != null) {<div class="fw-bold mt-5">@T["Brought from"]</div><div class="text-gray-600"><bdi>@c.BroughtFrom</bdi></div>}
                    @if (Model.Death != null)
                    {
                        <div class="fw-bold mt-5">@T["Death certificate"]</div><div class="text-gray-600"><span class="badge hp-code hp-num">@Model.Death.DeathNo</span>@if (Model.Death.VoidedAt != null) {<span class="badge badge-light-danger fw-bold ms-1">@T["Voided"]</span>}</div>
                        <div class="fw-bold mt-5">@T["Died at"]</div><div class="text-gray-600 hp-num">@L(Model.Death.DiedAt)</div>
                        <div class="fw-bold mt-5">@T["Cause of death"]</div><div class="text-gray-600"><bdi>@Model.Death.ImmediateCause</bdi></div>
                    }
                    @if (!inside)
                    {
                        <div class="fw-bold mt-5">@T[c.Status == HospitalMorgueStatus.Transferred ? "Transferred to" : "Released to"]</div>
                        <div class="text-gray-800 fw-semibold"><bdi>@c.ReleasedTo</bdi>@if (c.ReleasedToRelation != null) {<text> · <bdi>@c.ReleasedToRelation</bdi></text>}</div>
                        <div class="text-gray-500 fs-7">@T["Identity"] <bdi class="hp-num">@c.ReleasedToIdNo</bdi>@if (c.ReleasedToPhone != null) {<text> · <bdi class="hp-num" dir="ltr">@c.ReleasedToPhone</bdi></text>}</div>
                        if (c.Destination != null) {<div class="text-gray-600 fs-7"><bdi>@c.Destination</bdi></div>}
                        <div class="text-gray-500 fs-7"><span class="hp-num">@L(c.ReleasedAt)</span> · @Who(c.ReleasedByEmployeeId)</div>
                    }
                    @if (c.Note != null) {<div class="fw-bold mt-5">@T["Note"]</div><div class="text-gray-600"><bdi>@c.Note</bdi></div>}
                </div>
            </div></div></div>

            <div class="col-xl-8 d-flex flex-column gap-5">
                @if (inside)
                {
                    @* H128: what still holds the body as the theme's list widget (demo39 widgets/lists): symbol · step over its detail · action *@
                    bool unidentified = Model.Holds.Contains(HospitalMorgueWarning.Unidentified) || Model.Holds.Contains(HospitalMorgueWarning.NoCertificate);
                    bool autopsyOpen = c.AutopsyStatus == HospitalAutopsyStatus.Requested;
                    <div class="card card-flush">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@(Model.Holds.Count > 0 ? T["What still holds the body"] : T["Nothing holds the body: it may be released"])</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Each hold is lifted by its own step; the release opens when none is left. A transfer (to forensic medicine, another hospital) is not held."]</span></h3>
                            <div class="card-toolbar"><span class="badge badge-light-@(Model.Holds.Count > 0 ? "danger" : "success") fs-7 fw-bold hp-num">@Model.Holds.Count</span></div></div>
                        <div class="card-body pt-4">
                            @if (c.MedicoLegal)
                            {
                                <div class="d-flex flex-stack">
                                    <div class="symbol symbol-40px me-4 flex-shrink-0"><span class="symbol-label bg-light-@(policeOpen ? "danger" : "success")"><i class="ki-outline ki-shield-tick fs-2 text-@(policeOpen ? "danger" : "success")"></i></span></div>
                                    <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                        <div class="me-3"><span class="text-gray-800 fw-bold fs-6 d-block">@T["Police clearance"]</span><span class="text-gray-500 fw-semibold fs-7 d-block">@if (c.PoliceRef != null) {<span>@T["Report"] <bdi class="hp-num">@c.PoliceRef</bdi></span>}@if (c.PoliceClearedAt != null) {<span> · @T["Cleared {0}", L(c.PoliceClearedAt)] · @Who(c.PoliceClearedByEmployeeId)</span>}</span></div>
                                        <div class="flex-shrink-0">@if (policeOpen) {if (canWork) {<button type="button" class="btn btn-sm btn-light-danger" data-police>@T["Record the clearance"]</button>} else {<span class="badge badge-light-danger fs-7 fw-bold">@T["mgw:PoliceHold"]</span>}} else {<i class="ki-outline ki-check-circle text-success fs-2"></i>}</div>
                                    </div>
                                </div>
                                <div class="separator separator-dashed my-4"></div>
                            }
                            <div class="d-flex flex-stack">
                                <div class="symbol symbol-40px me-4 flex-shrink-0"><span class="symbol-label bg-light-@(autopsyOpen ? "danger" : "primary")"><i class="ki-outline ki-flask fs-2 text-@(autopsyOpen ? "danger" : "primary")"></i></span></div>
                                <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                    <div class="me-3"><span class="text-gray-800 fw-bold fs-6 d-block">@T["Autopsy"]</span><span class="text-gray-500 fw-semibold fs-7 d-block">@T["aut:" + c.AutopsyStatus]@if (c.AutopsyNote != null) {<span> · <bdi>@c.AutopsyNote</bdi></span>}</span></div>
                                    <div class="flex-shrink-0">
                                        @if (canWork && c.AutopsyStatus == HospitalAutopsyStatus.Requested) {<button type="button" class="btn btn-sm btn-light-danger" data-autopsy="AutopsyDone">@T["Record it done"]</button>}
                                        else if (canWork && c.AutopsyStatus == HospitalAutopsyStatus.None) {<button type="button" class="btn btn-sm btn-light" data-autopsy="AutopsyRequest">@T["Request an autopsy"]</button>}
                                        else {<i class="ki-outline ki-check-circle text-success fs-2"></i>}
                                    </div>
                                </div>
                            </div>
                            <div class="separator separator-dashed my-4"></div>
                            <div class="d-flex flex-stack">
                                <div class="symbol symbol-40px me-4 flex-shrink-0"><span class="symbol-label bg-light-@(unidentified ? "danger" : "success")"><i class="ki-outline ki-profile-circle fs-2 text-@(unidentified ? "danger" : "success")"></i></span></div>
                                <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                    <div class="me-3"><span class="text-gray-800 fw-bold fs-6 d-block">@T["Identity and certificate"]</span><span class="text-gray-500 fw-semibold fs-7 d-block">@(c.PatientId == null ? T["Unknown body: released only by transfer to the authorities, or once identified and certified."] : Model.Holds.Contains(HospitalMorgueWarning.NoCertificate) ? T["The certificate is voided: certify the death again."] : T["Identified and certified"])</span></div>
                                    <div class="flex-shrink-0">@if (unidentified) {<i class="ki-outline ki-cross-circle text-danger fs-2"></i>} else {<i class="ki-outline ki-check-circle text-success fs-2"></i>}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @* H128: the belongings as the theme's table widget (demo39 widgets/tables) *@
                <div class="card card-flush flex-grow-1">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Belongings"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@Model.Belongings.Count</span></h3>
                        @if (inside && canWork) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-item><i class="ki-outline ki-plus fs-4"></i>@T["Add an item"]</button></div>}</div>
                    <div class="card-body pt-2">
                        @if (Model.Belongings.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-parcel fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Nothing was found with the body."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Item"]</th><th>@T["Quantity"]</th><th>@T["Note"]</th><th class="pe-4 rounded-end">@T["Recorded"]</th></tr></thead>
                                <tbody>
                                @foreach (var b in Model.Belongings)
                                {
                                    <tr>
                                        <td class="ps-4"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-parcel fs-3 text-primary"></i></span></div><span class="text-gray-900 fw-bold fs-6"><bdi>@b.Item</bdi></span></div></td>
                                        <td><span class="badge badge-light-primary fs-7 fw-bold hp-num">@b.Quantity</span></td>
                                        <td><span class="text-gray-600 fw-semibold fs-7"><bdi>@b.Note</bdi></span></td>
                                        <td class="pe-4"><span class="text-gray-500 fw-semibold fs-7 hp-num text-nowrap">@L(b.RecordedAt)</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                            @if (!inside) {<div class="notice d-flex bg-light-success rounded border-success border border-dashed p-4 mt-5"><i class="ki-outline ki-check-circle fs-2x text-success me-3"></i><div class="fs-6 fw-semibold text-gray-700 align-self-center">@T["Handed over with the body"]</div></div>}
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@if (inside && canWork)
{
    @* H128: the theme's form modal (demo39 utilities/modals/forms/new-target); the title and the destination label still switch between release and transfer *@
    <div class="modal fade" id="relModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3" id="relTitle">@T["Release the body"]</h1><div class="text-muted fw-semibold fs-6"><span class="hp-num">@c.CaseNo</span> · @(c.PatientId != null ? DisplayName.Of(Model.Name!, Model.NameEn ?? Model.Name!) : T["Unknown"].Value)</div></div>
            <div class="row g-6">
            <div class="col-7"><label class="required fs-6 fw-semibold mb-2">@T["Received by (full name)"]</label><input type="text" maxlength="150" class="form-control form-control-solid" data-l="releasedTo" /></div>
            <div class="col-5" data-rel-only><label class="required fs-6 fw-semibold mb-2">@T["Relation to the deceased"]</label><input type="text" maxlength="50" class="form-control form-control-solid" data-l="relation" placeholder="@T["Son, wife, brother…"]" /></div>
            <div class="col-6"><label class="required fs-6 fw-semibold mb-2">@T["Identity number"]</label><input type="text" maxlength="30" class="form-control form-control-solid" dir="ltr" data-l="idNo" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Phone"]</label><input type="text" maxlength="30" class="form-control form-control-solid" dir="ltr" data-l="phone" /></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2" id="destLabel">@T["Funeral home"]</label><input type="text" maxlength="150" class="form-control form-control-solid" data-l="destination" /></div>
            @if (Model.Belongings.Count > 0) {<div class="col-12"><label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-l="belongingsHandedOver" /><span class="form-check-label fw-semibold text-gray-700">@T["The {0} belongings were handed over and signed for", Model.Belongings.Count]</span></label></div>}
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Note"]</label><input type="text" maxlength="200" class="form-control form-control-solid" data-l="note" /></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-rel-save>@T["Confirm"]</button></div>
        </div>
    </div></div></div>
}
@section Scripts {
    <script>
        (function () {
            var tokEl = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tokEl) return; var tok = tokEl.value;
            var base = @Json.Serialize(Url.Content("~/Hospital/Morgue/" + c.ID + "/"));
            var free = @Json.Serialize(Model.FreeCompartments.Select(f => new { id = f.Id, code = f.Code }));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                      police: @Json.Serialize(T["The police report number"].Value), policeT: @Json.Serialize(T["Record the clearance"].Value),
                      autoDone: @Json.Serialize(T["Who performed the autopsy, and where is the report?"].Value), autoReq: @Json.Serialize(T["Why is an autopsy requested?"].Value),
                      item: @Json.Serialize(T["The item (and quantity, like: watch × 1)"].Value), itemT: @Json.Serialize(T["Add an item"].Value),
                      move: @Json.Serialize(T["Move to which compartment? Free:"].Value), moveT: @Json.Serialize(T["Move"].Value),
                      rel: @Json.Serialize(T["Release the body to this person?"].Value), tra: @Json.Serialize(T["Transfer the body?"].Value),
                      relT: @Json.Serialize(T["Release the body"].Value), traT: @Json.Serialize(T["Transfer"].Value), funeral: @Json.Serialize(T["Funeral home"].Value), dest: @Json.Serialize(T["Transferred to (facility)"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b) })
                .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(btn) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }; }
            var transfer = false, rm = document.getElementById('relModal');
            document.addEventListener('click', function (e) {
                var o = e.target.closest('[data-modal]');
                if (o && rm) { transfer = o.getAttribute('data-transfer') === '1'; document.getElementById('relTitle').textContent = transfer ? W.traT : W.relT;
                    document.getElementById('destLabel').textContent = transfer ? W.dest : W.funeral; document.getElementById('destLabel').classList.toggle('required', transfer);
                    rm.querySelector('[data-rel-only]').classList.toggle('d-none', transfer); bootstrap.Modal.getOrCreateInstance(rm).show(); return; }
                var p = e.target.closest('[data-police]');
                if (p) { cbPrompt(W.police, { title: W.policeT, value: @Json.Serialize(c.PoliceRef ?? "") }).then(function (v) { if (v) post(base + 'Police', { policeRef: v }).then(done(p)); }); return; }
                var a = e.target.closest('[data-autopsy]');
                if (a) { var step = a.getAttribute('data-autopsy'); cbPrompt(step === 'AutopsyDone' ? W.autoDone : W.autoReq, { textarea: true }).then(function (v) { if (v) post(base + step, { note: v }).then(done(a)); }); return; }
                var it = e.target.closest('[data-item]');
                if (it) { cbPrompt(W.item, { title: W.itemT }).then(function (v) { if (!v) return; var m = v.match(/^(.*?)\s*[×x\*]\s*(\d+)$/); post(base + 'Belonging', m ? { item: m[1], quantity: Number(m[2]) } : { item: v, quantity: 1 }).then(done(it)); }); return; }
                var mv = e.target.closest('[data-move]');
                if (mv) { cbPrompt(W.move + ' ' + free.map(function (f) { return f.code; }).join(', '), { title: W.moveT }).then(function (v) { if (!v) return;
                    var f = free.find(function (x) { return x.code.toLowerCase() === v.trim().toLowerCase(); }); post(base + 'Move', { compartmentId: f ? f.id : 0 }).then(done(mv)); }); return; }
                var s = e.target.closest('[data-rel-save]'); if (!s) return;
                var b = { transfer: transfer }; rm.querySelectorAll('[data-l]').forEach(function (i) { var k = i.getAttribute('data-l'); b[k] = i.type === 'checkbox' ? i.checked : ((i.value || '').trim() || null); });
                if (transfer) b.relation = null;
                cbConfirm(transfer ? W.tra : W.rel).then(function (ok) { if (!ok) return; s.disabled = true; post(base + 'Release', b).then(done(s)); });
            });
        })();
    </script>
}
