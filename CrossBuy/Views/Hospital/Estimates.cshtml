@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalEstimateRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — estimates & deposits: the builder as a demo39 form card with the invoice's total block (apps/invoices/view),
    the deposit as list-widget rows (dashboards/logistics), the estimates as the table widget (widgets/tables).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Estimates & deposits"].Value;
    var packages = (ViewBag.Packages as IReadOnlyList<HospitalPackageRow>) ?? Array.Empty<HospitalPackageRow>();
    var rooms = (ViewBag.RoomTypes as List<HospitalRoomType>) ?? new();
    string? cur = ViewBag.Currency as string;
    bool canBill = ViewBag.CanBill == true;
    string Money(decimal v) => v.ToString("N3", System.Globalization.CultureInfo.InvariantCulture);
    string St(string s) => s switch { HospitalEstimateStatus.Issued => "success", HospitalEstimateStatus.Cancelled => "secondary", _ => "primary" };
    string Avatar(string? photo, string nameEn) => photo != null
        ? $"<div class=\"symbol symbol-45px symbol-circle flex-shrink-0\"><img src=\"{photo}\" alt=\"\" style=\"object-fit:cover\" data-initials=\"{HospitalUi.Initials(nameEn)}\" /></div>"
        : $"<div class=\"symbol symbol-45px symbol-circle flex-shrink-0\"><span class=\"symbol-label bg-light-primary text-primary fw-bold fs-7\">{HospitalUi.Initials(nameEn)}</span></div>";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Estimates & deposits"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Estimates"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("Packages")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-package fs-4"></i>@T["Packages"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (canBill)
        {
            <div class="row g-5 g-xl-8 mb-5" data-builder>
                <div class="col-xl-8"><div class="card card-flush h-100">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Procedure estimate"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7" data-cover-line>@T["Choose the patient: the estimate is priced on their price list and split by their cover today"]</span></h3>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-calculator fs-2 text-primary"></i></span></div></div>
                    </div>
                    <div class="card-body pt-2">
                        <div class="row g-5 mb-6">
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2 required">@T["Patient"]</label><select class="form-select form-select-solid" data-e-patient data-placeholder="@T["Search by name or MRN"]"></select></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Package / procedure"]</label><select class="form-select form-select-solid" data-e-package data-control="select2" data-allow-clear="true" data-placeholder="@T["No package"]">
                                <option></option>
                                @foreach (var p in packages) { <option value="@p.Package.ID" data-room="@p.Package.RoomTypeId" data-nights="@p.Package.IncludedNights">@p.Package.Code · @DisplayName.Of(p.Package.Name, p.Package.NameEn)</option> }
                            </select></div>
                            <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Room class"]</label><select class="form-select form-select-solid" data-e-room data-control="select2" data-allow-clear="true" data-hide-search="true" data-placeholder="@T["No stay"]">
                                <option></option>
                                @foreach (var r in rooms) { <option value="@r.ID">@DisplayName.Of(r.Name, r.NameEn ?? r.Name)</option> }
                            </select></div>
                            <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Expected stay (nights)"]</label><input class="form-control form-control-solid hp-num" dir="ltr" type="number" min="0" max="365" value="0" data-e-nights /></div>
                            <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Deposit margin"]</label><div class="input-group input-group-solid"><input class="form-control form-control-solid hp-num" dir="ltr" type="number" min="0" max="200" value="20" data-e-margin /><span class="input-group-text">%</span></div></div>
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Other expected services"]</label><select class="form-select form-select-solid" multiple data-e-services data-placeholder="@T["Search by code or name"]"></select></div>
                        </div>
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Item"]</th><th class="text-end">@T["Qty"]</th><th class="text-end">@T["Estimate"]</th><th class="text-end pe-4 rounded-end">@T["Payer's share"]</th></tr></thead>
                            <tbody data-e-lines><tr><td colspan="4" class="text-center text-muted py-8">@T["Choose a package or services to see the estimate."]</td></tr></tbody>
                            <tfoot><tr class="border-top border-gray-200"><td class="ps-4" colspan="2"><span class="text-primary fw-bolder fs-5">@T["Estimated total"]</span> <span class="text-muted fs-8">@cur</span></td><td class="text-end"><span class="text-gray-900 fw-bolder fs-5 hp-num" dir="ltr" data-e-gross>—</span></td><td class="pe-4"></td></tr></tfoot>
                        </table></div>
                        <div class="text-gray-500 fw-semibold fs-7 mt-4">@T["A package has a fixed price; anything beyond its limits (extra nights, complications, a second implant) is billed outside it."]</div>
                    </div>
                </div></div>
                <div class="col-xl-4"><div class="card card-flush h-100">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Required deposit"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@cur</span></h3>
                    </div>
                    <div class="card-body pt-2 d-flex flex-column">
                        <div class="d-flex flex-stack">
                            <div class="d-flex align-items-center"><div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-shield-tick fs-3 text-primary"></i></span></div><span class="text-gray-800 fw-bold fs-6">@T["Payer share"]</span></div>
                            <span class="text-gray-800 fw-bold fs-5 hp-num" dir="ltr" data-e-payer>—</span>
                        </div>
                        <div class="separator separator-dashed my-3"></div>
                        <div class="d-flex flex-stack">
                            <div class="d-flex align-items-center"><div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-info"><i class="ki-outline ki-user fs-3 text-info"></i></span></div><span class="text-gray-800 fw-bold fs-6">@T["Expected patient share"]</span></div>
                            <span class="text-gray-800 fw-bold fs-5 hp-num" dir="ltr" data-e-patient-share>—</span>
                        </div>
                        <div class="separator separator-dashed my-3"></div>
                        <div class="d-flex flex-stack mb-6">
                            <div class="d-flex align-items-center"><div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-success"><i class="ki-outline ki-wallet fs-3 text-success"></i></span></div><span class="text-gray-900 fw-bold fs-6">@T["Deposit required"]</span></div>
                            <span class="text-primary fw-bolder fs-2 hp-num" dir="ltr" data-e-deposit>—</span>
                        </div>
                        <div class="notice d-none bg-light-primary rounded border-primary border border-dashed p-5 mb-5" data-e-preauth>
                            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                            <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                                <h4 class="text-gray-900 fw-bold mb-1">@T["Pre-authorisation needed"]</h4>
                                <div class="fs-6 text-gray-700">@T["Issuing the estimate sends the payer an approval request."]</div>
                            </div></div>
                        </div>
                        <div class="text-gray-500 fw-semibold fs-7 mb-6">@T["Collecting the deposit is done on the patient's bill; the estimate only states it."]</div>
                        <button type="button" class="btn btn-primary w-100 mt-auto" data-e-save disabled><i class="ki-outline ki-document fs-4"></i>@T["Save estimate"]</button>
                    </div>
                </div></div>
            </div>
        }

        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Estimates"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["A draft can be re-priced; an issued estimate is what the patient was told"]</span></h3>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-calculator fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No estimates yet."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Estimate"]</th><th>@T["Package / procedure"]</th><th class="text-end">@T["Estimated total"]</th><th class="text-end">@T["Deposit required"]</th><th>@T["Status"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var e = r.Estimate;
                                var url = Url.Action("Estimate", new { id = e.ID });
                                <tr>
                                    <td class="ps-4"><div class="d-flex align-items-center gap-4">@Html.Raw(Avatar(r.Photo, r.PatientNameEn))
                                        <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = e.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6"><bdi>@DisplayName.Of(r.PatientName, r.PatientNameEn)</bdi></a><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi></div></div></td>
                                    <td><a href="@url" class="text-gray-900 fw-bold text-hover-primary d-block fs-6"><bdi class="hp-num">@e.EstimateNo</bdi></a><span class="text-muted fw-semibold d-block fs-7 hp-num" dir="ltr" data-fmt data-utc="@e.CreatedAt.ToString("o")">@e.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span></td>
                                    <td><span class="text-gray-800 fw-bold d-block fs-6">@(r.Package == null ? T["Services only"].Value : DisplayName.Of(r.Package, r.PackageEn ?? r.Package))</span>
                                        <span class="text-muted fw-semibold d-block fs-7">@(r.Payer == null ? T["Self-pay"].Value : DisplayName.Of(r.Payer, r.PayerEn ?? r.Payer))</span></td>
                                    <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num" dir="ltr">@Money(e.Gross)</span></td>
                                    <td class="text-end"><span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@Money(e.Deposit)</span></td>
                                    <td><span class="badge badge-light-@St(e.Status) fs-7 fw-bold">@T["est:" + e.Status]</span></td>
                                    <td class="text-end pe-4"><a href="@url" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Open"]" data-bs-toggle="tooltip"><i class="ki-outline ki-eye fs-3"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var isAr = document.documentElement.dir === 'rtl';
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), outside: @Json.Serialize(T["Not covered"].Value),
                self: @Json.Serialize(T["Self-pay"].Value), uncovered: @Json.Serialize(T["Not covered: {0} — self-pay"].Value), empty: @Json.Serialize(T["Choose a package or services to see the estimate."].Value),
                save: @Json.Serialize(T["Save this estimate as a draft for {0}? It can be re-priced until it is issued."].Value) };
            var urls = { root: @Json.Serialize(Url.Action("Estimates")), patients: @Json.Serialize(Url.Action("SearchInsurancePatients")), services: @Json.Serialize(Url.Action("SearchServices")), one: @Json.Serialize(Url.Action("Estimate", new { id = 0 })) };
            var root = document.querySelector('[data-builder]'); if (!root) return;
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function money(v) { return Number(v).toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 }); }
            function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            var el = function (s) { return root.querySelector(s); };
            var patient = el('[data-e-patient]'), pkg = el('[data-e-package]'), room = el('[data-e-room]'), nights = el('[data-e-nights]'), margin = el('[data-e-margin]'), svcs = el('[data-e-services]'), save = el('[data-e-save]');
            function picker(s, url, multi) {
                $(s).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', placeholder: s.getAttribute('data-placeholder'), multiple: !!multi,
                    ajax: { url: url, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
            }
            if (window.$ && $.fn.select2) { picker(patient, urls.patients); picker(svcs, urls.services, true); }
            function input() {
                return { patientId: Number(patient.value || 0), packageId: pkg.value ? Number(pkg.value) : null, roomTypeId: room.value ? Number(room.value) : null,
                    expectedNights: Number(nights.value || 0), marginPct: Number(margin.value || 0),
                    services: ($(svcs).val() || []).map(function (id) { return { serviceId: Number(id), quantity: 1 }; }) };
            }
            var last = null, seq = 0;
            // Re-priced on every change, never stored: the server prices it as the patient's bill would be.
            function quote() {
                var body = input(); last = null; save.disabled = true;
                if (!body.patientId || (!body.packageId && body.services.length === 0)) { el('[data-e-lines]').innerHTML = '<tr><td colspan="4" class="text-center text-muted py-8">' + esc(W.empty) + '</td></tr>'; return; }
                var mine = ++seq;
                post(urls.root + '/Quote', body).then(function (q) {
                    if (mine !== seq) return;   // a newer change is being priced
                    if (!q.ok) { toast('error', q.error || W.failed); return; }
                    last = body; save.disabled = false;
                    el('[data-e-lines]').innerHTML = q.lines.map(function (l) {
                        return '<tr><td class="ps-4"><span class="text-gray-900 fw-bold fs-6 d-block">' + esc(l.text) + '</span><span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num">' + esc(l.code) + '</bdi>' + (l.covered || !q.payer ? '' : ' · <span class="badge badge-light-danger fs-8 fw-bold">' + esc(W.outside) + '</span>') + '</span></td>' +
                            '<td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">' + esc(l.qty) + '</span></td><td class="text-end"><span class="text-gray-900 fw-bold hp-num" dir="ltr">' + money(l.amount) + '</span></td><td class="text-end pe-4"><span class="text-gray-800 fw-bold hp-num" dir="ltr">' + (l.payer > 0 ? money(l.payer) : '—') + '</span></td></tr>';
                    }).join('');
                    el('[data-e-gross]').textContent = money(q.gross);
                    el('[data-e-payer]').textContent = money(q.payerShare);
                    el('[data-e-patient-share]').textContent = money(q.patientShare);
                    el('[data-e-deposit]').textContent = money(q.deposit);
                    el('[data-cover-line]').textContent = q.payer ? q.payer + ' · ' + q.policyNo : q.uncovered ? W.uncovered.replace('{0}', q.uncovered) : W.self;
                    el('[data-e-preauth]').classList.toggle('d-none', !q.needsPreauth);
                });
            }
            // A package brings its room class and nights; they stay editable.
            $(pkg).on('change', function () {
                var o = pkg.options[pkg.selectedIndex];
                if (o && o.value) { if (o.getAttribute('data-room')) $(room).val(o.getAttribute('data-room')).trigger('change.select2'); nights.value = o.getAttribute('data-nights') || 0; }
                quote();
            });
            [patient, room, svcs].forEach(function (s) { $(s).on('change', quote); });
            [nights, margin].forEach(function (i) { i.addEventListener('change', quote); });
            save.addEventListener('click', function () {
                if (!last) return;
                var who = $(patient).find('option:selected').text();
                cbConfirm(W.save.replace('{0}', who)).then(function (ok) {
                    if (!ok) return;
                    save.disabled = true;
                    post(urls.root + '/Draft', last).then(function (r) {
                        save.disabled = false;
                        if (!r.ok) { toast('error', r.error || W.failed); return; }
                        toast('success', W.saved); location.href = urls.one.replace(/0$/, r.id);
                    });
                });
            });
        })();
    </script>
}
