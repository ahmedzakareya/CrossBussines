@using CrossBuy.BL
@using CrossBuy.BL.Reporting
@model IReadOnlyList<HospitalManagementReport>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H49 — the hospital's reports, as the approved prototype draws them (#/reports): "every report and printout runs
    through Report Studio", then the four groups, each report with its Open. Open = /Reports/Viewer with the dataset
    run; the layouts, exports, schedules and archive are the Studio's. A financial report the reader may not open
    says whose it is instead of offering a button the viewer would refuse.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Hospital reports"].Value;
    bool finance = ViewBag.Finance == true;
    var groups = new[]
    {
        (Key: HospitalReportGroups.Clinical, Title: T["Clinical"].Value, Icon: "ki-heart"),
        (Key: HospitalReportGroups.Operational, Title: T["Operational"].Value, Icon: "ki-graph-3"),
        (Key: HospitalReportGroups.Financial, Title: T["Financial"].Value, Icon: "ki-dollar"),
        (Key: HospitalReportGroups.Insurance, Title: T["Insurance"].Value, Icon: "ki-shield-tick"),
    };
    bool ar = DisplayName.IsArabic;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Hospital reports"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["hr:crumb"]</li></ul>
        </div>
        <div class="d-flex align-items-center gap-2 d-print-none">
            <a href="@Url.Action("Studio", "Reports")" class="btn btn-sm btn-light"><i class="ki-outline ki-design-1 fs-4"></i>@T["Report Studio"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="notice d-flex rounded border border-primary border-dashed bg-light-primary p-6 mb-5">
            <i class="ki-outline ki-chart-pie-simple fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="mb-3 mb-md-0 fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Every report and printout runs through Report Studio"]</h4>
                    <div class="fs-6 text-gray-700">@T["Each report is a registered dataset with its own permission; printouts are designed in the same place."]</div>
                </div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0"><bdi class="hp-num" dir="ltr">@Model.Count</bdi>&nbsp;@T["hr:count"]</span>
            </div>
        </div>

        <div class="row g-5 g-xl-8">
            @foreach (var g in groups)
            {
                bool money = g.Key is HospitalReportGroups.Financial or HospitalReportGroups.Insurance;
                <div class="col-xl-6">
                    <div class="card mb-5 h-xl-100">
                        <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@g.Title</span></div></div>
                        <div class="card-body pt-2">
                            @foreach (var r in Model.Where(x => x.Group == g.Key))
                            {
                                var d = r.Dataset;
                                <div class="d-flex align-items-center py-3 border-bottom border-gray-200 border-bottom-dashed" data-hr-report="@d.DatasetCode">
                                    <span class="symbol symbol-40px me-4 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline @g.Icon fs-3 text-primary"></i></span></span>
                                    <div class="min-w-0 pe-3" style="flex:1 1 0">
                                        <div class="fw-semibold text-gray-800">@(ar ? d.TitleAr : d.TitleEn)</div>
                                        <div class="text-muted fs-8 hp-clamp2" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;white-space:normal" title="@(ar ? d.DescriptionAr : d.DescriptionEn)">@(ar ? d.DescriptionAr : d.DescriptionEn)</div>
                                    </div>
                                    @if (!money || finance)
                                    {
                                        <a href="@Url.Action("Viewer", "Reports", new { id = d.DatasetCode, run = true })" class="btn btn-sm btn-light-primary flex-shrink-0">@T["Open"]</a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light fs-8 flex-shrink-0">@T["Billing desk only"]</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div></div>
</div>
