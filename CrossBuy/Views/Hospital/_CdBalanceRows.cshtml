@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalCdBalance>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H137: one controlled drug per row. Each row shows:
     · the formulary's name (Tall Man) over the brand and code, and the schedule;
     · what the store holds;
     · how the last count ended;
     · the blind count and the drug's ledger. *@
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    bool canEdit = ViewBag.CanPharmacy == true; int storeId = (int)ViewBag.StoreId;
}
@foreach (var r in Model)
{
    string tone = r.OpenDiscrepancy ? "danger" : "dark";
    string name = HospitalDrugRules.Shown(r.Drug) ?? DisplayName.Of(r.Name, r.NameEn);
    <tr>
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-45px me-4 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-lock-2 fs-2 text-@tone"></i></span></div>
            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi dir="auto">@name</bdi>@if (r.Drug?.ControlledSchedule != null) {<span class="badge badge-light-dark fs-8 fw-bold ms-2">@T["sched:" + r.Drug.ControlledSchedule]</span>}</span>
                <span class="text-muted fw-semibold fs-7"><bdi>@DisplayName.Of(r.Name, r.NameEn)</bdi> · <bdi dir="ltr">@r.Code</bdi></span></div>
        </div></td>
        <td class="text-end"><span class="text-gray-900 fw-bold fs-3 hp-num">@r.OnHand.ToString("0.###", inv)</span></td>
        <td>@if (r.LastCount is { } c)
            {
                string ct = c.Status == HospitalCountStatus.Open ? "danger" : "primary";
                <span class="badge badge-light-@ct fs-7 fw-bold">@T["cds:" + c.Status]</span>
                @if (r.Overdue) {<span class="badge badge-danger fs-8 fw-bold ms-1">@T["Overdue"]</span>}
                <span class="text-muted fs-8 d-block mt-1 hp-num" data-fmt data-utc="@c.CountedAt.ToString("o")">@c.CountedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            }
            else {<span class="badge badge-light fs-7">@T["Never counted"]</span>}</td>
        <td class="text-end pe-4 text-nowrap">
            @if (canEdit)
            {
                var row = System.Text.Json.JsonSerializer.Serialize(new { itemId = r.ItemId, title = name + " · " + r.Code });
                <button type="button" class="btn btn-sm btn-light-primary me-1" data-count data-row="@row"><i class="ki-outline ki-eye-slash fs-5"></i>@T["Blind count"]</button>
            }
            <a href="@Url.Action("ControlledRegister", "Hospital", new { store = storeId, tab = "ledger", item = r.ItemId })" class="btn btn-sm btn-icon btn-light btn-active-light-primary" title="@T["Ledger"]" data-bs-toggle="tooltip"><i class="ki-outline ki-row-vertical fs-4"></i></a>
        </td>
    </tr>
}
