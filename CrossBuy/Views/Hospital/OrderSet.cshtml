@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalOrderSetView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H74 — one order set's lines: the medicines (as the order screen takes them) and the nursing tasks (in both languages,
    due so many hours after placing), each ticked or not when the set is opened. The administrator adds, edits and
    removes lines; every write asks first.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var s = Model.Set;
    ViewData["Title"] = DisplayName.Of(s.Name, s.NameEn);
    bool canManage = ViewBag.CanManage == true;
    var catalog = (ViewBag.Catalog as IReadOnlyList<HospitalDiagnosticChoice>) ?? Array.Empty<HospitalDiagnosticChoice>();
    var svc = catalog.ToDictionary(c => c.ServiceId);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0"><span class="badge hp-code fs-7 me-2">@s.Code</span>@DisplayName.Of(s.Name, s.NameEn)</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("OrderSets")" class="text-muted text-hover-primary">@T["Order sets"]</a></li></ul>
        </div>
        @if (canManage)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-light-primary" data-new-line="Med"><i class="ki-outline ki-capsule fs-4"></i>@T["Add a medicine"]</button>
                <button type="button" class="btn btn-sm btn-light-primary" data-new-line="Task"><i class="ki-outline ki-notepad fs-4"></i>@T["Add a nursing task"]</button>
                <button type="button" class="btn btn-sm btn-light-primary" data-new-line="Lab"><i class="ki-outline ki-flask fs-4"></i>@T["Add a lab test"]</button>
                <button type="button" class="btn btn-sm btn-light-primary" data-new-line="Rad"><i class="ki-outline ki-scan-barcode fs-4"></i>@T["Add an imaging exam"]</button>
            </div>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!s.IsActive) { <div class="notice d-flex rounded border border-dashed p-5 mb-5 hp-notice"><div class="fs-7 text-gray-700">@T["This set is not in use: it is not offered on the nursing station."]</div></div> }
        <div class="card">
            <div class="card-body">
                @if (Model.Items.Count == 0) { <div class="text-muted fs-7 py-6 text-center">@T["No lines yet."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-8 text-uppercase gs-0"><th class="w-50px">#</th><th>@T["Kind"]</th><th class="min-w-250px">@T["Line"]</th><th>@T["Note"]</th><th>@T["Ticked"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var i in Model.Items)
                        {
                            bool med = i.Kind == HospitalOrderSetItemKind.Medication, diag = i.Kind is HospitalOrderSetItemKind.Lab or HospitalOrderSetItemKind.Imaging;
                            string icon = med ? "ki-capsule text-primary" : i.Kind == HospitalOrderSetItemKind.Lab ? "ki-flask text-primary" : i.Kind == HospitalOrderSetItemKind.Imaging ? "ki-scan-barcode text-info" : "ki-notepad text-success";
                            string tint = med || i.Kind == HospitalOrderSetItemKind.Lab ? "bg-light-primary" : i.Kind == HospitalOrderSetItemKind.Imaging ? "bg-light-info" : "bg-light-success";
                            string kindText = med ? T["Medicine"].Value : i.Kind == HospitalOrderSetItemKind.Lab ? T["Lab test"].Value : i.Kind == HospitalOrderSetItemKind.Imaging ? T["Imaging exam"].Value : T["Nursing task"].Value;
                            <tr>
                                <td class="hp-num text-muted">@i.SortOrder</td>
                                <td><div class="d-flex align-items-center gap-2"><span class="symbol symbol-30px"><span class="symbol-label @tint"><i class="ki-outline @icon fs-4"></i></span></span>
                                    <span class="fw-semibold text-nowrap">@kindText</span></div></td>
                                <td>@if (med)
                                    {
                                        <div class="d-flex flex-wrap gap-2"><bdi class="fw-bold text-gray-900">@i.Drug</bdi><bdi>@i.Dose</bdi><span class="badge badge-light">@T["route:" + i.Route]</span>
                                            @if (i.AsNeeded) {<span class="badge badge-light-primary">PRN</span>} else {<bdi class="hp-num text-gray-700">@i.Hours</bdi>}</div>
                                    }
                                    else if (diag)
                                    {
                                        var c = i.ServiceId is int sid && svc.TryGetValue(sid, out var cc) ? cc : null;
                                        <div class="d-flex flex-wrap gap-2"><span class="badge badge-light hp-num">@(c?.Code ?? "—")</span><bdi class="fw-bold text-gray-900">@(c == null ? "—" : DisplayName.Of(c.Name, c.NameEn))</bdi></div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-gray-900" dir="auto">@DisplayName.Of(i.TitleAr ?? i.TitleEn ?? "", i.TitleEn ?? i.TitleAr ?? "")</div>
                                        <div class="text-muted fs-8">@string.Format(T["Due {0} hours after placing"].Value, i.DueInHours)</div>
                                    }</td>
                                <td class="fs-8 text-gray-700" dir="auto">@i.Note</td>
                                <td>@if (i.Preselected) {<i class="ki-outline ki-check-square fs-3 text-success"></i>} else {<i class="ki-outline ki-minus-square fs-3 text-gray-400"></i>}</td>
                                <td class="text-end">@if (canManage)
                                    {
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-light-primary" data-edit-line="@i.ID" data-row="@System.Text.Json.JsonSerializer.Serialize(new { kind = i.Kind, serviceId = i.ServiceId, drug = i.Drug, dose = i.Dose, route = i.Route, hours = i.Hours, asNeeded = i.AsNeeded, note = i.Note, titleAr = i.TitleAr, titleEn = i.TitleEn, dueInHours = i.DueInHours, preselected = i.Preselected, sortOrder = i.SortOrder })">@T["Edit"]</button>
                                            <button type="button" class="btn btn-sm btn-icon btn-light-danger" title="@T["Remove"]" data-remove-line="@i.ID"><i class="ki-outline ki-trash fs-4"></i></button>
                                        </div>
                                    }</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@if (canManage)
{
    <div class="modal fade" id="lineModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0" data-line-title></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-8" data-for="Med"><label class="form-label required">@T["Drug"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="200" data-l="drug" /></div>
            <div class="col-4" data-for="Med"><label class="form-label required">@T["Dose"]</label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="60" data-l="dose" placeholder="1 g" /></div>
            <div class="col-4" data-for="Med"><label class="form-label required">@T["Route"]</label><select class="form-select form-select-solid" data-l="route">@foreach (var r in HospitalMedRoute.All) { <option value="@r">@T["route:" + r]</option> }</select></div>
            <div class="col-5" data-for="Med"><label class="form-label">@T["Hours"] <span class="text-muted fs-8">06,14,22</span></label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="60" data-l="hours" /></div>
            <div class="col-3 d-flex align-items-end" data-for="Med"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-l="asNeeded" /><span class="form-check-label">PRN</span></label></div>
            <div class="col-12" data-for="Lab"><label class="form-label required">@T["Lab test"]</label><select class="form-select form-select-solid" data-l="serviceId" data-kind-svc="Lab">@foreach (var c in catalog.Where(x => x.Kind == HospitalInpatientOrderKind.Lab)) { <option value="@c.ServiceId">@c.Code — @DisplayName.Of(c.Name, c.NameEn)</option> }</select></div>
            <div class="col-12" data-for="Rad"><label class="form-label required">@T["Imaging exam"]</label><select class="form-select form-select-solid" data-l="serviceId" data-kind-svc="Rad">@foreach (var c in catalog.Where(x => x.Kind == HospitalInpatientOrderKind.Imaging)) { <option value="@c.ServiceId">@c.Code — @DisplayName.Of(c.Name, c.NameEn)</option> }</select></div>
            <div class="col-12" data-for="Task"><label class="form-label">@T["Task (Arabic)"]</label><input class="form-control form-control-solid" dir="rtl" maxlength="90" data-l="titleAr" /></div>
            <div class="col-12" data-for="Task"><label class="form-label">@T["Task (English)"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="90" data-l="titleEn" /></div>
            <div class="col-6" data-for="Task"><label class="form-label required">@T["Due after (hours)"]</label><input type="number" min="0" max="72" class="form-control form-control-solid hp-num" data-l="dueInHours" value="0" /></div>
            <div class="col-12"><label class="form-label">@T["Note"]</label><input class="form-control form-control-solid" dir="auto" maxlength="300" data-l="note" /></div>
            <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-l="preselected" checked /><span class="form-check-label">@T["Ticked when the set is opened"]</span></label></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-line-save>@T["Save"]</button></div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var mEl = document.getElementById('lineModal'); if (!mEl) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, setId = @s.ID, editing = null, kind = 'Med';
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), ask: @Json.Serialize(T["Save this line?"].Value),
                remove: @Json.Serialize(T["Remove this line from the set?"].Value), med: @Json.Serialize(T["Medicine"].Value), task: @Json.Serialize(T["Nursing task"].Value),
                lab: @Json.Serialize(T["Lab test"].Value), rad: @Json.Serialize(T["Imaging exam"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function swap() { fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content'); if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML; }); }
            function open(k, data) {
                kind = k; mEl.querySelector('[data-line-title]').textContent = k === 'Med' ? W.med : k === 'Lab' ? W.lab : k === 'Rad' ? W.rad : W.task;
                mEl.querySelectorAll('[data-for]').forEach(function (el) { el.classList.toggle('d-none', el.getAttribute('data-for') !== k); });
                mEl.querySelectorAll('[data-l]').forEach(function (i) { var n = i.getAttribute('data-l'), v = data ? data[n] : null;
                    if (i.type === 'checkbox') i.checked = data ? !!v : n === 'preselected'; else if (i.tagName === 'SELECT') i.value = v || i.options[0].value; else i.value = v == null ? (n === 'dueInHours' ? 0 : '') : v; });
                bootstrap.Modal.getOrCreateInstance(mEl).show();
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-new-line],[data-edit-line],[data-remove-line],[data-line-save]'); if (!t) return;
                if (t.hasAttribute('data-new-line')) { editing = null; open(t.getAttribute('data-new-line'), null); return; }
                if (t.hasAttribute('data-edit-line')) { editing = Number(t.getAttribute('data-edit-line')); var d = JSON.parse(t.getAttribute('data-row')); open(d.kind, d); return; }
                if (t.hasAttribute('data-remove-line')) {
                    cbConfirm(W.remove, { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Content("~/Hospital/OrderSets/Items/")) + t.getAttribute('data-remove-line') + '/Remove').then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); swap(); }); });
                    return;
                }
                var body = { id: editing, setId: setId, kind: kind };
                mEl.querySelectorAll('[data-l]').forEach(function (i) { var n = i.getAttribute('data-l'); if (i.hasAttribute('data-kind-svc')) return; body[n] = i.type === 'checkbox' ? i.checked : i.type === 'number' ? (i.value === '' ? null : Number(i.value)) : (i.value.trim() || null); });
                var svcSel = mEl.querySelector('[data-kind-svc="' + kind + '"]'); body.serviceId = svcSel && svcSel.value ? Number(svcSel.value) : null;
                cbConfirm(W.ask).then(function (ok) { if (!ok) return; t.disabled = true;
                    post(@Json.Serialize(Url.Action("SaveOrderSetItem")), body).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                        toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(mEl).hide(); swap(); }); });
            });
        })();
    </script>
}
