@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalPregnancyRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@foreach (var r in Model)
{
    var p = r.Pregnancy;
    <tr>
        <td><a href="@Url.Action("Pregnancy", new { id = p.ID })" class="fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(r.Name, r.NameEn)</a>
            <div class="text-muted fs-8"><span class="badge hp-code fs-9 hp-num me-1">@p.PregnancyNo</span><bdi class="hp-num">@r.Mrn</bdi> · <span class="hp-num" dir="ltr">G@(p.Gravida) P@(p.Para) A@(p.Abortions)</span></div></td>
        <td><span class="fw-bold hp-num @(r.GaDays >= 37 * 7 ? "text-success" : "text-gray-800")" dir="ltr">@HospitalAntenatalRules.Ga(Math.Max(0, r.GaDays))</span><div class="text-muted fs-9">@T["Trimester {0}", HospitalAntenatalRules.Trimester(r.GaDays)]</div></td>
        <td class="hp-num text-nowrap">@r.Edd.ToString("yyyy-MM-dd")</td>
        <td class="fs-8">@if (r.LastVisit == null) {<span class="text-muted">@T["No visit yet"]</span>} else {<span class="hp-num">@r.LastVisit.VisitDate.ToString("yyyy-MM-dd")</span>
                @if (r.LastVisit.NextVisitOn is DateTime n) {<div class="@(r.VisitMissed ? "text-danger fw-bold" : "text-muted")">@T["Next"]: <span class="hp-num">@n.ToString("yyyy-MM-dd")</span>@if (r.VisitMissed) {<text> · @T["Visit missed"]</text>}</div>}}</td>
        <td>@if (r.Warnings.Count == 0) {<span class="text-muted fs-8">—</span>} else {<div class="d-flex flex-wrap gap-1">@foreach (var w in r.Warnings) {<span class="badge badge-light-danger fs-9">@T["anw:" + w]</span>}</div>}</td>
        <td class="text-end"><a href="@Url.Action("Pregnancy", new { id = p.ID })" class="btn btn-sm btn-light-primary text-nowrap">@T["Open"]</a></td>
    </tr>
}
