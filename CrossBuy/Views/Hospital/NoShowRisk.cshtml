@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalNoShowPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H263 — the coming week's booked appointments by no-show risk (points the desk can read), with the confirmation
    call recorded in place (H141), and the model's validation on the hospital's own past year. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["No-show risk"].Value;
    string band = ViewBag.Band as string ?? "", q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p, string? b = null) => Url.Action("NoShowRisk", new { band = b ?? band, q, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var v = Model.Validation;
    string BandClass(string b) => b == "High" ? "danger" : b == "Medium" ? "info" : "primary";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["No-show risk"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("FrontDesk")" class="text-muted text-hover-primary">@T["Front desk"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["No-show risk"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 mb-5">
            <div class="col-md-4"><a href="@Link(1, "High")" class="card card-flush h-100 @(band == "High" ? "border border-primary" : "") text-hover-primary"><div class="card-body py-6">
                <span class="fs-2hx fw-bold hp-num @(Model.High > 0 ? "text-danger" : "text-gray-900")">@Model.High</span><div class="text-gray-600 fw-semibold fs-6">@T["High-risk appointments this week"]</div></div></a></div>
            <div class="col-md-8"><div class="card card-flush h-100"><div class="card-body py-6">
                <div class="d-flex flex-wrap align-items-center gap-6">
                    <div><div class="text-muted fs-8">@T["Validated on the last 12 months"]</div><div class="fw-bold fs-6"><span class="hp-num">@v.Cases</span> @T["appointments on record"] · <span class="hp-num">@v.Events</span> @T["of them missed"]</div></div>
                    <div><div class="text-muted fs-8">AUC</div><div class="fw-bold fs-3 hp-num">@(v.Auc?.ToString("0.00", inv) ?? "—")</div></div>
                    @foreach (var b in v.Bands) {<div><div class="text-muted fs-8">@T["nsb:" + b.Band]</div><div class="fw-bold fs-6 hp-num">@(b.Cases == 0 ? "—" : (100m * b.Events / b.Cases).ToString("0", inv) + "%") <span class="text-muted fs-8">(@b.Cases)</span></div></div>}
                </div>
                @if (!v.Reliable) {<div class="text-muted fs-8 mt-3"><i class="ki-outline ki-information-5 fs-6 me-1"></i>@T["Fewer than {0} no-shows on record: the validation is not reliable yet; the points follow published risk factors.", HospitalNoShowRules.ReliableEvents]</div>}
            </div></div></div>
        </div>
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Booked for the next 7 days"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Highest risk first: call them to confirm"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("NoShowRisk")">
                    <select name="band" class="form-select form-select-sm form-select-solid w-150px" onchange="this.form.submit()">
                        <option value="">@T["All"]</option>
                        @foreach (var b in HospitalNoShowRules.Bands) {<option value="@b" selected="@(band == b)">@T["nsb:" + b]</option>}
                    </select>
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search a patient, MRN or phone"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Rows.Count == 0)
                {
                    <div class="text-center py-15"><i class="ki-outline ki-calendar-tick fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No appointment here."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th class="min-w-150px">@T["Appointment"]</th><th>@T["Risk"]</th><th class="min-w-200px">@T["Why"]</th><th class="text-end min-w-200px">@T["Confirmation call"]</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var dn = r.Doctor == null ? "—" : DisplayName.Of(r.Doctor.Name ?? "", r.Doctor.NameEn ?? r.Doctor.Name ?? "");
                            <tr>
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Photo, DisplayName.Of(r.PatientName, r.PatientNameEn), 35)<div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = r.Appointment.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><span class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn @(r.Phone != null ? "· " + r.Phone : "")</span></div></div></td>
                                <td><div class="fw-bold fs-7 text-gray-800 hp-num" dir="ltr">@r.Appointment.AppointmentDate.ToString("dd/MM", inv) @HospitalUi.Clock(r.Appointment.StartMinute)</div><div class="d-flex align-items-center gap-1 mt-1">@HospitalUi.Avatar(r.Doctor?.Photo, dn, 20)<span class="text-muted fs-8">@dn</span></div></td>
                                <td><span class="badge badge-light-@BandClass(r.Band) fs-7">@T["nsb:" + r.Band] · <span class="hp-num">@r.Score</span></span></td>
                                <td><div class="d-flex flex-wrap gap-1">@foreach (var why in r.Reasons) {<span class="badge badge-light fs-8">@T[why]</span>}</div></td>
                                <td class="text-end text-nowrap">
                                    @if (r.Confirmation != null) {<span class="badge badge-light-primary fs-8 me-2">@T["confirm:" + r.Confirmation]</span>}
                                    <button type="button" class="btn btn-sm btn-light-primary" data-ns-conf="@r.Appointment.ID" data-st="Confirmed">@T["Confirmed"]</button>
                                    <button type="button" class="btn btn-sm btn-light" data-ns-conf="@r.Appointment.ID" data-st="NoAnswer">@T["No answer"]</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/FrontDesk/Appointments/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value) };
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-ns-conf]'); if (!t) return;
                t.disabled = true;
                fetch(root + t.getAttribute('data-ns-conf') + '/Confirm', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ status: t.getAttribute('data-st') }) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
            });
        })();
    </script>
}
