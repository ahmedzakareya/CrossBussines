@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDeskStats
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H139/H140: the front desk, one workspace, laid out as the owner approved it in the prototype
    (design-output/hospital-prototype #/frontdesk):
      · the desk strip (bg-light-primary card): who sits here, the shift, the cash in the drawer, the last number called, the clock;
      · the one search with kind chips and the ID-card reader (a reader types into the box like a keyboard);
      · eight demo39 stat tiles;
      · the clinics right now: one dashed card per doctor working today;
      · today's board (stage pills, select2 filters, cbServerList, flags on each row) or its time grid, and beside it
        the patient at the counter;
      · the desk's work (tabs) and the drawer (my shift).
    One modal (#desk_modal) carries the walk-in slots and the payment window; its selects are set up after each load.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Front desk"].Value;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var inbox = (HospitalDeskInbox)ViewBag.Inbox;
    var counts = (Dictionary<string, int>)ViewBag.StageCounts;
    var departments = (IReadOnlyList<HospitalDepartment>)ViewBag.Departments;
    var doctors = (IReadOnlyList<HospitalPractitionerView>)ViewBag.Doctors;
    var clinics = (IReadOnlyList<HospitalDeskClinic>)ViewBag.Clinics;
    var me = (HospitalDeskMe)ViewBag.Me;
    var next = ViewBag.Next as HospitalDeskRow;
    var nowLocal = (DateTime)ViewBag.NowLocal;
    bool canBook = ViewBag.CanBook == true, canBill = ViewBag.CanBill == true;
    int dp = ViewBag.MoneyDp is int d0 ? d0 : 2; string cur = ViewBag.Currency as string ?? "";
    string Money(decimal v) => v.ToString("N" + dp, inv);
    string Mins(int? m) => m == null ? "—" : m < 60 ? string.Format(T["{0} min"].Value, m) : string.Format(T["{0} h {1} min"].Value, m / 60, m % 60);
    string Time(int minute) => (minute / 60).ToString("00") + ":" + (minute % 60).ToString("00");
    int Pct(int a, int b) => b == 0 ? 0 : (int)Math.Round(100m * a / b);
    decimal collected = me.CollectedToday.Values.Sum();
    var tiles = new (string Label, string N, string Note, string Icon, string Tone, string? Stage)[] {
        (T["Booked today"].Value, Model.Expected.ToString(), string.Format(T["{0} walk-ins"].Value, Model.WalkIns), "ki-calendar-tick", "primary", ""),
        (T["Arrived"].Value, Model.Arrived.ToString(), string.Format(T["{0}% of the day"].Value, Pct(Model.Arrived, Model.Expected)), "ki-entrance-left", "primary", null),
        (T["Waiting now"].Value, Model.WaitingNow.ToString(), Model.MaxWaitMinutes is int mx && Model.WaitingNow > 0 ? string.Format(T["the longest {0}"].Value, Mins(mx)) : T["nobody waiting"].Value, "ki-timer", Model.WaitingNow > 0 ? "danger" : "primary", HospitalDeskStage.Waiting),
        (T["With the doctor"].Value, Model.WithDoctor.ToString(), T["Average wait"].Value + " " + Mins(Model.AvgWaitMinutes), "ki-pulse", "primary", HospitalDeskStage.WithDoctor),
        (T["No-shows"].Value, Model.NoShow.ToString(), string.Format(T["{0}% of the day"].Value, Pct(Model.NoShow, Model.Expected)), "ki-cross-circle", Model.NoShow > 0 ? "danger" : "primary", HospitalDeskStage.NoShow),
        (T["Late"].Value, Model.Late.ToString(), T["15 minutes past their time"].Value, "ki-time", Model.Late > 0 ? "danger" : "primary", HospitalDeskStage.Expected),
        (T["Collected today"].Value, Money(collected), cur + " · " + string.Format(T["{0} receipts"].Value, me.ReceiptsToday), "ki-wallet", "primary", null),
        (T["Insurance to verify"].Value, Model.ToVerify.ToString(), T["before the doctor"].Value, "ki-shield-search", Model.ToVerify > 0 ? "danger" : "primary", null) };
    var stages = new[] { (Key: "", Label: T["All"].Value) }.Concat(HospitalDeskStage.All.Select(s => (Key: s, Label: T["desk:" + s].Value))).ToList();
    int unconfirmed = ViewBag.Unconfirmed is int uc ? uc : 0;
    var (hoOpen, hoOverdue) = ViewBag.Handoffs is ValueTuple<int, int> ho ? ho : (0, 0);   // H158
    var work = new (string Key, string Label, int N, string Tone, string Text)[] {
        ("handoff", T["On the way"].Value, hoOpen, hoOverdue > 0 ? "danger" : "primary", T["People the desk sent on: each must be taken by the receiving team; one not taken in time is chased."].Value),
        ("confirm", T["Confirm tomorrow"].Value, unconfirmed, "primary", T["Tomorrow's appointments: call those who have not confirmed."].Value),
        ("portal", T["Portal requests"].Value, inbox.PortalRequests, "primary", T["Booking requests patients sent from the portal, waiting for a slot."].Value),
        ("waitlist", T["Waitlist"].Value, inbox.WaitlistOffers, "primary", T["Freed slots offered to patients waiting for an earlier one."].Value),
        ("intake", T["Self-intake"].Value, inbox.Intake, "primary", T["Forms patients filled on the tablet, to review and link to a file."].Value),
        ("preauth", T["Insurance to verify"].Value, inbox.Preauths, "primary", T["Pre-authorisations waiting for the insurer's answer."].Value),
        ("unidentified", T["Incomplete registration"].Value, inbox.Unidentified, "danger", T["Patients registered without an identity, to identify and complete."].Value),
        ("dup", T["Duplicates"].Value, inbox.Duplicates, "danger", T["Files that look like the same person, to review and merge."].Value) };
    var shift = me.Shift;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Front desk"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Patients & front desk"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Front desk"]</li>
            </ul>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-danger" data-desk-arrival=""><i class="ki-outline ki-heart-circle fs-4"></i>@T["Urgent help"]</button>
            <a href="@Url.Action("Emergency")" class="btn btn-sm btn-light-danger"><i class="ki-outline ki-truck fs-4"></i>@T["Emergency arrival"]</a>
            <a href="@Url.Action("Unidentified")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-question-2 fs-4"></i>@T["Unidentified patient"]</a>
            <button type="button" class="btn btn-sm btn-primary" data-desk-register><i class="ki-outline ki-user-tick fs-4"></i>@T["Register a patient"]</button>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        @* ---------------- the desk strip ---------------- *@
        <div class="card mb-5 bg-light-primary border-0"><div class="card-body py-4 d-flex flex-wrap align-items-center gap-6">
            <div class="d-flex align-items-center">
                <div class="symbol symbol-45px symbol-circle flex-shrink-0">@if (me.Photo != null) {<img src="@me.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(me.Name)</span>}</div>
                <div class="ms-3"><div class="fw-bold text-gray-900 fs-6"><bdi>@me.Name</bdi></div><div class="text-muted fs-7">@(shift != null ? HospitalUi.DeskName(shift.Shift.Desk, T["Clinics desk"].Value) : T["Front desk"].Value)</div></div>
            </div>
            <div class="vr d-none d-md-block"></div>
            <div><div class="text-muted fs-8">@T["Shift"]</div>
                @if (shift != null) {<span class="badge badge-light-primary fs-8 fw-bold">@T["Open since"] <span class="hp-num ms-1">@HospitalNursingService.UtcToWard(shift.Shift.OpenedAt).ToString("HH:mm")</span></span>}
                else {<a href="@Url.Action("Cashier")" class="badge badge-light-danger fs-8 fw-bold">@T["No open shift — open one"]</a>}</div>
            <div><div class="text-muted fs-8">@T["Cash in the drawer"]</div><div class="fw-bold fs-5"><span class="hp-num">@(shift != null ? Money(shift.Expected) : "—")</span> <span class="fs-8 text-muted fw-semibold">@cur</span></div></div>
            <div><div class="text-muted fs-8">@T["Last called"]</div><div class="fw-bold fs-4 text-primary hp-num">@(me.LastCalled?.ToString() ?? "—")</div></div>
            <a href="@Url.Action("Clinics")" class="btn btn-sm btn-primary"><i class="ki-outline ki-notification-on fs-4"></i>@T["Clinics board"]</a>
            <div class="ms-auto text-end"><div class="fs-2 fw-bold text-gray-900 hp-num" data-desk-clock>@nowLocal.ToString("HH:mm")</div><div class="text-muted fs-8">@nowLocal.ToString("dddd d MMMM yyyy")</div></div>
        </div></div>

        @* ---------------- the one search ---------------- *@
        <div class="card mb-5"><div class="card-body py-6">
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <div class="position-relative flex-grow-1 min-w-300px">
                    <i class="ki-outline ki-magnifier fs-1 text-gray-500 position-absolute top-50 translate-middle-y ms-6"></i>
                    <input type="text" class="form-control form-control-lg form-control-solid ps-16 fs-4" autocomplete="off" data-desk-search
                           placeholder="@T["Search by name in Arabic or English, file, ID, mobile or queue number…"]" />
                </div>
                <button type="button" class="btn btn-light-primary" data-desk-reader><i class="ki-outline ki-scan-barcode fs-3"></i>@T["Read the ID card"]</button>
                <button type="button" class="btn btn-primary" data-desk-register><i class="ki-outline ki-user-tick fs-3"></i>@T["Register a patient"]</button>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                @foreach (var k in new[] { ("", T["All"].Value), ("name", T["match:name"].Value), ("mrn", T["match:mrn"].Value), ("id", T["match:id"].Value), ("phone", T["match:phone"].Value), ("queue", T["match:queue"].Value) })
                {
                    <a href="#" class="btn btn-sm @(k.Item1 == "" ? "btn-light-primary" : "btn-light") py-1 px-4 fs-7" data-desk-kind="@k.Item1">@k.Item2</a>
                }
                <span class="ms-auto text-muted fs-8 align-self-center"><i class="ki-outline ki-information-5 fs-7"></i> أحمد = احمد · Mohamed = Muhammad · @T["An exact ID or file number comes first"]</span>
            </div>
            <div class="mt-5 d-none" data-desk-results></div>
        </div></div>

        @* ---------------- eight figures ---------------- *@
        <div class="row g-4 mb-5">
            @foreach (var s in tiles)
            {
                <div class="col-6 col-md-3 col-xxl">
                    <a href="#" class="card card-flush h-100 hover-elevate-up" @(s.Stage != null ? Html.Raw("data-stage-tile=\"" + s.Stage + "\"") : Html.Raw(""))>
                        <div class="card-body p-5">
                            <div class="symbol symbol-35px mb-3"><span class="symbol-label bg-light-@s.Tone"><i class="ki-outline @s.Icon fs-3 text-@s.Tone"></i></span></div>
                            <div class="fs-2x fw-bold text-gray-900 hp-num lh-1">@s.N</div>
                            <div class="text-gray-600 fw-semibold fs-7 mt-2">@s.Label</div>
                            <div class="text-muted fs-8 mt-1">@s.Note</div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @* ---------------- the clinics right now ---------------- *@
        <div class="card mb-5">
            <div class="card-header border-0 pt-6">
                <div class="card-title align-items-start flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Clinics right now"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@T["Who is served, how many wait, the delay"]</span></div>
                <div class="card-toolbar"><a href="@Url.Action("QueueDisplay")" class="btn btn-sm btn-light"><i class="ki-outline ki-screen fs-4"></i>@T["Waiting screen"]</a></div>
            </div>
            <div class="card-body pt-4">
                @if (clinics.Count == 0)
                {
                    <div class="text-center text-muted py-10"><i class="ki-outline ki-calendar fs-3x text-gray-300 d-block mb-3"></i>@T["No clinic works today."]</div>
                }
                <div class="row g-4">
                    @foreach (var c in clinics)
                    {
                        var p = c.Card.Practitioner; int fill = HospitalFrontDeskRules.Fill(c.Booked, c.FreeLeft);
                        var (stTone, stText) = c.Card.Current != null ? ("primary", T["In session"].Value) : c.Card.Waiting.Count > 0 ? ("danger", T["Patients waiting"].Value) : c.Card.Seen > 0 ? ("secondary", T["Between patients"].Value) : ("primary", T["Not started"].Value);
                        <div class="col-md-6 col-xl-4"><div class="border border-dashed border-gray-300 rounded p-4 h-100">
                            <div class="d-flex align-items-center mb-3">
                                <div class="symbol symbol-40px symbol-circle flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(p.Row.NameEn ?? p.Row.Name)</span>}</div>
                                <div class="ms-3 min-w-0"><div class="text-gray-900 fw-bold fs-6 text-truncate"><bdi>@DisplayName.Of(p.Row.Name, p.Row.NameEn)</bdi></div>
                                    <div class="text-muted fs-7 text-truncate">@if (p.Department != null) {<bdi>@DisplayName.Of(p.Department.Name, p.Department.NameEn)</bdi>}@if (p.ClinicRoomNumber != null) {<text> · @T["Room"] </text><span class="hp-num">@p.ClinicRoomNumber</span>}</div></div>
                                <span class="ms-auto badge badge-light-@stTone fs-8 fw-bold">@stText</span>
                            </div>
                            <div class="d-flex flex-wrap gap-3 fs-7 mb-3">
                                <div class="flex-grow-1"><div class="text-muted fs-8">@T["Serving"]</div><div class="fw-bold hp-num text-primary fs-5">@(c.Card.Current?.QueueNumber?.ToString() ?? "—")</div></div>
                                <div class="flex-grow-1"><div class="text-muted fs-8">@T["Waiting"]</div><div class="fw-bold hp-num fs-5 @(c.Card.Waiting.Count > 2 ? "text-danger" : "")">@c.Card.Waiting.Count</div></div>
                                <div class="flex-grow-1"><div class="text-muted fs-8">@T["Delay"]</div><div class="fw-bold fs-5 @(c.Card.DelayMinutes > 20 ? "text-danger" : "")">@Mins(c.Card.DelayMinutes)</div></div>
                                <div class="flex-grow-1"><div class="text-muted fs-8">@T["Next free"]</div><div class="fw-bold hp-num fs-5">@(c.NextFree is int nf ? Time(nf) : "—")</div></div>
                            </div>
                            <div class="d-flex align-items-center w-100"><div class="progress h-6px w-100 bg-light-primary me-3"><div class="progress-bar bg-@(fill > 85 ? "danger" : "primary")" style="width:@fill%"></div></div><span class="fw-bold fs-7 hp-num">@fill%</span></div>
                            @if (canBook)
                            {
                                <div class="d-flex gap-2 mt-3">
                                    <button type="button" class="btn btn-sm btn-light-primary flex-grow-1 py-2" data-desk-walkin-doc="@p.Row.ID" @(c.NextFree == null ? "disabled" : "")><i class="ki-outline ki-entrance-right fs-5"></i>@T["Walk-in"]</button>
                                    <a href="@Url.Action("Appointments")" class="btn btn-sm btn-light flex-grow-1 py-2"><i class="ki-outline ki-calendar-add fs-5"></i>@T["Book"]</a>
                                </div>
                            }
                        </div></div>
                    }
                </div>
            </div>
        </div>

        @* ---------------- the board and the counter ---------------- *@
        <div class="row g-5 mb-5">
            <div class="col-xxl-8">
                <div class="card h-100 mb-0">
                    <div class="card-header border-0 pt-6">
                        <div class="card-title align-items-start flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Today's board"]</span>
                            <span class="text-muted mt-1 fw-semibold fs-7">@T["Those waiting first, the longest wait on top"] · <span id="resultCount">—</span></span></div>
                        <div class="card-toolbar d-flex flex-nowrap gap-2 align-items-center">
                            <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_dept"><option value="">@T["All departments"]</option>@foreach (var d in departments) { <option value="@d.ID">@DisplayName.Of(d.Name, d.NameEn)</option> }</select></div>
                            <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_doc"><option value="">@T["All doctors"]</option>@foreach (var d in doctors) { <option value="@d.Row.ID">@DisplayName.Of(d.Row.Name, d.Row.NameEn)</option> }</select></div>
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-light-primary active text-nowrap" data-desk-view="list"><i class="ki-outline ki-row-horizontal fs-4"></i>@T["List"]</button>
                                <button type="button" class="btn btn-sm btn-light text-nowrap" data-desk-view="grid"><i class="ki-outline ki-element-11 fs-4"></i>@T["Time grid"]</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body pt-4">
                        <div data-desk-list>
                            <div class="d-flex flex-wrap flex-stack gap-3 mb-5">
                                <ul class="nav nav-pills nav-pills-custom gap-2 m-0" data-stages>
                                    @foreach (var s in stages)
                                    {
                                        int n = s.Key == "" ? counts.Values.Sum() : counts.GetValueOrDefault(s.Key);
                                        <li class="nav-item"><a class="nav-link btn btn-sm btn-color-gray-600 btn-active btn-active-light-primary px-4 py-2 @(s.Key == "" ? "active" : "")" href="#" data-stage="@s.Key">@s.Label <span class="badge badge-light ms-1 hp-num">@n</span></a></li>
                                    }
                                </ul>
                                <div class="d-flex gap-2 align-items-center">
                                    <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Name, file or queue number…"]" /></div>
                                    <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                                    <button type="button" id="f_reset" class="btn btn-sm btn-icon btn-light btn-active-light-primary" title="@T["Reset"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrows-circle fs-3"></i></button>
                                </div>
                            </div>
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted">
                                    <th class="ps-4" style="width:90px">@T["Time"]</th><th>@T["Patient"]</th><th style="width:110px"></th><th>@T["Doctor · payer"]</th><th>@T["Stage"]</th><th class="text-end pe-4"></th>
                                </tr></thead>
                                <tbody id="rows" class="fs-6"><tr id="loadingRow"><td colspan="6" class="text-center text-muted py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>@T["Loading…"]</td></tr>
                                    <tr id="emptyRow" class="d-none"><td colspan="6" class="text-center py-12"><i class="ki-outline ki-calendar fs-3x text-gray-300 mb-4 d-block"></i><span class="fs-6 fw-semibold text-gray-600">@T["No appointment matches."]</span></td></tr></tbody>
                            </table></div>
                            <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                        </div>
                        <div data-desk-grid class="d-none"></div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-4">
                <div class="card h-100 mb-0">
                    <div class="card-header border-0 pt-6">
                        <div class="card-title align-items-start flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["At the counter"]</span>
                            <span class="text-muted mt-1 fw-semibold fs-7">@T["The patient you are serving"]</span></div>
                    </div>
                    <div class="card-body pt-4" data-desk-card>
                        <div class="text-center py-10">
                            <i class="ki-outline ki-profile-circle fs-5x text-gray-300 d-block mb-4"></i>
                            <div class="fs-6 fw-semibold text-gray-700 mb-2">@T["Search for the patient or pick one from the board."]</div>
                            @if (next != null)
                            {
                                <div class="text-muted fs-7 mb-4">@T["Next expected"]: <bdi class="fw-bold text-gray-800">@DisplayName.Of(next.A.PatientName, next.A.PatientNameEn)</bdi> · <span class="hp-num">@Time(next.A.StartMinute)</span></div>
                                <button type="button" class="btn btn-sm btn-light-primary" data-open-patient="@next.A.PatientId"><i class="ki-outline ki-profile-circle fs-4"></i>@T["Open at the counter"]</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ---------------- the desk's work and my drawer ---------------- *@
        <div class="row g-5">
            <div class="col-xl-8">
                <div class="card h-100 mb-0">
                    <div class="card-header border-0 pt-6">
                        <div class="card-title align-items-start flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["The desk's work"]</span>
                            <span class="text-muted mt-1 fw-semibold fs-7">@string.Format(T["{0} items"].Value, inbox.Total + unconfirmed + hoOpen)</span></div>
                    </div>
                    <div class="card-body pt-2">
                        <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-6 fw-bold mb-6" role="tablist">
                            @for (int i = 0; i < work.Length; i++)
                            {
                                var w = work[i];
                                <li class="nav-item"><a class="nav-link text-active-primary py-4 me-6 @(i == 0 ? "active" : "")" data-bs-toggle="tab" href="#desk_w_@w.Key">@w.Label <span class="badge badge-light-@(w.N > 0 ? w.Tone : "secondary") ms-1 hp-num">@w.N</span></a></li>
                            }
                        </ul>
                        <div class="tab-content">
                            @for (int i = 0; i < work.Length; i++)
                            {
                                var w = work[i];
                                <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="desk_w_@w.Key" role="tabpanel">
                                    <div class="text-muted fs-7 mb-4">@w.Text</div>
                                    <div data-desk-work="@w.Key"><div class="text-center text-muted py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>@T["Loading…"]</div></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="card h-100 mb-0">
                    <div class="card-header border-0 pt-6">
                        <div class="card-title align-items-start flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["My drawer"]</span>
                            <span class="text-muted mt-1 fw-semibold fs-7">@(shift != null ? HospitalUi.DeskName(shift.Shift.Desk, T["Clinics desk"].Value) : T["No open shift"].Value)</span></div>
                    </div>
                    <div class="card-body pt-4">
                        @if (shift == null)
                        {
                            <div class="notice d-flex bg-light rounded border border-dashed border-gray-300 p-5 mb-5">
                                <i class="ki-outline ki-wallet fs-2tx text-primary me-4"></i>
                                <div class="d-flex flex-column"><div class="fw-bold text-gray-900 mb-1">@T["No open shift"]</div><div class="fs-7 text-gray-700 mb-3">@T["Open a shift at the cashier to take money at the counter."]</div>
                                    <a href="@Url.Action("Cashier")" class="btn btn-sm btn-primary align-self-start">@T["Open a shift"]</a></div>
                            </div>
                        }
                        else
                        {
                            decimal mine = shift.ByMethod.Values.Sum();
                            <div class="d-flex flex-stack mb-4"><div><div class="text-muted fs-8">@T["I collected"]</div><div class="fw-bold fs-2x"><span class="hp-num">@Money(mine)</span> <span class="fs-7 text-muted fw-semibold">@cur</span></div></div>
                                <span class="badge badge-light-primary fs-8 fw-bold">@string.Format(T["{0} receipts"].Value, shift.Receipts)</span></div>
                            @foreach (var m in HospitalPaymentMethods.All)
                            {
                                decimal v = shift.ByMethod.GetValueOrDefault(m); int pc = mine == 0 ? 0 : (int)Math.Round(100m * v / mine);
                                <div class="mb-3"><div class="d-flex flex-stack fs-7 mb-1"><span class="fw-semibold">@T["pm:" + m]</span><span class="fw-bold"><span class="hp-num">@Money(v)</span> <span class="text-muted fs-8">@cur</span></span></div>
                                    <div class="progress h-6px w-100 bg-light-primary"><div class="progress-bar bg-primary" style="width:@pc%"></div></div></div>
                            }
                        }
                        <div class="separator separator-dashed my-4"></div>
                        <div class="fw-bold fs-7 mb-3">@T["My last receipts"]</div>
                        @if (me.Receipts.Count == 0) {<div class="text-muted fs-7">@T["No receipt yet today."]</div>}
                        @foreach (var r in me.Receipts)
                        {
                            <div class="d-flex flex-stack py-2 fs-7"><span class="min-w-0 text-truncate"><span class="hp-num text-gray-800 fw-bold">@r.ReceiptNo</span> · <bdi>@DisplayName.Of(r.Patient, r.PatientEn)</bdi></span><span class="fw-bold text-nowrap ms-2"><span class="hp-num">@Money(r.Amount)</span> <span class="text-muted fs-8">@T["pm:" + r.Method]</span></span></div>
                        }
                        <div class="d-flex gap-2 mt-4">
                            <a href="@Url.Action("Cashier")" class="btn btn-sm btn-light flex-grow-1"><i class="ki-outline ki-wallet fs-5"></i>@T["Cashier"]</a>
                            <a href="@Url.Action("Bills")" class="btn btn-sm btn-light flex-grow-1"><i class="ki-outline ki-bill fs-5"></i>@T["Bills"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@* H144: the Report Studio preview the print menus open (one for the page; the menus come with the counter and the payment window) *@
@await Html.PartialAsync("_ReportPreviewModal", (object)T["Front desk"].Value)

@* the desk's window: walk-in slots, payment *@
<div class="modal fade" id="desk_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-850px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0" data-desk-modal-title></h2>
            <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-8 px-lg-10" data-desk-modal-body></div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { idFirst: @Json.Serialize(T["Confirm the patient's name and date of birth (or file number) first"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), loading: @Json.Serialize(T["Loading…"].Value),
                pickFirst: @Json.Serialize(T["Open the patient at the counter first."].Value), scan: @Json.Serialize(T["Scan the card now: the reader types into the search."].Value),
                walkin: @Json.Serialize(T["Walk-in"].Value), pay: @Json.Serialize(T["Collect at the counter"].Value), done: @Json.Serialize(T["Booked and checked in"].Value),
                collected: @Json.Serialize(T["Collected; the receipt is in the bill."].Value), askSlot: @Json.Serialize(T["Book {0} at {1} and check them in now?"].Value) };
            var U = { board: @Json.Serialize(Url.Action("FrontDeskBoard")), grid: @Json.Serialize(Url.Action("FrontDeskGrid")), search: @Json.Serialize(Url.Action("FrontDeskSearch")),
                card: @Json.Serialize(Url.Content("~/Hospital/FrontDesk/Patient/")), slots: @Json.Serialize(Url.Action("FrontDeskWalkInSlots")), walkin: @Json.Serialize(Url.Action("FrontDeskWalkIn")),
                move: @Json.Serialize(Url.Content("~/Hospital/FrontDesk/Appointments/")), collect: @Json.Serialize(Url.Content("~/Hospital/Bill/")), deskCollect: @Json.Serialize(Url.Content("~/Hospital/FrontDesk/Bill/")),
                work: @Json.Serialize(Url.Action("FrontDeskWork")), slotsOf: @Json.Serialize(Url.Action("FrontDeskSlots")),
                arrival: @Json.Serialize(Url.Action("FrontDeskArrival")), handoffs: @Json.Serialize(Url.Action("FrontDeskHandoffs")), handoffsPost: @Json.Serialize(Url.Content("~/Hospital/FrontDesk/Handoffs")) };
            var W5 = { arrival: @Json.Serialize(T["Arrival: why they came and where they go"].Value), urgent: @Json.Serialize(T["Urgent help"].Value), pick: @Json.Serialize(T["Choose why they came"].Value),
                pickOpt: @Json.Serialize(T["Choose what it is for"].Value), sent: @Json.Serialize(T["Sent; the receiving team must take them."].Value), chased: @Json.Serialize(T["The receiving team is reminded."].Value),
                where: @Json.Serialize(T["Where the patient is now"].Value), secret: @Json.Serialize(T["This file is confidential: no place may be given. The inquiry is recorded."].Value), nowhere: @Json.Serialize(T["The patient is not inside the hospital now."].Value),
                visitorName: @Json.Serialize(T["Enter the visitor's name"].Value), referral: @Json.Serialize(T["Enter who referred them"].Value) };
            var W2 = { resched: @Json.Serialize(T["Move the appointment"].Value), moved: @Json.Serialize(T["Moved; the old appointment is cancelled."].Value), noSlot: @Json.Serialize(T["No free slot that day"].Value),
                askCollect: @Json.Serialize(T["Collect {0} by {1} on bill {2}?"].Value), amount: @Json.Serialize(T["Enter an amount above zero"].Value),
                askMove: @Json.Serialize(T["Move the appointment to {0} at {1}?"].Value) };
            var W3 = { register: @Json.Serialize(T["Register a patient"].Value), reader: @Json.Serialize(T["Scan the card now: the reader types into the ID field."].Value),
                camera: @Json.Serialize(T["The camera could not be opened: allow it in the browser, or take the photo from a file."].Value), big: @Json.Serialize(T["The photo must be an image of up to 5 MB"].Value),
                dupAsk: @Json.Serialize(T["A similar file already exists. Open a new file anyway?"].Value), dupTitle: @Json.Serialize(T["This patient may already have a file"].Value),
                saved: @Json.Serialize(T["The file is opened"].Value), photoFail: @Json.Serialize(T["The file is saved but the photo was not; add it from the file."].Value),
                why: { 'national-id': @Json.Serialize(T["Same ID number"].Value), phone: @Json.Serialize(T["Same mobile"].Value), name: @Json.Serialize(T["Same name"].Value) },
                open: @Json.Serialize(T["Open at the counter"].Value) };
            var W4 = { take: @Json.Serialize(T["Take a deposit of {0} by {1} from {2}?"].Value), use: @Json.Serialize(T["Pay {0} of bill {1} from the deposit?"].Value),
                refund: @Json.Serialize(T["How much of deposit {0} to refund? ({1} left)"].Value), why: @Json.Serialize(T["The reason for the refund"].Value),
                refundAsk: @Json.Serialize(T["Refund {0} of deposit {1} by {2}?"].Value), done: @Json.Serialize(T["Saved"].Value), amount: @Json.Serialize(T["Enter an amount above zero"].Value) };
            var U4 = { take: @Json.Serialize(Url.Content("~/Hospital/FrontDesk/Patient/")), use: @Json.Serialize(Url.Content("~/Hospital/FrontDesk/Bill/")), refund: @Json.Serialize(Url.Content("~/Hospital/FrontDesk/Deposits/")) };
            var payPatient = null;
            function reloadPay() { if (payPatient) windowOf(W.pay, U.card + payPatient + '/Pay'); refresh(); }
            var U3 = { win: @Json.Serialize(Url.Action("FrontDeskRegister")), similar: @Json.Serialize(Url.Action("SimilarPatients")), save: @Json.Serialize(Url.Action("SavePatient")), photo: @Json.Serialize(Url.Content("~/Hospital/Patient/")) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function get(u) { return fetch(u, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }); }
            function tips(root) { if (window.bootstrap) root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) { bootstrap.Tooltip.getOrCreateInstance(el); }); }
            function menus() { if (window.KTMenu) KTMenu.createInstances(); }
            function s2(root, parent) { if (!window.jQuery || !jQuery.fn.select2) return; root.querySelectorAll('select').forEach(function (el) { if (jQuery(el).hasClass('select2-hidden-accessible')) return;
                jQuery(el).select2({ width: '100%', dir: document.documentElement.dir || 'rtl', minimumResultsForSearch: el.querySelectorAll('option').length > 7 ? 0 : Infinity, dropdownParent: jQuery(parent) }); }); }

            // the clock
            var clock = document.querySelector('[data-desk-clock]');
            setInterval(function () { var d = new Date(); clock.textContent = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }, 20000);

            // the board: stage pills and filters feed the list; the grid reloads with the filters
            var stage = '', view = 'list';
            var list = cbServerList({ url: U.board, isAr: @(isAr ? "true" : "false"),
                addParams: function (p) { p.set('stage', stage); var d = document.getElementById('f_dept').value, o = document.getElementById('f_doc').value; if (d) p.set('department', d); if (o) p.set('doctor', o); } });
            new MutationObserver(function () { var b = document.getElementById('rows'); tips(b); menus(); }).observe(document.getElementById('rows'), { childList: true });
            var gridEl = document.querySelector('[data-desk-grid]'), listEl = document.querySelector('[data-desk-list]');
            function loadGrid() { var d = document.getElementById('f_dept').value, o = document.getElementById('f_doc').value;
                gridEl.innerHTML = '<div class="text-center text-muted py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>' + W.loading + '</div>';
                get(U.grid + '?' + new URLSearchParams(Object.assign({}, d ? { department: d } : {}, o ? { doctor: o } : {}))).then(function (h) { gridEl.innerHTML = h; tips(gridEl); }); }
            function pick(s) { stage = s || ''; document.querySelectorAll('[data-stage]').forEach(function (a) { a.classList.toggle('active', a.getAttribute('data-stage') === stage); }); list.reload(); }
            if (window.jQuery) jQuery('#f_dept, #f_doc').on('change', function () { if (view === 'grid') loadGrid(); });

            // the one search
            var box = document.querySelector('[data-desk-search]'), res = document.querySelector('[data-desk-results]'), timer = null, seq = 0, kind = '';
            function search() { clearTimeout(timer); var q = box.value.trim();
                if (q.length < 2) { res.classList.add('d-none'); res.innerHTML = ''; return; }
                timer = setTimeout(function () { var my = ++seq;
                    get(U.search + '?q=' + encodeURIComponent(q) + (kind ? '&kind=' + kind : '')).then(function (h) { if (my !== seq) return; res.innerHTML = h; res.classList.remove('d-none'); tips(res); }); }, 250); }
            box.addEventListener('input', search);

            // the patient at the counter
            var cardEl = document.querySelector('[data-desk-card]'), current = null;
            var cardSeq = 0;   // H157: only the last patient asked for may fill the card
            function openCard(id, scroll) {
                var mySeq = ++cardSeq;
                current = Number(id); cardEl.innerHTML = '<div class="text-center text-muted py-15"><span class="spinner-border spinner-border-sm text-primary me-2"></span>' + W.loading + '</div>';
                get(U.card + id).then(function (h) { if (mySeq !== cardSeq) return; cardEl.innerHTML = h; tips(cardEl); menus(); if (scroll) cardEl.closest('.card').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
            }
            function refresh() { list.reload(); if (view === 'grid') loadGrid(); if (current) openCard(current); }

            // the window
            var modalEl = document.getElementById('desk_modal'), mTitle = modalEl.querySelector('[data-desk-modal-title]'), mBody = modalEl.querySelector('[data-desk-modal-body]');
            // H157: the two-identifier check of the money window (it belongs to the window's own patient)
            function idChecked() { var c = mBody.querySelector('[data-id-check]'); return !!(c && c.checked); }
            function idRow() { var r = mBody.querySelector('[data-id-check-row]'); if (r) { r.classList.add('border-danger'); r.scrollIntoView({ block: 'center' }); } }
            function windowOf(title, url, size) { mTitle.textContent = title; modalEl.querySelector('.modal-dialog').className = 'modal-dialog modal-dialog-centered ' + (size || 'mw-850px'); mBody.innerHTML = '<div class="text-center text-muted py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>' + W.loading + '</div>';
                bootstrap.Modal.getOrCreateInstance(modalEl).show(); get(url).then(function (h) { mBody.innerHTML = h; s2(mBody, modalEl); tips(mBody); menus(); }); }
            function walkIn(patient, doctor) { if (!patient) { toastr.warning(W.pickFirst); return; } windowOf(W.walkin, U.slots + '?patient=' + patient + (doctor ? '&doctor=' + doctor : '')); }
            function book(patient, doctor, minute, btn) {
                if (btn) btn.disabled = true;
                post(U.walkin, { patientId: Number(patient), practitionerId: Number(doctor), startMinute: minute == null ? null : Number(minute), visitType: (mBody.querySelector('[data-walkin-type]') || {}).value })
                    .then(function (r) { if (btn) btn.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; } toastr.success(W.done); bootstrap.Modal.getOrCreateInstance(modalEl).hide(); refresh(); });
            }

            // the desk's work: a tab loads when it is opened (the first at once)
            function loadWork(k) { var el = document.querySelector('[data-desk-work="' + k + '"]'); if (!el) return;
                get(k === 'handoff' ? U.handoffs : U.work + '?kind=' + k).then(function (h) { el.innerHTML = h; tips(el); }); }
            document.querySelectorAll('a[href^="#desk_w_"]').forEach(function (a) { a.addEventListener('shown.bs.tab', function () { loadWork(a.getAttribute('href').replace('#desk_w_', '')); }); });
            loadWork('handoff');

            // H158: the arrival window — the reason shows what is waiting under it (or the referral / visitor fields), "send" hands over
            function esc(x) { var d = document.createElement('div'); d.textContent = x == null ? '' : x; return d.innerHTML; }
            function arrivalWindow(patient) { windowOf(patient ? W5.arrival : W5.urgent, U.arrival + (patient ? '?patient=' + patient : ''), 'mw-750px'); }
            function arrShow() {
                var box = mBody.querySelector('[data-arrival]'); if (!box) return;
                var r = (box.querySelector('input[name="arrReason"]:checked') || {}).value || '';
                var withOpts = ['Clinic', 'Lab', 'Imaging', 'Admission', 'Operation'].indexOf(r) >= 0;
                box.querySelectorAll('[data-arr-reason-tile]').forEach(function (l) { l.classList.toggle('active', l.querySelector('input').checked); });   // the theme's button group is not live in loaded content
                box.querySelector('[data-arr-section="options"]').classList.toggle('d-none', !withOpts);
                box.querySelector('[data-arr-section="referral"]').classList.toggle('d-none', r !== 'Referral');
                box.querySelector('[data-arr-section="visitor"]').classList.toggle('d-none', r !== 'Visitor');
                var n = 0;
                box.querySelectorAll('[data-opt-reason]').forEach(function (l) { var on = l.getAttribute('data-opt-reason') === r; l.classList.toggle('d-none', !on); l.classList.toggle('d-flex', on); if (on) n++; else l.querySelector('input').checked = false; });
                if (n === 1) box.querySelector('[data-opt-reason="' + r + '"] input').checked = true;
                box.querySelector('[data-arr-none]').classList.toggle('d-none', !withOpts || n > 0);
            }
            mBody.addEventListener('change', function (e) { if (e.target.name === 'arrReason') arrShow(); });
            function arrSend(btn) {
                var box = mBody.querySelector('[data-arrival]'), v = function (k) { var el = box.querySelector('[data-arr="' + k + '"]'); return el ? el.value.trim() : ''; };
                var r = (box.querySelector('input[name="arrReason"]:checked') || {}).value; if (!r) { toastr.warning(W5.pick); return; }
                var o = box.querySelector('input[name="arrOption"]:checked'), withOpts = ['Clinic', 'Lab', 'Imaging', 'Admission', 'Operation'].indexOf(r) >= 0;
                if (withOpts && !o) { toastr.warning(W5.pickOpt); return; }
                if (r === 'Visitor' && !v('visitorName')) { toastr.warning(W5.visitorName); return; }
                if (r === 'Referral' && !v('referralFrom')) { toastr.warning(W5.referral); return; }
                var pid = box.getAttribute('data-patient');
                var body = { patientId: pid ? Number(pid) : null, reason: r, destination: r === 'Referral' ? v('destination') : (o ? o.getAttribute('data-dest') : null),
                    linkKind: o ? o.getAttribute('data-kind') : null, linkId: o ? Number(o.value) : null, referralFrom: v('referralFrom') || null,
                    visitorName: v('visitorName') || null, visitorRelation: v('visitorRelation') || null, note: v('note') || null };
                btn.disabled = true;
                post(U.handoffsPost, body).then(function (res) {
                    btn.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                    if (r === 'Visitor') {
                        var a = box.querySelector('[data-arr-answer]'), h;
                        if (res.confidential) h = '<div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-4 fs-7 fw-semibold">' + esc(W5.secret) + '</div>';
                        else if (!res.where || !res.where.length) h = '<div class="notice d-flex bg-light rounded border border-dashed p-4 fs-7">' + esc(W5.nowhere) + '</div>';
                        else h = '<div class="notice bg-light-primary rounded border-primary border border-dashed p-4"><div class="fw-bold fs-7 mb-2">' + esc(W5.where) + '</div>' +
                            res.where.map(function (w) { return '<div class="fs-7"><bdi class="fw-bold">' + esc(w.place) + '</bdi>' + (w.detail ? ' · <bdi>' + esc(w.detail) + '</bdi>' : '') + '</div>'; }).join('') + '</div>';
                        a.innerHTML = h; a.classList.remove('d-none'); btn.classList.add('d-none'); loadWork('handoff'); return;
                    }
                    toastr.success(W5.sent); bootstrap.Modal.getOrCreateInstance(modalEl).hide(); loadWork('handoff');
                });
            }

            // the reschedule window: the doctor (select2) and the day (flatpickr) reload the free slots
            function rsSlots() {
                var box = mBody.querySelector('[data-rs]'); if (!box) return;
                var doc = box.querySelector('[data-rs-doctor]').value, day = box.querySelector('[data-rs-date]').value, out = box.querySelector('[data-rs-slots]');
                out.innerHTML = '<span class="spinner-border spinner-border-sm text-primary"></span>';
                fetch(U.slotsOf + '?doctor=' + doc + '&date=' + day, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (j) {
                    out.innerHTML = (j.slots || []).length ? j.slots.map(function (s) { return '<button type="button" class="btn btn-sm btn-light-primary hp-num py-1 px-3" data-rs-slot="' + s.m + '">' + s.t + '</button>'; }).join('') : '<span class="text-muted fs-7">' + W2.noSlot + '</span>';
                });
            }
            function rescheduleWindow(id) {
                windowOf(W2.resched, U.move + id + '/Reschedule');
                var wait = setInterval(function () { var box = mBody.querySelector('[data-rs]'); if (!box) return; clearInterval(wait);
                    var d = box.querySelector('[data-rs-date]');
                    if (d && window.flatpickr) flatpickr(d, { dateFormat: 'Y-m-d', defaultDate: d.value, minDate: box.getAttribute('data-today'), disableMobile: true, static: true,
                        locale: @(isAr ? "true" : "false") && flatpickr.l10ns && flatpickr.l10ns.ar ? flatpickr.l10ns.ar : 'default', onChange: rsSlots });
                    if (window.jQuery) jQuery(box).find('[data-rs-doctor]').on('change', rsSlots);
                }, 100);
            }

            // ---------------- H142: registering inside the desk ----------------
            var shot = null, stream = null, dupHits = [], dupTimer = null;
            function stopCam() { if (stream) { stream.getTracks().forEach(function (x) { x.stop(); }); stream = null; } }
            modalEl.addEventListener('hidden.bs.modal', stopCam);
            function reg() { return mBody.querySelector('[data-reg]'); }
            function field(k) { return reg().querySelector('[data-reg-f="' + k + '"]'); }
            function showShot(blob) { shot = blob; var box = reg(), img = box.querySelector('[data-reg-shot]'); img.src = URL.createObjectURL(blob); img.classList.remove('d-none');
                box.querySelector('[data-reg-video]').classList.add('d-none'); box.querySelector('[data-reg-empty]').classList.add('d-none'); }
            function dupCheck() {
                clearTimeout(dupTimer); dupTimer = setTimeout(function () {
                    var p = new URLSearchParams(); ['nationalId', 'phone', 'name', 'nameEn'].forEach(function (k) { var v = field(k).value.trim(); if (v) p.set(k, v); });
                    var box = reg().querySelector('[data-reg-dups]');
                    if (![...p.keys()].length) { dupHits = []; box.classList.add('d-none'); return; }
                    fetch(U3.similar + '?' + p, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (j) {
                        dupHits = j.items || [];
                        if (!dupHits.length) { box.classList.add('d-none'); box.innerHTML = ''; return; }
                        box.innerHTML = '<div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5"><i class="ki-outline ki-copy fs-2tx text-danger me-4"></i><div class="flex-grow-1"><div class="fw-bold text-gray-900 mb-2">' + W3.dupTitle + '</div>' +
                            dupHits.map(function (h) { var s = document.createElement('span'); s.textContent = h.name;
                                return '<div class="d-flex flex-stack flex-wrap gap-2 py-2 border-top border-dashed border-danger"><div class="fs-7"><bdi class="fw-bold">' + s.innerHTML + '</bdi> · <span class="hp-num">' + h.mrn + '</span> · <span class="badge badge-light-danger fs-8">' + (W3.why[h.reason] || h.reason) + '</span></div>' +
                                    '<button type="button" class="btn btn-sm btn-danger" data-reg-use="' + h.id + '">' + W3.open + '</button></div>'; }).join('') + '</div></div>';
                        box.classList.remove('d-none');
                    });
                }, 350);
            }
            function registerWindow(q) {
                shot = null; dupHits = [];
                windowOf(W3.register, U3.win + (q ? '?q=' + encodeURIComponent(q) : ''), 'mw-1000px');
                var wait = setInterval(function () { var box = reg(); if (!box) return; clearInterval(wait);
                    var d = box.querySelector('[data-reg-date]');
                    if (d && window.flatpickr) flatpickr(d, { dateFormat: 'Y-m-d', maxDate: d.getAttribute('data-max'), disableMobile: true, static: true,
                        locale: @(isAr ? "true" : "false") && flatpickr.l10ns && flatpickr.l10ns.ar ? flatpickr.l10ns.ar : 'default' });
                    box.querySelectorAll('[data-reg-dup]').forEach(function (el) { el.addEventListener('input', dupCheck); });
                    box.querySelector('[data-reg-file]').addEventListener('change', function (ev) { var f = ev.target.files[0]; if (!f) return; if (f.size > 5 * 1024 * 1024) { toastr.error(W3.big); return; } stopCam(); showShot(f); });
                    dupCheck();
                    var first = box.querySelector('[data-reg-f="name"]'); if (first && !first.value) first.focus();
                }, 100);
            }
            function saveRegistration(btn, then) {
                var box = reg(), body = {};
                box.querySelectorAll('[data-reg-f]').forEach(function (el) { var k = el.getAttribute('data-reg-f');
                    if (el.type === 'checkbox') body[k] = el.checked; else if (el.closest('[data-reg-full]') && el.closest('[data-reg-full]').classList.contains('d-none')) return; else body[k] = el.value.trim() || null; });
                if (body.nationalityId) body.nationalityId = Number(body.nationalityId);
                var go = function () {
                    btn.disabled = true;
                    post(U3.save, body).then(function (r) {
                        if (!r.ok) { btn.disabled = false; toastr.error(r.error || W.failed); return; }
                        var id = r.id, done = function (photoOk) {
                            btn.disabled = false; stopCam(); toastr.success(W3.saved); if (photoOk === false) toastr.warning(W3.photoFail);
                            openCard(id, true); list.reload();
                            if (then === 'walkin') walkIn(id, null); else bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                        };
                        if (!shot) { done(); return; }
                        var fd = new FormData(); fd.append('photo', shot, 'photo.jpg');
                        fetch(U3.photo + id + '/Photo', { method: 'POST', headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' }, body: fd })
                            .then(function (x) { return x.json().catch(function () { return { ok: false }; }); }).then(function (j) { done(!!j.ok); });
                    });
                };
                if (dupHits.length) cbConfirm(W3.dupAsk, { kind: 'danger' }).then(function (ok) { if (ok) go(); }); else go();
            }

            document.addEventListener('click', function (e) {
                var t;
                if ((t = e.target.closest('[data-desk-register]'))) { e.preventDefault(); registerWindow(t.getAttribute('data-q') || document.querySelector('[data-desk-search]').value.trim()); return; }
                if ((t = e.target.closest('[data-reg-mode]'))) { e.preventDefault(); var full = t.getAttribute('data-reg-mode') === 'full';
                    reg().querySelectorAll('[data-reg-mode]').forEach(function (a) { a.classList.toggle('active', a === t); }); reg().querySelector('[data-reg-full]').classList.toggle('d-none', !full); return; }
                if ((t = e.target.closest('[data-reg-reader]'))) { var nid = field('nationalId'); nid.value = ''; nid.focus(); toastr.info(W3.reader); return; }
                if ((t = e.target.closest('[data-reg-cam]'))) {
                    var v = reg().querySelector('[data-reg-video]');
                    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { toastr.error(W3.camera); return; }
                    navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 640 } }, audio: false }).then(function (s) {
                        stream = s; v.srcObject = s; v.classList.remove('d-none'); reg().querySelector('[data-reg-shot]').classList.add('d-none'); reg().querySelector('[data-reg-empty]').classList.add('d-none');
                        reg().querySelector('[data-reg-snap]').classList.remove('d-none');
                    }).catch(function () { toastr.error(W3.camera); });
                    return;
                }
                if ((t = e.target.closest('[data-reg-snap]'))) {
                    var vid = reg().querySelector('[data-reg-video]'), w = vid.videoWidth, h = vid.videoHeight, side = Math.min(w, h); if (!side) return;
                    var c = document.createElement('canvas'); c.width = c.height = Math.min(side, 640);
                    c.getContext('2d').drawImage(vid, (w - side) / 2, (h - side) / 2, side, side, 0, 0, c.width, c.height);
                    c.toBlob(function (b) { stopCam(); showShot(b); t.classList.add('d-none'); }, 'image/jpeg', 0.9);
                    return;
                }
                if ((t = e.target.closest('[data-reg-use]'))) { e.preventDefault(); stopCam(); bootstrap.Modal.getOrCreateInstance(modalEl).hide(); openCard(t.getAttribute('data-reg-use'), true); return; }
                if ((t = e.target.closest('[data-reg-save]'))) { e.preventDefault(); saveRegistration(t, t.getAttribute('data-reg-save')); return; }
                if ((t = e.target.closest('[data-desk-resched]'))) { e.preventDefault(); rescheduleWindow(t.getAttribute('data-desk-resched')); return; }
                if ((t = e.target.closest('[data-rs-slot]'))) {
                    e.preventDefault(); var rsBox = t.closest('[data-rs]'), day = rsBox.querySelector('[data-rs-date]').value;
                    cbConfirm(W2.askMove.replace('{0}', day).replace('{1}', t.textContent.trim()), { kind: 'primary' }).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post(U.move + rsBox.getAttribute('data-rs') + '/Reschedule', { practitionerId: Number(rsBox.querySelector('[data-rs-doctor]').value), date: day, startMinute: Number(t.getAttribute('data-rs-slot')) })
                            .then(function (r) { t.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; } toastr.success(W2.moved); bootstrap.Modal.getOrCreateInstance(modalEl).hide(); refresh(); loadWork('confirm'); });
                    });
                    return;
                }
                if ((t = e.target.closest('[data-desk-confirm]'))) {
                    e.preventDefault(); var id = t.getAttribute('data-desk-confirm'), st = t.getAttribute('data-status'); t.disabled = true;
                    post(U.move + id + '/Confirm', { status: st }).then(function (r) { t.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; }
                        if (st === 'WantsToMove') rescheduleWindow(id); else toastr.success(W.saved); loadWork('confirm'); });
                    return;
                }
                if ((t = e.target.closest('[data-stage]'))) { e.preventDefault(); pick(t.getAttribute('data-stage')); return; }
                if ((t = e.target.closest('[data-stage-tile]'))) { e.preventDefault(); if (view !== 'list') document.querySelector('[data-desk-view="list"]').click(); pick(t.getAttribute('data-stage-tile')); document.getElementById('rows').scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
                if ((t = e.target.closest('[data-desk-kind]'))) { e.preventDefault(); kind = t.getAttribute('data-desk-kind'); document.querySelectorAll('[data-desk-kind]').forEach(function (a) { a.classList.toggle('btn-light-primary', a === t); a.classList.toggle('btn-light', a !== t); }); box.focus(); search(); return; }
                if ((t = e.target.closest('[data-desk-reader]'))) { box.value = ''; box.focus(); toastr.info(W.scan); return; }
                if ((t = e.target.closest('[data-desk-view]'))) {
                    view = t.getAttribute('data-desk-view');
                    document.querySelectorAll('[data-desk-view]').forEach(function (b) { b.classList.toggle('btn-light-primary', b === t); b.classList.toggle('active', b === t); b.classList.toggle('btn-light', b !== t); });
                    listEl.classList.toggle('d-none', view !== 'list'); gridEl.classList.toggle('d-none', view !== 'grid'); if (view === 'grid') loadGrid(); return;
                }
                if ((t = e.target.closest('[data-move]'))) {
                    e.preventDefault(); var to = t.getAttribute('data-move'), ask = t.getAttribute('data-ask');
                    var go = function () { t.disabled = true; post(U.move + t.getAttribute('data-appt') + '/Move', { to: to })
                        .then(function (r) { t.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; } toastr.success(W.saved); refresh(); }); };
                    if (ask) cbConfirm(ask, { kind: to === 'Arrived' ? 'primary' : 'danger' }).then(function (ok) { if (ok) go(); }); else go();
                    return;
                }
                if ((t = e.target.closest('[data-desk-walkin]'))) { e.preventDefault(); walkIn(t.getAttribute('data-desk-walkin'), null); return; }
                if ((t = e.target.closest('[data-desk-walkin-doc]'))) { e.preventDefault(); walkIn(current, t.getAttribute('data-desk-walkin-doc')); return; }
                if ((t = e.target.closest('[data-desk-slot]'))) {
                    e.preventDefault(); var who = (mBody.querySelector('[data-walkin-name]') || {}).textContent || '';
                    cbConfirm(W.askSlot.replace('{0}', who).replace('{1}', t.textContent.trim()), { kind: 'primary' }).then(function (ok) { if (ok) book(t.getAttribute('data-patient'), t.getAttribute('data-doctor'), t.getAttribute('data-desk-slot'), t); });
                    return;
                }
                if ((t = e.target.closest('[data-grid-free]'))) {
                    e.preventDefault(); if (!current) { toastr.warning(W.pickFirst); return; }
                    var who = (cardEl.querySelector('[data-desk-name]') || {}).textContent || '';
                    cbConfirm(W.askSlot.replace('{0}', who).replace('{1}', t.getAttribute('data-time')), { kind: 'primary' }).then(function (ok) { if (ok) book(current, t.getAttribute('data-doctor'), t.getAttribute('data-grid-free'), null); });
                    return;
                }
                if ((t = e.target.closest('[data-desk-pay]'))) { e.preventDefault(); payPatient = t.getAttribute('data-desk-pay'); windowOf(W.pay, U.card + payPatient + '/Pay'); return; }
                // H143: the deposit — take, pay a bill from it, refund (each asks first)
                if ((t = e.target.closest('[data-desk-deposit]'))) {
                    e.preventDefault(); var f = t.closest('[data-deposit-form]'), amt = Number(f.querySelector('[data-dep-amount]').value), ms = f.querySelector('[data-dep-method]');
                    if (!(amt > 0)) { toastr.error(W4.amount); return; }
                    if (!idChecked()) { toastr.error(W.idFirst); idRow(); return; }
                    cbConfirm(W4.take.replace('{0}', amt + ' ' + f.getAttribute('data-cur')).replace('{1}', ms.options[ms.selectedIndex].text).replace('{2}', (mBody.querySelector('bdi') || {}).textContent || ''), { kind: 'primary' }).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post(U4.take + f.getAttribute('data-patient') + '/Deposit', { amount: amt, method: ms.value, purpose: f.querySelector('[data-dep-purpose]').value, note: f.querySelector('[data-dep-note]').value, identityChecked: idChecked() })
                            .then(function (r) { t.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; } toastr.success(W4.done); reloadPay(); });
                    });
                    return;
                }
                if ((t = e.target.closest('[data-desk-usedep]'))) {
                    e.preventDefault(); var row = t.closest('[data-bill]'), amt = Number(t.getAttribute('data-desk-usedep'));
                    cbConfirm(W4.use.replace('{0}', amt + ' ' + row.getAttribute('data-cur')).replace('{1}', row.getAttribute('data-bill-no')), { kind: 'primary' }).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post(U4.use + row.getAttribute('data-bill') + '/UseDeposit', { amount: amt }).then(function (r) { t.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; } toastr.success(W4.done); reloadPay(); });
                    });
                    return;
                }
                if ((t = e.target.closest('[data-desk-refund]'))) {
                    e.preventDefault(); var dr = t.closest('[data-dep]'), left = dr.getAttribute('data-left'), no = dr.getAttribute('data-dep-no'), cur2 = dr.getAttribute('data-cur');
                    cbPrompt(W4.refund.replace('{0}', no).replace('{1}', left + ' ' + cur2), { number: true, value: left }).then(function (v) {
                        if (v == null) return; var amt = Number(String(v).replace(',', '.'));
                        cbPrompt(W4.why, { kind: 'danger' }).then(function (reason) {
                            if (reason == null) return;
                            cbConfirm(W4.refundAsk.replace('{0}', amt + ' ' + cur2).replace('{1}', no).replace('{2}', dr.getAttribute('data-dep-method-label')), { kind: 'danger' }).then(function (ok) {
                                if (!ok) return; t.disabled = true;
                                post(U4.refund + dr.getAttribute('data-dep') + '/Refund', { amount: amt, method: dr.getAttribute('data-dep-method'), reason: reason }).then(function (r) { t.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; } toastr.success(W4.done); reloadPay(); });
                            });
                        });
                    });
                    return;
                }
                if ((t = e.target.closest('[data-desk-collect]'))) {
                    e.preventDefault(); var row = t.closest('[data-bill]'), amount = Number(row.querySelector('[data-amount]').value), sel = row.querySelector('[data-method]'), method = sel.value;
                    if (!(amount > 0)) { toastr.error(W2.amount); return; }
                    if (!idChecked()) { toastr.error(W.idFirst); idRow(); return; }
                    var ask = W2.askCollect.replace('{0}', amount + ' ' + row.getAttribute('data-cur')).replace('{1}', sel.options[sel.selectedIndex].text).replace('{2}', row.getAttribute('data-bill-no'));
                    cbConfirm(ask, { kind: 'primary' }).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post(U.deskCollect + row.getAttribute('data-bill') + '/Collect', { amount: amount, method: method, identityChecked: idChecked() })
                            .then(function (r) { t.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; } toastr.success(W.collected); bootstrap.Modal.getOrCreateInstance(modalEl).hide(); refresh(); });
                    });
                    return;
                }
                if ((t = e.target.closest('[data-open-patient]'))) { e.preventDefault(); openCard(t.getAttribute('data-open-patient'), true); return; }
                if ((t = e.target.closest('[data-desk-arrival]'))) { e.preventDefault(); arrivalWindow(t.getAttribute('data-desk-arrival')); return; }
                if ((t = e.target.closest('[data-arr-send]'))) { e.preventDefault(); arrSend(t); return; }
                if ((t = e.target.closest('[data-ho-remind]'))) { e.preventDefault(); t.disabled = true;
                    post(U.handoffsPost + '/' + t.getAttribute('data-ho-remind') + '/Remind').then(function (r) { t.disabled = false; if (!r.ok) { toastr.error(r.error || W.failed); return; } toastr.success(W5.chased); loadWork('handoff'); }); return; }
            });
        })();
    </script>
}
