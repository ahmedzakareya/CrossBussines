@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalSmsRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ bool canBook = ViewBag.CanBook == true; var inv = System.Globalization.CultureInfo.InvariantCulture; string At(DateTime u) => HospitalNursingService.UtcToWard(u).ToString("yyyy-MM-dd HH:mm", inv); }
@foreach (var r in Model)
{
    var m = r.Message;
    // one icon per kind, in its own tinted square
    var (icon, tint) = m.Kind switch
    {
        HospitalSmsKind.Booked => ("ki-calendar-tick", "primary"),
        HospitalSmsKind.Reminder => ("ki-notification-on", "info"),
        HospitalSmsKind.NoShow => ("ki-calendar-remove", "danger"),
        HospitalSmsKind.LabReady => ("ki-flask", "primary"),
        _ => ("ki-message-text-2", "primary"),
    };
    string st = m.Status switch { HospitalSmsStatus.Sent => "badge-light-primary", HospitalSmsStatus.Failed => "badge-light-danger", HospitalSmsStatus.Queued => "badge-light-primary", _ => "badge-light" };
    @* H128: a row of the theme's table widget (demo39 widgets/tables) — kind over the number and time; cancel is an icon *@
    <tr data-sms-row="@m.ID" class="@(m.Status == HospitalSmsStatus.Cancelled ? "opacity-75" : "")">
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-@tint"><i class="ki-outline @icon fs-3 text-@tint"></i></span></div>
            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6 text-nowrap">@T["smk:" + m.Kind]</span>
                <span class="text-muted fw-semibold d-block fs-7 text-nowrap"><bdi class="hp-num">@m.MessageNo</bdi> · <span class="hp-num" dir="ltr">@At(m.QueuedAt)</span></span></div></div></td>
        <td>@if (r.PatientName != null) {<div class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(r.PatientName, r.PatientNameEn ?? r.PatientName)</bdi></div><div class="text-muted fw-semibold fs-7 hp-num">@r.Mrn</div>}
            <div class="fs-7 fw-semibold hp-num text-gray-700" dir="ltr" style="text-align:start">@(m.Phone ?? "—")</div></td>
        <td><div class="fs-7 text-gray-800 fw-semibold" dir="@(m.Language == "ar" ? "rtl" : "ltr")" style="text-align:start">@m.Body</div>
            <div class="text-muted fs-8 mt-1"><span class="hp-num">@HospitalSmsRules.Parts(m.Body)</span>&nbsp;@T["SMS parts"]</div></td>
        <td><span class="badge @st fs-7 fw-bold text-nowrap">@T["sms:" + m.Status]</span>
            @if (m.SentAt is DateTime sa) {<div class="text-muted fs-8 mt-1 hp-num text-nowrap" dir="ltr">@At(sa)</div>}
            @if (m.Error != null) {<div class="text-muted fs-8 mt-1">@T[m.Error]</div>}
            @if (m.Attempts > 0 && m.Status != HospitalSmsStatus.Sent) {<div class="text-muted fs-8">@T["Tries"]&nbsp;<span class="hp-num">@m.Attempts</span></div>}</td>
        <td class="text-end pe-4">@if (canBook && HospitalSmsRules.CanCancel(m.Status)) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["Cancel"]" data-bs-toggle="tooltip" data-sms-cancel="@m.ID" data-ask="@string.Format(T["Cancel {0}? It will not be sent."].Value, "⁨" + m.MessageNo + "⁩")"><i class="ki-outline ki-cross-circle fs-3"></i></button> }</td>
    </tr>
}
