@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDialysisPatientPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H87 — one dialysis patient: the standing plan (changed in place, or stopped), the month at a glance (sessions done,
    days missed, the mean of the last three Kt/V), and the last sixty sessions, each with its gain, volume, rate,
    adequacy, lowest pressure and warnings.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Dialysis"].Value + " — " + DisplayName.Of(Model.Name, Model.NameEn);
    bool canPlan = ViewBag.CanPlan == true;
    var p = Model.Plan; bool active = p?.Status == HospitalDialysisPlanStatus.Active;
    var names = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.DayNames;
    string Days(int mask) => string.Join(" · ", Enumerable.Range(0, 7).Where(i => (mask & (1 << i)) != 0).Select(i => names[i]));
    string F1(decimal? x) => x?.ToString("0.#") ?? "—";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    // H128: one row of the theme's list widget (demo39 dashboards/logistics) — symbol · label over a muted line · value
    void Row(string icon, string tone, string label, string? sub, string value, bool last = false, bool ltr = true)
    {
        <div class="d-flex flex-stack">
            <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-3 text-@tone"></i></span></div>
            <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                <div class="me-3"><span class="text-gray-800 fw-bold fs-6">@label</span>@if (sub != null) {<span class="text-gray-500 fw-semibold fs-7 d-block"><bdi>@sub</bdi></span>}</div>
                @if (value != "") {<span class="text-gray-800 fw-bold fs-6 hp-num text-end" dir="@(ltr ? "ltr" : "auto")">@value</span>}
            </div>
        </div>
        if (!last) { <div class="separator separator-dashed my-3"></div> }
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Dialysis"] — @DisplayName.Of(Model.Name, Model.NameEn)</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("DialysisPatients")" class="text-muted text-hover-primary">@T["Dialysis patients"]</a></li></ul>
        </div>
        @if (canPlan)
        {
            <div class="d-flex gap-2">
                @if (active) {<button type="button" class="btn btn-sm btn-primary" data-plan-open><i class="ki-outline ki-pencil fs-4"></i>@T["Change the plan"]</button>
                    <button type="button" class="btn btn-sm btn-light-danger" data-plan-stop="@p!.ID"><i class="ki-outline ki-cross-circle fs-4"></i>@T["Stop the plan"]</button>}
                else {<button type="button" class="btn btn-sm btn-primary" data-plan-open><i class="ki-outline ki-plus fs-4"></i>@T["New dialysis plan"]</button>}
            </div>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 mb-5">
            @* H128: the patient's profile card (demo39 apps/user-management/users/view) with the standing plan as the theme's list widget (demo39 dashboards/logistics) *@
            <div class="col-xl-4"><div class="card card-flush h-100"><div class="card-body pt-10">
                <div class="d-flex flex-center flex-column mb-5">
                    <div class="symbol symbol-100px symbol-circle mb-5">@if (Model.Photo != null) {<img src="@Model.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fs-2x fw-bold hp-initials">@HospitalUi.Initials(Model.NameEn)</span>}</div>
                    <a href="@Url.Action("Patient", new { id = Model.PatientId })" class="fs-3 text-gray-800 text-hover-primary fw-bold mb-1">@DisplayName.Of(Model.Name, Model.NameEn)</a>
                    <div class="fs-6 fw-semibold text-gray-500 mb-4"><bdi class="hp-num">@Model.Mrn</bdi></div>
                    @if (p == null) {<span class="badge badge-lg badge-light-secondary">@T["No dialysis plan yet."]</span>}
                    else if (!active) {<span class="badge badge-lg badge-light-secondary">@T["The plan is stopped"] <span class="hp-num ms-1">@p.StoppedAt?.ToString("yyyy-MM-dd")</span></span>}
                    else {<span class="badge badge-lg badge-light-primary">@T["Shift {0}", p.Shift] · @T["dxa:" + p.Access]</span>}
                </div>
                @if (p != null)
                {
                    <div class="d-flex flex-stack fs-4 py-3"><div class="fw-bold">@T["Prescription"]</div></div>
                    <div class="separator separator-dashed mb-5"></div>
                    Row("abstract-26", "primary", T["Dry weight"].Value, null, p.DryWeightKg.ToString("0.0", inv) + " kg");
                    Row("calendar", "info", T["Dialysis days"].Value, string.Format(T["Shift {0}"].Value, p.Shift), Days(p.DaysMask), ltr: false);
                    Row("pulse", "danger", T["Vascular access"].Value, null, T["dxa:" + p.Access].Value, ltr: false);
                    Row("time", "primary", T["Hours"].Value, null, (p.DurationMin / 60m).ToString("0.#", inv));
                    Row("drop", "info", T["Blood / dialysate flow"].Value, null, p.BloodFlow + " / " + (p.DialysateFlow?.ToString() ?? "—") + " ml/min", last: p.Dialyzer == null && p.Anticoagulation == null && p.Note == null);
                    if (p.Dialyzer != null) { Row("filter", "success", T["Dialyser"].Value, null, p.Dialyzer, last: p.Anticoagulation == null && p.Note == null); }
                    if (p.Anticoagulation != null) { Row("capsule", "primary", T["Anticoagulation"].Value, p.Anticoagulation, "", last: p.Note == null, ltr: false); }
                    if (p.Note != null) { Row("notepad", "primary", T["Note"].Value, p.Note, "", last: true, ltr: false); }
                }
            </div></div></div>
            <div class="col-xl-8 d-flex flex-column gap-5">
                @* H128: the month as the theme's stat tiles (demo39 dashboards/logistics) *@
                @{
                    string ktTone = Model.AvgKtV == null ? "gray-400" : Model.AvgKtV < HospitalDialysisRules.MinKtV ? "danger" : "success";
                }
                <div class="row g-4">
                    <div class="col-4"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3"><div class="card-title d-flex flex-column"><span class="fs-2hx fw-bold text-gray-900 lh-1 hp-num">@Model.Done30</span><span class="text-gray-500 pt-1 fw-semibold fs-6">@T["Sessions in 30 days"]</span></div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-success"><i class="ki-outline ki-check-circle fs-2 text-success"></i></span></div></div></div>
                        <div class="card-body pt-0"></div></div></div>
                    <div class="col-4"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3"><div class="card-title d-flex flex-column"><span class="fs-2hx fw-bold lh-1 hp-num text-@(Model.Missed30 > 0 ? "danger" : "gray-900")">@Model.Missed30</span><span class="text-gray-500 pt-1 fw-semibold fs-6">@T["Missed in 30 days"]</span></div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@(Model.Missed30 > 0 ? "danger" : "primary")"><i class="ki-outline ki-cross-circle fs-2 text-@(Model.Missed30 > 0 ? "danger" : "primary")"></i></span></div></div></div>
                        <div class="card-body pt-0"></div></div></div>
                    <div class="col-4"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3"><div class="card-title d-flex flex-column"><span class="fs-2hx fw-bold lh-1 hp-num text-@(ktTone == "danger" ? "danger" : "gray-900")" dir="ltr">@(Model.AvgKtV?.ToString("0.00", inv) ?? "—")</span><span class="text-gray-500 pt-1 fw-semibold fs-6">@T["Kt/V, mean of the last three"]</span></div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@(ktTone == "gray-400" ? "primary" : ktTone)"><i class="ki-outline ki-flask fs-2 text-@(ktTone == "gray-400" ? "primary" : ktTone)"></i></span></div></div></div>
                        <div class="card-body pt-0">@if (Model.AvgKtV != null) {<span class="badge badge-light-@ktTone fs-7 fw-bold">@T[Model.AvgKtV < HospitalDialysisRules.MinKtV ? "Below the target" : "On target"]</span>}</div></div></div>
                </div>
                @* H128: the sessions as the theme's table widget (demo39 widgets/tables) *@
                <div class="card card-flush flex-grow-1">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Sessions"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Targets: Kt/V at least 1.2, URR at least 65 %, ultrafiltration under 13 ml/kg/h, a gain under 4 % of the dry weight."]</span></h3></div>
                    <div class="card-body pt-2">
                        @if (Model.History.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-calendar fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No session yet."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Date"]</th><th>@T["Weight"]</th><th>@T["Gain"]</th><th>@T["UF"]</th><th>@T["Minutes"]</th><th dir="ltr">URR</th><th dir="ltr">Kt/V</th><th>@T["Lowest pressure"]</th><th class="pe-4 rounded-end">@T["Warnings"]</th></tr></thead>
                                <tbody>
                                @foreach (var h in Model.History)
                                {
                                    var s = h.Session; var o = h.Outcome;
                                    <tr>
                                        <td class="ps-4 text-nowrap">@if (s.Status != HospitalDialysisSessionStatus.Missed) {<a href="@Url.Action("DialysisSession", new { id = s.ID })" class="text-gray-900 fw-bold text-hover-primary fs-6 hp-num d-block">@s.SessionDate.ToString("yyyy-MM-dd")</a>} else {<span class="text-gray-900 fw-bold fs-6 hp-num d-block">@s.SessionDate.ToString("yyyy-MM-dd")</span>}
                                            @if (s.Status != HospitalDialysisSessionStatus.Done) {<span class="badge badge-light-@(s.Status == HospitalDialysisSessionStatus.Missed ? "secondary" : "info") fs-8 fw-bold mt-1">@T["dxs:" + s.Status]</span>}</td>
                                        @if (s.Status == HospitalDialysisSessionStatus.Missed)
                                        {
                                            <td colspan="8" class="pe-4"><span class="text-gray-500 fw-semibold fs-7"><bdi>@s.MissedReason</bdi></span></td>
                                        }
                                        else
                                        {
                                            <td><span class="text-gray-800 fw-bold hp-num text-nowrap" dir="ltr">@F1(s.PreWeightKg) → @F1(s.PostWeightKg)</span></td>
                                            <td>@if (o.GainPct != null) {<span class="badge badge-light-@(o.GainPct > HospitalDialysisRules.MaxGainPct ? "danger" : "success") fs-7 fw-bold hp-num" dir="ltr">@F1(o.GainPct)&nbsp;%</span>} else {<span class="text-gray-400">—</span>}</td>
                                            <td class="text-nowrap"><span class="text-gray-800 fw-bold hp-num d-block" dir="ltr">@(o.UfMl?.ToString() ?? "—")</span>@if (o.UfRate != null) {<span class="fs-7 hp-num @(o.UfRate > HospitalDialysisRules.MaxUfRate ? "text-danger fw-bold" : "text-gray-500 fw-semibold")" dir="ltr">@F1(o.UfRate)&nbsp;ml/kg/h</span>}</td>
                                            <td><span class="text-gray-800 fw-bold hp-num">@(o.Minutes?.ToString() ?? "—")</span></td>
                                            <td>@if (o.Urr != null) {<span class="badge badge-light-@(o.Urr < HospitalDialysisRules.MinUrr ? "danger" : "success") fs-7 fw-bold hp-num" dir="ltr">@F1(o.Urr)&nbsp;%</span>} else {<span class="text-gray-400">—</span>}</td>
                                            <td>@if (o.KtV != null) {<span class="badge badge-light-@(o.KtV < HospitalDialysisRules.MinKtV ? "danger" : "success") fs-7 fw-bold hp-num" dir="ltr">@o.KtV.Value.ToString("0.00", inv)</span>} else {<span class="text-gray-400">—</span>}</td>
                                            <td><span class="hp-num fw-bold @(o.NadirSbp < HospitalDialysisRules.HypotensionNadir ? "text-danger" : "text-gray-800")">@(o.NadirSbp?.ToString() ?? "—")</span></td>
                                            <td class="pe-4">@if (o.Warnings.Count == 0) {<span class="text-gray-400">—</span>} else {<div class="d-flex flex-wrap gap-1">@foreach (var w in o.Warnings) {<span class="badge badge-light-danger fs-8 fw-bold">@T["dxw:" + w]</span>}</div>}</td>
                                        }
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>
@if (canPlan)
{
    ViewData["DxPatientId"] = Model.PatientId;
    <partial name="_DialysisPlanModal" model="@(active ? p : null)" />
}
@section Scripts {
    <script>
        (function () {
            var tok = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), stop: @Json.Serialize(T["Stop this patient's dialysis plan? The sessions stay on the file."].Value) };
            document.addEventListener('click', function (e) {
                var b = e.target.closest('[data-plan-stop]'); if (!b) return;
                cbConfirm(W.stop, { kind: 'danger' }).then(function (ok) { if (!ok) return; b.disabled = true;
                    fetch(@Json.Serialize(Url.Content("~/Hospital/Dialysis/Plan/")) + b.getAttribute('data-plan-stop') + '/Stop', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: '{}' })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { b.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }); });
            });
        })();
    </script>
}
