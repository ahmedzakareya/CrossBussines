@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalQcPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H232 — laboratory quality control: every control material with its Levey-Jennings chart (the last 20 runs against
    the mean and ±1/2/3 SD), the Westgard verdict of each run, and a run recorded at the bench. An out-of-control
    material is listed first: its test takes no patient result until an accepted run. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Quality control"].Value;
    string q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages; bool canSet = ViewBag.CanSet == true;
    string Link(int p) => Url.Action("LabQc", new { q, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Tone(string? s) => s == HospitalQcStatus.Rejected ? "danger" : s == HospitalQcStatus.Warning ? "info" : "primary";
    string Y(decimal z) => (80 - (double)Math.Clamp(z, -4m, 4m) * 18).ToString("0.#", inv);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Quality control"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Lab")" class="text-muted text-hover-primary">@T["Laboratory"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Quality control"]</li>
            </ul>
        </div>
        @if (canSet && Model.Ready) {<button type="button" class="btn btn-sm btn-primary" data-qc-new><i class="ki-outline ki-plus fs-4"></i>@T["Add a control material"]</button>}
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["Quality control is not installed yet (hospital_h232_lab_qc.sql)."]</div></div>
        }
        @if (Model.OutOfControl > 0)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mb-5">
                <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["{0} controls out", Model.OutOfControl]</h4>
                    <div class="fs-7 text-gray-700">@T["Their tests take no patient result until a control of the same material is accepted."]</div></div>
            </div>
        }
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Control materials"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Westgard rules: 1-2s warns; 1-3s, 2-2s, R-4s, 4-1s and 10x reject."]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("LabQc")">
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-250px ps-12" placeholder="@T["Search an analyte, test or lot"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
        </div>
        @if (Model.Rows.Count == 0 && Model.Ready)
        {
            <div class="card"><div class="card-body text-center py-15"><i class="ki-outline ki-chart-line fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No control material yet."]</div></div></div>
        }
        <div class="row g-5">
            @foreach (var r in Model.Rows)
            {
                var m = r.Material; var pts = r.Points; double step = pts.Count > 1 ? 360.0 / (pts.Count - 1) : 0;
                <div class="col-xl-6"><div class="card card-flush h-100 @(r.LatestStatus == HospitalQcStatus.Rejected ? "border border-danger" : "")" data-qc="@m.ID">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800" dir="auto">@DisplayName.Of(r.Analyte, r.AnalyteEn) <span class="text-muted fs-7 fw-semibold">· @r.Test</span></span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num" dir="ltr">@T["Lot"] @m.Lot · L@(m.Level) · @m.Mean.ToString("0.###", inv) ± @m.Sd.ToString("0.###", inv) @r.Unit@if (m.ExpiresOn is DateTime ex) {<text> · @T["expires"] @ex.ToString("yyyy-MM-dd", inv)</text>}</span>
                        </h3>
                        <div class="card-toolbar gap-2">
                            @if (r.LatestStatus != null) {<span class="badge badge-light-@Tone(r.LatestStatus) fs-7 fw-bold">@T["qc:" + r.LatestStatus]</span>}
                            @if (canSet) {<button type="button" class="btn btn-sm btn-icon btn-light" title="@T["Retire this lot"]" data-bs-toggle="tooltip" data-qc-retire="@m.ID"><i class="ki-outline ki-archive fs-4"></i></button>}
                        </div>
                    </div>
                    <div class="card-body pt-2">
                        @* Levey-Jennings: mean, ±1/±2/±3 SD; each run a point coloured by its verdict *@
                        <svg viewBox="0 0 400 160" class="w-100" style="max-height:180px" role="img" aria-label="Levey-Jennings">
                            @foreach (var (z, cls, dash) in new (int, string, string)[] { (3, "danger", "4 3"), (2, "info", "4 3"), (1, "gray-300", "2 3"), (0, "primary", ""), (-1, "gray-300", "2 3"), (-2, "info", "4 3"), (-3, "danger", "4 3") })
                            {
                                <line x1="20" x2="380" y1="@Y(z)" y2="@Y(z)" stroke="var(--bs-@cls)" stroke-width="@(z == 0 ? 1.5 : 1)" stroke-dasharray="@dash" />
                                @Html.Raw("<text x=\"0\" y=\"" + (80 - z * 18 + 3).ToString(inv) + "\" font-size=\"9\" fill=\"var(--bs-gray-500)\" direction=\"ltr\">" + (z == 0 ? "x̄" : (z > 0 ? "+" : "") + z.ToString(inv)) + "</text>")
                            }
                            @if (pts.Count > 1) {<polyline fill="none" stroke="var(--bs-gray-400)" stroke-width="1" points="@string.Join(" ", pts.Select((p, i) => (20 + i * step).ToString("0.#", inv) + "," + Y(p.Z)))" />}
                            @for (int i = 0; i < pts.Count; i++)
                            {
                                var p = pts[i];
                                <circle cx="@((20 + i * step).ToString("0.#", inv))" cy="@Y(p.Z)" r="4" fill="var(--bs-@Tone(p.Status))"><title>@p.At.ToLocalTime().ToString("MM-dd HH:mm", inv) · @p.Value.ToString("0.###", inv) (z @HospitalQcRules.Zs(p.Z))@(p.Violations != null ? " · " + p.Violations : "")</title></circle>
                            }
                        </svg>
                        @if (pts.Count > 0 && pts[^1] is var last && last.Violations != null)
                        {
                            <div class="fs-7 text-gray-700 mb-3"><span class="badge badge-light-@Tone(last.Status) me-2" dir="ltr">@last.Violations</span>@if (last.Action != null) {<span dir="auto">@last.Action</span>}</div>
                        }
                        <div class="d-flex gap-2 align-items-center">
                            <input class="form-control form-control-sm form-control-solid hp-num w-125px" dir="ltr" inputmode="decimal" placeholder="@T["Value"]" data-qc-value />
                            <input class="form-control form-control-sm form-control-solid" dir="auto" maxlength="300" placeholder="@T["Corrective action (if rejected)"]" data-qc-action />
                            <button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-qc-run="@m.ID"><i class="ki-outline ki-check fs-4"></i>@T["Record the run"]</button>
                        </div>
                    </div>
                </div></div>
            }
        </div>
        @if (pages > 1)
        {
            <ul class="pagination mt-6">
                <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                @for (int p = Math.Max(1, page - 3); p <= Math.Min(pages, page + 3); p++) {<li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>}
                <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
            </ul>
        }
    </div></div>
</div>

<div class="modal fade" id="qcNew" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-600px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Add a control material"]</h1><div class="text-muted fw-semibold fs-6">@T["The lot's target mean and standard deviation, from its insert or your own 20 runs."]</div></div>
        <div class="mb-5"><label class="required fs-6 fw-semibold mb-2">@T["Analyte"]</label>
            <select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#qcNew" data-placeholder="@T["Choose the analyte"]" data-qn="analyteId">
                <option></option>@foreach (var a in Model.Analytes) {<option value="@a.Id">@DisplayName.Of(a.Name, a.NameEn) — @a.Test</option>}</select></div>
        <div class="row g-5 mb-5">
            <div class="col-md-6"><label class="required fs-6 fw-semibold mb-2">@T["Lot"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="40" data-qn="lot" /></div>
            <div class="col-md-6"><label class="required fs-6 fw-semibold mb-2">@T["Level"]</label>
                <select class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-dropdown-parent="#qcNew" data-qn="level">
                    <option value="1">@T["Level 1 (low)"]</option><option value="2" selected>@T["Level 2 (normal)"]</option><option value="3">@T["Level 3 (high)"]</option></select></div>
            <div class="col-md-4"><label class="required fs-6 fw-semibold mb-2">@T["Mean"]</label><input class="form-control form-control-solid hp-num" dir="ltr" inputmode="decimal" data-qn="mean" /></div>
            <div class="col-md-4"><label class="required fs-6 fw-semibold mb-2">@T["SD"]</label><input class="form-control form-control-solid hp-num" dir="ltr" inputmode="decimal" data-qn="sd" /></div>
            <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Expires"]</label><input type="date" class="form-control form-control-solid" data-qn="expiresOn" /></div>
        </div>
        <div class="text-center pt-5"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-qc-save>@T["Save"]</button></div>
    </div>
</div></div></div>

@section Scripts {
    <script>
        (function () {
            var tk = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tk) return;
            var token = tk.value, root = @Json.Serialize(Url.Content("~/Hospital/Lab/Qc")), mn = document.getElementById('qcNew');
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), retire: @Json.Serialize(T["Retire this lot? Its runs stay; it no longer gates the test."].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function num(v) { v = (v || '').trim(); return v === '' ? null : Number(v); }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-qc-new],[data-qc-save],[data-qc-run],[data-qc-retire]'); if (!t) return;
                if (t.hasAttribute('data-qc-new')) { bootstrap.Modal.getOrCreateInstance(mn).show(); return; }
                if (t.hasAttribute('data-qc-retire')) {
                    cbConfirm(W.retire, { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(root + '/Materials/' + t.getAttribute('data-qc-retire') + '/Retire').then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }); });
                    return;
                }
                t.disabled = true;
                if (t.hasAttribute('data-qc-save')) {
                    var v = function (n) { return mn.querySelector('[data-qn="' + n + '"]').value; };
                    post(root + '/Materials', { analyteId: +(v('analyteId') || 0), lot: v('lot'), level: +v('level'), mean: num(v('mean')), sd: num(v('sd')), expiresOn: v('expiresOn') || null })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
                    return;
                }
                var card = t.closest('[data-qc]');
                post(root + '/Materials/' + t.getAttribute('data-qc-run') + '/Runs', { value: num(card.querySelector('[data-qc-value]').value), action: card.querySelector('[data-qc-action]').value || null })
                    .then(function (res) {
                        t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                        (res.status === 'Rejected' ? toastr.error : res.status === 'Warning' ? toastr.info : toastr.success)(res.statusText + (res.violations && res.violations.length ? ' — ' + res.violations.join(', ') : ''));
                        setTimeout(function () { location.reload(); }, 900);
                    });
            });
        })();
    </script>
}
