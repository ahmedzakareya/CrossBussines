@using System.Globalization
@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalVisitModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H94 — the specialty visit (the approved prototype screen sc-im): the patient, the templates, the doctor and the
    alerts; the figures on top; the visit form (the templates filled together); the trends from the stored
    observations; the care gaps; the KDIGO kidney stage; the order sets the visit's diagnoses propose. One signature
    with the consultation.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    bool isAr = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var e = Model.Visit.Encounter; var p = Model.Patient; bool canEdit = Model.CanEdit;
    var name = DisplayName.Of(p.Name, p.NameEn);
    string Nm(string ar, string? en) => isAr ? ar : (en ?? ar);
    string clinic = Model.Clinic == null ? T["Clinic"].Value : Nm(Model.Clinic.Name, Model.Clinic.NameEn);
    var W = ViewBag.Widgets as HospitalVisitWidgets;
    var facts = ViewBag.Facts as HospitalPatientFacts;   // H116: her sex, age and trimester — whether a range alert applies
    string heading = Model.Forms.Count == 0 ? string.Format(T["{0} — follow-up visit"].Value, clinic) : clinic + " — " + Nm(Model.Forms[0].Template.Name, Model.Forms[0].Template.NameEn);
    ViewData["Title"] = heading + " — " + name;
    var age = HospitalPatientService.AgeOn(p.BirthDate, DateTime.UtcNow);
    string[] Lines(string? s) => (s ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    string Val(HospitalConcept c, HospitalObsPoint? o)
    {
        if (o == null) return "—";
        if (o.Code != null) { var ch = HospitalConceptRules.Choices(c.Choices).FirstOrDefault(x => x.Code == o.Code); return ch.Code == null ? o.Code : (isAr ? ch.Ar : ch.En); }
        if (c.Unit == "logMAR" && o.Value is decimal lm) return HospitalVision.Snellen6(lm) + " (" + HospitalConceptRules.Num(lm, 2) + ")";
        var v = o.Value is decimal a ? HospitalConceptRules.Num(a, c.Decimals) : "";
        return o.Value2 is decimal b ? v + "/" + HospitalConceptRules.Num(b, c.Decimals) : v;
    }
    string D(decimal? d) => d?.ToString("0.####", CultureInfo.InvariantCulture) ?? "";
    var tplNames = string.Join(" + ", Model.Forms.Select(f => Nm(f.Template.Name, f.Template.NameEn) + " v" + f.Version.Version));
    var kdc = Model.Kdigo;
    string[][] KG = { new[] { "G1", "≥90", "lo", "mo", "hi" }, new[] { "G2", "60–89", "lo", "mo", "hi" }, new[] { "G3a", "45–59", "mo", "hi", "vh" }, new[] { "G3b", "30–44", "hi", "vh", "vh" }, new[] { "G4", "15–29", "vh", "vh", "vh" }, new[] { "G5", "<15", "vh", "vh", "vh" } };
    string[] AC = { "A1", "A2", "A3" };
    var primary = Model.Visit.Diagnoses.FirstOrDefault(d => d.IsPrimary) ?? Model.Visit.Diagnoses.FirstOrDefault();
    var seenConcepts = new HashSet<int>();   // a concept two templates ask is asked once: the second mirrors the first
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
<style>
    .hp-kd td { width: 25%; text-align: center; font-weight: 700; padding: .55rem .3rem !important; border: 2px solid #fff; }
    .hp-kd .lo { background: #DCFCE7; color: #166534; } .hp-kd .mo { background: #DBEAFE; color: #1E40AF; } .hp-kd .hi { background: #FECACA; color: #991B1B; } .hp-kd .vh { background: #DC2626; color: #fff; }
    .hp-kd .me { outline: 3px solid #111827; outline-offset: -3px; }
    .hp-gap { display: flex; gap: 1rem; align-items: center; padding: .85rem 0; border-bottom: 1px dashed var(--bs-gray-300, #E4E6EF); }
    .hp-gap:last-child { border-bottom: 0; }
</style>
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@heading</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Specialty clinics"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Consult", new { id = e.ID })" class="text-muted text-hover-primary">@T["Consultation"]</a></li>
            </ul>
        </div>
        <div class="d-flex gap-2">
            @if (W?.Child == true) {<a href="@Url.Content("~/Hospital/Patients/" + p.ID + "/Vaccines")" class="btn btn-sm btn-light"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Vaccines"]</a>}
            @* H109: the patient's emergency plan — an allergy visit, once signed *@
            @if (e.Status == HospitalEncounterStatus.Signed && (W?.Adrenaline?.Needed == true || W?.Spt != null || W?.Immuno != null))
            {
                <span class="align-self-center fs-7 text-gray-700">@T["Patient emergency plan"]</span>
                @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalAllergyVisit, DocumentId = e.ID.ToString(), DocumentTitle = "V-" + e.ID.ToString("D6") })
            }
            @if (canEdit)
            {
                <span class="text-muted fs-8 align-self-center" id="saveState"></span>
                <button type="button" class="btn btn-sm btn-light" data-problems><i class="ki-outline ki-plus fs-4"></i>@T["Add to problem list"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-sign><i class="ki-outline ki-check fs-4"></i>@T["Sign the visit"]</button>
            }
            else if (e.Status == HospitalEncounterStatus.Signed)
            {
                <span class="badge badge-light-success fs-7 px-4 py-3"><i class="ki-outline ki-check-circle fs-5 text-success me-1"></i>@T["Signed"]</span>
            }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H106: an alert opened another template on this visit — it must be filled before the visit is signed *@
        <div class="notice d-flex align-items-center bg-light-danger rounded border-danger border border-dashed p-5 mb-5 d-none" id="escOpened">
            <i class="ki-outline ki-notification-bing fs-2tx text-danger me-4"></i>
            <div class="flex-grow-1 fw-semibold"><div class="fs-6 text-gray-900 fw-bold">@T["An alert opened another template on this visit"]</div><div class="fs-7 text-gray-700">@T["Fill it before the patient leaves: the visit cannot be signed without it."]</div></div>
            <button type="button" class="btn btn-sm btn-danger" onclick="location.reload()">@T["Open it"]</button>
        </div>
        @* the visit head: the person, the templates, the doctor, the alerts *@
        @* H127: the visit head as the theme's profile header (demo39 apps/user-management/users/view): the person, then
           the template and the doctor as dashed stat boxes, then the alerts as badges *@
        <div class="card card-flush mb-5"><div class="card-body d-flex flex-wrap align-items-center gap-5 py-6">
            <div class="d-flex align-items-center">
                <div class="symbol symbol-65px symbol-circle me-4 flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label fs-3 fw-bold hp-initials">@HospitalUi.Initials(p.NameEn)</span>}</div>
                <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = p.ID })" class="text-gray-900 text-hover-primary fs-3 fw-bold">@name</a>
                    <span class="text-gray-500 fw-semibold fs-7"><bdi class="hp-num">@p.Mrn</bdi> · @if (age != null) {<span class="text-nowrap"><bdi class="hp-num">@age</bdi>&nbsp;@T["y"]</span><text> · </text>}@T["sex:" + p.Sex]</span></div>
            </div>
            <div class="border border-gray-300 border-dashed rounded py-3 px-4 min-w-0">
                <div class="d-flex align-items-center"><i class="ki-outline ki-notepad-edit fs-3 text-primary me-2"></i><span class="fs-6 fw-bold text-gray-800">@(tplNames.Length == 0 ? "—" : tplNames)</span></div>
                <div class="fw-semibold fs-7 text-gray-500">@T["Template"]</div>
            </div>
            <div class="border border-gray-300 border-dashed rounded py-3 px-4">
                <div class="d-flex align-items-center"><i class="ki-outline ki-user-tick fs-3 text-primary me-2"></i><span class="fs-6 fw-bold text-gray-800">@(Model.Doctor == null ? "—" : DisplayName.Of(Model.Doctor.Name, Model.Doctor.NameEn))</span></div>
                <div class="fw-semibold fs-7 text-gray-500">@T["Doctor"]</div>
            </div>
            <div class="ms-auto d-flex flex-wrap gap-2 justify-content-end">
                @foreach (var a in Lines(p.Allergies)) {<span class="badge badge-light-danger fw-bold fs-7">@T["Allergy: {0}", a]</span>}
                @* H107: the adrenaline auto-injector (the prototype's allergy visit head) *@
                @if (W?.Adrenaline is { } adr)
                {
                    if (adr.Anaphylaxis) {<span class="badge badge-light-danger fw-bold fs-7">@T["Previous anaphylaxis"]</span>}
                    if (adr.Prescribed) {<span class="badge badge-light-success fw-bold fs-7">@T["Adrenaline auto-injector: prescribed"]</span>}
                    else if (adr.Needed) {<a href="@Url.Action("Consult", new { id = e.ID })" class="badge badge-danger fw-bold fs-7">@T["Adrenaline auto-injector: not prescribed"]</a>}
                }
                @foreach (var d in Model.Visit.Diagnoses) {<span class="badge badge-light-primary fw-bold fs-7">@Nm(d.Name, d.NameEn)</span>}
                @if (kdc != null) {<span class="badge badge-light-danger fw-bold fs-7 hp-num">CKD @kdc.G @kdc.A</span>}
                @if (W?.Child == true && W.VaccinesReady)
                {
                    if (W.VaccinesOverdue > 0) {<span class="badge badge-light-danger fw-bold fs-7">@T["Vaccine doses overdue: {0}", W.VaccinesOverdue]</span>}
                    else if (W.VaccinesDue > 0) {<span class="badge badge-light-primary fw-bold fs-7">@T["Vaccine doses due: {0}", W.VaccinesDue]</span>}
                    else {<span class="badge badge-light-info fw-bold fs-7">@T["Vaccines up to date"]</span>}
                }
            </div>
        </div></div>

        @if (W != null && W.Crossing.Crossed && W.Crossing.From != null && W.Crossing.To != null)
        {
            var cf = W.Crossing.From; var ctp = W.Crossing.To; bool falling = ctp.Z < cf.Z;
            string crossKey = falling ? "From P{0} at age {1} to P{2} today — a gradual fall that needs a nutrition review and a cause." : "From P{0} at age {1} to P{2} today — a gradual rise that needs a nutrition review and a cause.";
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-4">
                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Weight has crossed two percentile lines"]</h4>
                        <div class="fs-6 text-gray-700">@T[crossKey, cf.Percentile?.ToString("0") ?? "—", (cf.AgeDays / 365.25).ToString("0.#"), ctp.Percentile?.ToString("0") ?? "—"]</div></div>
                    <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0 hp-num">z @(ctp.Z?.ToString("+0.00;-0.00"))</span>
                </div>
            </div>
        }

        @if (W?.Glaucoma is { Suspect: true } gl)
        {
            decimal? iop = gl.Side == "R" ? gl.IopR : gl.IopL; decimal? cd = gl.Side == "R" ? gl.CdR : gl.CdL;
            string eye = gl.Side == "R" ? T["The right eye"].Value : T["The left eye"].Value;
            string title = iop != null && cd != null ? string.Format(T["{0}: pressure {1} with a {2} cup"].Value, eye, HospitalConceptRules.Num(iop.Value, 0), HospitalConceptRules.Num(cd.Value, 1))
                : iop != null ? string.Format(T["{0}: pressure {1}"].Value, eye, HospitalConceptRules.Num(iop.Value, 0)) : string.Format(T["{0}: a {1} cup"].Value, eye, HospitalConceptRules.Num(cd!.Value, 1));
            string reasons = string.Join(isAr ? "، " : ", ", gl.Reasons.Select(r => T["glau:" + r].Value));
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5">
                <i class="ki-outline ki-eye fs-2tx text-danger me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-4">
                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@title</h4>
                        <div class="fs-6 text-gray-700">@reasons — @T["glaucoma suspected: visual fields, an optic-nerve OCT and a review in 6 weeks."]</div></div>
                    <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0 hp-num" dir="ltr">OD @(gl.IopR is decimal a ? HospitalConceptRules.Num(a, 0) : "—") / OS @(gl.IopL is decimal b ? HospitalConceptRules.Num(b, 0) : "—")</span>
                </div>
            </div>
        }

        @* the figures on top: the fields marked to head the visit, and the care gaps *@
        @if (Model.Headlines.Count > 0)
        {
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var h in Model.Headlines)
            {
                bool bad = h.Last != null && HospitalObsFlag.Abnormal(h.Last.Flag);
                string sub = "";
                if (h.Last != null && h.Previous != null && h.Last.Value is decimal lv && h.Previous.Value is decimal pv && lv != pv)
                    sub = string.Format(T[lv > pv ? "↑ from {0}" : "↓ from {0}"].Value, Val(h.Concept, h.Previous));
                bool alerted = h.Last?.Value is decimal av && (h.Field.AlertAbove <= av || h.Field.AlertBelow >= av || HospitalFieldAlertRules.OutsideRange(h.Field, h.Last.Flag, facts));   // H116
                if (alerted) sub += (sub.Length > 0 ? " — " : "") + (isAr ? h.Field.AlertText : h.Field.AlertTextEn ?? h.Field.AlertText);
                else if (sub.Length == 0) sub = h.Last?.Flag == HospitalObsFlag.Unknown ? T["No range to compare with"].Value : T["Normal"].Value + " " + HospitalConceptRules.NormalDisplay(h.Concept, isAr);
                if (h.Concept.HasLaterality)
                {
                    var lr = h.Points.LastOrDefault(x => x.Side == "R"); var ll = h.Points.LastOrDefault(x => x.Side == "L");
                    bool badR = lr != null && HospitalObsFlag.Abnormal(lr.Flag), badL = ll != null && HospitalObsFlag.Abnormal(ll.Flag);
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3"><div class="card-title d-flex flex-column">
                        <div class="fs-2hx fw-bold lh-1 hp-num" dir="ltr">@{ string Tv(decimal? x) => x is decimal d ? (h.Concept.Unit == "logMAR" ? HospitalVision.Snellen6(d) : HospitalConceptRules.Num(d, h.Concept.Decimals)) : "—"; }<span class="@(badR ? "text-danger" : "text-gray-900")">@Tv(lr?.Value)</span><span class="text-gray-400"> / </span><span class="@(badL ? "text-danger" : "text-gray-900")">@Tv(ll?.Value)</span></div>
                        <span class="text-gray-500 pt-1 fw-semibold fs-6">@Nm(h.Concept.Name, h.Concept.NameEn)</span></div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@(badR || badL ? "danger" : "primary")"><i class="ki-outline ki-eye fs-2 text-@(badR || badL ? "danger" : "primary")"></i></span></div></div></div>
                        <div class="card-body d-flex align-items-end pt-0"><div class="d-flex align-items-center"><span class="bullet bullet-dot bg-@(badR || badL ? "danger" : "primary") h-6px w-6px me-2"></span><span class="text-gray-500 fw-semibold fs-7" dir="ltr">OD / OS @(h.Concept.Unit != null ? "· " + h.Concept.Unit : "")</span></div></div>
                    </div></div>
                    continue;
                }
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3"><div class="card-title d-flex flex-column">
                        <span class="fs-2hx fw-bold lh-1 @(bad ? "text-danger" : "text-gray-900")"><bdi class="hp-num">@Val(h.Concept, h.Last)@(h.Last != null && (h.Concept.Unit == "%" || (h.Concept.Unit ?? "").StartsWith("/")) ? h.Concept.Unit : "")</bdi></span>
                        <span class="text-gray-500 pt-1 fw-semibold fs-6">@Nm(h.Concept.Name, h.Concept.NameEn)</span></div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@(bad || alerted ? "danger" : "primary")"><i class="ki-outline ki-pulse fs-2 text-@(bad || alerted ? "danger" : "primary")"></i></span></div></div></div>
                    <div class="card-body d-flex align-items-end pt-0"><div class="d-flex align-items-center"><span class="bullet bullet-dot bg-@(bad || alerted ? "danger" : "success") h-6px w-6px me-2 flex-shrink-0"></span><span class="@(alerted ? "text-danger" : "text-gray-500") fw-semibold fs-7">@sub</span></div></div>
                </div></div>
            }
            @{ int gaps = Model.Care.Count(c => c.Kind == "Gap"); }
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                <div class="card-header pt-5 flex-nowrap gap-3"><div class="card-title d-flex flex-column">
                    <span class="fs-2hx fw-bold lh-1 hp-num @(gaps > 0 ? "text-danger" : "text-gray-900")">@gaps</span>
                    <span class="text-gray-500 pt-1 fw-semibold fs-6">@T["Care gaps"]</span></div>
                    <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@(gaps > 0 ? "danger" : "success")"><i class="ki-outline ki-calendar-tick fs-2 text-@(gaps > 0 ? "danger" : "success")"></i></span></div></div></div>
                <div class="card-body d-flex align-items-end pt-0"><div class="text-gray-500 fw-semibold fs-7">@(gaps == 0 ? T["Nothing overdue"].Value : string.Join(isAr ? "، " : ", ", Model.Care.Where(c => c.Kind == "Gap").Select(c => isAr ? c.Text : c.TextEn)))</div></div>
            </div></div>
        </div>
        }

        <div class="row g-5">
            <div class="col-xl-@(W?.Growth.Count > 0 ? 8 : 7)">
                @if (W?.Spt != null)
                {
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Skin prick test"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Positive = wheal 3 mm or more above the negative control — computed"]</span></div></div>
                        <div class="card-body pt-2">
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Allergen"]</th><th class="text-center">@T["Wheal mm"]</th><th class="text-center">@T["Flare mm"]</th><th class="text-center pe-4 rounded-end">@T["Result"]</th></tr></thead>
                                <tbody>
                                    @foreach (var r in W.Spt.Rows)
                                    {
                                        <tr class="@(r.Control ? "bg-light" : "")"><td class="ps-4 text-gray-900 fw-bold fs-6">@(isAr ? r.Label : r.LabelEn)</td>
                                            <td class="text-center hp-num @(r.Positive == true ? "text-danger fw-bold" : "")">@(r.Wheal?.ToString("0.#") ?? "—")</td><td class="text-center hp-num">@(r.Flare?.ToString("0.#") ?? "—")</td>
                                            <td class="text-center pe-4">@if (r.Control) {<span class="badge badge-light fs-7 fw-bold">@T["Control"]</span>} else if (r.Positive == true) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Positive"]</span>} else if (r.Positive == false) {<span class="badge badge-light-success fs-7 fw-bold">@T["Negative"]</span>} else {<span class="text-muted">—</span>}</td></tr>
                                    }
                                </tbody>
                            </table></div>
                            <div class="mt-4">@if (W.Spt.Valid == true) {<span class="badge badge-light-success fs-7 fw-bold">@T["Test valid: saline ≤ 3 and histamine 3 mm or more above it"]</span>} else if (W.Spt.Valid == false) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Test invalid: read no result — repeat it (check antihistamines, the controls)"]</span>} else {<span class="badge badge-light fs-7 fw-bold">@T["Write both controls to read the test"]</span>}</div>
                        </div>
                    </div>
                }
                @if (W?.Growth.Count > 0)
                {
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5">
                            <div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Growth chart — WHO"] (@(p.Sex == "F" ? T["girls"] : T["boys"]))</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Points from the observations of every visit; z and percentile computed by the LMS method"]</span></div>
                            <div class="card-toolbar"><select class="form-select form-select-solid form-select-sm w-200px" id="growthPick" data-control="none">@foreach (var g in W.Growth) {<option value="@g.Indicator">@T["gi:" + g.Indicator]</option>}</select></div>
                        </div>
                        <div class="card-body pt-2"><div id="growthChart"></div></div>
                    </div>
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Measurements"]</span></div></div>
                        <div class="card-body pt-2"><div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Date"]</th><th>@T["Age"]</th><th>@T["Value"]</th><th>z</th><th class="pe-4 rounded-end">@T["Percentile"]</th></tr></thead>
                            <tbody id="growthRows"></tbody></table></div></div>
                    </div>
                }
                <div class="card card-flush mb-5 mb-xl-8">
                    <div class="card-header pt-5">
                        <div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Visit form"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Known values come from the lab and earlier visits; red is out of range"]</span></div>
                        @if (canEdit && Model.Offer.Count > 0)
                        {
                            <div class="card-toolbar gap-2"><select class="form-select form-select-solid form-select-sm w-200px" id="addTpl" data-control="none">@foreach (var t in Model.Offer) {<option value="@t.ID">@Nm(t.Name, t.NameEn)</option>}</select>
                                <button type="button" class="btn btn-sm btn-light-primary" data-addtpl><i class="ki-outline ki-plus fs-4"></i>@T["Add a template"]</button></div>
                        }
                    </div>
                    <div class="card-body pt-2" id="visitForm">
                        @if (Model.Forms.Count == 0) {<div class="text-center py-10"><i class="ki-outline ki-notepad-edit fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No template on this visit yet: add one of the clinic's templates."]</div></div>}
                        @foreach (var vf in Model.Forms)
                        {
                            bool signed = vf.Form.Status == HospitalFormStatus.Signed; string dis = signed || !canEdit ? "disabled" : "";
                            var all = vf.Fields.ToDictionary(x => x.Field.ID, x => x.Field);
                            bool gridOn = false;
                            if (Model.Forms.Count > 1) {<div class="d-flex align-items-center mb-4 @(vf == Model.Forms[0] ? "" : "mt-8")"><span class="bullet bullet-vertical h-20px bg-primary me-3"></span><span class="text-gray-800 fw-bold fs-5">@Nm(vf.Template.Name, vf.Template.NameEn)</span><span class="badge badge-light-primary fs-8 fw-bold hp-num ms-2" dir="ltr">v@(vf.Version.Version)</span>@if (signed) {<span class="badge badge-light-success fs-8 fw-bold ms-2">@T["Signed"]</span>}</div>}
                            <div class="row g-4" data-form="@vf.Form.ID">
                                @foreach (var fv in vf.Fields)
                                {
                                    var f = fv.Field; var c = fv.Concept; string label = isAr ? f.Label ?? c.Name : f.LabelEn ?? c.NameEn;
                                    bool calc = c.ValueType is HospitalConceptType.Calculated || (c.ValueType == HospitalConceptType.Score && c.Calculator == HospitalConceptCalculator.Sum);
                                    var depLabel = fv.ShowWhen == null ? null : (isAr ? fv.ShowWhen.Label : fv.ShowWhen.LabelEn) ?? Nm(vf.Fields.First(x => x.Field.ID == fv.ShowWhen.ID).Concept.Name, vf.Fields.First(x => x.Field.ID == fv.ShowWhen.ID).Concept.NameEn);
                                    Model.LastByConcept.TryGetValue(c.ID, out var lastObs);
                                    Model.Prefill.TryGetValue(f.ID, out var pre);
                                    bool repeat = !seenConcepts.Add(c.ID) && !calc;
                                    bool grid = c.HasLaterality && !repeat && !calc;
                                    if (grid)
                                    {
                                        if (!gridOn)
                                        {
                                            gridOn = true;
                                            <div class="col-4"></div>
                                            <div class="col-4 text-center"><div class="bg-light-primary rounded py-2"><span class="badge badge-primary fs-8 fw-bold me-1">OD</span><span class="fs-7 fw-bold text-gray-700">@T["Right"]</span></div></div>
                                            <div class="col-4 text-center"><div class="bg-light-info rounded py-2"><span class="badge badge-info fs-8 fw-bold me-1">OS</span><span class="fs-7 fw-bold text-gray-700">@T["Left"]</span></div></div>
                                        }
                                        <div class="col-4 d-flex flex-column justify-content-center" data-when="@f.ShowWhenFieldId" data-above="@D(f.ShowWhenAbove)">
                                            <span class="fs-6 fw-semibold text-gray-800 @(f.Required ? "required" : "")">@label @if (!string.IsNullOrEmpty(c.Unit)) {<span class="text-muted fs-9 hp-num">(@c.Unit)</span>}</span>
                                        </div>
                                    }
                                    else if (!repeat) { gridOn = false; }
                                    foreach (var side in HospitalFormRules.Sides(c))
                                    {
                                        var key = HospitalFormRules.Key(f.ID, side);
                                        vf.Answers.TryGetValue(key, out var ans);
                                        bool fromLab = ans == null && pre != null && !signed;
                                        var value = ans ?? (fromLab ? pre!.Value : null);
                                        string col = grid ? "col-4" : c.HasLaterality ? (c.ValueType == HospitalConceptType.Choice ? "col-md-6" : "col-md-3") : (calc || c.ValueType == HospitalConceptType.Choice ? "col-md-6" : "col-md-4");
                                        if (repeat) { <input type="hidden" data-key="@key" data-code="@c.Code" data-side="@side" data-mirror="1" value="@value" /> continue; }
                                        <div class="@col" data-when="@f.ShowWhenFieldId" data-above="@D(f.ShowWhenAbove)">
                                            @if (!grid) {
                                            <label class="fs-6 fw-semibold mb-2 @(f.Required && !calc ? "required" : "")">@label@(side == null ? "" : " — " + (side == "R" ? T["Right"].Value : T["Left"].Value))
                                                @if (!string.IsNullOrEmpty(c.Unit) && c.ValueType != HospitalConceptType.Score) {<span class="text-muted fs-9 hp-num">(@c.Unit)</span>}
                                                @if (fromLab) {<span class="text-muted fs-9">@T["(from the lab {0})", pre!.At.ToString("yyyy-MM-dd")]</span>}
                                                @if (lastObs != null && !calc && !signed) {<span class="d-block text-muted fs-9 fw-normal">@T["Last: {0} on {1}", Val(c, lastObs), lastObs.At.ToString("yyyy-MM-dd")]</span>}
                                                @if (depLabel != null) {<span class="badge badge-light-primary fs-9">@T["shown because {0} > {1}", depLabel, D(f.ShowWhenAbove)]</span>}</label>
                                            }
                                            @if (calc)
                                            {
                                                @if (c.ValueType == HospitalConceptType.Score && c.Calculator == HospitalConceptCalculator.Sum)
                                                {
                                                    @* H118: a sum score adds itself up as its items are typed — and its alert shows the moment it crosses *@
                                                    <input class="form-control form-control-solid fw-bold" readonly dir="ltr" data-sum="@c.CalcInputs" placeholder="@T["Adds up as you answer"]"
                                                           data-lo="@D(c.NormalLow)" data-hi="@D(c.NormalHigh)" data-alert-above="@D(f.AlertAbove)" data-alert-below="@D(f.AlertBelow)" data-alert-text="@(isAr ? f.AlertText : f.AlertTextEn ?? f.AlertText)"
                                                           data-bands="@string.Join("\n", HospitalConceptRules.Choices(c.Choices).Select(b => b.Code + "|" + (isAr ? b.Ar : b.En)))" />
                                                    @if (lastObs != null) {<div class="text-muted fs-9 mt-1">@T["Last: {0} on {1}", Val(c, lastObs), lastObs.At.ToString("yyyy-MM-dd")]</div>}
                                                }
                                                else
                                                {
                                                <input class="form-control form-control-solid" readonly dir="ltr" value="@(lastObs == null ? "" : Val(c, lastObs) + (c.Calculator == HospitalConceptCalculator.EgfrCkdEpi2021 && lastObs.Value is decimal eg ? " → " + HospitalClinicalCalc.GCategory(eg) : ""))" placeholder="@T["Computed at sign-off"]" />
                                                }
                                            }
                                            else if (c.ValueType == HospitalConceptType.Choice)
                                            {
                                                <select class="form-select form-select-solid" data-control="none" data-key="@key" data-code="@c.Code" data-side="@side" @dis><option value="">—</option>@foreach (var ch in HospitalConceptRules.Choices(c.Choices)) {<option value="@ch.Code" selected="@(ch.Code == value)">@(isAr ? ch.Ar : ch.En)</option>}</select>
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-solid @(HospitalVisitRules.OutOfRange(c, value) ? "is-invalid" : "")" dir="ltr" data-key="@key" data-code="@c.Code" data-side="@side" value="@value" @dis
                                                       data-lo="@D(c.NormalLow)" data-hi="@D(c.NormalHigh)" data-hi2="@D(c.NormalHigh2)" data-panel="@(c.ValueType == HospitalConceptType.Panel ? "1" : "")"
                                                       data-alert-above="@D(f.AlertAbove)" data-alert-below="@D(f.AlertBelow)" data-alert-range="@(f.AlertRange != null && (f.AlertRange != HospitalAlertRange.Pregnant || facts?.Trimester != null) ? "1" : "")" data-alert-text="@(isAr ? f.AlertText : f.AlertTextEn ?? f.AlertText)"
                                                       placeholder="@(c.ValueType == HospitalConceptType.Panel ? "120/80" : c.Unit == "logMAR" ? "6/6" : "")" />
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                        @* H108: the AF stroke score — the prototype's read-only field: read from age and the coded conditions, never typed. H172: CHA₂DS₂-VA (ESC 2024) *@
                        @if (W?.Chads is { } chv)
                        {
                            <div class="separator separator-dashed my-5"></div>
                            <div class="row g-4"><div class="col-md-6">
                                <label class="fs-6 fw-semibold mb-2">CHA₂DS₂-VA <span class="text-muted fs-8 fw-semibold ms-1" dir="ltr">ESC 2024</span></label>
                                <input type="text" readonly class="form-control form-control-solid @(chv.Score >= 2 ? "is-invalid" : "")" dir="auto"
                                       value="@(chv.Af ? string.Format(T["{0} of 8"].Value, chv.Score) + " — " + T["chads:" + chv.Advice].Value : T["No AF — not scored"].Value)" />
                                <div class="text-muted fs-8 mt-1 d-flex flex-wrap gap-3">@if (chv.Af) { foreach (var it in chv.Items) {<span>@T["chads:" + it.Key] <bdi class="hp-num" dir="ltr">+@it.Points</bdi></span>} } else {<span>@T["Read from the diagnoses on file: atrial fibrillation (I48) is not among them."]</span>}</div>
                            </div></div>
                        }
                    </div>
                </div>

                @if (Model.Headlines.Count > 0)
                {
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Trends — from the stored observations"]</span></div></div>
                        <div class="card-body pt-2">
                            <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent mb-5 fs-6 fw-bold">
                                @for (int i = 0; i < Model.Headlines.Count; i++) {<li class="nav-item"><a class="nav-link @(i == 0 ? "active" : "")" data-bs-toggle="tab" href="#trend@(i)">@Nm(Model.Headlines[i].Concept.Name, Model.Headlines[i].Concept.NameEn)</a></li>}
                            </ul>
                            <div class="tab-content">
                                @for (int i = 0; i < Model.Headlines.Count; i++)
                                {
                                    var h = Model.Headlines[i];
                                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="trend@(i)"><div data-chart="@i"></div>@if (h.Points.Count == 0) {<div class="text-center py-10"><i class="ki-outline ki-chart-line fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No value recorded yet"]</div></div>}</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-xl-@(W?.Growth.Count > 0 ? 4 : 5)">
                @if (W?.Immuno != null)
                {
                    foreach (var cv in W.Immuno)
                    {
                        var co = cv.Course; bool held = co.Status == HospitalImmunoStatus.Held, stopped = co.Status == HospitalImmunoStatus.Stopped;
                        <div class="card card-flush mb-5 mb-xl-8" data-course="@co.ID">
                            <div class="card-header pt-5">
                                <div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Immunotherapy — {0}", isAr ? co.Extract : co.ExtractEn]</span>
                                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Build-up schedule; a systemic reaction holds the next dose until the doctor decides"]</span></div>
                                <div class="card-toolbar">@if (held) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Course held"]</span>} else if (stopped) {<span class="badge badge-light fs-7 fw-bold">@T["Stopped"]</span>}</div>
                            </div>
                            <div class="card-body pt-2">
                                <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0 fs-7">
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">#</th><th>@T["Date"]</th><th>@T["Vial"]</th><th>@T["Dose"]</th><th class="pe-4 rounded-end">@T["Reaction"]</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in cv.Doses.TakeLast(6))
                                        {
                                            <tr><td class="ps-4 hp-num text-gray-500 fw-bold">@d.Seq</td><td class="hp-num text-nowrap">@HospitalNursingService.UtcToWard(d.GivenAt).ToString("yyyy-MM-dd")</td><td class="hp-num">@d.Vial</td><td class="hp-num text-nowrap fw-bold text-gray-800" dir="ltr">@d.DoseMl.ToString("0.00")&nbsp;mL</td>
                                                <td>@if (d.Reaction == HospitalImmunoReaction.Pending)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-light-primary py-1 px-3 fs-8" data-react="@d.ID" data-until="@d.ObserveUntil.ToString("o")">@T["Record the reaction"]</button>
                                                        <div class="text-muted fs-9 mt-1" data-timer="@d.ObserveUntil.ToString("o")"></div>
                                                    }
                                                    else
                                                    {
                                                        string kind = d.Reaction switch { HospitalImmunoReaction.Systemic => "danger", HospitalImmunoReaction.LargeLocal => "primary", _ => "success" };
                                                        <span class="badge badge-light-@kind fs-7 fw-bold">@T["imr:" + d.Reaction]@if (d.WhealMm != null) {<text> <bdi class="hp-num" dir="ltr">@d.WhealMm&nbsp;mm</bdi></text>}@if (d.Reaction == HospitalImmunoReaction.LargeLocal) {<text> — @T["repeat dose"]</text>}</span>
                                                    }</td></tr>
                                        }
                                        @if (cv.Next.Refusal == null && Model.CanEdit)
                                        {
                                            <tr class="bg-light-primary"><td class="ps-4 hp-num fw-bold">@(cv.Doses.Count + 1)</td><td class="fw-bold">@T["Today"]</td><td class="hp-num">@cv.Next.Vial</td><td class="hp-num fw-bold text-nowrap" dir="ltr">@cv.Next.DoseMl?.ToString("0.00")&nbsp;mL</td>
                                                <td><button type="button" class="btn btn-sm btn-primary py-1 px-3 fs-8" data-give="@co.ID">@T["Give + 30-min timer"]</button></td></tr>
                                        }
                                    </tbody>
                                </table></div>
                                @if (cv.Next.Refusal != null) {<div class="fs-8 text-muted mt-3">@T[cv.Next.Refusal, cv.Next.Args ?? Array.Empty<object>()]</div>}
                                @if (held && Model.CanEdit)
                                {
                                    <div class="notice bg-light-danger rounded border-danger border border-dashed p-4 mt-4"><div class="text-gray-900 fw-bold fs-6 mb-1">@T["Held after a systemic reaction"]</div><div class="text-gray-700 fs-7"><bdi>@co.StatusNote</bdi></div>
                                        <div class="d-flex gap-2 mt-2"><button type="button" class="btn btn-sm btn-light-primary py-1 px-3 fs-8" data-decide="@co.ID" data-resume="1">@T["Resume {0} steps lower", (int)(ViewBag.ImmunoSteps ?? 2)]</button><button type="button" class="btn btn-sm btn-light-danger py-1 px-3 fs-8" data-decide="@co.ID" data-resume="0">@T["Stop the course"]</button></div></div>
                                }
                            </div>
                        </div>
                    }
                    if (Model.CanEdit && !W.Immuno.Any(x => x.Course.Status != HospitalImmunoStatus.Stopped))
                    {
                        <div class="card card-flush mb-5 mb-xl-8"><div class="card-body d-flex flex-stack flex-wrap gap-3 py-5"><div class="d-flex align-items-center"><div class="symbol symbol-45px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-syringe fs-2 text-primary"></i></span></div><div><div class="text-gray-900 fw-bold fs-6">@T["Immunotherapy"]</div><div class="text-gray-500 fw-semibold fs-7">@T["No course yet: start one with the extract the skin test shows."]</div></div></div>
                            <button type="button" class="btn btn-sm btn-light-primary" data-bs-toggle="modal" data-bs-target="#imStart"><i class="ki-outline ki-plus fs-4"></i>@T["Start a course"]</button></div></div>
                    }
                }
                @if (W?.Dosing != null)
                {
                    var dz = W.Dosing;
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Weight-based dosing"]</span></div></div>
                        <div class="card-body pt-2">
                            @if (dz.Drugs.Count == 0)
                            {
                                <div class="text-center py-8"><i class="ki-outline ki-capsule fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-7 fw-semibold text-gray-600">@T["No medicine has a dose per kg yet: add it to the drug's dose limit."]</div></div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Drug"]</label><select class="form-select form-select-solid" id="doseDrug" data-control="none">@foreach (var d in dz.Drugs) {<option value="@d.ID" data-perkg="@d.PerKgMg" data-every="@d.EveryHours" data-max="@d.MaxSingle" data-daily="@d.MaxDaily" data-strength="@d.StrengthMgPerMl">@d.Drug@(d.StrengthMgPerMl is decimal sm ? " — " + HospitalDrugSafetyRules.Num(sm) + " mg/mL" : "")</option>}</select></div>
                                    <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Dose per kg"]</label><input class="form-control form-control-solid" id="dosePerKg" dir="ltr" readonly /></div>
                                    <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Weight today"]</label><input class="form-control form-control-solid" id="doseKg" dir="ltr" readonly value="@(dz.WeightKg is decimal wk ? HospitalDrugSafetyRules.Num(wk) + " kg" : "")" data-kg="@dz.WeightKg" placeholder="@T["No weight recorded"]" /></div>
                                </div>
                                <div class="rounded bg-light-primary p-5 mt-5"><div class="text-gray-600 fw-semibold fs-7">@T["Computed dose"]</div><div class="fs-2hx fw-bold text-primary lh-1 my-2 hp-num" dir="ltr" id="doseOut">—</div><div class="fs-7 text-gray-700" id="doseNote"></div></div>
                            }
                        </div>
                    </div>
                }
                @if (W?.Development.Count > 0)
                {
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Development — age {0}", Math.Floor(W.AgeYears ?? 0)]</span></div></div>
                        <div class="card-body pt-2">
                            @foreach (var ms in W.Development)
                            {
                                bool ok = ms.Answer == "Y";
                                <div class="hp-gap" data-milestone="@ms.Key" data-mform="@ms.FormId"><div class="symbol symbol-35px flex-shrink-0"><span class="symbol-label bg-light"><i class="ki-outline @(ok ? "ki-check-circle text-success" : "ki-time text-primary") fs-2"></i></span></div><div><div class="text-gray-800 fw-bold fs-6">@(isAr ? ms.Label : ms.LabelEn)</div><div class="text-muted fw-semibold fs-7">@(ok ? T["Achieved"] : ms.Answer == "N" ? T["Not yet"] : T["Not assessed"])</div></div></div>
                            }
                        </div>
                    </div>
                }
                @foreach (var sc in W?.Scores ?? Array.Empty<HospitalVisitScore>())
                {
                    bool badScore = sc.Last != null && HospitalObsFlag.Abnormal(sc.Last.Flag);
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@Nm(sc.Concept.Name, sc.Concept.NameEn)</span></div></div>
                        <div class="card-body pt-2">
                            <div class="d-flex flex-stack py-3 border-bottom border-gray-300 border-bottom-dashed"><span class="text-gray-600 fw-semibold fs-7">@T["The score"]</span><span class="fw-bold hp-num @(badScore ? "text-danger" : "text-gray-900")">@(sc.Last?.Value is decimal sv ? HospitalConceptRules.Num(sv, sc.Concept.Decimals) + " " + sc.Concept.Unit : "—")@if (HospitalConceptRules.Band(sc.Concept, sc.Last?.Value) is var band && band != null) {<span class="badge badge-light-@(badScore ? "danger" : "primary") fs-7 fw-bold ms-2">@(isAr ? band.Value.Ar : band.Value.En)</span>}</span></div>
                            <div class="d-flex flex-stack py-3 border-bottom border-gray-300 border-bottom-dashed"><span class="text-gray-600 fw-semibold fs-7">@T["Threshold"]</span><span class="fw-bold hp-num">@HospitalConceptRules.NormalDisplay(sc.Concept, isAr)@if (badScore) {<span class="text-danger ms-1">@T["out of range"]</span>}</span></div>
                            @if (sc.Items?.Count > 0)
                            {
                                <div class="d-flex align-items-center mt-5 mb-2"><span class="bullet bullet-vertical h-15px bg-primary me-3"></span><span class="text-gray-800 fw-bold fs-6">@T["The questions"]</span></div>
                                foreach (var it in sc.Items)
                                {
                                    <div class="d-flex flex-stack py-3 border-bottom border-gray-300 border-bottom-dashed"><span class="text-gray-700 fw-semibold fs-7">@(isAr ? it.Label : it.LabelEn)</span><span class="hp-num fw-bold">@(it.Answer ?? "—")@(it.Unit)</span></div>
                                }
                            }
                            <div class="fs-7 text-gray-500 fw-semibold mt-3">@(sc.Last == null ? T["Not recorded yet: it is stored when the visit is signed."] : T["Stored as an observation, so every clinic sees it."])</div>
                        </div>
                    </div>
                }
                @* H108: the eye visit's outputs (the prototype sc-eye): the OCT + visual-field order from the price list; the
                   glasses prescription and the letter are printed documents, which go through Report Studio *@
                @if (W?.EyeOutputs is { } eo)
                {
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Outputs"]</span></div>
                            @* H129: the services the two tests are ordered as — the eye clinic's settings *@
                            <div class="card-toolbar gap-2">@await Html.PartialAsync("_UnitSettings", ViewBag.EyeOct as HospitalUnitSettingsView)@await Html.PartialAsync("_UnitSettings", ViewBag.EyeVf as HospitalUnitSettingsView)</div></div>
                        <div class="card-body pt-2 d-flex flex-column gap-2">
                            @* H109: the glasses prescription and the letter are Report Studio papers, read from the SIGNED visit *@
                            @if (e.Status == HospitalEncounterStatus.Signed)
                            {
                                <div class="d-flex align-items-center gap-2"><span class="fs-6 fw-semibold text-gray-800 flex-grow-1">@T["Glasses prescription · letter to the diabetes doctor"]</span>
                                    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalEyeVisit, DocumentId = e.ID.ToString(), DocumentTitle = "V-" + e.ID.ToString("D6") })</div>
                            }
                            else
                            {
                                <div class="notice d-flex align-items-center bg-light-primary rounded border-primary border border-dashed p-4 fs-7 text-gray-700 fw-semibold"><i class="ki-outline ki-information fs-2 text-primary me-3"></i>@T["The glasses prescription and the letter print once the visit is signed: they say what was signed."]</div>
                            }
                            @if (eo.Oct != null && eo.Vf != null)
                            {
                                <button type="button" class="btn btn-light-primary btn-sm text-start" data-order-many="@eo.Oct.ID,@eo.Vf.ID" @(canEdit ? "" : "disabled")><i class="ki-outline ki-scan-barcode fs-4"></i>@T["Order OCT + visual fields"]</button>
                            }
                            else
                            {
                                <div class="notice d-flex align-items-center bg-light-primary rounded border-primary border border-dashed p-4 fs-7 text-gray-700 fw-semibold"><i class="ki-outline ki-information fs-2 text-primary me-3"></i>@T["Choose the OCT and visual-field services in the eye clinic's settings to order them here."]</div>
                            }
                        </div>
                    </div>
                }
                @* H99: the visit's drawings — the clinical canvas *@
                @{ var cvs = ViewBag.Canvas as IReadOnlyDictionary<string, (int Marks, int Carried, bool Signed)>; }
                @if (cvs != null)
                {
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Clinical canvas"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Drawings signed with the visit"]</span></div></div>
                        <div class="card-body pt-2">
                            @foreach (var (k, lbl, icon) in new[] { (HospitalCanvasKind.Body, "Body map", "ki-user-square"), (HospitalCanvasKind.Fundus, "Fundus drawing", "ki-eye"), (HospitalCanvasKind.Burn, "Burn chart", "ki-sun"), (HospitalCanvasKind.Audio, "Audiogram", "ki-graph-3"), (HospitalCanvasKind.Joints, "Rheumatoid joints — DAS28", "ki-abstract-14"), (HospitalCanvasKind.Pedigree, "Pedigree", "ki-people") })
                            {
                                cvs.TryGetValue(k, out var cs);
                                <a href="@Url.Action("CanvasSheet", new { id = e.ID, kind = k })" class="hp-gap text-hover-primary">
                                    <div class="symbol symbol-35px flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline @icon fs-3 text-primary"></i></span></div>
                                    <div class="flex-grow-1"><div class="text-gray-800 fw-bold fs-6">@T[lbl]</div>
                                        <div class="text-gray-500 fw-semibold fs-7">@(cs.Marks == 0 ? T["Not drawn on this visit"] : T["{0} marks", cs.Marks])</div></div>
                                    @if (cs.Carried > 0) {<span class="badge badge-light-danger fs-8 fw-bold">@T["{0} carried — unverified", cs.Carried]</span>}
                                </a>
                            }
                        </div>
                    </div>
                }
                <div class="card card-flush mb-5 mb-xl-8">
                    <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Care gaps & alerts"]</span></div></div>
                    <div class="card-body pt-2">
                        @* H104: the kidney — a medicine of the last 180 days against the last stored eGFR (the prototype's metformin line) *@
                        @foreach (var rn in W?.Renal ?? Array.Empty<HospitalRenalAlert>())
                        {
                            var lim = rn.Limit;
                            string rule = (lim.RenalReviewBelow is decimal rv ? string.Format(T["Review the dose below {0}"].Value, HospitalDrugSafetyRules.Num(rv)) : "")
                                + (lim.RenalReviewBelow != null && lim.RenalStopBelow != null ? " · " : "")
                                + (lim.RenalStopBelow is decimal sb ? string.Format(T["stop below {0}"].Value, HospitalDrugSafetyRules.Num(sb)) : "")
                                + (rn.Egfr.Falling ? " — " + T["the trend is falling"].Value : "");
                            <div class="hp-gap"><div class="symbol symbol-35px flex-shrink-0"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-information fs-3 text-danger"></i></span></div>
                                <div class="flex-grow-1"><div class="text-gray-800 fw-bold fs-6">@T["{0} with eGFR {1}", "\u2068" + rn.Drug + "\u2069", "\u2068" + HospitalDrugSafetyRules.Num(rn.Egfr.Value) + "\u2069"]</div>
                                    <div class="text-gray-500 fw-semibold fs-7">@rule</div></div>
                                <a href="@Url.Action("Consult", new { id = e.ID })" class="btn btn-sm btn-light-primary py-1 px-3 fs-8">@T["Review dose"]</a>
                            </div>
                        }
                        @if (Model.Care.Count == 0 && Model.Done.Count == 0 && (W?.Renal?.Count ?? 0) == 0) {<div class="text-center py-8"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Nothing overdue"]</div></div>}
                        @foreach (var g in Model.Care)
                        {
                            string what = g.Kind == "Gap"
                                ? (g.LastAt == null ? string.Format(T["{0}: never recorded"].Value, isAr ? g.Text : g.TextEn) : string.Format(T["{0} overdue {1} days"].Value, isAr ? g.Text : g.TextEn, g.DaysOverdue))
                                : (isAr ? g.Text : g.TextEn);
                            <div class="hp-gap"><div class="symbol symbol-35px flex-shrink-0"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-information fs-3 text-danger"></i></span></div>
                                <div class="flex-grow-1"><div class="text-gray-800 fw-bold fs-6">@what</div>
                                    <div class="text-gray-500 fw-semibold fs-7">@(g.Kind == "Gap" ? (g.LastAt == null ? T["No value on any visit"].Value : string.Format(T["Last {0}"].Value, g.LastAt.Value.ToString("yyyy-MM-dd"))) : string.Format(T["Latest {0} on {1}"].Value, Nm(g.Concept.Name, g.Concept.NameEn), g.LastAt?.ToString("yyyy-MM-dd")))</div></div>
                                @if (canEdit && g.Kind == "Gap" && Model.GapServices.TryGetValue(g.Concept.ID, out var svc)) {<button type="button" class="btn btn-sm btn-light-primary py-1 px-3 fs-8" data-order="@svc">@T["Order it"]</button>}
                            </div>
                        }
                        @foreach (var d in Model.Done)
                        {
                            <div class="hp-gap"><div class="symbol symbol-35px flex-shrink-0"><span class="symbol-label bg-light-success"><i class="ki-outline ki-check fs-3 text-success"></i></span></div>
                                <div class="flex-grow-1"><div class="text-gray-800 fw-bold fs-6">@T["{0} done {1}", Nm(d.Concept.Name, d.Concept.NameEn), d.At.ToString("yyyy-MM-dd")]</div><div class="text-gray-500 fw-semibold fs-7"><bdi class="hp-num">@d.Value</bdi></div></div>
                                <span class="badge badge-light-success fs-7 fw-bold"><i class="ki-outline ki-check-circle text-success fs-5"></i></span></div>
                        }
                    </div>
                </div>

                @if (kdc != null || Model.Forms.SelectMany(f => f.Fields).Any(f => f.Concept.Calculator == HospitalConceptCalculator.Kdigo))
                {
                    <div class="card card-flush mb-5 mb-xl-8">
                        <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Kidney stage — KDIGO 2024"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Computed from eGFR and ACR"]</span></div></div>
                        <div class="card-body pt-2">
                            <table class="table hp-kd mb-2 fs-8"><thead><tr><th></th>@foreach (var a in new[] { ("A1", "<30"), ("A2", "30–300"), ("A3", ">300") }) {<th class="text-center fs-9">@a.Item1<br />@a.Item2</th>}</tr></thead>
                                <tbody>@foreach (var r in KG) {<tr><th class="fs-9 text-nowrap">@r[0] <span class="text-muted">@r[1]</span></th>@for (int j = 0; j < 3; j++) { bool me = kdc != null && kdc.G == r[0] && kdc.A == AC[j]; <td class="@r[j + 2] @(me ? "me" : "")">@(me ? "●" : "")</td> }</tr>}</tbody></table>
                            @* H173: CKD needs the abnormality to last more than three months — one value is provisional *@
                            @if (kdc is { Abnormal: true, Confirmed: false }) { <div class="d-flex align-items-center gap-2 mt-3"><span class="badge badge-light-info fs-8 fw-bold">@T["kdigo:Provisional"]</span><span class="fs-8 text-gray-600 fw-semibold">@T["Not seen 3 months earlier: repeat the eGFR and ACR to confirm chronic kidney disease."]</span></div> }
                            else if (kdc is { Abnormal: true, Confirmed: true }) { <div class="mt-3"><span class="badge badge-light-primary fs-8 fw-bold">@T["kdigo:Confirmed"]</span></div> }
                            <div class="fs-7 text-gray-600 fw-semibold mt-3">@(kdc == null ? T["No KDIGO stage recorded yet: it is computed when the visit is signed."] : T[HospitalVisitRules.AdviceKey(kdc.Risk)])</div>
                        </div>
                    </div>
                }

                <div class="card card-flush mb-5 mb-xl-8">
                    <div class="card-header pt-5"><div class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Order set by diagnosis"]</span></div></div>
                    <div class="card-body pt-2">
                        @if (Model.OrderSets.Count == 0) {<div class="text-center py-8"><i class="ki-outline ki-questionnaire-tablet fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-7 fw-semibold text-gray-600">@(Model.Visit.Diagnoses.Count == 0 ? T["Add the visit's diagnosis in the consultation: its order set appears here."] : T["No order set for this visit's diagnoses."])</div></div>}
                        @foreach (var os in Model.OrderSets)
                        {
                            <div class="border border-gray-300 border-dashed rounded p-5 mb-5" data-set="@os.Set.ID">
                                <div class="fs-6 fw-semibold text-gray-800 mb-4">@T["“{0}” proposes:", primary == null ? Nm(os.Set.Name, os.Set.NameEn) : Nm(primary.Name, primary.NameEn)] <span class="text-gray-500 fs-7 d-block">@Nm(os.Set.Name, os.Set.NameEn)</span></div>
                                @foreach (var it in os.Items)
                                {
                                    string title = it.Kind == HospitalOrderSetItemKind.Medication ? string.Join(" ", new[] { it.Drug, it.Dose, it.Note }.Where(x => !string.IsNullOrWhiteSpace(x)))
                                        : it.ServiceId is int sid && Model.Services.TryGetValue(sid, out var svcRow) ? Nm(svcRow.Name, svcRow.NameEn) : Nm(it.TitleAr ?? it.TitleEn ?? "", it.TitleEn);
                                    <label class="form-check form-check-custom form-check-solid form-check-sm py-2"><input type="checkbox" class="form-check-input" data-item="@it.ID" checked="@it.Preselected" @(canEdit ? "" : "disabled") /><span class="form-check-label text-gray-700 fw-semibold fs-7">@title</span></label>
                                }
                                @if (canEdit) {<button type="button" class="btn btn-sm btn-primary w-100 mt-3" data-apply="@os.Set.ID">@T["Add the ticked to orders"]</button>}
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@if (W?.Immuno != null && Model.CanEdit)
