        </div>
    </div></div></div>
}

@await Html.PartialAsync("_ReportPreviewModal", (object)name)

@section Scripts {
    <script>
        (function () {
            var tokEl = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tokEl) return; var tok = tokEl.value;
            var base = @Json.Serialize(Url.Content("~/Hospital/Consult/" + e.ID + "/Specialty"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), sign: @Json.Serialize(T["Sign this visit? The consultation and its forms are signed together and cannot change afterwards."].Value),
                      tpl: @Json.Serialize(T["Add this template to the visit?"].Value), set: @Json.Serialize(T["Add the ticked lines to this visit's orders?"].Value), added: @Json.Serialize(T["Lines added: {0}"].Value),
                      order: @Json.Serialize(T["Order this test on this visit?"].Value), probs: @Json.Serialize(T["Add this visit's diagnoses to the patient's problem list?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b || {}) })
                .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function run(msg, u, b, then) { cbConfirm(msg).then(function (ok) { if (!ok) return; post(u, b).then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } then(res); }); }); }
            var form = document.getElementById('visitForm');
            function answers() { var all = {}; form.querySelectorAll('[data-form]').forEach(function (f) { var a = {}; f.querySelectorAll('[data-key]').forEach(function (i) {
                var box = i.closest('[data-when]'); if (box && box.classList.contains('d-none')) return; var v = (i.value || '').trim(); if (v) a[i.getAttribute('data-key')] = v; }); all[f.getAttribute('data-form')] = a; }); return { forms: all }; }
            // a conditional field shows when the field it depends on is above its value
            function cond() { form.querySelectorAll('[data-when]').forEach(function (b) { var w = b.getAttribute('data-when'); if (!w) return;
                var vals = Array.prototype.map.call(form.querySelectorAll('[data-key="' + w + '"],[data-key^="' + w + '."]'), function (i) { return parseFloat(i.value); });
                b.classList.toggle('d-none', !vals.some(function (v) { return v > parseFloat(b.getAttribute('data-above') || '0'); })); }); }
            // red when out of the concept's normal range
            function range(i) { var v = (i.value || '').trim(); if (!v) { i.classList.remove('is-invalid'); return; } var lo = parseFloat(i.dataset.lo), hi = parseFloat(i.dataset.hi), hi2 = parseFloat(i.dataset.hi2), bad = false;
                if (i.dataset.panel) { var p = v.split('/'); var a = parseFloat(p[0]), b = parseFloat(p[1]); bad = (!isNaN(hi) && a > hi) || (!isNaN(hi2) && b > hi2) || (!isNaN(lo) && a < lo); }
                else { var x = parseFloat(v); bad = !isNaN(x) && ((!isNaN(hi) && x > hi) || (!isNaN(lo) && x < lo)); }
                i.classList.toggle('is-invalid', bad); }
            // H98: a field with an alert says so the moment its value crosses it (PHQ-9 item 9 — before the patient leaves)
            // H116: outside THIS patient's range (the limits on the field are already hers: sex, age, pregnancy)
            function outside(i) { var v = (i.value || '').trim(); if (!v) return false; var lo = parseFloat(i.dataset.lo), hi = parseFloat(i.dataset.hi), hi2 = parseFloat(i.dataset.hi2);
                if (i.dataset.panel) { var p = v.split('/'); var a = parseFloat(p[0]), b = parseFloat(p[1]); return (!isNaN(a) && ((!isNaN(hi) && a > hi) || (!isNaN(lo) && a < lo))) || (!isNaN(b) && !isNaN(hi2) && b > hi2); }
                var x = parseFloat(v); return !isNaN(x) && ((!isNaN(hi) && x > hi) || (!isNaN(lo) && x < lo)); }
            function alertOf(i) { var box = i.parentNode, msg = box.querySelector('[data-alert-msg]'), v = parseFloat(i.value), a = parseFloat(i.dataset.alertAbove), b = parseFloat(i.dataset.alertBelow);
                var hit = (!isNaN(v) && ((!isNaN(a) && v >= a) || (!isNaN(b) && v <= b))) || (i.dataset.alertRange === '1' && outside(i));
                if (hit && !msg) { msg = document.createElement('div'); msg.setAttribute('data-alert-msg', ''); msg.className = 'rounded bg-light-danger text-danger fw-bold fs-8 px-3 py-2 mt-2'; box.appendChild(msg); }
                if (msg) { msg.textContent = hit ? '⚠ ' + i.dataset.alertText : ''; msg.classList.toggle('d-none', !hit); } }
            if (form) form.querySelectorAll('[data-alert-text]').forEach(function (i) { if (i.dataset.alertText && !i.dataset.sum) alertOf(i); });
            sums();
            // H118: each sum score adds up its items on this form as they are typed (all answered, or empty), names its band,
            // and raises its alert at once — the signature computes the same sum again on the server
            function sums() { if (!form) return; form.querySelectorAll('[data-sum]').forEach(function (s) {
                var scope = s.closest('[data-form]') || form, total = 0, all = true;
                s.dataset.sum.split(',').map(function (x) { return x.trim(); }).filter(Boolean).forEach(function (code) {
                    var i = scope.querySelector('[data-key][data-code="' + code + '"]:not([data-mirror])'), v = i ? parseFloat((i.value || '').trim()) : NaN;
                    if (isNaN(v)) all = false; else total += v; });
                if (!all) { s.value = ''; s.removeAttribute('title'); } else {
                    var band = ''; (s.dataset.bands || '').split('\n').forEach(function (b) { var p = b.split('|'); if (p.length > 1 && total >= parseFloat(p[0])) band = p[1]; });
                    s.value = total + (band ? '  —  ' + band : ''); }
                var probe = { value: all ? String(total) : '', dataset: s.dataset, parentNode: s.parentNode };
                if (s.dataset.alertText) alertOf(probe); }); }
            function mirror(i) { if (!i.dataset.code || i.dataset.mirror) return; form.querySelectorAll('[data-mirror][data-code="' + i.dataset.code + '"][data-side="' + (i.dataset.side || '') + '"]').forEach(function (m) { m.value = i.value; }); }
            var timer = null, st = document.getElementById('saveState');
            // H106: what the save set off — the on-call doctor told, a template opened (once; the server never sends twice)
            var told = false, opened = false;
            function escalation(res) {
                if (res.notified && !told) { told = true; toastr.info(@(Json.Serialize(T["The on-call doctor was notified: {0}"].Value)).replace('{0}', res.notified), '', { timeOut: 0, extendedTimeOut: 0 }); }
                if (res.nobodyOnCall && !told) { told = true; toastr.error(@Json.Serialize(T["Nobody is on call for this department now: tell a doctor yourself"].Value), '', { timeOut: 0, extendedTimeOut: 0 }); }
                if (res.added && !opened) { opened = true; var b = document.getElementById('escOpened'); if (b) b.classList.remove('d-none'); }
            }
            function autosave() { clearTimeout(timer); timer = setTimeout(function () { post(base + '/Save', answers()).then(function (res) { if (st) st.textContent = res.ok ? W.saved : (res.error || W.failed); if (!res.ok) toastr.error(res.error || W.failed); else escalation(res); }); }, 900); }
            if (form) { cond();
                form.addEventListener('input', function (e) { if (e.target.matches('[data-key]')) { mirror(e.target); range(e.target); if (e.target.dataset.alertText) alertOf(e.target); cond(); sums(); if (document.querySelector('[data-sign]')) autosave(); } });
                form.addEventListener('change', function (e) { if (e.target.matches('[data-key]')) { mirror(e.target); cond(); if (document.querySelector('[data-sign]')) autosave(); } });
                if (window.jQuery) jQuery(form).find('select[data-key]').on('change', function () { mirror(this); cond(); if (document.querySelector('[data-sign]')) autosave(); });   // select2 changes never reach addEventListener
            }
            // H95: the WHO growth chart and its table
            var growth = @Json.Serialize((W?.Growth ?? Array.Empty<HospitalGrowthSeries>()).Select(g => new { ind = g.Indicator, unit = g.Concept.Unit, ages = g.Curves.AgeDays, lines = g.Curves.Lines,
                pts = g.Points.Select(x => new { at = x.At.ToString("yyyy-MM-dd"), age = x.AgeDays, v = x.Value, z = x.Z, p = x.Percentile }) }));
            var GT = { age: @Json.Serialize(T["Age (years)"].Value), none: @Json.Serialize(T["No value recorded yet"].Value) };
            function growthDraw(ind) {
                var g = growth.filter(function (x) { return x.ind === ind; })[0], box = document.getElementById('growthChart'); if (!g || !box) return;
                var W3 = 640, H3 = 330, PL = 42, PR = 58, PT = 12, PB = 30, xs = g.ages.map(function (a) { return a / 365.25; }), vals = [];
                Object.keys(g.lines).forEach(function (k) { g.lines[k].forEach(function (v) { vals.push(v); }); }); g.pts.forEach(function (q) { vals.push(q.v); });
                var a0 = Math.min.apply(null, xs.concat(g.pts.map(function (q) { return q.age / 365.25; }))), a1 = Math.max.apply(null, xs), v0 = Math.min.apply(null, vals), v1 = Math.max.apply(null, vals), pad = (v1 - v0) * 0.06; v0 -= pad; v1 += pad;
                function X(a) { return PL + (W3 - PL - PR) * (a - a0) / ((a1 - a0) || 1); }
                function Y(v) { return PT + (H3 - PT - PB) * (v1 - v) / ((v1 - v0) || 1); }
                var s = '', vs = Math.pow(10, Math.floor(Math.log10((v1 - v0) / 5))), vstep = (v1 - v0) / vs > 10 ? vs * 2 : vs;
                for (var v = Math.ceil(v0 / vstep) * vstep; v <= v1; v += vstep) s += '<line x1="' + PL + '" x2="' + (W3 - PR) + '" y1="' + Y(v) + '" y2="' + Y(v) + '" stroke="#EEF0F6"/><text x="' + (PL - 6) + '" y="' + (Y(v) + 4) + '" font-size="10" text-anchor="end" fill="#6B7280">' + (+v.toFixed(1)) + '</text>';
                for (var a = Math.ceil(a0); a <= a1; a++) s += '<line x1="' + X(a) + '" x2="' + X(a) + '" y1="' + PT + '" y2="' + (H3 - PB) + '" stroke="#F4F5F9"/><text x="' + X(a) + '" y="' + (H3 - 12) + '" font-size="10" text-anchor="middle" fill="#6B7280">' + a + '</text>';
                var col = { P3: '#DC2626', P15: '#9CA3AF', P50: '#16A34A', P85: '#9CA3AF', P97: '#DC2626' };
                Object.keys(g.lines).forEach(function (k) {
                    var d = g.lines[k].map(function (v, i) { return (i ? 'L' : 'M') + X(xs[i]).toFixed(1) + ',' + Y(v).toFixed(1); }).join(' ');
                    s += '<path d="' + d + '" fill="none" stroke="' + col[k] + '" stroke-width="' + (k === 'P50' ? 2 : 1.3) + '"' + (k === 'P15' || k === 'P85' ? ' stroke-dasharray="4 4"' : '') + '/><text x="' + (W3 - PR + 4) + '" y="' + (Y(g.lines[k][g.lines[k].length - 1]) + 4) + '" font-size="10" fill="' + col[k] + '">' + k + '</text>';
                });
                if (g.pts.length) {
                    s += '<polyline fill="none" stroke="#3A5795" stroke-width="2.5" points="' + g.pts.map(function (q) { return X(q.age / 365.25) + ',' + Y(q.v); }).join(' ') + '"/>';
                    g.pts.forEach(function (q) { s += '<circle cx="' + X(q.age / 365.25) + '" cy="' + Y(q.v) + '" r="4.5" fill="' + (q.z != null && q.z < -1 ? '#DC2626' : '#3A5795') + '"/>'; });
                }
                box.innerHTML = '<svg viewBox="0 0 ' + W3 + ' ' + H3 + '" class="w-100" dir="ltr" style="max-height:360px">' + s + '<text x="' + (W3 / 2) + '" y="' + H3 + '" font-size="10" text-anchor="middle" fill="#6B7280">' + GT.age + '</text></svg>';
                document.getElementById('growthRows').innerHTML = g.pts.length ? g.pts.slice().reverse().map(function (q) {
                    return '<tr><td class="ps-4"><bdi class="hp-num">' + q.at + '</bdi></td><td><bdi class="hp-num">' + (q.age / 365.25).toFixed(1) + '</bdi></td><td><bdi class="hp-num">' + q.v + ' ' + (g.unit || '') + '</bdi></td><td><bdi class="hp-num ' + (q.z != null && q.z < -1 ? 'text-danger fw-bold' : '') + '">' + (q.z == null ? '—' : (q.z >= 0 ? '+' : '') + q.z.toFixed(2)) + '</bdi></td><td class="pe-4"><bdi class="hp-num">' + (q.p == null ? '—' : 'P' + Math.round(q.p)) + '</bdi></td></tr>';
                }).join('') : '<tr><td colspan="5" class="text-center text-muted py-6">' + GT.none + '</td></tr>';
            }
            var gp = document.getElementById('growthPick');
            if (gp) { growthDraw(gp.value); gp.addEventListener('change', function () { growthDraw(gp.value); }); if (window.jQuery) jQuery(gp).on('change', function () { growthDraw(gp.value); }); }
            // H95: the dose by weight — per kg, never above the adult single limit; with no weight it says so
            var DT = { noKg: @Json.Serialize(T["No weight recorded: the dose cannot be computed. Weigh the child first."].Value), every: @Json.Serialize(T["Every {0} hours, at most {1} doses a day."].Value),
                       capped: @Json.Serialize(T["Capped at the adult single dose of {0} mg."].Value), never: @Json.Serialize(T["The adult maximum of {0} mg is never exceeded."].Value) };
            var dd = document.getElementById('doseDrug');
            function dose() {
                if (!dd) return; var o = dd.options[dd.selectedIndex], perkg = parseFloat(o.dataset.perkg), every = parseInt(o.dataset.every, 10), max = parseFloat(o.dataset.max), daily = parseFloat(o.dataset.daily), str = parseFloat(o.dataset.strength);
                var kgIn = form && form.querySelector('[data-code="29463-7"]'), kg = parseFloat((kgIn && kgIn.value) || document.getElementById('doseKg').dataset.kg);
                document.getElementById('dosePerKg').value = perkg + ' mg/kg';
                if (kgIn && kgIn.value) document.getElementById('doseKg').value = kgIn.value + ' kg';
                if (isNaN(kg) || kg <= 0) { document.getElementById('doseOut').textContent = '—'; document.getElementById('doseNote').textContent = DT.noKg; return; }
                var mg = Math.round(perkg * kg * 10) / 10, capped = !isNaN(max) && mg > max; if (capped) mg = max;
                var perDay = every > 0 ? Math.floor(24 / every) : null; if (perDay && !isNaN(daily)) perDay = Math.max(0, Math.min(perDay, Math.floor(daily / mg)));
                document.getElementById('doseOut').textContent = mg + ' mg' + (!isNaN(str) && str > 0 ? ' = ' + (Math.round(mg / str * 10) / 10) + ' mL' : '');
                document.getElementById('doseNote').textContent = DT.every.replace('{0}', every).replace('{1}', perDay) + ' ' + (capped ? DT.capped : DT.never).replace('{0}', max);
            }
            if (dd) { dose(); dd.addEventListener('change', dose); if (window.jQuery) jQuery(dd).on('change', dose); if (form) form.addEventListener('input', function (e) { if (e.target.dataset && e.target.dataset.code === '29463-7') dose(); }); }
            // H95: the development card follows the answers as they are given
            var MT = { yes: @Json.Serialize(T["Achieved"].Value), no: @Json.Serialize(T["Not yet"].Value), none: @Json.Serialize(T["Not assessed"].Value) };
            function devTicks() {
                document.querySelectorAll('[data-milestone]').forEach(function (m) {
                    var i = form.querySelector('[data-form="' + m.dataset.mform + '"] [data-key="' + m.dataset.milestone + '"]'); if (!i) return;
                    m.querySelector('i').className = 'ki-outline ' + (i.value === 'Y' ? 'ki-check-circle text-success' : 'ki-time text-primary') + ' fs-2';
                    m.querySelector('.text-muted').textContent = i.value === 'Y' ? MT.yes : i.value === 'N' ? MT.no : MT.none;
                });
            }
            if (form && document.querySelector('[data-milestone]')) { form.addEventListener('change', devTicks); if (window.jQuery) jQuery(form).find('select[data-key]').on('change', devTicks); }
            // H97: immunotherapy — start, give (and its 30-minute timer), the reaction, resume / stop
            var IM = { start: @Json.Serialize(T["Start this immunotherapy course?"].Value), give: @Json.Serialize(T["Give this dose now? The patient stays 30 minutes under observation."].Value),
                       react: @Json.Serialize(T["Record this reaction?"].Value), resume: @Json.Serialize(T["Resume the course {0} steps lower?", (int)(ViewBag.ImmunoSteps ?? 2)].Value), stop: @Json.Serialize(T["Stop this course?"].Value),
                       why: @Json.Serialize(T["Write the reason"].Value), left: @Json.Serialize(T["Observation: {0} min left"].Value), over: @Json.Serialize(T["Observation over"].Value) };
            var ibase = @Json.Serialize(Url.Content("~/Hospital/Immuno/")), reactId = 0, decide = null;
            function timers() { document.querySelectorAll('[data-timer]').forEach(function (t) { var ms = new Date(t.dataset.timer) - new Date(); t.textContent = ms > 0 ? IM.left.replace('{0}', Math.ceil(ms / 60000)) : IM.over; }); }
            timers(); setInterval(timers, 30000);
            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-imstart]')) { run(IM.start, ibase + 'Start', { patientId: @p.ID, extract: document.getElementById('imExtract').value, extractEn: document.getElementById('imExtractEn').value }, function () { location.reload(); }); return; }
                var g = e.target.closest('[data-give]'); if (g) { run(IM.give, ibase + 'Courses/' + g.dataset.give + '/Give', {}, function () { location.reload(); }); return; }
                var r = e.target.closest('[data-react]'); if (r) { reactId = Number(r.dataset.react); bootstrap.Modal.getOrCreateInstance(document.getElementById('imReact')).show(); return; }
                if (e.target.closest('[data-imreact]')) { var kind = document.querySelector('input[name="imKind"]:checked').value, w = document.getElementById('imWheal').value;
                    run(IM.react, ibase + 'Doses/' + reactId + '/Reaction', { reaction: kind, whealMm: w ? Number(w) : null, note: document.getElementById('imNote').value }, function () { location.reload(); }); return; }
                var dc = e.target.closest('[data-decide]'); if (dc) { decide = { id: dc.dataset.decide, resume: dc.dataset.resume === '1' }; document.getElementById('imDecideNote').value = '';
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('imDecide')).show(); return; }
                if (e.target.closest('[data-imdecide]')) { run(decide.resume ? IM.resume : IM.stop, ibase + 'Courses/' + decide.id + '/Decide', { resume: decide.resume, note: document.getElementById('imDecideNote').value }, function () { location.reload(); }); return; }
            });
            // the charts: the stored observations, oldest first
            var heads = @Json.Serialize(Model.Headlines.Select(h => new { pts = h.Concept.HasLaterality
                ? h.Points.GroupBy(x => x.At.ToString("yyyy-MM-dd")).Select(g => new { at = g.Key.Substring(0, 7), v = g.FirstOrDefault(x => x.Side == "R")?.Value, v2 = g.FirstOrDefault(x => x.Side == "L")?.Value, f = g.Any(x => HospitalObsFlag.Abnormal(x.Flag)) ? "H" : "N" }).Cast<object>()
                : h.Points.Select(x => new { at = x.At.ToString("yyyy-MM"), v = x.Value, v2 = x.Value2, f = x.Flag }).Cast<object>(), lo = h.Concept.NormalLow, hi = h.Concept.NormalHigh, hi2 = h.Concept.NormalHigh2, alert = h.Field.AlertAbove, alertText = isAr ? h.Field.AlertText : h.Field.AlertTextEn, panel = h.Concept.ValueType == HospitalConceptType.Panel, lat = h.Concept.HasLaterality }));
            var LG = { od: 'OD — ' + @Json.Serialize(T["Right"].Value), os: 'OS — ' + @Json.Serialize(T["Left"].Value), sys: @Json.Serialize(T["Systolic"].Value), dia: @Json.Serialize(T["Diastolic"].Value) };
            heads.forEach(function (h, k) { var box = document.querySelector('[data-chart="' + k + '"]'); if (!box || !h.pts.length) return;
                var W2 = 560, H2 = 210, PL = 40, PR = 14, PT = 12, PB = 26, vals = []; h.pts.forEach(function (p) { if (p.v != null) vals.push(p.v); if (p.v2 != null) vals.push(p.v2); });
                [h.lo, h.hi, h.hi2, h.alert].forEach(function (x) { if (x != null) vals.push(x); });
                var mn = Math.min.apply(null, vals), mx = Math.max.apply(null, vals), pad = (mx - mn) * 0.15 || 1; mn -= pad; mx += pad;
                function X(i) { return PL + (W2 - PL - PR) * (h.pts.length < 2 ? 0.5 : i / (h.pts.length - 1)); } function Y(v) { return PT + (H2 - PT - PB) * (mx - v) / (mx - mn); }
                var g = '', step = Math.pow(10, Math.floor(Math.log10((mx - mn) / 4))), t0 = Math.ceil(mn / step) * step;
                for (var t = t0; t <= mx; t += step * (((mx - mn) / step) > 8 ? 2 : 1)) g += '<line x1="' + PL + '" x2="' + (W2 - PR) + '" y1="' + Y(t) + '" y2="' + Y(t) + '" stroke="#EEF0F6"/><text x="' + (PL - 6) + '" y="' + (Y(t) + 4) + '" font-size="10" text-anchor="end" fill="#6B7280">' + (+t.toFixed(2)) + '</text>';
                if (h.lo != null && h.hi != null && !h.panel) g += '<rect x="' + PL + '" width="' + (W2 - PL - PR) + '" y="' + Y(h.hi) + '" height="' + (Y(h.lo) - Y(h.hi)) + '" fill="#DCFCE7" opacity=".5"/>';
                [[h.hi, h.panel ? '#DC2626' : null], [h.hi2, '#DC2626'], [h.alert, '#DC2626', h.alertText]].forEach(function (l) { if (l[0] == null || !l[1]) return; g += '<line x1="' + PL + '" x2="' + (W2 - PR) + '" y1="' + Y(l[0]) + '" y2="' + Y(l[0]) + '" stroke="' + l[1] + '" stroke-dasharray="5 4"/>' + (l[2] ? '<text x="' + (W2 - PR - 2) + '" y="' + (Y(l[0]) - 4 < 12 ? Y(l[0]) + 13 : Y(l[0]) - 4) + '" font-size="10" text-anchor="end" fill="' + l[1] + '">' + l[2] + '</text>' : ''); });
                h.pts.forEach(function (p, i) { if (i % Math.ceil(h.pts.length / 8) === 0) g += '<text x="' + X(i) + '" y="' + (H2 - 8) + '" font-size="10" text-anchor="' + (h.pts.length > 1 && i === h.pts.length - 1 ? 'end' : i === 0 && h.pts.length > 1 ? 'start' : 'middle') + '" fill="#6B7280">' + p.at + '</text>'; });
                [['v', '#3A5795'], ['v2', '#7239EA']].forEach(function (s) { var pts = h.pts.map(function (p, i) { return p[s[0]] == null ? null : X(i) + ',' + Y(p[s[0]]); }).filter(Boolean); if (!pts.length) return;
                    g += '<polyline fill="none" stroke="' + s[1] + '" stroke-width="2.2" points="' + pts.join(' ') + '"/>';
                    h.pts.forEach(function (p, i) { if (p[s[0]] != null) g += '<circle cx="' + X(i) + '" cy="' + Y(p[s[0]]) + '" r="4" fill="' + (['L','H','LL','HH'].indexOf(p.f) >= 0 ? '#DC2626' : s[1]) + '"/>'; }); });
                var legend = (h.lat || h.panel) ? '<div class="d-flex gap-4 fs-8 mt-1"><span><span class="d-inline-block rounded-circle me-1" style="width:9px;height:9px;background:#3A5795"></span>' + (h.lat ? LG.od : LG.sys) + '</span><span><span class="d-inline-block rounded-circle me-1" style="width:9px;height:9px;background:#7239EA"></span>' + (h.lat ? LG.os : LG.dia) + '</span></div>' : '';
                box.innerHTML = '<svg viewBox="0 0 ' + W2 + ' ' + H2 + '" class="w-100" dir="ltr" style="max-height:240px">' + g + '</svg>' + legend; });
            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-sign]')) { cbConfirm(W.sign).then(function (ok) { if (!ok) return; post(base + '/Sign', answers()).then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }); }); return; }
                if (e.target.closest('[data-addtpl]')) { run(W.tpl, base + '/Template', { templateId: Number(document.getElementById('addTpl').value) }, function () { location.reload(); }); return; }
                if (e.target.closest('[data-problems]')) { run(W.probs, base + '/Problems', {}, function () { toastr.success(W.saved); }); return; }
                var o = e.target.closest('[data-order]'); if (o) { run(W.order, base + '/Order', { serviceId: Number(o.getAttribute('data-order')) }, function () { location.reload(); }); return; }
                // H108: OCT + visual fields — both lines, one confirmation; a line already on the visit is reported, not repeated
                var om = e.target.closest('[data-order-many]'); if (om) { var ids = om.getAttribute('data-order-many').split(',').map(Number);
                    cbConfirm(@(Json.Serialize(T["Order OCT and visual fields on this visit?"].Value))).then(function (ok) { if (!ok) return;
                        ids.reduce(function (p, id) { return p.then(function (errs) { return post(base + '/Order', { serviceId: id }).then(function (r) { if (!r.ok) errs.push(r.error || W.failed); return errs; }); }); }, Promise.resolve([]))
                            .then(function (errs) { if (errs.length) toastr.error(errs.join(' · ')); location.reload(); }); }); return; }
                var a = e.target.closest('[data-apply]'); if (a) { var box = a.closest('[data-set]'); var ids = Array.prototype.map.call(box.querySelectorAll('[data-item]:checked'), function (c) { return Number(c.getAttribute('data-item')); });
                    run(W.set, base + '/OrderSet', { setId: Number(a.getAttribute('data-apply')), itemIds: ids }, function (res) { toastr.success(W.added.replace('{0}', res.id)); }); return; }
            });
        })();
    </script>
}
