@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDeskCard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H139: the patient card in the desk's drawer.
     · The banner: face, names, file, age, sex, allergy, in hospital.
     · The check-in checklist: identity and the payer decision block; the rest is owed.
     · Today's visits with their acts.
     · A walk-in: the doctor's next free slot, booked and arrived.
     · The next visits; insurance and what is owed; links to the chart, the file, consents and bills. *@
@{
    var p = Model.Patient; var inv = System.Globalization.CultureInfo.InvariantCulture;
    bool canBook = ViewBag.CanBook == true;
    string Time(int minute) => (minute / 60).ToString("00") + ":" + (minute % 60).ToString("00");
    bool blocked = Model.Checklist.Any(c => c.Blocks && !c.Done);
}
@* the banner *@
<div class="d-flex align-items-center mb-6">
    <div class="symbol symbol-75px symbol-circle me-5 flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-2 hp-initials">@HospitalUi.Initials(p.NameEn ?? p.Name)</span>}</div>
    <div class="d-flex flex-column min-w-0">
        <span class="text-gray-900 fw-bold fs-3"><bdi>@DisplayName.Of(p.Name, p.NameEn)</bdi></span>
        <span class="text-muted fw-semibold fs-6 mb-2"><span class="hp-num">@p.Mrn</span> · @T["sex:" + p.Sex]@if (Model.Age is int ag) {<text> · @string.Format(T["{0} years"].Value, ag)</text>}</span>
        <div class="d-flex flex-wrap gap-1">
            @if (!string.IsNullOrWhiteSpace(p.Allergies)) {<span class="badge badge-light-danger fs-8 fw-bold"><i class="ki-outline ki-shield-cross fs-8 text-danger me-1"></i><bdi>@p.Allergies</bdi></span>}
            @if (Model.Admitted) {<span class="badge badge-light-info fs-8 fw-bold">@T["In hospital now"]</span>}
            @if (Model.Insured) {<span class="badge badge-light-success fs-8 fw-bold"><bdi>@Model.Payer</bdi></span>} else {<span class="badge badge-light fs-8 fw-bold">@T["Self-pay"]</span>}
        </div>
    </div>
</div>

@* the check-in checklist *@
<div class="card card-flush border border-dashed border-@(blocked ? "danger" : "gray-300") mb-6">
    <div class="card-header min-h-50px"><h3 class="card-title fs-6 fw-bold text-gray-800">@T["Check-in checklist"]</h3>
        <div class="card-toolbar">@if (blocked) {<span class="badge badge-light-danger fs-8 fw-bold">@T["Needs attention"]</span>} else {<span class="badge badge-light-success fs-8 fw-bold">@T["Ready to check in"]</span>}</div></div>
    <div class="card-body pt-0">
        @foreach (var c in Model.Checklist)
        {
            string tone = c.Done ? "success" : c.Blocks ? "danger" : "primary";
            <div class="d-flex align-items-center py-2">
                <span class="symbol symbol-25px me-3"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@(c.Done ? "check" : c.Blocks ? "cross" : "information-5") fs-6 text-@tone"></i></span></span>
                <span class="text-gray-800 fw-semibold fs-7 flex-grow-1">@T["chk:" + c.Key]</span>
                <span class="fs-8 @(c.Done ? "text-muted" : "text-" + tone + " fw-bold") text-end">
                    @if (c.Key == "payer" && c.Detail == "self") {@T["Self-pay"]}
                    else if (c.Key == "balance" && c.Detail != null) {<span class="hp-num">@Model.Owed.ToString("N" + (ViewBag.MoneyDp is int bdp ? bdp : 2), inv)</span> <span class="text-muted">@ViewBag.Currency</span>}
                    else if (c.Key == "phone" || c.Key == "identity") {<span class="hp-num" dir="ltr">@c.Detail</span>}
                    else if (!c.Done) {@(c.Blocks ? T["Needs attention"] : T["Owed"])}
                </span>
            </div>
        }
    </div>
</div>

@* today *@
<div class="fw-bold text-gray-800 fs-6 mb-3">@T["Today"]</div>
@if (Model.Today.Count == 0) {<div class="text-muted fs-7 mb-5">@T["No appointment today."]</div>}
@foreach (var r in Model.Today)
{
    <div class="d-flex flex-stack bg-light rounded p-4 mb-3">
        <div class="d-flex flex-column">
            <span class="text-gray-900 fw-bold fs-7"><span class="hp-num">@Time(r.A.StartMinute)</span> · <bdi>@DisplayName.Of(r.Doctor, r.DoctorEn)</bdi></span>
            <span class="text-muted fs-8">@T["desk:" + r.Stage]@if (r.A.QueueNumber is int q) {<text> · @T["No."] </text><span class="hp-num">@q</span>}@if (r.Late) {<text> · </text><span class="text-danger fw-bold">@T["Late"]</span>}</span>
        </div>
        @if (canBook && r.Stage == HospitalDeskStage.Expected)
        {
            <div class="d-flex gap-1">
                <button type="button" class="btn btn-sm btn-primary" data-move="Arrived" data-appt="@r.A.Id"><i class="ki-outline ki-check fs-5"></i>@T["Check in"]</button>
                <button type="button" class="btn btn-sm btn-icon btn-light btn-active-light-danger" data-move="NoShow" data-appt="@r.A.Id" data-ask="@string.Format(T["Mark {0} as a no-show?"].Value, DisplayName.Of(p.Name, p.NameEn))"><i class="ki-outline ki-cross-circle fs-4"></i></button>
            </div>
        }
    </div>
}

@* a walk-in *@
@if (canBook && !Model.Today.Any(r => r.Stage is HospitalDeskStage.Expected or HospitalDeskStage.Waiting or HospitalDeskStage.WithDoctor))
{
    <div class="border border-dashed border-primary rounded p-4 mb-6">
        <div class="fw-bold text-gray-800 fs-7 mb-3"><i class="ki-outline ki-entrance-right fs-5 text-primary me-1"></i>@T["Walk-in: the doctor's next free slot today"]</div>
        <div class="row g-3">
            <div class="col-md-7"><select class="form-select form-select-solid form-select-sm" data-walkin-doctor><option value="">@T["Choose the doctor"]</option>
                @foreach (var d in Model.Doctors) { <option value="@d.Id">@DisplayName.Of(d.Name, d.NameEn)@if (d.Department != null) {<text> · @DisplayName.Of(d.Department, d.DepartmentEn)</text>}</option> }</select></div>
            <div class="col-md-5"><select class="form-select form-select-solid form-select-sm" data-walkin-type>@foreach (var v in HospitalVisitTypes.All) { <option value="@v">@T["visit:" + v]</option> }</select></div>
        </div>
        <button type="button" class="btn btn-sm btn-primary w-100 mt-3" data-walkin="@p.ID" data-need="@T["Choose the doctor"]" data-done="@T["Booked and checked in"]"><i class="ki-outline ki-entrance-right fs-5"></i>@T["Book and check in now"]</button>
    </div>
}

@* next visits *@
@if (Model.Upcoming.Count > 0)
{
    <div class="fw-bold text-gray-800 fs-6 mb-3">@T["Next visits"]</div>
    @foreach (var a in Model.Upcoming)
    {
        <div class="d-flex flex-stack py-2"><span class="text-gray-800 fs-7 hp-num">@a.Date.ToString("yyyy-MM-dd") · @Time(a.StartMinute)</span><span class="badge badge-light fs-8">@T["visit:" + a.VisitType]</span></div>
    }
    <div class="separator separator-dashed my-4"></div>
}

@* insurance and money *@
<div class="d-flex flex-wrap gap-3 mb-6">
    <div class="border border-gray-300 border-dashed rounded py-3 px-4 flex-grow-1">
        <div class="fs-8 text-muted fw-semibold">@T["Insurance"]</div>
        <div class="fs-6 fw-bold text-gray-800"><bdi>@(Model.Payer ?? T["Self-pay"].Value)</bdi></div>
        @if (Model.PolicyNo != null) {<div class="fs-8 text-muted hp-num">@Model.PolicyNo</div>}
        @if (Model.Ineligible) {<span class="badge badge-light-danger fs-8 fw-bold">@T["Not covered today"]</span>}
    </div>
    <div class="border border-@(Model.Owed > 0 ? "danger" : "gray-300") border-dashed rounded py-3 px-4 flex-grow-1">
        <div class="fs-8 text-muted fw-semibold">@T["Owed"]</div>
        <div class="fs-4 fw-bold text-@(Model.Owed > 0 ? "danger" : "gray-800")"><span class="hp-num">@Model.Owed.ToString("N" + (ViewBag.MoneyDp is int dp ? dp : 2), inv)</span> <span class="fs-8 text-muted fw-semibold">@ViewBag.Currency</span></div>
        <div class="fs-8 text-muted">@string.Format(T["{0} open bills"].Value, Model.OpenBills)</div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a href="@Url.Action("Patient", "Hospital", new { id = p.ID })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-document fs-5"></i>@T["Open the file"]</a>
    <a href="@Url.Action("EditPatient", "Hospital", new { id = p.ID })" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-pencil fs-5"></i>@T["Edit the file"]</a>
    <a href="@Url.Action("NewConsent", "Hospital", new { id = p.ID })" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-notepad-edit fs-5"></i>@T["Sign a consent"]</a>
    <a href="@Url.Action("Bills", "Hospital")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-bill fs-5"></i>@T["Bills"]</a>
</div>
