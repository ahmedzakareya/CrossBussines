@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDeskCard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H139/H140: the patient at the counter, as the approved prototype lays it out:
     · the banner (face, names, file, age, sex, blood group, allergy, payer, in hospital);
     · today's visit (time, doctor, room, queue number);
     · the check-in steps: identity and the payer decision need attention, the rest is owed; nothing refuses care;
     · the money at the counter (owed, open bills, the insurer) with "collect";
     · the next visits; then check in (or walk-in), no-show, the file, a consent.
   H154: where the patient is now (under the banner), and their history as the desk needs it — administrative only. *@
@{
    var p = Model.Patient; var inv = System.Globalization.CultureInfo.InvariantCulture;
    bool canBook = ViewBag.CanBook == true, canBill = ViewBag.CanBill == true;
    int dp = ViewBag.MoneyDp is int d0 ? d0 : 2; string cur = ViewBag.Currency as string ?? "";
    string Money(decimal v) => v.ToString("N" + dp, inv);
    string Time(int minute) => (minute / 60).ToString("00") + ":" + (minute % 60).ToString("00");
    string name = DisplayName.Of(p.Name, p.NameEn);
    var visit = Model.Today.FirstOrDefault(r => r.Stage is HospitalDeskStage.Expected or HospitalDeskStage.Waiting or HospitalDeskStage.WithDoctor) ?? Model.Today.FirstOrDefault(r => r.Stage != HospitalDeskStage.Cancelled);
    bool active = Model.Today.Any(r => r.Stage is HospitalDeskStage.Expected or HospitalDeskStage.Waiting or HospitalDeskStage.WithDoctor);
    var where = ViewBag.Where as IReadOnlyList<HospitalWhere> ?? Array.Empty<HospitalWhere>(); bool restricted = ViewBag.Restricted == true;
    var hist = ViewBag.History as HospitalDeskHistory;
    var gaps = ViewBag.Gaps as IReadOnlyList<HospitalCheckinGap> ?? Array.Empty<HospitalCheckinGap>(); DateTime todayD = ViewBag.Today is DateTime td ? td : DateTime.Today;   // H159
    string WhereIcon(string k) => k switch { HospitalWhereKind.Theatre => "ki-pulse", HospitalWhereKind.Emergency => "ki-heart-circle", HospitalWhereKind.Imaging => "ki-scan-barcode",
        HospitalWhereKind.Ward => "ki-home-2", _ => "ki-hospital" };
    string EventIcon(string k) => k switch { HospitalDeskEventKind.Admission => "ki-home-2", HospitalDeskEventKind.Emergency => "ki-heart-circle", HospitalDeskEventKind.Operation => "ki-pulse", _ => "ki-calendar-tick" };
    var steps = new (string Key, string Icon, string Label)[] {
        ("identity", "ki-profile-circle", T["Identity"].Value), ("payer", "ki-shield-tick", T["Insurance"].Value), ("phone", "ki-notepad-edit", T["Contact details"].Value),
        ("consent", "ki-notepad-edit", T["Consents"].Value), ("photo", "ki-picture", T["Photo"].Value), ("balance", "ki-wallet", T["Payment"].Value) };
}
@* the banner *@
<div class="d-flex align-items-center mb-5">
    <div class="symbol symbol-75px symbol-circle me-4 flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-2 hp-initials">@HospitalUi.Initials(p.NameEn ?? p.Name)</span>}</div>
    <div class="d-flex flex-column min-w-0">
        <span class="text-gray-900 fw-bold fs-4" data-desk-name><bdi>@name</bdi></span>
        <span class="text-muted fw-semibold fs-7"><span class="hp-num">@p.Mrn</span> · @T["sex:" + p.Sex]@if (Model.Age is int ag) {<text> · @string.Format(T["{0} years"].Value, ag)</text>}@if (!string.IsNullOrWhiteSpace(p.BloodGroup)) {<text> · @T["Blood"] </text><span class="hp-num">@p.BloodGroup</span>}</span>
        <div class="d-flex flex-wrap gap-1 mt-2">
            @if (!string.IsNullOrWhiteSpace(p.Allergies)) {<span class="badge badge-light-danger fs-8 fw-bold"><i class="ki-outline ki-shield-cross fs-8 text-danger me-1"></i><bdi>@HospitalAllergyText.Display(p.Allergies)</bdi></span>}
            @if (Model.Insured) {<span class="badge badge-light-primary fs-8 fw-bold"><bdi>@Model.Payer</bdi></span>} else if (Model.Ineligible) {<span class="badge badge-light-danger fs-8 fw-bold">@T["Not covered today"]</span>} else {<span class="badge badge-light fs-8 fw-bold">@T["Self-pay"]</span>}
        </div>
    </div>
</div>

@* H157: a similar name is a reason to check, never a match *@
@{ var looks = ViewBag.Lookalikes as IReadOnlyList<HospitalLookalike> ?? Array.Empty<HospitalLookalike>(); }
@if (looks.Count > 0)
{
    <div class="rounded border border-dashed border-danger bg-light-danger p-4 mb-5" data-desk-lookalikes>
        <div class="d-flex align-items-center gap-2 fw-bold fs-7 text-danger mb-2"><i class="ki-outline ki-shield-cross fs-4 text-danger"></i>@T["Another file has a similar name: confirm the date of birth with the patient"]</div>
        <div class="fs-8 text-gray-800 mb-2">@T["This file"]: <span class="hp-num fw-bold">@p.Mrn</span> · @(p.BirthDate is DateTime bd0 ? Html.Raw("<span class=\"hp-num\" dir=\"ltr\">" + bd0.ToString("yyyy-MM-dd") + "</span>") : T["no date of birth"])</div>
        @foreach (var o in looks)
        {
            <div class="d-flex flex-stack fs-8 py-1 border-top border-dashed border-gray-300">
                <span><bdi class="fw-bold">@DisplayName.Of(o.Name, o.NameEn)</bdi> · <span class="hp-num">@o.Mrn</span> · @(o.BirthDate is DateTime bd ? Html.Raw("<span class=\"hp-num\" dir=\"ltr\">" + bd.ToString("yyyy-MM-dd") + "</span>") : T["no date of birth"])@if (o.PhoneTail != null) {<text> · </text><span class="hp-num" dir="ltr">…@o.PhoneTail</span>}</span>
                <a href="@Url.Action("DuplicatesCompare", "Hospital", new { a = p.ID, b = o.Id })" class="fw-bold text-nowrap ms-2" target="_blank">@T["Compare"]</a>
            </div>
        }
    </div>
}

@* H154: where the patient is now — what the desk answers a visitor *@
<div class="mb-5" data-desk-where>
    @if (restricted)
    {
        <div class="d-flex align-items-center gap-3 bg-light rounded p-4"><i class="ki-outline ki-lock-2 fs-2 text-gray-600"></i><div class="fs-7 text-gray-700">@T["Confidential file: the desk does not give where this patient is."]</div></div>
    }
    else if (where.Count > 0)
    {
        <div class="rounded border border-dashed border-primary bg-light-primary p-4">
            <div class="fw-bold fs-8 text-primary text-uppercase mb-2">@T["Where now"]</div>
            @foreach (var w in where)
            {
                <div class="d-flex align-items-start gap-3 mb-2">
                    <span class="symbol symbol-35px flex-shrink-0"><span class="symbol-label bg-primary"><i class="ki-outline @WhereIcon(w.Kind) fs-3 text-white"></i></span></span>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-bold fs-6 text-gray-900"><bdi>@DisplayName.Of(w.Place, w.PlaceEn)</bdi>@if (w.Live) {<span class="bullet bullet-dot bg-danger h-8px w-8px ms-2 animation-blink"></span>}</div>
                        @if (w.Detail != null) {<div class="fs-7 text-gray-700"><bdi>@DisplayName.Of(w.Detail, w.DetailEn)</bdi></div>}
                        <div class="fs-8 text-muted">@T["where:" + w.Kind]@if (w.Since is DateTime since) {<text> · @T["Since"] </text><span class="hp-num" dir="ltr">@since.ToLocalTime().ToString("HH:mm")</span>}
                            @if (w.FloorId is int fl) {<text> · </text><a href="@Url.Action("Map", "Hospital", new { floor = fl })" class="fw-bold">@T["On the map"]</a>}</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 bg-light rounded p-4"><i class="ki-outline ki-exit-right fs-2 text-gray-500"></i><div class="fs-7 text-gray-700">@T["Not in the hospital now, as far as the system knows."]</div></div>
    }
</div>

@* today's visit *@
@if (visit != null)
{
    <div class="d-flex gap-3 mb-5 bg-light-primary rounded p-4">
        <i class="ki-outline ki-calendar-tick fs-2 text-primary"></i>
        <div class="flex-grow-1 min-w-0">
            <div class="fw-bold fs-7 text-gray-900">@T["Today's visit"] <span class="hp-num">@Time(visit.A.StartMinute)</span> · <bdi>@DisplayName.Of(visit.Doctor, visit.DoctorEn)</bdi></div>
            <div class="text-muted fs-8">@T["visit:" + visit.A.VisitType]@if (visit.Department != null) {<text> · </text><bdi>@DisplayName.Of(visit.Department, visit.DepartmentEn)</bdi>} · @T["desk:" + visit.Stage]@if (visit.A.QueueNumber is int q) {<text> · @T["No."] </text><span class="hp-num">@q</span>}@if (visit.Late) {<text> · </text><span class="text-danger fw-bold">@T["Late"]</span>}</div>
        </div>
    </div>
}
else
{
    <div class="d-flex gap-3 mb-5 bg-light rounded p-4"><i class="ki-outline ki-calendar fs-2 text-gray-500"></i><div class="fs-7 text-gray-700 align-self-center">@T["No appointment today."]</div></div>
}

@* the check-in steps *@
<div class="fw-bold fs-7 text-gray-800 mb-3">@T["Check-in steps"]</div>
@for (int i = 0; i < steps.Length; i++)
{
    var s = steps[i]; var c = Model.Checklist.FirstOrDefault(x => x.Key == s.Key); if (c == null) { continue; }
    string tone = c.Done ? "primary" : c.Blocks ? "danger" : "primary";
    <div class="d-flex align-items-center mb-4">
        <span class="symbol symbol-35px me-3"><span class="symbol-label bg-light-@tone"><i class="ki-outline @s.Icon fs-3 text-@tone"></i></span></span>
        <div class="flex-grow-1 min-w-0">
            <div class="fw-bold fs-7 text-gray-800">@(i + 1). @s.Label</div>
            <div class="fs-8 @(c.Done ? "text-muted" : c.Blocks ? "text-danger fw-bold" : "text-muted")">
                @if (c.Key == "identity") {@if (c.Done) {@if (c.Detail != null) {<span class="hp-num" dir="ltr">@c.Detail</span>} else {@T["Known by the photo"]}} else {@T["No ID and no photo on file"]}}
                else if (c.Key == "payer") {@if (Model.Insured) {<bdi>@Model.Payer</bdi>@if (Model.PolicyNo != null) {<text> · </text><span class="hp-num">@Model.PolicyNo</span>}} else if (Model.Ineligible) {@T["The policy does not cover today"]} else {@T["Self-pay"]}}
                else if (c.Key == "phone") {@if (c.Done) {<span class="hp-num" dir="ltr">@c.Detail</span>} else {@T["No mobile on file"]}}
                else if (c.Key == "consent") {@(c.Done ? T["Signed"] : T["Not signed yet"])}
                else if (c.Key == "photo") {@(c.Done ? T["On file"] : T["No photo yet"])}
                else if (c.Key == "balance") {@if (c.Done) {@T["Nothing owed"]} else {<span>@T["Owed"] </span><span class="hp-num">@Money(Model.Owed)</span> <span>@cur</span>}}
            </div>
            @if (!c.Done && gaps.FirstOrDefault(x => x.Item == c.Key) is HospitalCheckinGap gp)
            {
                <div class="fs-8 fw-semibold @(gp.DueDate.Date < todayD.Date ? "text-danger" : "text-primary")"><i class="ki-outline ki-notepad-edit fs-7 me-1"></i>@T["Followed up"] · @T["due by"] <span class="hp-num" dir="ltr">@gp.DueDate.ToString("yyyy-MM-dd")</span></div>
            }
        </div>
        @if (c.Key == "payer" && visit != null && c.Done) {<button type="button" class="btn btn-sm btn-icon btn-light btn-active-light-primary w-30px h-30px me-2" data-desk-coverage="@visit.A.Id" title="@T["Insurance for this visit"]" data-bs-toggle="tooltip"><i class="ki-outline ki-shield-search fs-4"></i></button>}   @* H162 *@
        @if (!c.Done && !gaps.Any(x => x.Item == c.Key)) {<button type="button" class="btn btn-sm btn-icon btn-light btn-active-light-primary w-30px h-30px me-2" data-desk-gap="@p.ID" data-item="@c.Key" title="@T["Follow up later"]" data-bs-toggle="tooltip"><i class="ki-outline ki-notepad-edit fs-4"></i></button>}   @* H159 *@
        @if (c.Done) {<i class="ki-outline ki-check-circle fs-2 text-primary"></i>}
        else if (c.Key is "identity" or "phone" or "photo") {<a href="@Url.Action("EditPatient", "Hospital", new { id = p.ID })" class="btn btn-sm btn-light-@(c.Blocks ? "danger" : "primary") py-1 px-3">@T["Complete"]</a>}
        else if (c.Key == "payer" && visit != null) {<button type="button" class="btn btn-sm btn-light-danger py-1 px-3" data-desk-coverage="@visit.A.Id">@T["Check"]</button>}   @* H162: this visit's cover *@
        else if (c.Key == "payer") {<a href="@Url.Action("Insurance", "Hospital")" class="btn btn-sm btn-light-danger py-1 px-3">@T["Check"]</a>}
        else if (c.Key == "consent") {<a href="@Url.Action("NewConsent", "Hospital", new { id = p.ID })" class="btn btn-sm btn-light-primary py-1 px-3">@T["Sign"]</a>}
        else if (c.Key == "balance" && canBill) {<button type="button" class="btn btn-sm btn-light-primary py-1 px-3" data-desk-pay="@p.ID">@T["Collect payment"]</button>}
    </div>
}

@* the money at the counter *@
<div class="bg-light rounded p-4 mb-5">
    <div class="fw-bold fs-7 text-gray-800 mb-3">@T["At the counter"]</div>
    <div class="d-flex flex-stack fs-7 py-1"><span class="text-gray-600">@T["Payer"]</span><span class="fw-bold text-end"><bdi>@(Model.Payer ?? T["Self-pay"].Value)</bdi></span></div>
    <div class="d-flex flex-stack fs-7 py-1"><span class="text-gray-600">@T["Open bills"]</span><span class="fw-bold hp-num">@Model.OpenBills</span></div>
    @if (Model.DepositLeft > 0) {<div class="d-flex flex-stack fs-7 py-1"><span class="text-gray-600">@T["Deposit held"]</span><span class="fw-bold text-primary"><span class="hp-num">@Money(Model.DepositLeft)</span> @cur</span></div>}
    <div class="separator separator-dashed my-2"></div>
    <div class="d-flex flex-stack"><span class="fw-bold">@T["Total due"]</span><span class="fw-bold fs-3 text-@(Model.Owed > 0 ? "danger" : "gray-800")"><span class="hp-num">@Money(Model.Owed)</span> <span class="fs-8 text-muted fw-semibold">@cur</span></span></div>
    @if (canBill)
    {
        <div class="d-flex gap-2 mt-3">
            @if (Model.Owed > 0) {<button type="button" class="btn btn-sm btn-primary flex-grow-1" data-desk-pay="@p.ID"><i class="ki-outline ki-wallet fs-4"></i>@T["Collect at the counter"]</button>}
            <button type="button" class="btn btn-sm btn-light-primary flex-grow-1" data-desk-pay="@p.ID"><i class="ki-outline ki-plus fs-4"></i>@T["Deposit"]</button>
        </div>
    }
</div>

@* H144: the counter's papers — Report Studio layouts only (the visit slip and the queue ticket of today's visit, the wristband) *@
<div class="fw-bold fs-7 text-gray-800 mb-3">@T["Print"]</div>
<div class="d-flex flex-wrap gap-2 mb-5">
    @if (visit != null)
    {
        @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDeskVisit, DocumentId = visit.A.Id.ToString(), DocumentTitle = name, ButtonLabel = T["Visit slip & ticket"].Value })
    }
    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDeskPatient, DocumentId = p.ID.ToString(), DocumentTitle = name, ButtonLabel = T["Wristband"].Value })
</div>

@* the next visits *@
@if (Model.Upcoming.Count > 0)
{
    <div class="fw-bold fs-7 text-gray-800 mb-2">@T["Next visits"]</div>
    @foreach (var a in Model.Upcoming)
    {
        <div class="d-flex flex-stack py-2 fs-7"><span class="text-gray-800 hp-num">@a.Date.ToString("yyyy-MM-dd") · @Time(a.StartMinute)</span>
            <span class="d-flex align-items-center gap-2"><span class="badge badge-light fs-8">@T["visit:" + a.VisitType]</span>
                @if (canBook) {<button type="button" class="btn btn-sm btn-icon btn-light btn-active-light-primary w-25px h-25px" data-desk-resched="@a.Id" title="@T["Move the appointment"]" data-bs-toggle="tooltip"><i class="ki-outline ki-calendar-edit fs-5"></i></button>}</span></div>
    }
    <div class="separator separator-dashed my-4"></div>
}

@* H154: the history the desk needs — visits, stays, emergency visits, operations; never a diagnosis or a result *@
@if (hist != null)
{
    <div class="mb-5" data-desk-history>
        <div class="d-flex flex-stack mb-3"><span class="fw-bold fs-7 text-gray-800">@T["Previous history"]</span>
            @if (!hist.Restricted && hist.FirstSeen is DateTime fs) {<span class="text-muted fs-8">@T["Known since"] <span class="hp-num" dir="ltr">@fs.ToString("yyyy-MM-dd")</span></span>}</div>
        @if (hist.Restricted)
        {
            <div class="d-flex align-items-center gap-3 bg-light rounded p-4"><i class="ki-outline ki-lock-2 fs-2 text-gray-600"></i><div class="fs-7 text-gray-700">@T["Confidential file: its history opens only for the care team."]</div></div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                <span class="badge badge-light-primary fs-8 fw-bold">@T["Clinic visits"] <span class="hp-num ms-1">@hist.Visits</span></span>
                @if (hist.NoShows > 0) {<span class="badge badge-light-danger fs-8 fw-bold">@T["Did not come"] <span class="hp-num ms-1">@hist.NoShows</span></span>}
                <span class="badge badge-light-primary fs-8 fw-bold">@T["Stays"] <span class="hp-num ms-1">@hist.Admissions</span></span>
                <span class="badge badge-light-primary fs-8 fw-bold">@T["Emergency visits"] <span class="hp-num ms-1">@hist.EmergencyVisits</span></span>
                <span class="badge badge-light-primary fs-8 fw-bold">@T["Operations"] <span class="hp-num ms-1">@hist.Operations</span></span>
            </div>
            @if (hist.Recent.Count == 0) {<div class="text-muted fs-7 mb-2">@T["A new patient: nothing before today."]</div>}
            @foreach (var e in hist.Recent)
            {
                bool bad = e.State is HospitalAppointmentStatus.NoShow or HospitalAppointmentStatus.Cancelled or HospitalSurgeryStatus.Cancelled or HospitalErOutcome.LeftWithoutBeingSeen or HospitalErOutcome.Deceased;
                <div class="d-flex align-items-start gap-3 py-2 border-bottom border-gray-200 border-bottom-dashed">
                    <span class="symbol symbol-30px flex-shrink-0"><span class="symbol-label bg-light"><i class="ki-outline @EventIcon(e.Kind) fs-4 text-gray-700"></i></span></span>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fs-7 fw-bold text-gray-800">@T["hk:" + e.Kind]@if (!string.IsNullOrWhiteSpace(e.Title)) {<text> · </text><bdi>@DisplayName.Of(e.Title, e.TitleEn)</bdi>}</div>
                        <div class="fs-8 text-muted"><span class="hp-num" dir="ltr">@e.At.ToString("yyyy-MM-dd")</span>@if (e.Until is DateTime u) {<text> → </text><span class="hp-num" dir="ltr">@u.ToLocalTime().ToString("yyyy-MM-dd")</span>}@if (e.Detail != null) {<text> · </text><bdi>@DisplayName.Of(e.Detail, e.DetailEn)</bdi>}</div>
                    </div>
                    <span class="badge badge-light@(bad ? "-danger" : "") fs-8 fw-bold text-nowrap">@T["hst:" + e.Kind + ":" + e.State]</span>
                </div>
            }
            <a href="@Url.Action("Patient", "Hospital", new { id = p.ID })" class="d-inline-block fs-7 fw-bold mt-3"><i class="ki-outline ki-document fs-6 me-1"></i>@T["The full file"]</a>
        }
    </div>
}

@* the acts *@
<div class="d-flex flex-wrap gap-2 mt-2">
    @if (canBook && visit != null && visit.Stage == HospitalDeskStage.Expected)
    {
        <button type="button" class="btn btn-primary flex-grow-1" data-move="Arrived" data-appt="@visit.A.Id"><i class="ki-outline ki-check fs-3"></i>@T["Check in"]</button>
        <button type="button" class="btn btn-icon btn-light btn-active-light-primary" data-desk-resched="@visit.A.Id" title="@T["Move the appointment"]" data-bs-toggle="tooltip"><i class="ki-outline ki-calendar-edit fs-3"></i></button>
        <button type="button" class="btn btn-icon btn-light btn-active-light-danger" data-move="NoShow" data-appt="@visit.A.Id" data-ask="@string.Format(T["Mark {0} as a no-show?"].Value, name)" title="@T["No-show"]" data-bs-toggle="tooltip"><i class="ki-outline ki-cross-circle fs-3"></i></button>
    }
    else if (visit != null && visit.Stage == HospitalDeskStage.Done)
    {
        <button type="button" class="btn btn-light-primary flex-grow-1" data-desk-checkout="@visit.A.Id"><i class="ki-outline ki-exit-right fs-3"></i>@T["Check out"]</button>   @* H160 *@
    }
    else if (visit != null && visit.Stage is HospitalDeskStage.Waiting or HospitalDeskStage.WithDoctor)
    {
        <span class="btn btn-light-primary flex-grow-1 pe-none"><i class="ki-outline ki-check-circle fs-3"></i>@T["desk:" + visit.Stage]@if (visit.A.QueueNumber is int q2) {<text> · </text><span class="hp-num">@q2</span>}</span>
    }
    @if (canBook && !active)
    {
        <button type="button" class="btn btn-primary flex-grow-1" data-desk-walkin="@p.ID"><i class="ki-outline ki-entrance-right fs-3"></i>@T["Walk-in"]</button>
    }
    <button type="button" class="btn btn-light-primary" data-desk-arrival="@p.ID"><i class="ki-outline ki-send fs-3"></i>@T["Send on"]</button>   @* H158 *@
    <a href="@Url.Action("Patient", "Hospital", new { id = p.ID })" class="btn btn-light btn-active-light-primary"><i class="ki-outline ki-document fs-3"></i>@T["File"]</a>
</div>
