@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalLicencePage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H265 — professional licences ahead of their lapse: expired, ending within 60 days, or not on file. Each
    practitioner is told at 60, 30 and 7 days and when it lapses (once per stage). Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Licences"].Value;
    string state = ViewBag.State as string ?? "", q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p, string? s = null) => Url.Action("Licences", new { state = s ?? state, q, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Licences"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Practitioners")" class="text-muted text-hover-primary">@T["Doctors"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Licences"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 mb-5">
            @foreach (var (s, n, danger) in new[] { ("Expired", Model.Expired, true), ("Expiring", Model.Expiring, Model.Expiring > 0), ("Missing", Model.Missing, false) })
            {
                <div class="col-md-4"><a href="@Link(1, state == s ? "" : s)" class="card card-flush h-100 @(state == s ? "border border-primary" : "") text-hover-primary"><div class="card-body py-6">
                    <span class="fs-2hx fw-bold hp-num text-@(danger && n > 0 ? "danger" : "gray-900")">@n</span><div class="text-gray-600 fw-semibold fs-6">@T["lic:" + s]</div></div></a></div>
            }
        </div>
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Licences needing attention"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["A lapsed licence already stops bookings, theatre and on-call; each doctor is reminded at 60, 30 and 7 days"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("Licences")">
                    <input type="hidden" name="state" value="@state" />
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-225px ps-12" placeholder="@T["Search a doctor or licence number"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Rows.Count == 0)
                {
                    <div class="text-center py-15"><i class="ki-outline ki-shield-tick fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["Every licence is valid for more than 60 days."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Doctor"]</th><th>@T["Licence number"]</th><th>@T["Expires"]</th><th>@T["Status"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var nm = DisplayName.Of(r.Doctor.Name, r.Doctor.NameEn);
                            <tr>
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Face?.Photo, nm, 35)<div><div class="fw-bold text-gray-900">@nm</div><div class="text-muted fs-8">@DisplayName.Of(r.Doctor.Title ?? "", r.Doctor.TitleEn ?? r.Doctor.Title ?? "")</div></div></div></td>
                                <td class="fs-7 hp-num" dir="ltr">@(r.Doctor.LicenseNumber ?? "—")</td>
                                <td class="fs-7"><span class="hp-num" dir="ltr">@(r.Doctor.LicenseExpiry?.ToString("dd/MM/yyyy", inv) ?? "—")</span>@if (r.DaysLeft is int d) {<div class="text-muted fs-8">@(d < 0 ? T["{0} days ago", -d] : T["in {0} days", d])</div>}</td>
                                <td><span class="badge badge-light-@(r.State == "Expired" ? "danger" : r.State == "Expiring" ? "info" : r.State == "Missing" ? "danger" : "primary") fs-8">@T["lic:" + r.State]</span></td>
                                <td class="text-end"><a href="@Url.Action("EditPractitioner", new { id = r.Doctor.ID })" class="btn btn-sm btn-light-primary">@T["Update"]</a></td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>
