@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@using Microsoft.AspNetCore.Html
@model HospitalBillView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — the patient's bill, composed from demo39: stat tiles (dashboards/logistics), the order-details summary cards
    (apps/ecommerce/sales/details), the table widget with an invoice total block (widgets/tables, apps/invoices/view),
    list-widget rows for the payments and the journal.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var b = Model.Bill; var p = Model.Patient; var t = Model.Totals;
    ViewData["Title"] = T["Bill"].Value + " " + b.BillNo;
    var currency = ViewBag.Currency as HospitalCurrency;
    bool isAr = DisplayName.IsArabic, canBill = ViewBag.CanBill == true, open = b.Status == HospitalBillStatus.Open;
    var journal = (ViewBag.Journal as IReadOnlyList<HospitalLedgerLine>) ?? Array.Empty<HospitalLedgerLine>();
    string? missing = ViewBag.JournalMissing as string;
    var accountNames = (ViewBag.AccountNames as Dictionary<int, string>) ?? new();
    var myShift = ViewBag.MyShift as HospitalCashierShift;
    var admission = ViewBag.Admission as HospitalAdmission;
    var encounter = ViewBag.Encounter as HospitalEncounter;
    // H7: the bill's own amounts are in ITS currency (its price list's); the journal is in the facility's.
    var billCur = Model.Currency;
    string M(decimal v) => billCur != null ? billCur.Format(v) : currency == null ? v.ToString("N2") : currency.Format(v);
    string Dash(decimal v) => v == 0 ? "—" : M(v);
    string cur = billCur?.Label(isAr) ?? currency?.Label(isAr) ?? "";
    string MF(decimal v) => currency == null ? v.ToString("N2") : currency.Format(v);
    string DashF(decimal v) => v == 0 ? "—" : MF(v);
    string facCur = currency?.Label(isAr) ?? "";
    bool foreign = Model.Foreign;
    var name = DisplayName.Of(p.Name, p.NameEn);
    // H63: charity waivers on this bill — requested at the desk, decided by the administrator (never the requester)
    var charity = (ViewBag.Charity as IReadOnlyList<HospitalCharityRow>) ?? Array.Empty<HospitalCharityRow>();
    bool charityReady = ViewBag.CharityReady == true, canManage = ViewBag.CanManage == true;
    var funds = (ViewBag.CharityFunds as List<HospitalCharityFund>) ?? new();
    int? me = ViewBag.Me as int?;
    bool canAskCharity = charityReady && canBill && !open && !foreign && t.Due > 0;
    string PmIcon(string m) => m == HospitalPaymentMethods.Cash ? "dollar" : m == HospitalPaymentMethods.Card ? "credit-cart" : m == HospitalPaymentMethods.Transfer ? "bank" : "wallet";
    // H272: the theme's two-tone icons (the owner: rich icons, like the rest of the hospital screens)
    IHtmlContent Duo(string icon, string css)
    {
        var n = icon switch { "bill" => 6, "wallet" => 4, "book" => 4, "lock-2" => 5, "dollar" => 3, "price-tag" => 3, "profile-circle" => 3, _ => 2 };
        var sb = new System.Text.StringBuilder("<i class=\"ki-duotone ki-" + icon + " " + css + "\">");
        for (int k = 1; k <= n; k++) sb.Append("<span class=\"path" + k + "\"></span>");
        return new HtmlString(sb.Append("</i>").ToString());
    }
    string CatIcon(string c) => c switch
    {
        HospitalServiceCategories.Consultation => "pulse", HospitalServiceCategories.Lab => "test-tubes", HospitalServiceCategories.Radiology => "picture",
        HospitalServiceCategories.Procedure => "bandage", HospitalServiceCategories.Accommodation => "home-2", HospitalServiceCategories.Pharmacy => "capsule", _ => "bill",
    };
    bool collected = t.Gross > 0 && t.Due <= 0;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Billing & cashier"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Bills")" class="text-muted text-hover-primary">@T["Bills"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><bdi class="hp-num">@b.BillNo</bdi></li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @* the invoice and the receipt are Report Studio layouts of the bill — see _ReportPrintMenu *@
            @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
            {
                ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalBill,
                DocumentId = b.ID.ToString(),
                DocumentTitle = b.BillNo,
            })
            @if (open && canBill)
            {
                <button type="button" class="btn btn-sm btn-primary" data-close><i class="ki-outline ki-lock-2 fs-4"></i>@(b.AdmissionId != null ? T["Close the stay & post"] : T["Close the visit & post"])</button>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid" id="billRoot">
        @* H272: the bill's head - one card (demo39 account/overview header): who, which bill, the four amounts, where it stands *@
        <div class="card card-flush mb-5"><div class="card-body pt-8 pb-0">
            <div class="d-flex flex-wrap flex-sm-nowrap gap-7 mb-7">
                <div class="symbol symbol-90px symbol-lg-110px symbol-circle flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold fs-1">@HospitalUi.Initials(p.NameEn)</span>}</div>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-4 mb-4">
                        <div class="d-flex flex-column">
                            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                                <a href="@Url.Action("Patient", new { id = p.ID })" class="text-gray-900 text-hover-primary fs-2 fw-bold"><bdi>@name</bdi></a>
                                <span class="badge badge-light-primary fs-7 fw-bold">@if (b.AdmissionId != null) {@T["Inpatient stay"]} else {@T["Outpatient visit"]}</span>
                                <span class="badge @(open ? "badge-light-primary" : "badge-primary") fs-7 fw-bold d-inline-flex align-items-center gap-1">@Duo(open ? "bill" : "lock-2", "fs-5 " + (open ? "text-primary" : "text-white"))@(open ? T["bill:" + b.Status] : T["Closed and posted"])</span>
                            </div>
                            <div class="d-flex flex-wrap align-items-center column-gap-5 row-gap-2 fw-semibold fs-6 text-gray-600">
                                <span class="d-inline-flex align-items-center gap-1">@Duo("profile-circle", "fs-4 text-gray-500")<bdi class="hp-num">@p.Mrn</bdi></span>
                                <span class="d-inline-flex align-items-center gap-1">@Duo("bill", "fs-4 text-gray-500")<bdi class="hp-num">@b.BillNo</bdi></span>
                                <span class="d-inline-flex align-items-center gap-1">@Duo("calendar", "fs-4 text-gray-500")<span class="hp-num text-nowrap" dir="ltr">@b.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>@if (b.ClosedAt is DateTime c && c.ToLocalTime().Date != b.OpenedAt.ToLocalTime().Date) {<span class="text-gray-400 mx-1">—</span><span class="hp-num" dir="ltr">@c.ToLocalTime().ToString("yyyy-MM-dd")</span>}</span>
                                <span class="d-inline-flex align-items-center gap-1">@Duo("price-tag", "fs-4 text-gray-500")@if (Model.List is HospitalPriceList pl) {<a href="@Url.Action("PriceList", new { id = pl.ID })" class="text-gray-600 text-hover-primary"><bdi>@DisplayName.Of(pl.Name, pl.NameEn)</bdi> · <bdi class="hp-num">@pl.Code v@(pl.Version)</bdi></a>} else {<a href="@Url.Action("Catalog")" class="text-gray-600 text-hover-primary">@T["Main list"]</a>}@if (billCur != null) {<span class="badge @(foreign ? "badge-light-info" : "badge-light") fw-bold fs-8 hp-num ms-1">@billCur.Code</span>}</span>
                                @if (admission != null)
                                {
                                    <span class="d-inline-flex flex-wrap align-items-center gap-1">@Duo("home-2", "fs-4 text-gray-500")@T["Admitted"] <span class="hp-num text-nowrap" dir="ltr">@admission.AdmittedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                                        <span class="badge badge-light-@(admission.Status == HospitalAdmissionStatus.Active ? "info" : "primary") fs-8 fw-bold">@(admission.Status == HospitalAdmissionStatus.Active ? T["still in hospital"] : T["discharged"])</span></span>
                                }
                            </div>
                            @if (foreign && b.ExchangeRate is decimal xr)
                            {
                                <div class="text-gray-600 fs-7 mt-2">@T["Closing rate"]: <span class="hp-num fw-bold text-gray-800" dir="ltr">1&nbsp;@billCur!.Code = @xr.ToString("0.####")&nbsp;@(currency?.Code)</span></div>
                            }
                        </div>
                        @if (encounter != null) {<a href="@Url.Action("Consult", new { id = encounter.ID })" class="btn btn-sm btn-light-primary">@Duo("pulse", "fs-3")@T["Open the visit"]</a>}
                    </div>
                    @* the four amounts *@
                    <div class="row g-3 mb-4">
                        @foreach (var k in new[] {
                            (T["Gross"].Value, t.Gross, "bill", false),
                            (T["Insurer share"].Value, t.Insurer, "shield-tick", false),
                            (T["Patient share + tax"].Value, t.Patient + t.Vat, "user", false),
                            (T["Patient balance due"].Value, t.Due, "wallet", true) })
                        {
                            bool owed = k.Item4 && k.Item2 > 0;
                            <div class="col-6 col-lg-3"><div class="rounded py-3 px-4 h-100 border @(k.Item4 ? (owed ? "border-danger bg-light-danger" : "border-primary bg-light-primary") : "border-gray-300 border-dashed")">
                                <div class="d-flex flex-wrap align-items-center gap-2">@Duo(k.Item3, "fs-2 " + (owed ? "text-danger" : "text-primary"))<span class="fs-2 fw-bold hp-num @(owed ? "text-danger" : "text-gray-900")" dir="ltr">@M(k.Item2)</span><span class="text-gray-500 fs-8 fw-semibold">@cur</span></div>
                                <div class="fw-semibold fs-7 text-gray-600 mt-1">@k.Item1</div>
                            </div></div>
                        }
                    </div>
                    @* H18: who covers the bill, and so what the patient is asked for *@
                    <div class="d-flex align-items-start gap-3 p-4 rounded bg-light">
                        @Duo("shield-tick", "fs-2x text-primary flex-shrink-0")
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                @if (Model.Cover is HospitalBillCover cv)
                                {
                                    <span class="fw-bold fs-6 text-gray-900">@T["Covered by"] <bdi>@DisplayName.Of(cv.Payer, cv.PayerEn)</bdi></span>
                                    <span class="badge badge-light-primary fs-8 fw-bold">@T["Co-pay"] <span class="hp-num" dir="ltr">@cv.CopayPct.ToString("0.##")%</span></span>
                                }
                                else if (Model.List is HospitalPriceList onList)
                                {
                                    <span class="fw-bold fs-6 text-gray-900"><bdi>@DisplayName.Of(onList.Name, onList.NameEn)</bdi></span>
                                    <span class="badge badge-light fs-8 fw-bold">@T["kind:" + onList.Kind]</span>
                                }
                                else
                                {
                                    <span class="fw-bold fs-6 text-gray-900">@T["Cash patient"]</span>
                                }
                                <span class="badge badge-light-primary fs-8 fw-bold">@T["VAT"]&nbsp;<span class="hp-num" dir="ltr">@Model.VatRatePercent.ToString("0.##")%</span></span>
                            </div>
                            <div class="text-gray-600 fw-semibold fs-7">
                                @if (Model.Cover is HospitalBillCover cv2)
                                {
                                    @(cv2.Frozen ? T["The split was fixed when the bill closed: the payer is claimed exactly this share."] : T["Split by the patient's cover today: the patient pays the co-pay and what the contract does not cover; the payer is claimed the rest."])
                                    @if (cv2.Discount > 0) { <span class="ms-1">@T["Contract discount (paid by neither side):"] <span class="hp-num fw-bold text-gray-900" dir="ltr">@cv2.Discount.ToString("N3", System.Globalization.CultureInfo.InvariantCulture)</span></span> }
                                }
                                else if (Model.List is HospitalPriceList)
                                {
                                    @T["Priced from the patient's list, in its currency. No cover applies to this bill: the patient pays it in full."]
                                }
                                else
                                {
                                    @T["No cover applies to this bill: the patient pays it in full. Tax applies only to services marked taxable."]
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* where the bill stands: opened, the patient's share collected, closed and posted *@
            <div class="d-flex flex-column flex-md-row align-items-md-center gap-4 border-top border-gray-200 py-6" data-bill-steps>
                @{ int stepNo = 0; }
                @foreach (var (label, isDone, isNow, icon, note) in new[] {
                    (T["Bill opened"].Value, true, false, "bill", b.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")),
                    (T["Patient's share collected"].Value, collected, open && !collected, "wallet", collected ? M(t.Paid) + " " + cur : M(t.Due) + " " + cur),
                    (T["Closed and posted"].Value, !open, open && collected, "lock-2", b.ClosedAt is DateTime cl ? cl.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "") })
                {
                    stepNo++;
                    if (stepNo > 1) {<div class="flex-grow-1 border-top border-2 @(isDone ? "border-primary" : "border-gray-300 border-dashed") d-none d-md-block mx-2"></div>}
                    <div class="d-flex align-items-center gap-3 flex-shrink-0">
                        <div class="symbol symbol-40px"><span class="symbol-label @(isDone ? "bg-primary" : isNow ? "bg-light-primary" : "bg-light")">@Duo(icon, "fs-2 " + (isDone ? "text-white" : isNow ? "text-primary" : "text-gray-500"))</span></div>
                        <div class="d-flex flex-column">
                            <span class="fs-8 fw-semibold @(isNow ? "text-primary" : "text-gray-500")">@(isDone ? T["Done"].Value : string.Format(T["Step {0}"].Value, stepNo))</span>
                            <span class="fw-bold fs-6 @(isDone || isNow ? "text-gray-900" : "text-gray-500")">@label</span>
                            @if (!string.IsNullOrEmpty(note)) {<span class="fs-8 text-gray-500 hp-num" dir="ltr">@note</span>}
                        </div>
                    </div>
                }
            </div>
        </div></div>

        @* the lines — demo39 widgets/tables, with the invoice's total block (apps/invoices/view) *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800 d-flex align-items-center gap-2">@Duo("bill", "fs-2 text-primary")@T["Bill lines"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7"><span class="hp-num">@Model.Lines.Count</span> · @cur</span></h3>
                @if (open && canBill)
                {
                    <div class="card-toolbar d-flex flex-nowrap gap-2 align-items-center">
                        <div class="w-250px w-xl-300px"><select class="form-select form-select-sm form-select-solid" data-no-select2 data-add-service data-placeholder="@T["Add service"]"></select></div>
                        <input type="number" min="1" value="1" class="form-control form-control-sm form-control-solid hp-num w-70px" dir="ltr" data-add-qty />
                        <button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-add-line><i class="ki-outline ki-plus fs-4"></i>@T["Add"]</button>
                    </div>
                }
            </div>
            <div class="card-body pt-2">
                @if (Model.Lines.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-bill fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No lines yet."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Service"]</th><th class="text-end">@T["Qty"]</th><th class="text-end">@T["Price"]</th><th class="text-end">@T["Gross"]</th><th class="text-end">@T["Insurer"]</th><th class="text-end">@T["Patient"]</th><th class="text-end">@T["VAT"]</th><th class="pe-4 rounded-end w-50px"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var l in Model.Lines)
                            {
                                <tr>
                                    <td class="ps-4"><div class="d-flex align-items-center">
                                        <div class="symbol symbol-40px me-4 flex-shrink-0"><span class="symbol-label bg-light-@(l.OutsideList ? "danger" : "primary")">@Duo(l.Running ? "time" : CatIcon(l.Category), "fs-2 text-" + (l.OutsideList ? "danger" : "primary"))</span></div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@(isAr ? l.Description : l.DescriptionEn)</span>
                                            <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num">@l.Code</bdi> · @T["cat:" + l.Category]@if (l.Running) {<span class="badge badge-light-info fs-8 ms-2">@T["Running — counted until discharge"]</span>}@if (l.OutsideList) {<span class="badge badge-light-danger fs-8 ms-2">@T["Outside the list — main price"]</span>}</span></div>
                                    </div></td>
                                    <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@l.Quantity.ToString("0.##")</span></td>
                                    <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@M(l.UnitPrice)</span></td>
                                    <td class="text-end"><span class="text-gray-900 fw-bold hp-num" dir="ltr">@M(l.Gross)</span></td>
                                    <td class="text-end"><span class="text-gray-500 fw-bold hp-num" dir="ltr">@Dash(l.Insurer)</span></td>
                                    <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@Dash(l.Patient)</span></td>
                                    <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@Dash(l.Vat)</span></td>
                                    <td class="text-end pe-4">@if (open && canBill && l.Source == HospitalBillLineSources.Manual && l.Id != null) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" data-remove="@l.Id" title="@T["Remove"]" data-bs-toggle="tooltip"><i class="ki-outline ki-trash fs-3"></i></button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
                @* the invoice total block *@
                <div class="d-flex justify-content-end mt-6">
                    <div class="mw-350px w-100 bg-light rounded p-5">
                        <div class="d-flex flex-stack mb-3"><span class="fw-semibold text-gray-600 fs-7">@T["Gross"]</span><span class="text-end fw-bold fs-6 text-gray-800 hp-num" dir="ltr">@M(t.Gross)</span></div>
                        <div class="d-flex flex-stack mb-3"><span class="fw-semibold text-gray-600 fs-7">@T["Insurer"]</span><span class="text-end fw-bold fs-6 text-gray-800 hp-num" dir="ltr">@M(t.Insurer)</span></div>
                        <div class="d-flex flex-stack mb-3"><span class="fw-semibold text-gray-600 fs-7">@T["Patient"]</span><span class="text-end fw-bold fs-6 text-gray-800 hp-num" dir="ltr">@M(t.Patient)</span></div>
                        <div class="d-flex flex-stack mb-3"><span class="fw-semibold text-gray-600 fs-7">@T["VAT"]</span><span class="text-end fw-bold fs-6 text-gray-800 hp-num" dir="ltr">@M(t.Vat)</span></div>
                        @if (t.Credited > 0)
                        {
                            @* H148: what credit notes took off the closed bill (medicine brought back) *@
                            <div class="d-flex flex-stack mb-3" data-credited><span class="fw-semibold text-gray-600 fs-7">@T["Credit notes"]</span><span class="text-end fw-bold fs-6 text-primary hp-num" dir="ltr">−@M(t.Credited)</span></div>
                        }
                        <div class="separator separator-dashed my-3"></div>
                        <div class="d-flex flex-stack"><span class="fw-bold text-gray-900 fs-5">@T["Patient balance due"] <span class="text-muted fs-8">@cur</span></span><span class="text-end fw-bolder fs-2 hp-num text-@(t.Due > 0 ? "danger" : "primary")" dir="ltr">@M(t.Due)</span></div>
                    </div>
                </div>
                @{ var creditNotes = (ViewBag.CreditNotes as IReadOnlyList<HospitalCreditNote>) ?? Array.Empty<HospitalCreditNote>(); }
                @if (creditNotes.Count > 0)
                {
                    @* H148: each credit note on the closed bill — the bill itself stays as it was posted *@
                    <div class="mt-8" data-credit-notes>
                        <h4 class="fs-6 fw-bold text-gray-800 mb-1">@T["Credit notes"]</h4>
                        <div class="text-muted fs-7 mb-4">@T["Medicine brought back after the bill closed: the bill stays as posted, the patient owes this much less."]</div>
                        @foreach (var n in creditNotes)
                        {
                            <div class="d-flex align-items-center border border-dashed border-gray-300 rounded px-4 py-3 mb-3">
                                <i class="ki-outline ki-arrow-circle-left fs-2 text-primary me-4"></i>
                                <div class="flex-grow-1 me-3">
                                    <div class="fw-bold text-gray-800 fs-6"><bdi class="hp-num">@n.NoteNo</bdi> <span class="text-muted fw-semibold fs-7 ms-2"><bdi class="hp-num" dir="ltr">@n.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</bdi></span></div>
                                    <div class="text-gray-600 fs-7"><bdi>@n.Reason</bdi></div>
                                </div>
                                <span class="fw-bold fs-5 text-primary hp-num text-nowrap me-3" dir="ltr">−@M(n.Total)</span>
                                @* H149: the credit note is a Report Studio layout of this note — see _ReportPrintMenu *@
                                @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalCreditNote, DocumentId = n.ID.ToString(), DocumentTitle = n.NoteNo })
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="row g-5 g-xl-8">
            <div class="col-xl-7">
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800 d-flex align-items-center gap-2">@Duo("book", "fs-2 text-primary")@T["Journal preview"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@(open ? T["Posted when the bill closes, through the accounting journal engine"] : T["Posted to the general ledger"])@if (foreign) {<text> · @T["in"] </text><span class="hp-num">@(currency?.Code)</span>@if (open) {<text> @T["at today's rate"]</text>}}</span></h3>
                    </div>
                    <div class="card-body pt-2">
                        @if (missing != null)
                        {
                            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5">
                                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                                <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                                    <h4 class="text-gray-900 fw-bold mb-1">@T[missing]</h4>
                                    <a href="@Url.Action("BillingSettings")" class="fs-6 fw-bold">@T["Billing settings"]</a>
                                </div></div>
                            </div>
                        }
                        else if (journal.Count == 0)
                        {
                            <div class="text-center py-10"><i class="ki-outline ki-book fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Nothing to post yet."]</div></div>
                        }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Account"]</th><th class="text-end">@T["Debit"]</th><th class="text-end pe-4 rounded-end">@T["Credit"]</th></tr></thead>
                                <tbody>
                                    @foreach (var j in journal)
                                    {
                                        <tr><td class="ps-4"><span class="text-gray-800 fw-bold fs-6"><bdi>@(accountNames.TryGetValue(j.AccountId, out var an) ? an : j.AccountId.ToString())</bdi></span></td>
                                            <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@DashF(j.Debit)</span></td><td class="text-end pe-4"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@DashF(j.Credit)</span></td></tr>
                                    }
                                </tbody>
                                <tfoot><tr class="border-top border-gray-200"><td class="ps-4"><span class="text-primary fw-bolder fs-6">@T["Total"] <span class="text-muted fs-8">@facCur</span></span></td>
                                    <td class="text-end"><span class="text-gray-900 fw-bolder fs-6 hp-num" dir="ltr">@MF(journal.Sum(j => j.Debit))</span></td><td class="text-end pe-4"><span class="text-gray-900 fw-bolder fs-6 hp-num" dir="ltr">@MF(journal.Sum(j => j.Credit))</span></td></tr></tfoot>
                            </table></div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-5">
                @* Money is collected while anything is owed - a closed bill too: a patient often pays after discharge. *@
                @if (canBill && (open || t.Due > 0))
                {
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800 d-flex align-items-center gap-2">@Duo("dollar", "fs-2 text-primary")@T["Collect payment"]</span>
                                @if (myShift != null) {<span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Shift"]: <bdi>@HospitalUi.DeskName(myShift.Desk, T["Clinics desk"].Value)</bdi></span>}</h3>
                        </div>
                        <div class="card-body pt-2">
                            @if (foreign && open)
                            {
                                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5">
                                    <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                                    <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                                        <h4 class="text-gray-900 fw-bold mb-1">@T["A foreign-currency bill is collected after it is closed"]</h4>
                                        <div class="fs-6 text-gray-700">@T["Closing fixes its rate; a payment at another rate posts the difference to the exchange-difference account."]</div>
                                    </div></div>
                                </div>
                            }
                            else if (myShift == null)
                            {
                                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5">
                                    <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                                    <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                                        <h4 class="text-gray-900 fw-bold mb-1">@T["Open your cashier shift before taking a payment"]</h4>
                                        <a href="@Url.Action("Cashier")" class="fs-6 fw-bold">@T["Cashier closing"]</a>
                                    </div></div>
                                </div>
                            }
                            else
                            {
                                <div class="mb-6"><label class="fs-6 fw-semibold mb-2">@T["Amount"]</label>
                                    <div class="input-group input-group-solid"><input class="form-control form-control-solid hp-num fs-4 fw-bold" dir="ltr" data-amount value="@(t.Due > 0 ? M(t.Due).Replace(",", "") : "")" /><span class="input-group-text">@cur</span></div></div>
                                <div class="mb-6"><label class="fs-6 fw-semibold mb-2">@T["Method"]</label>
                                    <div class="row g-3">
                                        @foreach (var m in HospitalPaymentMethods.All)
                                        {
                                            <div class="col-6"><label class="w-100"><input type="radio" class="btn-check" name="pm" value="@m" @(m == HospitalPaymentMethods.Cash ? "checked" : "") />
                                                <span class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex align-items-center w-100 p-4"><i class="ki-outline ki-@PmIcon(m) fs-2x me-3"></i><span class="fw-bold fs-6">@T["pm:" + m]</span></span></label></div>
                                        }
                                    </div></div>
                                <button type="button" class="btn btn-primary w-100" data-collect @(t.Due <= 0 ? "disabled" : "")><i class="ki-outline ki-wallet fs-4"></i>@T["Collect & issue receipt"]</button>
                            }
                        </div>
                    </div>
                }
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800 d-flex align-items-center gap-2">@Duo("wallet", "fs-2 text-primary")@T["Payments"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7"><span class="hp-num">@Model.Payments.Count</span></span></h3>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Payments.Count == 0)
                        {
                            <div class="text-center py-10"><i class="ki-outline ki-wallet fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No payment yet."]</div></div>
                        }
                        else
                        {
                            @* list-widget rows — demo39 dashboards/logistics *@
                            for (int i = 0; i < Model.Payments.Count; i++)
                            {
                                var pay = Model.Payments[i];
                                <div class="d-flex flex-stack">
                                    <div class="symbol symbol-40px me-4"><span class="symbol-label bg-light-primary">@Duo(PmIcon(pay.Method), "fs-2 text-primary")</span></div>
                                    <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                        <div class="me-3"><bdi class="text-gray-800 fw-bold fs-6 hp-num">@pay.ReceiptNo</bdi><span class="text-gray-500 fw-semibold fs-7 d-block hp-num" dir="ltr" data-utc="@pay.ReceivedAt.ToString("o")">@pay.ReceivedAt.ToString("yyyy-MM-dd HH:mm")</span></div>
                                        <div class="d-flex align-items-center">
                                            <div class="text-end me-3"><span class="text-gray-800 fw-bold fs-6 hp-num text-nowrap" dir="ltr">@M(pay.Amount)</span>&nbsp;<span class="text-muted fs-8">@cur</span>
                                                @if (pay.BaseAmount is decimal ba) {<div class="text-muted fs-8 fw-semibold"><span class="hp-num" dir="ltr">@MF(ba)</span>&nbsp;@facCur</div>}</div>
                                            <span class="badge badge-light-primary fs-7 fw-bold">@T["pm:" + pay.Method]</span>
                                        </div>
                                    </div>
                                </div>
                                if (i < Model.Payments.Count - 1) { <div class="separator separator-dashed my-3"></div> }
                            }
                        }
                    </div>
                </div>
                @if (charityReady && (charity.Count > 0 || canAskCharity))
                {
                    <div class="card card-flush mb-5" data-charity-card>
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Charity"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["A fund waives part of what the patient owes; the administrator approves it."]</span></h3>
                        </div>
                        <div class="card-body pt-2">
                            @foreach (var r in charity)
                            {
                                var g = r.Grant;
                                string tone = g.Status == HospitalCharityStatus.Approved ? "primary" : g.Status == HospitalCharityStatus.Refused ? "danger" : "primary";
                                <div class="d-flex align-items-start mb-1" data-charity-row="@g.ID">
                                    <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-heart fs-3 text-@tone"></i></span></div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex flex-stack flex-wrap gap-2">
                                            <div><bdi class="text-gray-800 fw-bold fs-6 hp-num">@g.GrantNo</bdi> <span class="badge badge-light-@tone fs-7 fw-bold ms-1">@T["ch:" + g.Status]</span></div>
                                            <div class="text-nowrap"><span class="text-gray-800 fw-bold fs-6 hp-num" dir="ltr">@M(g.Amount)</span>&nbsp;<span class="text-muted fs-8">@cur</span></div>
                                        </div>
                                        <div class="text-gray-600 fw-semibold fs-7 mt-1"><bdi>@DisplayName.Of(r.Fund, r.FundEn)</bdi> · <span dir="auto">@g.Reason</span></div>
                                        <div class="text-muted fs-8 mt-1">@T["Asked by"] <bdi>@DisplayName.Of(r.RequestedBy, r.RequestedByEn)</bdi>@if (r.DecidedBy != null) {<span> · @T["Decided by"] <bdi>@DisplayName.Of(r.DecidedBy, r.DecidedByEn ?? r.DecidedBy)</bdi></span>}@if (g.DecisionNote != null) {<span dir="auto"> · @g.DecisionNote</span>}</div>
                                        @if (g.Status == HospitalCharityStatus.Requested && canManage && me != g.RequestedByEmployeeId)
                                        {
                                            <div class="d-flex gap-2 mt-3">
                                                <button type="button" class="btn btn-sm btn-primary" data-charity-decide="@g.ID" data-approve="1" data-ask="@string.Format(T["Approve waiver {0} of {1} {2}? It posts to the fund and the patient owes that much less."].Value, g.GrantNo, M(g.Amount), cur)"><i class="ki-outline ki-check fs-5"></i>@T["Approve"]</button>
                                                <button type="button" class="btn btn-sm btn-light-danger" data-charity-decide="@g.ID" data-approve="0" data-ask="@string.Format(T["Why is waiver {0} refused?"].Value, g.GrantNo)">@T["Refuse"]</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="separator separator-dashed my-3"></div>
                            }
                            @if (canAskCharity)
                            {
                                if (funds.Count == 0)
                                {
                                    <div class="text-center py-6"><i class="ki-outline ki-heart fs-3x text-gray-300 mb-4 d-block"></i>
                                        <div class="fs-6 fw-bold text-gray-700">@T["No charity fund with an expense account yet."]</div>
                                        <a href="@Url.Action("Charity")" class="fs-7 fw-bold">@T["Charity cases"]</a></div>
                                }
                                else
                                {
                                    <div class="row g-4" data-charity-form>
                                        <div class="col-7"><label class="fs-6 fw-semibold mb-2 required">@T["Fund"]</label>
                                            <select class="form-select form-select-solid" data-ch="fundId">@foreach (var f in funds) { <option value="@f.ID">@DisplayName.Of(f.Name, f.NameEn)</option> }</select></div>
                                        <div class="col-5"><label class="fs-6 fw-semibold mb-2 required">@T["Amount"]</label>
                                            <input class="form-control form-control-solid hp-num" dir="ltr" data-ch="amount" value="@M(t.Due).Replace(",", "")" /></div>
                                        <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Why the patient needs the help"]</label>
                                            <textarea class="form-control form-control-solid" rows="2" maxlength="500" dir="auto" data-ch="reason"></textarea></div>
                                        <div class="col-12"><button type="button" class="btn btn-light-primary w-100" data-charity-ask data-ask="@T["Ask for this charity waiver? The administrator approves or refuses it."]"><i class="ki-outline ki-heart fs-4"></i>@T["Ask for a charity waiver"]</button></div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        @* the record's conversation (owner 2026-11-24): comments, replies, @-mentions, files and tasks, as on Inventory's documents *@
        <partial name="_RecordConversation" model="@(new CrossBuy.Controllers.HospitalConversationRef(CrossBuy.BL.Platform.EntityRegistry.HospitalBill, Model.Bill.ID))" />
    </div></div>
</div>

@await Html.PartialAsync("_ReportPreviewModal", (object)(T["Bill"].Value + " " + b.BillNo))

@section Scripts {
    <script src="~/js/hospital/hospital-journey.js" asp-append-version="true"></script>
    <script>
        (function () {
            var $ = window.jQuery, isAr = @Json.Serialize(isAr);
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var urls = { search: @Json.Serialize(Url.Action("SearchServices")), add: @Json.Serialize(Url.Action("AddBillLine", new { id = b.ID })), remove: @Json.Serialize(Url.Action("RemoveBillLine", new { id = 0 })),
                collect: @Json.Serialize(Url.Action("CollectPayment", new { id = b.ID })), close: @Json.Serialize(Url.Action("CloseBill", new { id = b.ID })) };
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), choose: @Json.Serialize(T["Choose a service first"].Value),
                confirmClose: @Json.Serialize(T["Close this bill and post it to the ledger? It cannot be changed afterwards."].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            // In place, never a reload: the server renders the bill again and it is swapped.
            function refresh() {
                fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html');
                    var fresh = d.getElementById('billRoot'); if (fresh) document.getElementById('billRoot').innerHTML = fresh.innerHTML;
                    var tb = d.querySelector('.app-toolbar .d-print-none'); if (tb) document.querySelector('.app-toolbar .d-print-none').innerHTML = tb.innerHTML;
                    initPicker();
                });
            }
            function initPicker() {
                // a swapped bill brings its fund dropdown back as a plain select: give it the theme's select2 again
                var fund = document.querySelector('#billRoot select[data-ch="fundId"]');
                if (fund && $ && $.fn.select2 && !$(fund).hasClass('select2-hidden-accessible')) $(fund).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', minimumResultsForSearch: Infinity });
                var el = document.querySelector('[data-add-service]');
                if (!el || !$ || !$.fn.select2 || $(el).hasClass('select2-hidden-accessible')) return;
                $(el).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', placeholder: el.getAttribute('data-placeholder'),
                    ajax: { url: urls.search, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
            }
            initPicker();
            document.addEventListener('click', function (e) {
                var t;
                if ((t = e.target.closest('[data-add-line]'))) {
                    var sel = document.querySelector('[data-add-service]'); if (!sel.value) { toast('error', W.choose); return; }
                    t.disabled = true;
                    post(urls.add, { serviceId: +sel.value, quantity: +document.querySelector('[data-add-qty]').value || 1 }).then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); refresh(); });
                } else if ((t = e.target.closest('[data-remove]'))) {
                    post(urls.remove.replace(/0\/Remove$/, t.getAttribute('data-remove') + '/Remove')).then(function (res) { if (!res.ok) { toast('error', res.error || W.failed); return; } refresh(); });
                } else if ((t = e.target.closest('[data-collect]'))) {
                    var m = document.querySelector('[name=pm]:checked');
                    t.disabled = true;
                    post(urls.collect, { amount: +(document.querySelector('[data-amount]').value || 0), method: m ? m.value : 'Cash' }).then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); refresh(); });
                } else if ((t = e.target.closest('[data-close]'))) {
                    var closeBtn = t;
                    cbConfirm(W.confirmClose).then(function (ok) {
                        if (!ok) return;
                        closeBtn.disabled = true;
                        post(urls.close).then(function (res) { closeBtn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); refresh(); HospitalJourney.after(@b.PatientId, 'close-bill', { root: @Json.Serialize(Url.Content("~/Hospital")) }); });
                    });
                }
            });
            // H63: a charity request (asks first) and the administrator's decision (a refusal says why)
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-charity-ask],[data-charity-decide]'); if (!t) return;
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                function send(u, b) {
                    t.disabled = true;
                    fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); location.reload(); });
                }
                if (t.hasAttribute('data-charity-ask')) {
                    var f = document.querySelector('[data-charity-form]'), v = function (k) { return f.querySelector('[data-ch=' + k + ']').value; };
                    cbConfirm(t.getAttribute('data-ask')).then(function (ok) { if (ok) send(@Json.Serialize(Url.Action("RequestCharity", new { id = b.ID })), { fundId: +v('fundId'), amount: +(v('amount') || 0), reason: v('reason') }); });
                    return;
                }
                var url = @Json.Serialize(Url.Content("~/Hospital/Charity/")) + t.getAttribute('data-charity-decide') + '/Decide';
                if (t.getAttribute('data-approve') === '1') cbConfirm(t.getAttribute('data-ask')).then(function (ok) { if (ok) send(url, { approve: true }); });
                else cbPrompt(t.getAttribute('data-ask'), { kind: 'danger' }).then(function (why) { if (why != null) send(url, { approve: false, note: why }); });
            });
            document.querySelectorAll('[data-utc]').forEach(function (el) { var d = new Date(el.getAttribute('data-utc').replace(/Z?$/, 'Z')); if (!isNaN(d)) el.textContent = d.toISOString().slice(0, 10) + ' ' + d.toTimeString().slice(0, 5); });
        })();
    </script>
}
