@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalPregnancyPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H85 — one pregnancy: the dates (LMP, due date, weeks today), G/P/A and risks, every antenatal visit with its
    gestational age and warnings, recording a visit, and closing the pregnancy (delivered — linked to the mother's H58
    birth — or lost).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Pregnancy"].Value;
    bool canVisit = ViewBag.CanVisit == true, canEnd = ViewBag.CanEnd == true;
    var p = Model.Pregnancy; bool active = p.Status == HospitalPregnancyStatus.Active;
    string Who(int? id) => id is int i && Model.People.TryGetValue(i, out var n) ? n : "";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Pregnancy"] <span class="badge hp-code fs-7 hp-num ms-2">@p.PregnancyNo</span></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("Antenatal")" class="text-muted text-hover-primary">@T["Antenatal care"]</a></li></ul>
        </div>
        <div class="d-flex gap-2">
            @if (active && canVisit) {<button type="button" class="btn btn-sm btn-primary" data-v-new><i class="ki-outline ki-plus fs-4"></i>@T["Record a visit"]</button>}
            @if (active && canEnd) {<button type="button" class="btn btn-sm btn-light" data-end><i class="ki-outline ki-check-square fs-4"></i>@T["Close the pregnancy"]</button>}
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 mb-5">
            @* H128: the mother's profile card (demo39 apps/user-management/users/view): photo, name, the figures in dashed boxes, then the details list *@
            <div class="col-xl-4"><div class="card card-flush h-100"><div class="card-body pt-10">
                <div class="d-flex flex-center flex-column mb-5">
                    <div class="symbol symbol-100px symbol-circle mb-5">@if (Model.Photo != null) {<img src="@Model.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fs-2x fw-bold hp-initials">@HospitalUi.Initials(Model.NameEn)</span>}</div>
                    <a href="@Url.Action("Patient", new { id = p.PatientId })" class="fs-3 text-gray-800 text-hover-primary fw-bold mb-1">@DisplayName.Of(Model.Name, Model.NameEn)</a>
                    <div class="fs-6 fw-semibold text-gray-500 mb-4"><bdi class="hp-num">@Model.Mrn</bdi>@if (Model.BloodGroup != null) {<text> · <bdi dir="ltr">@Model.BloodGroup</bdi></text>}</div>
                    <div class="mb-6">@if (active) {<span class="badge badge-lg badge-light-primary">@T["Trimester {0}", HospitalAntenatalRules.Trimester(Model.GaDays)]</span>} else {<span class="badge badge-lg badge-light-@(p.Status == HospitalPregnancyStatus.Delivered ? "primary" : "secondary")">@T["pgs:" + p.Status]</span>}</div>
                    <div class="d-flex flex-wrap flex-center gap-3">
                        <div class="border border-gray-300 border-dashed rounded py-3 px-4 text-center min-w-100px">
                            <div class="fs-2 fw-bold text-gray-800 hp-num" dir="ltr">@(active ? HospitalAntenatalRules.Ga(Math.Max(0, Model.GaDays)) : "—")</div>
                            <div class="fw-semibold fs-7 text-gray-500">@T["Weeks today"]</div>
                        </div>
                        <div class="border border-gray-300 border-dashed rounded py-3 px-4 text-center min-w-100px">
                            <div class="fs-2 fw-bold text-gray-800 hp-num" dir="ltr">G@(p.Gravida) P@(p.Para) A@(p.Abortions)</div>
                            <div class="fw-semibold fs-7 text-gray-500">@T["Gravida / para / abortions"]</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-stack fs-4 py-3"><div class="fw-bold">@T["Details"]</div></div>
                <div class="separator separator-dashed"></div>
                <div class="pb-2 fs-6">
                    <div class="fw-bold mt-5">@T["Due date"]</div><div class="text-gray-600 hp-num">@Model.Edd.ToString("yyyy-MM-dd")</div>
                    <div class="fw-bold mt-5">@T["Last menstrual period"]</div><div class="text-gray-600 hp-num">@(p.Lmp?.ToString("yyyy-MM-dd") ?? "—")</div>
                    @if (p.UltrasoundEdd != null) {<div class="fw-bold mt-5">@T["Ultrasound due date"]</div><div class="text-gray-600 hp-num">@p.UltrasoundEdd.Value.ToString("yyyy-MM-dd")</div>}
                    @if (p.Risks != null) {<div class="fw-bold mt-5">@T["Risks at booking"]</div><div class="text-danger fw-semibold"><bdi>@p.Risks</bdi></div>}
                    @if (!active && p.EndNote != null) {<div class="fw-bold mt-5">@T["Notes"]</div><div class="text-gray-600"><bdi>@p.EndNote</bdi></div>}
                </div>
            </div></div></div>
            @* H128: the visits as the theme's table widget (demo39 widgets/tables) *@
            <div class="col-xl-8"><div class="card card-flush h-100">
                <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Antenatal visits"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@Model.Visits.Count</span></h3>
                    @if (active && canVisit) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-v-new><i class="ki-outline ki-plus fs-4"></i>@T["Record a visit"]</button></div>}</div>
                <div class="card-body pt-2">
                    @if (Model.Visits.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-calendar fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No visit yet"]</div></div> }
                    else
                    {
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Date"]</th><th>@T["Gestation"]</th><th>@T["BP"]</th><th>@T["Weight"]</th><th>@T["Fundal height"]</th><th>@T["Fetal heart"]</th><th>@T["Urine protein"]</th><th class="pe-4 rounded-end">@T["Warnings"]</th></tr></thead>
                            <tbody>
                            @foreach (var (v, ga, warn) in Model.Visits)
                            {
                                bool highBp = v.BpSystolic >= 140 || v.BpDiastolic >= 90; bool fhBad = v.FetalHeartRate is int f && (f < 110 || f > 160);
                                <tr>
                                    <td class="ps-4"><span class="text-gray-900 fw-bold fs-6 hp-num d-block">@v.VisitDate.ToString("yyyy-MM-dd")</span><span class="text-gray-500 fw-semibold fs-7">@Who(v.CreatedByEmployeeId)</span></td>
                                    <td><span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@HospitalAntenatalRules.Ga(Math.Max(0, ga))</span></td>
                                    <td>@if (v.BpSystolic != null) {<span class="badge badge-light-@(highBp ? "danger" : "primary") fs-7 fw-bold hp-num" dir="ltr">@v.BpSystolic/@v.BpDiastolic</span>} else {<span class="text-gray-400">—</span>}</td>
                                    <td>@if (v.WeightKg != null) {<span class="text-gray-800 fw-bold hp-num" dir="ltr">@v.WeightKg.Value.ToString("0.0")&nbsp;kg</span>} else {<span class="text-gray-400">—</span>}</td>
                                    <td>@if (v.FundalHeightCm != null) {<span class="text-gray-800 fw-bold hp-num" dir="ltr">@v.FundalHeightCm.Value.ToString("0.#")&nbsp;cm</span>} else {<span class="text-gray-400">—</span>}</td>
                                    <td>@if (v.FetalHeartRate != null) {<span class="badge badge-light-@(fhBad ? "danger" : "primary") fs-7 fw-bold hp-num">@v.FetalHeartRate</span>} else {<span class="text-gray-400">—</span>}</td>
                                    <td><span class="text-gray-800 fw-semibold" dir="ltr">@(v.UrineProtein ?? "—")</span></td>
                                    <td class="pe-4">@if (warn.Count > 0) {<div class="d-flex flex-wrap gap-1">@foreach (var w in warn) {<span class="badge badge-light-danger fs-8 fw-bold">@T["anw:" + w]</span>}</div>}
                                        @if (v.Note != null) {<span class="text-gray-500 fw-semibold fs-7 d-block mt-1"><bdi>@v.Note</bdi></span>}
                                        @if (v.NextVisitOn != null) {<span class="text-gray-500 fw-semibold fs-7 d-block mt-1">@T["Next"]: <span class="hp-num">@v.NextVisitOn.Value.ToString("yyyy-MM-dd")</span></span>}
                                        @if (warn.Count == 0 && v.Note == null && v.NextVisitOn == null) {<span class="text-gray-400">—</span>}</td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div></div>
        </div>
    </div></div>
</div>

@if (active && canVisit)
{
    @* H128: the forms as the theme's form modal (demo39 utilities/modals/forms/new-target) *@
    <div class="modal fade" id="visitModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Antenatal visit"]</h1><div class="text-muted fw-semibold fs-6">@DisplayName.Of(Model.Name, Model.NameEn) · <span class="hp-num">@p.PregnancyNo</span></div></div>
            <div class="row g-6">
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["Date"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-v="visitDate" /></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["BP (systolic)"]</label><input type="number" class="form-control form-control-solid" dir="ltr" data-v="bpSystolic" /></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["BP (diastolic)"]</label><input type="number" class="form-control form-control-solid" dir="ltr" data-v="bpDiastolic" /></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["Weight (kg)"]</label><input type="number" step="0.1" class="form-control form-control-solid" dir="ltr" data-v="weightKg" /></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["Fundal height (cm)"]</label><input type="number" step="0.5" class="form-control form-control-solid" dir="ltr" data-v="fundalHeightCm" /></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["Fetal heart (bpm)"]</label><input type="number" class="form-control form-control-solid" dir="ltr" data-v="fetalHeartRate" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Urine protein"]</label><select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#visitModal" data-hide-search="true" data-v="urineProtein"><option value="">—</option>@foreach (var u in HospitalUrineProtein.All) {<option value="@u">@u</option>}</select></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Next visit"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-v="nextVisitOn" /></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Notes"]</label><textarea class="form-control form-control-solid" rows="2" maxlength="500" data-v="note"></textarea></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-v-save>@T["Save"]</button></div>
        </div>
    </div></div></div>
}
@if (active && canEnd)
{
    <div class="modal fade" id="endModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Close the pregnancy"]</h1><div class="text-muted fw-semibold fs-6">@DisplayName.Of(Model.Name, Model.NameEn) · <span class="hp-num">@p.PregnancyNo</span></div></div>
            <div class="row g-6">
            <div class="col-12"><label class="required fs-6 fw-semibold mb-2">@T["Outcome"]</label><select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#endModal" data-hide-search="true" data-e="status"><option value="Delivered">@T["pgs:Delivered"]</option><option value="Loss">@T["pgs:Loss"]</option></select></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["The birth"]</label><select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#endModal" data-e="birthId"><option value="">—</option>@foreach (var b in Model.Births) {<option value="@b.Id">@b.No · @HospitalNursingService.UtcToWard(b.BornAt).ToString("yyyy-MM-dd")</option>}</select><div class="text-muted fs-7 mt-1">@T["The mother's births registered on her file."]</div></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Notes"]</label><textarea class="form-control form-control-solid" rows="2" maxlength="300" data-e="note"></textarea></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-e-save>@T["Close"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var tok = document.querySelector('input[name="__RequestVerificationToken"]').value, vEl = document.getElementById('visitModal'), eEl = document.getElementById('endModal');
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), visit: @Json.Serialize(T["Save this antenatal visit?"].Value), end: @Json.Serialize(T["Close this pregnancy?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }
            var nums = ['bpSystolic', 'bpDiastolic', 'weightKg', 'fundalHeightCm', 'fetalHeartRate'];
            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-v-new]') && vEl) { vEl.querySelectorAll('[data-v]').forEach(function (i) { i.value = ''; if (i._flatpickr) i._flatpickr.clear(); }); if (window.jQuery) jQuery(vEl).find('select').trigger('change.select2'); bootstrap.Modal.getOrCreateInstance(vEl).show(); return; }
                if (e.target.closest('[data-end]') && eEl) { bootstrap.Modal.getOrCreateInstance(eEl).show(); return; }
                var s = e.target.closest('[data-v-save]');
                if (s) { var b = { pregnancyId: @p.ID }; vEl.querySelectorAll('[data-v]').forEach(function (i) { var k = i.getAttribute('data-v'), v = i.value.trim(); b[k] = v === '' ? null : (nums.indexOf(k) >= 0 ? Number(v) : v); });
                    cbConfirm(W.visit).then(function (ok) { if (ok) post(@Json.Serialize(Url.Action("AddAntenatalVisit")), b).then(done); }); return; }
                var x = e.target.closest('[data-e-save]');
                if (x) { var c = {}; eEl.querySelectorAll('[data-e]').forEach(function (i) { var k = i.getAttribute('data-e'); c[k] = k === 'birthId' ? (i.value ? Number(i.value) : null) : (i.value.trim() || null); });
                    cbConfirm(W.end).then(function (ok) { if (ok) post(@Json.Serialize(Url.Content("~/Hospital/Pregnancies/" + p.ID + "/End")), c).then(done); }); }
            });
        })();
    </script>
}
