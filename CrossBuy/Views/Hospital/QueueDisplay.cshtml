@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalQueueBoard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H83 — the waiting-room display: a full screen (no menus) for a TV in the waiting room.
    LOOK: Metronic's own (owner 2026-11-12: "take it from Metronic") — card card-flush, symbol, badge, select2, the theme's
    light page — with ONE change for a TV: the root font size follows the screen, so every theme rem (fs-*, padding,
    symbol sizes) scales together and a ticket reads from ~8 m on a 55" panel. No hand-drawn widgets.
    LOGIC (research: Qmatic, Wavetec/Gulf MOH, Qminder, ADA/WCAG signage):
      * pushed, not polled — NotificationsHub's company group signals "hospitalQueueChanged" after an appointment's status
        commits (HospitalQueueSignalInterceptor); the screen then fetches its content once; 2-minute safety refresh;
      * a call takes the screen for 10 s: chime, then spoken in Arabic and English — the TICKET ("A-004", the desk's own
        spelling), the CLINIC, the room when there is one, and the doctor; the "recently called" card keeps it;
      * patients are tickets only — the room is public; doctors (staff) by name and face;
      * resilience: last-update time, reconnect with back-off that never gives up, wake lock, a few-pixel drift.
*@
@{
    Layout = null;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var deps = (ViewBag.Departments as List<HospitalDepartment>) ?? new();
    int? dep = ViewBag.Department;
}
<!DOCTYPE html>
<html lang="@(isAr ? "ar" : "en")" dir="@(isAr ? "rtl" : "ltr")" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T["Waiting room"]</title>
    <link rel="shortcut icon" href="@Url.Content(CrossBuy.BL.Platform.ProductIdentity.Assets.FaviconIco)" asp-append-version="true" />
    <link href="~/Backend-assets/plugins/global/plugins.bundle@(isAr ? ".rtl" : "").css" rel="stylesheet" asp-append-version="true" />
    <link href="~/Backend-assets/css/style.bundle@(isAr ? ".rtl" : "").css" rel="stylesheet" asp-append-version="true" />
    <link href="~/Backend-assets/css/crossbuy-brand.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/Backend-assets/fonts/cairo/cairo.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
    <style>
        /* the ONE TV adaptation: Metronic sizes everything in rem, so the root size scales the whole theme with the screen
           (the smaller of height and width, so a narrow window shrinks instead of overflowing) */
        /* Metronic pins `html, body { font-size: 13px !important }`, so the TV scale needs its own !important (html only;
           body text stays the theme's, but every rem — fs-*, spacing, symbols — now follows the screen) */
        html:root { font-size: clamp(12px, min(1.45vh, 1.05vw), 22px) !important; }
        html, body { height: 100%; }
        body { margin: 0; overflow: hidden; background: var(--bs-app-bg-color, #F5F8FA); font-family: 'Cairo', Inter, sans-serif; }
        body.qd-idle-cursor { cursor: none; }
        body.qd-idle-cursor .qd-tools { opacity: 0; pointer-events: none; }
        .qd-tools { transition: opacity .4s; }
        .qd-hero-clock { background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .18); }
        .qd-hero-clock .qd-sec { font-size: .45em; opacity: .6; margin-inline-start: .25em; vertical-align: baseline; }
        /* the hero's icon button stays on the hero in EVERY state: Metronic's hover/focus/active turned it light, and the
           white icon vanished on it */
        .qd-hero-btn, .qd-hero-btn:hover, .qd-hero-btn:focus, .qd-hero-btn:active, .qd-hero-btn.active {
            background-color: rgba(255, 255, 255, .12) !important; border: 1px solid rgba(255, 255, 255, .25) !important; box-shadow: none !important; }
        .qd-hero-btn:hover, .qd-hero-btn:focus-visible { background-color: rgba(255, 255, 255, .24) !important; }
        .qd-hero-btn i, .qd-hero-btn:hover i, .qd-hero-btn:focus i, .qd-hero-btn:active i { color: #fff !important; }
        /* the select2 box on the hero reads as part of it: white surface, the theme's own dropdown below */
        .qd-hero .select2-container--bootstrap5 .select2-selection { background-color: #fff !important; border: 0 !important; }
        bdi { unicode-bidi: isolate; }
        .qd-shell { height: 100vh; display: flex; flex-direction: column; gap: 1.25rem; padding: 1.25rem 1.5rem; transition: transform 2s ease; }
        .qd-clock { font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate; line-height: 1; }
        #qdBody { flex: 1 1 auto; min-height: 0; }
        .qd-main { height: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 24%); gap: 1.25rem; }
        .qd-main.qd-no-aside { grid-template-columns: minmax(0, 1fr); }
        .qd-grid { display: grid; grid-template-columns: repeat(var(--qd-cols, 2), minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); gap: 1.25rem; min-height: 0; }
        .qd-card, .qd-aside { min-height: 0; overflow: hidden; }
        .qd-empty { grid-column: 1 / -1; }
        /* the theme's timeline sizes its time column in px (50px, rail at 51px); on a scaled TV the time is wider, so the
           column and its rail move together in rem */
        .qd-aside .timeline-label .timeline-label { width: 4.25rem; }
        [dir=rtl] .qd-aside .timeline-label:before { right: calc(4.25rem + 1px); }
        [dir=ltr] .qd-aside .timeline-label:before { left: calc(4.25rem + 1px); }
        .qd-aside .timeline-label .timeline-item { margin-bottom: 1.6rem; }
        /* older calls step back: the brand CSS raises text greys for AA, so the dot (decoration) takes an explicit light grey and
           the ticket (large bold text, 3:1 is enough) fades instead of turning grey */
        .qd-aside .qd-old-dot { color: var(--bs-gray-300) !important; }
        .qd-aside .qd-old { opacity: .55; }
        .qd-clamp { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .qd-ticket { font-size: min(9.5rem, 52cqh, 28cqw); line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: .02em; }
        /* the body shrinks, the header and footer never do: a big ticket in a short card used to push "Next" out of it */
        .qd-card > .card-body { flex: 1 1 auto; min-height: 0; overflow: hidden; container-type: size; }
        /* everything in the middle is sized from the CARD's own space (container units), so a short card shrinks its
           ticket instead of cropping it */
        .qd-card > .card-body .symbol-label { width: min(75px, 30cqh); height: min(75px, 30cqh); }
        .qd-card > .card-body > span:first-child { font-size: min(1.5rem, 11cqh) !important; }
        .qd-card > .card-header, .qd-card > .card-footer { flex-shrink: 0; }
        /* the called card: the system's own blue (owner: green does not belong to this product), a slow pulse
           (well under 3 flashes/s) */
        .qd-card.is-called { box-shadow: 0 0 0 3px var(--bs-primary) !important; }
        .qd-card.is-called .qd-ticket { animation: qdpulse 1.6s ease-in-out 6; }
        @@keyframes qdpulse { 0%,100% { opacity: 1; } 50% { opacity: .5; } }
        .qd-status.is-offline .bullet { background-color: var(--bs-gray-400) !important; animation: qdpulse 1.6s infinite; }
        .qd-status .qd-off { display: none; }
        .qd-status.is-offline .qd-off { display: inline; }
        /* the call: a Metronic modal-content, centred, for 10 s */
        .qd-call { position: fixed; inset: 0; z-index: 1060; display: none; align-items: center; justify-content: center; background: rgba(0, 0, 0, .45); }
        .qd-call.is-on { display: flex; animation: qdin .3s ease-out; }
        @@keyframes qdin { from { opacity: 0; transform: scale(.97); } to { opacity: 1; transform: none; } }
        .qd-call .modal-content { width: min(86vw, 1400px); }
        /* Metronic puts the dialog's colours on .modal; these stand alone, so they take the surface explicitly */
        .qd-call .modal-content, .qd-sound .modal-content { background-color: var(--bs-body-bg, #fff); border-radius: 1rem; }
        .qd-call-ticket { font-size: min(13rem, 26vh); line-height: 1; font-variant-numeric: tabular-nums; animation: qdpulse 1.6s ease-in-out 5; }
        .qd-call-row + .qd-call-row { border-top: 1px dashed var(--bs-gray-300); }
        .qd-call-row .qd-row-ticket { font-size: min(5.5rem, 9vh); line-height: 1; font-variant-numeric: tabular-nums; min-width: 5.2em; }
        .qd-sound { position: fixed; inset: 0; z-index: 1070; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, .45); }
        @@media (max-width: 1100px) {
            .qd-main { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto; }
            .qd-aside .card-body > .d-flex { flex-wrap: wrap; }
        }
        @@media (max-width: 700px) { .qd-grid { grid-template-columns: minmax(0, 1fr) !important; } }
        /* SMALLER THAN A TV (a desk monitor, a laptop, a half-screen window): the fit-to-screen layout crushed the cards —
           a two-line header took half the height and the ticket shrank to a few pixels. Here the page scrolls instead,
           the header stays one compact row, and every card keeps a readable height. The TV layout above is untouched. */
        @@media (max-width: 1100px), (max-height: 760px) {
            body { overflow-y: auto; }
            .qd-shell { height: auto; min-height: 100vh; }
            #qdBody { flex: none; }
            .qd-main { height: auto; }
            .qd-grid { grid-auto-rows: auto; }
            .qd-card > .card-body { container-type: inline-size; min-height: 15rem; }
            .qd-ticket { font-size: min(7rem, 26cqw); }
            .qd-hero .card-body { flex-wrap: nowrap; gap: 1rem; padding-top: 1rem !important; padding-bottom: 1rem !important; }
            .qd-hero .rounded-circle { display: none !important; }
            .qd-hero .fs-2x { font-size: 1.6rem !important; }
            .qd-hero #qdScope { font-size: 1rem !important; margin-top: .25rem !important; }
            .qd-hero .qd-tools .w-250px { width: 13rem !important; }
            .qd-hero .qd-tools a.qd-hero-btn { padding-inline: .9rem !important; }
            .qd-hero-clock { padding: .5rem 1rem !important; }
            .qd-hero-clock .qd-clock { font-size: 2.2rem !important; }
            .qd-hero-clock #qdDate { font-size: .85rem !important; }
        }
        @@media (max-width: 760px) {
            .qd-hero .card-body { flex-wrap: wrap; }
            .qd-hero-clock #qdDate { display: none; }
        }
    </style>
</head>
<body>
    <div class="qd-shell" id="qdShell">
        @* Metronic demo39 dashboards/call-center hero card: the brand colour with the theme's wave, a dashed icon ring,
           white type; the clock is the hero's big figure *@
        <div class="card card-flush border-0 bgi-no-repeat bgi-size-contain bgi-position-x-end qd-hero"
             style="background-color: var(--bs-primary); background-image: url('@Url.Content("~/Backend-assets/media/svg/shapes/wave-bg-dark.svg")')">
            <div class="card-body d-flex align-items-center flex-wrap gap-6 py-6">
                <div class="d-flex align-items-center gap-5 flex-grow-1 min-w-0">
                    <div class="d-flex flex-center rounded-circle h-70px w-70px flex-shrink-0" style="border: 1px dashed rgba(255, 255, 255, .4); background-color: rgba(255, 255, 255, .08)">
                        <i class="ki-outline ki-people text-white fs-2qx lh-0"></i>
                    </div>
                    <div class="d-flex flex-column min-w-0">
                        <span class="text-white fw-bolder fs-2x lh-1">@T["Waiting room"]</span>
                        <span class="text-white opacity-75 fw-semibold fs-4 mt-2" id="qdScope">@(dep is int sel && deps.FirstOrDefault(x => x.ID == sel) is { } sd ? DisplayName.Of(sd.Name, sd.NameEn ?? sd.Name) : T["All clinics"].Value)</span>
                    </div>
                </div>
                <div class="qd-tools d-flex align-items-center gap-3">
                    <div class="w-250px">
                        <select id="qdDep" class="form-select form-select-solid"><option value="">@T["All clinics"]</option>@foreach (var d in deps) {<option value="@d.ID" selected="@(dep == d.ID)">@DisplayName.Of(d.Name, d.NameEn ?? d.Name)</option>}</select>
                    </div>
                    @* the system's own language switch (Account/SetLanguage writes the culture cookie and comes back here) *@
                    <a class="btn h-45px px-5 fw-bold fs-5 text-white text-nowrap qd-hero-btn"
                       href="@Url.Action("SetLanguage", "Account", new { culture = isAr ? "en" : "ar", returnUrl = Context.Request.Path + Context.Request.QueryString })"
                       title="@(isAr ? "English" : "العربية")"><i class="ki-outline ki-flag fs-2 me-2 text-white"></i>@(isAr ? "English" : "العربية")</a>
                    <button type="button" id="qdFull" class="btn btn-icon w-45px h-45px qd-hero-btn" title="@T["Full screen"]" aria-label="@T["Full screen"]"
                            data-on="@T["Full screen"]" data-off="@T["Exit full screen"]"><i class="ki-outline ki-maximize fs-1 text-white"></i></button>
                </div>
                <div class="qd-hero-clock d-flex flex-column align-items-end rounded-3 px-6 py-3">
                    <div class="qd-clock text-white fw-bolder fs-3hx" id="qdClock">@Model.NowLocal.ToString("HH:mm")</div>
                    <div class="text-white opacity-75 fw-semibold fs-6 text-nowrap" id="qdDate"></div>
                </div>
            </div>
        </div>
        <div id="qdBody"><partial name="_QueueClinics" model="Model" /></div>
        <div class="qd-status d-flex align-items-center text-gray-500 fw-semibold fs-7" id="qdStatus">
            <span class="bullet bullet-dot bg-primary h-8px w-8px me-2"></span>@T["Updated"]&nbsp;<bdi id="qdUpdated">@Model.NowLocal.ToString("HH:mm")</bdi><span class="qd-off">&nbsp;· @T["Reconnecting…"]</span>
        </div>
    </div>

    <div class="qd-call" id="qdCall" aria-live="assertive">
        <div class="modal-content shadow-lg">
            <div class="modal-header justify-content-center border-0 pt-10 pb-0">
                <span class="badge badge-light-primary fw-bolder fs-1 px-6 py-4"><i class="ki-outline ki-notification-on fs-1 text-primary me-3"></i>@T["Now calling"]</span>
            </div>
            <div class="modal-body text-center px-10 pt-8 pb-12" id="qcSingle">
                <div class="qd-call-ticket text-primary fw-bolder"><bdi id="qcNum"></bdi></div>
                <div class="text-gray-800 fw-bold fs-2hx mt-8"><span>@T["Please go to"]</span> <span id="qcClinic"></span></div>
                <div class="mt-6" id="qcRoomWrap"><span class="badge badge-light-primary fw-bolder fs-2hx px-8 py-5">@T["Room"]&nbsp;<bdi id="qcRoom"></bdi></span></div>
                <div class="d-inline-flex align-items-center gap-4 mt-8">
                    <div class="symbol symbol-70px symbol-circle" id="qcFace"></div>
                    <span class="text-gray-600 fw-bold fs-1" id="qcDoc"></span>
                </div>
            </div>
            @* several doctors called in the same instant: ONE window lists them all (ticket, clinic, room, doctor) instead
               of making the last patient wait 10 s per call ahead of him *@
            <div class="modal-body px-10 pt-6 pb-10 d-none" id="qcMulti"></div>
        </div>
    </div>

    <div class="qd-sound" id="qdSound">
        <div class="modal-content mw-600px">
            <div class="modal-body text-center py-12 px-10">
                <div class="symbol symbol-90px symbol-circle mb-7"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-speaker fs-3x text-primary"></i></span></div>
                <div class="text-gray-900 fw-bolder fs-1 mb-8">@T["Waiting room"]</div>
                <button type="button" class="btn btn-primary btn-lg fs-3"><i class="ki-outline ki-speaker fs-2"></i>@T["Start the display (with sound)"]</button>
            </div>
        </div>
    </div>

    <script src="~/Backend-assets/plugins/global/plugins.bundle.js" asp-append-version="true"></script>
    <script>
        (function () {
            var url = @Json.Serialize(Url.Action("QueueDisplayData")), body = document.getElementById('qdBody'), dep = document.getElementById('qdDep');
            var status = document.getElementById('qdStatus'), updated = document.getElementById('qdUpdated');
            var lang = document.documentElement.lang, isAr = lang === 'ar', $ = window.jQuery, ctx = null, sound = false;

            // ---- clock: re-armed on every whole second (never drifts); the Gregorian + Umm al-Qura Hijri line once a day ----
            var clockEl = document.getElementById('qdClock'), dayShown = '';
            function pad(n) { return String(n).padStart(2, '0'); }
            function tick() {
                var d = new Date();
                clockEl.innerHTML = pad(d.getHours()) + ':' + pad(d.getMinutes()) + '<span class="qd-sec">' + pad(d.getSeconds()) + '</span>';
                var day = d.toDateString();
                if (day !== dayShown) {
                    dayShown = day;
                    try {
                        var loc = isAr ? 'ar' : 'en';
                        var g = new Intl.DateTimeFormat(loc + '-u-nu-latn', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(d);
                        var h = new Intl.DateTimeFormat(loc + '-u-ca-islamic-umalqura-nu-latn', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
                        document.getElementById('qdDate').textContent = g + '  ·  ' + h;
                    } catch (e) { }
                }
                setTimeout(tick, 1000 - d.getMilliseconds() + 5);
            }
            tick();

            // ---- sound: a browser plays audio only after one tap ----
            document.querySelector('#qdSound button').addEventListener('click', function () {
                try { ctx = new (window.AudioContext || window.webkitAudioContext)(); sound = true; } catch (e) { }
                if (window.speechSynthesis) { try { speechSynthesis.getVoices(); } catch (e) { } }
                document.getElementById('qdSound').remove(); wake();
                if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen().catch(function () { });
            });
            function chime() { if (!ctx) return; [660, 880, 1100].forEach(function (f, i) { var o = ctx.createOscillator(), g = ctx.createGain(); o.type = 'sine'; o.frequency.value = f; o.connect(g); g.connect(ctx.destination);
                var t = ctx.currentTime + i * 0.28; g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.35, t + 0.03); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.5); o.start(t); o.stop(t + 0.52); }); }
            function voice(code) { var vs = (window.speechSynthesis && speechSynthesis.getVoices()) || []; return vs.filter(function (v) { return v.lang && v.lang.toLowerCase().indexOf(code) === 0; })[0] || null; }
            function say(text, code) { if (!sound || !window.speechSynthesis) return; var u = new SpeechSynthesisUtterance(text), v = voice(code); if (v) u.voice = v; u.lang = v ? v.lang : (code === 'ar' ? 'ar-SA' : 'en-US'); u.rate = 0.9; speechSynthesis.speak(u); }

            // ---- the call: one at a time, 10 s each. Shown and spoken in full: ticket, clinic, room (when there is one),
            //      doctor — Arabic first, then English. The ticket is spoken as "A 4", not "A zero zero four". ----
            var queue = [], showing = false, callEl = document.getElementById('qdCall');
            var single = document.getElementById('qcSingle'), multi = document.getElementById('qcMulti');
            var roomWord = @Json.Serialize(T["Room"].Value);
            function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : t; return d.innerHTML; }
            // a BATCH is every call one refresh found: one call keeps the big single view, several share one window
            function announce(batch) { if (!batch.length) return; queue.push(batch); if (!showing) next(); }
            function sayAll(batch) {
                // the call speaks the DISPLAY's language (the header's switch) and says only the ticket and the clinic:
                // "التذكرة A 4، عيادة الأطفال" on the Arabic screen, "Ticket A 4, Paediatrics clinic" on the English one.
                // The window still shows the room and the doctor.
                batch.forEach(function (c) {
                    if (isAr) say('التذكرة A ' + c.num + '، عيادة ' + c.depAr, 'ar');
                    else say('Ticket A ' + c.num + ', ' + c.depEn + ' clinic', 'en');
                });
            }
            function next() {
                var batch = queue.shift(); if (!batch) { showing = false; callEl.classList.remove('is-on'); return; }
                showing = true;
                if (batch.length === 1) {
                    var c = batch[0];
                    single.classList.remove('d-none'); multi.classList.add('d-none');
                    document.getElementById('qcNum').textContent = c.ticket;
                    document.getElementById('qcClinic').textContent = (isAr ? 'عيادة ' + c.depAr : c.depEn + ' clinic');
                    document.getElementById('qcRoom').textContent = c.room || '';
                    document.getElementById('qcRoomWrap').style.display = c.room ? '' : 'none';
                    document.getElementById('qcDoc').textContent = c.name || '';
                    var face = document.getElementById('qcFace'); face.innerHTML = c.photo ? '<img alt="" style="object-fit:cover" src="' + c.photo.replace(/"/g, '') + '">' : '';
                    face.style.display = c.photo ? '' : 'none';
                } else {
                    single.classList.add('d-none'); multi.classList.remove('d-none');
                    multi.innerHTML = batch.map(function (c) {
                        var face = c.photo ? '<div class="symbol symbol-60px symbol-circle flex-shrink-0"><img alt="" style="object-fit:cover" src="' + c.photo.replace(/"/g, '') + '"></div>' : '';
                        return '<div class="qd-call-row d-flex align-items-center gap-6 py-5">'
                            + '<span class="qd-row-ticket text-primary fw-bolder text-center"><bdi>' + esc(c.ticket) + '</bdi></span>'
                            + '<div class="d-flex flex-column flex-grow-1 min-w-0"><span class="text-gray-900 fw-bold fs-1">' + esc(isAr ? 'عيادة ' + c.depAr : c.depEn + ' clinic') + '</span>'
                            + '<span class="text-gray-600 fw-semibold fs-3">' + esc(c.name) + '</span></div>'
                            + (c.room ? '<span class="badge badge-light-primary fw-bolder fs-1 px-6 py-4 flex-shrink-0">' + esc(roomWord) + '&nbsp;<bdi>' + esc(c.room) + '</bdi></span>' : '')
                            + face + '</div>';
                    }).join('');
                }
                callEl.classList.add('is-on'); chime();
                setTimeout(function () { sayAll(batch); }, 900);
                // long enough to read and hear every call in the window: 10 s, plus 4 s for each further call (max 22 s)
                setTimeout(next, Math.min(22000, 10000 + (batch.length - 1) * 4000));
            }

            // ---- PUSHED, not polled (see the header comment) ----
            function cards() { var m = {}; body.querySelectorAll('[data-doc]').forEach(function (n) { m[n.getAttribute('data-doc')] = n.getAttribute('data-now'); }); return m; }
            var stamp = (body.querySelector('[data-stamp]') || { getAttribute: function () { return ''; } }).getAttribute('data-stamp');
            var busy = false, again = false, soon = null;
            function online(on) { status.classList.toggle('is-offline', !on); }
            function refresh() {
                if (busy) { again = true; return; }        // a burst of signals collapses into one fetch + one follow-up
                busy = true;
                fetch(url + (dep.value ? '?department=' + dep.value : ''), { headers: { 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store' })
                    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
                    .then(function (h) {
                        var before = cards(); body.innerHTML = h;
                        var root = body.querySelector('[data-stamp]'), s = root.getAttribute('data-stamp');
                        updated.textContent = root.getAttribute('data-updated');
                        if (s !== stamp && stamp !== null) {
                            var batch = [];
                            body.querySelectorAll('[data-doc]').forEach(function (n) { var now = n.getAttribute('data-now');
                                if (now && before[n.getAttribute('data-doc')] !== now) { n.classList.add('is-called');
                                    batch.push({ ticket: now, num: n.getAttribute('data-num'), room: n.getAttribute('data-room'), name: n.getAttribute('data-name'), photo: n.getAttribute('data-photo'),
                                        depAr: n.getAttribute('data-dep-ar') || '', depEn: n.getAttribute('data-dep-en') || '', docAr: n.getAttribute('data-doc-ar') || '', docEn: n.getAttribute('data-doc-en') || '' }); } });
                            announce(batch);
                        }
                        stamp = s;
                    })
                    .catch(function () { online(false); })
                    .then(function () { busy = false; if (again) { again = false; refresh(); } });
            }
            function nudge() { clearTimeout(soon); soon = setTimeout(refresh, 250); }
            setInterval(refresh, 120000);

            function live() {
                if (!window.signalR) { online(false); return; }
                var hub = new signalR.HubConnectionBuilder().withUrl('/hubs/notifications')
                    .withAutomaticReconnect({ nextRetryDelayInMilliseconds: function (c) { return Math.min(30000, 1000 * Math.pow(2, Math.min(c.previousRetryCount, 5))); } }).build();
                hub.on('hospitalQueueChanged', nudge);
                hub.onreconnecting(function () { online(false); });
                hub.onreconnected(function () { online(true); refresh(); });
                // automatic reconnect gives up after its schedule; a TV must not, so start again from scratch
                hub.onclose(function () { online(false); setTimeout(start, 5000); });
                function start() { hub.start().then(function () { online(true); refresh(); }).catch(function () { online(false); setTimeout(start, 5000); }); }
                start();
            }
            if (window.signalR) live();
            else { var s2 = document.createElement('script'); s2.src = @Json.Serialize(Url.Content("~/Backend-assets/plugins/signalr.min.js")); s2.onload = live; s2.onerror = function () { online(false); }; document.head.appendChild(s2); }

            // ---- the clinic picker: the theme's select2 (a select2 change is a jQuery event, never addEventListener) ----
            function onDep() { var u = new URL(location.href); if (dep.value) u.searchParams.set('department', dep.value); else u.searchParams.delete('department'); history.replaceState(null, '', u);
                document.getElementById('qdScope').textContent = dep.options[dep.selectedIndex].text; stamp = null; refresh(); }
            if ($ && $.fn.select2) { $(dep).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', minimumResultsForSearch: Infinity }); $(dep).on('change', onDep); }
            else dep.addEventListener('change', onDep);
            var fullBtn = document.getElementById('qdFull');
            function isFull() { return !!(document.fullscreenElement || document.webkitFullscreenElement); }
            function paintFull() { var on = isFull(), t = fullBtn.getAttribute(on ? 'data-off' : 'data-on');
                fullBtn.querySelector('i').className = 'ki-outline ' + (on ? 'ki-cross-square' : 'ki-maximize') + ' fs-1 text-white';
                fullBtn.title = t; fullBtn.setAttribute('aria-label', t); }
            fullBtn.addEventListener('click', function () {
                if (isFull()) { (document.exitFullscreen || document.webkitExitFullscreen).call(document); }
                else { var el = document.documentElement; (el.requestFullscreen || el.webkitRequestFullscreen).call(el); }
            });
            document.addEventListener('fullscreenchange', paintFull); document.addEventListener('webkitfullscreenchange', paintFull);

            // ---- a TV that is on all day: keep it awake, hide the cursor and tools, drift a few pixels ----
            var lock = null;
            function wake() { if ('wakeLock' in navigator) navigator.wakeLock.request('screen').then(function (l) { lock = l; }).catch(function () { }); }
            document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') wake(); });
            var idle; function awake() { document.body.classList.remove('qd-idle-cursor'); clearTimeout(idle); idle = setTimeout(function () { if (!document.querySelector('.select2-container--open')) document.body.classList.add('qd-idle-cursor'); }, 4000); }
            ['mousemove', 'keydown', 'touchstart'].forEach(function (e) { document.addEventListener(e, awake, { passive: true }); }); awake();
            var shifts = [[0, 0], [2, 1], [1, 3], [-2, 2], [-1, -2], [2, -1]], si = 0;
            setInterval(function () { si = (si + 1) % shifts.length; document.getElementById('qdShell').style.transform = 'translate(' + shifts[si][0] + 'px,' + shifts[si][1] + 'px)'; }, 600000);
        })();
    </script>
</body>
</html>
