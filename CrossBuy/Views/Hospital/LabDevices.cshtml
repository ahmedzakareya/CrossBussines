@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalDeviceMessageRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H198 — the laboratory's analysers: every HL7 result message received, what became of it, a device code linked to an
    analyte, a message applied again; and a message received by hand (pasted, or the file a middleware wrote).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Analyser results"].Value;
    var analytes = (ViewBag.Analytes as IReadOnlyList<(int Id, string Code, string Name, string NameEn, string Test)>) ?? Array.Empty<(int, string, string, string, string)>();
    string q = ViewBag.Q as string ?? "", status = ViewBag.Status as string ?? "";
    int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages, total = (int)ViewBag.Total;
    bool ready = ViewBag.Ready == true;
    string Tone(string s) => s switch { HospitalDeviceMessageStatus.Accepted => "primary", HospitalDeviceMessageStatus.Partial => "info", HospitalDeviceMessageStatus.Refused => "danger", _ => "secondary" };
    string Link(int p) => Url.Action("LabDevices", new { q, status, page = p })!;
    // the stored detail is the service's own words: a whole refusal is a resource key; a list names each code with why
    string Why(string? d)
    {
        if (string.IsNullOrEmpty(d)) return "—";
        var whole = T[d].Value; if (whole != d) return whole;
        return string.Join(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "، " : ", ", d.Split(", ").Select(x =>
        {
            if (x.EndsWith(" (not final)")) return string.Format(T["{0}: not final"].Value, x[..^" (not final)".Length]);
            if (x.EndsWith(" (unknown code)")) return string.Format(T["{0}: unknown code"].Value, x[..^" (unknown code)".Length]);
            var u = System.Text.RegularExpressions.Regex.Match(x, @"^(\S+) \(unit (.*) → (.*)\)$");
            return u.Success ? string.Format(T["{0}: in {1}, not {2}"].Value, u.Groups[1].Value, u.Groups[2].Value, u.Groups[3].Value) : x;
        }));
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Analyser results"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Lab")" class="text-muted text-hover-primary">@T["Laboratory"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Analyser results"]</li>
            </ul>
        </div>
        <button type="button" class="btn btn-sm btn-primary" data-dv-open><i class="ki-outline ki-file-down fs-4"></i>@T["Receive a message"]</button>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Results from the analysers come in as entered, never verified"]</h4>
                <div class="fs-6 text-gray-700">@T["Each result message (HL7 ORU^R01) is filed on the order its accession number names and merged with what the bench entered. The specialist verifies as always; nothing reaches the doctor before that. A result not final, with an unknown code or in other units is not filed and is named below."]</div></div>
        </div>
        @if (!ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["The analysers' tables are not created yet (hospital_h198_lab_devices.sql)."]</div></div>
        }
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Messages received"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} messages", total]</span>
                </h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("LabDevices")">
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" name="q" value="@q" class="form-control form-control-solid w-225px ps-12" placeholder="@T["Device, accession, patient"]" /></div>
                    <div class="w-150px"><select name="status" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="@T["All"]" onchange="this.form.submit()"><option value="">@T["All"]</option>@foreach (var s in HospitalDeviceMessageStatus.All) {<option value="@s" selected="@(s == status)">@T["dev:" + s]</option>}</select></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-flask fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No message received yet."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-3 my-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Received"]</th><th>@T["Device"]</th><th>@T["Lab order"]</th><th>@T["Status"]</th><th class="min-w-200px">@T["Not filed"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var m = r.Message;
                                var unknown = (m.Detail ?? "").Split(", ").Where(x => x.EndsWith(" (unknown code)")).Select(x => x[..^" (unknown code)".Length]).ToList();
                                <tr>
                                    <td class="ps-4 text-nowrap"><span class="text-gray-800 fw-semibold hp-num" dir="ltr">@HospitalNursingService.UtcToWard(m.ReceivedAt).ToString("yyyy-MM-dd HH:mm")</span></td>
                                    <td><span class="text-gray-900 fw-bold d-block fs-7" dir="ltr">@m.Device</span><span class="text-muted fs-8 hp-num" dir="ltr">@m.MessageId</span></td>
                                    <td>@if (m.LabOrderId is int oid) {<a href="@Url.Action("LabOrder", new { id = oid })" class="text-gray-900 fw-bold text-hover-primary d-block fs-7"><bdi class="hp-num">@m.AccessionNo</bdi> · @DisplayName.Of(r.Test ?? "", r.TestEn)</a><span class="text-muted fs-8">@DisplayName.Of(r.Patient ?? "", r.PatientEn)</span>}
                                        else {<bdi class="text-muted hp-num">@(m.AccessionNo ?? "—")</bdi>}</td>
                                    <td><span class="badge badge-light-@Tone(m.Status) fs-7 fw-bold">@T["dev:" + m.Status]</span>@if (m.Applied > 0) {<div class="text-muted fs-8 mt-1">@T["{0} results filed", m.Applied]</div>}</td>
                                    <td class="text-gray-700 fs-7">@Why(m.Detail)</td>
                                    <td class="text-end pe-4 text-nowrap">
                                        @foreach (var code in unknown.Take(3)) {<button type="button" class="btn btn-sm btn-light-primary ms-1" data-dv-map data-device="@m.Device" data-code="@code"><i class="ki-outline ki-fasten fs-4"></i>@T["Link {0}", code]</button>}
                                        @if (m.Status is HospitalDeviceMessageStatus.Partial or HospitalDeviceMessageStatus.Refused) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary ms-1" title="@T["Apply again"]" data-bs-toggle="tooltip" data-dv-again="@m.ID"><i class="ki-outline ki-arrows-circle fs-3"></i></button>}
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination pt-6 justify-content-end">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int p = Math.Max(1, page - 3); p <= Math.Min(pages, page + 3); p++) {<li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="dvModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-750px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Receive a message"]</h1><div class="text-muted fw-semibold fs-6">@T["Paste the HL7 result message, or open the file the analyser's middleware wrote."]</div></div>
        <input type="file" class="form-control form-control-solid mb-4" accept=".hl7,.txt,.msg" data-dv-file />
        <textarea class="form-control form-control-solid font-monospace fs-7" rows="9" dir="ltr" data-dv-raw placeholder="MSH|^~\&|ANALYSER|LAB|..."></textarea>
        <div class="mt-5 d-none" data-dv-result></div>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Close"]</button><button type="button" class="btn btn-primary" data-dv-send>@T["Receive"]</button></div>
    </div>
</div></div></div>
<div class="modal fade" id="mapModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Link a device code"]</h1><div class="text-muted fw-semibold fs-6" dir="ltr" data-map-what></div></div>
        <label class="fs-6 fw-semibold mb-2 required">@T["The analyte it means"]</label>
        <select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#mapModal" data-placeholder="@T["Choose"]" data-map-analyte><option></option>@foreach (var a in analytes) {<option value="@a.Id">@a.Test · @a.Code — @DisplayName.Of(a.Name, a.NameEn)</option>}</select>
        <div class="text-muted fs-7 mt-3">@T["From now on this device's code files on that analyte. Apply the message again to file it."]</div>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-map-save>@T["Link"]</button></div>
    </div>
</div></div></div>

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), filed: @Json.Serialize(T["{0} results filed"].Value), ack: @Json.Serialize(T["The acknowledgement sent back"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
            var dv = document.getElementById('dvModal'), mm = document.getElementById('mapModal'), mapping = null;
            dv.querySelector('[data-dv-file]').addEventListener('change', function () { var f = this.files && this.files[0]; if (!f) return; var r = new FileReader(); r.onload = function () { dv.querySelector('[data-dv-raw]').value = r.result; }; r.readAsText(f); });
            function show(res) {
                var box = dv.querySelector('[data-dv-result]'); box.classList.remove('d-none');
                var tone = res.status === 'Accepted' ? 'primary' : res.status === 'Partial' ? 'info' : res.status === 'Duplicate' ? 'secondary' : 'danger';
                box.innerHTML = '<div class="notice d-flex bg-light-' + tone + ' rounded border-' + tone + ' border border-dashed p-4"><div class="fw-semibold"><span class="badge badge-' + tone + ' me-2">' + esc(res.statusText) + '</span>' +
                    (res.applied ? esc(W.filed.replace('{0}', res.applied)) : '') + (res.detail ? '<div class="text-gray-700 fs-7 mt-2" dir="ltr">' + esc(res.detail) + '</div>' : '') +
                    '<div class="text-muted fs-8 mt-3">' + esc(W.ack) + '</div><pre class="fs-8 mb-0 mt-1" dir="ltr" style="white-space:pre-wrap">' + esc(res.ack) + '</pre></div></div>';
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-dv-open],[data-dv-send],[data-dv-again],[data-dv-map],[data-map-save]'); if (!t) return;
                if (t.hasAttribute('data-dv-open')) { dv.querySelector('[data-dv-raw]').value = ''; dv.querySelector('[data-dv-file]').value = ''; dv.querySelector('[data-dv-result]').classList.add('d-none'); bootstrap.Modal.getOrCreateInstance(dv).show(); return; }
                if (t.hasAttribute('data-dv-send')) { t.disabled = true; post(@Json.Serialize(Url.Action("LabDeviceReceive")), { raw: dv.querySelector('[data-dv-raw]').value }).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } show(res); dv.addEventListener('hidden.bs.modal', function () { location.reload(); }, { once: true }); }); return; }
                if (t.hasAttribute('data-dv-again')) { t.disabled = true; post(@Json.Serialize(Url.Content("~/Hospital/Lab/Devices/")) + t.getAttribute('data-dv-again') + '/Again').then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(res.statusText + (res.applied ? ' — ' + W.filed.replace('{0}', res.applied) : '')); setTimeout(function () { location.reload(); }, 600); }); return; }
                if (t.hasAttribute('data-dv-map')) { mapping = { device: t.getAttribute('data-device'), code: t.getAttribute('data-code') }; mm.querySelector('[data-map-what]').textContent = mapping.device + ' · ' + mapping.code; if (window.$) $(mm.querySelector('[data-map-analyte]')).val('').trigger('change'); bootstrap.Modal.getOrCreateInstance(mm).show(); return; }
                var aid = +mm.querySelector('[data-map-analyte]').value || 0; if (!aid) return; t.disabled = true;
                post(@Json.Serialize(Url.Action("LabDeviceMap")), { device: mapping.device, code: mapping.code, analyteId: aid }).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(mm).hide(); });
            });
        })();
    </script>
}
