@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalRehabPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H89 — one physiotherapy episode: the referral, the assessment (or the form to assess it), the progress against the
    measure's minimal clinically important difference drawn over the sessions, the goals, every session, and the
    discharge.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Physiotherapy episode"].Value;
    bool canTreat = ViewBag.CanTreat == true;
    var today = (DateTime)ViewBag.Today;
    var e = Model.Episode; var p = Model.Progress;
    bool referred = e.Status == HospitalRehabStatus.Referred, active = e.Status == HospitalRehabStatus.Active;
    var def = HospitalRehabMeasure.Of(e.MeasureCode);
    string Who(int? id) => id is int i && Model.People.TryGetValue(i, out var n) ? n : "";
    string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    // the outcome chart: the baseline, then each re-scored session; the dashed line is where a change becomes real (the MCID)
    var pts = new List<(int X, decimal Y)>();
    if (e.BaselineScore is decimal b0) pts.Add((0, b0));
    int n0 = 0;
    foreach (var s in Model.Sessions.Where(s => s.Attendance == HospitalRehabAttendance.Attended)) { n0++; if (s.Score is decimal sc) pts.Add((n0, sc)); }
    const double W = 760, H = 220, PL = 40, PR = 16, PT = 12, PB = 28;
    int maxX = Math.Max(Math.Max(e.PlannedSessions, n0), 1);
    double X(double x) => PL + (W - PL - PR) * x / maxX;
    double Y(double v) => def == null ? 0 : PT + (H - PT - PB) * (def.Max - v) / (def.Max - def.Min);
    Microsoft.AspNetCore.Html.IHtmlContent Svg(double x, double y, string anchor, string fill, string content) =>
        new Microsoft.AspNetCore.Html.HtmlString("<" + "text x=\"" + F(x) + "\" y=\"" + F(y) + "\" font-size=\"11\" text-anchor=\"" + anchor + "\" fill=\"" + fill + "\">" + System.Net.WebUtility.HtmlEncode(content) + "</" + "text>");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Physiotherapy episode"] <span class="badge hp-code fs-7 hp-num ms-2">@e.EpisodeNo</span></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("Rehab")" class="text-muted text-hover-primary">@T["Physiotherapy"]</a></li></ul>
        </div>
        @if (canTreat)
        {
            <div class="d-flex gap-2">
                @if (active) {<button type="button" class="btn btn-sm btn-primary" data-modal="sesModal"><i class="ki-outline ki-plus fs-4"></i>@T["Record a session"]</button>
                    <button type="button" class="btn btn-sm btn-light" data-modal="endModal"><i class="ki-outline ki-exit-right fs-4"></i>@T["End physiotherapy"]</button>}
                @if (referred) {<button type="button" class="btn btn-sm btn-light-danger" data-cancel><i class="ki-outline ki-cross-circle fs-4"></i>@T["Cancel the referral"]</button>}
            </div>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (p.Warnings.Count > 0)
        {
            <div class="notice d-flex align-items-center rounded border border-danger border-dashed bg-light-danger p-4 mb-5 gap-3"><i class="ki-outline ki-information-5 fs-2x text-danger"></i>
                <div class="d-flex flex-wrap gap-2">@foreach (var w in p.Warnings) {<span class="badge badge-danger fs-7">@T["rhw:" + w]</span>}</div></div>
        }
        <div class="row g-5 mb-5">
            <div class="col-xl-4"><div class="card h-100"><div class="card-body py-6">
                <div class="d-flex align-items-center gap-4 mb-5">
                    <div class="symbol symbol-55px symbol-circle">@if (Model.Photo != null) {<img src="@Model.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(Model.NameEn)</span>}</div>
                    <div><a href="@Url.Action("Patient", new { id = e.PatientId })" class="fs-4 fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(Model.Name, Model.NameEn)</a>
                        <div class="text-muted fs-7"><bdi class="hp-num">@Model.Mrn</bdi></div></div>
                </div>
                <div class="d-flex flex-stack py-2 border-bottom border-dashed"><span class="text-muted fs-7">@T["State"]</span><span class="badge badge-light-@(referred ? "primary" : active ? "success" : "secondary") fs-7">@T["rhs:" + e.Status]</span></div>
                <div class="d-flex flex-stack py-2 border-bottom border-dashed"><span class="text-muted fs-7">@T["Body region"]</span><span class="fw-semibold">@T["rgn:" + e.Region]</span></div>
                <div class="py-2 border-bottom border-dashed"><div class="text-muted fs-7">@T["Problem"]</div><div class="fw-semibold fs-7"><bdi>@e.Problem</bdi></div></div>
                @if (e.Precautions != null) {<div class="py-2 border-bottom border-dashed"><div class="text-muted fs-7">@T["Precautions"]</div><div class="text-danger fs-7 fw-semibold"><bdi>@e.Precautions</bdi></div></div>}
                <div class="d-flex flex-stack py-2 border-bottom border-dashed"><span class="text-muted fs-7">@T["Plan"]</span><span class="fw-semibold">@T["{0} sessions, {1} a week", e.PlannedSessions, e.PerWeek]</span></div>
                <div class="d-flex flex-stack py-2 border-bottom border-dashed"><span class="text-muted fs-7">@T["Referred by"]</span><span class="fs-7">@Who(e.ReferredByEmployeeId) <span class="text-muted hp-num">@HospitalNursingService.UtcToWard(e.ReferredAt).ToString("yyyy-MM-dd")</span></span></div>
                @if (e.AssessedAt != null) {<div class="d-flex flex-stack py-2 border-bottom border-dashed"><span class="text-muted fs-7">@T["Therapist"]</span><span class="fs-7">@Who(e.TherapistEmployeeId) <span class="text-muted hp-num">@HospitalNursingService.UtcToWard(e.AssessedAt.Value).ToString("yyyy-MM-dd")</span></span></div>}
                @if (e.Assessment != null) {<div class="py-2"><div class="text-muted fs-7">@T["Assessment"]</div><div class="fs-7"><bdi>@e.Assessment</bdi></div></div>}
                @if (e.EndedAt != null) {<div class="separator separator-dashed my-3"></div><div class="fs-7">@if (e.EndReason != null) {<span class="badge badge-light fs-8 me-1">@T["rhd:" + e.EndReason]</span>}<bdi>@e.Summary</bdi></div>}
            </div></div></div>

            <div class="col-xl-8 d-flex flex-column gap-5">
                @if (referred && canTreat)
                {
                    <div class="card border border-primary border-dashed" id="assessPanel"><div class="card-body py-6">
                        <div class="fw-bold fs-4 mb-1">@T["Assess the patient"]</div><div class="text-muted fs-8 mb-4">@T["One standard measure scored now and again during the sessions shows whether the change is real."]</div>
                        <div class="row g-3">
                            <div class="col-md-5"><label class="form-label fs-8 required">@T["Outcome measure"]</label><select class="form-select form-select-sm form-select-solid" data-a="measureCode">@foreach (var m in HospitalRehabMeasure.All) {<option value="@m.Code" data-min="@m.Min" data-max="@m.Max">@T["msr:" + m.Code]</option>}</select></div>
                            <div class="col-md-3"><label class="form-label fs-8 required">@T["Baseline score"]</label><input type="number" step="0.5" class="form-control form-control-sm form-control-solid" dir="ltr" data-a="baselineScore" /></div>
                            <div class="col-md-4"><label class="form-label fs-8">@T["Pain now (0–10)"]</label><input type="number" min="0" max="10" class="form-control form-control-sm form-control-solid" dir="ltr" data-a="baselinePain" /></div>
                            <div class="col-12"><label class="form-label fs-8">@T["Assessment"]</label><textarea rows="2" maxlength="1000" class="form-control form-control-sm form-control-solid" data-a="assessment" placeholder="@T["Range of motion, strength, function, special tests…"]"></textarea></div>
                            <div class="col-12"><label class="form-label fs-8">@T["Goals (one a line)"]</label><textarea rows="3" class="form-control form-control-sm form-control-solid" data-a="goals" placeholder="@T["Walk 500 m without pain, climb stairs with one rail…"]"></textarea></div>
                        </div>
                        <div class="d-flex justify-content-end mt-4"><button type="button" class="btn btn-sm btn-primary" data-assess><i class="ki-outline ki-check fs-4"></i>@T["Start the episode"]</button></div>
                    </div></div>
                }
                @if (!referred)
                {
                    <div class="row g-4">
                        <div class="col-md-3 col-6"><div class="card card-flush h-100 border-top border-3 border-primary"><div class="card-body py-4 px-5"><div class="fs-2hx fw-bold hp-num">@p.Attended<span class="fs-6 text-muted"> / @e.PlannedSessions</span></div><div class="text-muted fs-7">@T["Sessions done"]</div></div></div></div>
                        <div class="col-md-3 col-6"><div class="card card-flush h-100 border-top border-3 border-@(p.AttendancePct < 80 ? "danger" : "success")"><div class="card-body py-4 px-5"><div class="fs-2hx fw-bold hp-num">@(p.AttendancePct?.ToString() ?? "—")<span class="fs-6 text-muted">%</span></div><div class="text-muted fs-7">@T["Attendance"]</div></div></div></div>
                        <div class="col-md-3 col-6"><div class="card card-flush h-100 border-top border-3 border-@(p.Trend == HospitalRehabTrend.Improved ? "success" : p.Trend == HospitalRehabTrend.Worse ? "danger" : "gray-300")"><div class="card-body py-4 px-5">
                            <div class="fs-2hx fw-bold hp-num" dir="ltr">@(p.Change == null ? "—" : (p.Change > 0 ? "+" : "") + p.Change.Value.ToString("0.#"))</div><div class="text-muted fs-7">@T["Change in {0}", e.MeasureCode ?? ""]@if (p.Trend != null) {<text> · @T["rht:" + p.Trend]</text>}</div></div></div></div>
                        <div class="col-md-3 col-6"><div class="card card-flush h-100 border-top border-3 border-@(p.PainChange >= 2 ? "success" : p.PainChange <= -2 ? "danger" : "gray-300")"><div class="card-body py-4 px-5">
                            <div class="fs-2hx fw-bold hp-num" dir="ltr">@(e.BaselinePain?.ToString() ?? "—") → @(p.LatestPain?.ToString() ?? "—")</div><div class="text-muted fs-7">@T["Pain (0–10)"]</div></div></div></div>
                    </div>
                    if (def != null)
                    {
                        double target = def.HigherIsBetter ? (double)(e.BaselineScore + def.Mcid)! : (double)(e.BaselineScore - def.Mcid)!;
                        <div class="card"><div class="card-header border-0 pt-6"><div class="card-title flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["msr:" + def.Code]</span>
                            <span class="text-muted fs-8 mt-1">@T["A change of {0} or more is one the patient notices; the dashed line marks it.", def.Mcid.ToString("0.#")] @(def.HigherIsBetter ? T["Higher is better."] : T["Lower is better."])</span></div></div>
                            <div class="card-body pt-0">
                                <svg viewBox="0 0 @F(W) @F(H)" class="w-100" style="max-height:260px" dir="ltr" role="img" aria-label="@T["msr:" + def.Code]">
                                    @for (int v = def.Min; v <= def.Max; v += (def.Max - def.Min) / 4) {<line x1="@F(PL)" x2="@F(W - PR)" y1="@F(Y(v))" y2="@F(Y(v))" stroke="#eef0f6" />@Svg(PL - 6, Y(v) + 4, "end", "#6b7280", v.ToString())}
                                    @for (int x = 0; x <= maxX; x += Math.Max(1, maxX / 10)) {@Svg(X(x), H - 8, "middle", "#6b7280", x.ToString())}
                                    @if (target >= def.Min && target <= def.Max) {<line x1="@F(PL)" x2="@F(W - PR)" y1="@F(Y(target))" y2="@F(Y(target))" stroke="#50CD89" stroke-width="1.5" stroke-dasharray="6 4" />}
                                    @if (pts.Count > 1) {<polyline fill="none" stroke="#3A5795" stroke-width="2" points="@string.Join(" ", pts.Select(q => F(X(q.X)) + "," + F(Y((double)q.Y))))" />}
                                    @foreach (var q in pts) {<circle cx="@F(X(q.X))" cy="@F(Y((double)q.Y))" r="4.5" fill="@(q.X == 0 ? "#6b7280" : "#3A5795")" />}
                                </svg>
                            </div></div>
                    }
                }
            </div>
        </div>

        @if (!referred)
        {
            <div class="row g-5">
                <div class="col-xl-4"><div class="card h-100">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Goals"]</span></div>
                        @if (active && canTreat) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-goal-new><i class="ki-outline ki-plus fs-5"></i>@T["Add a goal"]</button></div>}</div>
                    <div class="card-body pt-2">
                        @if (Model.Goals.Count == 0) { <div class="text-center text-muted py-6">@T["No goal yet."]</div> }
                        @foreach (var g in Model.Goals)
                        {
                            <div class="d-flex align-items-start gap-3 py-3 border-bottom border-dashed">
                                <i class="ki-outline @(g.Status == HospitalRehabGoalStatus.Met ? "ki-check-circle text-success" : g.Status == HospitalRehabGoalStatus.NotMet ? "ki-cross-circle text-danger" : "ki-time text-primary") fs-2 mt-1"></i>
                                <div class="flex-grow-1"><div class="fw-semibold fs-7"><bdi>@g.Text</bdi></div>
                                    <div class="text-muted fs-8">@if (g.TargetDate != null) {<span class="hp-num @(g.Status == HospitalRehabGoalStatus.Open && g.TargetDate < today ? "text-danger fw-bold" : "")">@T["By {0}", g.TargetDate.Value.ToString("yyyy-MM-dd")]</span>} @if (g.Status != HospitalRehabGoalStatus.Open) {<span> · @T["rgs:" + g.Status]</span>}</div></div>
                                @if (active && canTreat && g.Status == HospitalRehabGoalStatus.Open) {<div class="d-flex gap-1"><button type="button" class="btn btn-icon btn-sm btn-light-success" title="@T["rgs:Met"]" data-goal="@g.ID" data-st="Met"><i class="ki-outline ki-check fs-5"></i></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light-danger" title="@T["rgs:NotMet"]" data-goal="@g.ID" data-st="NotMet"><i class="ki-outline ki-cross fs-5"></i></button></div>}
                            </div>
                        }
                    </div>
                </div></div>
                <div class="col-xl-8"><div class="card h-100">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Sessions"]</span></div></div>
                    <div class="card-body pt-2">
                        @if (Model.Sessions.Count == 0) { <div class="text-center text-muted py-6">@T["No session yet."]</div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                                <thead><tr class="text-start text-gray-500 fw-bold fs-8 text-uppercase gs-0"><th>@T["Date"]</th><th>@T["Attendance"]</th><th>@T["What was done"]</th><th>@T["Pain"]</th><th>@e.MeasureCode</th><th>@T["Note"]</th></tr></thead>
                                <tbody>
                                @foreach (var s in Model.Sessions.AsEnumerable().Reverse())
                                {
                                    bool came = s.Attendance == HospitalRehabAttendance.Attended;
                                    <tr class="@(came ? "" : "bg-light")">
                                        <td class="hp-num text-nowrap">@s.SessionDate.ToString("yyyy-MM-dd")<div class="text-muted fs-9" style="font-family:inherit">@Who(s.CreatedByEmployeeId)</div></td>
                                        <td><span class="badge @(came ? "badge-light-success" : s.Attendance == HospitalRehabAttendance.NoShow ? "badge-light-danger" : "badge-light") fs-8">@T["rha:" + s.Attendance]</span>@if (s.Minutes != null) {<div class="text-muted fs-9">@T["{0} min", s.Minutes]</div>}</td>
                                        <td class="fs-8">@if (s.Interventions != null) {<div class="d-flex flex-wrap gap-1">@foreach (var x in s.Interventions.Split(',')) {<span class="badge badge-light fs-9">@T["rhi:" + x]</span>}</div>}</td>
                                        <td class="hp-num text-nowrap" dir="ltr">@(s.PainBefore?.ToString() ?? "—") → @(s.PainAfter?.ToString() ?? "—")</td>
                                        <td class="hp-num fw-bold">@(s.Score?.ToString("0.#") ?? "")</td>
                                        <td class="fs-8"><bdi>@s.Note</bdi></td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div></div>
            </div>
        }
    </div></div>
</div>

@if (active && canTreat)
{
    <div class="modal fade" id="sesModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["Record a session"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-6"><label class="form-label required">@T["Date"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-s="date" value="@today.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" /></div>
            <div class="col-6"><label class="form-label required">@T["Attendance"]</label>
                <div class="d-flex gap-3 pt-2">@foreach (var a in HospitalRehabAttendance.All) {<label class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="radio" name="att" value="@a" checked="@(a == HospitalRehabAttendance.Attended)" /><span class="form-check-label">@T["rha:" + a]</span></label>}</div></div>
            <div class="col-12" data-came>
                <div class="row g-4">
                    <div class="col-4"><label class="form-label required">@T["Minutes"]</label><input type="number" min="5" max="240" value="45" class="form-control form-control-solid" dir="ltr" data-s="minutes" /></div>
                    <div class="col-4"><label class="form-label">@T["Pain before"]</label><input type="number" min="0" max="10" class="form-control form-control-solid" dir="ltr" data-s="painBefore" /></div>
                    <div class="col-4"><label class="form-label">@T["Pain after"]</label><input type="number" min="0" max="10" class="form-control form-control-solid" dir="ltr" data-s="painAfter" /></div>
                    <div class="col-12"><label class="form-label required">@T["What was done"]</label>
                        <div class="d-flex flex-wrap gap-2">@foreach (var x in HospitalRehabIntervention.All) {<label class="btn btn-sm btn-outline btn-outline-dashed btn-active-light-primary mb-0"><input type="checkbox" class="d-none" data-iv="@x" />@T["rhi:" + x]</label>}</div></div>
                    @if (def != null) {<div class="col-6"><label class="form-label">@T["msr:" + def.Code]</label><input type="number" step="0.5" min="@def.Min" max="@def.Max" class="form-control form-control-solid" dir="ltr" data-s="score" placeholder="@T["Re-scored today (optional)"]" /></div>}
                </div>
            </div>
            <div class="col-12"><label class="form-label">@T["Note"]</label><textarea rows="2" maxlength="500" class="form-control form-control-solid" data-s="note"></textarea></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-ses-save>@T["Save"]</button></div>
    </div></div></div>

    <div class="modal fade" id="endModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["End physiotherapy"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-12"><label class="form-label required">@T["Why"]</label><select class="form-select form-select-solid" data-e="reason">@foreach (var d in HospitalRehabDischarge.All) {<option value="@d">@T["rhd:" + d]</option>}</select></div>
            <div class="col-12"><label class="form-label required">@T["Discharge summary"]</label><textarea rows="4" maxlength="1000" class="form-control form-control-solid" data-e="summary" placeholder="@T["Where the patient is now, the home programme, when to come back…"]"></textarea></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-end-save>@T["End physiotherapy"]</button></div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var tokEl = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tokEl) return; var tok = tokEl.value;
            var id = @e.ID, base = @Json.Serialize(Url.Content("~/Hospital/Rehab/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), assess: @Json.Serialize(T["Start the episode with this assessment?"].Value),
                      ses: @Json.Serialize(T["Save this session?"].Value), end: @Json.Serialize(T["Discharge the patient from physiotherapy?"].Value), cancel: @Json.Serialize(T["Why is the referral cancelled?"].Value),
                      cancelT: @Json.Serialize(T["Cancel the referral"].Value), goal: @Json.Serialize(T["Write the goal"].Value), goalT: @Json.Serialize(T["Add a goal"].Value), mark: @Json.Serialize(T["Close this goal?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b) })
                .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(btn) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }; }
            function num(v) { return v === '' ? null : Number(v); }
            var ses = document.getElementById('sesModal');
            if (ses) {
                ses.querySelectorAll('[data-iv]').forEach(function (c) { c.addEventListener('change', function () { c.parentElement.classList.toggle('active', c.checked); }); });
                ses.querySelectorAll('input[name="att"]').forEach(function (r) { r.addEventListener('change', function () { ses.querySelector('[data-came]').classList.toggle('d-none', r.value !== 'Attended' || !r.checked); }); });
            }
            document.addEventListener('click', function (ev) {
                var o = ev.target.closest('[data-modal]'); if (o) { bootstrap.Modal.getOrCreateInstance(document.getElementById(o.getAttribute('data-modal'))).show(); return; }
                var a = ev.target.closest('[data-assess]');
                if (a) { var pn = document.getElementById('assessPanel'), b = {}; pn.querySelectorAll('[data-a]').forEach(function (i) { var k = i.getAttribute('data-a'), v = (i.value || '').trim();
                        b[k] = k === 'goals' ? v.split('\n').map(function (x) { return x.trim(); }).filter(Boolean) : (k === 'baselineScore' || k === 'baselinePain') ? num(v) : (v || null); });
                    cbConfirm(W.assess).then(function (ok) { if (!ok) return; a.disabled = true; post(base + id + '/Assess', b).then(done(a)); }); return; }
                var sv = ev.target.closest('[data-ses-save]');
                if (sv) { var att = ses.querySelector('input[name="att"]:checked').value, came = att === 'Attended', b2 = { episodeId: id, attendance: att };
                    ses.querySelectorAll('[data-s]').forEach(function (i) { var k = i.getAttribute('data-s'), v = (i.value || '').trim();
                        if (!came && k !== 'date' && k !== 'note') return; b2[k] = (k === 'date' || k === 'note') ? (v || null) : num(v); });
                    b2.interventions = came ? Array.from(ses.querySelectorAll('[data-iv]:checked')).map(function (c) { return c.getAttribute('data-iv'); }) : [];
                    cbConfirm(W.ses).then(function (ok) { if (!ok) return; sv.disabled = true; post(base + 'Session', b2).then(done(sv)); }); return; }
                var es = ev.target.closest('[data-end-save]');
                if (es) { var m = document.getElementById('endModal'); var b3 = { cancel: false, reason: m.querySelector('[data-e="reason"]').value, summary: (m.querySelector('[data-e="summary"]').value || '').trim() || null };
                    cbConfirm(W.end).then(function (ok) { if (!ok) return; es.disabled = true; post(base + id + '/End', b3).then(done(es)); }); return; }
                var cn = ev.target.closest('[data-cancel]');
                if (cn) { cbPrompt(W.cancel, { title: W.cancelT, kind: 'danger', textarea: true }).then(function (why) { if (why) post(base + id + '/End', { cancel: true, summary: why }).then(done(cn)); }); return; }
                if (ev.target.closest('[data-goal-new]')) { cbPrompt(W.goal, { title: W.goalT }).then(function (t) { if (t) post(base + 'Goal', { episodeId: id, text: t }).then(done(null)); }); return; }
                var g = ev.target.closest('[data-goal]');
                if (g) cbConfirm(W.mark).then(function (ok) { if (ok) post(base + 'Goal/' + g.getAttribute('data-goal'), { status: g.getAttribute('data-st') }).then(done(g)); });
            });
        })();
    </script>
}
