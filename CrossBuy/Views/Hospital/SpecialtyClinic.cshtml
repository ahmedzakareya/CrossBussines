@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    A specialty clinic (the menu's "Internal medicine", "Paediatrics" …): its visits — today's by default, the open ones,
    or all — each opening the specialty visit screen (H94/H95).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var clinic = (HospitalDepartment)ViewBag.Clinic; int today = ViewBag.Today is int n ? n : 0;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    string name = isAr ? clinic.Name : (clinic.NameEn ?? clinic.Name);
    ViewData["Title"] = string.Format(T["{0} clinic"].Value, name);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["{0} clinic", name]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Specialty clinics"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@name</li></ul>
        </div>
        <a href="@Url.Action("Worklist")" class="btn btn-sm btn-light"><i class="ki-outline ki-briefcase fs-4"></i>@T["Doctor worklist"]</a>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H127: the theme's notice (demo39) — what a clinic visit carries, with today's count *@
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-abstract-26 fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-4">
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["The clinic's visits"]</h4>
                    <div class="fs-6 text-gray-700">@T["Each visit opens with the clinic's templates, its figures and trends, its care gaps and the order sets of its diagnoses. A visit starts from the clinic board, when the doctor calls the patient in."]</div></div>
                <div class="d-flex flex-column align-items-center flex-shrink-0 px-4"><span class="fs-2hx fw-bold text-gray-900 lh-1 hp-num">@today</span><span class="text-gray-500 fw-semibold fs-7 pt-1">@T["Today"]</span></div>
            </div>
        </div>
        <div class="card card-flush">
            <div class="card-header pt-5 flex-wrap gap-3">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Visits"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                    <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by name or file…"]" /></div>
                    <div class="w-175px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_scope"><option value="today">@T["Today"]</option><option value="open">@T["Open visits"]</option><option value="all">@T["All visits"]</option></select></div>
                    <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                    <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                </div>
            </div>
            <div class="card-body pt-2">
                @* H127: the theme's table widget (demo39 widgets/tables) *@
                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                    <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 min-w-200px rounded-start">@T["Patient"]</th><th>@T["Time"]</th><th>@T["Doctor"]</th><th>@T["Complaint"]</th><th>@T["Forms signed"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                    <tbody id="rows"><tr id="loadingRow"><td colspan="7" class="text-center py-10"><span class="spinner-border spinner-border-sm text-primary align-middle me-2"></span><span class="text-gray-500 fw-semibold">@T["Loading…"]</span></td></tr>
                        <tr id="emptyRow" class="d-none"><td colspan="7" class="text-center py-12"><i class="ki-outline ki-calendar-remove fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["No visit in this clinic yet."]</div></td></tr></tbody>
                </table></div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            cbServerList({ url: @Json.Serialize(Url.Action("SpecialtyClinicData", new { code = clinic.Code })), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('scope', document.getElementById('f_scope').value); } });
        })();
    </script>
}
