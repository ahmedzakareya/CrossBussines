@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalBillRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — the bills: stat tiles (demo39 dashboards/logistics) over the theme's table widget (widgets/tables).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Bills"].Value;
    var currency = ViewBag.Currency as HospitalCurrency;
    string? status = ViewBag.Status as string;
    string M(decimal v) => currency == null ? v.ToString("N2") : currency.Format(v);
    string cur = currency?.Label(DisplayName.IsArabic) ?? "";
    var open = Model.Where(b => b.Status == HospitalBillStatus.Open).ToList();
    // H7: a bill is in its own currency; the totals add up only the bills in the facility's currency.
    var home = Model.Where(b => b.Currency == null || b.Currency.Code == currency?.Code).ToList();
    string RM(HospitalBillRow b, decimal v) => b.Currency != null ? b.Currency.Format(v) : M(v);
    bool Foreign(HospitalBillRow b) => b.Currency != null && b.Currency.Code != currency?.Code;
    decimal owed = home.Sum(b => b.Total - b.Paid);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Billing & cashier"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Bills"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("Cashier")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-wallet fs-4"></i>@T["Cashier closing"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* stat tiles — demo39 dashboards/logistics *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Open bills"].Value, open.Count.ToString(), T["visits and stays still running"].Value, "primary", "bill", "text-gray-900"),
                (T["Billed"].Value, M(home.Sum(b => b.Total)), cur, "info", "document", "text-gray-900"),
                (T["Collected"].Value, M(home.Sum(b => b.Paid)), cur, "primary", "wallet", "text-primary"),
                (T["Still owed"].Value, M(owed), cur, owed > 0 ? "danger" : "primary", "dollar", owed > 0 ? "text-danger" : "text-gray-900") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold @s.Item6 lh-1 hp-num" dir="ltr">@s.Item2</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item4"><i class="ki-outline ki-@s.Item5 fs-2 text-@s.Item4"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0"><span class="d-flex align-items-center fs-7 fw-semibold text-gray-500"><span class="bullet bullet-dot bg-@s.Item4 me-2"></span>@s.Item3</span></div>
                </div></div>
            }
        </div>

        @* table widget — demo39 widgets/tables *@
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Bills"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} of {1}", open.Count, Model.Count] · @T["bill:Open"]</span>
                </h3>
                <div class="card-toolbar">
                    <div class="btn-group">
                        <a href="@Url.Action("Bills")" class="btn btn-sm @(status == null ? "btn-primary" : "btn-light")">@T["All"]</a>
                        <a href="@Url.Action("Bills", new { status = HospitalBillStatus.Open })" class="btn btn-sm @(status == HospitalBillStatus.Open ? "btn-primary" : "btn-light")">@T["bill:Open"]</a>
                        <a href="@Url.Action("Bills", new { status = HospitalBillStatus.Closed })" class="btn btn-sm @(status == HospitalBillStatus.Closed ? "btn-primary" : "btn-light")">@T["bill:Closed"]</a>
                    </div>
                </div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-bill fs-3x text-gray-300 mb-4 d-block"></i>
                        <div class="fs-6 fw-bold text-gray-700">@T["No bills yet. A bill opens when a visit is signed or a patient is admitted."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Bill"]</th><th class="text-end">@T["Total"]</th><th class="text-end">@T["Paid"]</th><th class="text-end">@T["Due"]</th><th>@T["Status"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                var url = Url.Action("Bill", new { id = b.Id });
                                var due = b.Total - b.Paid;
                                <tr>
                                    <td class="ps-4"><div class="d-flex align-items-center min-w-0">
                                        <div class="symbol symbol-45px symbol-circle flex-shrink-0 me-4">@if (b.PatientPhoto != null) {<img src="@b.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(b.PatientNameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold fs-7">@HospitalUi.Initials(b.PatientNameEn)</span>}</div>
                                        <div class="d-flex flex-column min-w-0"><a href="@Url.Action("Patient", new { id = b.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6 text-truncate"><bdi>@DisplayName.Of(b.PatientName, b.PatientNameEn)</bdi></a><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@b.Mrn</bdi></div>
                                    </div></td>
                                    <td><a href="@url" class="text-gray-900 fw-bold text-hover-primary d-block fs-6"><bdi class="hp-num">@b.BillNo</bdi></a>
                                        <span class="text-muted fw-semibold d-block fs-7">@(b.Inpatient ? T["Inpatient stay"] : T["Outpatient visit"]) · <span class="hp-num" dir="ltr">@b.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd")</span></span></td>
                                    <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num" dir="ltr">@RM(b, b.Total)</span>@if (Foreign(b)) {<span class="badge badge-light-info fs-8 ms-1">@b.Currency!.Code</span>}</td>
                                    <td class="text-end"><span class="text-primary fw-bold fs-6 hp-num" dir="ltr">@RM(b, b.Paid)</span></td>
                                    <td class="text-end"><span class="badge badge-light-@(due > 0 ? "danger" : "primary") fs-7 fw-bold hp-num" dir="ltr">@RM(b, due)</span></td>
                                    <td><span class="badge badge-light-@(b.Status == HospitalBillStatus.Open ? "primary" : "primary") fs-7 fw-bold">@T["bill:" + b.Status]</span></td>
                                    <td class="text-end pe-4"><a href="@url" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Open the bill"]" data-bs-toggle="tooltip"><i class="ki-outline ki-eye fs-3"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>
