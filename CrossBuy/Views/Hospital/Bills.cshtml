@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalBillRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Bills"].Value;
    var currency = ViewBag.Currency as HospitalCurrency;
    string? status = ViewBag.Status as string;
    string M(decimal v) => currency == null ? v.ToString("N2") : currency.Format(v);
    string cur = currency?.Label(DisplayName.IsArabic) ?? "";
    var open = Model.Where(b => b.Status == HospitalBillStatus.Open).ToList();
    // H7: a bill is in its own currency; the totals add up only the bills in the facility's currency.
    var home = Model.Where(b => b.Currency == null || b.Currency.Code == currency?.Code).ToList();
    string RM(HospitalBillRow b, decimal v) => b.Currency != null ? b.Currency.Format(v) : M(v);
    bool Foreign(HospitalBillRow b) => b.Currency != null && b.Currency.Code != currency?.Code;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Billing & cashier"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Bills"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("Cashier")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-wallet fs-4"></i>@T["Cashier closing"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Open bills"].Value, open.Count.ToString(), T["visits and stays still running"].Value, "text-gray-900"),
                (T["Billed"].Value, M(home.Sum(b => b.Total)), cur, "text-gray-900"),
                (T["Collected"].Value, M(home.Sum(b => b.Paid)), cur, "text-success"),
                (T["Still owed"].Value, M(home.Sum(b => b.Total - b.Paid)), cur, home.Sum(b => b.Total - b.Paid) > 0 ? "text-danger" : "text-gray-900") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div>
                    <div class="fs-2hx fw-bold @s.Item4 hp-num">@s.Item2</div>
                    <div class="text-muted fs-8 mt-1">@s.Item3</div>
                </div></div></div>
            }
        </div>

        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Bills"]</span></div>
                <div class="card-toolbar">
                    <div class="btn-group">
                        <a href="@Url.Action("Bills")" class="btn btn-sm @(status == null ? "btn-primary" : "btn-light")">@T["All"]</a>
                        <a href="@Url.Action("Bills", new { status = HospitalBillStatus.Open })" class="btn btn-sm @(status == HospitalBillStatus.Open ? "btn-primary" : "btn-light")">@T["bill:Open"]</a>
                        <a href="@Url.Action("Bills", new { status = HospitalBillStatus.Closed })" class="btn btn-sm @(status == HospitalBillStatus.Closed ? "btn-primary" : "btn-light")">@T["bill:Closed"]</a>
                    </div>
                </div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0) { <div class="text-center text-muted py-15"><i class="ki-outline ki-bill fs-3x text-gray-300 d-block mb-4"></i>@T["No bills yet. A bill opens when a visit is signed or a patient is admitted."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-4 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th class="w-125px">@T["Bill"]</th><th>@T["Patient"]</th><th>@T["Type"]</th><th>@T["Opened"]</th><th class="text-end">@T["Total"]</th><th class="text-end">@T["Paid"]</th><th class="text-end">@T["Due"]</th><th>@T["Status"]</th><th class="text-end w-100px"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var b in Model)
                            {
                                var url = Url.Action("Bill", new { id = b.Id });
                                <tr>
                                    <td><a href="@url" class="badge hp-code fw-bold fs-8 hp-num">@b.BillNo</a></td>
                                    <td><div class="d-flex align-items-center min-w-0">
                                        <div class="symbol symbol-35px symbol-circle flex-shrink-0">@if (b.PatientPhoto != null) {<img src="@b.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(b.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(b.PatientNameEn)</span>}</div>
                                        <div class="d-flex flex-column ms-3 min-w-0"><a href="@Url.Action("Patient", new { id = b.PatientId })" class="text-gray-900 text-hover-primary fw-bold fs-7 text-truncate">@DisplayName.Of(b.PatientName, b.PatientNameEn)</a><span class="text-muted fs-8 hp-num">@b.Mrn</span></div>
                                    </div></td>
                                    <td class="fs-7">@(b.Inpatient ? T["Inpatient stay"] : T["Outpatient visit"])</td>
                                    <td class="hp-num fs-7">@b.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                    <td class="text-end hp-num">@RM(b, b.Total)@if (Foreign(b)) {<span class="badge badge-light-info fs-9 ms-1">@b.Currency!.Code</span>}</td>
                                    <td class="text-end hp-num text-success">@RM(b, b.Paid)</td>
                                    <td class="text-end hp-num fw-bold @(b.Total - b.Paid > 0 ? "text-danger" : "")">@RM(b, b.Total - b.Paid)</td>
                                    <td><span class="badge @(b.Status == HospitalBillStatus.Open ? "badge-light-primary" : "badge-light-success") fs-8">@T["bill:" + b.Status]</span></td>
                                    <td class="text-end"><a href="@url" class="btn btn-sm btn-light-primary">@T["Open"]</a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>
