@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model List<HospitalDoseLimit>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ bool canKeep = ViewBag.CanKeep == true; }
@foreach (var r in Model)
{
    <tr class="@(r.IsActive ? "" : "opacity-50")">
        <td><bdi class="fw-bold text-gray-900">@r.Drug</bdi></td>
        <td>@(r.Route != null ? T["route:" + r.Route] : T["Any route"])</td>
        <td class="hp-num text-nowrap" dir="ltr">@(r.MaxSingle is decimal s ? HospitalDrugSafetyRules.Num(s) + " " + r.Unit : "—")</td>
        <td class="hp-num text-nowrap" dir="ltr">@(r.MaxDaily is decimal d ? HospitalDrugSafetyRules.Num(d) + " " + r.Unit : "—")</td>
        <td class="fs-8 text-gray-700" dir="auto">@r.Note</td>
        <td>@if (r.IsActive) {<span class="badge badge-light-success">@T["In use"]</span>} else {<span class="badge badge-light">@T["Not in use"]</span>}</td>
        <td class="text-end">@if (canKeep) { <button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-ds-edit="@r.ID" data-row="@System.Text.Json.JsonSerializer.Serialize(new { drug = r.Drug, route = r.Route ?? "", unit = r.Unit, maxSingle = r.MaxSingle, maxDaily = r.MaxDaily, note = r.Note, isActive = r.IsActive })">@T["Edit"]</button> }</td>
    </tr>
}
