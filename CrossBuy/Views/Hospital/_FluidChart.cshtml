@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalFluidChart
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H78 — one fluid day of an admission's chart, loaded into the nursing station's window: the totals in, out and the
    balance, each kind's sum, every entry (a voided one struck through, with why), and the last five days. Low urine output
    shows only with a recorded weight, and says which weight.
*@
@{
    bool canWard = ViewBag.CanWard == true; int back = ViewBag.Back;
    string Ml(int v) => v.ToString("#,0", System.Globalization.CultureInfo.InvariantCulture);
    string Signed(int v) => (v > 0 ? "+" : v < 0 ? "−" : "") + Ml(Math.Abs(v));
    string Local(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("HH:mm");
}
@if (!Model.Ready) { <div class="notice d-flex rounded border border-dashed p-6 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalFluidService.NoTables]</div></div> }
else
{
    <div data-fluid-back="@back">
        <div class="d-flex flex-stack flex-wrap gap-3 mb-5">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-icon btn-light" data-fluid-day="@(back + 1)" @(back >= 30 ? "disabled" : "") title="@T["The day before"]"><i class="ki-outline @(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "ki-arrow-right" : "ki-arrow-left") fs-4"></i></button>
                <div class="fw-bold text-gray-900 fs-6"><bdi class="hp-num" dir="ltr">@Model.DayStart.ToString("yyyy-MM-dd HH:mm") → @Model.DayStart.AddDays(1).ToString("MM-dd HH:mm")</bdi>@if (Model.IsCurrentDay) {<span class="badge badge-light-primary ms-2">@T["Today"]</span>}</div>
                <button type="button" class="btn btn-sm btn-icon btn-light" data-fluid-day="@(back - 1)" @(back == 0 ? "disabled" : "") title="@T["The day after"]"><i class="ki-outline @(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "ki-arrow-left" : "ki-arrow-right") fs-4"></i></button>
            </div>
            @if (Model.WeightKg != null) {<div class="text-muted fs-8">@T["Weight used: {0} kg ({1})", Model.WeightKg.Value.ToString("0.#"), Model.WeightOn?.ToString("yyyy-MM-dd") ?? ""]</div>}
            else {<div class="text-muted fs-8">@T["No weight on file: low urine output is not checked."]</div>}
        </div>
        @if (Model.LowUrine) {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><i class="ki-outline ki-drop fs-2tx text-danger me-4"></i>
                <div class="fs-6 fw-semibold text-gray-700 align-self-center">@T["Low urine output: {0} ml in the last 6 hours — under 0.5 ml/kg/h.", Ml(Model.UrineLast6h ?? 0)]</div></div>
        }
        @* H128: in · out · net — the theme's stat tiles (demo39 dashboards/logistics) *@
        <div class="row g-4 mb-5">
            @foreach (var (label, val, icon, tone, signed) in new[] { (T["Fluid in"].Value, Model.Today.In, "arrow-down", "primary", false), (T["Fluid out"].Value, Model.Today.Out, "arrow-up", "info", false), (T["Net"].Value, Model.Today.Balance, "abstract-26", Model.Today.Balance < 0 ? "danger" : "success", true) })
            {
                <div class="col-4"><div class="card card-bordered h-100"><div class="card-body d-flex flex-stack flex-nowrap gap-3 p-4">
                    <div class="d-flex flex-column"><span class="fs-2 fw-bold lh-1 hp-num text-@(signed ? tone : "gray-900")" dir="ltr">@(signed ? Signed(val) : Ml(val))&nbsp;<span class="fs-7 text-gray-500">ml</span></span>
                        <span class="text-gray-500 pt-1 fw-semibold fs-7">@label</span></div>
                    <div class="symbol symbol-40px flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-2 text-@tone"></i></span></div>
                </div></div></div>
            }
        </div>
        @if (Model.ByKind.Count > 0) {
            <div class="d-flex flex-wrap gap-2 mb-5">@foreach (var k in HospitalFluidKind.All.Where(Model.ByKind.ContainsKey)) {<span class="badge @(HospitalFluidKind.In.Contains(k) ? "badge-light-primary" : "badge-light-info") fs-7 fw-bold">@T["fluid:" + k] · <bdi class="hp-num">@Ml(Model.ByKind[k])</bdi></span>}</div>
        }
        <div class="table-responsive mb-5"><table class="table align-middle gs-0 gy-3 mb-0">
            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Time"]</th><th>@T["In or out"]</th><th class="text-end">ml</th><th>@T["Recorded by"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
            <tbody>
            @if (Model.Entries.Count == 0) { <tr><td colspan="5"><div class="text-center py-8"><i class="ki-outline ki-drop fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Nothing recorded in this fluid day."]</div></div></td></tr> }
            @foreach (var e in Model.Entries)
            {
                bool voided = e.VoidedAt != null; bool isIn = e.Direction == HospitalFluidDirection.In;
                <tr class="@(voided ? "opacity-50" : "")">
                    <td class="ps-4"><span class="text-gray-900 fw-bold hp-num">@Local(e.At)</span></td>
                    <td><div class="d-flex align-items-center">
                            <div class="symbol symbol-30px me-3 flex-shrink-0"><span class="symbol-label bg-light-@(isIn ? "primary" : "info")"><i class="ki-outline @(isIn ? "ki-arrow-down text-primary" : "ki-arrow-up text-info") fs-4"></i></span></div>
                            <div class="d-flex flex-column"><span class="text-gray-800 fw-bold @(voided ? "text-decoration-line-through" : "")">@T["fluid:" + e.Kind]</span>
                                @if (e.Note != null) {<bdi class="fs-7 text-muted">@e.Note</bdi>}
                                @if (voided) {<span class="fs-7 text-danger">@T["Voided"]: <bdi>@e.VoidReason</bdi></span>}</div></div></td>
                    <td class="text-end"><span class="hp-num fw-bold text-gray-900 @(voided ? "text-decoration-line-through" : "")">@Ml(e.VolumeMl)</span></td>
                    <td class="text-gray-600 fw-semibold fs-7">@(e.CreatedByEmployeeId is int c && Model.People.TryGetValue(c, out var who) ? who : "")</td>
                    <td class="text-end pe-4">@if (canWard && !voided) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["Void"]" data-fluid-void="@e.ID" data-what="@Local(e.At) — @T["fluid:" + e.Kind] @Ml(e.VolumeMl) ml"><i class="ki-outline ki-trash fs-4"></i></button>}</td>
                </tr>
            }
            </tbody>
        </table></div>
        <div class="fw-bold text-gray-800 fs-6 mb-3">@T["The last five days"]</div>
        <div class="table-responsive"><table class="table align-middle gs-0 gy-2 mb-0">
            <thead><tr class="fw-bold text-muted bg-light fs-7"><th class="ps-4 rounded-start">@T["Fluid day"]</th><th class="text-end">@T["Fluid in"]</th><th class="text-end">@T["Fluid out"]</th><th class="text-end pe-4 rounded-end">@T["Net"]</th></tr></thead>
            <tbody class="hp-num fw-semibold text-gray-700">@foreach (var d in Model.Days) {<tr><td dir="ltr" class="text-start ps-4">@d.DayStart.ToString("MM-dd")</td><td class="text-end">@Ml(d.In)</td><td class="text-end">@Ml(d.Out)</td><td class="text-end pe-4"><span class="badge @(d.Balance < 0 ? "badge-light-danger" : "badge-light-success") fs-7 fw-bold" dir="ltr">@Signed(d.Balance)</span></td></tr>}</tbody>
        </table></div>
    </div>
}
