@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPractitionerView>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Practitioners"].Value;
    bool canManage = ViewBag.CanManage == true;
    var departments = (ViewBag.Departments as IReadOnlyList<HospitalDepartment>) ?? Array.Empty<HospitalDepartment>();
    DateTime today = ViewBag.Today;
    int? DaysLeft(HospitalPractitioner p) => p.LicenseExpiry is DateTime x ? (int)(x.Date - today).TotalDays : null;
    string EngagementBadge(string e) => e == HospitalEngagements.Visiting ? "badge-light-info" : e == HospitalEngagements.PartTime ? "badge-light-primary" : "badge-light-success";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Practitioners"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Hospital"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Doctors & staff"]</li>
            </ul>
        </div>
        @if (canManage)
        {
            <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
                @if (departments.Count == 0)
                {
                    <button type="button" class="btn btn-sm btn-light-primary" id="seedDepartments"><i class="ki-outline ki-arrow-down fs-4"></i>@T["Load standard departments"]</button>
                }
                <a href="@Url.Action("NewPractitioner")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-4"></i>@T["Add doctor"]</a>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Permanent doctors"].Value, Model.Count(p => p.Row.Engagement == HospitalEngagements.Permanent), T["through payroll"].Value, "primary", "ki-briefcase"),
                (T["Part-time"].Value, Model.Count(p => p.Row.Engagement == HospitalEngagements.PartTime), T["payroll, variable line"].Value, "info", "ki-time"),
                (T["Visiting"].Value, Model.Count(p => p.Row.Engagement == HospitalEngagements.Visiting), T["through vendors & payables"].Value, "success", "ki-route"),
                (T["Licences expiring in 60 days"].Value, Model.Count(p => DaysLeft(p.Row) is int d && d <= 60), T["Booking stops on expiry"].Value, Model.Any(p => DaysLeft(p.Row) is int d && d <= 60) ? "danger" : "success", "ki-shield-tick") })
            {
                @* H128: stat tiles (demo39 dashboards/logistics) *@
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold text-gray-900 lh-1 hp-num">@s.Item2</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item4"><i class="ki-outline @s.Item5 fs-2x text-@s.Item4"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0 pb-5">
                        <span class="d-flex align-items-center fs-7 fw-semibold text-gray-500"><span class="bullet bullet-dot bg-@s.Item4 me-2"></span>@s.Item3</span>
                    </div>
                </div></div>
            }
        </div>

        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="fw-semibold">
                <h4 class="text-gray-900 fw-bold mb-1">@T["One practitioner record, two ways to pay"]</h4>
                <div class="fs-6 text-gray-700">@T["Clinical data and privileges live in one record per doctor; permanent and part-time are paid through payroll, visiting doctors as vendors."]</div>
            </div>
        </div>

        <div class="card card-flush">
            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Practitioners"]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Doctors & staff"] · <span class="hp-num">@Model.Count</span></span></h3></div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-people fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No practitioners yet. Add the first doctor."]</div></div>
                }
                else
                {
                    @* H128: the theme's table widget (demo39 widgets/tables) — photo (initials only when none) · name over title *@
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Doctor"]</th><th>@T["Department"]</th><th>@T["Engagement"]</th><th>@T["Paid through"]</th><th>@T["Clinical privileges"]</th><th>@T["Licence expiry"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                var left = DaysLeft(p.Row);
                                var url = Url.Action("Practitioner", new { id = p.Row.ID });
                                <tr>
                                    <td class="ps-4"><div class="d-flex align-items-center min-w-0">
                                        <div class="symbol symbol-45px symbol-circle flex-shrink-0 me-4">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.Row.NameEn)" />} else {<span class="symbol-label fw-bold bg-light-primary text-primary">@HospitalUi.Initials(p.Row.NameEn)</span>}</div>
                                        <div class="d-flex flex-column min-w-0"><a href="@url" class="text-gray-900 text-hover-primary fs-6 fw-bold text-truncate">@DisplayName.Of(p.Row.Name, p.Row.NameEn)</a>
                                            <span class="text-muted fw-semibold d-block fs-7 text-truncate">@DisplayName.Of(p.Row.Title, p.Row.TitleEn)</span></div>
                                    </div></td>
                                    <td><span class="text-gray-800 fw-bold fs-6">@(p.Department == null ? "—" : DisplayName.Of(p.Department.Name, p.Department.NameEn))</span></td>
                                    <td><span class="badge @EngagementBadge(p.Row.Engagement) fs-7 fw-bold">@T["eng:" + p.Row.Engagement]</span></td>
                                    <td class="text-gray-600 fw-semibold fs-7">@T["pay:" + p.Row.PayChannel]</td>
                                    <td>@foreach (var pr in (p.Row.Privileges ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)) { <span class="badge badge-light fs-8 fw-semibold text-gray-700 me-1 mb-1">@T["priv:" + pr]</span> }</td>
                                    <td>@if (p.Row.LicenseExpiry is DateTime x) {<span class="text-gray-800 fw-bold fs-6 hp-num d-block" dir="ltr">@x.ToString("yyyy-MM-dd")</span>
                                        if (left < 0) {<span class="badge badge-light-danger fs-8 fw-bold">@T["Expired"]</span>}
                                        else if (left <= 60) {<span class="badge badge-light-danger fs-8 fw-bold">@T.GetString("Expires in {0} days", left!.Value)</span>} } else {<span class="text-muted">—</span>}</td>
                                    <td class="text-end pe-4"><a href="@url" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Profile"]" data-bs-toggle="tooltip"><i class="ki-outline ki-eye fs-3"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var b = document.getElementById('seedDepartments'); if (!b) return;
            b.addEventListener('click', function () {
                b.disabled = true;
                var fd = new FormData(); fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                fetch(@Json.Serialize(Url.Action("SeedDefaultDepartments")), { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); }).then(function (res) {
                        if (!res.ok) { b.disabled = false; if (window.toastr) toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); return; }
                        if (window.toastr) toastr.success(@Json.Serialize(T["Saved"].Value)); b.remove();
                    });
            });
        })();
    </script>
}
