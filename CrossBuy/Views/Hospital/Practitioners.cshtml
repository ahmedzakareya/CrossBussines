@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPractitionerView>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Practitioners"].Value;
    bool canManage = ViewBag.CanManage == true;
    var departments = (ViewBag.Departments as IReadOnlyList<HospitalDepartment>) ?? Array.Empty<HospitalDepartment>();
    DateTime today = ViewBag.Today;
    int? DaysLeft(HospitalPractitioner p) => p.LicenseExpiry is DateTime x ? (int)(x.Date - today).TotalDays : null;
    string EngagementBadge(string e) => e == HospitalEngagements.Visiting ? "badge-light-info" : e == HospitalEngagements.PartTime ? "badge-light-primary" : "hp-badge";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Practitioners"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Hospital"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Doctors & staff"]</li>
            </ul>
        </div>
        @if (canManage)
        {
            <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
                @if (departments.Count == 0)
                {
                    <button type="button" class="btn btn-sm btn-light-primary" id="seedDepartments"><i class="ki-outline ki-arrow-down fs-4"></i>@T["Load standard departments"]</button>
                }
                <a href="@Url.Action("NewPractitioner")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-4"></i>@T["Add doctor"]</a>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Permanent doctors"].Value, Model.Count(p => p.Row.Engagement == HospitalEngagements.Permanent), T["through payroll"].Value, "text-gray-900"),
                (T["Part-time"].Value, Model.Count(p => p.Row.Engagement == HospitalEngagements.PartTime), T["payroll, variable line"].Value, "text-gray-900"),
                (T["Visiting"].Value, Model.Count(p => p.Row.Engagement == HospitalEngagements.Visiting), T["through vendors & payables"].Value, "text-gray-900"),
                (T["Licences expiring in 60 days"].Value, Model.Count(p => DaysLeft(p.Row) is int d && d <= 60), T["Booking stops on expiry"].Value, Model.Any(p => DaysLeft(p.Row) is int d && d <= 60) ? "text-danger" : "text-gray-900") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div>
                    <div class="fs-2hx fw-bold @s.Item4 hp-num">@s.Item2</div>
                    <div class="text-muted fs-8 mt-1">@s.Item3</div>
                </div></div></div>
            }
        </div>

        <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice">
            <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label"><i class="ki-outline ki-people fs-2x text-white"></i></span></span>
            <div class="fw-semibold">
                <h4 class="text-gray-900 fw-bold mb-1">@T["One practitioner record, two ways to pay"]</h4>
                <div class="fs-6 text-gray-700">@T["Clinical data and privileges live in one record per doctor; permanent and part-time are paid through payroll, visiting doctors as vendors."]</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Practitioners"]</span></div></div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center text-muted py-15"><i class="ki-outline ki-people fs-3x text-gray-300 d-block mb-4"></i>@T["No practitioners yet. Add the first doctor."]</div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-4 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>@T["Doctor"]</th><th>@T["Department"]</th><th>@T["Engagement"]</th><th>@T["Paid through"]</th><th>@T["Clinical privileges"]</th><th>@T["Licence expiry"]</th><th class="text-end"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var p in Model)
                            {
                                var left = DaysLeft(p.Row);
                                var url = Url.Action("Practitioner", new { id = p.Row.ID });
                                <tr>
                                    <td><div class="d-flex align-items-center min-w-0">
                                        <div class="symbol symbol-40px symbol-circle flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.Row.NameEn)" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(p.Row.NameEn)</span>}</div>
                                        <div class="d-flex flex-column ms-3 min-w-0"><a href="@url" class="text-gray-900 text-hover-primary fs-6 fw-bold text-truncate">@DisplayName.Of(p.Row.Name, p.Row.NameEn)</a>
                                            <span class="text-muted fw-semibold fs-7 text-truncate">@DisplayName.Of(p.Row.Title, p.Row.TitleEn)</span></div>
                                    </div></td>
                                    <td>@(p.Department == null ? "—" : DisplayName.Of(p.Department.Name, p.Department.NameEn))</td>
                                    <td><span class="badge @EngagementBadge(p.Row.Engagement) fs-8">@T["eng:" + p.Row.Engagement]</span></td>
                                    <td class="fs-7">@T["pay:" + p.Row.PayChannel]</td>
                                    <td>@foreach (var pr in (p.Row.Privileges ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)) { <span class="hp-chip me-1 mb-1">@T["priv:" + pr]</span> }</td>
                                    <td>@if (p.Row.LicenseExpiry is DateTime x) {<span class="hp-num">@x.ToString("yyyy-MM-dd")</span>
                                        if (left < 0) {<div><span class="badge badge-light-danger fs-9">@T["Expired"]</span></div>}
                                        else if (left <= 60) {<div><span class="badge badge-light-danger fs-9">@T.GetString("Expires in {0} days", left!.Value)</span></div>} } else {<span class="text-muted">—</span>}</td>
                                    <td class="text-end"><a href="@url" class="btn btn-sm btn-light-primary">@T["Profile"]</a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var b = document.getElementById('seedDepartments'); if (!b) return;
            b.addEventListener('click', function () {
                b.disabled = true;
                var fd = new FormData(); fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                fetch(@Json.Serialize(Url.Action("SeedDefaultDepartments")), { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); }).then(function (res) {
                        if (!res.ok) { b.disabled = false; if (window.toastr) toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); return; }
                        if (window.toastr) toastr.success(@Json.Serialize(T["Saved"].Value)); b.remove();
                    });
            });
        })();
    </script>
}
