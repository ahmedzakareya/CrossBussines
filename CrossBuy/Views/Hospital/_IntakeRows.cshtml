@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalIntakeRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@foreach (var r in Model)
{
    var s = r.Intake; bool waiting = s.Status == HospitalIntakeStatus.Submitted; bool alarm = waiting && s.Urgent && s.AlertAckAt == null;
    @* H125: the theme's table widget cells — the ticket in a symbol, a name over its muted line, badges with weight *@
    <tr class="@(alarm ? "bg-light-danger" : "")">
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-45px me-3"><span class="symbol-label bg-light-@(alarm ? "danger" : waiting ? "primary" : "secondary") text-@(alarm ? "danger" : waiting ? "primary" : "gray-600") fw-bold fs-5 hp-num" dir="ltr">@s.TicketNo</span></div>
            <span class="text-muted fw-semibold fs-8 hp-num" dir="ltr">@s.IntakeNo</span></div></td>
        <td>@if (s.Name != null) {<span class="text-gray-900 fw-bold fs-6 d-block"><bdi>@s.Name</bdi></span><span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num" dir="ltr">@s.Phone</bdi>@if (s.BirthDate != null) {<text> · <span class="hp-num">@s.BirthDate.Value.ToString("yyyy-MM-dd")</span></text>}</span>}
            else {<span class="text-gray-500 fw-semibold fs-7">@T["Not given — sent to the desk"]</span>}
            @if (r.PatientName != null) {<span class="badge badge-light-primary fs-8 fw-bold mt-1"><i class="ki-outline ki-check fs-8 text-primary me-1"></i><bdi>@r.PatientName</bdi>&nbsp;<bdi class="hp-num" dir="ltr">@r.PatientMrn</bdi></span>}</td>
        <td><span class="text-gray-800 fw-bold fs-6 d-block">@T["ivt:" + s.VisitType]</span>@if (s.Reason != null) {<span class="text-muted fw-semibold d-block fs-7 text-truncate mw-250px"><bdi>@s.Reason</bdi></span>}</td>
        <td class="text-nowrap"><span class="badge badge-light-@(waiting && r.Minutes > 20 ? "danger" : "primary") fs-7 fw-bold">@T["{0} min", r.Minutes]</span></td>
        <td><div class="d-flex flex-wrap gap-1">@if (alarm) {<span class="badge badge-danger fs-7 fw-bold">@T["Danger signs"]</span>}
            else if (s.Urgent) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Danger signs — seen"]</span>}
            <span class="badge @(waiting ? "badge-light-primary" : s.Status == HospitalIntakeStatus.Linked || s.Status == HospitalIntakeStatus.NewFile ? "badge-light-primary" : "badge-light") fs-7 fw-bold">@T["ist:" + s.Status]</span></div>
            @if (s.RedFlags != null) {<div class="d-flex flex-wrap gap-1 mt-2">@foreach (var f in s.RedFlags.Split(',')) {<span class="badge badge-light-danger fs-8">@T["irf:" + f]</span>}</div>}</td>
        <td class="pe-4 text-end"><a href="@Url.Action("IntakeReview", new { id = s.ID })" class="btn btn-sm @(alarm ? "btn-danger" : "btn-light-primary") text-nowrap"><i class="ki-outline ki-eye fs-4"></i>@T["Open"]</a></td>
    </tr>
}
@* H114: the list's body is replaced by these rows, so an empty list must say so itself *@
@if (Model.Count == 0)
{
    <tr><td colspan="6" class="text-center py-10">
        <i class="ki-outline ki-tablet fs-3x text-gray-300 d-block mb-3"></i>
        <div class="fs-6 fw-semibold text-gray-700">@T["No intake waiting."]</div>
        <div class="fs-8 text-muted mt-1">@T["When a patient fills in the reception tablet, it appears here for the desk to confirm."]</div>
    </td></tr>
}
