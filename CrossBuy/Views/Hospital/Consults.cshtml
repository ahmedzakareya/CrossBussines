@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H77 — inpatient consultation requests: what was asked of my specialties (to accept and answer), what I asked, and all
    of them. Open ones first, the soonest due at the top; overdue in red. Searched, filtered and paged on the server.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Consultations"].Value;
    bool ready = ViewBag.Ready == true;
    string scope = ViewBag.Scope;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Consultations"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Inpatient"]</li></ul>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalConsultRequestService.NoTables]</div></div> }
        else
        {
            <div class="notice d-flex align-items-center rounded border border-primary border-dashed bg-light-primary p-5 mb-5">
                <i class="ki-outline ki-messages fs-2x text-primary me-4"></i>
                <div class="fs-7 text-gray-700">@T["A doctor asks another specialty from the nursing station. A doctor of that specialty — or the one named — accepts and answers. Emergency is due in 1 hour, urgent in 4, routine in 24."]</div>
            </div>
            <div class="card">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0">
                        <ul class="nav nav-stretch nav-line-tabs fs-6 border-0 fw-bold" id="scopeTabs">
                            @foreach (var (k, label) in new[] { ("mine", "Asked of me"), ("asked", "Asked by me"), ("all", "All") })
                            { <li class="nav-item"><a class="nav-link text-active-primary @(scope == k ? "active" : "")" href="#" data-scope="@k">@T[label]</a></li> }
                        </ul>
                        <span class="text-muted fs-7 mt-2"><span id="resultCount">—</span></span>
                    </div>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by number, patient or file…"]" /></div>
                        <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_status">
                            <option value="open">@T["Still open"]</option><option value="">@T["All states"]</option>
                            @foreach (var st in HospitalConsultRequestStatus.All) { <option value="@st">@T["crs:" + st]</option> }
                        </select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-5 mb-0">
                        <thead><tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th class="min-w-100px">@T["Request"]</th><th class="min-w-175px">@T["Patient"]</th><th class="min-w-150px">@T["Specialty"]</th><th class="min-w-250px">@T["Question"]</th><th class="min-w-100px">@T["Answer due"]</th><th class="min-w-100px">@T["State"]</th><th class="text-end min-w-100px">@T["Actions"]</th></tr></thead>
                        <tbody id="rows" class="text-gray-600 fw-semibold"><tr id="loadingRow"><td colspan="7" class="text-center text-muted py-10">@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="7" class="text-center text-muted py-10">@T["No consultation here."]</td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>

<div class="modal fade" id="answerModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
    <div class="modal-header"><div><h2 class="fw-bold m-0">@T["Answer the consultation"]</h2><div class="text-muted fs-7 mt-1" data-a-who></div></div><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10"><div class="row g-4">
        <div class="col-12"><div class="bg-light rounded p-4 fs-7"><div class="text-muted fs-8 mb-1">@T["Question"]</div><div data-a-q class="text-gray-800" style="white-space:pre-wrap"></div></div></div>
        <div class="col-12"><label class="form-label">@T["Findings"]</label><textarea class="form-control form-control-solid" rows="3" maxlength="2000" data-a="findings" placeholder="@T["What you found on examination and in the results"]"></textarea></div>
        <div class="col-12"><label class="form-label required">@T["Recommendations"]</label><textarea class="form-control form-control-solid" rows="4" maxlength="2000" data-a="recommendations" placeholder="@T["What the team should do"]"></textarea></div>
        <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-a="followUp" /><span class="form-check-label">@T["I will keep following the patient"]</span></label></div>
    </div></div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-a-save>@T["Send the answer"]</button></div>
</div></div></div>

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            var scope = @Json.Serialize(scope);
            var list = cbServerList({ url: @Json.Serialize(Url.Action("ConsultsData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('scope', scope); p.set('status', document.getElementById('f_status').value); } });
            document.querySelectorAll('[data-scope]').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); scope = a.getAttribute('data-scope');
                document.querySelectorAll('[data-scope]').forEach(function (x) { x.classList.toggle('active', x === a); }); list.reload(); }); });
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, mEl = document.getElementById('answerModal'), answering = null;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                accept: @Json.Serialize(T["Accept this consultation? The team will see that you are on it."].Value), answer: @Json.Serialize(T["Send this answer to the team?"].Value),
                cancel: @Json.Serialize(T["Cancel this consultation request"].Value), cancelWhy: @Json.Serialize(T["Why it is cancelled"].Value) };
            var base = @Json.Serialize(Url.Content("~/Hospital/Consults/"));
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(res) { if (!res.ok) { toastr.error(res.error || W.failed); return false; } toastr.success(W.saved); list.reload(); return true; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-accept],[data-answer],[data-cancel-cr],[data-a-save]'); if (!t) return;
                if (t.tagName === 'A') e.preventDefault();
                if (t.hasAttribute('data-accept')) { cbConfirm(W.accept).then(function (ok) { if (ok) post(base + t.getAttribute('data-accept') + '/Accept').then(done); }); return; }
                if (t.hasAttribute('data-cancel-cr')) { cbPrompt(t.getAttribute('data-what') || '', { title: W.cancel, placeholder: W.cancelWhy, kind: 'danger' }).then(function (why) { if (why) post(base + t.getAttribute('data-cancel-cr') + '/Cancel', { reason: why }).then(done); }); return; }
                if (t.hasAttribute('data-answer')) {
                    answering = t.getAttribute('data-answer');
                    mEl.querySelector('[data-a-who]').textContent = t.getAttribute('data-what') || '';
                    mEl.querySelector('[data-a-q]').textContent = t.getAttribute('data-question') || '';
                    mEl.querySelectorAll('[data-a]').forEach(function (i) { if (i.type === 'checkbox') i.checked = false; else i.value = ''; });
                    bootstrap.Modal.getOrCreateInstance(mEl).show(); return;
                }
                var body = {}; mEl.querySelectorAll('[data-a]').forEach(function (i) { body[i.getAttribute('data-a')] = i.type === 'checkbox' ? i.checked : (i.value.trim() || null); });
                cbConfirm(W.answer).then(function (ok) { if (!ok) return; t.disabled = true;
                    post(base + answering + '/Answer', body).then(function (res) { t.disabled = false; if (done(res)) bootstrap.Modal.getOrCreateInstance(mEl).hide(); }); });
            });
        })();
    </script>
}
