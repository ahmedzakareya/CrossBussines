@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalFormularyStats
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H133: the drug master (formulary). The page has three parts:
      · the figures, as demo39 stat tiles; each opens the list already filtered;
      · the medicines, in the theme's table widget, searched, filtered and paged by cbServerList;
      · the pharmacist's editor, in the theme's modal, every list a select2.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Drug formulary"].Value;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    bool canEdit = ViewBag.CanPharmacy == true;
    int undescribed = Model.Medicines - Model.Described;
    var tiles = new (string Label, int N, string Note, string Icon, string Tone, string? Filter)[] {
        (T["Medicines"].Value, Model.Medicines, string.Format(T["{0} described"].Value, Model.Described), "ki-capsule", "primary", null),
        (T["Not described yet"].Value, undescribed, T["no generic name behind the brand"].Value, "ki-question-2", undescribed > 0 ? "danger" : "primary", HospitalFormularyFilter.Undescribed),
        (T["Incomplete records"].Value, Model.Incomplete, T["strength, form, route or ATC missing"].Value, "ki-notepad-edit", Model.Incomplete > 0 ? "danger" : "primary", HospitalFormularyFilter.Incomplete),
        (T["High-alert medicines"].Value, Model.HighAlert, T["a second check before they leave"].Value, "ki-shield-cross", "danger", HospitalFormularyFilter.HighAlert),
        (T["Controlled drugs"].Value, Model.Controlled, T["narcotics and psychotropics"].Value, "ki-lock-2", "dark", HospitalFormularyFilter.Controlled),
        (T["Off the list or restricted"].Value, Model.Restricted + Model.OffList, string.Format(T["{0} restricted"].Value, Model.Restricted), "ki-cross-square", "info", HospitalFormularyStatus.Restricted) };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Drug formulary"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Pharmacy")" class="text-muted text-hover-primary">@T["Pharmacy"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Generic name, strength, form, route, ATC and safety flags of every medicine"]</li>
            </ul>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <a href="@Url.Action("Pharmacy")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-capsule fs-4"></i>@T["Dispensing queue"]</a>
            <a href="@Url.Action("PharmacyStock")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-package fs-4"></i>@T["Pharmacy stock"]</a>
            <a href="@Url.Action("DrugSafety")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Drug interactions & doses"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in tiles)
            {
                <div class="col-sm-6 col-xl-4 col-xxl-2">
                    <a href="@Url.Action("Formulary")@(s.Filter != null ? "#" + s.Filter : "")" class="card card-flush h-100 hover-elevate-up" data-tile-filter="@s.Filter">
                        <div class="card-body d-flex flex-column justify-content-between pt-6 pb-0 px-6">
                            <div class="symbol symbol-45px mb-5"><span class="symbol-label bg-light-@s.Tone"><i class="ki-outline @s.Icon fs-2x text-@s.Tone"></i></span></div>
                            <div class="d-flex flex-column">
                                <span class="fs-2hx fw-bold text-@(s.Tone == "danger" && s.N > 0 ? "danger" : "gray-900") lh-1 ls-n2 hp-num">@s.N</span>
                                <span class="text-gray-500 pt-2 fw-semibold fs-6">@s.Label</span>
                            </div>
                        </div>
                        <div class="card-body d-flex align-items-end pt-3 pb-6 px-6">
                            <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500"><div class="bullet w-8px h-6px rounded-2 bg-@s.Tone me-3 flex-shrink-0"></div><span>@s.Note</span></div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <div class="card card-flush">
            <div class="card-header align-items-center pt-5 gap-2 gap-md-5 border-0">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Medicines"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                    <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by name, generic or ATC…"]" /></div>
                    <div class="w-200px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_filter">
                        <option value="">@T["All"]</option>
                        <option value="@HospitalFormularyFilter.Undescribed">@T["Not described yet"]</option>
                        <option value="@HospitalFormularyFilter.Incomplete">@T["Incomplete records"]</option>
                        @foreach (var st in HospitalFormularyStatus.All) { <option value="@st">@T["fstat:" + st]</option> }
                        <option value="@HospitalFormularyFilter.HighAlert">@T["High-alert"]</option>
                        <option value="@HospitalFormularyFilter.Lasa">@T["Look-alike / sound-alike"]</option>
                        <option value="@HospitalFormularyFilter.Controlled">@T["Controlled drugs"]</option>
                        <option value="@HospitalFormularyFilter.Hazardous">@T["Hazardous / cytotoxic"]</option>
                        <option value="@HospitalFormularyFilter.ColdChain">@T["Cold chain"]</option>
                    </select></div>
                    <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                    <button type="button" id="f_reset" class="btn btn-sm btn-icon btn-light btn-active-light-primary" title="@T["Reset"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrows-circle fs-3"></i></button>
                </div>
            </div>
            <div class="card-body pt-2">
                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                    <thead><tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-200px rounded-start">@T["Medicine"]</th><th>@T["Strength, form and routes"]</th><th>ATC</th>
                        <th>@T["Formulary status"]</th><th>@T["Safety flags"]</th><th class="text-end pe-4 rounded-end"></th>
                    </tr></thead>
                    <tbody id="rows"><tr id="loadingRow"><td colspan="6" class="text-center text-muted py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>@T["Loading…"]</td></tr>
                        <tr id="emptyRow" class="d-none"><td colspan="6" class="text-center py-12"><i class="ki-outline ki-capsule fs-3x text-gray-300 mb-4 d-block"></i><span class="fs-6 fw-semibold text-gray-600">@T["Nothing matches."]</span></td></tr></tbody>
                </table></div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>

@if (canEdit)
{
    <div class="modal fade" id="drugModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-900px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-2">@T["Drug record"]</h1><div class="text-muted fw-semibold fs-5"><bdi data-title></bdi></div></div>
            <div class="row g-6">
                @* who it is *@
                <div class="col-12"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-capsule fs-3 text-primary"></i></span></div>
                    <div class="d-flex flex-column"><span class="fw-bold fs-6 text-gray-800">@T["The active ingredient"]</span><span class="text-muted fw-semibold fs-7">@T["What the brand contains; allergies and interactions are matched on it too."]</span></div></div></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2 required">@T["Generic name (Arabic)"]</label><input class="form-control form-control-solid" dir="auto" maxlength="150" data-m="genericName" /></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Generic name (English)"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="150" data-m="genericNameEn" placeholder="amoxicillin" /></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Tall Man spelling"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="150" data-m="tallMan" placeholder="hydrALAZINE" /></div>
                <div class="col-6 col-md-2"><label class="fs-6 fw-semibold mb-2">@T["Strength"]</label><input type="number" step="0.0001" min="0" class="form-control form-control-solid hp-num" data-m="strength" /></div>
                <div class="col-6 col-md-2"><label class="fs-6 fw-semibold mb-2">@T["Unit"]</label><select class="form-select form-select-solid" data-m="strengthUnit" data-hide-search="true"><option value="">—</option>@foreach (var u in HospitalStrengthUnit.All) { <option value="@u">@u</option> }</select></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Dosage form"]</label><select class="form-select form-select-solid" data-m="form"><option value="">—</option>@foreach (var f in HospitalDrugForm.All) { <option value="@f">@T["form:" + f]</option> }</select></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["VEN class"]</label><select class="form-select form-select-solid" data-m="ven" data-hide-search="true"><option value="">—</option>@foreach (var v in HospitalVen.All) { <option value="@v">@T["ven:" + v]</option> }</select></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Routes"]</label><select class="form-select form-select-solid" multiple data-m="routes" data-placeholder="@T["Choose the routes"]">@foreach (var r in HospitalDrugRoute.All) { <option value="@r">@T["route:" + r]</option> }</select></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["ATC code"]</label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="10" data-m="atc" placeholder="J01CA04" /></div>
                <div class="col-md-8"><label class="fs-6 fw-semibold mb-2">@T["Therapeutic class"]</label><input class="form-control form-control-solid" dir="auto" maxlength="120" data-m="therapeuticClass" /></div>

                @* on the list or not *@
                <div class="col-12"><div class="separator separator-dashed mb-5"></div><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3"><span class="symbol-label bg-light-info"><i class="ki-outline ki-book-open fs-3 text-info"></i></span></div>
                    <div class="d-flex flex-column"><span class="fw-bold fs-6 text-gray-800">@T["Formulary status"]</span><span class="text-muted fw-semibold fs-7">@T["A medicine marked unavailable is refused at dispensing."]</span></div></div></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2 required">@T["Status"]</label><select class="form-select form-select-solid" data-m="formularyStatus" data-hide-search="true">@foreach (var st in HospitalFormularyStatus.All) { <option value="@st">@T["fstat:" + st]</option> }</select></div>
                <div class="col-md-8"><label class="fs-6 fw-semibold mb-2">@T["Who may prescribe it, or why it is off the list"]</label><input class="form-control form-control-solid" dir="auto" maxlength="300" data-m="restrictionNote" /></div>

                @* what to watch *@
                <div class="col-12"><div class="separator separator-dashed mb-5"></div><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-shield-cross fs-3 text-danger"></i></span></div>
                    <div class="d-flex flex-column"><span class="fw-bold fs-6 text-gray-800">@T["Safety"]</span><span class="text-muted fw-semibold fs-7">@T["Shown on the dispense review beside the medicine's name."]</span></div></div></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Controlled schedule"]</label><select class="form-select form-select-solid" data-m="controlledSchedule" data-hide-search="true"><option value="">@T["Not controlled"]</option>@foreach (var c in HospitalControlledSchedule.All) { <option value="@c">@T["sched:" + c]</option> }</select></div>
                <div class="col-md-8"><label class="fs-6 fw-semibold mb-2">@T["Confused with (look-alike / sound-alike)"]</label><input class="form-control form-control-solid" dir="auto" maxlength="200" data-m="lasaWith" placeholder="hydrOXYzine" /></div>
                <div class="col-md-4"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-m="highAlert" /><span class="form-check-label fw-semibold text-gray-700">@T["High-alert medicine"]</span></label></div>
                <div class="col-md-4"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-m="hazardous" /><span class="form-check-label fw-semibold text-gray-700">@T["Hazardous / cytotoxic"]</span></label></div>
                <div class="col-md-4"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-m="coldChain" /><span class="form-check-label fw-semibold text-gray-700">@T["Cold chain (2–8 °C)"]</span></label></div>
                @* H234: pregnancy and breastfeeding; H235: antimicrobial stewardship *@
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["In pregnancy"]</label><select class="form-select form-select-solid" data-m="pregnancyRisk" data-hide-search="true"><option value="">@T["No concern recorded"]</option>@foreach (var r in HospitalDrugRisk.All) { <option value="@r">@T["risk:" + r]</option> }</select></div>
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["In breastfeeding"]</label><select class="form-select form-select-solid" data-m="lactationRisk" data-hide-search="true"><option value="">@T["No concern recorded"]</option>@foreach (var r in HospitalDrugRisk.All) { <option value="@r">@T["risk:" + r]</option> }</select></div>
                <div class="col-md-4 d-flex align-items-end"><label class="form-check form-switch form-check-custom form-check-solid mb-3"><input class="form-check-input" type="checkbox" data-m="isAntimicrobial" /><span class="form-check-label fw-semibold text-gray-700">@T["Antimicrobial (stewardship)"]</span></label></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-drug-save><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            // a figure opens its list already filtered (#undescribed, #high-alert…): the filter is set before the first load
            var f = document.getElementById('f_filter');
            function fromHash() { var h = decodeURIComponent((location.hash || '').replace('#', ''));
                if (!h || !Array.prototype.some.call(f.options, function (o) { return o.value === h; })) return false;
                f.value = h; if (window.jQuery) jQuery(f).trigger('change.select2'); return true; }
            fromHash();
            var list = cbServerList({ url: @Json.Serialize(Url.Action("FormularyData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('filter', f.value); } });
            // a figure clicked on this page only changes the hash: the browser does not reload, so the list does
            window.addEventListener('hashchange', function () { if (fromHash()) list.reload(); });

            var mEl = document.getElementById('drugModal'); if (!mEl) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, editing = null;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), ask: @Json.Serialize(T["Save this medicine's record?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function fill(d) {
                mEl.querySelectorAll('[data-m]').forEach(function (i) {
                    var v = d[i.getAttribute('data-m')];
                    if (i.type === 'checkbox') i.checked = !!v;
                    else if (i.multiple) Array.prototype.forEach.call(i.options, function (o) { o.selected = (v || []).indexOf(o.value) >= 0; });
                    else i.value = v == null ? (i.tagName === 'SELECT' ? i.options[0].value : '') : v;
                    if (i.tagName === 'SELECT' && window.jQuery) jQuery(i).trigger('change.select2');   // the theme's dropdown shows the value set
                });
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-drug-edit],[data-drug-save]'); if (!t) return;
                if (t.hasAttribute('data-drug-save')) {
                    var body = { itemId: editing };
                    mEl.querySelectorAll('[data-m]').forEach(function (i) { var k = i.getAttribute('data-m');
                        body[k] = i.type === 'checkbox' ? i.checked : i.multiple ? Array.prototype.filter.call(i.options, function (o) { return o.selected; }).map(function (o) { return o.value; })
                            : i.type === 'number' ? (i.value === '' ? null : Number(i.value)) : (i.value.trim() || null); });
                    cbConfirm(W.ask).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("FormularySave")), body).then(function (res) { t.disabled = false;
                            if (!res.ok) { toastr.error(res.error || W.failed); return; }
                            toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(mEl).hide(); list.reload(); }); });
                    return;
                }
                var d = JSON.parse(t.getAttribute('data-row')); editing = d.itemId;
                mEl.querySelector('[data-title]').textContent = d.title;
                fill(d);
                bootstrap.Modal.getOrCreateInstance(mEl).show();
            });
        })();
    </script>
}
