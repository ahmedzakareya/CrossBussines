@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H88 — the chemotherapy regimen library (searched, paged): each regimen's drugs with dose, basis, route, days and
    lifetime limit. The hospital enters its own protocols; a regimen in use is changed only under a new code.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Chemotherapy regimens"].Value;
    bool ready = ViewBag.Ready == true, canLib = ViewBag.CanLibrary == true;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Chemotherapy regimens"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("Oncology")" class="text-muted text-hover-primary">@T["Oncology"]</a></li></ul>
        </div>
        @if (ready && canLib) {<button type="button" class="btn btn-sm btn-primary" data-reg-new><i class="ki-outline ki-plus fs-4"></i>@T["New regimen"]</button>}
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalOncologyService.NoTables]</div></div> }
        else
        {
            <div class="notice d-flex rounded border border-dashed p-4 mb-5 hp-notice fs-7 text-gray-700">@T["The library ships empty: the oncologists and the pharmacy enter the hospital's own protocols, and each dose is computed from them."]</div>
            <div class="card">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Regimens"]</span><span class="text-muted fs-7 mt-1"><span id="resultCount">—</span></span></div>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by code, name or drug…"]" /></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-8 text-uppercase gs-0"><th>@T["Regimen"]</th><th>@T["Cycle"]</th><th class="min-w-300px">@T["Drugs"]</th><th>@T["Courses on it"]</th><th class="text-end"></th></tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="5" class="text-center text-muted py-10">@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="5" class="text-center text-muted py-10">@T["No regimen yet."]</td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
            @* H120: the pharmacy's stock for each drug — a cycle given sends its drugs to the pharmacy, prepared from these *@
            @if (ViewBag.DrugLinksReady == true)
            {
                var dlinks = (ViewBag.DrugLinks as IReadOnlyList<HospitalChemoDrugLinkRow>) ?? Array.Empty<HospitalChemoDrugLinkRow>();
                var meds = (ViewBag.Medicines as IReadOnlyList<(int Id, string Code, string Name, string NameEn, decimal? Price)>) ?? Array.Empty<(int, string, string, string, decimal?)>();
                bool canPh = ViewBag.CanPharmacy == true;
                <div class="card mt-5">
                    <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                        <span class="card-label fw-bold text-gray-900 fs-4"><i class="ki-outline ki-capsule fs-3 text-primary me-1"></i>@T["Pharmacy stock for each drug"]</span>
                        <span class="text-muted fs-7 mt-1">@T["A cycle given sends its drugs to the pharmacy: each is prepared from the item linked here, in whole units — a vial is never shared between patients."]</span></div></div>
                    <div class="card-body pt-2">
                        @if (dlinks.Count == 0) { <div class="text-center text-muted py-8">@T["No regimen names a drug yet."]</div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                                <thead><tr class="text-start text-gray-500 fw-bold fs-8 text-uppercase gs-0"><th>@T["Drug"]</th><th>@T["Regimens"]</th><th class="min-w-250px">@T["Stock item"]</th><th class="w-125px">@T["mg per unit"]</th><th class="text-end"></th></tr></thead>
                                <tbody>
                                @foreach (var d in dlinks)
                                {
                                    <tr data-dl="@d.DrugName">
                                        <td><bdi dir="ltr" class="fw-bold text-gray-900">@d.DrugName</bdi>@if (d.Link == null) {<div><span class="badge badge-light-danger fs-9 mt-1">@T["Not linked"]</span></div>}</td>
                                        <td class="hp-num">@d.Regimens</td>
                                        <td>@if (canPh)
                                            {
                                                <select class="form-select form-select-sm form-select-solid" data-dl-item data-control="select2" data-placeholder="@T["Choose the stock item"]">
                                                    <option value="">@T["Not linked"]</option>
                                                    @foreach (var m in meds) {<option value="@m.Id" selected="@(d.Link?.ItemId == m.Id)">@m.Code — @DisplayName.Of(m.Name, m.NameEn)</option>}
                                                </select>
                                            }
                                            else {<span>@(d.ItemName == null ? "—" : d.ItemCode + " — " + d.ItemName)</span>}</td>
                                        <td>@if (canPh) {<input type="number" min="0" step="any" class="form-control form-control-sm form-control-solid" dir="ltr" data-dl-mg value="@(d.Link?.MgPerUnit.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" placeholder="50" />}
                                            else {<span class="hp-num">@(d.Link?.MgPerUnit.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</span>}</td>
                                        <td class="text-end">@if (canPh) {<button type="button" class="btn btn-sm btn-light-primary" data-dl-save><i class="ki-outline ki-check fs-5"></i>@T["Save"]</button>}</td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>
            }
        }
    </div></div>
</div>

@if (ready && canLib)
{
    <div class="modal fade" id="regModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-900px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0" id="regTitle">@T["New regimen"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-3"><label class="form-label required">@T["Code"]</label><input type="text" maxlength="30" class="form-control form-control-solid" dir="ltr" data-r="code" placeholder="AC" /></div>
            <div class="col-5"><label class="form-label required">@T["Name"]</label><input type="text" maxlength="150" class="form-control form-control-solid" data-r="name" /></div>
            <div class="col-4"><label class="form-label">@T["Name in English"]</label><input type="text" maxlength="150" class="form-control form-control-solid" dir="ltr" data-r="nameEn" /></div>
            <div class="col-3"><label class="form-label required">@T["Days per cycle"]</label><input type="number" min="7" max="56" class="form-control form-control-solid" dir="ltr" data-r="cycleDays" value="21" /></div>
            <div class="col-3"><label class="form-label required">@T["Chemo cycles"]</label><input type="number" min="1" max="52" class="form-control form-control-solid" dir="ltr" data-r="maxCycles" value="6" /></div>
            <div class="col-6 d-flex align-items-end"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-r="isActive" checked /><span class="form-check-label">@T["In the library"]</span></label></div>
            <div class="col-12">
                <div class="d-flex flex-stack mb-2"><label class="form-label required m-0">@T["Drugs"]</label><button type="button" class="btn btn-sm btn-light-primary" data-drug-add><i class="ki-outline ki-plus fs-5"></i>@T["Add a drug"]</button></div>
                <table class="table table-row-dashed align-middle fs-7 gy-2 mb-0"><thead><tr class="text-gray-500 fw-bold fs-8"><th>@T["Drug"]</th><th class="w-90px">@T["Dose"]</th><th class="w-125px">@T["Basis"]</th><th class="w-90px">@T["Route"]</th><th class="w-100px">@T["Days of the cycle"]</th><th class="w-110px">@T["Lifetime limit (mg/m²)"]</th><th class="w-40px"></th></tr></thead>
                    <tbody id="drugRows"></tbody></table>
                <template id="drugTpl"><tr>
                    <td><input type="text" maxlength="100" class="form-control form-control-sm form-control-solid" dir="ltr" data-d="drugName" /></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm form-control-solid" dir="ltr" data-d="dose" /></td>
                    <td><select class="form-select form-select-sm form-select-solid" data-d="basis" data-control="none">@foreach (var b in HospitalChemoBasis.All) {<option value="@b">@T["cbs:" + b]</option>}</select></td>
                    <td><select class="form-select form-select-sm form-select-solid" data-d="route" data-control="none">@foreach (var r in HospitalChemoRoute.All) {<option value="@r">@r</option>}</select></td>
                    <td><input type="text" maxlength="30" class="form-control form-control-sm form-control-solid" dir="ltr" data-d="days" value="1" /></td>
                    <td><input type="number" step="1" class="form-control form-control-sm form-control-solid" dir="ltr" data-d="lifetimeMgM2" /></td>
                    <td><button type="button" class="btn btn-icon btn-sm btn-light-danger" data-drug-del title="@T["Remove"]"><i class="ki-outline ki-trash fs-5"></i></button></td>
                </tr></template>
            </div>
            <div class="col-12"><label class="form-label">@T["Note"]</label><textarea rows="2" maxlength="500" class="form-control form-control-solid" data-r="note" placeholder="@T["Premedication, hydration, reference…"]"></textarea></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-reg-save>@T["Save"]</button></div>
    </div></div></div>
}

@section Scripts {
    <script>
        // H120: a drug's pharmacy stock link, saved row by row
        (function () {
            var WL = { ask: @Json.Serialize(T["Save this drug's pharmacy stock link?"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            document.addEventListener('click', function (e) {
                var b = e.target.closest('[data-dl-save]'); if (!b) return;
                var row = b.closest('[data-dl]'), item = row.querySelector('[data-dl-item]').value, mg = row.querySelector('[data-dl-mg]').value;
                cbConfirm(WL.ask).then(function (ok) { if (!ok) return; b.disabled = true;
                    var tok = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value;
                    fetch(@Json.Serialize(Url.Action("ChemoDrugLink")), { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok },
                        body: JSON.stringify({ drug: row.getAttribute('data-dl'), itemId: item ? +item : null, mgPerUnit: mg === '' ? null : Number(mg) }) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { b.disabled = false; if (!res.ok) { toastr.error(res.error || WL.failed); return; } toastr.success(WL.saved); location.reload(); });
                });
            });
        })();
        (function () {
            if (!document.getElementById('rows')) return;
            var list = cbServerList({ url: @Json.Serialize(Url.Action("ChemoRegimensData")), isAr: @(isAr ? "true" : "false") });
            var mEl = document.getElementById('regModal'); if (!mEl) return;
            var tok = document.querySelector('input[name="__RequestVerificationToken"]').value, body = document.getElementById('drugRows'), tpl = document.getElementById('drugTpl'), regId = 0;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), ask: @Json.Serialize(T["Save this regimen?"].Value),
                      newT: @Json.Serialize(T["New regimen"].Value), editT: @Json.Serialize(T["Change the regimen"].Value) };
            function addRow(d) { var tr = tpl.content.firstElementChild.cloneNode(true); body.appendChild(tr);
                if (d) Object.keys(d).forEach(function (k) { var i = tr.querySelector('[data-d="' + k + '"]'); if (i && d[k] != null) i.value = d[k]; }); }
            function open(data) { regId = data ? data.id : 0; document.getElementById('regTitle').textContent = data ? W.editT : W.newT; body.innerHTML = '';
                mEl.querySelectorAll('[data-r]').forEach(function (i) { var k = i.getAttribute('data-r'); if (i.type === 'checkbox') i.checked = data ? !!data[k] : true; else i.value = data && data[k] != null ? data[k] : (k === 'cycleDays' ? 21 : k === 'maxCycles' ? 6 : ''); });
                (data ? data.drugs : [null]).forEach(addRow); bootstrap.Modal.getOrCreateInstance(mEl).show(); }
            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-reg-new]')) { open(null); return; }
                var ed = e.target.closest('[data-reg-edit]'); if (ed) { open(JSON.parse(ed.getAttribute('data-reg-edit'))); return; }
                if (e.target.closest('[data-drug-add]')) { addRow(null); return; }
                var del = e.target.closest('[data-drug-del]'); if (del) { del.closest('tr').remove(); return; }
                var s = e.target.closest('[data-reg-save]'); if (!s) return;
                var b = { id: regId, drugs: [] };
                mEl.querySelectorAll('[data-r]').forEach(function (i) { var k = i.getAttribute('data-r'); b[k] = i.type === 'checkbox' ? i.checked : (i.type === 'number' ? Number(i.value || 0) : ((i.value || '').trim() || null)); });
                body.querySelectorAll('tr').forEach(function (tr) { var d = {}; tr.querySelectorAll('[data-d]').forEach(function (i) { var k = i.getAttribute('data-d'), v = (i.value || '').trim();
                    d[k] = k === 'dose' ? Number(v || 0) : (k === 'lifetimeMgM2' ? (v === '' ? null : Number(v)) : (v || null)); }); b.drugs.push(d); });
                cbConfirm(W.ask).then(function (ok) { if (!ok) return; s.disabled = true;
                    fetch(@Json.Serialize(Url.Action("SaveChemoRegimen")), { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { s.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(mEl).hide(); list.reload(); }); });
            });
        })();
    </script>
}
