@using CrossBuy.BL
@using CrossBuy.Models.Context.Hospital
@model HospitalPatient?
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    bool isNew = Model == null;
    var p = Model ?? new HospitalPatient();   // H272: a new patient has no nationality chosen for him
    var title = isNew ? T["Register a new patient"].Value : T["Edit patient file"].Value;
    ViewData["Title"] = title;
    var countries = (ViewBag.Countries as List<(int Id, string Label)>) ?? new();
    string? mrn = isNew ? ViewBag.NextMrn as string : p.Mrn;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@title</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Patients")" class="text-muted text-hover-primary">@T["Patients"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@(isNew ? T["Register"] : T["Edit"])</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@(isNew ? Url.Action("Patients") : Url.Action("Patient", new { id = p.ID }))" class="btn btn-sm btn-light">@T["Cancel"]</a>
            <button type="button" class="btn btn-sm btn-primary" id="patientSave"><i class="ki-outline ki-check fs-4"></i>@(isNew ? T["Save and open file"] : T["Save"])</button>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <form id="patientForm" autocomplete="off">
            <input type="hidden" name="id" value="@(isNew ? "" : p.ID.ToString())" />
            @* H272: the photo and the number on top, the same head as the registration window (_PatientPhotoHead) *@
            <div class="card card-flush mb-5"><div class="card-body py-6 bg-light rounded">
                @await Html.PartialAsync("_PatientPhotoHead", (mrn, p.PhotoPath, (isNew ? T["Generated by the system when the file is saved; the number shown is the next one."] : T["The record number never changes."]).Value))
            </div></div>
            <div class="row g-5 g-xl-8">
                <div class="col-xl-8">
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Patient details"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Every name is captured in Arabic and English"]</span></h3></div>
                        <div class="card-body pt-2"><div class="row g-6">
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2 required">@T["Name (Arabic)"]</label><input name="name" value="@p.Name" class="form-control form-control-solid" dir="rtl" maxlength="200" data-similar placeholder="@T["Full name"]" /></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2 required">@T["Name (English)"]</label><input name="nameEn" value="@p.NameEn" class="form-control form-control-solid" dir="ltr" maxlength="200" data-similar placeholder="Full name" /></div>
                            <div class="col-md-3"><label class="fs-6 fw-semibold mb-2">@T["ID number"]</label><input name="nationalId" value="@p.NationalId" class="form-control form-control-solid hp-num" dir="ltr" inputmode="numeric" maxlength="20" data-similar /><div class="text-muted fs-8 mt-1">@T["One file per ID number"]</div></div>
                            <div class="col-md-3"><label class="fs-6 fw-semibold mb-2">@T["Date of birth"]</label><input name="birthDate" type="date" value="@p.BirthDate?.ToString("yyyy-MM-dd")" class="form-control form-control-solid" /></div>
                            <div class="col-md-3"><label class="fs-6 fw-semibold mb-2 required">@T["Sex"]</label>
                                <select name="sex" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                                    <option value="M" selected="@(p.Sex == HospitalPatientSex.Male)">@T["sex:M"]</option>
                                    <option value="F" selected="@(p.Sex == HospitalPatientSex.Female)">@T["sex:F"]</option>
                                </select></div>
                            <div class="col-md-3"><label class="fs-6 fw-semibold mb-2">@T["Mobile"]</label><input name="phone" value="@p.Phone" class="form-control form-control-solid hp-num" dir="ltr" maxlength="20" data-similar placeholder="+20 1xx xxx xxxx" /></div>
                            @* nationality and blood group share their own full row (owner) *@
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Nationality"]</label>
                                <select name="nationalityId" class="form-select form-select-solid" data-control="select2" data-placeholder="@T["Choose the nationality"]">
                                    <option value="">@T["Choose the nationality"]</option>
                                    @foreach (var c in countries) { <option value="@c.Id" selected="@(c.Id == p.NationalityId)">@c.Label</option> }
                                </select>
                                <div class="text-muted fs-8 mt-1">@T["From the system country table"]</div></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Blood group"]</label>
                                <select name="bloodGroup" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                                    <option value="">—</option>
                                    @foreach (var g in HospitalBloodGroups.All) { <option value="@g" selected="@(g == p.BloodGroup)">@g</option> }
                                </select></div>
                        </div></div>
                    </div>

                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Medical details"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["An allergy shows as a red alert on the file"]</span></h3></div>
                        <div class="card-body pt-2"><div class="row g-6">
                            <div class="col-12">@await Html.PartialAsync("_AllergyPicker", ((ViewBag.AllergyItems as List<CrossBuy.BL.Hospital.HospitalAllergyItem>) ?? new(), false))</div>@* H270: the coded allergy list *@
                            @if (ViewBag.CanClinical != false)
                            {
                                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Chronic conditions"]</label><textarea name="chronicConditions" rows="3" maxlength="1000" class="form-control form-control-solid" placeholder="@T["One per line"]">@p.ChronicConditions</textarea></div>
                            }
                        </div></div>
                    </div>

                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Emergency contact"]</span></h3></div>
                        <div class="card-body pt-2">
                            <div class="row g-6">
                                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Name"]</label><input name="emergencyName" value="@p.EmergencyName" maxlength="200" class="form-control form-control-solid" /></div>
                                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Relationship"]</label><input name="emergencyRelation" value="@p.EmergencyRelation" maxlength="60" class="form-control form-control-solid" /></div>
                                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Mobile"]</label><input name="emergencyPhone" value="@p.EmergencyPhone" maxlength="20" class="form-control form-control-solid hp-num" dir="ltr" /></div>
                            </div>
                            <label class="form-check form-check-custom form-check-solid mt-6"><input class="form-check-input" type="checkbox" name="consentSigned" value="true" @(p.ConsentSigned || isNew ? "checked" : "") /><span class="form-check-label fw-semibold text-gray-700">@T["The patient signed the general consent to treatment and the privacy notice"]</span></label>
                        </div>
                    </div>

                    @{ var priceLists = (ViewBag.PriceLists as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new(); }
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Billing"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["The patient's bills are priced from this list, in its currency"]</span></h3></div>
                        <div class="card-body pt-2"><div class="row g-6">
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Price list"]</label>
                                <select name="priceListId" class="form-select form-select-solid" data-placeholder="@T["Main list"]" data-control="select2">
                                    <option value="">@T["Main list"]</option>
                                    @foreach (var l in priceLists) { <option value="@l.Id" selected="@(l.Id == p.PriceListId)">@l.Label — @DisplayName.Of(l.Name, l.NameEn)</option> }
                                </select></div>
                            <div class="col-md-6 d-flex align-items-end"><div class="text-muted fs-8">@T["Only an approved list appears here. The insurance unit will set it from the patient's contract."]</div></div>
                        </div></div>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                        <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                        <div class="fw-semibold">
                            <h4 class="text-gray-900 fw-bold mb-1">@T["Duplicate check"]</h4>
                            <div class="fs-7 text-gray-700">@T["As the ID, mobile or name is typed, the system looks for an existing file before a new one is opened."]</div>
                        </div>
                    </div>
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Similar files"]</span></h3></div>
                        <div class="card-body pt-2" id="similarList"><div class="text-center py-8"><i class="ki-outline ki-people fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-7 fw-semibold text-gray-500">@T["Nothing similar yet."]</div></div></div>
                    </div>
                </div>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script src="~/js/hospital/hospital-allergy-picker.js" asp-append-version="true"></script>
    <script src="~/js/hospital/hospital-patient-form.js" asp-append-version="true"></script>
    <script>
        (function () {
            var form = document.getElementById('patientForm');
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var urls = { save: @Json.Serialize(Url.Action("SavePatient")), similar: @Json.Serialize(Url.Action("SimilarPatients")), file: @Json.Serialize(Url.Action("Patient", new { id = 0 })), photo: @Json.Serialize(Url.Action("PatientPhoto", new { id = 0 })) };
            // The photo is taken here (a file or the camera) and uploaded right after the file is saved (a new file has no id yet).
            var photoCtl = HospPatientForm.photo(form);
            function uploadPhoto(id) {
                var b = photoCtl.blob(); if (!b) return Promise.resolve({ ok: true });
                var fd = new FormData(); fd.append('photo', b, b.name || 'photo.jpg'); fd.append('__RequestVerificationToken', token);
                return fetch(urls.photo.replace(/0\/Photo$/, id + '/Photo'), { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            var words = {
                failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                none: @Json.Serialize(T["Nothing similar yet."].Value), open: @Json.Serialize(T["Open file"].Value),
                reason: { 'national-id': @Json.Serialize(T["Same ID number"].Value), phone: @Json.Serialize(T["Same mobile"].Value), name: @Json.Serialize(T["Same name"].Value) },
                needName: @Json.Serialize(T["Enter the Arabic name"].Value), needNameEn: @Json.Serialize(T["Enter the English name"].Value), needAllergy: @Json.Serialize(T["Choose the allergy in every row, or remove the row"].Value)
            };
            // H272: what the file holds as the page opens (after the lists and the allergy rows are drawn) - the edit is compared with it
            var cw = {
                yes: @Json.Serialize(T["Yes"].Value), no: @Json.Serialize(T["No"].Value), allergies: @Json.Serialize(T["Allergies"].Value),
                nka: @Json.Serialize(T["The patient was asked and has no known allergy"].Value), photo: @Json.Serialize(T["Patient photo"].Value), newPhoto: @Json.Serialize(T["A new photo"].Value),
                title: @Json.Serialize(T["Confirm the changes"].Value), intro: @Json.Serialize(T["These details of the file will change:"].Value),
                nothing: @Json.Serialize(T["Nothing in the file was changed."].Value), save: @Json.Serialize(T["Save the changes"].Value)
            };
            var initial = null;
            window.addEventListener('load', function () { setTimeout(function () { initial = HospPatientForm.snapshot(form, cw); }, 0); });
            function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
            function val(n) { var el = form.elements[n]; return el ? el.value.trim() : ''; }

            // ---- duplicate check, as the desk types --------------------------------------------
            var timer = null, list = document.getElementById('similarList');
            function similar() {
                var qs = new URLSearchParams({ nationalId: val('nationalId'), phone: val('phone'), name: val('name'), nameEn: val('nameEn') });
                if (val('id')) qs.set('exclude', val('id'));
                fetch(urls.similar + '?' + qs, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (res) {
                    if (!res.ok || !res.items.length) { list.innerHTML = '<div class="text-center py-8"><i class="ki-outline ki-people fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-7 fw-semibold text-gray-500">' + esc(words.none) + '</div></div>'; return; }
                    // H128: the theme's list widget rows (demo39 widgets/lists) — symbol · name over file number · reason · open
                    list.innerHTML = res.items.map(function (h, i) {
                        var strong = h.reason === 'national-id', tone = strong ? 'danger' : 'primary';
                        return (i ? '<div class="separator separator-dashed my-3"></div>' : '') +
                            '<div class="d-flex flex-stack gap-3"><div class="d-flex align-items-center min-w-0">' +
                            '<div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-' + tone + '"><i class="ki-outline ki-profile-user fs-3 text-' + tone + '"></i></span></div>' +
                            '<div class="min-w-0"><a class="text-gray-900 text-hover-primary fw-bold fs-6 text-truncate d-block" href="' + h.url + '"><bdi>' + esc(h.name) + '</bdi></a>' +
                            '<span class="text-gray-500 fw-semibold fs-7 d-block"><bdi class="hp-num" dir="ltr">' + esc(h.mrn) + '</bdi>' + (h.nationalId ? ' · <bdi class="hp-num" dir="ltr">' + esc(h.nationalId) + '</bdi>' : '') + '</span>' +
                            '<span class="badge badge-light-' + tone + ' fs-8 fw-bold mt-1">' + esc(words.reason[h.reason] || '') + '</span></div></div>' +
                            '<a class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary flex-shrink-0" href="' + h.url + '" title="' + esc(words.open) + '"><i class="ki-outline ki-eye fs-3"></i></a></div>';
                    }).join('');
                });
            }
            form.querySelectorAll('[data-similar]').forEach(function (el) { el.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(similar, 350); }); });
            if (val('id')) similar();

            // ---- save ------------------------------------------------------------------------
            // the checks the page can make itself, each under its field, before anything is confirmed or sent
            function gaps() {
                HospPatientForm.clear(form); var bad = false;
                if (!val('name')) bad = HospPatientForm.error(form, 'name', words.needName) || bad;
                if (!val('nameEn')) bad = HospPatientForm.error(form, 'nameEn', words.needNameEn) || bad;
                var rows = [].slice.call(form.querySelectorAll('[data-ap-row] [data-ap-what]'));
                if (rows.some(function (s) { return !s.value; })) bad = HospPatientForm.error(form, 'allergy', words.needAllergy) || bad;
                var first = form.querySelector('[data-fe]'); if (first) first.scrollIntoView({ block: 'center', behavior: 'smooth' });
                return bad;
            }
            document.getElementById('patientSave').addEventListener('click', function () {
                var b = this;
                if (gaps()) return;
                // an edit is saved only after the desk has seen what changes (the owner)
                var ask = Promise.resolve(true);
                if (val('id') && initial) {
                    var list = HospPatientForm.changes(initial, HospPatientForm.snapshot(form, cw));
                    if (photoCtl.blob()) list.push({ label: cw.photo, from: '—', to: cw.newPhoto });
                    ask = HospPatientForm.confirmChanges(list, cw);
                }
                ask.then(function (yes) { if (yes) send(b); });
            });
            function send(b) {
                b.disabled = true;
                var payload = {
                    id: val('id') ? +val('id') : null, name: val('name'), nameEn: val('nameEn'), sex: val('sex'),
                    birthDate: val('birthDate') || null, nationalId: val('nationalId') || null,
                    nationalityId: val('nationalityId') ? +val('nationalityId') : null, phone: val('phone') || null,
                    bloodGroup: val('bloodGroup') || null, allergyItemsJson: val('allergyItemsJson') || '[]', chronicConditions: val('chronicConditions') || null,
                    emergencyName: val('emergencyName') || null, emergencyRelation: val('emergencyRelation') || null, emergencyPhone: val('emergencyPhone') || null,
                    consentSigned: form.elements.consentSigned.checked,
                    priceListId: val('priceListId') ? +val('priceListId') : null
                };
                fetch(urls.save, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(payload) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) {
                        if (!res.ok) { b.disabled = false; if (!HospPatientForm.refusal(form, res) && window.toastr) toastr.error(res.error || words.failed); return; }   // H272: under the field
                        uploadPhoto(res.id).then(function (ph) {
                            if (!ph.ok && window.toastr) toastr.error(ph.error || words.failed);
                            location.href = urls.file.replace(/0$/, res.id);
                        });
                    })
                    .catch(function () { b.disabled = false; if (window.toastr) toastr.error(words.failed); });
            }
        })();
    </script>
}
