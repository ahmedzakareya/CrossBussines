@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model List<HospitalOverrideRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ var inv = System.Globalization.CultureInfo.InvariantCulture; }
@foreach (var r in Model)
{
    <tr>
        <td class="ps-4 text-nowrap"><span class="hp-num text-gray-900 fw-bold d-block" dir="ltr">@HospitalNursingService.UtcToWard(r.Row.At).ToString("yyyy-MM-dd", inv)</span><span class="hp-num text-muted fw-semibold fs-7" dir="ltr">@HospitalNursingService.UtcToWard(r.Row.At).ToString("HH:mm", inv)</span></td>
        <td><a href="@Url.Action("Patient", new { id = r.Row.PatientId })" class="fw-bold fs-6 text-gray-900 text-hover-primary">@DisplayName.Of(r.Patient, r.PatientEn)</a><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi></td>
        <td><span class="badge badge-light-danger fs-7 fw-bold">@T["alertKind:" + r.Row.Kind]</span><div class="fs-7 text-gray-600 mt-1" dir="ltr" style="text-align:start"><bdi>@r.Row.Detail</bdi></div></td>
        <td class="fs-7 fw-semibold text-gray-800" dir="auto">@r.Row.Reason</td>
        <td class="pe-4 fs-7 fw-semibold text-gray-600">@(r.By ?? "—")</td>
    </tr>
}
