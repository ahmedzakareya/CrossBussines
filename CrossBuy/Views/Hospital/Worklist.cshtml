@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model List<HospitalWorklistRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Doctor worklist"].Value;
    var doctors = (ViewBag.Doctors as IReadOnlyList<HospitalPractitionerView>) ?? Array.Empty<HospitalPractitionerView>();
    var d = ViewBag.Doctor as HospitalPractitionerView;
    bool canConsult = ViewBag.CanConsult == true;
    var nowUtc = DateTime.UtcNow;
    int waiting = Model.Count(r => r.Appointment.Status == HospitalAppointmentStatus.Arrived);
    int seen = Model.Count(r => r.Appointment.Status == HospitalAppointmentStatus.Done);
    int remaining = Model.Count(r => r.Appointment.Status is HospitalAppointmentStatus.Booked or HospitalAppointmentStatus.Arrived or HospitalAppointmentStatus.InRoom);
    string StatusBadge(string s) => s switch
    {
        HospitalAppointmentStatus.Booked => "badge-light",
        HospitalAppointmentStatus.Arrived => "badge-light-info",
        HospitalAppointmentStatus.InRoom => "hp-badge",
        HospitalAppointmentStatus.Done => "badge-light-primary",
        _ => "badge-light",
    };
    string Tone(string s) => s switch { HospitalAppointmentStatus.Arrived => "info", HospitalAppointmentStatus.InRoom => "primary", HospitalAppointmentStatus.Done => "primary", _ => "gray-500" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Doctor worklist"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Clinics"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Worklist"]</li>
            </ul>
        </div>
        <form method="get" action="@Url.Action("Worklist")" id="docForm" class="w-250px">
            <select name="doctor" class="form-select form-select-sm form-select-solid" data-control="select2" data-placeholder="@T["Doctor"]">
                @foreach (var x in doctors) { <option value="@x.Row.ID" selected="@(d != null && x.Row.ID == d.Row.ID)">@DisplayName.Of(x.Row.Name, x.Row.NameEn)</option> }
            </select>
        </form>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (d == null)
        {
            <div class="card card-flush"><div class="card-body text-center py-10"><i class="ki-outline ki-user-square fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No practitioners yet. Add the first doctor."]</div></div></div>
        }
        else
        {
            @* H127: the doctor — demo39 account/overview profile header (photo · name · details with icons · dashed figures) *@
            <div class="card mb-5"><div class="card-body pt-7 pb-4">
                <div class="d-flex flex-wrap flex-sm-nowrap align-items-center">
                    <div class="me-6 mb-3"><div class="symbol symbol-75px symbol-circle flex-shrink-0">@if (d.PhotoPath != null) {<img src="@d.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(d.Row.NameEn)" />} else {<span class="symbol-label fs-2 fw-bold bg-light-primary text-primary hp-initials">@HospitalUi.Initials(d.Row.NameEn)</span>}</div></div>
                    <div class="flex-grow-1 min-w-0 mb-3">
                        <div class="text-gray-900 fs-2 fw-bold mb-1">@DisplayName.Of(d.Row.Name, d.Row.NameEn)</div>
                        <div class="d-flex flex-wrap fw-semibold fs-6">
                            <span class="d-flex align-items-center text-gray-500 me-5 mb-1"><i class="ki-outline ki-briefcase fs-4 me-1"></i>@DisplayName.Of(d.Row.Title, d.Row.TitleEn)</span>
                            @if (d.ClinicRoomNumber != null) {<span class="d-flex align-items-center text-gray-500 me-5 mb-1"><i class="ki-outline ki-geolocation fs-4 me-1"></i>@T["Room"]&nbsp;<bdi class="hp-num text-gray-800 fw-bold" dir="ltr">@d.ClinicRoomNumber</bdi></span>}
                        </div>
                    </div>
                    <div class="d-flex flex-wrap">
                        @foreach (var (label, n, icon, tone) in new[] { (T["Waiting"].Value, waiting, "ki-time", "info"), (T["Seen"].Value, seen, "ki-check-circle", "primary"), (T["Remaining"].Value, remaining, "ki-calendar", "primary") })
                        {
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 ms-3 mb-3">
                                <div class="d-flex align-items-center"><i class="ki-outline @icon fs-3 text-@tone me-2"></i><div class="fs-2 fw-bold hp-num">@n</div></div>
                                <div class="fw-semibold fs-6 text-gray-500">@label</div>
                            </div>
                        }
                    </div>
                </div>
            </div></div>

            @* H127: today's list — demo39 widgets/tables (table widget) *@
            <div class="card card-flush">
                <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Today's list"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Vitals are taken before the patient goes in"]</span>
                </h3>
                    <div class="card-toolbar"><span class="badge badge-light-primary fs-7 fw-bold hp-num">@Model.Count</span></div>
                </div>
                <div class="card-body pt-2">
                    @if (Model.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-calendar fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No appointments today."]</div></div> }
                    else
                    {
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light">
                                <th class="ps-4 w-50px rounded-start">#</th><th class="w-80px">@T["Time"]</th><th class="min-w-200px">@T["Patient"]</th><th>@T["Visit type"]</th><th class="text-center w-90px">@T["Vitals"]</th><th class="w-90px">@T["Wait"]</th><th>@T["Status"]</th><th class="text-end pe-4 rounded-end"></th>
                            </tr></thead>
                            <tbody class="fw-semibold text-gray-700">
                                @{ int i = 0; }
                                @foreach (var r in Model)
                                {
                                    var a = r.Appointment; i++;
                                    int? wait = a.Status == HospitalAppointmentStatus.Arrived && a.ArrivedAt is DateTime arr ? (int)Math.Max(0, (nowUtc - arr).TotalMinutes) : null;
                                    <tr>
                                        <td class="ps-4"><span class="fs-3 fw-bold text-gray-400 hp-num" dir="ltr">@i.ToString("00")</span></td>
                                        <td><span class="hp-num fw-bold text-gray-900 fs-6" dir="ltr">@HospitalUi.Clock(a.StartMinute)</span></td>
                                        <td><div class="d-flex align-items-center min-w-0">
                                            <div class="symbol symbol-45px symbol-circle me-4 flex-shrink-0">@if (a.PatientPhoto != null) {<img src="@a.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(a.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-7 hp-initials">@HospitalUi.Initials(a.PatientNameEn)</span>}</div>
                                            <div class="d-flex flex-column min-w-0"><a href="@Url.Action("Patient", new { id = a.PatientId })" class="text-gray-900 text-hover-primary fs-6 fw-bold text-truncate">@DisplayName.Of(a.PatientName, a.PatientNameEn)</a>
                                                <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num" dir="ltr">@a.Mrn</bdi>@if (a.QueueNumber != null) {<text> · </text><bdi class="hp-num" dir="ltr">A-@a.QueueNumber.Value.ToString("000")</bdi>}</span></div>
                                        </div></td>
                                        <td><span class="badge badge-light fs-7 fw-bold">@T["visit:" + a.VisitType]</span></td>
                                        <td class="text-center">@if (r.HasVitals) {<i class="ki-outline ki-check-circle fs-2 text-primary"></i>} else {<span class="text-gray-400">—</span>}</td>
                                        <td>@if (wait != null) {<span class="badge badge-light-@(wait > 15 ? "danger" : "primary") fs-7 fw-bold hp-num text-nowrap"><span dir="ltr">@wait</span>&nbsp;@T["min"]</span>} else {<span class="text-gray-400">—</span>}</td>
                                        <td><span class="d-inline-flex align-items-center"><span class="bullet bullet-dot bg-@Tone(a.Status) h-8px w-8px me-2"></span><span class="badge @StatusBadge(a.Status) fs-7 fw-bold">@T["appt:" + a.Status]</span></span>@if (r.EncounterStatus == HospitalEncounterStatus.Signed) {<span class="badge badge-light-primary fs-7 fw-bold ms-1">@T["Signed"]</span>}</td>
                                        <td class="text-end pe-4 text-nowrap">
                                            @if (r.EncounterId is int eid)
                                            {
                                                if (r.EncounterStatus == HospitalEncounterStatus.Draft) { <a href="@Url.Action("Consult", new { id = eid })" class="btn btn-sm btn-primary"><i class="ki-outline ki-notepad-edit fs-5"></i>@T["Resume"]</a> }
                                                else { <a href="@Url.Action("Consult", new { id = eid })" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["View visit"]" data-bs-toggle="tooltip"><i class="ki-outline ki-eye fs-3"></i></a> }
                                            }
                                            else if (canConsult && a.Status is HospitalAppointmentStatus.Arrived or HospitalAppointmentStatus.InRoom)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" data-start="@a.Id"><i class="ki-outline ki-entrance-left fs-5"></i>@T["Start"]</button>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("Patient", new { id = a.PatientId })" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["File"]" data-bs-toggle="tooltip"><i class="ki-outline ki-folder fs-3"></i></a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var sel = document.querySelector('#docForm [name=doctor]');
            if (sel) CB.onSelectChange(sel, function () { document.getElementById('docForm').submit(); });
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var urls = { open: @Json.Serialize(Url.Action("OpenConsultation", new { appointmentId = 0 })), consult: @Json.Serialize(Url.Action("Consult", new { id = 0 })) };
            document.addEventListener('click', function (e) {
                var b = e.target.closest('[data-start]'); if (!b) return;
                b.disabled = true;
                fetch(urls.open.replace(/0$/, b.getAttribute('data-start')), { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token } })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) {
                        if (!res.ok) { b.disabled = false; if (window.toastr) toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); return; }
                        location.href = urls.consult.replace(/0$/, res.id);
                    });
            });
        })();
    </script>
}
