@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalMorgueCompartmentView>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H90 — the mortuary: every compartment, free or holding a body (how long, what holds it), the register (in storage,
    police holds, released and transferred; searched and paged), receiving a body and adding compartments.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Mortuary"].Value;
    bool ready = ViewBag.Ready == true, canWork = ViewBag.CanWork == true, canManage = ViewBag.CanManage == true;
    var deaths = (ViewBag.Deaths as IReadOnlyList<(int Id, string Text)>) ?? Array.Empty<(int, string)>();
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var free = Model.Where(x => x.Case == null).ToList();
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Mortuary"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Occupied {0} of {1}", Model.Count - free.Count, Model.Count]</li></ul>
        </div>
        <div class="d-flex gap-2">
            @if (ready && canManage) {<button type="button" class="btn btn-sm btn-light" data-modal="compModal"><i class="ki-outline ki-plus fs-4"></i>@T["Add compartments"]</button>}
            @if (ready && canWork && free.Count > 0) {<button type="button" class="btn btn-sm btn-primary" data-modal="recvModal"><i class="ki-outline ki-entrance-left fs-4"></i>@T["Receive a body"]</button>}
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalMorgueService.NoTables]</div></div> }
        else
        {
            if (Model.Count == 0) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T["No compartment yet: add the cold chambers' places first."]</div></div> }
            <div class="row g-4 mb-6">
                @foreach (var v in Model)
                {
                    var c = v.Case;
                    <div class="col-6 col-md-3 col-xl-2">
                        @if (c == null)
                        {
                            <div class="card h-100 border border-dashed border-gray-300 bg-transparent"><div class="card-body p-4 text-center">
                                <div class="fs-3 fw-bold text-gray-500 hp-num">@v.Compartment.Code</div><div class="text-muted fs-8">@T["mgk:" + v.Compartment.Kind] · @T["Vacant"]</div></div></div>
                        }
                        else
                        {
                            <a href="@Url.Action("MorgueCase", new { id = c.ID })" class="card h-100 border-top border-3 border-@(v.Warnings.Count > 0 ? "danger" : "primary") text-hover-primary"><div class="card-body p-4">
                                <div class="d-flex flex-stack"><span class="fs-3 fw-bold text-gray-900 hp-num">@v.Compartment.Code</span><span class="badge badge-light fs-9 hp-num">@T["{0} h", v.Hours]</span></div>
                                <div class="fw-semibold fs-7 text-gray-800 mt-1 text-truncate">@(v.Name ?? T["Unknown"].Value)</div>
                                <div class="text-muted fs-9 hp-num">@c.TagNo</div>
                                <div class="d-flex flex-wrap gap-1 mt-2">@foreach (var w in v.Warnings) {<span class="badge badge-light-danger fs-9">@T["mgw:" + w]</span>}</div>
                            </div></a>
                        }
                    </div>
                }
            </div>
            <div class="card">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Mortuary register"]</span><span class="text-muted fs-7 mt-1"><span id="resultCount">—</span></span></div>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by name, file, tag or receiver…"]" /></div>
                        <div class="w-175px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_filter">
                            <option value="">@T["In the mortuary"]</option><option value="police">@T["Police hold"]</option><option value="out">@T["Released or transferred"]</option>
                        </select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-8 text-uppercase gs-0"><th>@T["Deceased"]</th><th>@T["Compartment"]</th><th>@T["Received"]</th><th>@T["State"]</th><th class="min-w-150px">@T["Warnings"]</th><th class="text-end"></th></tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="6" class="text-center text-muted py-10">@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="6" class="text-center text-muted py-10">@T["The register is empty."]</td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (ready && canManage)
{
    <div class="modal fade" id="compModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-450px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["Add compartments"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-12"><label class="form-label required">@T["Codes"]</label><input type="text" class="form-control form-control-solid" dir="ltr" data-k="codes" placeholder="A1-A6, F1" /><div class="text-muted fs-8 mt-1">@T["A range like A1-A6, or codes separated by commas."]</div></div>
            <div class="col-12"><label class="form-label required">@T["Kind"]</label><select class="form-select form-select-solid" data-k="kind">@foreach (var k in HospitalMorgueKind.All) {<option value="@k">@T["mgk:" + k]</option>}</select></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-comp-save>@T["Add"]</button></div>
    </div></div></div>
}
@if (ready && canWork && free.Count > 0)
{
    <div class="modal fade" id="recvModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["Receive a body"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-12"><label class="form-label">@T["Death certificate"]</label><select class="form-select form-select-solid" data-v="deathId"><option value="">@T["Unknown body (no certificate)"]</option>@foreach (var d in deaths) {<option value="@d.Id">@d.Text</option>}</select></div>
            <div class="col-12" data-unknown><label class="form-label required">@T["Description of the unknown body"]</label><textarea rows="2" maxlength="500" class="form-control form-control-solid" data-v="description" placeholder="@T["Sex, apparent age, height, marks, clothing, where found…"]"></textarea>
                <div class="text-danger fs-8 mt-1">@T["An unknown body is always a police case."]</div></div>
            <div class="col-4"><label class="form-label required">@T["Compartment"]</label><select class="form-select form-select-solid" data-v="compartmentId">@foreach (var f in free) {<option value="@f.Compartment.ID">@f.Compartment.Code</option>}</select></div>
            <div class="col-4"><label class="form-label required">@T["Tag number"]</label><input type="text" maxlength="30" class="form-control form-control-solid" dir="ltr" data-v="tagNo" /></div>
            <div class="col-4"><label class="form-label">@T["Brought from"]</label><input type="text" maxlength="150" class="form-control form-control-solid" data-v="broughtFrom" placeholder="@T["Ward, ER, ambulance…"]" /></div>
            <div class="col-6"><label class="form-check form-switch form-check-custom form-check-solid mt-2"><input class="form-check-input" type="checkbox" data-v="medicoLegal" /><span class="form-check-label">@T["Police case"]</span></label></div>
            <div class="col-6"><label class="form-check form-switch form-check-custom form-check-solid mt-2"><input class="form-check-input" type="checkbox" data-v="autopsyRequested" /><span class="form-check-label">@T["Autopsy requested"]</span></label></div>
            <div class="col-12"><label class="form-label">@T["Police report number"]</label><input type="text" maxlength="60" class="form-control form-control-solid" dir="ltr" data-v="policeRef" /></div>
            <div class="col-12"><label class="form-label">@T["Belongings (one a line: item × quantity)"]</label><textarea rows="3" class="form-control form-control-solid" data-v="belongings" placeholder="@T["Wedding ring × 1, wristwatch × 1, mobile phone × 1…"]"></textarea></div>
            <div class="col-12 text-muted fs-8">@T["A certificate whose manner is not natural becomes a police case, and its autopsy request carries over."]</div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-recv-save>@T["Receive"]</button></div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            if (document.getElementById('rows')) cbServerList({ url: @Json.Serialize(Url.Action("MorgueData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('filter', document.getElementById('f_filter').value); } });
            var tokEl = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tokEl) return; var tok = tokEl.value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), recv: @Json.Serialize(T["Receive this body into the mortuary?"].Value), comp: @Json.Serialize(T["Add these compartments?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b) })
                .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            var rv = document.getElementById('recvModal');
            function syncUnknown() { if (!rv) return; var d = rv.querySelector('[data-v="deathId"]'); var v = window.jQuery ? jQuery(d).val() : d.value; rv.querySelector('[data-unknown]').classList.toggle('d-none', !!v); }
            if (rv) { var ds = rv.querySelector('[data-v="deathId"]'); if (window.jQuery) jQuery(ds).on('change', syncUnknown); ds.addEventListener('change', syncUnknown); syncUnknown(); }
            document.addEventListener('click', function (e) {
                var o = e.target.closest('[data-modal]'); if (o) { bootstrap.Modal.getOrCreateInstance(document.getElementById(o.getAttribute('data-modal'))).show(); return; }
                var cs = e.target.closest('[data-comp-save]');
                if (cs) { var m = document.getElementById('compModal'); var b = { codes: m.querySelector('[data-k="codes"]').value, kind: window.jQuery ? jQuery(m.querySelector('[data-k="kind"]')).val() : m.querySelector('[data-k="kind"]').value };
                    cbConfirm(W.comp).then(function (ok) { if (!ok) return; cs.disabled = true; post(@Json.Serialize(Url.Action("AddMorgueCompartments")), b).then(function (res) { cs.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }); }); return; }
                var s = e.target.closest('[data-recv-save]'); if (!s) return;
                var val = function (k) { var i = rv.querySelector('[data-v="' + k + '"]'); return i.type === 'checkbox' ? i.checked : ((window.jQuery && i.tagName === 'SELECT') ? (jQuery(i).val() || '') : (i.value || '').trim()); };
                var items = (val('belongings') || '').split('\n').map(function (l) { l = l.trim(); if (!l) return null; var m = l.match(/^(.*?)\s*[×x\*]\s*(\d+)$/); return m ? { item: m[1], quantity: Number(m[2]) } : { item: l, quantity: 1 }; }).filter(Boolean);
                var b2 = { deathId: val('deathId') ? Number(val('deathId')) : null, description: val('description') || null, compartmentId: Number(val('compartmentId')), tagNo: val('tagNo') || null, broughtFrom: val('broughtFrom') || null,
                    medicoLegal: val('medicoLegal'), autopsyRequested: val('autopsyRequested'), policeRef: val('policeRef') || null, belongings: items };
                cbConfirm(W.recv).then(function (ok) { if (!ok) return; s.disabled = true;
                    post(@Json.Serialize(Url.Action("ReceiveMorgue")), b2).then(function (res) { s.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.href = @Json.Serialize(Url.Content("~/Hospital/Morgue/")) + res.id; }); });
            });
        })();
    </script>
}
