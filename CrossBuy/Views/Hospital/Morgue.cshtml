@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalMorgueCompartmentView>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H90 — the mortuary: every compartment, free or holding a body (how long, what holds it), the register (in storage,
    police holds, released and transferred; searched and paged), receiving a body and adding compartments.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Mortuary"].Value;
    bool ready = ViewBag.Ready == true, canWork = ViewBag.CanWork == true, canManage = ViewBag.CanManage == true;
    var deaths = (ViewBag.Deaths as IReadOnlyList<(int Id, string Text)>) ?? Array.Empty<(int, string)>();
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var free = Model.Where(x => x.Case == null).ToList();
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Mortuary"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Occupied {0} of {1}", Model.Count - free.Count, Model.Count]</li></ul>
        </div>
        <div class="d-flex gap-2">
            @if (ready && canManage) {<button type="button" class="btn btn-sm btn-light" data-modal="compModal"><i class="ki-outline ki-plus fs-4"></i>@T["Add compartments"]</button>}
            @if (ready && canWork && free.Count > 0) {<button type="button" class="btn btn-sm btn-primary" data-modal="recvModal"><i class="ki-outline ki-entrance-left fs-4"></i>@T["Receive a body"]</button>}
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalMorgueService.NoTables]</div></div> }
        else
        {
            if (Model.Count == 0) { <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5"><i class="ki-outline ki-information fs-2tx text-primary me-4"></i><div class="fs-6 text-gray-700 fw-semibold">@T["No compartment yet: add the cold chambers' places first."]</div></div> }
            @* H128: the occupancy as the theme's stat tiles (demo39 dashboards/logistics) *@
            int police = Model.Count(x => x.Case != null && x.Case.MedicoLegal && x.Case.PoliceClearedAt == null), warned = Model.Count(x => x.Case != null && x.Warnings.Count > 0);
            var tiles = new (string Label, int N, string Tone, string Icon)[] { ("Occupied", Model.Count - free.Count, "primary", "lock"), ("Vacant", free.Count, "success", "check-circle"),
                ("Police hold", police, "danger", "shield-tick"), ("With a warning", warned, "danger", "information") };
            <div class="row g-4 mb-5">
                @foreach (var t in tiles)
                {
                    <div class="col-6 col-md-3"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column"><span class="fs-2hx fw-bold lh-1 hp-num text-@(t.N > 0 ? "gray-900" : "gray-400")">@t.N</span><span class="text-gray-500 pt-1 fw-semibold fs-6">@T[t.Label]</span></div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@t.Tone"><i class="ki-outline ki-@t.Icon fs-2 text-@t.Tone"></i></span></div></div>
                        </div>
                        <div class="card-body pt-0"></div>
                    </div></div>
                }
            </div>
            @* H128: the compartments as small theme cards: a vacant place is dashed, an occupied one names the body and its hours *@
            <div class="row g-4 mb-6">
                @foreach (var v in Model)
                {
                    var c = v.Case;
                    <div class="col-6 col-md-3 col-xl-2">
                        @if (c == null)
                        {
                            <div class="card h-100 border border-dashed border-gray-300 bg-transparent shadow-none"><div class="card-body p-4 d-flex flex-column align-items-center justify-content-center text-center">
                                <div class="symbol symbol-35px mb-2"><span class="symbol-label bg-light-success"><i class="ki-outline ki-check-circle fs-3 text-success"></i></span></div>
                                <div class="fs-4 fw-bold text-gray-700 hp-num"><bdi>@v.Compartment.Code</bdi></div><div class="text-gray-500 fw-semibold fs-8">@T["mgk:" + v.Compartment.Kind] · @T["Vacant"]</div></div></div>
                        }
                        else
                        {
                            bool warn = v.Warnings.Count > 0;
                            <a href="@Url.Action("MorgueCase", new { id = c.ID })" class="card card-flush h-100 bg-hover-light-primary"><div class="card-body p-4">
                                <div class="d-flex flex-stack mb-2"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-2"><span class="symbol-label bg-light-@(warn ? "danger" : "primary")"><i class="ki-outline ki-lock fs-3 text-@(warn ? "danger" : "primary")"></i></span></div>
                                    <span class="fs-4 fw-bold text-gray-900 hp-num"><bdi>@v.Compartment.Code</bdi></span></div>
                                    <span class="badge badge-light-@(v.Hours >= HospitalMorgueRules.AlertHours ? "danger" : "primary") fs-8 fw-bold hp-num">@T["{0} h", v.Hours]</span></div>
                                <div class="text-gray-800 fw-bold fs-7 text-truncate">@(v.Name ?? T["Unknown"].Value)</div>
                                <div class="text-gray-500 fw-semibold fs-8 hp-num"><bdi>@c.TagNo</bdi></div>
                                @if (warn) {<div class="d-flex flex-wrap gap-1 mt-2">@foreach (var w in v.Warnings) {<span class="badge badge-light-danger fs-9 fw-bold">@T["mgw:" + w]</span>}</div>}
                            </div></a>
                        }
                    </div>
                }
            </div>
            @* H128: the register as the theme's table widget (demo39 widgets/tables) *@
            <div class="card card-flush">
                <div class="card-header align-items-center pt-5 gap-2 gap-md-5">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Mortuary register"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by name, file, tag or receiver…"]" /></div>
                        <div class="w-175px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_filter">
                            <option value="">@T["In the mortuary"]</option><option value="police">@T["Police hold"]</option><option value="out">@T["Released or transferred"]</option>
                        </select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-icon btn-light btn-active-light-primary" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-3"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 min-w-200px rounded-start">@T["Deceased"]</th><th>@T["Compartment"]</th><th>@T["Received"]</th><th>@T["State"]</th><th>@T["Warnings"]</th><th class="pe-4 rounded-end"></th></tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="6" class="text-center py-10"><span class="spinner-border spinner-border-sm text-primary align-middle me-2"></span><span class="text-gray-500 fw-semibold">@T["Loading…"]</span></td></tr>
                            <tr id="emptyRow" class="d-none"><td colspan="6" class="text-center py-12"><i class="ki-outline ki-notepad fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["The register is empty."]</div></td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (ready && canManage)
{
    @* H128: the forms as the theme's form modal (demo39 utilities/modals/forms/new-target) *@
    <div class="modal fade" id="compModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Add compartments"]</h1><div class="text-muted fw-semibold fs-6">@T["A range like A1-A6, or codes separated by commas."]</div></div>
            <div class="row g-6">
            <div class="col-12"><label class="required fs-6 fw-semibold mb-2">@T["Codes"]</label><input type="text" class="form-control form-control-solid" dir="ltr" data-k="codes" placeholder="A1-A6, F1" /></div>
            <div class="col-12"><label class="required fs-6 fw-semibold mb-2">@T["Kind"]</label><select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#compModal" data-hide-search="true" data-k="kind">@foreach (var k in HospitalMorgueKind.All) {<option value="@k">@T["mgk:" + k]</option>}</select></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-comp-save>@T["Add"]</button></div>
        </div>
    </div></div></div>
}
@if (ready && canWork && free.Count > 0)
{
    <div class="modal fade" id="recvModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Receive a body"]</h1><div class="text-muted fw-semibold fs-6">@T["A certificate whose manner is not natural becomes a police case, and its autopsy request carries over."]</div></div>
            <div class="row g-6">
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Death certificate"]</label><select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#recvModal" data-v="deathId"><option value="">@T["Unknown body (no certificate)"]</option>@foreach (var d in deaths) {<option value="@d.Id">@d.Text</option>}</select></div>
            <div class="col-12" data-unknown><label class="required fs-6 fw-semibold mb-2">@T["Description of the unknown body"]</label><textarea rows="2" maxlength="500" class="form-control form-control-solid" data-v="description" placeholder="@T["Sex, apparent age, height, marks, clothing, where found…"]"></textarea>
                <div class="text-danger fw-semibold fs-7 mt-1">@T["An unknown body is always a police case."]</div></div>
            <div class="col-4"><label class="required fs-6 fw-semibold mb-2">@T["Compartment"]</label><select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#recvModal" data-v="compartmentId">@foreach (var f in free) {<option value="@f.Compartment.ID">@f.Compartment.Code</option>}</select></div>
            <div class="col-4"><label class="required fs-6 fw-semibold mb-2">@T["Tag number"]</label><input type="text" maxlength="30" class="form-control form-control-solid" dir="ltr" data-v="tagNo" /></div>
            <div class="col-4"><label class="fs-6 fw-semibold mb-2">@T["Brought from"]</label><input type="text" maxlength="150" class="form-control form-control-solid" data-v="broughtFrom" placeholder="@T["Ward, ER, ambulance…"]" /></div>
            <div class="col-6"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-v="medicoLegal" /><span class="form-check-label fw-semibold text-gray-700">@T["Police case"]</span></label></div>
            <div class="col-6"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-v="autopsyRequested" /><span class="form-check-label fw-semibold text-gray-700">@T["Autopsy requested"]</span></label></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Police report number"]</label><input type="text" maxlength="60" class="form-control form-control-solid" dir="ltr" data-v="policeRef" /></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Belongings (one a line: item × quantity)"]</label><textarea rows="3" class="form-control form-control-solid" data-v="belongings" placeholder="@T["Wedding ring × 1, wristwatch × 1, mobile phone × 1…"]"></textarea></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-recv-save>@T["Receive"]</button></div>
        </div>
    </div></div></div>
}
@section Scripts {
    <script>
        (function () {
            if (document.getElementById('rows')) cbServerList({ url: @Json.Serialize(Url.Action("MorgueData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('filter', document.getElementById('f_filter').value); } });
            var tokEl = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tokEl) return; var tok = tokEl.value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), recv: @Json.Serialize(T["Receive this body into the mortuary?"].Value), comp: @Json.Serialize(T["Add these compartments?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b) })
                .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            var rv = document.getElementById('recvModal');
            function syncUnknown() { if (!rv) return; var d = rv.querySelector('[data-v="deathId"]'); var v = window.jQuery ? jQuery(d).val() : d.value; rv.querySelector('[data-unknown]').classList.toggle('d-none', !!v); }
            if (rv) { var ds = rv.querySelector('[data-v="deathId"]'); if (window.jQuery) jQuery(ds).on('change', syncUnknown); ds.addEventListener('change', syncUnknown); syncUnknown(); }
            document.addEventListener('click', function (e) {
                var o = e.target.closest('[data-modal]'); if (o) { bootstrap.Modal.getOrCreateInstance(document.getElementById(o.getAttribute('data-modal'))).show(); return; }
                var cs = e.target.closest('[data-comp-save]');
                if (cs) { var m = document.getElementById('compModal'); var b = { codes: m.querySelector('[data-k="codes"]').value, kind: window.jQuery ? jQuery(m.querySelector('[data-k="kind"]')).val() : m.querySelector('[data-k="kind"]').value };
                    cbConfirm(W.comp).then(function (ok) { if (!ok) return; cs.disabled = true; post(@Json.Serialize(Url.Action("AddMorgueCompartments")), b).then(function (res) { cs.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }); }); return; }
                var s = e.target.closest('[data-recv-save]'); if (!s) return;
                var val = function (k) { var i = rv.querySelector('[data-v="' + k + '"]'); return i.type === 'checkbox' ? i.checked : ((window.jQuery && i.tagName === 'SELECT') ? (jQuery(i).val() || '') : (i.value || '').trim()); };
                var items = (val('belongings') || '').split('\n').map(function (l) { l = l.trim(); if (!l) return null; var m = l.match(/^(.*?)\s*[×x\*]\s*(\d+)$/); return m ? { item: m[1], quantity: Number(m[2]) } : { item: l, quantity: 1 }; }).filter(Boolean);
                var b2 = { deathId: val('deathId') ? Number(val('deathId')) : null, description: val('description') || null, compartmentId: Number(val('compartmentId')), tagNo: val('tagNo') || null, broughtFrom: val('broughtFrom') || null,
                    medicoLegal: val('medicoLegal'), autopsyRequested: val('autopsyRequested'), policeRef: val('policeRef') || null, belongings: items };
                cbConfirm(W.recv).then(function (ok) { if (!ok) return; s.disabled = true;
                    post(@Json.Serialize(Url.Action("ReceiveMorgue")), b2).then(function (res) { s.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.href = @Json.Serialize(Url.Content("~/Hospital/Morgue/")) + res.id; }); });
            });
        })();
    </script>
}
