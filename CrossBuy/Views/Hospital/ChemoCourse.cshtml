@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalChemoCoursePage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@inject CrossBuy.Models.Context.CrossDbContext Db
@using Microsoft.EntityFrameworkCore
@*
    H88 — one chemotherapy course: the patient and the regimen, the lifetime limits used so far, every cycle given or held
    with what cleared it and the doses as given, and the next cycle: today's weight and counts in, the doses and the
    checks out (computed by the server as they are typed), given — with a reason when a check is overruled — or held.
*@
@{
    // H120: each cycle's pharmacy request — its number and where it stands
    var rxIds = Model.Cycles.Where(cv => cv.Cycle.DispenseId != null).Select(cv => cv.Cycle.DispenseId!.Value).ToList();
    var rxs = rxIds.Count == 0 ? new Dictionary<int, HospitalDispense>() : Db.HospitalDispenses.AsNoTracking().Where(d => rxIds.Contains(d.ID)).ToDictionary(d => d.ID);
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Chemotherapy course"].Value;
    bool canTreat = ViewBag.CanTreat == true;
    var today = (DateTime)ViewBag.Today;
    var c = Model.Course; var r = Model.Regimen;
    bool active = c.Status == HospitalChemoCourseStatus.Active, more = active && Model.Given < r.MaxCycles;
    string Who(int? id) => id is int i && Model.People.TryGetValue(i, out var n) ? n : "";
    var lastWeight = Model.Cycles.Where(x => x.Cycle.WeightKg != null).Select(x => x.Cycle.WeightKg).LastOrDefault() ?? c.WeightKg;
    string V(decimal? d) => d?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    bool needsCr = Model.Drugs.Any(d => d.Basis == HospitalChemoBasis.Auc);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    int coursePct = r.MaxCycles == 0 ? 0 : Math.Clamp(Model.Given * 100 / r.MaxCycles, 0, 100);
    // H125: one row of the theme's list widget (demo39 dashboards/logistics) — symbol · label · value (markup) · last row has no separator
    void Row(string icon, string tone, string label, Microsoft.AspNetCore.Html.IHtmlContent value, bool last = false)
    {
        <div class="d-flex flex-stack">
            <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-3 text-@tone"></i></span></div>
            <div class="d-flex flex-stack flex-row-fluid d-grid gap-2"><span class="text-gray-800 fw-bold fs-6 me-3">@label</span><div class="text-end">@value</div></div>
        </div>
        if (!last) { <div class="separator separator-dashed my-3"></div> }
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Chemotherapy course"] <span class="badge hp-code fs-7 hp-num ms-2">@c.CourseNo</span></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("Oncology")" class="text-muted text-hover-primary">@T["Oncology"]</a></li></ul>
        </div>
        @if (active && canTreat)
        {
            <div class="d-flex gap-2">
                @if (!more) {<button type="button" class="btn btn-sm btn-primary" data-end="complete"><i class="ki-outline ki-check-circle fs-4"></i>@T["Complete the course"]</button>}
                <button type="button" class="btn btn-sm btn-light-danger" data-end="stop"><i class="ki-outline ki-cross-circle fs-4"></i>@T["Stop the course"]</button>
            </div>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 mb-5">
            @* H125: the patient and the course — the theme's list widget, the course's progress and the lifetime limits as progress bars *@
            <div class="col-xl-4"><div class="card card-flush h-100">
                <div class="card-header pt-6">
                    <div class="d-flex align-items-center gap-4">
                        <div class="symbol symbol-55px symbol-circle">@if (Model.Photo != null) {<img src="@Model.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold bg-light-primary text-primary fs-3">@HospitalUi.Initials(Model.NameEn)</span>}</div>
                        <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = c.PatientId })" class="fs-4 fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(Model.Name, Model.NameEn)</a>
                            <span class="text-gray-500 fw-semibold fs-7"><bdi class="hp-num">@Model.Mrn</bdi>@if (Model.Age != null) {<text> · @T["{0} years", Model.Age]</text>}</span></div>
                    </div>
                </div>
                <div class="card-body pt-4">
                    <div class="rounded bg-light-primary p-5 mb-6">
                        <div class="d-flex flex-stack mb-3"><span class="text-gray-700 fw-semibold fs-6">@T["Chemo cycles"]</span><span class="badge badge-@(active ? "primary" : "light") fs-8 fw-bold">@T["ccs:" + c.Status]</span></div>
                        <div class="d-flex align-items-end mb-3"><span class="fs-2hx fw-bold text-gray-900 lh-1 me-2 hp-num">@Model.Given</span><span class="text-gray-600 fw-semibold fs-6 mb-1">@T["{0} of {1}", Model.Given, r.MaxCycles]</span></div>
                        <div class="progress h-8px bg-white"><div class="progress-bar bg-primary" role="progressbar" style="width:@(coursePct)%"></div></div>
                    </div>
                    @{
                        Row("book", "primary", T["Regimen"].Value, new Microsoft.AspNetCore.Html.HtmlString("<span class=\"badge hp-code hp-num me-1\">" + System.Net.WebUtility.HtmlEncode(r.Code) + "</span><span class=\"text-gray-800 fw-bold fs-7\">" + System.Net.WebUtility.HtmlEncode(DisplayName.Of(r.Name, r.NameEn ?? r.Name)) + "</span>"));
                        Row("pulse", "danger", T["Diagnosis"].Value, new Microsoft.AspNetCore.Html.HtmlString("<bdi class=\"text-gray-800 fw-bold fs-7\">" + System.Net.WebUtility.HtmlEncode(c.Diagnosis) + "</bdi>" + (c.Stage != null ? "<span class=\"text-gray-500 fw-semibold d-block fs-8\"><bdi dir=\"ltr\">" + System.Net.WebUtility.HtmlEncode(c.Stage) + "</bdi></span>" : "")));
                        Row("abstract-26", "info", T["Intent"].Value, new Microsoft.AspNetCore.Html.HtmlString("<span class=\"badge badge-light-info fs-7 fw-bold\">" + System.Net.WebUtility.HtmlEncode(T["cin:" + c.Intent].Value) + "</span>"));
                        Row("user", "success", T["At the start"].Value, new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-gray-800 fw-bold fs-7 hp-num text-nowrap\" dir=\"ltr\">" + V(c.HeightCm) + "\u00A0cm · " + V(c.WeightKg) + "\u00A0kg · " + HospitalOncologyRules.Bsa(c.HeightCm, c.WeightKg).ToString("0.00", inv) + "\u00A0m²</span>"));
                        var nextHtml = Model.NextDue is DateTime nd
                            ? "<span class=\"badge badge-light-" + (nd < today ? "danger" : "primary") + " fs-7 fw-bold hp-num\">" + nd.ToString("yyyy-MM-dd") + "</span>"
                            : "<span class=\"badge badge-light fs-7 fw-semibold\">" + System.Net.WebUtility.HtmlEncode(active ? T["All cycles given"].Value : T["ccs:" + c.Status].Value) + "</span>";
                        Row("calendar", "primary", T["Next cycle"].Value, new Microsoft.AspNetCore.Html.HtmlString(nextHtml), last: true);
                    }
                    @if (!active && c.EndReason != null) {<div class="notice d-flex bg-light rounded border border-dashed p-4 mt-5 fs-7 text-gray-700"><i class="ki-outline ki-information-5 fs-3 text-gray-500 me-3"></i><bdi>@c.EndReason</bdi></div>}
                    @{ var limited = Model.Drugs.Where(d => d.LifetimeMgM2 != null).ToList(); }
                    @if (limited.Count > 0)
                    {
                        <div class="separator separator-dashed my-6"></div>
                        <div class="d-flex align-items-center mb-5"><i class="ki-outline ki-shield-tick fs-2 text-primary me-2"></i><span class="fw-bold fs-6 text-gray-800">@T["Lifetime limits"]</span></div>
                        foreach (var d in limited)
                        {
                            var used = Model.Lifetime.TryGetValue(d.DrugName.Trim().ToUpperInvariant(), out var u) ? u : 0m;
                            int pct = (int)Math.Min(100, used / d.LifetimeMgM2!.Value * 100);
                            <div class="mb-5">
                                <div class="d-flex flex-stack mb-2"><bdi dir="ltr" class="text-gray-800 fw-bold fs-7">@d.DrugName</bdi>
                                    <span class="badge badge-light-@(pct >= 85 ? "danger" : "primary") fs-8 fw-bold hp-num">@T["{0} of {1}", used.ToString("0", inv), d.LifetimeMgM2.Value.ToString("0", inv)]&nbsp;<bdi dir="ltr">mg/m²</bdi></span></div>
                                <div class="progress h-8px bg-light"><div class="progress-bar @(pct >= 85 ? "bg-danger" : "bg-primary")" role="progressbar" style="width:@pct%"></div></div>
                            </div>
                        }
                    }
                </div>
            </div></div>

            <div class="col-xl-8">
                @if (more && canTreat)
                {
                    <div class="card card-flush mb-5 border border-primary border-dashed" id="givePanel">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800"><i class="ki-outline ki-capsule fs-2 text-primary me-2"></i>@T["Cycle {0}", Model.Given + 1]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Write today's weight and counts: the doses and the checks follow."]</span></h3>
                        </div>
                        <div class="card-body pt-2">
                            <div class="row g-3 mb-4">
                                <div class="col-md-2 col-4"><label class="form-label fs-8 required">@T["Weight (kg)"]</label><input type="number" step="0.1" class="form-control form-control-sm form-control-solid" dir="ltr" data-g="weightKg" value="@V(lastWeight)" /></div>
                                <div class="col-md-2 col-4"><label class="form-label fs-8">@T["Neutrophils ×10⁹/L"]</label><input type="number" step="0.01" class="form-control form-control-sm form-control-solid" dir="ltr" data-g="anc" /></div>
                                <div class="col-md-2 col-4"><label class="form-label fs-8">@T["Platelets ×10⁹/L"]</label><input type="number" step="1" class="form-control form-control-sm form-control-solid" dir="ltr" data-g="platelets" /></div>
                                <div class="col-md-2 col-4"><label class="form-label fs-8 @(needsCr ? "required" : "")">@T["Creatinine mg/dL"]</label><input type="number" step="0.01" class="form-control form-control-sm form-control-solid" dir="ltr" data-g="creatinine" /></div>
                                <div class="col-md-2 col-4"><label class="form-label fs-8">@T["Dose reduction"]</label><div class="input-group input-group-sm input-group-solid" dir="ltr"><input type="number" min="0" max="75" step="5" value="0" class="form-control form-control-sm form-control-solid" data-g="doseReductionPct" /><span class="input-group-text">%</span></div></div>
                                <div class="col-md-2 col-4"><label class="form-label fs-8">@T["Toxicity since the last"]</label><select class="form-select form-select-sm form-select-solid" data-g="toxicityGrade" data-control="none"><option value="">—</option>@for (int g = 0; g <= 4; g++) {<option value="@g">@T["Grade {0}", g]</option>}</select></div>
                                <div class="col-md-8"><label class="form-label fs-8">@T["What toxicity"]</label><input type="text" maxlength="300" class="form-control form-control-sm form-control-solid" data-g="toxicityNote" placeholder="@T["Neutropenic fever, mucositis, neuropathy…"]" /></div>
                                <div class="col-md-4"><label class="form-label fs-8">@T["Given on"]</label><input type="date" class="form-control form-control-sm form-control-solid" dir="ltr" data-g="date" value="@today.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" /></div>
                            </div>
                            <div id="pvBox" class="rounded border border-gray-300 border-dashed p-5 mb-4">
                                <div class="d-flex flex-wrap gap-6 mb-3 hp-num fs-7"><div><span class="text-muted">@T["Body surface"]</span> <span class="fw-bold fs-5" id="pvBsa">—</span> m²</div><div id="pvGfrBox"><span class="text-muted">GFR</span> <span class="fw-bold fs-5" id="pvGfr">—</span> ml/min</div></div>
                                <table class="table align-middle gs-0 gy-3 fs-7 mb-3"><thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Drug"]</th><th>@T["Prescribed"]</th><th>@T["Route"]</th><th>@T["Days of the cycle"]</th><th class="text-end">@T["Dose to give"]</th><th class="text-end pe-4 rounded-end">@T["Lifetime after"]</th></tr></thead><tbody id="pvRows"></tbody></table>
                                <div id="pvChecks" class="d-flex flex-wrap gap-2"></div>
                                <div id="pvRefusal" class="text-danger fw-semibold fs-7 mt-2 d-none"></div>
                            </div>
                            <div id="ovBox" class="mb-4 d-none"><label class="form-label fs-8 required text-danger">@T["Why give it anyway"]</label><textarea rows="2" maxlength="300" class="form-control form-control-sm form-control-solid" data-g="overrideReason"></textarea></div>
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-sm btn-light" data-modal="holdModal"><i class="ki-outline ki-time fs-4"></i>@T["Hold the cycle"]</button>
                                <button type="button" class="btn btn-sm btn-primary" data-give><i class="ki-outline ki-check fs-4"></i>@T["Prepare cycle {0} for the check", Model.Given + 1]</button>
                            </div>
                        </div>
                    </div>
                }
                @* H130: what each cycle draws from the oncology unit's store *@
                @await Html.PartialAsync("_SessionKit", ViewBag.KitCard as HospitalSessionKitCard)
                <div class="card card-flush">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Chemo cycles"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} of {1}", Model.Given, r.MaxCycles]</span></h3>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Cycles.Count == 0)
                        {
                            <div class="text-center py-12"><i class="ki-outline ki-capsule fs-3x text-gray-300 mb-4 d-block"></i><span class="fs-6 fw-semibold text-gray-600">@T["No cycle yet."]</span></div>
                        }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Cycle"]</th><th>@T["Date"]</th><th>@T["Weight / BSA"]</th><th>@T["Counts"]</th><th>@T["Toxicity"]</th><th class="min-w-200px">@T["Doses"]</th><th class="pe-4 rounded-end">@T["The bill"]</th></tr></thead>
                                <tbody>
                                @foreach (var v in Model.Cycles.AsEnumerable().Reverse())
                                {
                                    var y = v.Cycle; bool held = y.Status == HospitalChemoCycleStatus.Held, prepared = y.Status == HospitalChemoCycleStatus.Prepared;   // H181
                                    <tr>
                                        <td class="ps-4"><div class="symbol symbol-40px"><span class="symbol-label fw-bold fs-5 hp-num @(held ? "bg-light text-gray-600" : "bg-light-primary text-primary")">@y.CycleNo</span></div>
                                            @if (held) {<span class="badge badge-light fs-8 fw-bold mt-2 d-inline-block">@T["Held"]</span>}
                                            @if (prepared) {<span class="badge badge-light-danger fs-8 fw-bold mt-2 d-inline-block">@T["Awaiting the independent check"]</span>}
                                            else if (y.CheckedByEmployeeId != null) {<span class="badge badge-light-primary fs-8 fw-bold mt-2 d-inline-block">@T["Double-checked"]</span>}</td>
                                        <td class="text-nowrap"><span class="text-gray-800 fw-bold d-block fs-7 hp-num">@y.CycleDate.ToString("yyyy-MM-dd")</span>@if (held) {<span class="text-muted fw-semibold d-block fs-8 hp-num">→ @y.HeldUntil?.ToString("yyyy-MM-dd")</span>}<span class="text-gray-500 fw-semibold d-block fs-8">@Who(y.CreatedByEmployeeId)</span></td>
                                        <td class="text-nowrap">@if (!held) {<span class="text-gray-800 fw-bold d-block fs-7 hp-num" dir="ltr">@V(y.WeightKg) kg</span><span class="text-gray-500 fw-semibold d-block fs-8 hp-num" dir="ltr">@y.BsaM2?.ToString("0.00") m²</span>@if (y.DoseReductionPct > 0) {<span class="badge badge-light-danger fs-8 fw-bold mt-1 hp-num" dir="ltr">−@y.DoseReductionPct %</span>}} else {<span class="text-muted">—</span>}</td>
                                        <td class="text-nowrap" dir="ltr"><span class="d-block fs-8 hp-num @(y.Anc < HospitalOncologyRules.MinAnc ? "text-danger fw-bold" : "text-gray-700 fw-semibold")">ANC @(y.Anc?.ToString("0.0#") ?? "—")</span><span class="d-block fs-8 hp-num @(y.Platelets < HospitalOncologyRules.MinPlatelets ? "text-danger fw-bold" : "text-gray-700 fw-semibold")">PLT @(y.Platelets?.ToString() ?? "—")</span>@if (y.Creatinine != null) {<span class="d-block fs-8 hp-num text-gray-500">Cr @y.Creatinine.Value.ToString("0.0#")</span>}</td>
                                        <td>@if (y.ToxicityGrade is int g) {<span class="badge badge-light-@(g >= 3 ? "danger" : g >= 1 ? "primary" : "success") fs-7 fw-bold">@T["Grade {0}", g]</span>}@if (y.ToxicityNote != null) {<span class="text-gray-500 fw-semibold d-block fs-8 mt-1"><bdi>@y.ToxicityNote</bdi></span>}</td>
                                        <td class="fs-7">@if (held) {<span class="text-gray-600"><bdi>@y.Reason</bdi></span>}
                                            else
                                            {
                                                foreach (var d in v.Doses) {<div class="d-flex flex-wrap align-items-center gap-2 mb-1"><bdi dir="ltr" class="text-gray-800 fw-bold">@d.DrugName</bdi><span class="badge badge-light-primary fs-8 fw-bold hp-num" dir="ltr">@d.DoseMg.ToString("0.#") mg @d.Route</span><span class="text-gray-500 fs-8">@T["Day {0}", d.Days]</span></div>}
                                                if (y.OverrideReason != null) {<span class="text-danger fw-semibold d-block fs-8 mt-1">@T["Overruled"]: <bdi>@y.OverrideReason</bdi></span>}
                                            }</td>
                                        <td class="pe-4 min-w-175px">@if (prepared)
                                            {
                                                <div class="d-flex flex-column gap-2">
                                                    <button type="button" class="btn btn-sm btn-primary" data-verify="@y.ID"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Checked: give it"]</button>
                                                    <button type="button" class="btn btn-sm btn-light-danger" data-reject="@y.ID">@T["Take it back"]</button>
                                                    <span class="text-muted fs-8">@T["By a second clinician, not the one who prepared it."]</span>
                                                </div>
                                            }
                                            @await Html.PartialAsync("_SessionCharge", new HospitalSessionChargeCell(HospitalSessionKinds.Chemo, y.ID, y.BillLineId, y.Status == HospitalChemoCycleStatus.Given))<div class="mt-2">@await Html.PartialAsync("_SessionKitCell", new HospitalSessionKitCell(HospitalSessionKinds.Chemo, y.ID, y.KitIssuedAt, y.Status == HospitalChemoCycleStatus.Given, (ViewBag.KitCard as HospitalSessionKitCard)?.Kit.KitItemId != null))</div>@if (y.DispenseId is int rxId && rxs.TryGetValue(rxId, out var rx)) {<a href="@Url.Action("Pharmacy")" class="badge badge-light-@(rx.Status == HospitalDispenseStatus.Dispensed ? "success" : "primary") fs-8 fw-bold mt-2 text-nowrap"><i class="ki-outline ki-capsule fs-7 me-1 text-@(rx.Status == HospitalDispenseStatus.Dispensed ? "success" : "primary")"></i><bdi class="hp-num">@rx.RxNo</bdi>&nbsp;·&nbsp;@T["rxs:" + rx.Status]</a>}</td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@if (more && canTreat)
{
    <div class="modal fade" id="holdModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Hold the cycle"]</h1><div class="text-muted fw-semibold fs-6">@T["Cycle {0}", Model.Given + 1] · <span class="badge hp-code hp-num">@c.CourseNo</span></div></div>
            <div class="row g-6">
            <div class="col-6"><label class="required fs-6 fw-semibold mb-2">@T["Put off to"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-h="until" min="@today.AddDays(1).ToString("yyyy-MM-dd")" value="@today.AddDays(7).ToString("yyyy-MM-dd")" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Toxicity grade"]</label><select class="form-select form-select-solid" data-h="toxicityGrade" data-control="none"><option value="">—</option>@for (int g = 0; g <= 4; g++) {<option value="@g">@T["Grade {0}", g]</option>}</select></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Neutrophils ×10⁹/L"]</label><input type="number" step="0.01" class="form-control form-control-solid" dir="ltr" data-h="anc" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Platelets ×10⁹/L"]</label><input type="number" class="form-control form-control-solid" dir="ltr" data-h="platelets" /></div>
            <div class="col-12"><label class="required fs-6 fw-semibold mb-2">@T["Why"]</label><textarea rows="2" maxlength="300" class="form-control form-control-solid" data-h="reason"></textarea></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-hold-save>@T["Hold the cycle"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var tokEl = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tokEl) return; var tok = tokEl.value;
            var base = @Json.Serialize(Url.Content("~/Hospital/Oncology/Course/" + c.ID));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), give: @Json.Serialize(T["Record this cycle with these doses? A second clinician checks it before it is given."].Value),
                      verify: @Json.Serialize(T["You checked the drugs, doses and patient independently: give this cycle?"].Value), reject: @Json.Serialize(T["What did the check find?"].Value),
                      hold: @Json.Serialize(T["Hold this cycle?"].Value), complete: @Json.Serialize(T["Mark the course completed?"].Value), stop: @Json.Serialize(T["Why is the course stopped?"].Value),
                      stopTitle: @Json.Serialize(T["Stop the course"].Value), noLimit: '—', ofN: @Json.Serialize(T["{0} of {1}"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b) })
                .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            // H130: the cycle is given; a short store leaves its kit waiting, and says so
            function done(btn) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved);
                if (res.kitError) { toastr.info(@Json.Serialize(T["The session is finished, but its kit did not leave the store:"].Value) + ' ' + res.kitError); setTimeout(function () { location.reload(); }, 2500); } else location.reload(); }; }
            function num(v) { return v === '' ? null : Number(v); }
            function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
            var panel = document.getElementById('givePanel'), blocks = false, timer = null;
            function form() { var b = {}; panel.querySelectorAll('[data-g]').forEach(function (i) { var k = i.getAttribute('data-g'), v = (i.value || '').trim();
                b[k] = (k === 'toxicityNote' || k === 'overrideReason' || k === 'date') ? (v || null) : (k === 'doseReductionPct' ? Number(v || 0) : num(v)); }); return b; }
            function preview() {
                post(base + '/Preview', form()).then(function (p) {
                    if (!p.ok) return;
                    document.getElementById('pvBsa').textContent = p.bsa.toFixed(2);
                    document.getElementById('pvGfr').textContent = p.gfr == null ? '—' : p.gfr;
                    document.getElementById('pvRows').innerHTML = p.doses.map(function (d) {
                        var after = d.lifetimeMgM2 == null ? W.noLimit : '<span class="' + (d.priorMgM2 + d.cycleMgM2 > d.lifetimeMgM2 ? 'text-danger fw-bold' : 'text-muted') + '">' + W.ofN.replace('{0}', (d.priorMgM2 + d.cycleMgM2).toFixed(0)).replace('{1}', d.lifetimeMgM2.toFixed(0)) + '</span>';
                        return '<tr><td><bdi dir="ltr" class="fw-semibold">' + esc(d.drugName) + '</bdi></td><td class="hp-num" dir="ltr">' + esc(d.dose) + ' ' + esc(d.basis) + '</td><td>' + esc(d.route) + '</td><td class="hp-num">' + esc(d.days) +
                            '</td><td class="text-end hp-num fw-bold fs-6" dir="ltr">' + d.doseMg.toFixed(1) + ' mg</td><td class="text-end hp-num fs-8">' + after + '</td></tr>'; }).join('');
                    blocks = p.checks.some(function (x) { return x.blocks; });
                    document.getElementById('pvChecks').innerHTML = p.checks.map(function (x) { return '<span class="badge ' + (x.blocks ? 'badge-danger' : 'badge-light-primary') + ' fs-8">' + esc(x.text) + '</span>'; }).join('');
                    var rf = document.getElementById('pvRefusal'); rf.textContent = p.refusal || ''; rf.classList.toggle('d-none', !p.refusal);
                    document.getElementById('ovBox').classList.toggle('d-none', !blocks);
                });
            }
            if (panel) { panel.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(preview, 300); }); panel.addEventListener('change', function () { clearTimeout(timer); timer = setTimeout(preview, 100); }); preview(); }
            document.addEventListener('click', function (e) {
                var o = e.target.closest('[data-modal]'); if (o) { bootstrap.Modal.getOrCreateInstance(document.getElementById(o.getAttribute('data-modal'))).show(); return; }
                var vf = e.target.closest('[data-verify]');   // H181: the independent check
                if (vf) { cbConfirm(W.verify).then(function (ok) { if (!ok) return; vf.disabled = true; post(@Json.Serialize(Url.Content("~/Hospital/Oncology/Cycle/")) + vf.getAttribute('data-verify') + '/Verify', {}).then(done(vf)); }); return; }
                var rj = e.target.closest('[data-reject]');
                if (rj) { cbPrompt(W.reject, { kind: 'danger' }).then(function (why) { if (!why) return; rj.disabled = true; post(@Json.Serialize(Url.Content("~/Hospital/Oncology/Cycle/")) + rj.getAttribute('data-reject') + '/Reject', { reason: why }).then(done(rj)); }); return; }
                var g = e.target.closest('[data-give]');
                if (g) { cbConfirm(W.give).then(function (ok) { if (!ok) return; g.disabled = true; post(base + '/Give', form()).then(done(g)); }); return; }
                var h = e.target.closest('[data-hold-save]');
                if (h) { var m = document.getElementById('holdModal'), b = {}; m.querySelectorAll('[data-h]').forEach(function (i) { var k = i.getAttribute('data-h'), v = (i.value || '').trim(); b[k] = (k === 'until' || k === 'reason') ? (v || null) : num(v); });
                    cbConfirm(W.hold).then(function (ok) { if (!ok) return; h.disabled = true; post(base + '/Hold', b).then(done(h)); }); return; }
                var en = e.target.closest('[data-end]'); if (!en) return;
                if (en.getAttribute('data-end') === 'complete') cbConfirm(W.complete).then(function (ok) { if (ok) post(base + '/End', { completed: true }).then(done(en)); });
                else cbPrompt(W.stop, { title: W.stopTitle, kind: 'danger', textarea: true }).then(function (why) { if (why) post(base + '/End', { completed: false, reason: why }).then(done(en)); });
            });
        })();
    </script>
}
