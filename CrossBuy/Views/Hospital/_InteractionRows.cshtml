@using CrossBuy.BL
@using CrossBuy.Models.Context.Hospital
@model List<HospitalDrugInteraction>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ bool canKeep = ViewBag.CanKeep == true; }
@foreach (var r in Model)
{
    string sev = r.Severity == HospitalInteractionSeverity.Contraindicated ? "badge-danger" : r.Severity == HospitalInteractionSeverity.Major ? "badge-light-danger" : "badge-light-primary";
    <tr class="@(r.IsActive ? "" : "opacity-50")">
        <td class="ps-4"><div class="d-flex align-items-center">
                @{ string tone = r.Severity is HospitalInteractionSeverity.Contraindicated or HospitalInteractionSeverity.Major ? "danger" : "primary"; }
                <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-abstract-24 fs-3 text-@tone"></i></span></div>
                <div class="d-flex align-items-center flex-wrap gap-2" dir="ltr" style="justify-content:flex-start"><bdi class="fw-bold fs-6 text-gray-900">@r.DrugA</bdi><span class="text-muted fw-bold">+</span><bdi class="fw-bold fs-6 text-gray-900">@r.DrugB</bdi></div></div></td>
        <td><span class="badge @sev fs-7 fw-bold text-nowrap">@T["sev:" + r.Severity]</span></td>
        <td><div class="fs-7 fw-semibold text-gray-700" dir="auto">@DisplayName.Of(r.EffectAr, r.EffectEn)</div></td>
        <td>@if (r.IsActive) {<span class="badge badge-light-primary fs-7 fw-bold">@T["In use"]</span>} else {<span class="badge badge-light fs-7 fw-bold">@T["Not in use"]</span>}</td>
        <td class="text-end pe-4">@if (canKeep) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Edit"]" data-ds-edit="@r.ID" data-row="@System.Text.Json.JsonSerializer.Serialize(new { drugA = r.DrugA, drugB = r.DrugB, severity = r.Severity, effectAr = r.EffectAr, effectEn = r.EffectEn, isActive = r.IsActive })"><i class="ki-outline ki-pencil fs-4"></i></button> }</td>
    </tr>
}
