@using CrossBuy.BL
@using CrossBuy.Models.Context.Hospital
@model List<HospitalDrugInteraction>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ bool canKeep = ViewBag.CanKeep == true; }
@foreach (var r in Model)
{
    string sev = r.Severity == HospitalInteractionSeverity.Contraindicated ? "badge-danger" : r.Severity == HospitalInteractionSeverity.Major ? "badge-light-danger" : "badge-light-primary";
    <tr class="@(r.IsActive ? "" : "opacity-50")">
        <td><div class="d-flex align-items-center flex-wrap gap-2" dir="ltr" style="justify-content:flex-start"><bdi class="fw-bold text-gray-900">@r.DrugA</bdi><span class="text-muted">+</span><bdi class="fw-bold text-gray-900">@r.DrugB</bdi></div></td>
        <td><span class="badge @sev text-nowrap">@T["sev:" + r.Severity]</span></td>
        <td><div class="fs-7 text-gray-800" dir="auto">@DisplayName.Of(r.EffectAr, r.EffectEn)</div></td>
        <td>@if (r.IsActive) {<span class="badge badge-light-success">@T["In use"]</span>} else {<span class="badge badge-light">@T["Not in use"]</span>}</td>
        <td class="text-end">@if (canKeep) { <button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-ds-edit="@r.ID" data-row="@System.Text.Json.JsonSerializer.Serialize(new { drugA = r.DrugA, drugB = r.DrugB, severity = r.Severity, effectAr = r.EffectAr, effectEn = r.EffectEn, isActive = r.IsActive })">@T["Edit"]</button> }</td>
    </tr>
}
