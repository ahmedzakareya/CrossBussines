@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model (bool Ready, IReadOnlyList<HospitalQuestionnaireRow> Rows, int Total, int Urgent)
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H250 — the clinic's questionnaires: answered and not yet reviewed first (urgent at the top: a PHQ-9 with thoughts of
    self-harm, a severe score), waiting, all; send a questionnaire to a patient. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Questionnaires"].Value;
    string q = ViewBag.Q as string ?? "", view = ViewBag.View as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages; bool canConsult = ViewBag.CanConsult == true;
    string Link(int p, string? v = null) => Url.Action("Questionnaires", new { q, view = v ?? view, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Tone(string? s) => s switch { "Severe" or "ModeratelySevere" or "Positive" => "danger", "Moderate" => "info", _ => "primary" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Questionnaires"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Patient portal"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["Questionnaires"]</li></ul>
        </div>
        <div class="d-flex gap-2">
            @foreach (var (v, label) in new[] { ("", T["To review"].Value), ("pending", T["Waiting"].Value), ("all", T["All"].Value) }) {<a href="@Link(1, v)" class="btn btn-sm @(view == v ? "btn-primary" : "btn-light")">@label</a>}
            @if (canConsult && Model.Ready) {<button type="button" class="btn btn-sm btn-primary" data-qs-open><i class="ki-outline ki-send fs-4"></i>@T["Send a questionnaire"]</button>}
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready) {<div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalQuestionnaireService.NoTables]</div></div>}
        @if (Model.Urgent > 0) {<div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["{0} answered questionnaires need a clinician now (self-harm thoughts or a severe score)", Model.Urgent]</div></div>}
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title"><span class="card-label fw-bold text-gray-800">@T["Questionnaires"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("Questionnaires")"><input type="hidden" name="view" value="@view" />
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search a patient or questionnaire"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button></form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Rows.Count == 0) {<div class="text-center py-15"><i class="ki-outline ki-questionnaire-tablet fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No questionnaire here."]</div></div>}
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th>@T["Questionnaire"]</th><th>@T["Score"]</th><th>@T["Answers"]</th><th>@T["Date"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var x = r.Q;
                            <tr class="@(x.Urgent && x.ReviewedAt == null ? "bg-light-danger" : "")">
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Photo, DisplayName.Of(r.PatientName, r.PatientNameEn), 35)<div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = x.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><span class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn</span></div></div></td>
                                <td class="fw-bold hp-num" dir="ltr">@x.Instrument</td>
                                <td>@if (x.Score is int s) {<span class="fw-bold fs-5 hp-num">@s</span> <span class="badge badge-light-@Tone(x.Severity) fs-8">@T["sev:" + x.Severity]</span>@if (x.Urgent) {<span class="badge badge-danger fs-8 ms-1">@T["Urgent"]</span>}} else {<span class="badge badge-light fs-8">@T["qs:" + x.Status]</span>}</td>
                                <td class="fs-8 hp-num text-muted" dir="ltr">@x.Answers</td>
                                <td class="fs-8 hp-num" dir="ltr">@((x.CompletedAt ?? x.SentAt).ToLocalTime().ToString("dd/MM/yyyy", inv))</td>
                                <td class="text-end text-nowrap">@if (canConsult)
                                    {
                                        if (x.Status == HospitalQuestionnaireStatus.Completed && x.ReviewedAt == null) {<button type="button" class="btn btn-sm btn-light-primary" data-qs-review="@x.ID">@T["Mark as reviewed"]</button>}
                                        else if (x.Status == HospitalQuestionnaireStatus.Pending) {<button type="button" class="btn btn-sm btn-icon btn-light" title="@T["Withdraw"]" data-bs-toggle="tooltip" data-qs-cancel="@x.ID"><i class="ki-outline ki-cross-square fs-3"></i></button>}
                                    }</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

@if (canConsult && Model.Ready)
{
<div class="modal fade" id="qsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-500px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Send a questionnaire"]</h1><div class="text-muted fw-semibold fs-6">@T["The patient answers it on the portal."]</div></div>
        <div class="mb-5"><label class="required fs-6 fw-semibold mb-2">@T["Patient"]</label><select class="form-select form-select-solid" data-qs="patient" data-placeholder="@T["Choose the patient"]"><option></option></select></div>
        <div class="mb-5"><label class="required fs-6 fw-semibold mb-2">@T["Questionnaire"]</label><select class="form-select form-select-solid" data-qs="instrument">@foreach (var i in HospitalQuestionnaireRules.All) {<option value="@i.Code">@DisplayName.Of(i.Ar, i.En)</option>}</select></div>
        <div><label class="fs-6 fw-semibold mb-2">@T["Before"]</label><input type="date" class="form-control form-control-solid" data-qs="due" /></div>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-qs-send>@T["Send"]</button></div>
    </div>
</div></div></div>
}
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Questionnaires")), patients = @Json.Serialize(Url.Action("QuestionnairePatients"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), cancel: @Json.Serialize(T["Withdraw this questionnaire?"].Value) }, m = document.getElementById('qsModal'), isAr = document.documentElement.dir === 'rtl';
            function post(u, b) { return fetch(root + u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function after(res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }
            if (m) {
                var sel = m.querySelector('[data-qs=patient]');
                $(sel).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', dropdownParent: $(m), placeholder: sel.getAttribute('data-placeholder'),
                    ajax: { url: patients, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-qs-open],[data-qs-send],[data-qs-review],[data-qs-cancel]'); if (!t) return;
                if (t.hasAttribute('data-qs-open')) { bootstrap.Modal.getOrCreateInstance(m).show(); return; }
                if (t.hasAttribute('data-qs-send')) { post('', { patientId: +m.querySelector('[data-qs=patient]').value, instrument: m.querySelector('[data-qs=instrument]').value, dueDate: m.querySelector('[data-qs=due]').value || null }).then(after); return; }
                if (t.hasAttribute('data-qs-review')) { post('/' + t.getAttribute('data-qs-review') + '/Review').then(after); return; }
                cbConfirm(W.cancel, { kind: 'danger' }).then(function (ok) { if (ok) post('/' + t.getAttribute('data-qs-cancel') + '/Cancel').then(after); });
            });
        })();
    </script>
}
