@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalDisposalRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H135: one act per row, in the theme's table widget, the newest first. Each row shows:
     · the act's number and day;
     · the medicine and batch, the store;
     · destroyed (how) or returned (to whom);
     · quantity and value at cost;
     · the document the inventory or the payables wrote;
     · the witness's face, or who returned it. *@
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    int dp = ViewBag.MoneyDp is int d ? d : 2;
}
@foreach (var r in Model)
{
    var x = r.D; bool destroyed = x.Kind == HospitalDisposalKind.Destroyed;
    <tr>
        <td class="ps-4 text-nowrap"><span class="text-gray-900 fw-bold hp-num d-block">@x.DisposalNo</span><span class="text-muted fs-8 hp-num" data-fmt data-utc="@x.DoneAt.ToString("o")">@x.DoneAt.ToLocalTime().ToString("yyyy-MM-dd")</span></td>
        <td><div class="d-flex align-items-center">
            <div class="symbol symbol-40px me-3 flex-shrink-0"><span class="symbol-label bg-light-@(destroyed ? "danger" : "primary")"><i class="ki-outline ki-@(destroyed ? "trash" : "arrow-circle-left") fs-3 text-@(destroyed ? "danger" : "primary")"></i></span></div>
            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold"><bdi>@DisplayName.Of(r.Name, r.NameEn)</bdi></span><span class="text-muted fs-7"><bdi dir="ltr">@r.Code</bdi> · <bdi dir="ltr">@x.BatchNo</bdi></span></div>
        </div></td>
        <td><bdi class="text-gray-800 fw-semibold">@DisplayName.Of(r.StoreName, r.StoreNameEn)</bdi></td>
        <td><span class="badge badge-light-@(destroyed ? "danger" : "primary") fs-7 fw-bold">@T["dsp:" + x.Kind]</span>
            <span class="text-muted fs-8 d-block mt-1">@T["dspr:" + x.Reason]@if (destroyed && x.Method != null) {<text> · @T["dspm:" + x.Method]</text>}@if (!destroyed && r.Vendor != null) {<text> · </text><bdi>@r.Vendor</bdi>}</span></td>
        <td class="text-end"><span class="text-gray-900 fw-bold hp-num">@x.Qty.ToString("0.###", inv)</span></td>
        <td class="text-end"><span class="fw-bold hp-num text-@(destroyed ? "danger" : "success")">@x.Value.ToString("N" + dp, inv)</span></td>
        <td>@if (x.DocumentNo != null) {<span class="badge badge-light fs-7 fw-bold hp-num">@x.DocumentNo</span>} else {<span class="text-gray-400">—</span>}</td>
        <td class="pe-4">@if (r.Witness != null)
            {
                <div class="d-flex align-items-center"><div class="symbol symbol-30px symbol-circle me-2 flex-shrink-0">@if (r.WitnessPhoto != null) {<img src="@r.WitnessPhoto" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(r.WitnessEn ?? r.Witness)</span>}</div>
                    <span class="text-gray-800 fw-semibold fs-7">@DisplayName.Of(r.Witness, r.WitnessEn)</span></div>
            }
            else {<span class="text-muted fs-7">@DisplayName.Of(r.DoneBy ?? "—", r.DoneByEn)</span>}</td>
    </tr>
}
