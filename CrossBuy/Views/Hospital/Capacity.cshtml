@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalCapacityCentre
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H239 — the capacity centre: the house's beds now, the next four days (occupied − expected discharges + expected
    admissions), each ward's occupancy, the barriers holding discharges, and every inpatient with the expected discharge
    (the team's plan, or the length-of-stay estimate). The plan is set in a modal. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Capacity centre"].Value;
    string q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages; bool canAdmit = ViewBag.CanAdmit == true;
    string Link(int p) => Url.Action("Capacity", new { q, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Tone(decimal? pct) => HospitalCapacityRules.Level(pct) switch { "Critical" => "danger", "Strain" => "info", _ => "primary" };
    string Day(DateTime d) => d.ToString("ddd dd/MM", System.Globalization.CultureInfo.CurrentUICulture);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Capacity centre"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Inpatient"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Capacity centre"]</li>
            </ul>
        </div>
        @* H256: the read-only downtime copy, printed through Report Studio *@
        <a href="@Url.Action("Viewer", "Reports", new { id = CrossBuy.BL.Reporting.HospitalReportCodes.DowntimeCensus, run = true })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-printer fs-4"></i>@T["Downtime copy"]</a>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalCapacityService.NoTables]</div></div>
        }
        <div class="row g-5 mb-5">
            @foreach (var (value, label, sub, tone, icon) in new[]
            {
                ((Model.OccupancyPct?.ToString("0", inv) ?? "—") + "%", T["Occupancy"].Value, string.Format(T["{0} of {1} beds in service"].Value, Model.Occupied, Model.InService), Tone(Model.OccupancyPct), "chart-pie-simple"),
                (Model.Vacant.ToString(inv), T["Vacant beds"].Value, string.Format(T["{0} cleaning · {1} reserved"].Value, Model.Cleaning, Model.Reserved), "primary", "home-2"),
                (Model.DischargesToday.ToString(inv), T["Expected discharges today"].Value, string.Format(T["{0} tomorrow"].Value, Model.Forecast.Count > 1 ? Model.Forecast[1].Discharges : 0), "primary", "exit-right"),
                (Model.ErWaiting.ToString(inv), T["Emergency at disposition"].Value, string.Format(T["{0} in the department"].Value, Model.ErInDepartment), Model.ErWaiting > Model.Vacant ? "danger" : "primary", "pulse"),
            })
            {
                <div class="col-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body d-flex align-items-center gap-4 py-6">
                    <span class="symbol symbol-50px"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-2x text-@tone"></i></span></span>
                    <div class="d-flex flex-column"><span class="fs-2hx fw-bold text-gray-900 hp-num" dir="ltr" style="text-align:start">@value</span><span class="text-gray-700 fw-semibold fs-6">@label</span><span class="text-muted fs-7">@sub</span></div>
                </div></div></div>
            }
        </div>

        <div class="row g-5 mb-5">
            <div class="col-xl-7">
                <div class="card card-flush h-100">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["The next four days"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Occupied − expected discharges + expected admissions (the same weekday over 8 weeks)"]</span></h3></div>
                    <div class="card-body pt-2">
                        <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted fs-7"><th>@T["Day"]</th><th class="text-center">@T["Occupied"]</th><th class="text-center">@T["Discharges"]</th><th class="text-center">@T["Admissions"]</th><th class="min-w-200px">@T["End of day"]</th></tr></thead>
                            <tbody>
                            @foreach (var d in Model.Forecast)
                            {
                                var pct = d.OccupancyPct ?? 0;
                                <tr>
                                    <td class="fw-bold text-gray-800">@Day(d.Day)@if (d.Day == Model.Today) {<span class="badge badge-light-primary fs-8 ms-2">@T["Today"]</span>}</td>
                                    <td class="text-center hp-num">@d.Occupied</td>
                                    <td class="text-center hp-num text-primary">−@d.Discharges</td>
                                    <td class="text-center hp-num">+@d.Admissions</td>
                                    <td><div class="d-flex align-items-center gap-3"><div class="progress h-8px flex-grow-1 bg-light"><div class="progress-bar bg-@Tone(d.OccupancyPct)" style="width:@(Math.Min(100, pct).ToString(inv))%"></div></div>
                                        <span class="fw-bold hp-num text-@Tone(d.OccupancyPct) w-75px text-end" dir="ltr">@d.Projected · @(d.OccupancyPct?.ToString("0", inv) ?? "—")%</span></div></td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                        <div class="text-muted fs-8 mt-3">@T["Strain at 85 % occupancy, critical at 95 %."]</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="card card-flush h-100">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Wards"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Occupancy of the beds in service"]</span></h3></div>
                    <div class="card-body pt-2">
                        @if (Model.Wards.Count == 0) {<div class="text-muted fs-7">@T["No bed is set up yet."]</div>}
                        @foreach (var w in Model.Wards)
                        {
                            <div class="d-flex align-items-center gap-3 py-2">
                                <span class="fw-bold text-gray-800 w-150px text-truncate">@DisplayName.Of(w.Name, w.NameEn)</span>
                                <div class="progress h-8px flex-grow-1 bg-light"><div class="progress-bar bg-@Tone(w.OccupancyPct)" style="width:@(Math.Min(100m, w.OccupancyPct ?? 0).ToString(inv))%"></div></div>
                                <span class="fs-7 hp-num text-gray-700 w-100px text-end" dir="ltr">@w.Occupied/@w.InService · @(w.OccupancyPct?.ToString("0", inv) ?? "—")%</span>
                            </div>
                        }
                        <div class="separator separator-dashed my-4"></div>
                        <div class="fw-bold text-gray-800 mb-2">@T["What holds discharges"]</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var b in Model.BarrierCounts.Where(x => x.Value > 0)) {<span class="badge badge-light-danger fs-7">@T["bar:" + b.Key] <span class="hp-num ms-1">@b.Value</span></span>}
                            @if (!Model.BarrierCounts.Any(x => x.Value > 0)) {<span class="text-muted fs-7">@T["No barrier recorded."]</span>}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Inpatients and expected discharge"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["The team's plan when set, otherwise the median stay of past patients with the same diagnosis"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("Capacity")">
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-225px ps-12" placeholder="@T["Search a patient, bed or diagnosis"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Patients.Count == 0)
                {
                    <div class="text-center py-15"><i class="ki-outline ki-home-2 fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No inpatient here."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th>@T["Bed"]</th><th class="min-w-150px">@T["Diagnosis"]</th><th class="w-75px">@T["Stay"]</th><th class="min-w-150px">@T["Expected discharge"]</th><th class="min-w-150px">@T["Barriers"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.Patients)
                        {
                            var bars = (p.Barriers ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <tr>
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(p.Photo, DisplayName.Of(p.Name, p.NameEn), 35)<a href="@Url.Action("Patient", new { id = p.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(p.Name, p.NameEn)</a></div></td>
                                <td><span class="fw-bold hp-num" dir="ltr">@p.Bed</span>@if (p.Ward != null) {<div class="text-muted fs-8">@DisplayName.Of(p.Ward, p.WardEn)</div>}</td>
                                <td class="text-gray-700 fs-7" dir="auto">@p.Diagnosis</td>
                                <td class="hp-num" dir="ltr">@p.LosDays @T["d"]</td>
                                <td>@if (p.Expected is DateTime e)
                                    {
                                        <span class="fw-bold @(e == Model.Today ? "text-primary" : "text-gray-800")">@Day(e)</span>
                                        if (p.Planned) {<span class="badge badge-light-primary fs-8 ms-1">@T["conf:" + p.Confidence]</span>} else {<span class="badge badge-light fs-8 ms-1" title="@T["Estimated from past stays"]" data-bs-toggle="tooltip">@T["Estimate"]</span>}
                                    }
                                    else {<span class="text-muted fs-7">@T["Not known"]</span>}</td>
                                <td>@foreach (var b in bars) {<span class="badge badge-light-danger fs-8 me-1 mb-1">@T["bar:" + b]</span>}@if (p.Note != null) {<div class="text-muted fs-8" dir="auto">@p.Note</div>}</td>
                                <td class="text-end text-nowrap">@if (canAdmit && Model.Ready)
                                    {<button type="button" class="btn btn-sm btn-light-primary" data-cap="@p.AdmissionId" data-name="@DisplayName.Of(p.Name, p.NameEn)" data-date="@(p.Planned ? p.Expected!.Value.ToString("yyyy-MM-dd", inv) : "")"
                                        data-conf="@p.Confidence" data-bars="@p.Barriers" data-note="@p.Note">@T["Plan"]</button>}</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

@if (canAdmit && Model.Ready)
{
    <div class="modal fade" id="capModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body px-10 pt-0 pb-10">
            <div class="mb-8 text-center"><h1 class="mb-3">@T["Discharge plan"]</h1><div class="text-muted fw-semibold fs-6" data-cap-f="name"></div></div>
            <div class="row g-5">
                <div class="col-md-6"><label class="required fs-6 fw-semibold mb-2">@T["Expected discharge"]</label><input type="date" class="form-control form-control-solid" data-cap-f="date" min="@Model.Today.ToString("yyyy-MM-dd", inv)" /></div>
                <div class="col-md-6"><label class="required fs-6 fw-semibold mb-2">@T["How sure"]</label><select class="form-select form-select-solid" data-cap-f="conf">@foreach (var c in HospitalDischargeConfidence.All) {<option value="@c">@T["conf:" + c]</option>}</select></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Barriers"]</label>
                    <div class="d-flex flex-wrap gap-4">@foreach (var b in HospitalDischargeBarrier.All) {<label class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" value="@b" data-cap-bar /><span class="form-check-label fs-7">@T["bar:" + b]</span></label>}</div></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Note"]</label><input class="form-control form-control-solid" maxlength="300" dir="auto" data-cap-f="note" /></div>
            </div>
            <div class="d-flex justify-content-between pt-8">
                <button type="button" class="btn btn-light-danger" data-cap-clear>@T["Clear the plan"]</button>
                <div><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-cap-save>@T["Save"]</button></div>
            </div>
        </div>
    </div></div></div>
}
@section Scripts {
    <script>
        (function () {
            var m = document.getElementById('capModal'); if (!m) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Capacity/")), id = 0;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), clear: @Json.Serialize(T["Clear this discharge plan?"].Value) };
            function f(k) { return m.querySelector('[data-cap-f=' + k + ']'); }
            function post(u, b) { return fetch(root + id + u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function after(res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-cap],[data-cap-save],[data-cap-clear]'); if (!t) return;
                if (t.hasAttribute('data-cap')) {
                    id = +t.getAttribute('data-cap'); f('name').textContent = t.getAttribute('data-name');
                    f('date').value = t.getAttribute('data-date') || ''; f('note').value = t.getAttribute('data-note') || '';
                    if (t.getAttribute('data-conf')) f('conf').value = t.getAttribute('data-conf');
                    var bars = (t.getAttribute('data-bars') || '').split(',');
                    m.querySelectorAll('[data-cap-bar]').forEach(function (c) { c.checked = bars.indexOf(c.value) >= 0; });
                    m.querySelector('[data-cap-clear]').classList.toggle('d-none', !t.getAttribute('data-date'));
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                if (t.hasAttribute('data-cap-clear')) { cbConfirm(W.clear, { kind: 'danger' }).then(function (ok) { if (ok) post('/Plan/Clear').then(after); }); return; }
                var bars2 = []; m.querySelectorAll('[data-cap-bar]:checked').forEach(function (c) { bars2.push(c.value); });
                t.disabled = true;
                post('/Plan', { expectedDate: f('date').value || '0001-01-01', confidence: f('conf').value, barriers: bars2, note: f('note').value || null }).then(function (res) { t.disabled = false; after(res); });
            });
        })();
    </script>
}
