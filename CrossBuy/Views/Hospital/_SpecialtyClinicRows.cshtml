@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalClinicVisitRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@foreach (var r in Model)
{
    var age = HospitalPatientService.AgeOn(r.BirthDate, DateTime.UtcNow);
    bool signed = r.Status == HospitalEncounterStatus.Signed;
    @* H127: the theme's table rows (demo39 widgets/tables) — the patient with their photo, the doctor with theirs, badges for the forms and the state *@
    <tr>
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-45px symbol-circle me-3 flex-shrink-0">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.NameEn)" />} else {<span class="symbol-label fw-bold fs-7 hp-initials">@HospitalUi.Initials(r.NameEn)</span>}</div>
            <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = r.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(r.Name, r.NameEn)</a>
                <span class="text-gray-500 fw-semibold fs-7"><bdi class="hp-num">@r.Mrn</bdi> · @if (age != null) {<span class="text-nowrap"><bdi class="hp-num">@age</bdi>&nbsp;@T["y"]</span><text> · </text>}@T["sex:" + r.Sex]</span></div>
        </div></td>
        <td class="text-nowrap"><span class="text-gray-800 fw-bold fs-6 hp-num d-block" dir="ltr">@HospitalNursingService.UtcToWard(r.StartedAt).ToString("HH:mm")</span><span class="text-gray-500 fw-semibold fs-7 hp-num" dir="ltr">@HospitalNursingService.UtcToWard(r.StartedAt).ToString("yyyy-MM-dd")</span></td>
        <td><div class="d-flex align-items-center">
            <div class="symbol symbol-35px symbol-circle flex-shrink-0 me-3">@if (!string.IsNullOrEmpty(r.DoctorPhoto)) {<img src="@r.DoctorPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.DoctorEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.DoctorEn)</span>}</div>
            <span class="text-gray-800 fw-bold fs-7">@DisplayName.Of(r.Doctor, r.DoctorEn)</span></div></td>
        <td class="text-gray-600 fw-semibold fs-7 mw-250px">@if (r.Complaint != null) {<bdi>@r.Complaint</bdi>} else {<span class="text-gray-400">—</span>}</td>
        <td>@if (r.Forms == 0) {<span class="text-gray-400">—</span>} else {<span class="badge badge-light-@(r.SignedForms == r.Forms ? "primary" : "primary") fs-7 fw-bold hp-num">@T["{0} of {1}", r.SignedForms, r.Forms]</span>}</td>
        <td>@if (signed) {<span class="badge badge-light-primary fs-7 fw-bold">@T["Signed"]</span>} else {<span class="badge badge-light-primary fs-7 fw-bold">@T["Visit open"]</span>}</td>
        <td class="text-end pe-4"><a href="@Url.Action("SpecialtyVisit", new { id = r.EncounterId })" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Open the visit"]" data-bs-toggle="tooltip"><i class="ki-outline ki-eye fs-3"></i></a></td>
    </tr>
}
