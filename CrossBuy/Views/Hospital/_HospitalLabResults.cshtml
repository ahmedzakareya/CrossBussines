@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalLabHistory
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* A patient's verified lab results — the patient file's tab and the consultation's side card share this one view. *@
@{
    string Num(decimal? v, int dec) => HospitalUi.LabNum(v, dec);
}
<div class="card @(Model.Compact ? "mb-5" : "")">
    <div class="card-header border-0 pt-6">
        <div class="card-title align-items-start flex-column m-0">
            <span class="card-label fw-bold text-gray-900 fs-4">@T["Lab results"]</span>
            @if (Model.Pending > 0) { <span class="text-muted mt-1 fw-semibold fs-7"><span class="hp-num">@Model.Pending</span> @T["still in the lab — shown once verified"]</span> }
        </div>
    </div>
    <div class="card-body pt-2">
        @if (Model.Verified.Count == 0) { <div class="text-center text-muted py-8 fs-7">@T["No verified lab results yet."]</div> }
        @foreach (var (o, results) in Model.Verified)
        {
            <div class="py-3 hp-row">
                <div class="d-flex flex-stack mb-2">
                    <div class="fw-bold text-gray-800">@DisplayName.Of(o.Name, o.NameEn)@if (o.IsCritical) {<span class="badge badge-danger fs-9 ms-2">@T["Critical"]</span>}</div>
                    <a href="@Url.Action("LabOrder", new { id = o.ID })" class="text-muted text-hover-primary fs-8 hp-num" data-fmt data-utc="@o.VerifiedAt?.ToString("o")">@o.VerifiedAt?.ToLocalTime().ToString("yyyy-MM-dd")</a>
                </div>
                <table class="table table-sm align-middle mb-0 fs-7 gy-1">
                    <tbody>
                        @foreach (var r in results)
                        {
                            var shown = r.Value != null ? Num(r.Value, r.Decimals) : r.TextValue ?? "—";
                            <tr>
                                <td class="text-gray-700">@DisplayName.Of(r.Name, r.NameEn)</td>
                                <td class="text-end text-nowrap"><bdi dir="ltr" class="hp-num @(r.Flag != HospitalLabFlag.Normal ? "hp-result-out" : "fw-bold text-gray-900")">@shown</bdi> @if (r.Unit != null) {<span class="text-muted fs-8" dir="ltr">@r.Unit</span>}</td>
                                @if (!Model.Compact) { <td class="text-muted hp-num text-nowrap"><bdi dir="ltr">@HospitalUi.LabRange(r.RefLow, r.RefHigh, r.Decimals)</bdi></td> }
                                <td class="text-center w-40px">@if (r.Flag != HospitalLabFlag.Normal) {<span class="hp-flag hp-flag-@r.Flag">@r.Flag</span>}</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Compact && !string.IsNullOrWhiteSpace(o.Comment)) { <div class="text-muted fs-8 mt-2"><i class="ki-outline ki-message-text fs-7 me-1"></i>@o.Comment</div> }
            </div>
        }
    </div>
</div>
