@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalCompoundStats
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H153 — compounding: the worklist of sterile preparations (demo39 stat tiles + the theme's table widget, cbServerList),
    the batch record in the theme's modal (what is prepared, the diluent and volume, the batches, the storage and the
    beyond-use time — capped by its storage), the independent check (another pharmacist releases or rejects, confirmed
    first), and the bag label through Report Studio.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Compounding"].Value;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    bool canPharmacy = ViewBag.CanPharmacy == true;
    var tiles = new (string Label, int N, string Note, string Icon, bool Alert, string Filter)[] {
        (T["To prepare"].Value, Model.ToMake, T["chemotherapy by injection, and rejected ones"].Value, "ki-flask", Model.ToMake > 0, HospitalCompoundingService.Filter.ToMake),
        (T["Waiting for the check"].Value, Model.ToCheck, T["another pharmacist releases them"].Value, "ki-shield-search", Model.ToCheck > 0, HospitalCompoundingService.Filter.ToCheck),
        (T["Released today"].Value, Model.ReleasedToday, T["ready to give before their time"].Value, "ki-check-circle", false, HospitalCompoundingService.Filter.Released) };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Compounding"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Pharmacy")" class="text-muted text-hover-primary">@T["Pharmacy"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Sterile preparations"]</li>
            </ul>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <a href="@Url.Action("Pharmacy")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-capsule fs-4"></i>@T["Dispensing queue"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in tiles)
            {
                <div class="col-sm-4">
                    <a href="#@s.Filter" class="card card-flush h-100 hover-elevate-up">
                        <div class="card-body d-flex align-items-center gap-5 py-6">
                            <div class="symbol symbol-50px"><span class="symbol-label bg-light-@(s.Alert ? "danger" : "primary")"><i class="ki-outline @s.Icon fs-2x text-@(s.Alert ? "danger" : "primary")"></i></span></div>
                            <div class="d-flex flex-column"><span class="fs-2hx fw-bold text-@(s.Alert ? "danger" : "gray-900") lh-1 hp-num">@s.N</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Label</span><span class="text-gray-400 fs-8">@s.Note</span></div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <div class="card card-flush">
            <div class="card-header align-items-center pt-5 gap-2 gap-md-5 border-0">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Preparations"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                    <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by patient, medicine or number…"]" /></div>
                    <div class="w-175px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_filter">
                        <option value="">@T["All"]</option>
                        <option value="@HospitalCompoundingService.Filter.ToMake">@T["To prepare"]</option>
                        <option value="@HospitalCompoundingService.Filter.ToCheck">@T["Waiting for the check"]</option>
                        <option value="@HospitalCompoundingService.Filter.Released">@T["Released"]</option>
                    </select></div>
                    <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                    <button type="button" id="f_reset" class="btn btn-sm btn-icon btn-light btn-active-light-primary" title="@T["Reset"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrows-circle fs-3"></i></button>
                </div>
            </div>
            <div class="card-body pt-2">
                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                    <thead><tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-200px rounded-start">@T["Patient"]</th><th class="min-w-200px">@T["Preparation"]</th><th class="min-w-200px">@T["Batch record"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th>
                    </tr></thead>
                    <tbody id="rows"><tr id="loadingRow"><td colspan="5" class="text-center text-muted py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>@T["Loading…"]</td></tr>
                        <tr id="emptyRow" class="d-none"><td colspan="5" class="text-center py-12"><i class="ki-outline ki-flask fs-3x text-gray-300 mb-4 d-block"></i><span class="fs-6 fw-semibold text-gray-600">@T["Nothing matches."]</span></td></tr></tbody>
                </table></div>
                <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
            </div>
        </div>
    </div></div>
</div>

@if (canPharmacy)
{
    <div class="modal fade" id="cmpRecord" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold mb-0">@T["Batch record"]</h2>
            <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-8 px-lg-10">
            <div class="fw-bold text-gray-900 fs-5 mb-1" data-c-product></div>
            <div class="text-gray-600 fs-7 mb-6" data-c-patient></div>
            <div class="row g-5">
                <div class="col-md-6" data-c-kind-row><label class="fs-6 fw-semibold mb-2">@T["What is prepared"]</label>
                    <select class="form-select form-select-solid" data-c="kind" data-control="select2" data-dropdown-parent="#cmpRecord" data-hide-search="true">
                        <option value="@HospitalCompoundKind.IV">@T["cmpk:" + HospitalCompoundKind.IV]</option><option value="@HospitalCompoundKind.TPN">@T["cmpk:" + HospitalCompoundKind.TPN]</option>
                    </select></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Diluent"]</label><input class="form-control form-control-solid" data-c="diluent" placeholder="@T["e.g. Sodium chloride 0.9%"]" /></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Final volume (mL)"]</label><input type="number" min="0" step="any" class="form-control form-control-solid hp-num" dir="ltr" data-c="finalVolumeMl" /></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Drug batch"]</label><input class="form-control form-control-solid hp-num" dir="ltr" data-c="drugBatch" /></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Diluent batch"]</label><input class="form-control form-control-solid hp-num" dir="ltr" data-c="diluentBatch" /></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Storage"]</label>
                    <select class="form-select form-select-solid" data-c="storage" data-control="select2" data-dropdown-parent="#cmpRecord" data-hide-search="true">
                        @foreach (var st in HospitalCompoundStorage.All) { <option value="@st">@T["cmps:" + st] (@string.Format(T["up to {0} h"].Value, HospitalCompoundRules.CapHours(st)))</option> }
                    </select></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Beyond-use time (hours)"]</label><input type="number" min="1" max="24" step="1" class="form-control form-control-solid hp-num" dir="ltr" data-c="budHours" value="12" /></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Notes"]</label><textarea class="form-control form-control-solid" rows="2" data-c="notes"></textarea></div>
            </div>
            <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-c-save>@T["Save the batch record"]</button></div>
        </div>
    </div></div></div>
}

@await Html.PartialAsync("_ReportPreviewModal", (object)T["Compounding"].Value)

@section Scripts {
    <script>
        (function () {
            var f = document.getElementById('f_filter');
            function fromHash() { var h = (location.hash || '').replace('#', '');
                if (!h || !Array.prototype.some.call(f.options, function (o) { return o.value === h; })) return false;
                f.value = h; if (window.jQuery) jQuery(f).trigger('change.select2'); return true; }
            fromHash();
            var list = cbServerList({ url: @Json.Serialize(Url.Action("CompoundingData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('filter', f.value); } });
            window.addEventListener('hashchange', function () { if (fromHash()) list.reload(); });
            @if (canPharmacy)
            {
                <text>
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value, m = document.getElementById('cmpRecord'), cur = null;
                document.body.appendChild(m);
                var base = @Json.Serialize(Url.Action("Pharmacy")), W = { saved: @Json.Serialize(T["Saved"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value),
                    ask: @Json.Serialize(T["Save the batch record of {0}? Another pharmacist checks it before it is given."].Value),
                    release: @Json.Serialize(T["Release {0}? You confirm the product, the dose, the diluent, the label and the beyond-use time."].Value),
                    reject: @Json.Serialize(T["Why is {0} rejected? It is made again."].Value), released: @Json.Serialize(T["Released: it may be given before its beyond-use time"].Value) };
                function post(url, body) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
                function toast(k, s) { if (window.toastr) toastr[k](s); }
                function open(d) {
                    cur = d;
                    m.querySelector('[data-c-product]').textContent = d.product; m.querySelector('[data-c-patient]').textContent = d.patient;
                    m.querySelector('[data-c-kind-row]').classList.toggle('d-none', d.required);
                    m.querySelectorAll('input[data-c],textarea[data-c]').forEach(function (i) { i.value = i.getAttribute('data-c') === 'budHours' ? '12' : ''; });
                    bootstrap.Modal.getOrCreateInstance(m).show();
                }
                document.addEventListener('click', function (e) {
                    var p = e.target.closest('[data-c-prepare]');
                    if (p) { e.preventDefault(); open({ dispense: p.getAttribute('data-dispense'), line: p.getAttribute('data-c-prepare'), product: p.getAttribute('data-product'), patient: p.getAttribute('data-patient'), required: p.hasAttribute('data-required') }); return; }
                    var sv = e.target.closest('[data-c-save]');
                    if (sv) {
                        var v = function (k) { return m.querySelector('[data-c="' + k + '"]').value; };
                        var body = { kind: v('kind'), diluent: v('diluent'), finalVolumeMl: v('finalVolumeMl') ? +v('finalVolumeMl') : null, drugBatch: v('drugBatch'), diluentBatch: v('diluentBatch'),
                            storage: v('storage'), budHours: +v('budHours') || 0, notes: v('notes') };
                        cbConfirm(W.ask.replace('{0}', cur.product), { kind: 'primary' }).then(function (ok) {
                            if (!ok) return; sv.disabled = true;
                            post(base + '/' + cur.dispense + '/Lines/' + cur.line + '/Compound', body).then(function (r) {
                                sv.disabled = false; if (!r.ok) { toast('error', r.error || W.failed); return; }
                                bootstrap.Modal.getOrCreateInstance(m).hide(); toast('success', W.saved); list.reload(); });
                        });
                        return;
                    }
                    var c = e.target.closest('[data-c-check]');
                    if (c) {
                        e.preventDefault();
                        var release = c.getAttribute('data-release') === '1', name = c.getAttribute('data-no'), url = @Json.Serialize(Url.Action("Compounding")) + '/' + c.getAttribute('data-c-check') + '/Check';
                        var go = function (reason) { post(url, { release: release, reason: reason || null }).then(function (r) {
                            if (!r.ok) { toast('error', r.error || W.failed); return; } toast('success', release ? W.released : W.saved); list.reload(); }); };
                        if (release) cbConfirm(W.release.replace('{0}', name), { kind: 'primary' }).then(function (ok) { if (ok) go(); });
                        else cbPrompt(W.reject.replace('{0}', name), { textarea: true }).then(function (why) { if (why != null) go(why); });
                    }
                });
                // the dispense card's "prepare" link opens the record for its line at once
                var want = @Json.Serialize(ViewBag.OpenRecord);
                if (want) open(want);
                </text>
            }
        })();
    </script>
}
