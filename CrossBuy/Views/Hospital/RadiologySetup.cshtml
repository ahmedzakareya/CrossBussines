@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalRadSetupRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Exams & rooms"].Value;
    bool canManage = ViewBag.CanManage == true;
    var rooms = (ViewBag.Rooms as IReadOnlyList<HospitalRadRoom>) ?? Array.Empty<HospitalRadRoom>();
    string ro = canManage ? "" : "disabled";
    bool empty = rooms.Count == 0 || Model.Any(m => m.Exam == null);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Exams & rooms"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Radiology")" class="text-muted text-hover-primary">@T["Radiology"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Exams & rooms"]</li>
            </ul>
        </div>
        @if (canManage && empty)
        {
            <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
                <button type="button" class="btn btn-sm btn-light-primary" data-seed data-confirm="@T["Load the standard rooms and the setup of the starter imaging exams?"]"><i class="ki-outline ki-arrow-down fs-4"></i>@T["Load the standard rooms & exams"]</button>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H127: the machines — demo39 widgets/tables (table widget) *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Imaging rooms"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Each machine takes the patients of its modality; one in maintenance takes nobody"]</span>
                </h3>
                <div class="card-toolbar"><span class="badge badge-light-primary fs-7 fw-bold hp-num">@rooms.Count</span></div>
            </div>
            <div class="card-body pt-2">
                <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0 fs-7">
                    <thead><tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-80px rounded-start">@T["Code"]</th><th class="min-w-150px">@T["Name"]</th><th class="min-w-150px">@T["Name (English)"]</th><th class="min-w-150px">@T["Modality"]</th><th class="w-50px">@T["Active"]</th><th class="min-w-100px">@T["State"]</th><th class="pe-4 w-60px rounded-end"></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var m in rooms.Append(null))
                        {
                            if (m == null && !canManage) { continue; }
                            <tr data-room-row data-id="@m?.ID">
                                <td class="ps-4"><input class="form-control form-control-sm form-control-solid hp-num" dir="ltr" data-k="code" value="@m?.Code" maxlength="20" placeholder="@(m == null ? T["New"].Value : "")" @ro /></td>
                                <td><input class="form-control form-control-sm form-control-solid" data-k="name" value="@m?.Name" @ro /></td>
                                <td><input class="form-control form-control-sm form-control-solid" dir="ltr" data-k="nameEn" value="@m?.NameEn" @ro /></td>
                                <td><select class="form-select form-select-sm form-select-solid" data-k="modality" data-control="select2" data-hide-search="true" @ro>
                                    @foreach (var mod in HospitalRadModality.All) { <option value="@mod" selected="@(m?.Modality == mod)">@T["mod:" + mod]</option> }
                                </select></td>
                                <td><div class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-k="isActive" @(m == null || m.IsActive ? "checked" : "") @ro /></div></td>
                                <td>@if (m != null) { if (m.InMaintenance) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Maintenance"]</span>} else {<span class="badge badge-light-primary fs-7 fw-bold">@T["Working"]</span>}}</td>
                                <td class="text-end pe-4">@if (canManage) {<button type="button" class="btn btn-sm btn-icon @(m == null ? "btn-primary" : "btn-bg-light btn-active-color-primary")" data-save-room title="@(m == null ? T["Add"] : T["Save"])" data-bs-toggle="tooltip"><i class="ki-outline @(m == null ? "ki-plus" : "ki-check") fs-3"></i></button>}</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            </div>
        </div>

        <div class="notice d-flex rounded border border-primary border-dashed bg-light-primary p-6 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="mb-3 mb-md-0 fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Every imaging exam is a service of the Radiology category"]</h4>
                    <div class="fs-6 text-gray-700">@T["Its price lives in the service catalogue; here are its modality, whether it uses contrast, and the text its report starts from."]</div>
                </div>
                <a href="@Url.Action("Services", new { category = HospitalServiceCategories.Radiology })" class="btn btn-sm btn-light flex-shrink-0">@T["Service catalogue"]</a>
            </div>
        </div>

        @if (Model.Count == 0) { <div class="card card-flush"><div class="card-body text-center py-10"><i class="ki-outline ki-scan-barcode fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No radiology services yet. Add them in the service catalogue."]</div></div></div> }
        @foreach (var x in Model)
        {
            var s = x.Service; var e = x.Exam;
            @* H127: one exam — demo39 card header (title over a muted line · action in the toolbar) over its labelled fields *@
            <div class="card card-flush mb-5" data-exam="@s.ID">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@DisplayName.Of(s.Name, s.NameEn) <bdi class="badge badge-light-primary fw-bold fs-7 hp-num ms-1" dir="ltr">@s.Code</bdi></span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@if (e == null) {<span class="text-danger">@T["not set up yet"]</span>} else {@T["mod:" + e.Modality]}@if (e?.Contrast == true) {<text> · @T["with contrast"]</text>}</span>
                    </h3>
                    @if (canManage) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-save-exam="@s.ID"><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div>}
                </div>
                <div class="card-body pt-2">
                    <div class="row g-5">
                        <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Modality"]</label>
                            <select class="form-select form-select-solid" data-k="modality" data-control="select2" data-hide-search="true" @ro>
                                @foreach (var mod in HospitalRadModality.All) { <option value="@mod" selected="@((e?.Modality ?? HospitalRadiologyService.GuessModality(s.Code)) == mod)">@T["mod:" + mod]</option> }
                            </select></div>
                        <div class="col-md-6 d-flex align-items-end"><label class="form-check form-switch form-check-custom form-check-solid mb-3"><input class="form-check-input" type="checkbox" data-k="contrast" @(e?.Contrast == true ? "checked" : "") @ro /><span class="form-check-label fw-semibold text-gray-800">@T["Uses contrast"]</span></label></div>
                        <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Report template"]</label><textarea class="form-control form-control-solid" rows="4" maxlength="2000" data-k="template" @ro>@e?.Template</textarea></div>
                        <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Report template (English)"]</label><textarea class="form-control form-control-solid" rows="4" dir="ltr" maxlength="2000" data-k="templateEn" @ro>@e?.TemplateEn</textarea></div>
                    </div>
                </div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var root = @Json.Serialize(Url.Action("RadiologySetup"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    ['kt_app_content', 'kt_app_toolbar'].forEach(function (id) { var f = doc.getElementById(id); if (f) document.getElementById(id).innerHTML = f.innerHTML; });
                    if (window.KTApp && KTApp.createSelect2) KTApp.createSelect2();
                });
            }
            function read(scope) {
                var o = {};
                scope.querySelectorAll('[data-k]').forEach(function (i) { var k = i.getAttribute('data-k'); o[k] = i.type === 'checkbox' ? i.checked : i.value; });
                return o;
            }
            function done(btn) { return function (res) { btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); }; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-seed],[data-save-room],[data-save-exam]'); if (!t) return;
                var msg = t.getAttribute('data-confirm');
                if (msg && !t.hasAttribute('data-confirmed')) { cbConfirm(msg).then(function (ok) { if (ok) { t.setAttribute('data-confirmed', ''); t.click(); } }); return; }
                t.removeAttribute('data-confirmed');
                t.disabled = true;
                if (t.hasAttribute('data-seed')) { post(root + '/SeedStandard').then(done(t)); return; }
                if (t.hasAttribute('data-save-exam')) { post(root + '/Exam/' + t.getAttribute('data-save-exam'), read(t.closest('[data-exam]'))).then(done(t)); return; }
                var tr = t.closest('tr'), body = read(tr);
                body.id = tr.getAttribute('data-id') ? Number(tr.getAttribute('data-id')) : null;
                post(root + '/Room', body).then(done(t));
            });
        })();
    </script>
}
