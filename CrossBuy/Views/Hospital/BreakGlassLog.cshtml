@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H64 — the break-glass log: every emergency opening of a restricted file, waiting ones first; the administrator marks
    each justified or not (an unjustified one says why). Searched and paged on the server.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Emergency access"].Value;
    bool ready = ViewBag.Ready == true;
    int waiting = ViewBag.Waiting as int? ?? 0, restricted = ViewBag.Restricted as int? ?? 0;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Emergency access"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Supply & quality"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Restricted files"]</li>
            </ul>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5"><i class="ki-outline ki-information fs-2tx text-primary me-4"></i><div class="fs-6 fw-semibold text-gray-700">@T[HospitalRestrictedAccessService.NoTables]</div></div> }
        else
        {
            <div class="row g-5 mb-5">
                @* H128: stat tiles (demo39 dashboards/logistics) *@
                @foreach (var (n, label, line, icon, tone) in new[] {
                    (waiting, T["Openings waiting for review"].Value, T["bg:waiting"].Value, "ki-time", waiting > 0 ? "danger" : "primary"),
                    (restricted, T["Restricted files"].Value, T["A file is restricted from the patient's file page."].Value, "ki-lock-2", "primary") })
                {
                    <div class="col-md-6"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column">
                                <span class="fs-2hx fw-bold text-gray-900 lh-1 hp-num">@n</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@label</span>
                            </div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@tone"><i class="ki-outline @icon fs-2x text-@tone"></i></span></div></div>
                        </div>
                        <div class="card-body d-flex align-items-end pt-0 pb-5"><span class="d-flex align-items-center fs-7 fw-semibold text-gray-500"><span class="bullet bullet-dot bg-@tone me-2"></span>@line</span></div>
                    </div></div>
                }
            </div>
            @* H128: the theme's list page (demo39 apps/ecommerce) — search and filters in the card header, the table widget below *@
            <div class="card card-flush">
                <div class="card-header pt-5 flex-wrap gap-3">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Emergency openings"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px position-relative d-flex align-items-center"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" id="f_q" class="form-control form-control-solid form-control-sm ps-12" autocomplete="off" placeholder="@T["Search by patient, MRN or employee…"]" /></div>
                        <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_state"><option value="">@T["All states"]</option><option value="waiting">@T["bg:waiting"]</option><option value="reviewed">@T["bg:reviewed"]</option></select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-icon btn-light btn-active-color-primary" title="@T["Reset"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrows-circle fs-3"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["bg:when"]</th><th>@T["bg:who"]</th><th>@T["Patient"]</th><th>@T["bg:why"]</th><th>@T["bg:review"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                        <tbody id="rows"></tbody>
                    </table></div>
                    <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm text-primary me-2"></span>@T["Loading…"]</div>
                    <div class="text-center py-10 d-none" id="emptyRow"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No emergency opening yet."]</div></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            var list = cbServerList({ url: @Json.Serialize(Url.Action("BreakGlassData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('state', document.getElementById('f_state').value); } });
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { saved: @Json.Serialize(T["Saved"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), ok: @Json.Serialize(T["Mark this opening justified?"].Value) };
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-glass-review]'); if (!t) return;
                var outcome = t.getAttribute('data-outcome');
                var go = function (note) {
                    t.disabled = true;
                    fetch(@Json.Serialize(Url.Content("~/Hospital/BreakGlass/")) + t.getAttribute('data-glass-review') + '/Review', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ outcome: outcome, note: note }) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); list.reload(); });
                };
                if (outcome === 'Justified') cbConfirm(W.ok).then(function (ok) { if (ok) go(null); });
                else cbPrompt(t.getAttribute('data-ask'), { kind: 'danger' }).then(function (why) { if (why != null) go(why); });
            });
        })();
    </script>
}
