@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalPharmacyBatchRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H132 — the batches on the pharmacy's shelf in the theme's table widget, the nearest expiry first: the medicine, the batch,
   its expiry, what is left of it, and the days left as a badge (red when near or past). *@
@{ var inv = System.Globalization.CultureInfo.InvariantCulture; }
@foreach (var r in Model)
{
    string tone = r.State == HospitalPharmacyStockState.Ok ? "primary" : "danger";
    <tr>
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-45px me-4"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-calendar fs-2 text-@tone"></i></span></div>
            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(r.Name, r.NameEn)</span><bdi class="text-muted fw-semibold fs-7" dir="ltr">@r.Code</bdi></div>
        </div></td>
        <td><span class="badge badge-light fs-7 fw-bold" dir="ltr">@r.BatchNo</span></td>
        <td><span class="text-gray-800 fw-bold hp-num" dir="ltr">@(r.Expiry?.ToString("yyyy-MM-dd") ?? "—")</span></td>
        <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@r.Qty.ToString("0.###", inv)</span></td>
        <td>@if (r.DaysLeft is int d)
            {
                <span class="badge badge-light-@tone fs-7 fw-bold">@(d < 0 ? T["Expired {0} days ago", -d] : T["{0} days left", d])</span>
            }
            else {<span class="text-gray-400">—</span>}</td>
        @* H134: the batch can be recalled from here; the form opens with it chosen *@
        <td class="text-end pe-4"><a href="@Url.Action("Recalls", "Hospital", new { item = r.ItemId, batch = r.BatchNo })" class="btn btn-sm btn-icon btn-light btn-active-light-danger" title="@T["Recall this batch"]" data-bs-toggle="tooltip"><i class="ki-outline ki-shield-cross fs-4"></i></a></td>
    </tr>
}
