@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalImmunizationCard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H84 — a patient's immunization card: the schedule laid over his birth date (given, due, overdue, upcoming), each dose
    given with its lot and who gave it, doses outside the schedule, and an adverse event recorded against a dose.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Immunization card"].Value;
    bool canGive = ViewBag.CanGive == true;
    var m = Model;
    string Age(int d) => d == 0 ? T["At birth"].Value : d % 365 == 0 ? string.Format(T["{0} year(s)"].Value, d / 365) : d >= 28 ? string.Format(T["{0} month(s)"].Value, (int)Math.Round(d / 30.4)) : string.Format(T["{0} days"].Value, d);
    string Local(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("yyyy-MM-dd HH:mm");
    string Who(int? id) => id is int i && m.People.TryGetValue(i, out var n) ? n : "";
    // the person who gave the dose: their photo, initials on the brand tint when they have none
    Microsoft.AspNetCore.Html.IHtmlContent Face(int? id, int size = 30)
    {
        var name = Who(id); if (name == "") return Microsoft.AspNetCore.Html.HtmlString.Empty;
        var ini = System.Net.WebUtility.HtmlEncode(HospitalUi.Initials(name));
        var inner = id is int i && m.Faces != null && m.Faces.TryGetValue(i, out var url)
            ? $"<img src=\"{System.Net.WebUtility.HtmlEncode(url)}\" alt=\"\" style=\"object-fit:cover\" data-initials=\"{ini}\" />"
            : $"<span class=\"symbol-label fw-bold fs-9 hp-initials\">{ini}</span>";
        return new Microsoft.AspNetCore.Html.HtmlString($"<div class=\"symbol symbol-{size}px symbol-circle flex-shrink-0 me-2\" title=\"{System.Net.WebUtility.HtmlEncode(name)}\">{inner}</div>");
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Immunization card"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("Vaccines")" class="text-muted text-hover-primary">@T["Immunizations"]</a></li></ul>
        </div>
        @if (canGive && m.Ready) {<button type="button" class="btn btn-sm btn-light-primary" data-vx-give="" data-label="@T["A dose outside the schedule"]"><i class="ki-outline ki-plus fs-4"></i>@T["A dose outside the schedule"]</button>}
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H128: the patient's header (demo39 account overview): the photo, the name over a muted line, the counts in dashed boxes *@
        <div class="card card-flush mb-5"><div class="card-body pt-9 pb-6">
            <div class="d-flex flex-wrap flex-sm-nowrap gap-6">
                <div class="symbol symbol-100px symbol-circle flex-shrink-0">@if (m.Photo != null) {<img src="@m.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fs-2x fw-bold hp-initials">@HospitalUi.Initials(m.NameEn)</span>}</div>
                <div class="flex-grow-1">
                    <a href="@Url.Action("Patient", new { id = m.PatientId })" class="text-gray-900 text-hover-primary fs-2 fw-bold">@DisplayName.Of(m.Name, m.NameEn)</a>
                    <div class="d-flex flex-wrap fw-semibold fs-6 mt-1 mb-5 gap-4 text-gray-500">
                        <span class="d-flex align-items-center"><i class="ki-outline ki-profile-circle fs-4 me-1"></i><bdi class="hp-num">@m.Mrn</bdi></span>
                        <span class="d-flex align-items-center"><i class="ki-outline ki-calendar fs-4 me-1"></i>@(m.BirthDate == null ? T["No birth date on file"].Value : string.Format(T["Born {0}"].Value, m.BirthDate.Value.ToString("yyyy-MM-dd")))</span>
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var (st, tone) in new[] { (HospitalImmunizationStatus.Given, "success"), (HospitalImmunizationStatus.Due, "primary"), (HospitalImmunizationStatus.Overdue, "danger") })
                        {
                            int n = m.Doses.Count(d => d.Status == st);
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4">
                                <div class="d-flex align-items-center"><span class="bullet bullet-dot bg-@tone h-8px w-8px me-2"></span><span class="fs-2 fw-bold hp-num text-@(n > 0 && tone == "danger" ? "danger" : "gray-900")">@n</span></div>
                                <div class="fw-semibold fs-7 text-gray-500">@T["vxs:" + st]</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div></div>
        @if (!m.Ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalImmunizationService.NoTables]</div></div> }
        else if (!m.HasSchedule) { <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5"><i class="ki-outline ki-information fs-2tx text-primary me-4"></i><div class="fs-6 text-gray-700 fw-semibold">@T["There is no schedule yet: load the default one in the schedule tab, then adjust it to your country's."]</div></div> }
        @if (m.BirthDate == null && m.Ready) { <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><i class="ki-outline ki-information fs-2tx text-danger me-4"></i><div class="fs-6 text-gray-700 fw-semibold">@T["Without a birth date the due dates cannot be worked out: add it to the patient's file."]</div></div> }
        @* H128: the doses as the theme's table widget (demo39 widgets/tables) *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["The immunization schedule"]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@T["{0} of {1}", m.Doses.Count(d => d.Status == HospitalImmunizationStatus.Given), m.Doses.Count]</span></h3></div>
            <div class="card-body pt-2">
                @if (m.Doses.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-syringe fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No dose in the schedule yet."]</div></div> }
                else
                {
                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                    <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Age"]</th><th class="min-w-175px">@T["Vaccine"]</th><th>@T["Due on"]</th><th>@T["State"]</th><th class="min-w-200px">@T["Given"]</th><th class="pe-4 rounded-end"></th></tr></thead>
                    <tbody>
                    @foreach (var d in m.Doses)
                    {
                        var g = d.Given;
                        string tone = d.Status == HospitalImmunizationStatus.Given ? "success" : d.Status == HospitalImmunizationStatus.Overdue ? "danger" : d.Status == HospitalImmunizationStatus.Due ? "primary" : "secondary";
                        <tr>
                            <td class="ps-4"><span class="text-gray-900 fw-bold fs-6 text-nowrap">@Age(d.Item.AgeDays)</span></td>
                            <td><div class="d-flex align-items-center">
                                <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-syringe fs-3 text-@tone"></i></span></div>
                                <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(d.Item.Name, d.Item.NameEn)</span><span class="text-gray-500 fw-semibold fs-7">@T["Dose {0}", d.Item.DoseNo] · @T["vxr:" + d.Item.Route]</span></div></div></td>
                            <td><span class="text-gray-800 fw-bold hp-num text-nowrap">@(m.BirthDate == null ? "—" : d.DueOn.ToString("yyyy-MM-dd"))</span></td>
                            <td><span class="badge badge-light-@tone fs-7 fw-bold">@T["vxs:" + d.Status]</span></td>
                            <td>@if (g != null) {<div class="d-flex align-items-center">@Face(g.GivenByEmployeeId)<div class="d-flex flex-column"><span class="text-gray-800 fw-bold fs-7 hp-num">@Local(g.GivenAt)</span><span class="text-gray-500 fw-semibold fs-7">@Who(g.GivenByEmployeeId)@if (g.Lot != null) {<text> · @T["Lot"] <bdi dir="ltr">@g.Lot</bdi></text>}@if (g.Site != null) {<text> · <bdi>@g.Site</bdi></text>}</span></div></div>
                                @if (g.AdverseEvent != null) {<span class="badge badge-light-danger fs-8 fw-bold mt-2"><i class="ki-outline ki-information-5 fs-7 text-danger me-1"></i><bdi>@g.AdverseEvent</bdi></span>}} else {<span class="text-gray-400">—</span>}</td>
                            <td class="text-end text-nowrap pe-4">
                                @if (canGive && g == null) {<button type="button" class="btn btn-sm @(d.Status == HospitalImmunizationStatus.Upcoming ? "btn-light" : "btn-primary")" data-vx-give="@d.Item.ID" data-route="@d.Item.Route" data-label="@DisplayName.Of(d.Item.Name, d.Item.NameEn) — @T["Dose {0}", d.Item.DoseNo]">@T["Give"]</button>}
                                @if (canGive && g != null && g.AdverseEvent == null) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["Adverse event"]" data-bs-toggle="tooltip" data-vx-aefi="@g.ID" data-label="@DisplayName.Of(d.Item.Name, d.Item.NameEn) — @T["Dose {0}", d.Item.DoseNo]"><i class="ki-outline ki-information-5 fs-2"></i></button>}
                            </td>
                        </tr>
                    }
                    </tbody>
                </table></div>
                }
            </div>
        </div>
        @if (m.OffSchedule.Count > 0)
        {
            <div class="card card-flush"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Doses outside the schedule"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@m.OffSchedule.Count</span></h3></div>
                <div class="card-body pt-2"><div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                    <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Vaccine"]</th><th>@T["Given at"]</th><th>@T["Given"]</th><th class="pe-4 rounded-end">@T["Adverse event"]</th></tr></thead>
                    <tbody>
                    @foreach (var g in m.OffSchedule)
                    {
                        <tr>
                            <td class="ps-4"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-info"><i class="ki-outline ki-syringe fs-3 text-info"></i></span></div>
                                <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi>@g.Name</bdi></span><span class="text-gray-500 fw-semibold fs-7"><bdi dir="ltr" class="hp-num">@g.Code</bdi> · @T["Dose {0}", g.DoseNo]</span></div></div></td>
                            <td><span class="text-gray-800 fw-bold fs-7 hp-num text-nowrap">@Local(g.GivenAt)</span></td>
                            <td><div class="d-flex align-items-center">@Face(g.GivenByEmployeeId, 25)<span class="text-gray-600 fw-semibold fs-7">@Who(g.GivenByEmployeeId)</span></div></td>
                            <td class="pe-4">@if (g.AdverseEvent != null) {<span class="badge badge-light-danger fs-8 fw-bold"><bdi>@g.AdverseEvent</bdi></span>} else {<span class="text-gray-400">—</span>}</td>
                        </tr>
                    }
                    </tbody>
                </table></div></div></div>
        }
    </div></div>
</div>

@if (canGive)
{
    @* H128: the theme's form modal (demo39 utilities/modals/forms/new-target) *@
    <div class="modal fade" id="giveModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Record a dose"]</h1><div class="text-muted fw-semibold fs-6" data-g-what></div></div>
            <div class="row g-6">
            <div class="col-12 d-none" data-g-off><div class="row g-6">
                <div class="col-4"><label class="required fs-6 fw-semibold mb-2">@T["Code"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="12" data-g="code" placeholder="TYPH" /></div>
                <div class="col-5"><label class="required fs-6 fw-semibold mb-2">@T["Vaccine"]</label><input class="form-control form-control-solid" maxlength="100" data-g="name" /></div>
                <div class="col-3"><label class="required fs-6 fw-semibold mb-2">@T["Dose"]</label><input type="number" min="1" max="10" class="form-control form-control-solid" dir="ltr" data-g="doseNo" value="1" /></div>
            </div></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Given at"]</label><input type="datetime-local" class="form-control form-control-solid" dir="ltr" data-g="givenAt" /><div class="text-muted fs-7 mt-1">@T["Empty means now."]</div></div>
            <div class="col-6"><label class="required fs-6 fw-semibold mb-2">@T["Route"]</label><select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#giveModal" data-hide-search="true" data-g="route">@foreach (var r in HospitalVaccineRoute.All) {<option value="@r">@T["vxr:" + r]</option>}</select></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2" data-g-now-req>@T["Lot"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="40" data-g="lot" /></div>
            <div class="col-6"><label class="fs-6 fw-semibold mb-2" data-g-now-req>@T["Lot expiry"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-g="lotExpiry" /></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Site"]</label><input class="form-control form-control-solid" maxlength="60" data-g="site" placeholder="@T["Left thigh"]" /></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2" data-g-now-req>@T["Screening before the dose"]</label><select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#giveModal" data-hide-search="true" data-g="screening" data-placeholder="@T["Choose the answer"]"><option></option>@foreach (var c in HospitalVaccineScreening.All) {<option value="@c">@T["vxs:" + c]</option>}</select>
                <div class="text-muted fs-7 mt-1">@T["Asked before every dose given now; a dose from another clinic's card needs no screening."]</div></div>
            <div class="col-12 d-none" data-g-override><label class="required fs-6 fw-semibold mb-2">@T["Why it is given now"]</label><input class="form-control form-control-solid" maxlength="300" data-g="screenOverride" /></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-g-save>@T["Record the dose"]</button></div>
        </div>
    </div></div></div>
}
@section Scripts {
    <script>
        (function () {
            var mEl = document.getElementById('giveModal'); if (!mEl) return;
            var tok = document.querySelector('input[name="__RequestVerificationToken"]').value, item = null, pid = @m.PatientId;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), give: @Json.Serialize(T["Record this dose as given?"].Value),
                aefi: @Json.Serialize(T["Record an adverse event"].Value), aefiWhat: @Json.Serialize(T["What was seen (fever, swelling, rash…)"].Value) };
            // H183: the override reason appears only for a precaution (moderate or severe illness)
            $(document.getElementById('giveModal').querySelector('[data-g=screening]')).on('change', function () { document.getElementById('giveModal').querySelector('[data-g-override]').classList.toggle('d-none', this.value !== 'Fever'); });
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }
            document.addEventListener('click', function (e) {
                var g = e.target.closest('[data-vx-give]');
                if (g) { item = g.getAttribute('data-vx-give') ? Number(g.getAttribute('data-vx-give')) : null;
                    mEl.querySelector('[data-g-what]').textContent = g.getAttribute('data-label') || '';
                    mEl.querySelector('[data-g-off]').classList.toggle('d-none', item != null);
                    mEl.querySelectorAll('[data-g]').forEach(function (i) { if (i.tagName === 'SELECT') { $(i).val(i.getAttribute('data-g') === 'route' ? (g.getAttribute('data-route') || 'IM') : '').trigger('change'); } else if (i.getAttribute('data-g') !== 'doseNo') { i.value = ''; if (i._flatpickr) i._flatpickr.clear(); } });
                    if (window.jQuery) jQuery(mEl).find('select').trigger('change.select2');
                    bootstrap.Modal.getOrCreateInstance(mEl).show(); return; }
                var a = e.target.closest('[data-vx-aefi]');
                if (a) { cbPrompt(a.getAttribute('data-label') || '', { title: W.aefi, placeholder: W.aefiWhat, kind: 'danger', textarea: true }).then(function (t) { if (!t) return;
                    post(@Json.Serialize(Url.Content("~/Hospital/Vaccines/")) + a.getAttribute('data-vx-aefi') + '/Aefi', { text: t }).then(done); }); return; }
                var s = e.target.closest('[data-g-save]'); if (!s) return;
                if (mEl.querySelector('[data-g=screening]').value === 'Fever' && !mEl.querySelector('[data-g=screenOverride]').value.trim()) { mEl.querySelector('[data-g=screenOverride]').focus(); }
                var b = { patientId: pid, scheduleItemId: item };
                mEl.querySelectorAll('[data-g]').forEach(function (i) { var k = i.getAttribute('data-g'); if (item != null && (k === 'code' || k === 'name' || k === 'doseNo')) return; b[k] = k === 'doseNo' ? Number(i.value || 0) : (i.value.trim() || null); });
                cbConfirm(W.give).then(function (ok) { if (!ok) return; s.disabled = true; post(@Json.Serialize(Url.Action("GiveVaccine")), b).then(function (r) { s.disabled = false; done(r); }); });
            });
        })();
    </script>
}
