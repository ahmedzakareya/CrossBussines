@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalImmunizationCard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H84 — a patient's immunization card: the schedule laid over his birth date (given, due, overdue, upcoming), each dose
    given with its lot and who gave it, doses outside the schedule, and an adverse event recorded against a dose.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Immunization card"].Value;
    bool canGive = ViewBag.CanGive == true;
    var m = Model;
    string Age(int d) => d == 0 ? T["At birth"].Value : d % 365 == 0 ? string.Format(T["{0} year(s)"].Value, d / 365) : d >= 28 ? string.Format(T["{0} month(s)"].Value, (int)Math.Round(d / 30.4)) : string.Format(T["{0} days"].Value, d);
    string Local(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("yyyy-MM-dd HH:mm");
    string Who(int? id) => id is int i && m.People.TryGetValue(i, out var n) ? n : "";
    // the person who gave the dose: their photo, initials on the brand tint when they have none
    Microsoft.AspNetCore.Html.IHtmlContent Face(int? id, int size = 30)
    {
        var name = Who(id); if (name == "") return Microsoft.AspNetCore.Html.HtmlString.Empty;
        var ini = System.Net.WebUtility.HtmlEncode(HospitalUi.Initials(name));
        var inner = id is int i && m.Faces != null && m.Faces.TryGetValue(i, out var url)
            ? $"<img src=\"{System.Net.WebUtility.HtmlEncode(url)}\" alt=\"\" style=\"object-fit:cover\" data-initials=\"{ini}\" />"
            : $"<span class=\"symbol-label fw-bold fs-9 hp-initials\">{ini}</span>";
        return new Microsoft.AspNetCore.Html.HtmlString($"<div class=\"symbol symbol-{size}px symbol-circle flex-shrink-0 me-2\" title=\"{System.Net.WebUtility.HtmlEncode(name)}\">{inner}</div>");
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Immunization card"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("Vaccines")" class="text-muted text-hover-primary">@T["Immunizations"]</a></li></ul>
        </div>
        @if (canGive && m.Ready) {<button type="button" class="btn btn-sm btn-light-primary" data-vx-give="" data-label="@T["A dose outside the schedule"]"><i class="ki-outline ki-plus fs-5"></i>@T["A dose outside the schedule"]</button>}
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body d-flex align-items-center gap-4 py-5">
            <div class="symbol symbol-60px symbol-circle">@if (m.Photo != null) {<img src="@m.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(m.NameEn)</span>}</div>
            <div><a href="@Url.Action("Patient", new { id = m.PatientId })" class="fs-3 fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(m.Name, m.NameEn)</a>
                <div class="text-muted fs-7"><bdi class="hp-num">@m.Mrn</bdi> · @(m.BirthDate == null ? T["No birth date on file"].Value : string.Format(T["Born {0}"].Value, m.BirthDate.Value.ToString("yyyy-MM-dd")))</div></div>
            <div class="ms-auto d-flex gap-3 fs-7">
                <span><span class="badge badge-light-success me-1 hp-num">@m.Doses.Count(d => d.Status == HospitalImmunizationStatus.Given)</span>@T["vxs:Given"]</span>
                <span><span class="badge badge-light-primary me-1 hp-num">@m.Doses.Count(d => d.Status == HospitalImmunizationStatus.Due)</span>@T["vxs:Due"]</span>
                <span><span class="badge badge-light-danger me-1 hp-num">@m.Doses.Count(d => d.Status == HospitalImmunizationStatus.Overdue)</span>@T["vxs:Overdue"]</span>
            </div>
        </div></div>
        @if (!m.Ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalImmunizationService.NoTables]</div></div> }
        else if (!m.HasSchedule) { <div class="notice d-flex rounded border border-primary border-dashed bg-light-primary p-5 mb-5"><div class="fs-7 text-gray-700">@T["There is no schedule yet: load the default one in the schedule tab, then adjust it to your country's."]</div></div> }
        @if (m.BirthDate == null && m.Ready) { <div class="notice d-flex rounded border border-dashed p-5 mb-5 hp-notice"><div class="fs-7 text-gray-700">@T["Without a birth date the due dates cannot be worked out: add it to the patient's file."]</div></div> }
        <div class="card mb-5">
            <div class="card-body pt-6">
                <div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                    <thead><tr class="text-start text-gray-500 fw-bold fs-8 text-uppercase gs-0"><th>@T["Age"]</th><th>@T["Vaccine"]</th><th>@T["Due on"]</th><th>@T["State"]</th><th>@T["Given"]</th><th class="text-end"></th></tr></thead>
                    <tbody>
                    @foreach (var d in m.Doses)
                    {
                        var g = d.Given;
                        string tone = d.Status == HospitalImmunizationStatus.Given ? "badge-light-success" : d.Status == HospitalImmunizationStatus.Overdue ? "badge-light-danger" : d.Status == HospitalImmunizationStatus.Due ? "badge-light-primary" : "badge-light";
                        <tr>
                            <td class="fw-semibold text-nowrap">@Age(d.Item.AgeDays)</td>
                            <td><span class="fw-bold text-gray-900">@DisplayName.Of(d.Item.Name, d.Item.NameEn)</span> <span class="text-muted fs-8">· @T["Dose {0}", d.Item.DoseNo] · @T["vxr:" + d.Item.Route]</span></td>
                            <td class="hp-num text-nowrap">@(m.BirthDate == null ? "—" : d.DueOn.ToString("yyyy-MM-dd"))</td>
                            <td><span class="badge @tone">@T["vxs:" + d.Status]</span></td>
                            <td class="fs-8">@if (g != null) {<div class="d-flex align-items-center">@Face(g.GivenByEmployeeId)<div><div class="hp-num text-gray-800">@Local(g.GivenAt)</div><div class="text-muted">@Who(g.GivenByEmployeeId)@if (g.Lot != null) {<text> · @T["Lot"] <bdi dir="ltr">@g.Lot</bdi></text>}@if (g.Site != null) {<text> · <bdi>@g.Site</bdi></text>}</div></div></div>
                                @if (g.AdverseEvent != null) {<div class="text-danger mt-1"><i class="ki-outline ki-information-5 fs-8 text-danger"></i> <bdi>@g.AdverseEvent</bdi></div>}}</td>
                            <td class="text-end text-nowrap">
                                @if (canGive && g == null) {<button type="button" class="btn btn-sm @(d.Status == HospitalImmunizationStatus.Upcoming ? "btn-light" : "btn-primary")" data-vx-give="@d.Item.ID" data-route="@d.Item.Route" data-label="@DisplayName.Of(d.Item.Name, d.Item.NameEn) — @T["Dose {0}", d.Item.DoseNo]">@T["Give"]</button>}
                                @if (canGive && g != null && g.AdverseEvent == null) {<button type="button" class="btn btn-sm btn-light-danger" data-vx-aefi="@g.ID" data-label="@DisplayName.Of(d.Item.Name, d.Item.NameEn) — @T["Dose {0}", d.Item.DoseNo]">@T["Adverse event"]</button>}
                            </td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        </div>
        @if (m.OffSchedule.Count > 0)
        {
            <div class="card"><div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-5">@T["Doses outside the schedule"]</span></div></div>
                <div class="card-body pt-2"><div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0"><tbody>
                    @foreach (var g in m.OffSchedule) {<tr><td><span class="badge hp-code fs-9 me-2">@g.Code</span><span class="fw-bold">@g.Name</span> <span class="text-muted fs-8">· @T["Dose {0}", g.DoseNo]</span></td><td class="hp-num fs-8">@Local(g.GivenAt)</td><td class="fs-8 text-muted"><div class="d-flex align-items-center">@Face(g.GivenByEmployeeId, 25)<span>@Who(g.GivenByEmployeeId)</span></div></td><td class="fs-8">@if (g.AdverseEvent != null) {<span class="text-danger"><bdi>@g.AdverseEvent</bdi></span>}</td></tr>}
                </tbody></table></div></div></div>
        }
    </div></div>
</div>

@if (canGive)
{
    <div class="modal fade" id="giveModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-600px"><div class="modal-content">
        <div class="modal-header"><div><h2 class="fw-bold m-0">@T["Record a dose"]</h2><div class="text-muted fs-7 mt-1" data-g-what></div></div><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-12 d-none" data-g-off><div class="row g-4">
                <div class="col-4"><label class="form-label required">@T["Code"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="12" data-g="code" placeholder="TYPH" /></div>
                <div class="col-5"><label class="form-label required">@T["Vaccine"]</label><input class="form-control form-control-solid" maxlength="100" data-g="name" /></div>
                <div class="col-3"><label class="form-label required">@T["Dose"]</label><input type="number" min="1" max="10" class="form-control form-control-solid" dir="ltr" data-g="doseNo" value="1" /></div>
            </div></div>
            <div class="col-6"><label class="form-label">@T["Given at"]</label><input type="datetime-local" class="form-control form-control-solid" dir="ltr" data-g="givenAt" /><div class="form-text">@T["Empty means now."]</div></div>
            <div class="col-6"><label class="form-label required">@T["Route"]</label><select class="form-select form-select-solid" data-g="route">@foreach (var r in HospitalVaccineRoute.All) {<option value="@r">@T["vxr:" + r]</option>}</select></div>
            <div class="col-6"><label class="form-label">@T["Lot"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="40" data-g="lot" /></div>
            <div class="col-6"><label class="form-label">@T["Lot expiry"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-g="lotExpiry" /></div>
            <div class="col-12"><label class="form-label">@T["Site"]</label><input class="form-control form-control-solid" maxlength="60" data-g="site" placeholder="@T["Left thigh"]" /></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-g-save>@T["Record the dose"]</button></div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var mEl = document.getElementById('giveModal'); if (!mEl) return;
            var tok = document.querySelector('input[name="__RequestVerificationToken"]').value, item = null, pid = @m.PatientId;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), give: @Json.Serialize(T["Record this dose as given?"].Value),
                aefi: @Json.Serialize(T["Record an adverse event"].Value), aefiWhat: @Json.Serialize(T["What was seen (fever, swelling, rash…)"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }
            document.addEventListener('click', function (e) {
                var g = e.target.closest('[data-vx-give]');
                if (g) { item = g.getAttribute('data-vx-give') ? Number(g.getAttribute('data-vx-give')) : null;
                    mEl.querySelector('[data-g-what]').textContent = g.getAttribute('data-label') || '';
                    mEl.querySelector('[data-g-off]').classList.toggle('d-none', item != null);
                    mEl.querySelectorAll('[data-g]').forEach(function (i) { if (i.tagName === 'SELECT') i.value = g.getAttribute('data-route') || 'IM'; else if (i.getAttribute('data-g') !== 'doseNo') i.value = ''; });
                    bootstrap.Modal.getOrCreateInstance(mEl).show(); return; }
                var a = e.target.closest('[data-vx-aefi]');
                if (a) { cbPrompt(a.getAttribute('data-label') || '', { title: W.aefi, placeholder: W.aefiWhat, kind: 'danger', textarea: true }).then(function (t) { if (!t) return;
                    post(@Json.Serialize(Url.Content("~/Hospital/Vaccines/")) + a.getAttribute('data-vx-aefi') + '/Aefi', { text: t }).then(done); }); return; }
                var s = e.target.closest('[data-g-save]'); if (!s) return;
                var b = { patientId: pid, scheduleItemId: item };
                mEl.querySelectorAll('[data-g]').forEach(function (i) { var k = i.getAttribute('data-g'); if (item != null && (k === 'code' || k === 'name' || k === 'doseNo')) return; b[k] = k === 'doseNo' ? Number(i.value || 0) : (i.value.trim() || null); });
                cbConfirm(W.give).then(function (ok) { if (!ok) return; s.disabled = true; post(@Json.Serialize(Url.Action("GiveVaccine")), b).then(function (r) { s.disabled = false; done(r); }); });
            });
        })();
    </script>
}
