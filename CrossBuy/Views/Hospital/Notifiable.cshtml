@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalDiseaseReportRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@*
    H209 — notifiable diseases, composed from the theme (demo39): two stat badges, the register's filter bar and table
    (each case's disease and group, the visit's diagnosis, the time it is due by — overdue in red — and how it closed),
    and the hospital's list of diseases in a second tab (an administrator adds, edits or switches one off).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Notifiable diseases"].Value;
    string q = ViewBag.Q as string ?? "", status = ViewBag.Status as string ?? "";
    bool overdue = ViewBag.Overdue == true; int? patient = ViewBag.Patient as int?;
    int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages, total = (int)ViewBag.Total, due = (int)ViewBag.Due, late = (int)ViewBag.Late;
    bool ready = ViewBag.Ready == true, canManage = ViewBag.CanManage == true;
    var diseases = (ViewBag.Diseases as IReadOnlyList<HospitalNotifiableDisease>) ?? Array.Empty<HospitalNotifiableDisease>();
    string Link(int p, bool? od = null) => Url.Action("Notifiable", new { q, status, overdue = od ?? overdue, patient, page = p })!;
    bool mohConnected = !string.IsNullOrWhiteSpace(Config["Hospital:MohGateway:Url"]);   // H225
    string Tone(string s) => s switch { HospitalDiseaseReportStatus.Due => "info", HospitalDiseaseReportStatus.Reported => "primary", _ => "secondary" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0 d-flex align-items-center gap-3">@T["Notifiable diseases"]
                <span class="badge badge-light-primary fs-7 fw-bold">@T["{0} to report", due]</span>
                @if (late > 0) {<a href="@Link(1, true)" class="badge badge-danger fs-7 fw-bold">@T["{0} overdue", late]</a>}</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Infection")" class="text-muted text-hover-primary">@T["Infection control"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Notifiable diseases"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["The notifiable disease tables are not created yet (hospital_h209_notifiable_diseases.sql)."]</div></div>
        }
        @if (ready && !mohConnected)
        {
            <div class="notice d-flex bg-light rounded border border-dashed p-5 mb-5"><i class="ki-outline ki-information-5 fs-2tx text-gray-500 me-4"></i><div class="fs-7 fw-semibold text-gray-700">@T["The hospital is not connected to the Ministry's system yet: cases are reported as before and the Ministry's reference is recorded by hand. Once the administrator sets the connection, each case is sent from here."]</div></div>
        }
        <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold mb-5">
            <li class="nav-item"><a class="nav-link text-active-primary active" data-bs-toggle="tab" href="#nt-cases">@T["Cases to report"]</a></li>
            <li class="nav-item"><a class="nav-link text-active-primary" data-bs-toggle="tab" href="#nt-list">@T["The list of diseases"] <span class="badge badge-light ms-1 fs-8">@diseases.Count(d => d.IsActive)</span></a></li>
        </ul>
        <div class="tab-content">
        <div class="tab-pane fade show active" id="nt-cases">
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Cases to report"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} cases", total] · @T["Group A within 24 hours · group B within 7 days"]</span>
                </h3>
                <form class="card-toolbar gap-2 flex-wrap" method="get" action="@Url.Action("Notifiable")">
                    @if (patient != null) {<input type="hidden" name="patient" value="@patient" />}
                    @if (overdue) {<input type="hidden" name="overdue" value="true" />}
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" name="q" value="@q" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Patient, disease, code, number"]" /></div>
                    <div class="w-150px"><select name="status" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="@T["All"]" onchange="this.form.submit()"><option value="">@T["All"]</option>@foreach (var s in HospitalDiseaseReportStatus.All) {<option value="@s" selected="@(s == status)">@T["ntf:" + s]</option>}</select></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                    @if (overdue || patient != null) {<a href="@Url.Action("Notifiable")" class="btn btn-sm btn-light">@T["Show all"]</a>}
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-shield-search fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No case to report here."]</div>
                        <div class="text-muted fs-7 mt-1">@T["A case opens by itself when a signed visit carries a diagnosis on the list."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-top gs-0 gy-4 my-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 min-w-150px rounded-start">@T["Patient"]</th><th class="min-w-175px">@T["Disease"]</th><th class="min-w-150px">@T["Diagnosis"]</th><th class="min-w-100px">@T["Report due by"]</th><th class="min-w-125px">@T["Status"]</th><th class="text-end pe-4 rounded-end min-w-100px"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var r = row.Report;
                                <tr>
                                    <td class="ps-4"><a href="@Url.Action("Patient", new { id = r.PatientId })" class="text-gray-900 fw-bold text-hover-primary d-flex align-items-center gap-2 fs-7 mb-1">@HospitalUi.Avatar(row.PatientPhoto, row.PatientEn)<span>@DisplayName.Of(row.Patient, row.PatientEn)</span></a>
                                        <span class="text-muted fs-8"><bdi class="hp-num text-nowrap" dir="ltr">@row.Mrn</bdi> · <bdi class="hp-num text-nowrap" dir="ltr">@r.ReportNo</bdi></span></td>
                                    <td class="fs-7"><span class="badge badge-@(row.Urgency == HospitalNotifiableUrgency.Immediate ? "danger" : "light") fw-semibold mb-1">@T["ntu:" + row.Urgency]</span>
                                        <div class="text-gray-800 fw-semibold">@DisplayName.Of(row.Disease, row.DiseaseEn)</div></td>
                                    <td class="fs-7"><bdi class="hp-num fw-bold" dir="ltr">@r.Code</bdi> <span class="text-gray-700">@DisplayName.Of(r.DiagnosisName, r.DiagnosisNameEn)</span>
                                        <div class="text-muted fs-8"><span class="hp-num" dir="ltr">@HospitalNursingService.UtcToWard(r.DiagnosedAt).ToString("yyyy-MM-dd HH:mm")</span></div>
                                        <div class="mt-2">@await Html.PartialAsync("_HospitalFace", row.Doctor)</div></td>
                                    <td class="fs-7 text-nowrap"><span class="hp-num @(row.Overdue ? "text-danger fw-bold" : "text-gray-700")" dir="ltr">@HospitalNursingService.UtcToWard(r.DueAt).ToString("MM-dd HH:mm")</span>@if (row.Overdue) {<div class="text-danger fs-8 fw-bold">@T["Overdue"]</div>}</td>
                                    <td><span class="badge badge-light-@Tone(r.Status) fs-7 fw-bold">@T["ntf:" + r.Status]</span>
                                        @if (r.MohRef != null) {<div class="text-muted fs-8 mt-1">@T["Ministry reference"]: <bdi class="hp-num" dir="ltr">@r.MohRef</bdi></div>}
                                        @if (r.DismissReason != null) {<div class="text-muted fs-8 mt-1"><bdi>@r.DismissReason</bdi></div>}</td>
                                    <td class="text-end pe-4 text-nowrap">
                                        @* the case form for the Ministry is a Report Studio layout of this case — see _ReportPrintMenu *@
                                        @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDiseaseReport, DocumentId = r.ID.ToString(), DocumentTitle = r.ReportNo })
                                        @if (r.Status == HospitalDiseaseReportStatus.Due)
                                        {
                                            @if (mohConnected) {<button type="button" class="btn btn-sm btn-primary ms-1" data-nt-moh="@r.ID"><i class="ki-outline ki-send fs-4"></i>@T["Send to the Ministry"]</button>}
                                            <button type="button" class="btn btn-sm btn-icon btn-light-primary ms-1" title="@T["Record the report to the Ministry"]" data-bs-toggle="tooltip" data-nt-close="Reported" data-id="@r.ID" data-no="@r.ReportNo"><i class="ki-outline ki-notepad-edit fs-3"></i></button>
                                            <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger ms-1" title="@T["Not a case to report"]" data-bs-toggle="tooltip" data-nt-close="Dismissed" data-id="@r.ID" data-no="@r.ReportNo"><i class="ki-outline ki-cross-circle fs-3"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination pt-6 justify-content-end">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int p = Math.Max(1, page - 3); p <= Math.Min(pages, page + 3); p++) {<li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
        </div>

        <div class="tab-pane fade" id="nt-list">
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["The list of diseases"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["A diagnosis whose code starts with one of these opens a case"]</span>
                </h3>
                <div class="card-toolbar gap-2">
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Disease or code"]" data-nd-search /></div>
                    @if (canManage && ready) {<button type="button" class="btn btn-sm btn-primary" data-nd-edit=""><i class="ki-outline ki-plus fs-4"></i>@T["Add a disease"]</button>}
                </div>
            </div>
            <div class="card-body pt-2">
                <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-3 my-0">
                    <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start w-100px">@T["ICD-10 code"]</th><th>@T["Disease"]</th><th>@T["Disease group"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                    <tbody data-nd-body>
                        @foreach (var d in diseases)
                        {
                            <tr data-nd-row data-text="@(d.CodePrefix + " " + d.Name + " " + d.NameEn)" class="@(d.IsActive ? "" : "opacity-50")">
                                <td class="ps-4"><bdi class="hp-num fw-bold" dir="ltr">@d.CodePrefix</bdi></td>
                                <td class="fs-7 fw-semibold text-gray-800">@DisplayName.Of(d.Name, d.NameEn)</td>
                                <td><span class="badge badge-@(d.Urgency == HospitalNotifiableUrgency.Immediate ? "danger" : "light") fs-8">@T["ntu:" + d.Urgency]</span></td>
                                <td><span class="badge badge-light-@(d.IsActive ? "primary" : "secondary") fs-8">@(d.IsActive ? T["On"] : T["Off"])</span></td>
                                <td class="text-end pe-4 text-nowrap">@if (canManage) {
                                    <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Edit"]" data-nd-edit="@d.ID" data-code="@d.CodePrefix" data-name="@d.Name" data-name-en="@d.NameEn" data-urgency="@d.Urgency"><i class="ki-outline ki-pencil fs-4"></i></button>
                                    <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary ms-1" title="@(d.IsActive ? T["Switch off"] : T["Switch on"])" data-nd-toggle="@d.ID"><i class="ki-outline ki-switch fs-4"></i></button>
                                }</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
                <ul class="pagination pt-6 justify-content-end" data-nd-pages></ul>
            </div>
        </div>
        </div>
        </div>
    </div></div>
</div>

@if (canManage && ready)
{
    <div class="modal fade" id="ndModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 pt-0 pb-10">
            <div class="mb-8 text-center"><h1 class="mb-3">@T["A notifiable disease"]</h1><div class="text-muted fw-semibold fs-6">@T["The most specific code wins: A05.1 before A05."]</div></div>
            <div class="row g-4">
                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2 required">@T["ICD-10 code"]</label><input class="form-control form-control-solid" maxlength="10" dir="ltr" data-nd="code" /></div>
                <div class="col-md-8"><label class="fs-6 fw-semibold mb-2 required">@T["Disease group"]</label><select class="form-select form-select-solid" data-nd="urgency">@foreach (var u in HospitalNotifiableUrgency.All) {<option value="@u">@T["ntu:" + u]</option>}</select></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Name (Arabic)"]</label><input class="form-control form-control-solid" maxlength="200" dir="rtl" data-nd="name" /></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Name (English)"]</label><input class="form-control form-control-solid" maxlength="200" dir="ltr" data-nd="nameEn" /></div>
            </div>
            <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-nd-save>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var tk = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tk) return;
            var token = tk.value, root = @Json.Serialize(Url.Content("~/Hospital/Notifiable"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                Reported: @Json.Serialize(T["The Ministry's reference for case {0}:"].Value), Dismissed: @Json.Serialize(T["Why is case {0} not a case to report?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(t) { return function (res) { if (t) t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); setTimeout(function () { location.reload(); }, 500); }; }
            // the list: search and pages in the browser (the whole list is on the page)
            var rows = Array.prototype.slice.call(document.querySelectorAll('[data-nd-row]')), pager = document.querySelector('[data-nd-pages]'), size = 15, cur = 1, term = '';
            function paint() {
                var hit = rows.filter(function (r) { return !term || r.getAttribute('data-text').toLowerCase().indexOf(term) >= 0; });
                var pages = Math.max(1, Math.ceil(hit.length / size)); if (cur > pages) cur = pages;
                rows.forEach(function (r) { r.classList.add('d-none'); });
                hit.slice((cur - 1) * size, cur * size).forEach(function (r) { r.classList.remove('d-none'); });
                var h = '';
                if (pages > 1) for (var p = 1; p <= pages; p++) h += '<li class="page-item' + (p === cur ? ' active' : '') + '"><a class="page-link" href="#" data-nd-page="' + p + '">' + p + '</a></li>';
                if (pager) pager.innerHTML = h;
            }
            var box = document.querySelector('[data-nd-search]'); if (box) box.addEventListener('input', function () { term = box.value.trim().toLowerCase(); cur = 1; paint(); });
            paint();
            var m = document.getElementById('ndModal'), editId = null;
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-nt-close],[data-nd-page],[data-nd-edit],[data-nd-save],[data-nd-toggle],[data-nt-moh]'); if (!t) return;
                if (t.hasAttribute('data-nt-moh')) { t.disabled = true; post(root + '/' + t.getAttribute('data-nt-moh') + '/MohSend').then(done(t)); return; }
                if (t.hasAttribute('data-nd-page')) { e.preventDefault(); cur = Number(t.getAttribute('data-nd-page')); paint(); return; }
                if (t.hasAttribute('data-nd-edit')) {
                    editId = t.getAttribute('data-nd-edit') || null;
                    var f = function (k) { return m.querySelector('[data-nd="' + k + '"]'); };
                    f('code').value = t.getAttribute('data-code') || ''; f('name').value = t.getAttribute('data-name') || ''; f('nameEn').value = t.getAttribute('data-name-en') || '';
                    f('urgency').value = t.getAttribute('data-urgency') || 'Immediate';
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                if (t.hasAttribute('data-nd-save')) {
                    var v = function (k) { return m.querySelector('[data-nd="' + k + '"]').value; };
                    t.disabled = true;
                    post(root + '/Diseases' + (editId ? '?id=' + editId : ''), { codePrefix: v('code'), name: v('name'), nameEn: v('nameEn'), urgency: v('urgency') })
                        .then(function (res) { if (res.ok) bootstrap.Modal.getOrCreateInstance(m).hide(); done(t)(res); });
                    return;
                }
                if (t.hasAttribute('data-nd-toggle')) { t.disabled = true; post(root + '/Diseases/' + t.getAttribute('data-nd-toggle') + '/Toggle').then(done(t)); return; }
                var to = t.getAttribute('data-nt-close');
                cbPrompt(W[to].replace('{0}', t.getAttribute('data-no')), { kind: to === 'Reported' ? 'primary' : 'danger', textarea: to === 'Dismissed' }).then(function (val) {
                    if (val == null) return; t.disabled = true;
                    post(root + '/' + t.getAttribute('data-id') + '/Close', { to: to, text: val }).then(done(t));
                });
            });
        })();
    </script>
}
