@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPayerRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — payers and their contracts, and the patients' policies, composed from the theme (demo39): stat tiles
    (dashboards/logistics), table widgets with a search in the card toolbar (widgets/tables, apps/ecommerce lists) and the
    form modal (utilities/modals/forms/new-target).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Payers & contracts"].Value;
    var policies = (ViewBag.Policies as IReadOnlyList<HospitalPolicyRow>) ?? Array.Empty<HospitalPolicyRow>();
    var lists = (ViewBag.PriceLists as List<(int ID, string Label)>) ?? new();
    string? cur = ViewBag.Currency as string;
    bool canManage = ViewBag.CanManage == true, canRegister = ViewBag.CanRegister == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Pct(decimal v) => v.ToString("0.##", inv) + "%";
    string Day(DateTime? d) => d?.ToString("yyyy-MM-dd", inv) ?? "";
    string Arrow() => DisplayName.IsArabic ? "←" : "→";
    // the person, not a glyph: the patient's photo, or their initials
    string Avatar(string? photo, string nameEn) => photo != null
        ? $"<div class=\"symbol symbol-35px symbol-circle flex-shrink-0 me-3\"><img src=\"{photo}\" alt=\"\" style=\"object-fit:cover\" data-initials=\"{HospitalUi.Initials(nameEn)}\" /></div>"
        : $"<div class=\"symbol symbol-35px symbol-circle flex-shrink-0 me-3\"><span class=\"symbol-label fw-bold fs-7 hp-initials\">{HospitalUi.Initials(nameEn)}</span></div>";
    var dental = (ViewBag.DentalBenefits as Dictionary<int, HospitalDentalBenefit>) ?? new();
    object DentalData(HospitalPayer p) { var b = dental.GetValueOrDefault(p.ID); return new { payerId = p.ID, who = DisplayName.Of(p.Name, p.NameEn), limit = b?.YearlyLimit ?? 0,
        cover = HospitalDentalCategory.All.ToDictionary(c => c, c => HospitalDentalRules.CoverFor(b, c)) }; }
    object PayerData(HospitalPayer p) => new { id = p.ID, code = p.Code, name = p.Name, nameEn = p.NameEn, kind = p.Kind, classes = p.Classes, discountPct = p.DiscountPct, copayPct = p.CopayPct, copayCap = p.CopayCap,
        priceListId = p.PriceListId, preauthCategories = HospitalInsuranceRules.PreauthCategories(p.PreauthCategories).ToArray(), validFrom = Day(p.ValidFrom), validTo = Day(p.ValidTo), isActive = p.IsActive };
    int active = Model.Count(r => r.Payer.IsActive && !r.Expired), expired = Model.Count(r => r.Expired);
    int covered = policies.Count(r => r.Ineligible == null);
    var tiles = new[] {
        (Num: active.ToString(), Label: T["Contracts"].Value, Icon: "shield-tick", Tone: "primary", Line: string.Format(T["{0} of {1}"].Value, active, Model.Count) + " · " + T["Active"].Value),
        (Num: expired.ToString(), Label: T["Expired"].Value, Icon: "time", Tone: expired > 0 ? "danger" : "success", Line: T["Contracts"].Value),
        (Num: policies.Count.ToString(), Label: T["Patient policies"].Value, Icon: "people", Tone: "info", Line: string.Format(T["{0} of {1}"].Value, covered, policies.Count) + " · " + T["Covered"].Value) };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Payers & contracts"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Insurance")" class="text-muted text-hover-primary">@T["Insurance"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Contracts"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("PriceLists")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-price-tag fs-4"></i>@T["Price lists"]</a>
            @if (canManage) { <button type="button" class="btn btn-sm btn-primary" data-edit-payer><i class="ki-outline ki-plus fs-4"></i>@T["New contract"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* stat tiles — demo39 dashboards/logistics *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in tiles)
            {
                <div class="col-md-4"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2 hp-num">@s.Num</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Label</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Tone"><i class="ki-outline ki-@s.Icon fs-2x text-@s.Tone"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500"><div class="bullet w-8px h-6px rounded-2 bg-@s.Tone me-3"></div><span class="hp-num">@s.Line</span></div>
                    </div>
                </div></div>
            }
        </div>

        @* contracts — demo39 widgets/tables *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Payers & contracts"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Each contract sets the discount, co-pay, price list and services needing approval"]</span>
                </h3>
                <div class="card-toolbar"><div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" data-filter="payer" class="form-control form-control-solid w-250px ps-12" placeholder="@T["Search..."]" /></div></div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 mb-4 d-block"></i>
                        <div class="fs-6 fw-bold text-gray-700">@T["No contracts yet."]</div>
                        <div class="fs-7 text-gray-500">@T["Each contract sets the discount, co-pay, price list and services needing approval"]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Payer"]</th><th>@T["Classes"]</th><th class="text-end">@T["Discount"]</th><th class="text-end">@T["Co-pay"]</th><th>@T["Price list"]</th><th>@T["Validity"]</th><th class="text-end">@T["Rejection"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var p = r.Payer; var db = dental.GetValueOrDefault(p.ID);
                                string tone = !p.IsActive ? "secondary" : r.Expired ? "danger" : "primary";
                                <tr data-row="payer">
                                    <td class="ps-4"><div class="d-flex align-items-center">
                                        <div class="symbol symbol-45px me-4 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-shield-tick fs-2 text-@(tone == "secondary" ? "gray-600" : tone)"></i></span></div>
                                        <div class="d-flex flex-column">
                                            <span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(p.Name, p.NameEn)</span>
                                            <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num" dir="ltr">@p.Code</bdi> · @T["kind:" + p.Kind]</span>
                                            @if (db != null) { <span class="text-muted fw-semibold d-block fs-8"><i class="ki-outline ki-emoji-happy fs-8"></i> @T["Dental limit"] <span class="hp-num" dir="ltr">@(db.YearlyLimit > 0 ? db.YearlyLimit.ToString("N3", inv) : "∞")</span></span> }
                                        </div>
                                    </div></td>
                                    <td class="text-gray-600 fw-semibold fs-7"><bdi>@(p.Classes ?? "—")</bdi></td>
                                    <td class="text-end">@if (p.PriceListId == null && p.DiscountPct > 0) {<span class="badge badge-light-success fs-7 fw-bold hp-num" dir="ltr">@Pct(p.DiscountPct)</span>} else {<span class="text-muted">—</span>}</td>
                                    <td class="text-end">@if (p.CopayPct > 0) {<span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@Pct(p.CopayPct)</span>} else {<span class="text-muted">—</span>}@if (p.CopayCap > 0) {<span class="text-muted fw-semibold d-block fs-8">@T["cap"] <span class="hp-num" dir="ltr">@p.CopayCap.ToString("N3", inv)</span></span>}</td>
                                    <td>@if (r.PriceList != null) {<a href="@Url.Action("PriceList", new { id = p.PriceListId })" class="text-gray-800 fw-bold text-hover-primary fs-7"><i class="ki-outline ki-price-tag fs-6 text-primary me-1"></i>@r.PriceList</a>} else {<span class="text-muted fw-semibold fs-7">@T["Main list"]</span>}</td>
                                    <td class="text-gray-600 fw-semibold fs-7 text-nowrap"><span class="hp-num">@Day(p.ValidFrom)</span> @Arrow() <span class="hp-num">@(p.ValidTo == null ? "…" : Day(p.ValidTo))</span></td>
                                    <td class="text-end">@if (r.RejectionRate is decimal rr) {<span class="badge badge-light-@(rr > 8 ? "danger" : "success") fs-7 fw-bold hp-num" dir="ltr">@(rr.ToString("0.0", inv) + "%")</span>} else {<span class="text-muted">—</span>}</td>
                                    <td>@if (!p.IsActive) {<span class="badge badge-light fs-7 fw-bold">@T["Inactive"]</span>} else if (r.Expired) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Expired"]</span>} else {<span class="badge badge-light-success fs-7 fw-bold">@T["Active"]</span>}</td>
                                    <td class="text-end pe-4 text-nowrap">@if (canManage) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" title="@T["Dental benefit"]" data-bs-toggle="tooltip" data-edit-dental="@System.Text.Json.JsonSerializer.Serialize(DentalData(p))"><i class="ki-outline ki-emoji-happy fs-3"></i></button><button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Edit"]" data-bs-toggle="tooltip" data-edit-payer="@System.Text.Json.JsonSerializer.Serialize(PayerData(p))"><i class="ki-outline ki-pencil fs-3"></i></button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Prices live in the price lists"]</h4>
                <div class="fs-6 text-gray-700">@T["Each contract points at one list, in that list's currency. A contract on the main list takes its discount on top; a payer's own list has the discount built in."]</div></div>
        </div>

        @* patients' policies — demo39 widgets/tables, the patient's photo first *@
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Patient policies"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["A patient is covered when the policy and the contract are both valid on the day"]</span>
                </h3>
                <div class="card-toolbar d-flex gap-2">
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" data-filter="policy" class="form-control form-control-solid w-250px ps-12" placeholder="@T["Search..."]" /></div>
                    @if (canRegister && Model.Count > 0) { <button type="button" class="btn btn-sm btn-primary" data-edit-policy><i class="ki-outline ki-plus fs-4"></i>@T["Add policy"]</button> }
                </div>
            </div>
            <div class="card-body pt-2">
                @if (policies.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-people fs-3x text-gray-300 mb-4 d-block"></i>
                        <div class="fs-6 fw-bold text-gray-700">@T["No patient policies yet."]</div>
                        <div class="fs-7 text-gray-500">@T["A patient is covered when the policy and the contract are both valid on the day"]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Payer"]</th><th>@T["Member no."]</th><th>@T["Class"]</th><th>@T["Validity"]</th><th>@T["Cover today"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in policies)
                            {
                                var po = r.Policy;
                                <tr data-row="policy">
                                    <td class="ps-4"><div class="d-flex align-items-center">@Html.Raw(Avatar(r.Photo, r.PatientNameEn))
                                        <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = po.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi></div></div></td>
                                    <td class="text-gray-800 fw-bold fs-7">@DisplayName.Of(r.Payer, r.PayerEn)</td>
                                    <td><bdi class="text-gray-800 fw-bold fs-7 hp-num" dir="ltr">@po.PolicyNo</bdi></td>
                                    <td>@if (po.MemberClass != null) {<span class="badge badge-light-primary fs-7 fw-bold"><bdi>@po.MemberClass</bdi></span>} else {<span class="text-muted">—</span>}</td>
                                    <td class="text-gray-600 fw-semibold fs-7 text-nowrap"><span class="hp-num">@Day(po.ValidFrom)</span> @Arrow() <span class="hp-num">@(po.ValidTo == null ? "…" : Day(po.ValidTo))</span></td>
                                    <td>@if (r.Ineligible == null) {<span class="badge badge-light-success fs-7 fw-bold">@T["Covered"]</span>} else {<span class="badge badge-light-danger fs-7 fw-bold">@T["inelig:" + r.Ineligible]</span>}</td>
                                    <td class="text-end pe-4">@if (canRegister) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Edit"]" data-bs-toggle="tooltip" data-edit-policy="@System.Text.Json.JsonSerializer.Serialize(new { id = po.ID, patientId = po.PatientId, patient = DisplayName.Of(r.PatientName, r.PatientNameEn) + " — " + r.Mrn, payerId = po.PayerId, policyNo = po.PolicyNo, memberClass = po.MemberClass, validFrom = Day(po.ValidFrom), validTo = Day(po.ValidTo), isActive = po.IsActive })"><i class="ki-outline ki-pencil fs-3"></i></button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@if (canManage)
{
    @* the form modals — demo39 utilities/modals/forms/new-target *@
    <div class="modal fade" id="payerModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-750px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10" data-payer-form>
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Contract"]</h1>
                <div class="text-muted fw-semibold fs-5">@T["Each contract sets the discount, co-pay, price list and services needing approval"]</div></div>
            <div class="row g-6">
                <div class="col-md-3 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Code"]</label><input class="form-control form-control-solid hp-num" dir="ltr" data-k="code" maxlength="20" /></div>
                <div class="col-md-5 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Name"]</label><input class="form-control form-control-solid" data-k="name" maxlength="150" /></div>
                <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Name (English)"]</label><input class="form-control form-control-solid" dir="ltr" data-k="nameEn" maxlength="150" /></div>
                <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Kind"]</label><select class="form-select form-select-solid" data-k="kind" data-control="select2" data-hide-search="true" data-dropdown-parent="#payerModal">
                    @foreach (var k in HospitalPayerKind.All) { <option value="@k">@T["kind:" + k]</option> }</select></div>
                <div class="col-md-8 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Classes"]</label><input class="form-control form-control-solid" data-k="classes" maxlength="100" placeholder="VIP · A · B" /></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Price list"]</label><select class="form-select form-select-solid" data-k="priceListId" data-control="select2" data-dropdown-parent="#payerModal">
                    <option value="">@T["Main list"]</option>
                    @foreach (var l in lists) { <option value="@l.ID">@l.Label</option> }</select></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Discount"] <span class="text-muted fs-8">@T["On the main list only"]</span></label><div class="input-group input-group-solid"><input class="form-control form-control-solid hp-num" dir="ltr" data-k="discountPct" data-num /><span class="input-group-text">%</span></div></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Co-pay"]</label><div class="input-group input-group-solid"><input class="form-control form-control-solid hp-num" dir="ltr" data-k="copayPct" data-num /><span class="input-group-text">%</span></div></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Co-pay cap per bill"] <span class="text-muted fs-8">@T["0 = no cap"]</span></label><div class="input-group input-group-solid"><input class="form-control form-control-solid hp-num" dir="ltr" data-k="copayCap" data-num /><span class="input-group-text">@cur</span></div></div>
                <div class="col-12 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Services needing the payer's approval"]</label><select class="form-select form-select-solid" multiple data-k="preauthCategories" data-control="select2" data-close-on-select="false" data-dropdown-parent="#payerModal">
                    @foreach (var c in HospitalServiceCategories.All) { <option value="@c">@T["cat:" + c]</option> }</select></div>
                <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Valid from"]</label><input type="date" class="form-control form-control-solid hp-num" data-k="validFrom" /></div>
                <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Valid to"]</label><input type="date" class="form-control form-control-solid hp-num" data-k="validTo" /></div>
                <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch form-check-custom form-check-solid mb-3"><input class="form-check-input" type="checkbox" data-k="isActive" checked /><label class="form-check-label fw-semibold">@T["Active"]</label></div></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-payer>@T["Save"]</button></div>
        </div>
    </div></div></div>
}
@if (canRegister)
{
    @* H15: the payer's dental benefit — the cover per dental category and the yearly dental limit *@
    <div class="modal fade" id="dentalModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Dental benefit"]</h1>
                <div class="text-muted fw-semibold fs-5" data-db-who></div></div>
            <div class="d-flex flex-column mb-8 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Yearly dental limit"] <span class="text-muted fs-8">@cur</span></label><input type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" data-db="limit" /><div class="text-muted fs-7 mt-2">@T["0 = no limit"]</div></div>
            <div class="row g-5">
                @foreach (var c in HospitalDentalCategory.All)
                {
                    <div class="col-md-3 col-6"><label class="fs-7 fw-semibold mb-2">@T["dcat:" + c]</label><div class="input-group input-group-sm input-group-solid"><input type="number" min="0" max="100" step="1" class="form-control hp-num" dir="ltr" data-db-cat="@c" /><span class="input-group-text">%</span></div></div>
                }
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-dental>@T["Save"]</button></div>
        </div>
    </div></div></div>

    <div class="modal fade" id="policyModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10" data-policy-form>
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Patient policy"]</h1>
                <div class="text-muted fw-semibold fs-5">@T["A patient is covered when the policy and the contract are both valid on the day"]</div></div>
            <div class="row g-6">
                <div class="col-12 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Patient"]</label><select class="form-select form-select-solid" data-k="patientId" data-no-select2 data-placeholder="@T["Search by name or MRN"]"></select></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Payer"]</label><select class="form-select form-select-solid" data-k="payerId" data-control="select2" data-hide-search="true" data-dropdown-parent="#policyModal">
                    @foreach (var r in Model) { <option value="@r.Payer.ID">@r.Payer.Code · @DisplayName.Of(r.Payer.Name, r.Payer.NameEn)</option> }</select></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Member no."]</label><input class="form-control form-control-solid hp-num" dir="ltr" data-k="policyNo" maxlength="40" /></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Class"]</label><input class="form-control form-control-solid" data-k="memberClass" maxlength="30" /></div>
                <div class="col-md-6 d-flex align-items-end"><div class="form-check form-switch form-check-custom form-check-solid mb-3"><input class="form-check-input" type="checkbox" data-k="isActive" checked /><label class="form-check-label fw-semibold">@T["Active"]</label></div></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Valid from"]</label><input type="date" class="form-control form-control-solid hp-num" data-k="validFrom" /></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Valid to"]</label><input type="date" class="form-control form-control-solid hp-num" data-k="validTo" /></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-policy>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var isAr = document.documentElement.dir === 'rtl';
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            var urls = { root: @Json.Serialize(Url.Action("Insurance")), patients: @Json.Serialize(Url.Action("SearchInsurancePatients")) };
            var today = new Date().toISOString().slice(0, 10);
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function setVal(el, v) {
                if (el.type === 'checkbox') { el.checked = v !== false; return; }
                if (window.$ && $(el).data('select2')) { $(el).val(v == null ? (el.multiple ? [] : '') : v).trigger('change'); return; }
                el.value = v == null ? '' : v;
            }
            function fill(form, data) { form.querySelectorAll('[data-k]').forEach(function (el) { setVal(el, data[el.getAttribute('data-k')]); }); }
            function read(form) {
                var o = {};
                form.querySelectorAll('[data-k]').forEach(function (el) {
                    var k = el.getAttribute('data-k'), v;
                    if (el.type === 'checkbox') v = el.checked;
                    else if (el.multiple) v = Array.prototype.map.call(el.selectedOptions, function (x) { return x.value; });
                    else v = el.value === '' ? null : el.value;
                    if (v != null && el.hasAttribute('data-num')) v = Number(v);
                    o[k] = v;
                });
                return o;
            }
            var payerEl = document.getElementById('payerModal'), policyEl = document.getElementById('policyModal'), editing = { payer: null, policy: null };
            var pickPatient = policyEl && policyEl.querySelector('[data-k=patientId]');
            if (pickPatient && window.$ && $.fn.select2) $(pickPatient).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', dropdownParent: $(policyEl), placeholder: pickPatient.getAttribute('data-placeholder'),
                ajax: { url: urls.patients, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });

            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-edit-payer],[data-edit-policy],[data-save-payer],[data-save-policy]'); if (!t) return;
                if (t.hasAttribute('data-edit-payer')) {
                    var d = t.getAttribute('data-edit-payer') ? JSON.parse(t.getAttribute('data-edit-payer')) : { kind: 'Insurer', discountPct: 0, copayPct: 0, copayCap: 0, validFrom: today, isActive: true, preauthCategories: [] };
                    editing.payer = d.id || null; fill(payerEl.querySelector('[data-payer-form]'), d);
                    bootstrap.Modal.getOrCreateInstance(payerEl).show(); return;
                }
                if (t.hasAttribute('data-edit-policy')) {
                    var p = t.getAttribute('data-edit-policy') ? JSON.parse(t.getAttribute('data-edit-policy')) : { validFrom: today, isActive: true };
                    editing.policy = p.id || null;
                    $(pickPatient).empty(); if (p.patientId) $(pickPatient).append(new Option(p.patient, p.patientId, true, true)).trigger('change');
                    var rest = Object.assign({}, p); delete rest.patientId; fill(policyEl.querySelector('[data-policy-form]'), rest);
                    bootstrap.Modal.getOrCreateInstance(policyEl).show(); return;
                }
                var isPayer = t.hasAttribute('data-save-payer'), modal = isPayer ? payerEl : policyEl;
                var body = read(modal.querySelector(isPayer ? '[data-payer-form]' : '[data-policy-form]'));
                body.id = isPayer ? editing.payer : editing.policy;
                if (isPayer) body.priceListId = body.priceListId == null ? null : Number(body.priceListId);
                else { body.patientId = Number(body.patientId || 0); body.payerId = Number(body.payerId || 0); }
                t.disabled = true;
                post(urls.root + (isPayer ? '/Payer' : '/Policy'), body).then(function (res) {
                    t.disabled = false;
                    if (!res.ok) { toast('error', res.error || W.failed); return; }
                    toast('success', W.saved); bootstrap.Modal.getOrCreateInstance(modal).hide(); swap();
                });
            });
            // the dental benefit (H15)
            var dEl = document.getElementById('dentalModal'), dentalFor = null;
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-edit-dental],[data-save-dental]'); if (!t || !dEl) return;
                if (t.hasAttribute('data-edit-dental')) {
                    var d = JSON.parse(t.getAttribute('data-edit-dental')); dentalFor = d.payerId;
                    dEl.querySelector('[data-db-who]').textContent = d.who; dEl.querySelector('[data-db=limit]').value = d.limit;
                    dEl.querySelectorAll('[data-db-cat]').forEach(function (i) { i.value = d.cover[i.getAttribute('data-db-cat')]; });
                    bootstrap.Modal.getOrCreateInstance(dEl).show(); return;
                }
                var cover = {}; dEl.querySelectorAll('[data-db-cat]').forEach(function (i) { cover[i.getAttribute('data-db-cat')] = Number(i.value || 0); });
                t.disabled = true;
                post(@Json.Serialize(Url.Action("DentalSaveBenefit")), { payerId: dentalFor, yearlyLimit: Number(dEl.querySelector('[data-db=limit]').value || 0), cover: cover }).then(function (res) {
                    t.disabled = false;
                    if (!res.ok) { toast('error', res.error || W.failed); return; }
                    toast('success', W.saved); bootstrap.Modal.getOrCreateInstance(dEl).hide(); swap();
                });
            });
            document.addEventListener('input', function (e) {
                var kind = e.target.getAttribute && e.target.getAttribute('data-filter'); if (!kind) return;
                var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row="' + kind + '"]').forEach(function (tr) { tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none'; });
            });
        })();
    </script>
}
