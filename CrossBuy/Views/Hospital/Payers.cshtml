@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPayerRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Payers & contracts"].Value;
    var policies = (ViewBag.Policies as IReadOnlyList<HospitalPolicyRow>) ?? Array.Empty<HospitalPolicyRow>();
    var lists = (ViewBag.PriceLists as List<(int ID, string Label)>) ?? new();
    string? cur = ViewBag.Currency as string;
    bool canManage = ViewBag.CanManage == true, canRegister = ViewBag.CanRegister == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Pct(decimal v) => v.ToString("0.##", inv) + "%";
    string Day(DateTime? d) => d?.ToString("yyyy-MM-dd", inv) ?? "";
    string Avatar(string? photo, string nameEn) => photo != null
        ? $"<div class=\"symbol symbol-30px symbol-circle flex-shrink-0\"><img src=\"{photo}\" alt=\"\" style=\"object-fit:cover\" data-initials=\"{HospitalUi.Initials(nameEn)}\" /></div>"
        : $"<div class=\"symbol symbol-30px symbol-circle flex-shrink-0\"><span class=\"symbol-label fw-bold fs-9 hp-initials\">{HospitalUi.Initials(nameEn)}</span></div>";
    object PayerData(HospitalPayer p) => new { id = p.ID, code = p.Code, name = p.Name, nameEn = p.NameEn, kind = p.Kind, classes = p.Classes, discountPct = p.DiscountPct, copayPct = p.CopayPct, copayCap = p.CopayCap,
        priceListId = p.PriceListId, preauthCategories = HospitalInsuranceRules.PreauthCategories(p.PreauthCategories).ToArray(), validFrom = Day(p.ValidFrom), validTo = Day(p.ValidTo), isActive = p.IsActive };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Payers & contracts"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Insurance")" class="text-muted text-hover-primary">@T["Insurance"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Contracts"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("PriceLists")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-price-tag fs-4"></i>@T["Price lists"]</a>
            @if (canManage) { <button type="button" class="btn btn-sm btn-primary" data-edit-payer><i class="ki-outline ki-plus fs-4"></i>@T["New contract"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5">
            <div class="card-header border-0 pt-6">
                <div class="card-title align-items-start flex-column m-0">
                    <span class="card-label fw-bold text-gray-900 fs-4">@T["Payers & contracts"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@T["Each contract sets the discount, co-pay, price list and services needing approval"]</span>
                </div>
                <div class="card-toolbar"><div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" data-filter="payer" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Search..."]" /></div></div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0) { <div class="text-center text-muted py-15"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 d-block mb-4"></i>@T["No contracts yet."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>@T["Payer"]</th><th>@T["Classes"]</th><th class="text-end">@T["Discount"]</th><th class="text-end">@T["Co-pay"]</th><th>@T["Price list"]</th><th>@T["Validity"]</th><th class="text-end">@T["Rejection"]</th><th>@T["State"]</th><th class="text-end w-75px"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in Model)
                            {
                                var p = r.Payer;
                                <tr data-row="payer">
                                    <td><div class="fw-bold text-gray-900">@DisplayName.Of(p.Name, p.NameEn)</div><div class="text-muted fs-8"><span class="hp-num">@p.Code</span> · @T["kind:" + p.Kind]</div></td>
                                    <td class="text-gray-700">@(p.Classes ?? "—")</td>
                                    <td class="text-end hp-num">@(p.PriceListId == null && p.DiscountPct > 0 ? Pct(p.DiscountPct) : "—")</td>
                                    <td class="text-end hp-num">@(p.CopayPct > 0 ? Pct(p.CopayPct) : "—")@if (p.CopayCap > 0) {<div class="text-muted fs-8">@T["cap"] @p.CopayCap.ToString("N3", inv)</div>}</td>
                                    <td>@if (r.PriceList != null) {<a href="@Url.Action("PriceList", new { id = p.PriceListId })" class="fw-semibold">@r.PriceList</a>} else {<span class="text-muted">@T["Main list"]</span>}</td>
                                    <td class="hp-num fs-7">@Day(p.ValidFrom) → @(p.ValidTo == null ? "…" : Day(p.ValidTo))</td>
                                    <td class="text-end hp-num @(r.RejectionRate > 8 ? "text-danger fw-bold" : "")">@(r.RejectionRate is decimal rr ? rr.ToString("0.0", inv) + "%" : "—")</td>
                                    <td>@if (!p.IsActive) {<span class="badge badge-light fs-8">@T["Inactive"]</span>} else if (r.Expired) {<span class="badge badge-light-danger fs-8">@T["Expired"]</span>} else {<span class="badge badge-light-success fs-8">@T["Active"]</span>}</td>
                                    <td class="text-end">@if (canManage) {<button type="button" class="btn btn-sm btn-light" data-edit-payer="@System.Text.Json.JsonSerializer.Serialize(PayerData(p))">@T["Edit"]</button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice">
            <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label"><i class="ki-outline ki-price-tag fs-2x text-white"></i></span></span>
            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Prices live in the price lists"]</h4>
                <div class="fs-6 text-gray-700">@T["Each contract points at one list, in that list's currency. A contract on the main list takes its discount on top; a payer's own list has the discount built in."]</div></div>
        </div>

        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title align-items-start flex-column m-0">
                    <span class="card-label fw-bold text-gray-900 fs-4">@T["Patient policies"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@T["A patient is covered when the policy and the contract are both valid on the day"]</span>
                </div>
                <div class="card-toolbar d-flex gap-2">
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" data-filter="policy" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Search..."]" /></div>
                    @if (canRegister && Model.Count > 0) { <button type="button" class="btn btn-sm btn-primary" data-edit-policy><i class="ki-outline ki-plus fs-4"></i>@T["Add policy"]</button> }
                </div>
            </div>
            <div class="card-body pt-2">
                @if (policies.Count == 0) { <div class="text-center text-muted py-15">@T["No patient policies yet."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>@T["Patient"]</th><th>@T["Payer"]</th><th>@T["Member no."]</th><th>@T["Class"]</th><th>@T["Validity"]</th><th>@T["Cover today"]</th><th class="text-end w-75px"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in policies)
                            {
                                var po = r.Policy;
                                <tr data-row="policy">
                                    <td><div class="d-flex align-items-center gap-2">@Html.Raw(Avatar(r.Photo, r.PatientNameEn))
                                        <div><a href="@Url.Action("Patient", new { id = po.PatientId })" class="fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><div class="text-muted fs-8 hp-num">@r.Mrn</div></div></div></td>
                                    <td>@DisplayName.Of(r.Payer, r.PayerEn)</td>
                                    <td class="hp-num">@po.PolicyNo</td>
                                    <td>@(po.MemberClass ?? "—")</td>
                                    <td class="hp-num fs-7">@Day(po.ValidFrom) → @(po.ValidTo == null ? "…" : Day(po.ValidTo))</td>
                                    <td>@if (r.Ineligible == null) {<span class="badge badge-light-success fs-8">@T["Covered"]</span>} else {<span class="badge badge-light-danger fs-8">@T["inelig:" + r.Ineligible]</span>}</td>
                                    <td class="text-end">@if (canRegister) {<button type="button" class="btn btn-sm btn-light" data-edit-policy="@System.Text.Json.JsonSerializer.Serialize(new { id = po.ID, patientId = po.PatientId, patient = DisplayName.Of(r.PatientName, r.PatientNameEn) + " — " + r.Mrn, payerId = po.PayerId, policyNo = po.PolicyNo, memberClass = po.MemberClass, validFrom = Day(po.ValidFrom), validTo = Day(po.ValidTo), isActive = po.IsActive })">@T["Edit"]</button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@if (canManage)
{
    <div class="modal fade" id="payerModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-750px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["Contract"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-8 px-lg-10" data-payer-form>
            <div class="row g-5">
                <div class="col-md-3"><label class="form-label required">@T["Code"]</label><input class="form-control form-control-solid hp-num" dir="ltr" data-k="code" maxlength="20" /></div>
                <div class="col-md-5"><label class="form-label required">@T["Name"]</label><input class="form-control form-control-solid" data-k="name" maxlength="150" /></div>
                <div class="col-md-4"><label class="form-label required">@T["Name (English)"]</label><input class="form-control form-control-solid" dir="ltr" data-k="nameEn" maxlength="150" /></div>
                <div class="col-md-4"><label class="form-label">@T["Kind"]</label><select class="form-select form-select-solid" data-k="kind" data-control="select2" data-hide-search="true" data-dropdown-parent="#payerModal">
                    @foreach (var k in HospitalPayerKind.All) { <option value="@k">@T["kind:" + k]</option> }</select></div>
                <div class="col-md-8"><label class="form-label">@T["Classes"]</label><input class="form-control form-control-solid" data-k="classes" maxlength="100" placeholder="VIP · A · B" /></div>
                <div class="col-md-6"><label class="form-label">@T["Price list"]</label><select class="form-select form-select-solid" data-k="priceListId" data-control="select2" data-dropdown-parent="#payerModal">
                    <option value="">@T["Main list"]</option>
                    @foreach (var l in lists) { <option value="@l.ID">@l.Label</option> }</select></div>
                <div class="col-md-6"><label class="form-label">@T["Discount"] <span class="text-muted fs-8">@T["on the main list only"]</span></label><div class="input-group input-group-solid"><input class="form-control form-control-solid hp-num" dir="ltr" data-k="discountPct" data-num /><span class="input-group-text">%</span></div></div>
                <div class="col-md-6"><label class="form-label">@T["Co-pay"]</label><div class="input-group input-group-solid"><input class="form-control form-control-solid hp-num" dir="ltr" data-k="copayPct" data-num /><span class="input-group-text">%</span></div></div>
                <div class="col-md-6"><label class="form-label">@T["Co-pay cap per bill"] <span class="text-muted fs-8">@T["0 = no cap"]</span></label><div class="input-group input-group-solid"><input class="form-control form-control-solid hp-num" dir="ltr" data-k="copayCap" data-num /><span class="input-group-text">@cur</span></div></div>
                <div class="col-12"><label class="form-label">@T["Services needing the payer's approval"]</label><select class="form-select form-select-solid" multiple data-k="preauthCategories" data-control="select2" data-close-on-select="false" data-dropdown-parent="#payerModal">
                    @foreach (var c in HospitalServiceCategories.All) { <option value="@c">@T["cat:" + c]</option> }</select></div>
                <div class="col-md-4"><label class="form-label required">@T["Valid from"]</label><input type="date" class="form-control form-control-solid hp-num" data-k="validFrom" /></div>
                <div class="col-md-4"><label class="form-label">@T["Valid to"]</label><input type="date" class="form-control form-control-solid hp-num" data-k="validTo" /></div>
                <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-k="isActive" checked /><label class="form-check-label">@T["Active"]</label></div></div>
            </div>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-payer>@T["Save"]</button></div>
    </div></div></div>
}
@if (canRegister)
{
    <div class="modal fade" id="policyModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["Patient policy"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-8 px-lg-10" data-policy-form>
            <div class="row g-5">
                <div class="col-12"><label class="form-label required">@T["Patient"]</label><select class="form-select form-select-solid" data-k="patientId" data-placeholder="@T["Search by name or MRN"]"></select></div>
                <div class="col-md-6"><label class="form-label required">@T["Payer"]</label><select class="form-select form-select-solid" data-k="payerId" data-control="select2" data-hide-search="true" data-dropdown-parent="#policyModal">
                    @foreach (var r in Model) { <option value="@r.Payer.ID">@r.Payer.Code · @DisplayName.Of(r.Payer.Name, r.Payer.NameEn)</option> }</select></div>
                <div class="col-md-6"><label class="form-label required">@T["Member no."]</label><input class="form-control form-control-solid hp-num" dir="ltr" data-k="policyNo" maxlength="40" /></div>
                <div class="col-md-6"><label class="form-label">@T["Class"]</label><input class="form-control form-control-solid" data-k="memberClass" maxlength="30" /></div>
                <div class="col-md-6 d-flex align-items-end"><div class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-k="isActive" checked /><label class="form-check-label">@T["Active"]</label></div></div>
                <div class="col-md-6"><label class="form-label required">@T["Valid from"]</label><input type="date" class="form-control form-control-solid hp-num" data-k="validFrom" /></div>
                <div class="col-md-6"><label class="form-label">@T["Valid to"]</label><input type="date" class="form-control form-control-solid hp-num" data-k="validTo" /></div>
            </div>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-policy>@T["Save"]</button></div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var isAr = document.documentElement.dir === 'rtl';
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            var urls = { root: @Json.Serialize(Url.Action("Insurance")), patients: @Json.Serialize(Url.Action("SearchInsurancePatients")) };
            var today = new Date().toISOString().slice(0, 10);
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function setVal(el, v) {
                if (el.type === 'checkbox') { el.checked = v !== false; return; }
                if (window.$ && $(el).data('select2')) { $(el).val(v == null ? (el.multiple ? [] : '') : v).trigger('change'); return; }
                el.value = v == null ? '' : v;
            }
            function fill(form, data) { form.querySelectorAll('[data-k]').forEach(function (el) { setVal(el, data[el.getAttribute('data-k')]); }); }
            function read(form) {
                var o = {};
                form.querySelectorAll('[data-k]').forEach(function (el) {
                    var k = el.getAttribute('data-k'), v;
                    if (el.type === 'checkbox') v = el.checked;
                    else if (el.multiple) v = Array.prototype.map.call(el.selectedOptions, function (x) { return x.value; });
                    else v = el.value === '' ? null : el.value;
                    if (v != null && el.hasAttribute('data-num')) v = Number(v);
                    o[k] = v;
                });
                return o;
            }
            var payerEl = document.getElementById('payerModal'), policyEl = document.getElementById('policyModal'), editing = { payer: null, policy: null };
            var pickPatient = policyEl && policyEl.querySelector('[data-k=patientId]');
            if (pickPatient && window.$ && $.fn.select2) $(pickPatient).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', dropdownParent: $(policyEl), placeholder: pickPatient.getAttribute('data-placeholder'),
                ajax: { url: urls.patients, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });

            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-edit-payer],[data-edit-policy],[data-save-payer],[data-save-policy]'); if (!t) return;
                if (t.hasAttribute('data-edit-payer')) {
                    var d = t.getAttribute('data-edit-payer') ? JSON.parse(t.getAttribute('data-edit-payer')) : { kind: 'Insurer', discountPct: 0, copayPct: 0, copayCap: 0, validFrom: today, isActive: true, preauthCategories: [] };
                    editing.payer = d.id || null; fill(payerEl.querySelector('[data-payer-form]'), d);
                    bootstrap.Modal.getOrCreateInstance(payerEl).show(); return;
                }
                if (t.hasAttribute('data-edit-policy')) {
                    var p = t.getAttribute('data-edit-policy') ? JSON.parse(t.getAttribute('data-edit-policy')) : { validFrom: today, isActive: true };
                    editing.policy = p.id || null;
                    $(pickPatient).empty(); if (p.patientId) $(pickPatient).append(new Option(p.patient, p.patientId, true, true)).trigger('change');
                    var rest = Object.assign({}, p); delete rest.patientId; fill(policyEl.querySelector('[data-policy-form]'), rest);
                    bootstrap.Modal.getOrCreateInstance(policyEl).show(); return;
                }
                var isPayer = t.hasAttribute('data-save-payer'), modal = isPayer ? payerEl : policyEl;
                var body = read(modal.querySelector(isPayer ? '[data-payer-form]' : '[data-policy-form]'));
                body.id = isPayer ? editing.payer : editing.policy;
                if (isPayer) body.priceListId = body.priceListId == null ? null : Number(body.priceListId);
                else { body.patientId = Number(body.patientId || 0); body.payerId = Number(body.payerId || 0); }
                t.disabled = true;
                post(urls.root + (isPayer ? '/Payer' : '/Policy'), body).then(function (res) {
                    t.disabled = false;
                    if (!res.ok) { toast('error', res.error || W.failed); return; }
                    toast('success', W.saved); bootstrap.Modal.getOrCreateInstance(modal).hide(); swap();
                });
            });
            document.addEventListener('input', function (e) {
                var kind = e.target.getAttribute && e.target.getAttribute('data-filter'); if (!kind) return;
                var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row="' + kind + '"]').forEach(function (tr) { tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none'; });
            });
        })();
    </script>
}
