@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalAbcVenRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H151 — one medicine of the ABC/VEN analysis: its name over its code, its class (ABC + VEN), its attention category,
   its consumption value over 365 days and share of the total, what is on hand and how many days it covers. *@
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var currency = ViewBag.Currency as HospitalCurrency;
    string M(decimal v) => currency == null ? v.ToString("N2") : currency.Format(v);
}
@foreach (var r in Model)
{
    bool top = r.Category == HospitalAbcVenRules.CategoryI;
    <tr>
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-45px me-4"><span class="symbol-label bg-light-@(top ? "primary" : "secondary")"><i class="ki-outline ki-capsule fs-2 text-@(top ? "primary" : "gray-600")"></i></span></div>
            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(r.Name, r.NameEn)</span>
                <span class="text-muted fw-semibold fs-7"><bdi dir="ltr">@r.Code</bdi></span></div>
        </div></td>
        <td><span class="badge badge-light-primary fs-7 fw-bold">@r.Abc</span> <span class="badge badge-light fs-7 fw-bold" title="@(r.Ven == null ? T["Not classified in the formulary"].Value : T["ven:" + r.Ven].Value)">@(r.Ven ?? "—")</span></td>
        <td><span class="badge badge-@(top ? "primary" : "light") fs-7 fw-bold">@T["Category"] @r.Category</span></td>
        <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num" dir="ltr">@M(r.Value)</span></td>
        <td class="text-end"><span class="text-gray-700 fw-semibold hp-num" dir="ltr">@r.SharePct.ToString("0.#", inv)%</span></td>
        <td class="text-end"><span class="text-gray-700 fw-semibold hp-num">@r.OnHand.ToString("0.###", inv)</span></td>
        <td class="text-end pe-4">@if (r.DaysOfCover is int d) {<span class="fw-bold hp-num text-@(d < 14 && top ? "danger" : "gray-800")">@(d > 999 ? "999+" : d.ToString(inv))</span>} else {<span class="text-gray-400">—</span>}</td>
    </tr>
}
