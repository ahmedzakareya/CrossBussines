@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalSupplyBoard?
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H32 — ward requisitions to stores, as the approved prototype draws them (#/requisitions): the day's figures, the
    requests with who asked, and the chosen request's lines (par, what the ward holds, asked, approved, what the store
    holds). Who may ask and who may give is each unit's SETTING (H36, Supply/Units). Every change swaps in place.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Ward requisitions"].Value;
    bool ready = ViewBag.Ready == true, canManage = ViewBag.CanManage == true;
    bool mayRequest = ViewBag.MayRequest == true, mayApprove = ViewBag.MayApprove == true;
    var requestUnits = (ViewBag.RequestUnits as List<HospitalSupplyUnit>) ?? new();
    var sel = ViewBag.Selected as HospitalRequisitionView;
    var reqs = Model?.Requests ?? Array.Empty<HospitalRequisitionRow>();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Qty(decimal v) => v.ToString("0.###", inv);
    string StateKind(string s) => s switch
    {
        HospitalRequisitionStatus.Draft => "secondary", HospitalRequisitionStatus.Submitted => "primary", HospitalRequisitionStatus.Approved => "info",
        HospitalRequisitionStatus.Picking => "primary", HospitalRequisitionStatus.Dispatched => "success", _ => "danger",
    };
    string PrioKind(string p) => p == HospitalRequisitionPriority.Stat ? "danger" : p == HospitalRequisitionPriority.Urgent ? "primary" : "secondary";
    var cons = (ViewBag.Consignments as IReadOnlyList<HospitalConsignmentRow>) ?? Array.Empty<HospitalConsignmentRow>();
    bool consReady = ViewBag.ConsReady == true, mayStore = ViewBag.MayStore == true;
    var vendors = (ViewBag.Vendors as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    // used, and the supplier's purchase order not yet received / invoiced (procurement raises it approved, never draft)
    int awaitingPo = cons.Count(c => HospitalConsignmentRules.State(c.Row.Status, c.PoStatus) is "DraftPO" or "POApproved");
    string ConsKind(string st) => st switch { "Consignment" => "secondary", "DraftPO" => "primary", "Invoiced" => "success", "Returned" => "light", _ => "info" };
    // H39: the controlled-drugs register
    var cdStores = (ViewBag.CdStores as IReadOnlyList<(int WarehouseId, string Code, string Name, string NameEn)>) ?? Array.Empty<(int, string, string, string)>();
    var cdStore = ViewBag.CdStore is ValueTuple<int, string, string, string> cs0 ? cs0 : default;
    var cdLines = (ViewBag.CdLines as IReadOnlyList<HospitalControlledLine>) ?? Array.Empty<HospitalControlledLine>();
    var cdEntries = (ViewBag.CdEntries as IReadOnlyList<HospitalControlledEntryRow>) ?? Array.Empty<HospitalControlledEntryRow>();
    var cdItems = (ViewBag.CdItems as IReadOnlyList<(int Id, string Code, string Name, string NameEn)>) ?? Array.Empty<(int, string, string, string)>();
    var cdWitnesses = (ViewBag.CdWitnesses as List<(int ID, string Name, string NameEn, string? Photo)>) ?? new();
    bool cdReady = ViewBag.CdReady == true, cdMayRecord = ViewBag.CdMayRecord == true && cdStore.Item1 != 0;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Ward requisitions"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Supply"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Requisitions"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @if (canManage) { <a href="@Url.Action("SupplyUnits")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-setting-2 fs-4"></i>@T["Units & who asks"]</a> }
            @if (ready && requestUnits.Count > 0) { <button type="button" class="btn btn-sm btn-primary" data-req-new><i class="ki-outline ki-plus fs-4"></i>@T["New requisition"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready)
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Ward requisitions"]</h4>
                    <div class="fs-6 text-gray-700">@T[HospitalSupplyService.NoTables]</div>
                </div></div>
            </div>
        }
        else if (((IReadOnlyList<HospitalSupplyUnit>)ViewBag.Units).Count == 0)
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Units & who asks"]</h4>
                    <div class="fs-6 text-gray-700">@T["No supply unit is set up yet: add the wards' stores in Units & who asks."]</div>
                </div></div>
            </div>
        }

        @* H128: the day's figures — the theme's stat tiles (demo39 dashboards/logistics) *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Requests today"].Value, (Model?.Today ?? 0).ToString(inv), "", "text-gray-900", "basket", "primary"),
                (T["Average fulfilment"].Value, Model?.AverageHours is double h ? h.ToString("0.#", inv) + "\u00A0" + T["h"].Value : "—", "", "text-gray-900", "time", "info"),
                (T["Items below ward par"].Value, (Model?.BelowPar ?? 0).ToString(inv), "", "text-danger", "information-5", "danger"),
                (T["Consignment implants used"].Value, consReady ? awaitingPo.ToString(inv) : "—", T["awaiting a purchase order"].Value, "text-gray-900", "delivery-3", "primary") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold lh-1 @s.Item4"><bdi class="hp-num" dir="ltr">@s.Item2</bdi></span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item6"><i class="ki-outline ki-@s.Item5 fs-2x text-@s.Item6"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">@if (s.Item3 != "") {<span class="d-flex align-items-center fs-7 fw-semibold text-gray-500"><span class="bullet bullet-dot bg-@s.Item6 me-2"></span>@s.Item3</span>}</div>
                </div></div>
            }
        </div>

        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Ward requisitions to stores"]</span></h3>
                <div class="card-toolbar"><div class="d-flex align-items-center position-relative">
                    <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4 text-gray-500"></i>
                    <input type="text" class="form-control form-control-solid form-control-sm w-250px ps-12" placeholder="@T["Search..."]" data-req-search autocomplete="off" />
                </div></div>
            </div>
            <div class="card-body pt-2">
                @if (reqs.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-notepad fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No requests yet."]</div></div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-4 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Request"]</th><th>@T["Ward"]</th><th>@T["Requested by"]</th><th class="text-end">@T["req:Items"]</th><th>@T["Priority"]</th><th class="pe-4 rounded-end">@T["State"]</th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in reqs)
                            {
                                <tr role="button" class="@(sel?.Row.Req.ID == r.Req.ID ? "bg-light-primary" : "")" data-req-open="@r.Req.ID">
                                    <td><span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@r.Req.ReqNo</span></td>
                                    <td><span class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(r.Unit.Name, r.Unit.NameEn)</bdi></span></td>
                                    <td><div class="d-flex align-items-center">
                                        <div class="symbol symbol-30px symbol-circle me-3 flex-shrink-0">@if (r.RequestedByPhoto != null) {<img src="@r.RequestedByPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.RequestedBy ?? "")" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.RequestedBy ?? "")</span>}</div>
                                        <span class="text-gray-800 fw-semibold"><bdi>@(r.RequestedBy ?? "—")</bdi></span></div></td>
                                    <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@r.Lines</span></td>
                                    <td><span class="badge badge-light-@PrioKind(r.Req.Priority) fs-7 fw-bold">@T["prio:" + r.Req.Priority]</span></td>
                                    <td><span class="badge badge-light-@StateKind(r.Req.Status) fs-7 fw-bold">@T["req:" + r.Req.Status]</span></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        @* H38: the consignment implants — the prototype's lower-left card; H39: the controlled-drugs register beside it *@
        <div class="row g-5 mb-5">
        @if (consReady)
        {
            <div class="col-xl-6">
                <div class="card card-flush h-100">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800">@T["Consignment implants"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Owned by the supplier until used; a purchase order is then raised automatically"]</span>
                        </h3>
                        @if (mayStore) { <div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-cons-new><i class="ki-outline ki-entrance-left fs-4"></i>@T["Receive implants"]</button></div> }
                    </div>
                    <div class="card-body pt-2">
                        @if (cons.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-notepad fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No consignment implant yet."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-4 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Serial"]</th><th>@T["Item"]</th><th>@T["Patient"]</th><th>@T["State"]</th><th class="pe-4 rounded-end w-40px"></th></tr></thead>
                                <tbody class="fw-semibold text-gray-700">
                                    @foreach (var c in cons)
                                    {
                                        var stt = HospitalConsignmentRules.State(c.Row.Status, c.PoStatus);
                                        <tr>
                                            <td><span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@c.Row.SerialNo</span></td>
                                            <td><span class="text-gray-900 fw-bold"><bdi>@DisplayName.Of(c.Item, c.ItemEn)</bdi></span><div class="text-muted fw-semibold fs-7"><bdi>@DisplayName.Of(c.Vendor, c.VendorEn)</bdi></div></td>
                                            <td>@if (c.PatientName != null)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="symbol symbol-30px symbol-circle me-2 flex-shrink-0">@if (c.PatientPhoto != null) {<img src="@c.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(c.PatientNameEn ?? "")" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(c.PatientNameEn ?? "")</span>}</div>
                                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold"><bdi>@DisplayName.Of(c.PatientName, c.PatientNameEn ?? "")</bdi></span><bdi class="text-muted fw-semibold fs-7 hp-num">@c.CaseNo</bdi></div>
                                                    </div>
                                                }
                                                else { <span class="text-muted fs-8">@T[c.Row.Status == HospitalConsignmentStatus.Returned ? "Back with the supplier" : "In store"]</span> }</td>
                                            <td><span class="badge badge-light-@ConsKind(stt) fs-7 fw-bold">@T["cons:" + stt]</span>@if (c.PoNo != null) {<bdi class="d-block text-muted fw-semibold fs-8 hp-num mt-1" dir="ltr">@c.PoNo</bdi>}</td>
                                            <td class="text-end">@if (mayStore && c.Row.Status == HospitalConsignmentStatus.InStore) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" data-cons-return="@c.Row.ID" title="@T["Return to the supplier"]" data-bs-toggle="tooltip"><i class="ki-outline ki-exit-left fs-3"></i></button> }</td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>
            </div>
        }
        @if (!cdReady)
        {
            <div class="col-xl-6"><div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 h-100">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Controlled drugs register"]</h4>
                    <div class="fs-6 text-gray-700">@T[HospitalControlledService.NoTables]</div>
                </div></div>
            </div></div>
        }
        else if (cdStore.Item1 != 0)
        {
            <div class="col-xl-6" data-cd-ward="@cdStore.Item1">
                <div class="card card-flush h-100">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800">@T["Controlled drugs register"] — @DisplayName.Of(cdStore.Item3, cdStore.Item4)</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Every movement signed by two nurses"]</span>
                        </h3>
                        <div class="card-toolbar gap-2">
                            @if (cdStores.Count > 1)
                            {
                                <div class="w-175px"><select class="form-select form-select-sm form-select-solid" data-cd-pick>
                                    @foreach (var s in cdStores) { <option value="@s.WarehouseId" selected="@(s.WarehouseId == cdStore.Item1)">@s.Code · @DisplayName.Of(s.Name, s.NameEn)</option> }
                                </select></div>
                            }
                            @if (canManage) { <button type="button" class="btn btn-sm btn-icon btn-light btn-active-light-primary" data-cd-items title="@T["Controlled items"]" data-bs-toggle="tooltip"><i class="ki-outline ki-setting-2 fs-4"></i></button> }
                            @if (cdMayRecord && cdItems.Count > 0) { <button type="button" class="btn btn-sm btn-light-primary" data-cd-new><i class="ki-outline ki-pencil fs-4"></i>@T["Record a dose or waste"]</button> }
                        </div>
                    </div>
                    <div class="card-body pt-2">
                        @if (cdItems.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-notepad fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No item is marked controlled yet."]</div></div> }
                        else if (cdLines.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-notepad fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No controlled drug in this ward's store today."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-4 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light">
                                    <th class="ps-4 rounded-start">@T["Drug"]</th><th class="text-end">@T["cd:Open"]</th><th class="text-end">@T["cd:In"]</th><th class="text-end">@T["cd:Given"]</th><th class="text-end">@T["cd:Wasted"]</th><th class="pe-4 rounded-end text-end">@T["Balance"]</th>
                                </tr></thead>
                                <tbody class="fw-semibold text-gray-700">
                                    @foreach (var l in cdLines)
                                    {
                                        <tr>
                                            <td><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-capsule fs-3 text-danger"></i></span></div><span class="text-gray-900 fw-bold"><bdi>@DisplayName.Of(l.Name, l.NameEn)</bdi></span></div></td>
                                            <td class="text-end"><span class="hp-num">@Qty(l.Open)</span></td>
                                            <td class="text-end"><span class="hp-num">@Qty(l.In)</span></td>
                                            <td class="text-end"><span class="hp-num">@Qty(l.Given)</span></td>
                                            <td class="text-end"><span class="hp-num">@Qty(l.Wasted)</span></td>
                                            <td class="text-end"><span class="badge badge-light-primary fs-7 fw-bold hp-num">@Qty(l.Balance)</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                        @if (cdEntries.Count > 0)
                        {
                            <div class="separator separator-dashed my-4"></div>
                            <div class="text-gray-800 fw-bold fs-6 mb-3">@T["Today's entries"]</div>
                            @foreach (var en in cdEntries)
                            {
                                var given = en.Entry.Kind == HospitalControlledKind.Given;
                                <div class="d-flex align-items-center gap-3 py-2 border-bottom border-gray-200 border-bottom-dashed">
                                    <span class="badge badge-light-@(given ? "primary" : "danger") fs-7 fw-bold">@T["cd:" + en.Entry.Kind]</span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="text-gray-800 fw-semibold fs-7"><bdi class="hp-num" dir="ltr">@Qty(en.Entry.Qty)</bdi> × @DisplayName.Of(en.Item, en.ItemEn)</div>
                                        <div class="text-muted fs-8 text-truncate">@if (en.Patient != null) {<span>@DisplayName.Of(en.Patient, en.PatientEn ?? en.Patient) · <bdi class="hp-num">@en.Mrn</bdi></span>} else {<span dir="auto">@en.Entry.Note</span>}</div>
                                    </div>
                                    <div class="symbol-group symbol-hover flex-shrink-0">
                                        @foreach (var (who, whoEn, ph, role) in new[] { (en.Nurse, en.NurseEn, en.NursePhoto, T["Recorded by"].Value), (en.Witness, en.WitnessEn, en.WitnessPhoto, T["Witness"].Value) })
                                        {
                                            <div class="symbol symbol-30px symbol-circle" title="@role: @DisplayName.Of(who, whoEn)">@if (ph != null) {<img src="@ph" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(whoEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(whoEn)</span>}</div>
                                        }
                                    </div>
                                    <span class="text-muted fs-8 hp-num" dir="ltr" data-utc="@en.Entry.RecordedAt.ToString("o", inv)">@en.Entry.RecordedAt.ToString("HH:mm", inv)</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        </div>

        @if (sel != null)
        {
            var st = sel.Row.Req.Status;
            bool draft = st == HospitalRequisitionStatus.Draft, submitted = st == HospitalRequisitionStatus.Submitted;
            @* the chosen request — the theme's table widget (demo39 widgets/tables) *@
            <div class="card card-flush mb-5" data-req="@sel.Row.Req.ID">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800"><bdi class="hp-num">@sel.Row.Req.ReqNo</bdi> · @DisplayName.Of(sel.Row.Unit.Name, sel.Row.Unit.NameEn)</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Suggested quantity = ward par − ward balance"]</span>
                    </h3>
                    <div class="card-toolbar gap-2">
                        <span class="badge badge-light-@StateKind(st) fs-7 fw-bold py-3 px-4">@T["req:" + st]</span>
                        @if (sel.TransferNo != null) { <span class="badge badge-light-success fs-7 fw-bold py-3 px-4"><i class="ki-outline ki-arrow-right-left fs-5 me-2 text-success"></i>@T["Store transfer"] <bdi class="hp-num ms-1">@sel.TransferNo</bdi></span> }
                        else { <span class="badge badge-light fs-7 fw-bold py-3 px-4">@T["Store transfers with approval"]</span> }
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-4 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Item"]</th><th class="text-end">@T["Par"]</th><th class="text-end">@T["On ward"]</th><th class="text-end">@T["Requested"]</th><th class="text-end">@T["Approved"]</th><th class="text-end">@T["Store stock"]</th><th class="pe-4 rounded-end w-50px"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var l in sel.Lines)
                            {
                                <tr>
                                    <td><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-parcel fs-3 text-primary"></i></span></div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold"><bdi>@DisplayName.Of(l.Name, l.NameEn)</bdi></span><bdi class="text-muted fw-semibold fs-7 hp-num" dir="ltr">@l.Code</bdi></div></div></td>
                                    <td class="text-end"><span class="hp-num">@Qty(l.Par)</span></td>
                                    <td class="text-end"><span class="hp-num @(l.Par > 0 && l.OnWard < l.Par * 0.3m ? "text-danger fw-bold" : "")">@Qty(l.OnWard)</span></td>
                                    <td class="text-end">@if (draft && mayRequest) { <input class="form-control form-control-sm form-control-solid hp-num w-90px ms-auto text-end" dir="ltr" type="number" min="0" step="any" value="@Qty(l.Line.RequestedQty)" data-line-qty="@l.Line.ItemId" /> } else { <span class="hp-num">@Qty(l.Line.RequestedQty)</span> }</td>
                                    <td class="text-end">@if (submitted && mayApprove) { <input class="form-control form-control-sm form-control-solid hp-num w-90px ms-auto text-end" dir="ltr" type="number" min="0" step="any" value="@(l.Line.ApprovedQty is decimal a ? Qty(a) : Qty(Math.Min(l.Line.RequestedQty, Math.Max(0, l.StoreStock))))" data-line-approve="@l.Line.ItemId" /> } else { <span class="hp-num">@(l.Line.ApprovedQty is decimal a2 ? Qty(a2) : "—")</span> }</td>
                                    <td class="text-end"><span class="hp-num text-gray-600">@Qty(l.StoreStock)</span></td>
                                    <td class="text-end">@if (draft && mayRequest) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" data-line-remove="@l.Line.ItemId" title="@T["Remove"]" data-bs-toggle="tooltip"><i class="ki-outline ki-trash fs-3"></i></button> }</td>
                                </tr>
                            }
                            @if (sel.Lines.Count == 0) { <tr><td colspan="7"><div class="text-center py-10"><i class="ki-outline ki-parcel fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No items on this request yet."]</div></div></td></tr> }
                        </tbody>
                    </table></div>

                    @if (draft && mayRequest)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-3 mt-5 p-4 rounded bg-light">
                            <div class="w-350px"><select class="form-select form-select-sm form-select-solid" data-item-pick data-placeholder="@T["Add an item..."]"></select></div>
                            <input class="form-control form-control-sm form-control-solid hp-num w-100px" dir="ltr" type="number" min="0" step="any" placeholder="@T["Qty"]" data-item-qty />
                            <button type="button" class="btn btn-sm btn-light-primary" data-item-add><i class="ki-outline ki-plus fs-4"></i>@T["Add"]</button>
                        </div>
                    }
                    @if (sel.Row.Req.CancelReason != null) { <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-4 mt-5"><i class="ki-outline ki-information fs-2x text-danger me-3"></i><div class="fs-6 fw-semibold text-gray-700 align-self-center">@T["Cancelled"]: <span dir="auto">@sel.Row.Req.CancelReason</span></div></div> }

                    <div class="separator separator-dashed my-6"></div>
                    <div class="d-flex flex-wrap justify-content-end gap-2">
                        @if (draft && mayRequest)
                        {
                            <button type="button" class="btn btn-sm btn-light-danger" data-req-move="Cancelled" data-reason="1"><i class="ki-outline ki-cross fs-4"></i>@T["Cancel request"]</button>
                            <button type="button" class="btn btn-sm btn-primary" data-req-move="Submitted"><i class="ki-outline ki-send fs-4"></i>@T["Send to the store"]</button>
                        }
                        @if (mayApprove && (submitted || st == HospitalRequisitionStatus.Approved || st == HospitalRequisitionStatus.Picking))
                        {
                            <button type="button" class="btn btn-sm btn-light-danger" data-req-move="Cancelled" data-reason="1"><i class="ki-outline ki-cross fs-4"></i>@T["Cancel request"]</button>
                        }
                        @if (submitted && mayApprove) { <button type="button" class="btn btn-sm btn-primary" data-req-move="Approved"><i class="ki-outline ki-check fs-4"></i>@T["Approve quantities"]</button> }
                        @if (st == HospitalRequisitionStatus.Approved && mayApprove) { <button type="button" class="btn btn-sm btn-primary" data-req-move="Picking"><i class="ki-outline ki-basket fs-4"></i>@T["Start picking"]</button> }
                        @if (st == HospitalRequisitionStatus.Picking && mayApprove) { <button type="button" class="btn btn-sm btn-primary" data-req-move="Dispatched" data-confirm="1"><i class="ki-outline ki-delivery fs-4"></i>@T["Dispatch & post the transfer"]</button> }
                    </div>
                </div>
            </div>
        }
    </div></div>
</div>

