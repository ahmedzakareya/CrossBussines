@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalCatalogEntry
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var e = Model;
    ViewData["Title"] = DisplayName.Of(e.Name, e.NameEn);
    bool canManage = ViewBag.CanManage == true;
    var fac = (HospitalPriceCurrency)ViewBag.Facility;
    var lists = (ViewBag.Lists as List<HospitalPriceListView>) ?? new();
    bool isService = e.ServiceId != null;
    int holding = lists.Count(v => v.Lines.Any(x => x.Entry.Key == e.Key));
    string SrcBadge(string s) => s switch { "rule" => "primary", "override" => "info", "ceiling" => "primary", _ => "danger" };
    var dental = ViewBag.DentalProfile as HospitalDentalProcedure;
    string scope = dental == null ? "none" : dental.Surfaces != null ? "surfaces" : dental.ToothWork != null ? "work" : dental.NeedsTooth ? "tooth" : "mouth";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@DisplayName.Of(e.Name, e.NameEn)</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Catalog")" class="text-muted text-hover-primary">@T["Services & items"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted hp-num">@e.Code</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("Catalog", new { tab = e.Group })" class="btn btn-sm btn-light"><i class="ki-outline @(DisplayName.IsArabic ? "ki-arrow-right" : "ki-arrow-left") fs-4"></i>@T["Catalogue"]</a>
            @if (!isService) { <a href="@Url.Action("EditItem", "Inventory", new { id = e.ItemId })" class="btn btn-sm btn-light-primary" target="_blank"><i class="ki-outline ki-package fs-4"></i>@T["Open the item card"]</a> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8">
            <div class="col-xl-4">
                @* H128: the profile card (demo39 apps/customers/view) — a symbol over the name, then a details list *@
                <div class="card card-flush mb-5">
                    <div class="card-body pt-10">
                        <div class="d-flex flex-center flex-column mb-6">
                            <div class="symbol symbol-75px mb-5"><span class="symbol-label bg-light-@(isService ? "primary" : e.Group == HospitalPriceGroups.Medicine ? "primary" : "info")"><i class="ki-outline @(isService ? "ki-price-tag" : e.Group == HospitalPriceGroups.Medicine ? "ki-capsule" : "ki-package") fs-2tx text-@(isService ? "primary" : e.Group == HospitalPriceGroups.Medicine ? "primary" : "info")"></i></span></div>
                            <span class="fs-3 text-gray-800 fw-bold mb-1 text-center">@DisplayName.Of(e.Name, e.NameEn)</span>
                            <bdi class="fs-6 fw-semibold text-muted mb-3 hp-num" dir="ltr">@e.Code</bdi>
                            <span class="badge badge-light-primary fs-7 fw-bold">@(isService ? T["cat:" + e.Category] : T["group:" + e.Group])</span>
                        </div>
                        <div class="separator separator-dashed mb-4"></div>
                        <div class="fw-bold text-gray-500 fs-7 mt-4">@T["Type"]</div><div class="text-gray-800 fw-semibold fs-6">@(isService ? T["cat:" + e.Category] : T["group:" + e.Group])</div>
                        <div class="fw-bold text-gray-500 fs-7 mt-4">@T["Created in"]</div><div class="text-gray-800 fw-semibold fs-6">@(isService ? T["Hospital — service catalogue"] : T["Inventory — the item card"])</div>
                        @if (e.Since is DateTime since) { <div class="fw-bold text-gray-500 fs-7 mt-4">@T["Entered the catalogue"]</div><div class="text-gray-800 fw-semibold fs-6 hp-num">@since.ToString("yyyy-MM-dd")</div> }
                        <div class="fw-bold text-gray-500 fs-7 mt-4">@T["On other lists"]</div><div class="text-gray-800 fw-semibold fs-6 hp-num">@T["{0} of {1}", holding, lists.Count]</div>
                    </div>
                </div>

                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Selling price"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Main list"]</span></h3>
                        <div class="card-toolbar"><div class="symbol symbol-40px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-dollar fs-2 text-primary"></i></span></div></div></div>
                    <div class="card-body pt-2">
                        @if (isService && canManage)
                        {
                            <label class="fs-6 fw-semibold mb-2">@T["Selling price"] (<span class="hp-num">@fac.Code</span>)</label>
                            <input id="sellPrice" type="number" min="0" step="0.001" value="@e.MainPrice.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-solid hp-num mb-4" dir="ltr" />
                        }
                        else
                        {
                            <div class="d-flex align-items-baseline mb-4"><span class="fs-2hx fw-bold text-gray-900 hp-num lh-1 me-2">@fac.Format(e.MainPrice)</span><span class="fs-6 fw-semibold text-gray-500">@fac.Label(DisplayName.IsArabic)</span></div>
                        }
                        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-4">
                            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["The main list updates automatically"]</h4>
                                <div class="fs-6 text-gray-700">@(isService ? T["Saving a new price updates the main list at once, and marks this item not updated on every other list that holds it until it is reviewed:"] : T["The selling price on the Inventory item card is the main list price. Changing it there marks this item not updated on every other list that holds it:"]) <span class="hp-num fw-bold">@holding</span></div></div>
                        </div>
                        @if (isService && canManage) { <button type="button" class="btn btn-primary w-100" data-save-price><i class="ki-outline ki-check fs-4"></i>@T["Save the price"]</button> }
                    </div>
                </div>

                @if (isService && (dental != null || canManage))
                {
                    @* H15: how the tooth chart and the treatment plan treat this service *@
                    <div class="card card-flush mb-5" data-dental>
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800">@T["Dental procedure"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["How the tooth chart and the treatment plan treat this service"]</span>
                        </h3>
                        @if (dental != null) { <div class="card-toolbar"><span class="badge badge-light-primary fs-7 fw-bold">@T["dcat:" + dental.Category]</span></div> }</div>
                        <div class="card-body pt-2">
                            @if (canManage)
                            {
                                <div class="row g-3">
                                    <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Dental category"]</label>
                                        <select class="form-select form-select-solid form-select-sm" data-control="select2" data-dp="category">@foreach (var c in HospitalDentalCategory.All) { <option value="@c" selected="@(dental?.Category == c)">@T["dcat:" + c]</option> }</select></div>
                                    <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Done on"]</label>
                                        <select class="form-select form-select-solid form-select-sm" data-dp="scope">
                                            <option value="mouth" selected="@(scope == "mouth" || scope == "none")">@T["dscope:mouth"]</option>
                                            <option value="tooth" selected="@(scope == "tooth")">@T["dscope:tooth"]</option>
                                            <option value="surfaces" selected="@(scope == "surfaces")">@T["dscope:surfaces"]</option>
                                            <option value="work" selected="@(scope == "work")">@T["dscope:work"]</option>
                                        </select></div>
                                    <div class="col-6" data-dp-for="surfaces"><label class="fs-6 fw-semibold mb-2">@T["Surfaces it bills"]</label><input type="number" min="1" max="5" class="form-control form-control-solid form-control-sm hp-num" dir="ltr" data-dp="surfaces" value="@(dental?.Surfaces ?? 1)" /></div>
                                    <div class="col-6" data-dp-for="work"><label class="fs-6 fw-semibold mb-2">@T["Work on the tooth"]</label>
                                        <select class="form-select form-select-solid form-select-sm" data-control="select2" data-dp="work">@foreach (var w in HospitalToothWork.Procedures) { <option value="@w" selected="@(dental?.ToothWork == w)">@T["work:" + w]</option> }</select></div>
                                    <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Chair time (minutes)"]</label><input type="number" min="5" max="480" class="form-control form-control-solid form-control-sm hp-num" dir="ltr" data-dp="minutes" value="@(dental?.Minutes ?? 30)" /></div>
                                    <div class="col-12 d-flex flex-wrap gap-5 pt-2">
                                        <label class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-dp="preauth" @(dental?.NeedsPreauth == true ? "checked" : "") /><span class="form-check-label fs-7">@T["Needs pre-authorisation"]</span></label>
                                        <label class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-dp="lab" @(dental?.NeedsLab == true ? "checked" : "") /><span class="form-check-label fs-7">@T["Lab work"]</span></label>
                                        <label class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-dp="notCovered" @(dental?.NotCovered == true ? "checked" : "") /><span class="form-check-label fs-7">@T["Never covered"]</span></label>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-5">
                                    <button type="button" class="btn btn-light-primary flex-fill" data-dp-save><i class="ki-outline ki-check fs-4"></i>@(dental == null ? T["Make it a dental procedure"] : T["Save"])</button>
                                    @if (dental != null) { <button type="button" class="btn btn-light" data-dp-remove>@T["Not dental"]</button> }
                                </div>
                            }
                            else
                            {
                                <div class="fs-7 text-gray-700">@T["Done on"]: @T["dscope:" + scope]@if (dental!.Surfaces != null) {<text> · </text><span class="hp-num">@dental.Surfaces</span>} · <span class="hp-num">@dental.Minutes</span> @T["min"]</div>
                            }
                        </div>
                    </div>
                }

                @if (e.Group == HospitalPriceGroups.Medicine)
                {
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800">@T["Public price"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["The regulator's approved price: no list may charge more"]</span>
                        </h3></div>
                        <div class="card-body pt-2">
                            @if (canManage)
                            {
                                <input id="publicPrice" type="number" min="0" step="0.001" value="@(e.PublicPrice?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))" placeholder="@T["None"]" class="form-control form-control-solid hp-num mb-4" dir="ltr" />
                                <button type="button" class="btn btn-light-primary w-100" data-save-public><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button>
                            }
                            else { <div class="fs-2hx fw-bold text-gray-900 lh-1 hp-num">@(e.PublicPrice is decimal pp ? fac.Format(pp) : "—")</div> }
                        </div>
                    </div>
                }
            </div>

            <div class="col-xl-8">
                @* H128: table widget (demo39 widgets/tables) — the list's code and version ride under its name *@
                <div class="card card-flush">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Its price in every list"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@T["{0} of {1}", holding, lists.Count]</span></h3>
                        <div class="card-toolbar"><a href="@Url.Action("PriceLists")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-price-tag fs-4"></i>@T["Price lists"]</a></div></div>
                    <div class="card-body pt-2">
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light">
                                <th class="ps-4 rounded-start">@T["List"]</th><th>@T["Currency"]</th><th class="text-end">@T["Price"]</th><th>@T["Source"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th>
                            </tr></thead>
                            <tbody>
                                <tr>
                                    <td class="ps-4"><div class="d-flex align-items-center">
                                        <div class="symbol symbol-40px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-star fs-2 text-primary"></i></span></div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@T["Main list"]</span><bdi class="text-muted fw-semibold d-block fs-7 hp-num" dir="ltr" style="text-align:start">MAIN</bdi></div></div></td>
                                    <td><span class="badge badge-light-primary fw-bold fs-7 hp-num">@fac.Code</span></td>
                                    <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@fac.Format(e.MainPrice)</span></td>
                                    <td><span class="badge badge-light fs-7 fw-bold">@T["From the card"]</span></td>
                                    <td><span class="badge badge-light-primary fs-7 fw-bold">@T["Updated automatically"]</span></td>
                                    <td class="pe-4"></td>
                                </tr>
                                @foreach (var v in lists)
                                {
                                    var x = v.Lines.FirstOrDefault(y => y.Entry.Key == e.Key);
                                    bool foreign = v.List.CurrencyId != null;
                                    <tr>
                                        <td class="ps-4"><div class="d-flex align-items-center">
                                            <div class="symbol symbol-40px me-3 flex-shrink-0"><span class="symbol-label bg-light-@(x?.Stale == true ? "danger" : "primary")"><i class="ki-outline ki-price-tag fs-2 text-@(x?.Stale == true ? "danger" : "primary")"></i></span></div>
                                            <div class="d-flex flex-column"><span><a href="@Url.Action("PriceList", new { id = v.List.ID })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(v.List.Name, v.List.NameEn)</a>@if (v.List.Status == HospitalPriceListStatus.Draft) {<span class="badge badge-light fs-8 fw-bold ms-2">@T["plst:Draft"]</span>}</span>
                                                <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num">@v.List.Code</bdi> · <span class="hp-num" dir="ltr">v@(v.List.Version)</span></span></div></div></td>
                                        <td><span class="badge @(foreign ? "badge-light-info" : "badge-light-primary") fw-bold fs-7 hp-num">@v.Currency.Code</span></td>
                                        <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@(x?.Price is decimal p ? v.Currency.Format(p) : "—")</span></td>
                                        <td>@if (x != null) {<span class="badge badge-light-@SrcBadge(x.Source) fs-7 fw-bold">@T["src:" + x.Source]</span>}</td>
                                        <td>@if (x == null) {<span class="badge badge-light-info fs-7 fw-bold">@T["New — not added"]</span>} else if (x.Stale) {<span class="badge badge-light-danger fs-7 fw-bold">@T["Not updated"]</span>} else {<span class="badge badge-light-primary fs-7 fw-bold">@T["Up to date"]</span>}</td>
                                        <td class="text-end pe-4">
                                            @if (canManage)
                                            {
                                                if (x == null) { <button type="button" class="btn btn-sm btn-icon btn-light-primary" title="@T["Add"]" data-bs-toggle="tooltip" data-add-to="@v.List.ID"><i class="ki-outline ki-plus fs-3"></i></button> }
                                                else if (x.Stale) { <button type="button" class="btn btn-sm btn-icon btn-light-primary" title="@T["Approve"]" data-bs-toggle="tooltip" data-approve-in="@v.List.ID" data-line="@x.Line!.ID"><i class="ki-outline ki-check fs-3"></i></button> }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), mainUpdated: @Json.Serialize(T["The main list is updated"].Value) };
            var key = @Json.Serialize(e.Key);
            var urls = { price: @Json.Serialize(isService ? Url.Action("SaveServicePrice", new { id = e.ServiceId }) : null), pub: @Json.Serialize(e.ItemId != null ? Url.Action("SavePublicPrice", new { id = e.ItemId }) : null),
                list: @Json.Serialize(Url.Action("PriceList", new { id = 0 })), dental: @Json.Serialize(Url.Action("DentalSaveProcedure")) };
            // the dental card shows the field its scope needs (again after an in-place swap)
            function dpScope() { var c = document.querySelector('[data-dental]'); if (!c || !c.querySelector('[data-dp=scope]')) return; var v = c.querySelector('[data-dp=scope]').value; c.querySelectorAll('[data-dp-for]').forEach(function (el) { el.classList.toggle('d-none', el.getAttribute('data-dp-for') !== v); }); }
            dpScope(); document.addEventListener('change', function (ev) { if (ev.target.matches('[data-dp=scope]')) dpScope(); });
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            // H128: the theme's select2 for selects that come back from an in-place swap; select2's change is relayed natively
            function s2(scope) {
                if (!scope || !window.jQuery || !jQuery.fn.select2) return;
                var rtl = (document.documentElement.getAttribute('dir') || '').toLowerCase() === 'rtl';
                jQuery(scope).find('select.form-select').each(function () {
                    var el = this, $el = jQuery(el); if (el.hasAttribute('data-no-select2') || $el.hasClass('select2-hidden-accessible')) return;
                    $el.select2({ width: '100%', dir: rtl ? 'rtl' : 'ltr', minimumResultsForSearch: el.options.length > 7 ? 0 : Infinity, dropdownParent: jQuery(document.body) });
                    $el.on('change.relay', function () { if (el.__relaying) return; el.__relaying = true; el.dispatchEvent(new Event('change', { bubbles: true })); el.__relaying = false; });
                });
            }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (fresh) { document.getElementById('kt_app_content').innerHTML = fresh.innerHTML; s2(document.getElementById('kt_app_content')); dpScope(); }
                });
            }
            function done(res, msg) { if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', msg || W.saved); swap(); }
            document.addEventListener('click', function (ev) {
                var t;
                if ((t = ev.target.closest('[data-save-price]'))) { var v = document.getElementById('sellPrice').value; t.disabled = true; post(urls.price, { price: v === '' ? null : +v }).then(function (r) { t.disabled = false; done(r, W.mainUpdated); }); }
                else if ((t = ev.target.closest('[data-save-public]'))) { var p = document.getElementById('publicPrice').value; t.disabled = true; post(urls.pub, { price: p === '' ? null : +p }).then(function (r) { t.disabled = false; done(r); }); }
                else if ((t = ev.target.closest('[data-add-to]'))) { t.disabled = true; post(urls.list.replace(/0$/, t.getAttribute('data-add-to')) + '/AddLines', { keys: [key] }).then(function (r) { t.disabled = false; done(r); }); }
                else if ((t = ev.target.closest('[data-dp-save],[data-dp-remove]'))) {
                    var c = document.querySelector('[data-dental]'), g = function (k) { return c.querySelector('[data-dp=' + k + ']'); }, sc = g('scope').value;
                    var profile = { serviceId: @(e.ServiceId ?? 0), category: g('category').value, surfaces: sc === 'surfaces' ? +g('surfaces').value : null, toothWork: sc === 'work' ? g('work').value : null,
                        needsTooth: sc !== 'mouth', needsPreauth: g('preauth').checked, needsLab: g('lab').checked, notCovered: g('notCovered').checked, minutes: +g('minutes').value };
                    t.disabled = true; post(urls.dental, { profile: profile, remove: t.hasAttribute('data-dp-remove') }).then(function (r) { t.disabled = false; done(r); });
                }
                else if ((t = ev.target.closest('[data-approve-in]'))) { t.disabled = true; post(urls.list.replace(/0$/, t.getAttribute('data-approve-in')) + '/ApproveLines', { ids: [+t.getAttribute('data-line')] }).then(function (r) { t.disabled = false; done(r); }); }
            });
        })();
    </script>
}
