@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalLabCaseRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Dental lab cases"].Value;
    var s = (HospitalDentalLabStats)ViewBag.Stats;
    var labs = (ViewBag.Labs as IReadOnlyList<HospitalDentalLab>) ?? Array.Empty<HospitalDentalLab>();
    var fac = (HospitalPriceCurrency)ViewBag.Facility;
    bool canConsult = ViewBag.CanConsult == true, canMove = ViewBag.CanMove == true, canManage = ViewBag.CanManage == true;
    string Pct(decimal? v) => v == null ? "—" : v.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Dental lab cases"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Dental")" class="text-muted text-hover-primary">@T["Dentistry"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Lab"]</li>
            </ul>
        </div>
        <div class="d-flex gap-2">
            @if (canManage) { <button type="button" class="btn btn-sm btn-light" data-labs-open><i class="ki-outline ki-setting-2 fs-4"></i>@T["Labs"]</button> }
            @if (canConsult && labs.Any(l => l.IsActive)) { <button type="button" class="btn btn-sm btn-primary" data-case-open><i class="ki-outline ki-plus fs-4"></i>@T["Lab prescription"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Open cases"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@s.Open</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["On time"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@Pct(s.OnTimeRate)</div>
                <div class="text-muted fs-8 mt-1">@T["last 90 days"]</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Remake rate"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@Pct(s.RemakeRate)</div>
                @if (s.RemakeLabShare != null) { <div class="text-muted fs-8 mt-1"><span class="hp-num">@Pct(s.RemakeLabShare)</span> @T["of them the lab's fault"]</div> }</div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Lab cost this month"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@fac.Format(s.CostThisMonth) <span class="fs-7 text-muted">@fac.Code</span></div>
                <div class="text-muted fs-8 mt-1">@T["what the labs charge for this month's cases"]</div></div></div></div>
        </div>

        <div class="card mb-5">
            <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Case pipeline"]</span></div></div>
            <div class="card-body pt-2"><div class="d-flex flex-wrap gap-3">
                @foreach (var st in HospitalLabCaseStage.Pipeline)
                {
                    bool fitted = st == HospitalLabCaseStage.Fitted;
                    <div class="flex-fill rounded p-4 text-center" style="min-width:120px;background:@(fitted ? "var(--bs-light-success)" : "#F7FAFF");border:1px dashed @(fitted ? "var(--bs-success)" : "var(--cb-brand, #3A5795)")"><div class="fs-2 fw-bold hp-num">@Model.Count(c => c.Case.Stage == st)</div><div class="fs-8 fw-semibold text-gray-700">@T["dlab:" + st]</div></div>
                }
                <div class="flex-fill rounded p-4 text-center" style="min-width:120px;background:var(--bs-light-danger);border:1px dashed var(--bs-danger)"><div class="fs-2 fw-bold hp-num text-danger">@Model.Count(c => c.Case.Stage == HospitalLabCaseStage.Remake)</div><div class="fs-8 fw-semibold text-gray-700">@T["dlab:Remake"]</div></div>
            </div></div>
        </div>

        <div class="card mb-5">
            <div class="card-header border-0 pt-6">
                <div class="card-title align-items-start flex-column m-0">
                    <span class="card-label fw-bold text-gray-900 fs-4">@T["Lab cases"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@T["A prescription never leaves incomplete: tooth, type, material, shade, the due date asked"]</span>
                </div>
                <div class="card-toolbar"><div class="position-relative"><i class="ki-outline ki-magnifier fs-4 position-absolute top-50 translate-middle-y ms-3"></i><input class="form-control form-control-sm form-control-solid w-250px ps-10" placeholder="@T["Search"]" data-filter /></div></div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0) { <div class="text-center text-muted py-10">@T["No lab cases yet."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th class="w-100px">@T["Case"]</th><th>@T["Patient"]</th><th>@T["Tooth"]</th><th>@T["Type & material"]</th><th>@T["Lab"]</th><th>@T["Due"]</th><th>@T["Fit appointment"]</th><th>@T["Stage"]</th><th class="text-end">@T["Cost"]</th><th class="text-end"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in Model)
                            {
                                var c = r.Case; var next = HospitalDentalPracticeRules.NextStage(c.Stage);
                                <tr data-row="@c.CaseNo @r.PatientName @r.PatientNameEn @r.Mrn">
                                    <td><span class="badge hp-code fw-bold fs-8 hp-num">@c.CaseNo</span></td>
                                    <td><a href="@Url.Action("DentalChart", new { patientId = c.PatientId })" class="d-flex align-items-center gap-2 text-hover-primary">
                                        <div class="symbol symbol-30px symbol-circle flex-shrink-0">@if (r.PatientPhoto != null) {<img src="@r.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                        <div><div class="fw-bold text-gray-900 fs-7">@DisplayName.Of(r.PatientName, r.PatientNameEn)</div><div class="text-muted fs-8 hp-num">@r.Mrn</div></div></a></td>
                                    <td class="text-nowrap"><span class="hp-num fw-bold">@(c.Teeth ?? "—")</span></td>
                                    <td><div class="fw-semibold text-gray-800">@T["ltype:" + c.CaseType]</div><div class="text-muted fs-8">@c.Material@if (c.Shade != null) {<text> · </text>@T["Shade"] <span class="hp-num">@c.Shade</span>}</div></td>
                                    <td class="fs-7">@DisplayName.Of(r.Lab, r.LabEn)</td>
                                    <td class="text-nowrap"><span class="hp-num">@c.DueDate.ToString("yyyy-MM-dd")</span></td>
                                    <td class="text-nowrap">@if (r.FitAt != null) {<span class="hp-num @(r.AtRisk ? "text-danger fw-bold" : "")">@r.FitAt.Value.ToString("yyyy-MM-dd HH:mm")</span>} else {<span class="text-muted">—</span>}</td>
                                    <td>@if (c.Stage == HospitalLabCaseStage.Remake) {<span class="badge badge-danger fs-8">@T["dlab:Remake"]</span>} else if (c.Stage == HospitalLabCaseStage.Fitted) {<span class="badge badge-success fs-8">@T["dlab:Fitted"]</span>} else {<span class="badge badge-primary fs-8">@T["dlab:" + c.Stage]</span>}
                                        @if (c.RemakeReason != null) { <div class="text-danger fs-8 mt-1">@c.RemakeReason — @(c.RemakeFault == "Lab" ? T["lab's fault"] : T["clinic's fault"])</div> }</td>
                                    <td class="text-end"><span class="hp-num">@fac.Format(c.Cost)</span></td>
                                    <td class="text-end text-nowrap">
                                        @if (canMove && next != null) { <button type="button" class="btn btn-sm btn-light-primary py-1 px-3" data-case-move="@c.ID" data-to="@next" data-what="@c.CaseNo" data-label="@T["dlab:" + next]"><i class="ki-outline ki-arrow-left fs-6"></i>@T["dlab:" + next]</button> }
                                        @if (canMove && HospitalDentalPracticeRules.CanMove(c.Stage, HospitalLabCaseStage.Remake)) { <button type="button" class="btn btn-sm btn-light py-1 px-3" data-case-remake="@c.ID" data-what="@c.CaseNo">@T["dlab:Remake"]</button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
        <div class="notice d-flex rounded border border-dashed p-5 mb-0 hp-notice">
            <span class="symbol symbol-40px me-4 flex-shrink-0"><span class="symbol-label"><i class="ki-outline ki-information-5 fs-2 text-white"></i></span></span>
            <div><h4 class="text-gray-900 fw-bold mb-1">@T["Alert two days before, not on the due day"]</h4><div class="fs-7 text-gray-700">@T["If a case has not arrived two days before the fit, the desk is told to call the lab or move the appointment before the patient comes."]</div></div>
        </div>
    </div></div>
</div>

@if (canConsult)
{
    <div class="modal fade" id="caseModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0 fs-4">@T["Lab prescription"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-12"><label class="form-label required">@T["Patient"]</label>
                <select class="form-select form-select-solid" data-lc="patient" data-person-select data-person-ajax="@Url.Action("SearchDentalPatients")" data-searching="@T["Searching…"]" data-no-results="@T["No patient matches"]" data-placeholder="@T["Patient"]"><option value=""></option></select></div>
            <div class="col-md-6"><label class="form-label required">@T["Lab"]</label><select class="form-select form-select-solid" data-lc="lab">@foreach (var l in labs.Where(l => l.IsActive)) { <option value="@l.ID">@DisplayName.Of(l.Name, l.NameEn)</option> }</select></div>
            <div class="col-md-6"><label class="form-label required">@T["Type of work"]</label><select class="form-select form-select-solid" data-lc="type">@foreach (var t in HospitalLabCaseType.All) { <option value="@t">@T["ltype:" + t]</option> }</select></div>
            <div class="col-md-4"><label class="form-label">@T["Tooth"]</label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="20" data-lc="teeth" placeholder="26 · 11–21" /></div>
            <div class="col-md-4"><label class="form-label required">@T["Material"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="60" data-lc="material" placeholder="Zirconia" /></div>
            <div class="col-md-4"><label class="form-label">@T["Shade"]</label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="10" data-lc="shade" placeholder="A2" /></div>
            <div class="col-md-6"><label class="form-label required">@T["Due"]</label><input type="date" class="form-control form-control-solid hp-num" data-lc="due" min="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-6"><label class="form-label">@T["Cost"] <span class="text-muted fs-8">@fac.Code</span></label><input type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" data-lc="cost" value="0" /></div>
            <div class="col-12"><label class="form-label">@T["Fit appointment"] <span class="text-muted fs-8">@T["the patient's coming chair appointments"]</span></label><select class="form-select form-select-solid" data-lc="fit"><option value="">—</option></select></div>
        </div></div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-lc-save>@T["Send the prescription"]</button></div>
    </div></div></div>
}
@if (canManage)
{
    <div class="modal fade" id="labsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0 fs-4">@T["Labs"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10">
            <div class="table-responsive mb-6"><table class="table align-middle table-row-dashed fs-7 gy-2 mb-0"><tbody>
                @foreach (var l in labs)
                {
                    <tr><td>@DisplayName.Of(l.Name, l.NameEn)</td><td class="hp-num">@(l.Phone ?? "—")</td><td>@if (!l.IsActive) {<span class="badge badge-light fs-9">@T["Inactive"]</span>}</td>
                        <td class="text-end"><button type="button" class="btn btn-sm btn-light" data-lab-edit="@System.Text.Json.JsonSerializer.Serialize(new { id = l.ID, name = l.Name, nameEn = l.NameEn, phone = l.Phone, isActive = l.IsActive })">@T["Edit"]</button></td></tr>
                }
            </tbody></table></div>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label required fs-7">@T["Name (Arabic)"]</label><input class="form-control form-control-solid form-control-sm" dir="rtl" maxlength="150" data-lb="name" /></div>
                <div class="col-md-6"><label class="form-label required fs-7">@T["Name (English)"]</label><input class="form-control form-control-solid form-control-sm" dir="ltr" maxlength="150" data-lb="nameEn" /></div>
                <div class="col-md-6"><label class="form-label fs-7">@T["Phone"]</label><input class="form-control form-control-solid form-control-sm hp-num" dir="ltr" maxlength="30" data-lb="phone" /></div>
                <div class="col-md-6 d-flex align-items-end"><label class="form-check form-check-sm form-check-custom form-check-solid mb-2"><input class="form-check-input" type="checkbox" data-lb="isActive" checked /><span class="form-check-label fs-7">@T["Active"]</span></label></div>
            </div>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-lb-save>@T["Save"]</button></div>
    </div></div></div>
}

@section Scripts {
    <partial name="_PersonSelect" />
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Dental"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                move: @Json.Serialize(T["{1}: {0}?"].Value), why: @Json.Serialize(T["Why is {0} remade?"].Value), whose: @Json.Serialize(T["Whose fault is the remake?"].Value), lab_: @Json.Serialize(T["The lab's"].Value), clinic: @Json.Serialize(T["The clinic's"].Value), cancel: @Json.Serialize(T["Cancel"].Value),
                send: @Json.Serialize(T["Send this prescription to the lab?"].Value), lab: @Json.Serialize(T["Save this lab?"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            // a code inside an Arabic sentence keeps its own direction (first-strong isolate … pop)
            function iso(x) { return '⁨' + x + '⁩'; }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            var cm = document.getElementById('caseModal'), lm = document.getElementById('labsModal'), labEditing = null;
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.getElementById('kt_app_content'), tb = d.getElementById('kt_app_toolbar');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                    if (tb) document.getElementById('kt_app_toolbar').innerHTML = tb.innerHTML;
                    var rows = d.querySelector('#labsModal tbody'), opts = d.querySelector('#caseModal [data-lc=lab]');
                    if (rows && lm) lm.querySelector('tbody').innerHTML = rows.innerHTML;
                    if (opts && cm) cm.querySelector('[data-lc=lab]').innerHTML = opts.innerHTML;
                });
            }
            function done(btn, modal) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); if (modal) bootstrap.Modal.getOrCreateInstance(modal).hide(); swap(); }; }
            // the fit appointment list follows the chosen patient
            if (cm && window.$) $(cm.querySelector('[data-lc=patient]')).on('select2:select', function (e) {
                fetch(root + '/Patient/' + e.params.data.id + '/Visits').then(function (r) { return r.json(); }).then(function (d) {
                    cm.querySelector('[data-lc=fit]').innerHTML = '<option value="">—</option>' + (d.results || []).map(function (x) { return '<option value="' + x.id + '">' + x.text + '</option>'; }).join('');
                });
            });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-case-move],[data-case-remake],[data-case-open],[data-lc-save],[data-labs-open],[data-lab-edit],[data-lb-save]'); if (!t) return;
                if (t.hasAttribute('data-case-move')) {
                    cbConfirm(W.move.replace('{0}', iso(t.getAttribute('data-what'))).replace('{1}', t.getAttribute('data-label'))).then(function (ok) {
                        if (!ok) return; t.disabled = true; post(root + '/LabCase/' + t.getAttribute('data-case-move') + '/Move', { to: t.getAttribute('data-to') }).then(done(t));
                    });
                    return;
                }
                if (t.hasAttribute('data-case-remake')) {
                    cbPrompt(W.why.replace('{0}', iso(t.getAttribute('data-what'))), { kind: 'danger' }).then(function (why) {
                        if (!why) return;
                        // whose fault: the house SweetAlert with both answers and a real cancel (never the browser's dialog)
                        Swal.fire({ title: W.whose, icon: 'question', iconColor: '#3A5795', showDenyButton: true, showCancelButton: true, buttonsStyling: false,
                            confirmButtonText: W.lab_, denyButtonText: W.clinic, cancelButtonText: W.cancel,
                            customClass: { container: 'cb-confirm-top', confirmButton: 'btn fw-bold btn-primary', denyButton: 'btn fw-bold btn-light-primary', cancelButton: 'btn fw-bold btn-light' } }).then(function (r) {
                            if (!r.isConfirmed && !r.isDenied) return;
                            t.disabled = true; post(root + '/LabCase/' + t.getAttribute('data-case-remake') + '/Move', { to: 'Remake', fault: r.isConfirmed ? 'Lab' : 'Clinic', reason: why }).then(done(t));
                        });
                    });
                    return;
                }
                if (t.hasAttribute('data-case-open')) { bootstrap.Modal.getOrCreateInstance(cm).show(); return; }
                if (t.hasAttribute('data-lc-save')) {
                    var g = function (k) { return cm.querySelector('[data-lc=' + k + ']').value.trim(); };
                    var body = { patientId: +g('patient') || 0, labId: +g('lab') || 0, caseType: g('type'), teeth: g('teeth') || null, material: g('material'), shade: g('shade') || null,
                        dueDate: g('due') || null, cost: +g('cost') || 0, fitAppointmentId: g('fit') ? +g('fit') : null };
                    cbConfirm(W.send).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/LabCase', body).then(done(t, cm)); });
                    return;
                }
                if (t.hasAttribute('data-labs-open') || t.hasAttribute('data-lab-edit')) {
                    var d = t.hasAttribute('data-lab-edit') ? JSON.parse(t.getAttribute('data-lab-edit')) : { name: '', nameEn: '', phone: '', isActive: true };
                    labEditing = d.id || null;
                    lm.querySelectorAll('[data-lb]').forEach(function (i) { var k = i.getAttribute('data-lb'); if (i.type === 'checkbox') i.checked = d[k] !== false; else i.value = d[k] == null ? '' : d[k]; });
                    bootstrap.Modal.getOrCreateInstance(lm).show(); return;
                }
                var b = { id: labEditing }; lm.querySelectorAll('[data-lb]').forEach(function (i) { var k = i.getAttribute('data-lb'); b[k] = i.type === 'checkbox' ? i.checked : (i.value.trim() || null); });
                cbConfirm(W.lab).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Labs', b).then(done(t, lm)); });
            });
            var f = document.querySelector('[data-filter]');
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-filter]')) return; var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row]').forEach(function (r) { r.classList.toggle('d-none', q && r.getAttribute('data-row').toLowerCase().indexOf(q) === -1); });
            });
        })();
    </script>
}
