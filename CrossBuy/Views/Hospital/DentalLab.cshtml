@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalLabCaseRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Dental lab cases"].Value;
    var s = (HospitalDentalLabStats)ViewBag.Stats;
    var labs = (ViewBag.Labs as IReadOnlyList<HospitalDentalLab>) ?? Array.Empty<HospitalDentalLab>();
    var fac = (HospitalPriceCurrency)ViewBag.Facility;
    bool canConsult = ViewBag.CanConsult == true, canMove = ViewBag.CanMove == true, canManage = ViewBag.CanManage == true;
    var perf = (ViewBag.Performance as IReadOnlyList<HospitalLabPerformance>) ?? Array.Empty<HospitalLabPerformance>();   // H187
    string Pct(decimal? v) => v == null ? "—" : v.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    // H127: a stat tile of the theme (demo39 dashboards/logistics) — the figure over its label, an icon, a line under it
    void Stat(string label, string value, string? unit, object? sub, string icon, string tone)
    {
        <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
            <div class="card-header pt-5 flex-nowrap gap-3">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-baseline flex-wrap"><span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2 hp-num">@value</span>@if (unit != null) {<span class="fs-6 fw-semibold text-gray-500 hp-num">@unit</span>}</div>
                    <span class="text-gray-500 pt-1 fw-semibold fs-6">@label</span>
                </div>
                <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-2x text-@tone"></i></span></div></div>
            </div>
            <div class="card-body d-flex align-items-end pt-0">
                <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500">@if (sub != null) {<span class="bullet w-8px h-6px rounded-2 bg-@tone me-3 flex-shrink-0"></span><span>@sub</span>} else {<span>&nbsp;</span>}</div>
            </div>
        </div></div>
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Dental lab cases"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Dental")" class="text-muted text-hover-primary">@T["Dentistry"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Lab"]</li>
            </ul>
        </div>
        <div class="d-flex gap-2">
            @if (canManage) { <button type="button" class="btn btn-sm btn-light btn-active-light-primary" data-labs-open><i class="ki-outline ki-setting-2 fs-4"></i>@T["Labs"]</button> }
            @if (canConsult && labs.Any(l => l.IsActive)) { <button type="button" class="btn btn-sm btn-primary" data-case-open><i class="ki-outline ki-plus fs-4"></i>@T["Lab prescription"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H127: the lab's figures — demo39 dashboards/logistics stat tiles *@
        <div class="row g-5 g-xl-8 mb-5">
            @{
                Stat(T["Open cases"].Value, s.Open.ToString(), null, null, "abstract-26", "primary");
                Stat(T["On time"].Value, Pct(s.OnTimeRate), null, T["last 90 days"], "time", "primary");
                Stat(T["Remake rate"].Value, Pct(s.RemakeRate), null, s.RemakeLabShare == null ? null : new Microsoft.AspNetCore.Html.HtmlString("<span class=\"hp-num\">" + Pct(s.RemakeLabShare) + "</span>&nbsp;" + System.Net.WebUtility.HtmlEncode(T["of them the lab's fault"].Value)), "arrows-circle", "danger");
                Stat(T["Lab cost this month"].Value, fac.Format(s.CostThisMonth), fac.Code, T["what the labs charge for this month's cases"], "bill", "info");
            }
        </div>

        @* H127: the pipeline — the dashed figure boxes of demo39 account/overview *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Case pipeline"]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@Model.Count</span></h3></div>
            <div class="card-body pt-2"><div class="d-flex flex-wrap gap-4">
                @foreach (var st in HospitalLabCaseStage.Pipeline)
                {
                    bool fitted = st == HospitalLabCaseStage.Fitted;
                    <div class="flex-fill border border-dashed rounded min-w-125px py-3 px-4 @(fitted ? "border-primary bg-light-primary" : "border-gray-300")">
                        <div class="d-flex align-items-center"><i class="ki-outline @(fitted ? "ki-check-circle text-primary" : "ki-abstract-26 text-primary") fs-3 me-2"></i><div class="fs-2 fw-bold hp-num text-gray-900">@Model.Count(c => c.Case.Stage == st)</div></div>
                        <div class="fw-semibold fs-6 text-gray-500">@T["dlab:" + st]</div>
                    </div>
                }
                <div class="flex-fill border border-dashed border-danger bg-light-danger rounded min-w-125px py-3 px-4">
                    <div class="d-flex align-items-center"><i class="ki-outline ki-arrows-circle text-danger fs-3 me-2"></i><div class="fs-2 fw-bold hp-num text-danger">@Model.Count(c => c.Case.Stage == HospitalLabCaseStage.Remake)</div></div>
                    <div class="fw-semibold fs-6 text-gray-500">@T["dlab:Remake"]</div>
                </div>
            </div></div>
        </div>

        @* H127: the cases — demo39 widgets/tables *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Lab cases"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["A prescription never leaves incomplete: tooth, type, material, shade, the due date asked"]</span>
                </h3>
                <div class="card-toolbar"><div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Search"]" data-filter /></div></div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-abstract-26 fs-3x text-gray-300 mb-4 d-block"></i>
                        <div class="fs-6 fw-bold text-gray-700">@T["No lab cases yet."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Case"]</th><th>@T["Type & material"]</th><th>@T["Lab"]</th><th>@T["Due"]</th><th>@T["Fit appointment"]</th><th>@T["Stage"]</th><th class="text-end">@T["Cost"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var c = r.Case; var next = HospitalDentalPracticeRules.NextStage(c.Stage);
                                <tr data-row="@c.CaseNo @r.PatientName @r.PatientNameEn @r.Mrn">
                                    <td class="ps-4"><a href="@Url.Action("DentalChart", new { patientId = c.PatientId })" class="d-flex align-items-center text-hover-primary">
                                        <div class="symbol symbol-40px symbol-circle flex-shrink-0 me-3">@if (r.PatientPhoto != null) {<img src="@r.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(r.PatientName, r.PatientNameEn)</span><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi></div></a></td>
                                    <td class="text-nowrap"><bdi class="text-gray-900 fw-bold fs-7 hp-num d-block">@c.CaseNo</bdi><span class="text-muted fw-semibold fs-7">@T["Tooth"]&nbsp;<bdi class="hp-num">@(c.Teeth ?? "—")</bdi></span></td>
                                    <td><span class="text-gray-900 fw-bold d-block fs-7">@T["ltype:" + c.CaseType]</span><span class="text-muted fw-semibold fs-7"><bdi>@c.Material</bdi>@if (c.Shade != null) {<text> · </text>@T["Shade"]<text>&nbsp;</text><bdi class="hp-num">@c.Shade</bdi>}</span>
                                        @if (c.ImpressionKind != null) {<div class="mt-1"><span class="badge badge-light-primary fs-8 fw-bold" title="@(c.Disinfectant == null ? "" : T["Disinfected with {0}", c.Disinfectant].Value)" data-bs-toggle="tooltip">@T["imp:" + c.ImpressionKind]@if (c.Disinfectant != null) {<i class="ki-outline ki-shield-tick fs-7 ms-1 text-primary"></i>}</span></div>}</td>
                                    <td class="text-gray-800 fw-semibold fs-7">@DisplayName.Of(r.Lab, r.LabEn)</td>
                                    <td class="text-nowrap"><span class="text-gray-800 fw-semibold hp-num">@c.DueDate.ToString("yyyy-MM-dd")</span></td>
                                    <td class="text-nowrap">@if (r.FitAt != null) {<span class="badge badge-light-@(r.AtRisk ? "danger" : "primary") fs-7 fw-bold hp-num">@r.FitAt.Value.ToString("yyyy-MM-dd HH:mm")</span>} else {<span class="text-muted">—</span>}</td>
                                    <td>@if (c.Stage == HospitalLabCaseStage.Remake) {<span class="badge badge-light-danger fs-7 fw-bold">@T["dlab:Remake"]</span>} else if (c.Stage == HospitalLabCaseStage.Fitted) {<span class="badge badge-light-primary fs-7 fw-bold">@T["dlab:Fitted"]</span>} else {<span class="badge badge-light-primary fs-7 fw-bold">@T["dlab:" + c.Stage]</span>}
                                        @if (c.RemakeReason != null) { <div class="text-danger fw-semibold fs-8 mt-1">@c.RemakeReason — @(c.RemakeFault == "Lab" ? T["lab's fault"] : T["clinic's fault"])</div> }
                                        @if (c.QcAt != null) { <div class="fs-8 text-gray-700 mt-1"><i class="ki-outline ki-check-square fs-7 text-primary me-1"></i>@T["Checked on receipt"]</div> }</td>
                                    <td class="text-end"><span class="text-gray-900 fw-bold hp-num">@fac.Format(c.Cost)</span></td>
                                    <td class="text-end pe-4 text-nowrap">
                                        @if (canMove && next != null) { <button type="button" class="btn btn-sm btn-light-primary" data-case-move="@c.ID" data-to="@next" data-what="@c.CaseNo" data-label="@T["dlab:" + next]" data-imp="@c.ImpressionKind" data-qc="@((next == HospitalLabCaseStage.Received || (next == HospitalLabCaseStage.Fitted && c.QcAt == null)) ? "1" : "")"><i class="ki-outline ki-arrow-left fs-4"></i>@T["dlab:" + next]</button> }
                                        @if (canMove && HospitalDentalPracticeRules.CanMove(c.Stage, HospitalLabCaseStage.Remake)) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger ms-1" title="@T["dlab:Remake"]" data-bs-toggle="tooltip" data-case-remake="@c.ID" data-what="@c.CaseNo"><i class="ki-outline ki-arrows-circle fs-3"></i></button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
        @* H187: each lab's record *@
        @if (perf.Count > 0)
        {
            <div class="card card-flush mb-5">
                <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Each lab's record"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["On time over the last 90 days; remakes and turnaround over every case sent."]</span></h3></div>
                <div class="card-body pt-2"><div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-3 my-0">
                    <thead><tr class="fs-7 fw-bold text-gray-500 border-bottom-0"><th>@T["Lab"]</th><th class="text-end">@T["Cases"]</th><th class="text-end">@T["On time"]</th><th class="text-end">@T["Remake rate"]</th><th class="text-end">@T["The lab's fault"]</th><th class="text-end">@T["Days to return"]</th></tr></thead>
                    <tbody>@foreach (var p in perf)
                    {
                        <tr><td class="text-gray-800 fw-bold">@DisplayName.Of(p.Name, p.NameEn)</td><td class="text-end hp-num">@p.Cases</td>
                            <td class="text-end"><span class="badge badge-light-@(p.OnTimeRate is decimal ot && ot < 80 ? "danger" : "primary") fs-7 fw-bold hp-num">@Pct(p.OnTimeRate)</span></td>
                            <td class="text-end"><span class="badge badge-light-@(p.RemakeRate is decimal rr && rr >= 10 ? "danger" : "primary") fs-7 fw-bold hp-num">@Pct(p.RemakeRate)</span></td>
                            <td class="text-end hp-num">@p.LabFaultRemakes</td><td class="text-end hp-num">@(p.AvgTurnaroundDays?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td></tr>
                    }</tbody></table></div></div>
            </div>
        }
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Alert two days before, not on the due day"]</h4><div class="fs-6 text-gray-700">@T["If a case has not arrived two days before the fit, the desk is told to call the lab or move the appointment before the patient comes."]</div></div>
        </div>
    </div></div>
</div>

@if (canConsult)
{
    @* H127: the theme's form modals (demo39 utilities/modals/forms/new-target) *@
    <div class="modal fade" id="caseModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Lab prescription"]</h1><div class="text-muted fw-semibold fs-5">@T["A prescription never leaves incomplete: tooth, type, material, shade, the due date asked"]</div></div>
            <div class="row g-6">
                <div class="col-12"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Patient"]</label>
                    <select class="form-select form-select-solid" data-lc="patient" data-person-select data-person-ajax="@Url.Action("SearchDentalPatients")" data-searching="@T["Searching…"]" data-no-results="@T["No patient matches"]" data-placeholder="@T["Patient"]"><option value=""></option></select></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Lab"]</label><select class="form-select form-select-solid" data-lc="lab">@foreach (var l in labs.Where(l => l.IsActive)) { <option value="@l.ID">@DisplayName.Of(l.Name, l.NameEn)</option> }</select></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Type of work"]</label><select class="form-select form-select-solid" data-lc="type">@foreach (var t in HospitalLabCaseType.All) { <option value="@t">@T["ltype:" + t]</option> }</select></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Impression"]</label><select class="form-select form-select-solid" data-lc="impression" data-placeholder="@T["Choose"]"><option></option>@foreach (var k in HospitalLabImpression.All) { <option value="@k">@T["imp:" + k]</option> }</select></div>
                <div class="col-md-6 d-flex align-items-end"><div class="text-muted fs-7">@T["A conventional impression leaves for the lab only disinfected; the disinfectant is recorded when it is sent."]</div></div>
                <div class="col-md-4"><label class="d-block fs-6 fw-semibold mb-2">@T["Tooth"]</label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="20" data-lc="teeth" placeholder="26 · 11–21" /></div>
                <div class="col-md-4"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Material"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="60" data-lc="material" placeholder="Zirconia" /></div>
                <div class="col-md-4"><label class="d-block fs-6 fw-semibold mb-2">@T["Shade"]</label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="10" data-lc="shade" placeholder="A2" /></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Due"]</label><input type="date" class="form-control form-control-solid hp-num" data-lc="due" min="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Cost"] <span class="text-muted fs-8">@fac.Code</span></label><input type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" data-lc="cost" value="0" /></div>
                <div class="col-12"><label class="d-block fs-6 fw-semibold mb-2">@T["Fit appointment"] <span class="text-muted fs-8">@T["the patient's coming chair appointments"]</span></label><select class="form-select form-select-solid" data-lc="fit"><option value="">—</option></select></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-lc-save>@T["Send the prescription"]</button></div>
        </div>
    </div></div></div>
}
@if (canManage)
{
    <div class="modal fade" id="labsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-8 text-center"><h1 class="mb-3">@T["Labs"]</h1></div>
            <div class="table-responsive mb-8"><table class="table align-middle gs-0 gy-3 mb-0"><tbody>
                @foreach (var l in labs)
                {
                    <tr><td class="ps-0"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-abstract-26 fs-3 text-primary"></i></span></div><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(l.Name, l.NameEn)</span></div></td>
                        <td><bdi class="text-gray-600 fw-semibold hp-num">@(l.Phone ?? "—")</bdi></td><td>@if (!l.IsActive) {<span class="badge badge-light-secondary fs-8 fw-bold">@T["Inactive"]</span>}</td>
                        <td class="text-end pe-0"><button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Edit"]" data-lab-edit="@System.Text.Json.JsonSerializer.Serialize(new { id = l.ID, name = l.Name, nameEn = l.NameEn, phone = l.Phone, isActive = l.IsActive })"><i class="ki-outline ki-pencil fs-3"></i></button></td></tr>
                }
            </tbody></table></div>
            <div class="separator separator-dashed mb-8"></div>
            <div class="row g-6">
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Name (Arabic)"]</label><input class="form-control form-control-solid" dir="rtl" maxlength="150" data-lb="name" /></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Name (English)"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="150" data-lb="nameEn" /></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Phone"]</label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="30" data-lb="phone" /></div>
                <div class="col-md-6 d-flex align-items-end"><label class="form-check form-switch form-check-custom form-check-solid mb-3"><input class="form-check-input" type="checkbox" data-lb="isActive" checked /><span class="form-check-label fw-semibold text-gray-700">@T["Active"]</span></label></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-lb-save>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@* H187: the check of the work on receipt *@
@if (canMove)
{
    <div class="modal fade" id="qcModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-500px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-8 text-center"><h1 class="mb-3">@T["Check the work"]</h1><div class="text-muted fw-semibold fs-5"><bdi class="hp-num" data-qc-what></bdi></div></div>
            <div class="d-flex flex-column gap-4">@foreach (var q in HospitalDentalLabQcRules.QcItems)
            {
                <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" value="@q" data-qc-item /><span class="form-check-label fw-semibold text-gray-800">@T["qc:" + q]</span></label>
            }</div>
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-4 mt-6 fs-7 text-gray-700">@T["Work that fails any check is not received: send it back as a remake."]</div>
            <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-qc-save>@T["Passed: record"]</button></div>
        </div>
    </div></div></div>
}
@section Scripts {
    <partial name="_PersonSelect" />
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Dental"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                move: @Json.Serialize(T["{1}: {0}?"].Value), why: @Json.Serialize(T["Why is {0} remade?"].Value), whose: @Json.Serialize(T["Whose fault is the remake?"].Value), lab_: @Json.Serialize(T["The lab's"].Value), clinic: @Json.Serialize(T["The clinic's"].Value), cancel: @Json.Serialize(T["Cancel"].Value),
                send: @Json.Serialize(T["Send this prescription to the lab?"].Value),
                disinfect: @Json.Serialize(T["Which disinfectant was the impression of {0} treated with?"].Value), disinfectant: @Json.Serialize(T["e.g. sodium hypochlorite 1%, 10 minutes"].Value), qcFail: @Json.Serialize(T["The work passes every check to be received: send what fails back as a remake"].Value), lab: @Json.Serialize(T["Save this lab?"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            // a code inside an Arabic sentence keeps its own direction (first-strong isolate … pop)
            function iso(x) { return '⁨' + x + '⁩'; }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            var cm = document.getElementById('caseModal'), lm = document.getElementById('labsModal'), labEditing = null, qm = document.getElementById('qcModal'), moving = null;
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.getElementById('kt_app_content'), tb = d.getElementById('kt_app_toolbar');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                    if (tb) document.getElementById('kt_app_toolbar').innerHTML = tb.innerHTML;
                    var rows = d.querySelector('#labsModal tbody'), opts = d.querySelector('#caseModal [data-lc=lab]');
                    if (rows && lm) lm.querySelector('tbody').innerHTML = rows.innerHTML;
                    if (opts && cm) cm.querySelector('[data-lc=lab]').innerHTML = opts.innerHTML;
                });
            }
            function done(btn, modal) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); if (modal) bootstrap.Modal.getOrCreateInstance(modal).hide(); swap(); }; }
            // the fit appointment list follows the chosen patient
            if (cm && window.$) $(cm.querySelector('[data-lc=patient]')).on('select2:select', function (e) {
                fetch(root + '/Patient/' + e.params.data.id + '/Visits').then(function (r) { return r.json(); }).then(function (d) {
                    cm.querySelector('[data-lc=fit]').innerHTML = '<option value="">—</option>' + (d.results || []).map(function (x) { return '<option value="' + x.id + '">' + x.text + '</option>'; }).join('');
                });
            });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-case-move],[data-case-remake],[data-case-open],[data-lc-save],[data-labs-open],[data-lab-edit],[data-lb-save],[data-qc-save]'); if (!t) return;
                if (t.hasAttribute('data-case-move') && t.getAttribute('data-qc') === '1') {   // H187: the check of the work before it is received (or fitted)
                    moving = t; qm.querySelector('[data-qc-what]').textContent = t.getAttribute('data-what');
                    qm.querySelectorAll('[data-qc-item]').forEach(function (i) { i.checked = false; }); bootstrap.Modal.getOrCreateInstance(qm).show(); return;
                }
                if (t.hasAttribute('data-qc-save')) {
                    var passed = []; qm.querySelectorAll('[data-qc-item]').forEach(function (i) { if (i.checked) passed.push(i.value); });
                    if (passed.length < qm.querySelectorAll('[data-qc-item]').length) { toast('warning', W.qcFail); return; }
                    t.disabled = true; post(root + '/LabCase/' + moving.getAttribute('data-case-move') + '/Move', { to: moving.getAttribute('data-to'), qc: passed }).then(done(t, qm)); return;
                }
                if (t.hasAttribute('data-case-move') && t.getAttribute('data-to') === 'Sent' && t.getAttribute('data-imp') === 'Conventional') {   // H187: disinfected before it leaves
                    cbPrompt(W.disinfect.replace('{0}', iso(t.getAttribute('data-what'))), { placeholder: W.disinfectant }).then(function (d) {
                        if (!d) return; t.disabled = true; post(root + '/LabCase/' + t.getAttribute('data-case-move') + '/Move', { to: 'Sent', disinfectant: d }).then(done(t)); });
                    return;
                }
                if (t.hasAttribute('data-case-move')) {
                    cbConfirm(W.move.replace('{0}', iso(t.getAttribute('data-what'))).replace('{1}', t.getAttribute('data-label'))).then(function (ok) {
                        if (!ok) return; t.disabled = true; post(root + '/LabCase/' + t.getAttribute('data-case-move') + '/Move', { to: t.getAttribute('data-to') }).then(done(t));
                    });
                    return;
                }
                if (t.hasAttribute('data-case-remake')) {
                    cbPrompt(W.why.replace('{0}', iso(t.getAttribute('data-what'))), { kind: 'danger' }).then(function (why) {
                        if (!why) return;
                        // whose fault: the house SweetAlert with both answers and a real cancel (never the browser's dialog)
                        Swal.fire({ title: W.whose, icon: 'question', iconColor: '#3A5795', showDenyButton: true, showCancelButton: true, buttonsStyling: false,
                            confirmButtonText: W.lab_, denyButtonText: W.clinic, cancelButtonText: W.cancel,
                            customClass: { container: 'cb-confirm-top', confirmButton: 'btn fw-bold btn-primary', denyButton: 'btn fw-bold btn-light-primary', cancelButton: 'btn fw-bold btn-light' } }).then(function (r) {
                            if (!r.isConfirmed && !r.isDenied) return;
                            t.disabled = true; post(root + '/LabCase/' + t.getAttribute('data-case-remake') + '/Move', { to: 'Remake', fault: r.isConfirmed ? 'Lab' : 'Clinic', reason: why }).then(done(t));
                        });
                    });
                    return;
                }
                if (t.hasAttribute('data-case-open')) { bootstrap.Modal.getOrCreateInstance(cm).show(); return; }
                if (t.hasAttribute('data-lc-save')) {
                    var g = function (k) { return cm.querySelector('[data-lc=' + k + ']').value.trim(); };
                    var body = { patientId: +g('patient') || 0, labId: +g('lab') || 0, caseType: g('type'), teeth: g('teeth') || null, material: g('material'), shade: g('shade') || null,
                        dueDate: g('due') || null, cost: +g('cost') || 0, fitAppointmentId: g('fit') ? +g('fit') : null, impressionKind: g('impression') || null };
                    cbConfirm(W.send).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/LabCase', body).then(done(t, cm)); });
                    return;
                }
                if (t.hasAttribute('data-labs-open') || t.hasAttribute('data-lab-edit')) {
                    var d = t.hasAttribute('data-lab-edit') ? JSON.parse(t.getAttribute('data-lab-edit')) : { name: '', nameEn: '', phone: '', isActive: true };
                    labEditing = d.id || null;
                    lm.querySelectorAll('[data-lb]').forEach(function (i) { var k = i.getAttribute('data-lb'); if (i.type === 'checkbox') i.checked = d[k] !== false; else i.value = d[k] == null ? '' : d[k]; });
                    bootstrap.Modal.getOrCreateInstance(lm).show(); return;
                }
                var b = { id: labEditing }; lm.querySelectorAll('[data-lb]').forEach(function (i) { var k = i.getAttribute('data-lb'); b[k] = i.type === 'checkbox' ? i.checked : (i.value.trim() || null); });
                cbConfirm(W.lab).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Labs', b).then(done(t, lm)); });
            });
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-filter]')) return; var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row]').forEach(function (r) { r.classList.toggle('d-none', q && r.getAttribute('data-row').toLowerCase().indexOf(q) === -1); });
            });
        })();
    </script>
}
