@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalOrthoRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Orthodontics"].Value;
    var s = (HospitalOrthoStats)ViewBag.Stats;
    var dentists = (ViewBag.Dentists as IReadOnlyList<HospitalDentist>) ?? Array.Empty<HospitalDentist>();
    var fac = (HospitalPriceCurrency)ViewBag.Facility;
    bool canConsult = ViewBag.CanConsult == true, canPay = ViewBag.CanPay == true;
    var today = DateTime.Now.Date;
    string St(string v) => v switch { HospitalOrthoStatus.Active => "primary", HospitalOrthoStatus.Retention => "info", HospitalOrthoStatus.Completed => "primary", _ => "secondary" };
    // H127: a stat tile of the theme (demo39 dashboards/logistics) — the figure over its label, an icon, a line under it
    void Stat(string label, string value, string? unit, object? sub, string icon, string tone, bool alert = false)
    {
        <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
            <div class="card-header pt-5 flex-nowrap gap-3">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-baseline flex-wrap"><span class="fs-2hx fw-bold @(alert ? "text-danger" : "text-gray-900") me-2 lh-1 ls-n2 hp-num">@value</span>@if (unit != null) {<span class="fs-6 fw-semibold text-gray-500 hp-num">@unit</span>}</div>
                    <span class="text-gray-500 pt-1 fw-semibold fs-6">@label</span>
                </div>
                <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-2x text-@tone"></i></span></div></div>
            </div>
            <div class="card-body d-flex align-items-end pt-0">
                <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500">@if (sub != null) {<span class="bullet w-8px h-6px rounded-2 bg-@tone me-3"></span>@sub} else {<span>&nbsp;</span>}</div>
            </div>
        </div></div>
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Orthodontics"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Dental")" class="text-muted text-hover-primary">@T["Dentistry"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Orthodontics"]</li>
            </ul>
        </div>
        <div class="d-flex gap-2">
            @await Html.PartialAsync("_UnitSettings", ViewBag.UnitSettings as HospitalUnitSettingsView)   @* H167: the service an instalment is billed as *@
            @if (canConsult) { <button type="button" class="btn btn-sm btn-primary" data-case-open><i class="ki-outline ki-plus fs-4"></i>@T["New ortho case"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H127: the clinic's figures — demo39 dashboards/logistics stat tiles *@
        <div class="row g-5 g-xl-8 mb-5">
            @{
                Stat(T["Active ortho cases"].Value, s.Active.ToString(), null, null, "element-11", "primary");
                Stat(T["Adjustments this week"].Value, s.AdjustmentsThisWeek.ToString(), null, null, "wrench", "info");
                Stat(T["Instalments due"].Value, fac.Format(s.InstalmentsDue), fac.Code, T["collected at the cashier"], "wallet", "primary");
                Stat(T["Missed adjustments"].Value, s.Missed.ToString(), null, null, "calendar-remove", s.Missed > 0 ? "danger" : "primary", s.Missed > 0);
            }
        </div>

        @* H127: the cases — demo39 widgets/tables *@
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Orthodontic cases"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["One ortho contract with instalments; each adjustment is logged on the case, not billed as a separate visit"]</span>
                </h3>
                <div class="card-toolbar"><div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Search"]" data-filter /></div></div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-emoji-happy fs-3x text-gray-300 mb-4 d-block"></i>
                        <div class="fs-6 fw-bold text-gray-700">@T["No orthodontic cases yet."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Case"]</th><th>@T["Start"]</th><th class="min-w-150px">@T["Progress"]</th><th>@T["Next visit"]</th><th>@T["Paid / total"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var c = r.Case; var age = HospitalPatientService.AgeOn(r.BirthDate, today);
                                <tr data-row="@c.CaseNo @r.PatientName @r.PatientNameEn @r.Mrn">
                                    <td class="ps-4"><a href="@Url.Action("DentalChart", new { patientId = c.PatientId })" class="d-flex align-items-center text-hover-primary">
                                        <div class="symbol symbol-40px symbol-circle flex-shrink-0 me-3">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(r.PatientName, r.PatientNameEn)</span><span class="text-muted fw-semibold d-block fs-7">@if (age != null) {<span class="hp-num">@age</span><text>&nbsp;@T["y"] · </text>}@(r.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])</span></div></a></td>
                                    <td><div class="d-flex align-items-center gap-2"><bdi class="text-gray-900 fw-bold fs-6 hp-num">@c.CaseNo</bdi>@if (c.Status != HospitalOrthoStatus.Active) {<span class="badge badge-light-@St(c.Status) fs-8 fw-bold">@T["ortho:" + c.Status]</span>}</div>
                                        <span class="text-muted fw-semibold d-block fs-7">@T["appl:" + c.Appliance]@if (c.Stages != null) {<text> · </text>@T["Stage"]<text> </text>@T["{0} of {1}", c.CurrentStage, c.Stages]}</span>
                                        @if (c.AngleClass != null) {<div class="d-flex flex-wrap gap-1 mt-1"><span class="badge badge-light-primary fs-8 fw-bold">@T["angle:" + c.AngleClass]</span>@if (c.Iotn != null) {<span class="badge badge-light-@(c.Iotn >= 4 ? "danger" : c.Iotn == 3 ? "info" : "secondary") fs-8 fw-bold" title="@T["iotn:" + HospitalOrthoClinicalRules.Need(c.Iotn)]" data-bs-toggle="tooltip">IOTN <span class="hp-num ms-1">@c.Iotn</span></span>}</div>}</td>
                                    <td class="text-nowrap"><span class="text-gray-800 fw-semibold hp-num">@c.StartDate.ToString("yyyy-MM-dd")</span><span class="text-muted fw-semibold d-block fs-7">@T["Visits"] <span class="hp-num">@r.Visits</span></span></td>
                                    <td><div class="d-flex align-items-center gap-2"><div class="progress h-6px flex-grow-1 bg-light-@(r.Progress >= 100 ? "primary" : "primary")"><div class="progress-bar @(r.Progress >= 100 ? "bg-primary" : "bg-primary")" role="progressbar" style="width:@Math.Clamp(r.Progress, 0, 100)%"></div></div><span class="text-gray-800 fw-bold fs-7 hp-num">@r.Progress%</span></div>
                                        <div class="text-muted fw-semibold fs-8 mt-1">@T["{0} of {1}", HospitalDentalCasesRules.MonthsElapsed(c.StartDate, today), c.PlannedMonths] @T["months"]</div></td>
                                    <td class="text-nowrap">@if (c.NextVisit != null) {<span class="badge badge-light-@(r.Missed ? "danger" : "primary") fs-7 fw-bold hp-num">@c.NextVisit.Value.ToString("yyyy-MM-dd")</span>@if (r.Missed) {<div class="text-danger fw-semibold fs-8 mt-1">@T["missed"]</div>}} else {<span class="text-muted">—</span>}
                                        @if (r.NextReview != null) {<div class="text-muted fw-semibold fs-8 mt-1">@T["Retention review"] <span class="hp-num">@r.NextReview.Value.ToString("yyyy-MM-dd")</span></div>}
                                        @if (r.Warnings is { Count: > 0 } ws) {<div class="d-flex flex-wrap gap-1 mt-1">@foreach (var w in ws) {<span class="badge badge-light-danger fs-8 fw-bold">@T["orw:" + w]</span>}</div>}</td>
                                    <td class="text-nowrap"><div class="text-gray-900 fw-bold fs-7">@T["{0} of {1}", fac.Format(r.Paid), fac.Format(c.ContractTotal)]</div>
                                        @if (c.MonthlyInstalment > 0) {<div class="text-muted fw-semibold fs-8">@T["monthly"] <span class="hp-num">@fac.Format(c.MonthlyInstalment)</span></div>}
                                        @if (r.Due > 0) {<div class="text-danger fw-semibold fs-8">@T["Due"] <span class="hp-num">@fac.Format(r.Due)</span></div>}</td>
                                    <td class="text-end pe-4 text-nowrap">
                                        @if (canConsult && HospitalOrthoStatus.Open(c.Status)) { <button type="button" class="btn btn-sm btn-light-primary" data-visit="@System.Text.Json.JsonSerializer.Serialize(new { id = c.ID, no = c.CaseNo, stages = c.Stages, stage = c.CurrentStage, status = c.Status })"><i class="ki-outline ki-plus fs-4"></i>@T["Adjustment"]</button> }
                                        @if (canPay && r.Paid < c.ContractTotal) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary ms-1" title="@T["Payment"]" data-bs-toggle="tooltip" data-pay="@c.ID" data-what="@c.CaseNo" data-due="@(r.Due > 0 ? r.Due : c.MonthlyInstalment)"><i class="ki-outline ki-wallet fs-3"></i></button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@if (canConsult)
{
    @* H127: the theme's form modals (demo39 utilities/modals/forms/new-target) *@
    <div class="modal fade" id="caseModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["New ortho case"]</h1><div class="text-muted fw-semibold fs-5">@T["One ortho contract with instalments; each adjustment is logged on the case, not billed as a separate visit"]</div></div>
            <div class="row g-6">
                <div class="col-12"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Patient"]</label>
                    <select class="form-select form-select-solid" data-oc="patient" data-person-select data-person-ajax="@Url.Action("SearchDentalPatients")" data-searching="@T["Searching…"]" data-no-results="@T["No patient matches"]" data-placeholder="@T["Patient"]"><option value=""></option></select></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Orthodontist"]</label>
                    <select class="form-select form-select-solid" data-oc="dentist" data-person-select data-allow-clear data-placeholder="@T["Orthodontist"]"><option value=""></option>@foreach (var d in dentists) { <option value="@d.Id" data-photo="@d.Photo" data-initials="@HospitalUi.Initials(d.NameEn)">@DisplayName.Of(d.Name, d.NameEn)</option> }</select></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Appliance"]</label><select class="form-select form-select-solid" data-oc="appliance">@foreach (var a in HospitalOrthoAppliance.All) { <option value="@a">@T["appl:" + a]</option> }</select></div>
                <div class="col-md-4"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Start"]</label><input type="date" class="form-control form-control-solid hp-num" data-oc="start" value="@today.ToString("yyyy-MM-dd")" /></div>
                <div class="col-md-4"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Planned months"]</label><input type="number" min="1" max="60" class="form-control form-control-solid hp-num" dir="ltr" data-oc="months" value="24" /></div>
                <div class="col-md-4 d-none" data-oc-stages><label class="d-block fs-6 fw-semibold mb-2 required">@T["Aligner stages"]</label><input type="number" min="1" max="99" class="form-control form-control-solid hp-num" dir="ltr" data-oc="stages" value="30" /></div>
                <div class="col-md-4"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Contract total"] <span class="text-muted fs-8">@fac.Code</span></label><input type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" data-oc="total" /></div>
                <div class="col-md-4"><label class="d-block fs-6 fw-semibold mb-2">@T["Monthly instalment"]</label><input type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" data-oc="instalment" value="0" /></div>
                <div class="col-md-4"><label class="d-block fs-6 fw-semibold mb-2">@T["Next visit"]</label><input type="date" class="form-control form-control-solid hp-num" data-oc="next" /></div>
                @* H185: the diagnosis the treatment rests on *@
                <div class="col-12" data-oc-dx><div class="separator separator-dashed my-2"></div><div class="fs-5 fw-bold text-gray-800 mb-1">@T["Diagnosis"]</div><div class="text-muted fs-7">@T["Millimetres; a negative crowding is spacing."]</div></div>
                <div class="col-md-6" data-oc-dx><label class="d-block fs-6 fw-semibold mb-2 required">@T["Angle class"]</label><select class="form-select form-select-solid" data-oc="angle" data-placeholder="@T["Choose"]"><option></option>@foreach (var a in HospitalOrthoAngle.All) { <option value="@a">@T["angle:" + a]</option> }</select></div>
                <div class="col-md-6" data-oc-dx><label class="d-block fs-6 fw-semibold mb-2 required">@T["IOTN grade"]</label><select class="form-select form-select-solid" data-oc="iotn" data-placeholder="@T["Choose"]"><option></option>@for (int g = 1; g <= 5; g++) { <option value="@g">@g — @T["iotn:" + HospitalOrthoClinicalRules.Need(g)]</option> }</select></div>
                <div class="col-6" data-oc-dx><label class="d-block fs-6 fw-semibold mb-2">@T["Overjet"]</label><input type="number" step="0.5" min="-10" max="20" class="form-control form-control-solid hp-num" dir="ltr" data-oc="overjet" /></div>
                <div class="col-6" data-oc-dx><label class="d-block fs-6 fw-semibold mb-2">@T["Overbite"]</label><input type="number" step="0.5" min="-10" max="15" class="form-control form-control-solid hp-num" dir="ltr" data-oc="overbite" /></div>
                <div class="col-6" data-oc-dx><label class="d-block fs-6 fw-semibold mb-2">@T["Crowding upper"]</label><input type="number" step="0.5" min="-15" max="20" class="form-control form-control-solid hp-num" dir="ltr" data-oc="crowdU" /></div>
                <div class="col-6" data-oc-dx><label class="d-block fs-6 fw-semibold mb-2">@T["Crowding lower"]</label><input type="number" step="0.5" min="-15" max="20" class="form-control form-control-solid hp-num" dir="ltr" data-oc="crowdL" /></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-oc-save>@T["Open the case"]</button></div>
        </div>
    </div></div></div>
    <div class="modal fade" id="visitModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Adjustment"]</h1><div class="text-muted fw-semibold fs-5"><bdi class="hp-num" data-v-no></bdi></div></div>
            <div class="row g-6">
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2 required">@T["Date"]</label><input type="date" class="form-control form-control-solid hp-num" data-v="date" value="@today.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" /></div>
                <div class="col-md-6" data-v-stage-wrap><label class="d-block fs-6 fw-semibold mb-2">@T["Aligner stage reached"] <span class="text-muted fs-8" data-v-of></span></label><input type="number" min="1" class="form-control form-control-solid hp-num" dir="ltr" data-v="stage" /></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Next visit"]</label><input type="date" class="form-control form-control-solid hp-num" data-v="next" /></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2">@T["The case"]</label><select class="form-select form-select-solid" data-v="status"><option value="">@T["Continues"]</option>@foreach (var st in new[] { HospitalOrthoStatus.Retention, HospitalOrthoStatus.Completed, HospitalOrthoStatus.Discontinued }) { <option value="@st">@T["ortho:" + st]</option> }</select></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Upper archwire"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="40" data-v="wireU" placeholder="0.014 NiTi" /></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Lower archwire"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="40" data-v="wireL" placeholder="0.016 NiTi" /></div>
                <div class="col-md-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Elastics"]</label><input class="form-control form-control-solid" maxlength="60" data-v="elastics" placeholder="@T["e.g. Class II, 3/16 in, both sides"]" /></div>
                <div class="col-md-3 col-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Oral hygiene"]</label><select class="form-select form-select-solid" data-v="hygiene" data-placeholder="—"><option></option>@foreach (var h in HospitalOrthoHygiene.All) { <option value="@h">@T["hyg:" + h]</option> }</select></div>
                <div class="col-md-3 col-6"><label class="d-block fs-6 fw-semibold mb-2">@T["Breakages"]</label><input type="number" min="0" max="20" class="form-control form-control-solid hp-num" dir="ltr" data-v="breakages" /></div>
                <div class="col-md-6 d-none" data-v-ret><label class="d-block fs-6 fw-semibold mb-2 required">@T["Upper retainer"]</label><select class="form-select form-select-solid" data-v="retU" data-placeholder="@T["Choose"]"><option></option>@foreach (var rt in HospitalOrthoRetainer.All) { <option value="@rt">@T["ret:" + rt]</option> }</select></div>
                <div class="col-md-6 d-none" data-v-ret><label class="d-block fs-6 fw-semibold mb-2 required">@T["Lower retainer"]</label><select class="form-select form-select-solid" data-v="retL" data-placeholder="@T["Choose"]"><option></option>@foreach (var rt in HospitalOrthoRetainer.All) { <option value="@rt">@T["ret:" + rt]</option> }</select></div>
                <div class="col-12"><label class="d-block fs-6 fw-semibold mb-2">@T["Note"]</label><input class="form-control form-control-solid" maxlength="300" data-v="note" placeholder="@T["e.g. wire changed to 0.018 NiTi"]" /></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-v-save>@T["Log the adjustment"]</button></div>
        </div>
    </div></div></div>
}

@* H167: an instalment is taken at the cashier — the amount, how it is paid, a reference; a receipt in the shift *@
<div class="modal fade" id="payModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0" data-pay-title></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-8 px-lg-10">
            <div class="mb-5"><label class="required fs-7 fw-semibold mb-2">@T["Amount"]</label><input type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" data-pay-f="amount" /></div>
            <div class="mb-5"><label class="required fs-7 fw-semibold mb-2">@T["Payment method"]</label>
                <select class="form-select form-select-solid" data-pay-f="method" data-control="select2" data-hide-search="true" data-dropdown-parent="#payModal">
                    @foreach (var m in HospitalPaymentMethods.All) { <option value="@m">@T["pm:" + m]</option> }
                </select></div>
            <div class="mb-5"><label class="fs-7 fw-semibold mb-2">@T["Reference"]</label><input class="form-control form-control-solid" maxlength="60" data-pay-f="reference" /></div>
            <div class="text-muted fs-8 mb-5">@T["The instalment goes on the patient's bill and is collected in your cashier shift: a receipt, posted to the ledger."]</div>
            <div class="text-end"><button type="button" class="btn btn-primary" data-pay-save><i class="ki-outline ki-wallet fs-4"></i>@T["Collect payment"]</button></div>
        </div>
    </div></div>
</div>

@section Scripts {
    <partial name="_PersonSelect" />
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Dental/Ortho"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                open: @Json.Serialize(T["Open this orthodontic contract?"].Value), visit: @Json.Serialize(T["Log this adjustment on {0}?"].Value), pay: @Json.Serialize(T["The amount paid on {0}"].Value), num: @Json.Serialize(T["Enter a number"].Value), of: @Json.Serialize(T["of"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            // a code inside an Arabic sentence keeps its own direction (first-strong isolate … pop)
            function iso(x) { return '⁨' + x + '⁩'; }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function done(btn, modal) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); if (modal) bootstrap.Modal.getOrCreateInstance(modal).hide(); swap(); }; }
            var cm = document.getElementById('caseModal'), vm = document.getElementById('visitModal'), visiting = null, pm = document.getElementById('payModal'), paying = null;   // H167
            // clear aligners are planned in stages; nothing else is
            if (cm) cm.querySelector('[data-oc=appliance]').addEventListener('change', function (e) { cm.querySelector('[data-oc-stages]').classList.toggle('d-none', e.target.value !== 'ClearAligners'); });
            // H185: a retention-only case needs no diagnosis; the retainers are asked only when the appliance comes off (select2: jQuery's change)
            function onSel(el, f) { if (!el) return; if (window.$) $(el).on('change', f); else el.addEventListener('change', f); }
            if (cm) onSel(cm.querySelector('[data-oc=appliance]'), function () { var ret = this.value === 'Retention'; cm.querySelectorAll('[data-oc-dx]').forEach(function (x) { x.classList.toggle('d-none', ret); }); cm.querySelector('[data-oc-stages]').classList.toggle('d-none', this.value !== 'ClearAligners'); });
            if (vm) onSel(vm.querySelector('[data-v=status]'), function () { var off = this.value === 'Retention' && visiting && visiting.status === 'Active'; vm.querySelectorAll('[data-v-ret]').forEach(function (x) { x.classList.toggle('d-none', !off); }); });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-case-open],[data-oc-save],[data-visit],[data-v-save],[data-pay],[data-pay-save]'); if (!t) return;
                if (t.hasAttribute('data-case-open')) { bootstrap.Modal.getOrCreateInstance(cm).show(); return; }
                if (t.hasAttribute('data-oc-save')) {
                    var g = function (k) { return cm.querySelector('[data-oc=' + k + ']').value.trim(); }, aligners = g('appliance') === 'ClearAligners';
                    var body = { patientId: +g('patient') || 0, practitionerId: g('dentist') ? +g('dentist') : null, appliance: g('appliance'), startDate: g('start'), plannedMonths: +g('months') || 0,
                        stages: aligners ? (+g('stages') || 0) : null, contractTotal: +g('total') || 0, monthlyInstalment: +g('instalment') || 0, nextVisit: g('next') || null,
                        angleClass: g('angle') || null, iotn: g('iotn') ? +g('iotn') : null, overjetMm: g('overjet') === '' ? null : +g('overjet'), overbiteMm: g('overbite') === '' ? null : +g('overbite'),
                        crowdingUpperMm: g('crowdU') === '' ? null : +g('crowdU'), crowdingLowerMm: g('crowdL') === '' ? null : +g('crowdL') };
                    cbConfirm(W.open).then(function (ok) { if (!ok) return; t.disabled = true; post(root, body).then(done(t, cm)); });
                    return;
                }
                if (t.hasAttribute('data-visit')) {
                    visiting = JSON.parse(t.getAttribute('data-visit'));
                    vm.querySelector('[data-v-no]').textContent = visiting.no;
                    vm.querySelector('[data-v-stage-wrap]').classList.toggle('d-none', !visiting.stages);
                    vm.querySelector('[data-v-of]').textContent = visiting.stages ? W.of + ' ' + visiting.stages : '';
                    vm.querySelector('[data-v=stage]').value = visiting.stages ? Math.min(visiting.stages, (visiting.stage || 0) + 1) : '';
                    vm.querySelector('[data-v=next]').value = ''; vm.querySelector('[data-v=note]').value = ''; vm.querySelector('[data-v=status]').value = '';
                    ['wireU', 'wireL', 'elastics', 'breakages', 'hygiene', 'retU', 'retL'].forEach(function (k) { vm.querySelector('[data-v=' + k + ']').value = ''; });
                    vm.querySelectorAll('[data-v-ret]').forEach(function (x) { x.classList.add('d-none'); });
                    if (window.$) ['hygiene', 'retU', 'retL'].forEach(function (k) { $(vm.querySelector('[data-v=' + k + ']')).trigger('change.select2'); });
                    // the dates are the theme's pickers and the case's state a select2: their shown values follow the reset
                    var nx = vm.querySelector('[data-v=next]'); if (nx._flatpickr) nx._flatpickr.clear();
                    if (window.$) $(vm.querySelector('[data-v=status]')).trigger('change.select2');
                    bootstrap.Modal.getOrCreateInstance(vm).show(); return;
                }
                if (t.hasAttribute('data-v-save')) {
                    var v = function (k) { return vm.querySelector('[data-v=' + k + ']').value.trim(); };
                    var b = { visitDate: v('date') || null, alignerStage: visiting.stages && v('stage') ? +v('stage') : null, nextVisit: v('next') || null, note: v('note') || null, status: v('status') || null,
                        archwireUpper: v('wireU') || null, archwireLower: v('wireL') || null, elastics: v('elastics') || null, hygiene: v('hygiene') || null, breakages: v('breakages') === '' ? null : +v('breakages'),
                        retainerUpper: v('retU') || null, retainerLower: v('retL') || null };
                    cbConfirm(W.visit.replace('{0}', iso(visiting.no))).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/' + visiting.id + '/Visit', b).then(done(t, vm)); });
                    return;
                }
                if (t.hasAttribute('data-pay-save')) {   // H167
                    var pf = function (k) { return pm.querySelector('[data-pay-f=' + k + ']').value.trim(); }, amt = +pf('amount').replace(',', '.') || 0;
                    if (amt <= 0) { toast('warning', W.num); return; }
                    t.disabled = true; post(root + '/' + paying + '/Payment', { amount: amt, method: pf('method'), reference: pf('reference') || null }).then(done(t, pm));
                    return;
                }
                paying = t.getAttribute('data-pay');
                pm.querySelector('[data-pay-title]').textContent = W.pay.replace('{0}', iso(t.getAttribute('data-what')));
                pm.querySelector('[data-pay-f=amount]').value = (+t.getAttribute('data-due')).toFixed(3); pm.querySelector('[data-pay-f=reference]').value = '';
                bootstrap.Modal.getOrCreateInstance(pm).show();
            });
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-filter]')) return; var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row]').forEach(function (r) { r.classList.toggle('d-none', q && r.getAttribute('data-row').toLowerCase().indexOf(q) === -1); });
            });
        })();
    </script>
}
