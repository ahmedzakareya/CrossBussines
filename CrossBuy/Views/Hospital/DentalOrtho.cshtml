@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalOrthoRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Orthodontics"].Value;
    var s = (HospitalOrthoStats)ViewBag.Stats;
    var dentists = (ViewBag.Dentists as IReadOnlyList<HospitalDentist>) ?? Array.Empty<HospitalDentist>();
    var fac = (HospitalPriceCurrency)ViewBag.Facility;
    bool canConsult = ViewBag.CanConsult == true, canPay = ViewBag.CanPay == true;
    var today = DateTime.Now.Date;
    string St(string v) => v switch { HospitalOrthoStatus.Active => "primary", HospitalOrthoStatus.Retention => "info", HospitalOrthoStatus.Completed => "success", _ => "secondary" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Orthodontics"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Dental")" class="text-muted text-hover-primary">@T["Dentistry"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Orthodontics"]</li>
            </ul>
        </div>
        @if (canConsult) { <button type="button" class="btn btn-sm btn-primary" data-case-open><i class="ki-outline ki-plus fs-4"></i>@T["New ortho case"]</button> }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Active ortho cases"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@s.Active</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Adjustments this week"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@s.AdjustmentsThisWeek</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Instalments due"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@fac.Format(s.InstalmentsDue) <span class="fs-7 text-muted">@fac.Code</span></div>
                <div class="text-muted fs-8 mt-1">@T["collected at the cashier"]</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Missed adjustments"]</div><div class="fs-2hx fw-bold hp-num @(s.Missed > 0 ? "text-danger" : "text-gray-900")">@s.Missed</div></div></div></div>
        </div>

        <div class="card mb-5">
            <div class="card-header border-0 pt-6">
                <div class="card-title align-items-start flex-column m-0">
                    <span class="card-label fw-bold text-gray-900 fs-4">@T["Orthodontic cases"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@T["One ortho contract with instalments; each adjustment is logged on the case, not billed as a separate visit"]</span>
                </div>
                <div class="card-toolbar"><div class="position-relative"><i class="ki-outline ki-magnifier fs-4 position-absolute top-50 translate-middle-y ms-3"></i><input class="form-control form-control-sm form-control-solid w-250px ps-10" placeholder="@T["Search"]" data-filter /></div></div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0) { <div class="text-center text-muted py-10">@T["No orthodontic cases yet."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th class="w-100px">@T["Case"]</th><th>@T["Patient"]</th><th>@T["Appliance"]</th><th>@T["Start"]</th><th class="w-175px">@T["Progress"]</th><th>@T["Visits"]</th><th>@T["Next visit"]</th><th>@T["Paid / total"]</th><th class="text-end"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in Model)
                            {
                                var c = r.Case; var age = HospitalPatientService.AgeOn(r.BirthDate, today);
                                <tr data-row="@c.CaseNo @r.PatientName @r.PatientNameEn @r.Mrn">
                                    <td><span class="badge hp-code fw-bold fs-8 hp-num">@c.CaseNo</span>@if (c.Status != HospitalOrthoStatus.Active) {<div class="mt-1"><span class="badge badge-light-@St(c.Status) fs-9">@T["ortho:" + c.Status]</span></div>}</td>
                                    <td><a href="@Url.Action("DentalChart", new { patientId = c.PatientId })" class="d-flex align-items-center gap-3 text-hover-primary">
                                        <div class="symbol symbol-35px symbol-circle flex-shrink-0">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                        <div><div class="fw-bold text-gray-900">@DisplayName.Of(r.PatientName, r.PatientNameEn)</div><div class="text-muted fs-8">@if (age != null) {<span class="hp-num">@age</span> @T["y"]<text> · </text>}@(r.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])</div></div></a></td>
                                    <td><div class="fw-semibold text-gray-800">@T["appl:" + c.Appliance]</div>@if (c.Stages != null) {<div class="text-muted fs-8">@T["Stage"] <span class="hp-num">@c.CurrentStage / @c.Stages</span></div>}</td>
                                    <td class="text-nowrap"><span class="hp-num">@c.StartDate.ToString("yyyy-MM-dd")</span></td>
                                    <td><div class="d-flex align-items-center gap-2"><div class="progress h-6px flex-grow-1" style="min-width:90px"><div class="progress-bar @(r.Progress >= 100 ? "bg-success" : "bg-primary")" style="width:@r.Progress%"></div></div><span class="hp-num fs-8 fw-bold">@r.Progress%</span></div>
                                        <div class="text-muted fs-9 mt-1"><span class="hp-num">@HospitalDentalCasesRules.MonthsElapsed(c.StartDate, today) / @c.PlannedMonths</span> @T["months"]</div></td>
                                    <td><span class="hp-num">@r.Visits</span></td>
                                    <td class="text-nowrap">@if (c.NextVisit != null) {<span class="hp-num @(r.Missed ? "text-danger fw-bold" : "")">@c.NextVisit.Value.ToString("yyyy-MM-dd")</span>@if (r.Missed) {<div class="text-danger fs-9">@T["missed"]</div>}} else {<span class="text-muted">—</span>}</td>
                                    <td class="text-nowrap"><div class="hp-num fw-bold">@fac.Format(r.Paid) / @fac.Format(c.ContractTotal)</div>
                                        @if (c.MonthlyInstalment > 0) {<div class="text-muted fs-8">@T["monthly"] <span class="hp-num">@fac.Format(c.MonthlyInstalment)</span></div>}
                                        @if (r.Due > 0) {<div class="text-danger fs-8">@T["Due"] <span class="hp-num">@fac.Format(r.Due)</span></div>}</td>
                                    <td class="text-end text-nowrap">
                                        @if (canConsult && HospitalOrthoStatus.Open(c.Status)) { <button type="button" class="btn btn-sm btn-light-primary py-1 px-3" data-visit="@System.Text.Json.JsonSerializer.Serialize(new { id = c.ID, no = c.CaseNo, stages = c.Stages, stage = c.CurrentStage })"><i class="ki-outline ki-plus fs-6"></i>@T["Adjustment"]</button> }
                                        @if (canPay && r.Paid < c.ContractTotal) { <button type="button" class="btn btn-sm btn-light py-1 px-3" data-pay="@c.ID" data-what="@c.CaseNo" data-due="@(r.Due > 0 ? r.Due : c.MonthlyInstalment)">@T["Payment"]</button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@if (canConsult)
{
    <div class="modal fade" id="caseModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0 fs-4">@T["New ortho case"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-12"><label class="form-label required">@T["Patient"]</label>
                <select class="form-select form-select-solid" data-oc="patient" data-person-select data-person-ajax="@Url.Action("SearchDentalPatients")" data-searching="@T["Searching…"]" data-no-results="@T["No patient matches"]" data-placeholder="@T["Patient"]"><option value=""></option></select></div>
            <div class="col-md-6"><label class="form-label">@T["Orthodontist"]</label>
                <select class="form-select form-select-solid" data-oc="dentist" data-person-select data-allow-clear data-placeholder="@T["Orthodontist"]"><option value=""></option>@foreach (var d in dentists) { <option value="@d.Id" data-photo="@d.Photo" data-initials="@HospitalUi.Initials(d.NameEn)">@DisplayName.Of(d.Name, d.NameEn)</option> }</select></div>
            <div class="col-md-6"><label class="form-label required">@T["Appliance"]</label><select class="form-select form-select-solid" data-oc="appliance">@foreach (var a in HospitalOrthoAppliance.All) { <option value="@a">@T["appl:" + a]</option> }</select></div>
            <div class="col-md-4"><label class="form-label required">@T["Start"]</label><input type="date" class="form-control form-control-solid hp-num" data-oc="start" value="@today.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-4"><label class="form-label required">@T["Planned months"]</label><input type="number" min="1" max="60" class="form-control form-control-solid hp-num" dir="ltr" data-oc="months" value="24" /></div>
            <div class="col-md-4 d-none" data-oc-stages><label class="form-label required">@T["Aligner stages"]</label><input type="number" min="1" max="99" class="form-control form-control-solid hp-num" dir="ltr" data-oc="stages" value="30" /></div>
            <div class="col-md-4"><label class="form-label required">@T["Contract total"] <span class="text-muted fs-8">@fac.Code</span></label><input type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" data-oc="total" /></div>
            <div class="col-md-4"><label class="form-label">@T["Monthly instalment"]</label><input type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" data-oc="instalment" value="0" /></div>
            <div class="col-md-4"><label class="form-label">@T["Next visit"]</label><input type="date" class="form-control form-control-solid hp-num" data-oc="next" /></div>
        </div></div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-oc-save>@T["Open the case"]</button></div>
    </div></div></div>
    <div class="modal fade" id="visitModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0 fs-4">@T["Adjustment"] <span class="text-muted fs-6 hp-num" data-v-no></span></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            <div class="col-md-6"><label class="form-label required">@T["Date"]</label><input type="date" class="form-control form-control-solid hp-num" data-v="date" value="@today.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-6" data-v-stage-wrap><label class="form-label">@T["Aligner stage reached"] <span class="text-muted fs-8" data-v-of></span></label><input type="number" min="1" class="form-control form-control-solid hp-num" dir="ltr" data-v="stage" /></div>
            <div class="col-md-6"><label class="form-label">@T["Next visit"]</label><input type="date" class="form-control form-control-solid hp-num" data-v="next" /></div>
            <div class="col-md-6"><label class="form-label">@T["The case"]</label><select class="form-select form-select-solid" data-v="status"><option value="">@T["Continues"]</option>@foreach (var st in new[] { HospitalOrthoStatus.Retention, HospitalOrthoStatus.Completed, HospitalOrthoStatus.Discontinued }) { <option value="@st">@T["ortho:" + st]</option> }</select></div>
            <div class="col-12"><label class="form-label">@T["Note"]</label><input class="form-control form-control-solid" maxlength="300" data-v="note" placeholder="@T["e.g. wire changed to 0.018 NiTi"]" /></div>
        </div></div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-v-save>@T["Log the adjustment"]</button></div>
    </div></div></div>
}

@section Scripts {
    <partial name="_PersonSelect" />
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Dental/Ortho"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                open: @Json.Serialize(T["Open this orthodontic contract?"].Value), visit: @Json.Serialize(T["Log this adjustment on {0}?"].Value), pay: @Json.Serialize(T["The amount paid on {0}"].Value), num: @Json.Serialize(T["Enter a number"].Value), of: @Json.Serialize(T["of"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            // a code inside an Arabic sentence keeps its own direction (first-strong isolate … pop)
            function iso(x) { return '⁨' + x + '⁩'; }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function done(btn, modal) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); if (modal) bootstrap.Modal.getOrCreateInstance(modal).hide(); swap(); }; }
            var cm = document.getElementById('caseModal'), vm = document.getElementById('visitModal'), visiting = null;
            // clear aligners are planned in stages; nothing else is
            if (cm) cm.querySelector('[data-oc=appliance]').addEventListener('change', function (e) { cm.querySelector('[data-oc-stages]').classList.toggle('d-none', e.target.value !== 'ClearAligners'); });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-case-open],[data-oc-save],[data-visit],[data-v-save],[data-pay]'); if (!t) return;
                if (t.hasAttribute('data-case-open')) { bootstrap.Modal.getOrCreateInstance(cm).show(); return; }
                if (t.hasAttribute('data-oc-save')) {
                    var g = function (k) { return cm.querySelector('[data-oc=' + k + ']').value.trim(); }, aligners = g('appliance') === 'ClearAligners';
                    var body = { patientId: +g('patient') || 0, practitionerId: g('dentist') ? +g('dentist') : null, appliance: g('appliance'), startDate: g('start'), plannedMonths: +g('months') || 0,
                        stages: aligners ? (+g('stages') || 0) : null, contractTotal: +g('total') || 0, monthlyInstalment: +g('instalment') || 0, nextVisit: g('next') || null };
                    cbConfirm(W.open).then(function (ok) { if (!ok) return; t.disabled = true; post(root, body).then(done(t, cm)); });
                    return;
                }
                if (t.hasAttribute('data-visit')) {
                    visiting = JSON.parse(t.getAttribute('data-visit'));
                    vm.querySelector('[data-v-no]').textContent = visiting.no;
                    vm.querySelector('[data-v-stage-wrap]').classList.toggle('d-none', !visiting.stages);
                    vm.querySelector('[data-v-of]').textContent = visiting.stages ? W.of + ' ' + visiting.stages : '';
                    vm.querySelector('[data-v=stage]').value = visiting.stages ? Math.min(visiting.stages, (visiting.stage || 0) + 1) : '';
                    vm.querySelector('[data-v=next]').value = ''; vm.querySelector('[data-v=note]').value = ''; vm.querySelector('[data-v=status]').value = '';
                    bootstrap.Modal.getOrCreateInstance(vm).show(); return;
                }
                if (t.hasAttribute('data-v-save')) {
                    var v = function (k) { return vm.querySelector('[data-v=' + k + ']').value.trim(); };
                    var b = { visitDate: v('date') || null, alignerStage: visiting.stages && v('stage') ? +v('stage') : null, nextVisit: v('next') || null, note: v('note') || null, status: v('status') || null };
                    cbConfirm(W.visit.replace('{0}', iso(visiting.no))).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/' + visiting.id + '/Visit', b).then(done(t, vm)); });
                    return;
                }
                cbPrompt(W.pay.replace('{0}', iso(t.getAttribute('data-what'))), { value: (+t.getAttribute('data-due')).toFixed(3), number: true, numberText: W.num }).then(function (amt) {
                    if (!amt) return; t.disabled = true; post(root + '/' + t.getAttribute('data-pay') + '/Payment', { amount: +amt.replace(',', '.') || 0 }).then(done(t));
                });
            });
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-filter]')) return; var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row]').forEach(function (r) { r.classList.toggle('d-none', q && r.getAttribute('data-row').toLowerCase().indexOf(q) === -1); });
            });
        })();
    </script>
}
