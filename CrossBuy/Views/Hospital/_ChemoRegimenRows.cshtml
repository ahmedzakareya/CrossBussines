@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalChemoRegimenRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ bool canLib = ViewBag.CanLibrary == true; }
@foreach (var row in Model)
{
    var r = row.Regimen;
    var json = System.Text.Json.JsonSerializer.Serialize(new { id = r.ID, code = r.Code, name = r.Name, nameEn = r.NameEn, cycleDays = r.CycleDays, maxCycles = r.MaxCycles, note = r.Note, isActive = r.IsActive,
        drugs = row.Drugs.Select(d => new { drugName = d.DrugName, dose = d.Dose, basis = d.Basis, route = d.Route, days = d.Days, lifetimeMgM2 = d.LifetimeMgM2 }) });
    <tr class="@(r.IsActive ? "" : "opacity-50")">
        <td><span class="badge hp-code fs-8 hp-num">@r.Code</span> <span class="fw-bold text-gray-900">@DisplayName.Of(r.Name, r.NameEn ?? r.Name)</span>
            @if (!r.IsActive) {<div class="text-muted fs-9">@T["Out of the library"]</div>}@if (r.Note != null) {<div class="text-muted fs-8"><bdi>@r.Note</bdi></div>}</td>
        <td class="text-nowrap fs-8">@T["Every {0} days", r.CycleDays]<div class="text-muted">@T["{0} cycles", r.MaxCycles]</div></td>
        <td class="fs-8">@foreach (var d in row.Drugs)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center py-1"><bdi class="fw-semibold" dir="ltr">@d.DrugName</bdi>
                    <span class="hp-num" dir="ltr">@d.Dose.ToString("0.##") @T["cbs:" + d.Basis]</span><span class="badge badge-light fs-9">@d.Route</span>
                    <span class="text-muted">@T["Day {0}", d.Days]</span>
                    @if (d.LifetimeMgM2 != null) {<span class="badge badge-light-danger fs-9">@T["Lifetime {0} mg/m²", d.LifetimeMgM2.Value.ToString("0")]</span>}</div>
            }</td>
        <td class="hp-num">@(row.ActiveCourses > 0 ? row.ActiveCourses.ToString() : "—")</td>
        <td class="text-end">@if (canLib) {<button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-reg-edit="@json">@T["Edit"]</button>}</td>
    </tr>
}
