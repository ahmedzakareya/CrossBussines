@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPortalRefillRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Refill requests"].Value;
    bool canConsult = ViewBag.CanConsult == true;
    int open = Model.Count(r => r.Refill.Status == HospitalPortalRefillStatus.Open);
    string Badge(string s) => s switch { HospitalPortalRefillStatus.Approved => "primary", HospitalPortalRefillStatus.Declined => "danger", _ => "primary" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Refill requests"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Worklist")" class="text-muted text-hover-primary">@T["Doctor worklist"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Refill requests"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="fw-semibold pe-5"><h4 class="text-gray-900 fw-bold mb-1">@T["Patients asking for a medicine again"]</h4>
                    <div class="fs-6 text-gray-700">@T["From the patient portal. Approve with where and when to collect it, or decline with the reason the patient will read; approving does not dispense."]</div></div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0"><span class="hp-num">@open</span>&nbsp;@T["prq:Open"]</span>
            </div>
        </div>

        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Refill requests"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7"><bdi class="hp-num" dir="ltr">@Model.Count</bdi></span></h3>
                <div class="card-toolbar"><div class="symbol symbol-40px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-capsule fs-2 text-primary"></i></span></div></div>
            </div>
            <div class="card-body pt-2">
            @if (Model.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-capsule fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No requests here."]</div></div> }
            else
            {
                @* H128: table widget (demo39 widgets/tables) *@
                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                    <thead><tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Medicine"]</th><th>@T["Prescribed by"]</th><th>@T["Asked"]</th><th>@T["Status"]</th><th class="pe-4 rounded-end"></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var x in Model)
                        {
                            var r = x.Refill;
                            <tr>
                                <td class="ps-4"><div class="d-flex align-items-center">
                                    <div class="symbol symbol-45px symbol-circle me-3 flex-shrink-0">@if (x.PatientPhoto != null) {<img src="@x.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(x.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(x.PatientNameEn)</span>}</div>
                                    <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = x.PatientId })" class="text-gray-900 text-hover-primary fw-bold fs-6"><bdi>@DisplayName.Of(x.PatientName, x.PatientNameEn)</bdi></a><bdi class="text-muted fw-semibold fs-7 hp-num">@x.Mrn</bdi></div>
                                </div></td>
                                <td><div class="text-gray-900 fw-bold fs-6"><bdi>@x.Drug</bdi></div><div class="text-muted fw-semibold fs-7">@x.Instructions · <span class="hp-num">@x.Quantity</span></div>
                                    @if (!string.IsNullOrEmpty(r.Note)) {<div class="text-gray-600 fs-7 mt-1"><i class="ki-outline ki-message-text fs-7 me-1"></i>@r.Note</div>}</td>
                                <td>@if (x.Doctor is { } d)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="symbol symbol-35px symbol-circle me-3 flex-shrink-0">@if (d.Photo != null) {<img src="@d.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(d.NameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(d.NameEn)</span>}</div>
                                            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(d.Name, d.NameEn)</bdi></span><span class="text-muted fw-semibold fs-7 hp-num" data-fmt data-utc="@x.PrescribedAt.ToString("o")">@x.PrescribedAt.ToLocalTime().ToString("yyyy-MM-dd")</span></div>
                                        </div>
                                    }</td>
                                <td class="hp-num text-gray-800 fw-bold fs-7" data-fmt data-utc="@r.CreatedAt.ToString("o")">@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge badge-light-@Badge(r.Status) fs-7 fw-bold">@T["rfl:" + r.Status]</span>
                                    @if (r.Answer != null || r.AnswerEn != null) {<div class="text-muted fs-7 mt-1" dir="auto">@DisplayName.Of(r.Answer ?? "", r.AnswerEn ?? "")</div>}</td>
                                <td class="text-end text-nowrap pe-4">
                                    @if (canConsult && r.Status == HospitalPortalRefillStatus.Open)
                                    {
                                        <button type="button" class="btn btn-sm btn-icon btn-light-primary me-1" title="@T["Approve"]" data-bs-toggle="tooltip" data-refill-decide="@r.ID" data-approve="1"><i class="ki-outline ki-check fs-3"></i></button>
                                        <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["Decline"]" data-bs-toggle="tooltip" data-refill-decide="@r.ID" data-approve="0"><i class="ki-outline ki-cross fs-3"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <partial name="_HospitalPrompt" />
    @if (canConsult)
    {
        <script>
            (function () {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/PortalRefills"));
                var W = { approve: @Json.Serialize(T["Approve this refill: where and when does the patient collect it?"].Value), decline: @Json.Serialize(T["Decline this refill: the reason the patient will read"].Value),
                    failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
                function swap() {
                    return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                        var d = new DOMParser().parseFromString(html, 'text/html');
                        ['kt_app_toolbar', 'kt_app_content'].forEach(function (id) { var f = d.getElementById(id); if (f) document.getElementById(id).innerHTML = f.innerHTML; });
                    });
                }
                document.addEventListener('click', function (e) {
                    var t = e.target.closest('[data-refill-decide]'); if (!t) return;
                    var approve = t.getAttribute('data-approve') === '1';
                    // H33: the patient reads the answer in their language — both are written
                    cbPromptBoth(approve ? W.approve : W.decline, { kind: approve ? null : 'danger' }).then(function (answer) {
                        if (answer === null || answer === undefined) return;
                        t.disabled = true;
                        fetch(root + '/' + t.getAttribute('data-refill-decide') + '/Decide', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ approve: approve, answer: answer.ar || null, answerEn: answer.en || null }) })
                            .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                            .then(function (res) { t.disabled = false; if (!res.ok) { if (window.toastr) toastr.error(res.error || W.failed); return; } if (window.toastr) toastr.success(W.saved); swap(); });
                    });
                });
            })();
        </script>
    }
}
