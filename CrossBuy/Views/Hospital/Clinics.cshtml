@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalClinicCard>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Outpatient clinics board"].Value;
    bool canBook = ViewBag.CanBook == true;
    DateTime today = ViewBag.Today;
    int running = Model.Count(c => c.Current != null);
    int waiting = Model.Sum(c => c.Waiting.Count);
    var late = Model.Count(c => c.DelayMinutes > 15);
    var serving = Model.Where(c => c.Current?.QueueNumber != null).Select(c => c.Current!.QueueNumber!.Value).DefaultIfEmpty(0).Max();
    var visits = Model.SelectMany(c => new[] { c.Current }.Where(x => x != null)).ToList();
    string Q(int? n) => n == null ? "—" : "A-" + n.Value.ToString("000");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Outpatient clinics board"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Clinics"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Board"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("Appointments")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-calendar fs-4"></i>@T["Appointments"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid" id="boardRoot">
        @* H127: the theme's stat tiles (demo39 dashboards/logistics) — the number over its label, an icon in a tinted symbol, a muted line *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Clinics running"].Value, string.Format(T["{0} of {1}"].Value, running, Model.Count), T["a patient is with the doctor"].Value, "ki-briefcase", "primary", "gray-900"),
                (T["Waiting"].Value, waiting.ToString(), T["arrived, not yet called"].Value, "ki-people", "info", "gray-900"),
                (T["Seen today"].Value, Model.Sum(c => c.Seen).ToString(), T["visits finished"].Value, "ki-check-circle", "success", "success"),
                (T["Clinics running late"].Value, late.ToString(), T["over 15 minutes"].Value, "ki-time", late > 0 ? "danger" : "success", late > 0 ? "danger" : "gray-900") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold text-@s.Item6 lh-1 hp-num">@s.Item2</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item5"><i class="ki-outline @s.Item4 fs-2 text-@s.Item5"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0"><div class="d-flex align-items-center"><span class="bullet bullet-dot bg-@s.Item5 h-6px w-6px me-2"></span><span class="text-gray-500 fw-semibold fs-7">@s.Item3</span></div></div>
                </div></div>
            }
        </div>

        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-screen fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-4">
                <div class="fw-semibold">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Calling the next patient"]</h4>
                    <div class="fs-6 text-gray-700">@T["Each clinic calls the next arrived patient by queue number; the number is given at check-in."]</div>
                </div>
                <div class="d-flex flex-column align-items-center flex-shrink-0 px-4"><span class="fs-2hx fw-bold text-primary lh-1 hp-num" dir="ltr">@(serving == 0 ? "—" : Q(serving))</span><span class="text-gray-500 fw-semibold fs-7 pt-1">@T["Now serving"]</span></div>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="card card-flush"><div class="card-body"><div class="text-center py-10"><i class="ki-outline ki-briefcase fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No clinic runs today."]</div></div></div></div>
        }
        <div class="row g-5 g-xl-8">
            @foreach (var c in Model)
            {
                var d = c.Practitioner;
                @* one clinic: the theme's card header (demo39 apps/user-management/users/view) — the room over its doctor, the patient inside, three counters *@
                <div class="col-md-6 col-xl-4"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Clinic"] <bdi class="hp-num">@(d.ClinicRoomNumber ?? "—")</bdi></span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@(d.Department == null ? "" : DisplayName.Of(d.Department.Name, d.Department.NameEn))</span></h3>
                        <div class="card-toolbar">
                            @if (c.Current != null) { <span class="badge badge-light-success fs-7 fw-bold">@T["In session"]</span> }
                            else if (c.Seen == 0 && c.Waiting.Count == 0) { <span class="badge badge-light fs-7 fw-bold">@T["Not started"]</span> }
                            else { <span class="badge badge-light-info fs-7 fw-bold">@T["Available"]</span> }
                        </div>
                    </div>
                    <div class="card-body pt-2 d-flex flex-column">
                    <div class="d-flex align-items-center mb-5">
                        <div class="symbol symbol-50px symbol-circle flex-shrink-0">@if (d.PhotoPath != null) {<img src="@d.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(d.Row.NameEn)" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(d.Row.NameEn)</span>}</div>
                        <div class="d-flex flex-column ms-3 min-w-0"><a href="@Url.Action("Practitioner", new { id = d.Row.ID })" class="text-gray-900 text-hover-primary fs-6 fw-bold text-truncate">@DisplayName.Of(d.Row.Name, d.Row.NameEn)</a>
                            <span><span class="badge badge-light-primary fs-8 fw-bold">@T["eng:" + d.Row.Engagement]</span></span></div>
                    </div>
                    <div class="rounded bg-light-primary p-4 mb-5">
                        <div class="text-gray-600 fs-7 fw-semibold mb-2">@T["With the doctor now"]</div>
                        @if (c.Current is HospitalAppointmentView cur)
                        {
                            <div class="d-flex align-items-center">
                                <div class="symbol symbol-35px symbol-circle flex-shrink-0">@if (cur.PatientPhoto != null) {<img src="@cur.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(cur.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(cur.PatientNameEn)</span>}</div>
                                <div class="d-flex flex-column ms-3 min-w-0 flex-grow-1"><a href="@Url.Action("Patient", new { id = cur.PatientId })" class="text-gray-900 text-hover-primary fw-bold fs-6 text-truncate">@DisplayName.Of(cur.PatientName, cur.PatientNameEn)</a>
                                    <span class="text-gray-500 fw-semibold fs-7"><span class="hp-num" dir="ltr">@Q(cur.QueueNumber)</span> · <span class="hp-num" dir="ltr">@HospitalUi.Clock(cur.StartMinute)</span></span></div>
                                @if (canBook) { <button type="button" class="btn btn-sm btn-success flex-shrink-0" data-finish="@cur.Id"><i class="ki-outline ki-check fs-5"></i>@T["Finish"]</button> }
                            </div>
                        }
                        else { <span class="text-gray-400 fw-bold">—</span> }
                    </div>
                    <div class="d-flex gap-3 mb-5">
                        <div class="border border-gray-300 border-dashed rounded flex-grow-1 py-3 px-3 text-center"><div class="fs-2 fw-bold text-gray-800 hp-num">@c.Waiting.Count</div><div class="fw-semibold fs-7 text-gray-500">@T["Waiting"]</div></div>
                        <div class="border border-gray-300 border-dashed rounded flex-grow-1 py-3 px-3 text-center"><div class="fs-2 fw-bold text-success hp-num">@c.Seen</div><div class="fw-semibold fs-7 text-gray-500">@T["Seen"]</div></div>
                        <div class="border border-gray-300 border-dashed rounded flex-grow-1 py-3 px-3 text-center"><div class="fs-2 fw-bold hp-num @(c.DelayMinutes > 15 ? "text-danger" : "text-gray-800")">@c.DelayMinutes</div><div class="fw-semibold fs-7 text-gray-500">@T["Delay (min)"]</div></div>
                    </div>
                    <div class="separator separator-dashed mb-4 mt-auto"></div>
                    <div class="d-flex flex-stack gap-2">
                        <div class="d-flex align-items-center min-w-0"><div class="symbol symbol-30px me-3 flex-shrink-0"><span class="symbol-label bg-light-info"><i class="ki-outline ki-arrow-circle-right fs-4 text-info"></i></span></div><span class="text-gray-500 fw-semibold fs-7">@T["Next"]</span></div>
                        <span class="fw-bold text-gray-800 fs-7 text-truncate">@if (c.Next is HospitalAppointmentView n) {@DisplayName.Of(n.PatientName, n.PatientNameEn)<text> · </text><span class="hp-num" dir="ltr">@(n.QueueNumber != null ? Q(n.QueueNumber) : HospitalUi.Clock(n.StartMinute))</span>} else {<text>—</text>}</span>
                    </div>
                    @if (canBook && c.Current == null && c.Waiting.Count > 0)
                    {
                        <button type="button" class="btn btn-sm btn-primary w-100 mt-4" data-call="@d.Row.ID"><i class="ki-outline ki-notification-on fs-4"></i>@T["Call next"]</button>
                    }
                    </div>
                </div></div>
            }
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var urls = { call: @Json.Serialize(Url.Action("CallNext", new { practitionerId = 0 })), move: @Json.Serialize(Url.Action("MoveAppointment", new { id = 0 })) };
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            function post(url, body) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            // In place, never a reload: the server renders the board again and it is swapped.
            function refresh() {
                fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('boardRoot');
                    if (fresh) document.getElementById('boardRoot').innerHTML = fresh.innerHTML;
                });
            }
            document.addEventListener('click', function (e) {
                var b = e.target.closest('[data-call],[data-finish]'); if (!b) return;
                b.disabled = true;
                var call = b.hasAttribute('data-call')
                    ? post(urls.call.replace(/0\/CallNext$/, b.getAttribute('data-call') + '/CallNext'))
                    : post(urls.move.replace(/0\/Move$/, b.getAttribute('data-finish') + '/Move'), { to: 'Done' });
                call.then(function (res) {
                    if (!res.ok) { b.disabled = false; if (window.toastr) toastr.error(res.error || W.failed); return; }
                    if (window.toastr) toastr.success(W.saved); refresh();
                });
            });
            setInterval(refresh, 60000);   // the board is watched, not clicked: it follows the desk every minute
        })();
    </script>
}
