@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalBreakGlassRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ int? me = ViewBag.Me as int?; var inv = System.Globalization.CultureInfo.InvariantCulture; string At(DateTime u) => HospitalNursingService.UtcToWard(u).ToString("yyyy-MM-dd HH:mm", inv); }
@foreach (var r in Model)
{
    var g = r.Entry;
    <tr data-glass-row="@g.ID">
        @* H128: a table-widget row (demo39 widgets/tables) — the employee shown by their photo, initials only when none *@
        <td class="ps-4"><span class="text-gray-900 fw-bold fs-6 hp-num d-block text-nowrap" dir="ltr">@At(g.OpenedAt)</span><span class="text-muted fw-semibold fs-7 hp-num d-block text-nowrap" dir="ltr">→ @At(g.ExpiresAt)</span></td>
        <td><div class="d-flex align-items-center">
            <div class="symbol symbol-45px symbol-circle me-4 flex-shrink-0">@if (r.EmployeePhoto != null) {<img src="@r.EmployeePhoto" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold bg-light-primary text-primary">@HospitalUi.Initials(r.EmployeeEn)</span>}</div>
            <span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(r.Employee, r.EmployeeEn)</span></div></td>
        <td><a href="@Url.Action("Patient", new { id = g.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><bdi class="text-muted fw-semibold d-block fs-7 hp-num" dir="ltr">@r.Mrn</bdi></td>
        <td class="mw-300px"><span class="text-gray-800 fw-semibold fs-7" dir="auto">@g.Reason</span></td>
        <td>@if (g.ReviewedAt == null) {<span class="badge badge-light-primary fs-7 fw-bold">@T["bg:waiting"]</span>}
            else {<span class="badge @(g.Outcome == HospitalBreakGlassOutcome.Justified ? "badge-light-success" : "badge-light-danger") fs-7 fw-bold">@T["bg:" + g.Outcome]</span>
                <span class="text-muted fw-semibold fs-7 d-block mt-1">@DisplayName.Of(r.Reviewer ?? "", r.ReviewerEn ?? r.Reviewer ?? "")@if (g.ReviewNote != null) {<span dir="auto"> · @g.ReviewNote</span>}</span>}</td>
        <td class="text-end pe-4">
            @if (g.ReviewedAt == null && me != g.EmployeeId)
            {
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-success" data-glass-review="@g.ID" data-outcome="@HospitalBreakGlassOutcome.Justified" title="@T["bg:Justified"]" data-bs-toggle="tooltip"><i class="ki-outline ki-check-circle fs-3"></i></button>
                    <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" data-glass-review="@g.ID" data-outcome="@HospitalBreakGlassOutcome.Unjustified" data-ask="@T["Why was this opening not justified?"]" title="@T["bg:Unjustified"]" data-bs-toggle="tooltip"><i class="ki-outline ki-cross-circle fs-3"></i></button>
                </div>
            }
        </td>
    </tr>
}
