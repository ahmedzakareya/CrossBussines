@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalRadHistory
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* A patient's signed imaging reports — the patient file's tab and the consultation's side card share this one view. *@
<div class="card @(Model.Compact ? "mb-5" : "")">
    <div class="card-header border-0 pt-6">
        <div class="card-title align-items-start flex-column m-0">
            <span class="card-label fw-bold text-gray-900 fs-4">@T["Imaging reports"]</span>
            @if (Model.Pending > 0) { <span class="text-muted mt-1 fw-semibold fs-7"><span class="hp-num">@Model.Pending</span> @T["still in radiology — shown once signed"]</span> }
        </div>
    </div>
    <div class="card-body pt-2">
        @if (Model.Signed.Count == 0) { <div class="text-center text-muted py-8 fs-7">@T["No signed imaging reports yet."]</div> }
        @foreach (var r in Model.Signed)
        {
            <a href="@Url.Action("RadOrder", new { id = r.ID })" class="d-block py-3 hp-row text-hover-primary">
                <div class="d-flex flex-stack mb-1">
                    <div class="fw-bold text-gray-800">@DisplayName.Of(r.Name, r.NameEn)
                        @if (r.ImpressionCategory != null) { <span class="badge @(r.ImpressionCategory == HospitalRadImpression.Critical ? "badge-danger" : r.ImpressionCategory == HospitalRadImpression.Abnormal ? "badge-light-danger" : "badge-light-success") fs-9 ms-2">@T["imp:" + r.ImpressionCategory]</span> }</div>
                    <span class="text-muted fs-8 hp-num" data-fmt data-utc="@r.SignedAt?.ToString("o")">@r.SignedAt?.ToLocalTime().ToString("yyyy-MM-dd")</span>
                </div>
                <div class="text-gray-700 fs-7 @(Model.Compact ? "text-truncate" : "")" style="white-space:pre-line">@r.Impression</div>
            </a>
        }
    </div>
</div>
