@using CrossBuy.BL.Hospital
@model (List<HospitalAllergyItem> Items, bool InDesk)
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    HOSPITAL H270 — the coded allergy list (registration window and the patient's file). The allergen is picked from
    the catalogue (or typed when the list does not hold it — shown "not in the list"), with its reaction and severity;
    "No known allergy" records that the patient was asked. js/hospital/hospital-allergy-picker.js draws and keeps the
    JSON in the hidden field the form sends (allergyItemsJson).
*@
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var json = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    // every name in the three languages rides along: an Arabic name typed on an English screen still finds its entry
    var catalog = HospitalAllergenCatalog.All.Select(a => new { code = a.Code, kind = a.Kind, label = HospitalAllergenCatalog.Label(a, lang), names = new[] { a.Ar, a.En, a.Fr } });
    var words = new
    {
        add = T["Add an allergy"].Value, nka = T["No known allergy"].Value, choose = T["Choose or type an allergy"].Value,
        reaction = T["Reaction"].Value, severity = T["Severity"].Value, notCoded = T["Not in the list"].Value, none = T["No allergy recorded yet"].Value,
        remove = T["Remove"].Value, allergen = T["Allergy"].Value, nkaOn = T["The patient was asked and has no known allergy"].Value,
        groups = new Dictionary<string, string> { [HospitalAllergenCatalog.Drug] = T["Medicines"].Value, [HospitalAllergenCatalog.Food] = T["Food"].Value, [HospitalAllergenCatalog.Environment] = T["Environment and other"].Value },
        reactions = HospitalAllergenCatalog.Reactions.Select(r => new { code = r.Code, label = lang == "ar" ? r.Ar : lang == "fr" ? r.Fr : r.En }),
        severities = new[] { new { code = HospitalAllergenCatalog.Mild, label = T["Mild"].Value }, new { code = HospitalAllergenCatalog.Moderate, label = T["Moderate"].Value }, new { code = HospitalAllergenCatalog.Severe, label = T["Severe"].Value } },
    };
}
<div data-allergy-picker data-catalog="@System.Text.Json.JsonSerializer.Serialize(catalog)" data-words="@System.Text.Json.JsonSerializer.Serialize(words)">
    @if (Model.InDesk)
    {
        <input type="hidden" data-reg-f="allergyItemsJson" data-ap-value value="@System.Text.Json.JsonSerializer.Serialize(Model.Items, json)" />
    }
    else
    {
        <input type="hidden" name="allergyItemsJson" data-ap-value value="@System.Text.Json.JsonSerializer.Serialize(Model.Items, json)" />
    }
    @* H272: the section as the rest of the window draws it (the owner: "strange and off the design") - its head with the
       two-tone icon, "no known allergy" as the theme's switch, the rows and the add action in one dashed frame *@
    <div class="d-flex flex-stack flex-wrap gap-3 mb-3">
        <span class="fw-semibold fs-6 text-gray-800 d-inline-flex align-items-center gap-2"><i class="ki-duotone ki-shield-cross fs-2 text-danger"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>@T["Allergies"]</span>
        <label class="form-check form-switch form-check-custom form-check-solid m-0"><input class="form-check-input h-20px w-35px" type="checkbox" data-ap-nka /><span class="form-check-label fs-7 fw-semibold text-gray-700">@T["No known allergy"]</span></label>
    </div>
    <div class="rounded border border-dashed border-gray-300 p-5">
        <div data-ap-rows></div>
        <button type="button" class="btn btn-sm btn-light-primary d-inline-flex align-items-center gap-1" data-ap-add><i class="ki-outline ki-plus fs-3"></i>@T["Add an allergy"]</button>
    </div>
</div>
