@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalRadFollowUpPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H243 — the imaging follow-up worklist: every recommended follow-up until the later study answers it or it is
    closed with a reason; overdue ones first. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Imaging follow-ups"].Value;
    string q = ViewBag.Q as string ?? "", view = ViewBag.View as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages; bool canClose = ViewBag.CanClose == true;
    string Link(int p, string? v = null) => Url.Action("RadFollowUps", new { q, view = v ?? view, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Imaging follow-ups"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Radiology")" class="text-muted text-hover-primary">@T["Radiology"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Imaging follow-ups"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalRadQualityService.NoTables]</div></div>
        }
        <div class="row g-5 mb-5">
            @foreach (var (v, num, label, danger) in new[] { ("", Model.Open.ToString(inv), T["Open follow-ups"].Value, false), ("overdue", Model.Overdue.ToString(inv), T["Overdue"].Value, Model.Overdue > 0), ("closed", "", T["Closed"].Value, false) })
            {
                <div class="col-6 col-xl-3"><a href="@Link(1, v)" class="card card-flush h-100 @(view == v ? "border border-primary" : "") text-hover-primary"><div class="card-body d-flex flex-column justify-content-between py-6">
                    @if (num != "") {<span class="fs-2hx fw-bold text-@(danger ? "danger" : "gray-900") hp-num">@num</span>} else {<i class="ki-outline ki-archive fs-2hx text-gray-400"></i>}
                    <span class="text-gray-600 fw-semibold fs-6">@label</span></div></a></div>
            }
        </div>
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Recommended follow-ups"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Nearest due first; each stays open until the later study answers it"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("RadFollowUps")">
                    <input type="hidden" name="view" value="@view" />
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-225px ps-12" placeholder="@T["Search a patient, accession or system"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Rows.Count == 0)
                {
                    <div class="text-center py-15"><i class="ki-outline ki-calendar-tick fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No follow-up here."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th class="min-w-150px">@T["Study"]</th><th>@T["Category"]</th><th class="min-w-175px">@T["Recommendation"]</th><th>@T["Due"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Photo, DisplayName.Of(r.PatientName, r.PatientNameEn), 35)<div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = r.F.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><span class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn</span></div></div></td>
                                <td><a href="@Url.Action("RadOrder", new { id = r.F.OrderId })" class="fw-bold text-gray-800 text-hover-primary fs-7">@DisplayName.Of(r.Exam, r.ExamEn)</a><div class="text-muted fs-8 hp-num" dir="ltr">@r.AccessionNo</div></td>
                                <td><span class="badge badge-light-primary fs-8 hp-num" dir="ltr">@r.F.System @r.F.Category</span></td>
                                <td class="fs-7 text-gray-700" dir="auto">@r.F.Recommendation@if (r.F.Note != null) {<div class="text-muted fs-8">@r.F.Note</div>}</td>
                                <td><span class="fw-bold fs-7 hp-num @(r.Overdue ? "text-danger" : "text-gray-800")" dir="ltr">@r.F.DueDate?.ToString("dd/MM/yyyy", inv)</span><div><span class="badge badge-light-@(r.F.Status == HospitalRadFollowUpStatus.Open ? (r.Overdue ? "danger" : "info") : "primary") fs-8">@T["rfu:" + r.F.Status]</span></div></td>
                                <td class="text-end text-nowrap">@if (canClose && r.F.Status == HospitalRadFollowUpStatus.Open)
                                    {
                                        <button type="button" class="btn btn-sm btn-light-primary" data-rfu-done="@r.F.ID">@T["Answered"]</button>
                                        <button type="button" class="btn btn-sm btn-icon btn-light ms-1" title="@T["Close with a reason"]" data-bs-toggle="tooltip" data-rfu-close="@r.F.ID"><i class="ki-outline ki-cross-square fs-3"></i></button>
                                    }</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Radiology/FollowUps/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), acc: @Json.Serialize(T["The accession number of the later study that answers it"].Value), why: @Json.Serialize(T["Why is the follow-up closed?"].Value) };
            function post(u, b) { return fetch(root + u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function after(res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-rfu-done],[data-rfu-close]'); if (!t) return;
                if (t.hasAttribute('data-rfu-done')) { cbPrompt(W.acc, { kind: 'primary' }).then(function (v) { if (v) post(t.getAttribute('data-rfu-done') + '/Close', { done: true, accessionNo: v }).then(after); }); return; }
                cbPrompt(W.why, { kind: 'danger', textarea: true }).then(function (v) { if (v) post(t.getAttribute('data-rfu-close') + '/Close', { done: false, note: v }).then(after); });
            });
        })();
    </script>
}
