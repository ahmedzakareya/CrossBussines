@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model HospitalWaitlistBoard?
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H48 — the earlier-slot waitlist, as the approved prototype draws it (#/portal-waitlist): four figures, "a slot freed
    up? it is offered by email, in turn", the line (patient, clinic and doctor, the appointment they hold, since when,
    the state, the action), and what happened to the last time that freed up. Every action asks first and swaps in place.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Earlier-slot waitlist"].Value;
    var b = Model;
    var rows = b?.Rows ?? Array.Empty<HospitalWaitlistRow>();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Day(DateTime d) => d.ToString("yyyy-MM-dd", inv);
    string At(DateTime d) => d.ToString("yyyy-MM-dd HH:mm", inv);
    string Clock(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("HH:mm", inv);
    int mins = b?.OfferMinutes ?? 30;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Earlier-slot waitlist"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Appointments"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Waitlist"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (b == null)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><div class="fs-6 text-gray-700">@T["The waitlist tables are not installed yet (hospital_h48_portal_waitlist.sql)."]</div></div>
            </div>
        }
        else if (!b.On)
        {
            <div class="notice d-flex bg-light rounded border-gray-300 border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-gray-600 me-4"></i>
                <div class="fw-semibold"><div class="fs-6 text-gray-700">@T["The earlier-slot waitlist is turned off in the portal settings"]</div></div>
            </div>
        }
        <div class="row g-5 g-xl-8 mb-5">
            @* H128: stat tiles (demo39 dashboards/logistics) *@
            @foreach (var s in new[] {
                (T["Waiting for an earlier slot"].Value, b?.Waiting.ToString(inv) ?? "0", "", "ki-time", "primary"),
                (T["Offers open now"].Value, b?.OpenOffers.ToString(inv) ?? "0", string.Format(T["Each held {0} minutes"].Value, mins), "ki-sms", "info"),
                (T["Slots refilled this month"].Value, b?.Refilled.ToString(inv) ?? "0", string.Format(T["of {0} freed up"].Value, b?.Freed ?? 0), "ki-calendar-tick", "primary"),
                (T["Average days gained"].Value, (b?.AverageDaysGained ?? 0).ToString("0.#", inv), "", "ki-rocket", "primary") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold @(s.Item5 == "primary" ? "text-primary" : "text-gray-900") me-2 lh-1 ls-n2"><bdi class="hp-num" dir="ltr">@s.Item2</bdi></span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item5"><i class="ki-outline @s.Item4 fs-2x text-@s.Item5"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500">@if (s.Item3 != "") {<div class="bullet w-8px h-6px rounded-2 bg-@s.Item5 me-3"></div><span class="hp-num">@s.Item3</span>} else {<span>&nbsp;</span>}</div>
                    </div>
                </div></div>
            }
        </div>

        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-notification-on fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="mb-3 mb-md-0 fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["A slot freed up? It is offered by email, in turn"]</h4>
                    <div class="fs-6 text-gray-700">@string.Format(T["When an appointment is cancelled, the first waiting patient of the same doctor whose wishes fit gets an email. The offer is held for them for {0} minutes: if they accept they take the slot and their later appointment is released by itself; if they do not answer, the offer moves to the next. Email only."].Value, mins)</div>
                </div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0">@T["Email only"]</span>
            </div>
        </div>

        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Waitlist"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7"><bdi class="hp-num" dir="ltr">@rows.Count</bdi></span></h3>
                <div class="card-toolbar">
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                        <input type="text" class="form-control form-control-solid form-control-sm w-225px ps-12" placeholder="@T["Search..."]" data-wl-search autocomplete="off" /></div>
                </div>
            </div>
            <div class="card-body pt-2">
                @if (rows.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-time fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No one is waiting for an earlier slot."]</div></div> }
                else
                {
                    @* H128: table widget (demo39 widgets/tables) *@
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Clinic & doctor"]</th><th>@T["Current appointment"]</th><th>@T["Wants"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in rows)
                            {
                                var name = DisplayName.Of(r.Name, r.NameEn);
                                <tr data-wl-row>
                                    <td class="ps-4"><div class="d-flex align-items-center">
                                        <div class="symbol symbol-45px symbol-circle me-3 flex-shrink-0">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.NameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.NameEn)</span>}</div>
                                        <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = r.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6"><bdi>@name</bdi></a>
                                            @if (r.Mrn != null) {<bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi>}</div>
                                    </div></td>
                                    <td><div class="text-gray-800 fw-bold fs-6">@DisplayName.Of(r.Clinic, r.ClinicEn)</div><div class="text-muted fw-semibold fs-7"><bdi>@DisplayName.Of(r.Doctor, r.DoctorEn)</bdi></div></td>
                                    <td><span class="badge badge-light fs-7 fw-bold hp-num" dir="ltr">@At(r.CurrentStart)</span></td>
                                    <td><span class="text-gray-700 fw-semibold fs-7">@T["Any earlier time with this doctor"]</span><div class="text-muted fs-8">@T["Since"]&nbsp;<span class="hp-num" dir="ltr">@Day(r.Since)</span></div></td>
                                    <td>
                                        @switch (r.State)
                                        {
                                            case HospitalWaitlistState.Offered:
                                                <span class="badge badge-primary fs-7 fw-bold">@T["Offer sent"]</span>
                                                <div class="text-muted fs-8 mt-1"><span class="hp-num" dir="ltr">@At(r.OfferedStart!.Value)</span></div>
                                                <div class="text-muted fs-8">@string.Format(T["Offer lapses in {0} min"].Value, r.MinutesLeft)</div>
                                                break;
                                            case HospitalWaitlistState.Took:
                                                <span class="badge badge-light-primary fs-7 fw-bold">@T["Took an earlier slot"]</span>
                                                <div class="text-muted fs-8 mt-1">@string.Format(T["Gained {0} days"].Value, r.DaysGained.ToString("0.#", inv))</div>
                                                break;
                                            case HospitalWaitlistState.Lapsed:
                                            case HospitalWaitlistState.Passed:
                                                <span class="badge badge-light fs-7 fw-bold">@(r.State == HospitalWaitlistState.Passed ? T["Passed to the next"] : T["Offer lapsed"])</span>
                                                <div class="text-muted fs-8 mt-1">@T["Place"] <span class="hp-num">@r.Place</span></div>
                                                break;
                                            default:
                                                <span class="badge badge-light-primary fs-7 fw-bold">@T["Waiting"]</span>
                                                <div class="text-muted fs-8 mt-1">@T["Place"] <span class="hp-num">@r.Place</span></div>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (r.State == HospitalWaitlistState.Offered && r.OfferId is int oid)
                                        {
                                            <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Pass to the next"]" data-bs-toggle="tooltip" data-wl-pass="@oid" data-name="@name"><i class="ki-outline ki-arrow-right fs-3"></i></button>
                                        }
                                        else if (r.State is HospitalWaitlistState.Waiting or HospitalWaitlistState.Lapsed or HospitalWaitlistState.Passed && b!.On)
                                        {
                                            <button type="button" class="btn btn-sm btn-icon btn-light-primary" title="@T["Offer a slot"]" data-bs-toggle="tooltip" data-wl-offer="@r.BookingId" data-name="@name"><i class="ki-outline ki-sms fs-3"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        <div class="card card-flush mb-5">
            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold text-gray-800">@T["The last slot that freed up — what happened"]</span>
                @if (b?.LastSlot is DateTime ls) { <span class="text-gray-500 mt-1 fw-semibold fs-7"><bdi>@DisplayName.Of(b.LastDoctor ?? "", b.LastDoctorEn ?? "")</bdi> · <span class="hp-num" dir="ltr">@At(ls)</span></span> }
            </h3></div>
            <div class="card-body pt-2">
                @if (b == null || b.LastEvents.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-sms fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No time has been offered yet."]</div></div> }
                else
                {
                    int n = 0;
                    foreach (var e in b.LastEvents)
                    {
                        var who = DisplayName.Of(e.Name, e.NameEn);
                        if (e.Kind == "Sent") n++;
                        var (icon, tone, text) = e.Kind switch
                        {
                            "Sent" => ("ki-sms", "primary", string.Format(T["Offer emailed to {0}"].Value, who) + (n == 1 ? " " + T["(first in line)"].Value : "")),
                            "Taken" => ("ki-check-circle", "primary", string.Format(T["{0} took the slot; their later appointment was released"].Value, who)),
                            "Declined" => ("ki-cross-circle", "danger", string.Format(T["{0} kept their appointment — passed to the next"].Value, who)),
                            "Passed" => ("ki-send", "primary", T["The desk passed the offer to the next"].Value),
                            _ => ("ki-time", "primary", T["The offer lapsed unanswered — passed to the next"].Value),
                        };
                        @* H128: list-widget row (demo39 dashboards/logistics) — symbol · what happened · time *@
                        <div class="d-flex flex-stack py-3 border-bottom border-gray-300 border-bottom-dashed">
                            <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline @icon fs-3 text-@tone"></i></span></div>
                            <div class="d-flex flex-stack flex-row-fluid gap-2">
                                <span class="text-gray-800 fw-bold fs-6">@text</span>
                                <span class="badge badge-light fs-7 fw-bold hp-num flex-shrink-0" dir="ltr">@Clock(e.AtUtc)</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/PortalWaitlist"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), offered: @Json.Serialize(T["Offer emailed"].Value), passed: @Json.Serialize(T["Passed to the next"].Value),
                offer: @Json.Serialize(T["Email {0} the earliest free earlier time now?"].Value), pass: @Json.Serialize(T["End {0}'s offer and send it to the next in line?"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function fmt(t) { var a = arguments; return t.replace(/\{(\d)\}/g, function (_, i) { return a[+i + 1]; }); }
            function post(url) {
                return fetch(root + url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: '{}' })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // in place, never a reload
            function swap() {
                return fetch(root, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            document.addEventListener('input', function (e) {
                var s = e.target.closest('[data-wl-search]'); if (!s) return;
                var q = s.value.trim().toLowerCase();
                document.querySelectorAll('[data-wl-row]').forEach(function (tr) { tr.style.display = !q || tr.innerText.toLowerCase().indexOf(q) >= 0 ? '' : 'none'; });
            });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-wl-offer],[data-wl-pass]'); if (!t) return;
                var offer = t.hasAttribute('data-wl-offer'), id = t.getAttribute(offer ? 'data-wl-offer' : 'data-wl-pass'), name = t.getAttribute('data-name');
                cbConfirm(fmt(offer ? W.offer : W.pass, name)).then(function (ok) {
                    if (!ok) return; t.disabled = true;
                    post(offer ? '/' + id + '/Offer' : '/Offers/' + id + '/Pass').then(function (res) {
                        t.disabled = false;
                        if (!res.ok) { toast('error', res.error || W.failed); swap(); return; }
                        toast('success', offer ? W.offered : W.passed); swap();
                    });
                });
            });
        })();
    </script>
}
