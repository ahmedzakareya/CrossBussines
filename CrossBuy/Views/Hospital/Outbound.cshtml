@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalOutboundPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H247 — outbound HL7 feeds: each feed the administrator entered (off until enabled), its queue and what was sent with
    the receiver's acknowledgement. Opening the page collects new events into the enabled feeds. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Outbound feeds"].Value;
    string q = ViewBag.Q as string ?? "", status = ViewBag.Status as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p) => Url.Action("Outbound", new { q, status, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Tone(string s) => s switch { HospitalFeedStatus.Sent => "primary", HospitalFeedStatus.Error => "danger", _ => "info" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Outbound feeds"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Interfaces"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["Outbound feeds"]</li></ul>
        </div>
        @if (Model.Ready) {<button type="button" class="btn btn-sm btn-primary" data-feed="0"><i class="ki-outline ki-plus fs-4"></i>@T["New feed"]</button>}
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalOutboundService.NoTables]</div></div>
        }
        <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T["A feed sends nothing until it is enabled with its host and port; switching it on starts from that moment (history is not replayed). Messages are collected when this page opens; sending is by the button."]</div></div>
        <div class="row g-5 mb-5">
            @if (Model.Feeds.Count == 0) {<div class="col-12"><div class="card card-flush"><div class="card-body text-muted fs-7">@T["No feed yet."]</div></div></div>}
            @foreach (var f in Model.Feeds)
            {
                var fd = f.Feed;
                <div class="col-md-6 col-xl-4"><div class="card card-flush h-100"><div class="card-body py-6">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div><div class="fw-bold text-gray-800 fs-5">@fd.Name</div><div class="text-muted fs-8 hp-num" dir="ltr">@fd.Code · HL7 @fd.Kind@if (fd.Host != null) {<text> · @fd.Host:@fd.Port</text>}</div></div>
                        <span class="badge badge-light-@(fd.Enabled ? "primary" : "secondary") fs-8">@(fd.Enabled ? T["On"] : T["Off"])</span>
                    </div>
                    <div class="d-flex gap-4 fs-7 mb-4">
                        <span><span class="fw-bold hp-num">@f.Queued</span> @T["fs:Queued"]</span><span><span class="fw-bold hp-num text-primary">@f.Sent</span> @T["fs:Sent"]</span><span><span class="fw-bold hp-num @(f.Errors > 0 ? "text-danger" : "")">@f.Errors</span> @T["fs:Error"]</span>
                    </div>
                    <div class="d-flex gap-2">
                        @if (fd.Enabled) {<button type="button" class="btn btn-sm btn-light-primary" data-feed-send="@fd.ID"><i class="ki-outline ki-send fs-4"></i>@T["Send now"]</button>}
                        <button type="button" class="btn btn-sm btn-light" data-feed="@fd.ID" data-f="@(Json.Serialize(new { fd.ID, fd.Code, fd.Name, fd.Kind, fd.Host, fd.Port, fd.ReceivingApp, fd.ReceivingFacility, fd.Enabled }).ToString())"><i class="ki-outline ki-setting-2 fs-4"></i>@T["Settings"]</button>
                    </div>
                </div></div></div>
            }
        </div>
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title"><span class="card-label fw-bold text-gray-800">@T["Messages"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("Outbound")">
                    <select name="status" class="form-select form-select-sm form-select-solid w-125px"><option value="">@T["All"]</option>@foreach (var s in new[] { HospitalFeedStatus.Queued, HospitalFeedStatus.Sent, HospitalFeedStatus.Error }) {<option value="@s" selected="@(status == s)">@T["fs:" + s]</option>}</select>
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search a patient, type or feed"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Messages.Count == 0) {<div class="text-center py-15"><i class="ki-outline ki-send fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No message yet."]</div></div>}
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th>@T["Feed"]</th><th>@T["Message"]</th><th>@T["Event"]</th><th>@T["Status"]</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Messages)
                        {
                            var m = r.Message;
                            <tr>
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Photo, DisplayName.Of(r.PatientName, r.PatientNameEn), 35)<div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = m.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><span class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn</span></div></div></td>
                                <td class="fs-7 hp-num" dir="ltr">@r.FeedCode</td>
                                <td><span class="badge badge-light fs-8 hp-num" dir="ltr" title="@m.Raw.Replace("\r", "\n")" data-bs-toggle="tooltip">@m.MessageType</span><div class="text-muted fs-9 hp-num" dir="ltr">@m.ControlId</div></td>
                                <td class="fs-8 hp-num" dir="ltr">@HospitalNursingService.UtcToWard(m.EventAt).ToString("dd/MM HH:mm", inv)</td>
                                <td><span class="badge badge-light-@Tone(m.Status) fs-8">@T["fs:" + m.Status]</span>@if (m.AckCode != null) {<span class="text-muted fs-8 ms-1 hp-num">@m.AckCode</span>}@if (m.LastError != null) {<div class="text-danger fs-8" dir="auto">@m.LastError</div>}</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="feedModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Outbound feed"]</h1></div>
        <div class="row g-5">
            <div class="col-md-4"><label class="required fs-6 fw-semibold mb-2">@T["Code"]</label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="20" data-fd="code" /></div>
            <div class="col-md-8"><label class="required fs-6 fw-semibold mb-2">@T["Name"]</label><input class="form-control form-control-solid" dir="auto" maxlength="100" data-fd="name" /></div>
            <div class="col-12"><label class="required fs-6 fw-semibold mb-2">@T["Carries"]</label><select class="form-select form-select-solid" data-fd="kind"><option value="ADT">@T["fk:ADT"]</option><option value="ORU">@T["fk:ORU"]</option></select></div>
            <div class="col-md-8"><label class="fs-6 fw-semibold mb-2">@T["Host"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="200" data-fd="host" /></div>
            <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Port"]</label><input type="number" class="form-control form-control-solid hp-num" dir="ltr" data-fd="port" /></div>
            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Receiving application"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="60" data-fd="receivingApp" /></div>
            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Receiving facility"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="60" data-fd="receivingFacility" /></div>
            <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-fd="enabled" /><span class="form-check-label fw-semibold">@T["Enabled — send patient data to this receiver"]</span></label></div>
        </div>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-feed-save>@T["Save"]</button></div>
    </div>
</div></div></div>
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Interfaces/Outbound/Feeds"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), sent: @Json.Serialize(T["Sent: {0}"].Value) }, m = document.getElementById('feedModal'), fid = null;
            function post(u, b) { return fetch(root + u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function f(k) { return m.querySelector('[data-fd=' + k + ']'); }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-feed],[data-feed-save],[data-feed-send]'); if (!t) return;
                if (t.hasAttribute('data-feed')) {
                    var d = t.getAttribute('data-f') ? JSON.parse(t.getAttribute('data-f')) : { kind: 'ADT', enabled: false }; fid = d.id || null;
                    ['code', 'name', 'host', 'port', 'receivingApp', 'receivingFacility'].forEach(function (k) { f(k).value = d[k] == null ? '' : d[k]; });
                    f('kind').value = d.kind; f('enabled').checked = !!d.enabled;
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                if (t.hasAttribute('data-feed-send')) {
                    t.disabled = true;
                    post('/' + t.getAttribute('data-feed-send') + '/Send').then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); } else toastr.success(W.sent.replace('{0}', res.id)); setTimeout(function () { location.reload(); }, 800); });
                    return;
                }
                post('', { id: fid, code: f('code').value, name: f('name').value, kind: f('kind').value, host: f('host').value || null, port: f('port').value ? +f('port').value : null,
                    receivingApp: f('receivingApp').value || null, receivingFacility: f('receivingFacility').value || null, enabled: f('enabled').checked })
                    .then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
            });
        })();
    </script>
}
