@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H88 — oncology: every active chemotherapy course, the overdue and the soonest due first (searched, filtered, paged),
    and starting a course for a patient on a regimen from the library.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Oncology"].Value;
    bool ready = ViewBag.Ready == true, canTreat = ViewBag.CanTreat == true;
    var regimens = (ViewBag.Regimens as IReadOnlyList<(int Id, string Text)>) ?? Array.Empty<(int, string)>();
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Oncology"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Chemotherapy"]</li></ul>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("ChemoRegimens")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-book fs-4"></i>@T["Regimens"]</a>
            @if (ready && canTreat) {<button type="button" class="btn btn-sm btn-primary" data-course-new><i class="ki-outline ki-plus fs-4"></i>@T["Start a course"]</button>}
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalOncologyService.NoTables]</div></div> }
        else
        {
            <div class="card">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Courses in progress"]</span><span class="text-muted fs-7 mt-1"><span id="resultCount">—</span></span></div>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by name, file, regimen or diagnosis…"]" /></div>
                        <div class="w-175px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_filter">
                            <option value="">@T["All"]</option><option value="due">@T["Due within a week"]</option><option value="overdue">@T["Overdue"]</option><option value="held">@T["Held"]</option><option value="toxic">@T["Toxicity grade 3–4"]</option>
                        </select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-8 text-uppercase gs-0"><th>@T["Patient"]</th><th>@T["Regimen"]</th><th>@T["Diagnosis"]</th><th>@T["Chemo cycles"]</th><th>@T["Next cycle"]</th><th>@T["Last toxicity"]</th><th class="text-end"></th></tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="7" class="text-center text-muted py-10">@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="7" class="text-center text-muted py-10">@T["No course in progress."]</td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (ready && canTreat)
{
    <div class="modal fade" id="courseModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["Start a course"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10"><div class="row g-4">
            @if (regimens.Count == 0) {<div class="col-12"><div class="notice d-flex rounded border border-dashed p-4 hp-notice fs-7">@T["The regimen library is empty: a regimen must be entered first."]</div></div>}
            <div class="col-12"><label class="form-label required">@T["Patient"]</label><select class="form-select form-select-solid" data-c="patientId" data-placeholder="@T["Search by name or file…"]"><option></option></select></div>
            <div class="col-12"><label class="form-label required">@T["Regimen"]</label><select class="form-select form-select-solid" data-c="regimenId"><option value="">—</option>@foreach (var r in regimens) {<option value="@r.Id">@r.Text</option>}</select></div>
            <div class="col-8"><label class="form-label required">@T["Diagnosis"]</label><input type="text" maxlength="200" class="form-control form-control-solid" data-c="diagnosis" /></div>
            <div class="col-4"><label class="form-label">@T["Stage"]</label><input type="text" maxlength="30" class="form-control form-control-solid" dir="ltr" data-c="stage" placeholder="T2N1M0" /></div>
            <div class="col-6"><label class="form-label required">@T["Intent"]</label><select class="form-select form-select-solid" data-c="intent">@foreach (var i in HospitalChemoIntent.All) {<option value="@i">@T["cin:" + i]</option>}</select></div>
            <div class="col-6"><label class="form-label">@T["First cycle on"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-c="startDate" /></div>
            <div class="col-6"><label class="form-label required">@T["Height (cm)"]</label><input type="number" step="0.5" class="form-control form-control-solid" dir="ltr" data-c="heightCm" /></div>
            <div class="col-6"><label class="form-label required">@T["Weight (kg)"]</label><input type="number" step="0.1" class="form-control form-control-solid" dir="ltr" data-c="weightKg" /></div>
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-course-save>@T["Start the course"]</button></div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            cbServerList({ url: @Json.Serialize(Url.Action("OncologyData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('filter', document.getElementById('f_filter').value); } });
            var mEl = document.getElementById('courseModal'); if (!mEl) return;
            var tok = document.querySelector('input[name="__RequestVerificationToken"]').value, pick = mEl.querySelector('[data-c="patientId"]');
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), ask: @Json.Serialize(T["Start this chemotherapy course?"].Value) };
            if (window.jQuery && jQuery.fn.select2) jQuery(pick).select2({ width: '100%', dir: @Json.Serialize(isAr ? "rtl" : "ltr"), dropdownParent: jQuery(mEl), placeholder: pick.getAttribute('data-placeholder'),
                ajax: { url: @Json.Serialize(Url.Action("SearchPatients")), dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-course-new]')) { bootstrap.Modal.getOrCreateInstance(mEl).show(); return; }
                var s = e.target.closest('[data-course-save]'); if (!s) return;
                var b = {}; mEl.querySelectorAll('[data-c]').forEach(function (i) { var k = i.getAttribute('data-c'), v = (window.jQuery && (k === 'patientId' || k === 'regimenId')) ? (jQuery(i).val() || '') : (i.value || '').trim();
                    b[k] = (k === 'patientId' || k === 'regimenId' || k === 'heightCm' || k === 'weightKg') ? Number(v || 0) : (v || null); });
                cbConfirm(W.ask).then(function (ok) { if (!ok) return; s.disabled = true;
                    fetch(@Json.Serialize(Url.Action("StartChemoCourse")), { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { s.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.href = @Json.Serialize(Url.Content("~/Hospital/Oncology/Course/")) + res.id; }); });
            });
        })();
    </script>
}
