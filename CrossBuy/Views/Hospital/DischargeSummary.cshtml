@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDischargeView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H55 — the discharge summary of a stay. The stay's facts on the left (read from the stay, never typed); the doctor's
    summary on the right; save the draft or sign it (each asks first). Signed = final. Printed only through Report
    Studio: the print menu (Hospital.DischargeSummary) — never an HTML print.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var a = Model.Admission; var p = Model.Patient; var s = Model.Summary;
    bool ready = ViewBag.Ready == true, canWrite = ViewBag.CanWrite == true;
    bool ar = DisplayName.IsArabic;
    var name = DisplayName.Of(p.Name, p.NameEn ?? p.Name);
    ViewData["Title"] = T["Discharge summary"].Value + " — " + name;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string At(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("yyyy-MM-dd HH:mm", inv);
    string ro = canWrite ? "" : "disabled";
    var procedures = s?.Procedures ?? (Model.Operations.Count > 0 ? HospitalDischargeRules.ProceduresText(Model.Operations, ar) : null);
    var signed = s?.Status == HospitalDischargeSummaryStatus.Signed;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Discharge summary"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Patient", new { id = p.ID })" class="text-muted text-hover-primary">@name</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Admissions"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @* the summary is a Report Studio layout of this stay — see _ReportPrintMenu *@
            @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
            {
                ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDischarge,
                DocumentId = a.ID.ToString(),
                DocumentTitle = name,
            })
            <a href="@Url.Action("MedRec", new { id = a.ID, stage = "Discharge" })" class="btn btn-sm btn-light"><i class="ki-outline ki-capsule fs-4"></i>@T["Medication reconciliation"]</a>
            @if (canWrite)
            {
                <button type="button" class="btn btn-sm btn-light" data-ds-save><i class="ki-outline ki-save-2 fs-4"></i>@T["Save draft"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-ds-sign><i class="ki-outline ki-check-square fs-4"></i>@T["Sign the summary"]</button>
            }
            else if (signed)
            {
                <span class="badge badge-light-success fs-7 px-4 py-3" data-ds-signed><i class="ki-outline ki-check-circle fs-5 text-success me-1"></i>@T["Signed"] · @DisplayName.Of(Model.SignedBy ?? "", Model.SignedByEn ?? Model.SignedBy ?? "") · <span class="hp-num ms-1" dir="ltr">@At(s!.SignedAt!.Value)</span></span>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalDischargeService.NoTables]</div></div> }
        <div class="row g-5">
            <div class="col-xl-4">
                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["The stay"]</span></div></div>
                    <div class="card-body pt-2">
                        <div class="d-flex align-items-center mb-5">
                            <div class="symbol symbol-50px symbol-circle me-4">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn ?? p.Name)" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(p.NameEn ?? p.Name)</span>}</div>
                            <div><a href="@Url.Action("Patient", new { id = p.ID })" class="fw-bold text-gray-900 text-hover-primary fs-5">@name</a><div><span class="badge hp-code fs-8 hp-num">@p.Mrn</span></div></div>
                        </div>
                        @foreach (var f in new (string Label, string? Value, bool Num)[] {
                            (T["ds:admitted"].Value, At(a.AdmittedAt), true),
                            (T["ds:discharged"].Value, a.DischargedAt is DateTime d ? At(d) : T["Still in"].Value, a.DischargedAt != null),
                            (T["Length of stay"].Value, Model.StayDays.ToString("0.#", inv) + " " + T["days"].Value, false),
                            (T["Ward"].Value, Model.Ward == null ? null : DisplayName.Of(Model.Ward, Model.WardEn ?? Model.Ward) + (Model.Room != null ? " · " + Model.Room : "") + (Model.Bed != null ? " · " + Model.Bed : ""), false),
                            (T["Attending doctor"].Value, Model.Attending == null ? null : DisplayName.Of(Model.Attending, Model.AttendingEn ?? Model.Attending), false),
                            (T["Reason for admission"].Value, a.Diagnosis, false) })
                        {
                            <div class="d-flex flex-stack py-3 border-bottom border-gray-200 border-bottom-dashed">
                                <span class="text-muted fw-semibold fs-7">@f.Label</span>
                                <span class="fw-bold text-gray-800 fs-7 text-end @(f.Num ? "hp-num" : "")" dir="auto">@(f.Value ?? "—")</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Operations during the stay"]</span></div></div>
                    <div class="card-body pt-2" data-ds-ops>
                        @if (Model.Operations.Count == 0) { <div class="text-muted fs-7">@T["No operation during this stay."]</div> }
                        @foreach (var o in Model.Operations)
                        {
                            <div class="py-2 border-bottom border-gray-200 border-bottom-dashed"><div class="fw-semibold text-gray-800">@DisplayName.Of(o.Name, o.NameEn)</div>
                                <div class="text-muted fs-8"><span class="hp-num" dir="ltr">@o.Date.ToString("yyyy-MM-dd", inv)</span>@if (o.Surgeon != null) {<text> · </text>@DisplayName.Of(o.Surgeon, o.SurgeonEn ?? o.Surgeon)}</div></div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-8">
                <div class="card mb-5" data-ds-form>
                    <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0">
                        <span class="card-label fw-bold text-gray-900 fs-4">@T["The doctor's summary"]</span>
                        <span class="text-muted fs-7 mt-1">@(signed ? T["Signed: it cannot change."] : T["Saved as a draft until it is signed."])</span>
                    </div></div>
                    <div class="card-body pt-2"><div class="row g-5">
                        <div class="col-12"><label class="form-label required">@T["Final diagnosis"]</label>
                            <textarea class="form-control form-control-solid" rows="2" maxlength="1000" dir="auto" data-k="finalDiagnosis" @ro>@s?.FinalDiagnosis</textarea></div>
                        <div class="col-12"><label class="form-label">@T["Course in hospital"]</label>
                            <textarea class="form-control form-control-solid" rows="5" maxlength="4000" dir="auto" data-k="course" @ro>@s?.Course</textarea></div>
                        <div class="col-12"><label class="form-label">@T["Procedures"]</label>
                            <textarea class="form-control form-control-solid" rows="2" maxlength="2000" dir="auto" data-k="procedures" @ro>@procedures</textarea></div>
                        <div class="col-md-6"><label class="form-label required">@T["Condition at discharge"]</label>
                            <select class="form-select form-select-solid" data-k="condition" @ro><option value="">—</option>
                                @foreach (var c in HospitalDischargeCondition.All) { <option value="@c" selected="@(s?.Condition == c)">@T["dc:" + c]</option> }
                            </select></div>
                        <div class="col-md-3"><label class="form-label">@T["Follow-up on"]</label>
                            <input type="date" class="form-control form-control-solid" data-k="followUpOn" value="@s?.FollowUpOn?.ToString("yyyy-MM-dd", inv)" @ro /></div>
                        <div class="col-md-3"><label class="form-label">@T["Follow-up with"]</label>
                            <input type="text" class="form-control form-control-solid" maxlength="200" dir="auto" data-k="followUpWith" value="@s?.FollowUpWith" @ro /></div>
                        <div class="col-md-6"><label class="form-label">@T["Medicines to take home"]</label>
                            <textarea class="form-control form-control-solid" rows="4" maxlength="2000" dir="auto" data-k="medications" @ro>@s?.Medications</textarea></div>
                        <div class="col-md-6"><label class="form-label">@T["Instructions for the patient"]</label>
                            <textarea class="form-control form-control-solid" rows="4" maxlength="2000" dir="auto" data-k="instructions" @ro>@s?.Instructions</textarea></div>
                    </div></div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@await Html.PartialAsync("_ReportPreviewModal", (object)(T["Discharge summary"].Value + " " + name))

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, url = @Json.Serialize(Url.Action("SaveDischargeSummary", new { id = a.ID }));
            var W = { save: @Json.Serialize(T["Save the summary as a draft?"].Value), sign: @Json.Serialize(T["Sign the discharge summary? Once signed it cannot change."].Value),
                saved: @Json.Serialize(T["Saved"].Value), signed: @Json.Serialize(T["The summary is signed"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value) };
            function body() { var o = {}; document.querySelectorAll('[data-ds-form] [data-k]').forEach(function (el) { o[el.getAttribute('data-k')] = el.value === '' ? null : el.value; }); return o; }
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            // in place: the page is rendered again and its content swapped (a signed summary locks itself)
            function swap() {
                return fetch(location.pathname, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html');
                    ['kt_app_content', 'kt_app_toolbar'].forEach(function (id) { var f = d.getElementById(id); if (f) document.getElementById(id).innerHTML = f.innerHTML; });
                    if (window.KTMenu) KTMenu.createInstances();
                });
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-ds-save],[data-ds-sign]'); if (!t) return;
                var sign = t.hasAttribute('data-ds-sign');
                cbConfirm(sign ? W.sign : W.save).then(function (ok) {
                    if (!ok) return; t.disabled = true;
                    post(sign ? url + '/Sign' : url, body()).then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', sign ? W.signed : W.saved); swap(); });
                });
            });
        })();
    </script>
}
