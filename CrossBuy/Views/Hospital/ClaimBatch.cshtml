@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalBatchView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — one claim batch, composed from the theme (demo39): stat tiles (dashboards/logistics), notices, the payer ledger
    and each claim as a card with the theme's dashed figure boxes (apps/user-management/users/view) over a table widget
    (widgets/tables) with icon actions.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var b = Model.Row.Batch;
    ViewData["Title"] = b.BatchNo;
    string? cur = Model.Row.Currency ?? ViewBag.Currency as string;   // the contract's currency when it has its own
    bool canBill = ViewBag.CanBill == true;
    bool draft = b.Status == HospitalClaimBatchStatus.Draft;
    string Money(decimal v) => v.ToString("N3", System.Globalization.CultureInfo.InvariantCulture);
    string Plain(decimal v) => v.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);
    string BatchBadge(string s) => s switch { HospitalClaimBatchStatus.Paid => "primary", HospitalClaimBatchStatus.Partial => "info", HospitalClaimBatchStatus.Rejected => "danger", HospitalClaimBatchStatus.Submitted => "primary", _ => "secondary" };
    string LineBadge(string s) => s switch { HospitalClaimLineStatus.Accepted => "primary", HospitalClaimLineStatus.Rejected => "danger", HospitalClaimLineStatus.Resubmitted => "info", _ => "primary" };
    int flagged = Model.Claims.Sum(c => c.Lines.Count(l => l.MissingPreauth));
    // H62: the claim check of a draft batch — errors block the submission (fix, or hold the claim); warnings do not
    var scrub = (ViewBag.Scrub as IReadOnlyList<HospitalScrubIssue>) ?? Array.Empty<HospitalScrubIssue>();
    int errClaims = scrub.Where(i => i.Severity == HospitalScrubSeverity.Error).Select(i => i.ClaimId).Distinct().Count();
    int warnClaims = scrub.Where(i => i.Severity == HospitalScrubSeverity.Warning).Select(i => i.ClaimId).Distinct().Count();
    string Issue(HospitalScrubIssue i) => i.Args.Length == 0 ? T[i.Message].Value : string.Format(T[i.Message].Value, i.Args.Select(a => a is string str ? T[str].Value : a).ToArray());
    // H20: what posted against the batch and what the payer still owes (null = insurance accounting not set up yet)
    var ledger = ViewBag.Ledger is ValueTuple<decimal, IReadOnlyList<HospitalClaimPosting>> lg ? lg : ((decimal, IReadOnlyList<HospitalClaimPosting>)?)null;
    // H200: the batch's electronic files (null = not installed, or the reader does not handle claims)
    var files = ViewBag.Exchanges as IReadOnlyList<(HospitalClaimExchange X, string? By)>;
    (string Where, string Why) Note(string n)
    {
        int i = n.LastIndexOf(": ", StringComparison.Ordinal);
        if (i < 0) return ("", n);
        string where = n[..i], why = n[(i + 2)..];
        if (why.StartsWith(HospitalEClaimSkip.PayerError, StringComparison.Ordinal)) why = T[HospitalEClaimSkip.PayerError].Value + why[HospitalEClaimSkip.PayerError.Length..];
        else why = T[why].Value;
        return (where, why);
    }
    var tiles = new[] {
        (Num: Model.Row.Claims.ToString(), Label: T["Claims"].Value, Icon: "document", Tone: "primary", Line: T["one per closed bill"].Value, Danger: false),
        (Num: Money(Model.Row.Amount), Label: T["Claimed from the payer"].Value, Icon: "send", Tone: "info", Line: cur ?? "", Danger: false),
        (Num: Model.Row.Accepted > 0 ? Money(Model.Row.Accepted) : "—", Label: T["Accepted"].Value, Icon: "check-circle", Tone: "primary", Line: cur ?? "", Danger: false),
        (Num: Model.Row.Rejected > 0 ? Money(Model.Row.Rejected) : "—", Label: T["Rejected"].Value, Icon: "cross-circle", Tone: Model.Row.Rejected > 0 ? "danger" : "primary", Line: cur ?? "", Danger: Model.Row.Rejected > 0) };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0 d-flex align-items-center gap-3"><bdi class="hp-num" dir="ltr">@b.BatchNo</bdi> <span class="badge badge-light-@BatchBadge(b.Status) fs-7 fw-bold">@T["cb:" + b.Status]</span></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Insurance", new { tab = "cl" })" class="text-muted text-hover-primary">@T["Approvals & claims"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@DisplayName.Of(Model.Row.Payer, Model.Row.PayerEn) · <span class="hp-num ms-1">@b.Period</span></li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @if (canBill && draft && Model.Claims.Count > 0 && errClaims > 0)
            {
                <span title="@string.Format(T["Fix or hold the {0} claims with errors before submitting"].Value, errClaims)" data-bs-toggle="tooltip"><button type="button" class="btn btn-sm btn-primary" disabled><i class="ki-outline ki-send fs-4"></i>@T["Submit batch"]</button></span>
            }
            else if (canBill && draft && Model.Claims.Count > 0)
            {
                <button type="button" class="btn btn-sm btn-primary" data-submit-batch data-ask="@string.Format(T["Submit {0} to {1}? {2} claims for {3} {4}; the batch can no longer change."].Value, b.BatchNo, DisplayName.Of(Model.Row.Payer, Model.Row.PayerEn), Model.Row.Claims, Money(Model.Row.Amount), cur)"><i class="ki-outline ki-send fs-4"></i>@T["Submit batch"]</button>
            }
            @if (canBill && !draft && files != null)
            {
                @* H200: the claims as the payer's system reads them (FHIR R4), and the payer's answer file *@
                <a href="@Url.Action("ClaimBatchFhir", new { id = b.ID })" class="btn btn-sm btn-light-primary text-nowrap" data-fhir-out><i class="ki-outline ki-file-up fs-4"></i>@T["Claims file (FHIR)"]</a>
                @* H210: the claims as the payer's TPA sheet (its columns, headers, separator and date format) *@
                <a href="@Url.Action("ClaimBatchSheet", new { id = b.ID })" class="btn btn-sm btn-light-primary text-nowrap" data-sheet-out><i class="ki-outline ki-file-sheet fs-4"></i>@T["Claim sheet (Excel)"]</a>
                <button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#hp_answer_modal" data-fhir-in><i class="ki-outline ki-file-down fs-4"></i>@T["Load the payer's answer"]</button>
            }
            @if (canBill && files != null) {<button type="button" class="btn btn-sm btn-icon btn-light" title="@T["The payer's claim sheet columns"]" data-bs-toggle="tooltip" data-sheet-setup="@b.PayerId"><i class="ki-outline ki-setting-2 fs-3"></i></button>}
            @if (canBill && !draft && ledger is { } lr && lr.Item1 > 0)
            {
                <button type="button" class="btn btn-sm btn-primary" data-remit data-owed="@Plain(lr.Item1)" data-ask="@string.Format(T["{0} still owes {1} {2} on this batch: enter the amount it paid."].Value, DisplayName.Of(Model.Row.Payer, Model.Row.PayerEn), Money(lr.Item1), cur)" data-ask2="@T["And the payer's payment reference:"]"><i class="ki-outline ki-bank fs-4"></i>@T["Record payer payment"]</button>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* stat tiles — demo39 dashboards/logistics *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in tiles)
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold me-2 lh-1 ls-n2 hp-num @(s.Danger ? "text-danger" : "text-gray-900")" dir="ltr">@s.Num</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Label</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Tone"><i class="ki-outline ki-@s.Icon fs-2x text-@s.Tone"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500"><div class="bullet w-8px h-6px rounded-2 bg-@s.Tone me-3"></div><span class="hp-num">@s.Line</span></div>
                    </div>
                </div></div>
            }
        </div>

        @if (draft && Model.Claims.Count > 0)
        {
            if (errClaims > 0)
            {
                <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mb-5" data-scrub-summary>
                    <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@string.Format(T["Claim check: {0} claims have errors that stop the submission"].Value, errClaims)</h4>
                        <div class="fs-6 text-gray-700">@T["Payers reject these. Fix what each claim lists below, or hold the claim: it leaves this batch and its bill comes back with the next build."]@if (warnClaims > 0) {<span> @string.Format(T["{0} more claims have warnings only."].Value, warnClaims)</span>}</div></div>
                </div>
            }
            else
            {
                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5" data-scrub-summary>
                    <i class="ki-outline ki-shield-tick fs-2tx text-primary me-4"></i>
                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Claim check: nothing stops this batch"]</h4>
                        <div class="fs-6 text-gray-700">@(warnClaims > 0 ? string.Format(T["{0} claims have warnings: read them before submitting."].Value, warnClaims) : T["Every claim has its approvals, cover, member number, codes and diagnosis."].Value)</div></div>
                </div>
            }
        }
        else if (flagged > 0)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mb-5">
                <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@string.Format(T["{0} lines need the payer's approval and have none"].Value, flagged)</h4>
                    <div class="fs-6 text-gray-700">@T["They go out flagged; the payer is likely to reject them. Request the approval before submitting, or expect to resubmit with a justification."]</div></div>
            </div>
        }

        @if (!draft && ledger is { } led)
        {
            @* the payer ledger — demo39 widgets/tables *@
            <div class="card card-flush mb-5">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@T["Payer ledger"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Adjustments, rejections, recoveries and payments posted against this batch"]</span>
                    </h3>
                    <div class="card-toolbar">
                        <div class="border border-gray-300 border-dashed rounded py-3 px-4">
                            <div class="fs-2 fw-bold text-primary hp-num" dir="ltr">@Money(led.Item1) <span class="fs-7 text-muted">@cur</span></div>
                            <div class="fw-semibold fs-7 text-gray-500">@T["Still owed by the payer"]</div>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-2">
                    @if (led.Item2.Count == 0)
                    {
                        <div class="text-center py-10"><i class="ki-outline ki-bank fs-3x text-gray-300 mb-4 d-block"></i>
                            <div class="fs-6 fw-bold text-gray-700">@T["Nothing has posted against this batch yet."]</div></div>
                    }
                    else
                    {
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Event"]</th><th>@T["Reference"]</th><th>@T["Date"]</th><th class="text-end pe-4 rounded-end">@T["Amount"]</th></tr></thead>
                            <tbody>
                                @foreach (var pst in led.Item2)
                                {
                                    var code = pst.ClaimLineId is int cl ? Model.Claims.SelectMany(c => c.Lines).FirstOrDefault(x => x.ID == cl)?.Code : null;
                                    string tone = pst.Event == HospitalClaimEvent.Remittance || pst.Event == HospitalClaimEvent.Recovery ? "primary" : pst.Event == HospitalClaimEvent.Rejection ? "danger" : "secondary";
                                    <tr>
                                        <td class="ps-4"><div class="d-flex align-items-center">
                                            <div class="symbol symbol-35px me-3"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-bank fs-3 text-@(tone == "secondary" ? "gray-600" : tone)"></i></span></div>
                                            <span class="badge badge-light-@tone fs-7 fw-bold">@T["ce:" + pst.Event]</span></div></td>
                                        <td><bdi class="text-gray-800 fw-bold fs-7 hp-num" dir="ltr">@(pst.Reference ?? code ?? "—")</bdi></td>
                                        <td class="text-gray-600 fw-semibold fs-7 hp-num">@pst.PostedAt.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end pe-4"><span class="text-gray-900 fw-bold fs-6 hp-num">@Money(pst.Amount)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>
        }

        @if (Model.Claims.Count == 0)
        {
            <div class="card card-flush"><div class="card-body">
                <div class="text-center py-10"><i class="ki-outline ki-document fs-3x text-gray-300 mb-4 d-block"></i>
                    <div class="fs-6 fw-bold text-gray-700">@T["This batch has no claims."]</div></div>
            </div></div>
        }
        @if (files != null && files.Count > 0)
        {
            @* H200: every electronic file of the batch, sent or received, with what it changed *@
            <div class="card card-flush mb-5" data-files>
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@T["Electronic files"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Each file is kept as it went or came; an answer is recorded line by line as if typed"]</span>
                    </h3>
                    <div class="card-toolbar"><span class="badge badge-light-primary fs-7 fw-bold hp-num">@files.Count</span></div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0 fs-7">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 min-w-100px rounded-start">@T["File"]</th><th class="min-w-100px">@T["When"]</th><th class="min-w-100px">@T["Handled by"]</th><th class="w-70px">@T["Lines recorded"]</th><th class="w-70px">@T["Left as they were"]</th><th class="min-w-200px">@T["Detail"]</th><th class="pe-4 w-50px rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var (x, by) in files)
                            {
                                bool sent = x.Direction == HospitalClaimExchangeDirection.Sent;
                                <tr>
                                    <td class="ps-4"><span class="badge badge-light-@(sent ? "info" : "primary") fs-7 fw-bold">@(sent ? T["Sent to the payer"] : T["Payer's answer"])</span> <span class="badge badge-light fs-8 fw-semibold">@(x.Format == HospitalClaimSheets.Format ? "CSV" : "FHIR")</span></td>
                                    <td><span class="hp-num" data-fmt data-utc="@x.At.ToString("o")">@x.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></td>
                                    <td>@(by ?? "—")</td>
                                    <td class="hp-num">@(sent ? "—" : x.Applied.ToString())</td>
                                    <td class="hp-num">@if (!sent && x.Skipped > 0) {<span class="text-danger fw-bold">@x.Skipped</span>} else {<text>—</text>}</td>
                                    <td class="text-gray-700">@if (sent) {<text>@string.Format(T["{0} lines"].Value, x.Applied)</text>} else if (x.Detail != null) {foreach (var n in x.Detail.Split("; ")) { var (w, y) = Note(n); <div class="mb-1"><bdi dir="ltr" class="badge badge-light fw-semibold hp-num me-1">@w</bdi>@y</div>}} else {<text>—</text>}</td>
                                    <td class="text-end pe-4"><a href="@Url.Action("ClaimExchangeFile", new { id = x.ID })" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Download"]" data-bs-toggle="tooltip"><i class="ki-outline ki-file-down fs-3"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
        }
        @foreach (var c in Model.Claims)
        {
            <div class="card card-flush mb-5">
                <div class="card-header pt-5">
                    <div class="card-title">
                        <div class="d-flex align-items-center">
                            <div class="symbol symbol-45px symbol-circle me-4 flex-shrink-0"><span class="symbol-label fw-bold fs-6 hp-initials">@HospitalUi.Initials(c.PatientNameEn)</span></div>
                            <div class="d-flex flex-column">
                                <span class="text-gray-900 fw-bold fs-5">@DisplayName.Of(c.PatientName, c.PatientNameEn) <bdi class="text-muted fw-semibold fs-7 hp-num ms-2">@c.Mrn</bdi></span>
                                <span class="text-gray-500 fw-semibold fs-7">@T["Bill"] <a href="@Url.Action("Bill", new { id = c.Claim.BillId })" class="fw-bold text-hover-primary"><bdi class="hp-num" dir="ltr">@c.BillNo</bdi></a> · @T["Member no."] <bdi class="hp-num" dir="ltr">@c.PolicyNo</bdi></span>
                            </div>
                        </div>
                    </div>
                    <div class="card-toolbar gap-3">
                        <div class="border border-gray-300 border-dashed rounded py-2 px-4"><div class="fs-5 fw-bold text-gray-800 hp-num" dir="ltr">@Money(c.Claim.Gross)</div><div class="fw-semibold fs-7 text-gray-500">@T["Bill total"]</div></div>
                        <div class="border border-gray-300 border-dashed rounded py-2 px-4"><div class="fs-5 fw-bold text-gray-800 hp-num" dir="ltr">@Money(c.Claim.PatientShare)</div><div class="fw-semibold fs-7 text-gray-500">@T["Patient's share"]</div></div>
                        <div class="border border-primary border-dashed rounded py-2 px-4"><div class="fs-5 fw-bold text-primary hp-num" dir="ltr">@Money(c.Claim.InsurerShare)</div><div class="fw-semibold fs-7 text-gray-500">@T["Payer's share"]</div></div>
                    </div>
                </div>
                <div class="card-body pt-4">
                    @{ var mine = scrub.Where(i => i.ClaimId == c.Claim.ID).OrderBy(i => i.Severity == HospitalScrubSeverity.Error ? 0 : 1).ToList(); }
                    @if (mine.Count > 0)
                    {
                        bool anyErr = mine.Any(i => i.Severity == HospitalScrubSeverity.Error);
                        <div class="notice d-flex rounded border border-dashed p-4 mb-5 @(anyErr ? "bg-light-danger border-danger" : "bg-light-primary border-primary")" data-claim-issues="@c.Claim.ID">
                            <div class="d-flex flex-stack flex-grow-1 flex-wrap gap-3">
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var i in mine)
                                    {
                                        bool err = i.Severity == HospitalScrubSeverity.Error;
                                        <div class="d-flex align-items-center gap-2 fs-7"><i class="ki-outline @(err ? "ki-cross-circle text-danger" : "ki-information-5 text-primary") fs-3"></i>
                                            <span class="badge @(err ? "badge-danger" : "badge-light-primary") fs-8 fw-bold">@T[err ? "scrub:error" : "scrub:warning"]</span><span class="text-gray-800 fw-semibold" dir="auto">@Issue(i)</span></div>
                                    }
                                </div>
                                @if (canBill && draft) { <button type="button" class="btn btn-sm btn-light-danger" data-hold="@c.Claim.ID" data-ask="@string.Format(T["Hold the claim of bill {0}? It leaves this batch, and the bill comes back with the next build."].Value, c.BillNo)"><i class="ki-outline ki-time fs-4"></i>@T["Hold the claim"]</button> }
                            </div>
                        </div>
                    }
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Line"]</th><th>@T["Category"]</th><th class="text-end">@T["Amount"]</th><th class="text-end">@T["Claimed"]</th><th>@T["Status"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var l in c.Lines)
                            {
                                var what = DisplayName.Of(l.Description, l.DescriptionEn);
                                <tr>
                                    <td class="ps-4"><div class="d-flex align-items-center">
                                        <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-@LineBadge(l.Status)"><i class="ki-outline ki-document fs-3 text-@LineBadge(l.Status)"></i></span></div>
                                        <div class="d-flex flex-column">
                                            <span class="text-gray-900 fw-bold fs-6">@what</span>
                                            <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num" dir="ltr">@l.Code</bdi>
                                                @if (l.MissingPreauth) {<span class="badge badge-light-danger fs-8 fw-bold ms-1">@T["No approval"]</span>}
                                                @if (l.ResubmitsLineId != null) {<span class="badge badge-light-info fs-8 fw-bold ms-1">@T["Resubmitted"]</span>}</span>
                                            @if (l.Justification != null) {<span class="text-gray-600 fw-semibold d-block fs-7"><bdi>@l.Justification</bdi></span>}
                                            @if (l.RejectCode != null) {<span class="d-block fs-7 mt-1"><span class="badge badge-light-danger fs-8 fw-bold hp-num">@l.RejectCode</span> <span class="text-danger fw-semibold"><bdi>@l.RejectReason</bdi></span></span>}
                                        </div>
                                    </div></td>
                                    <td class="text-gray-600 fw-semibold fs-7">@T["cat:" + l.Category]</td>
                                    <td class="text-end"><span class="text-gray-700 fw-bold fs-6 hp-num">@Money(l.Amount)</span></td>
                                    <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@Money(l.InsurerAmount)</span>@if (l.Status == HospitalClaimLineStatus.Accepted && l.AcceptedAmount != l.InsurerAmount) {<span class="text-primary fw-semibold d-block fs-7">@T["Paid"] <span class="hp-num" dir="ltr">@Money(l.AcceptedAmount ?? 0)</span></span>}@if (l.RecoupedAmount is decimal rc) {<span class="text-danger fw-semibold d-block fs-7" title="@l.RecoupReason">@T["Recouped"] <span class="hp-num" dir="ltr">@Money(rc)</span></span>}</td>
                                    <td><span class="badge badge-light-@LineBadge(l.Status) fs-7 fw-bold">@T["cl:" + l.Status]</span></td>
                                    <td class="text-end pe-4 text-nowrap">
                                        @if (canBill && !draft && l.Status == HospitalClaimLineStatus.Pending)
                                        {
                                            <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" title="@T["Accepted"]" data-bs-toggle="tooltip" data-accept="@l.ID" data-full="@Plain(l.InsurerAmount)" data-ask="@string.Format(T["The payer accepted {0}: enter the amount it pays."].Value, what)"><i class="ki-outline ki-check fs-3"></i></button>
                                            <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["Rejected"]" data-bs-toggle="tooltip" data-reject="@l.ID" data-ask="@string.Format(T["The payer rejected {0}: enter its rejection code."].Value, what)" data-ask2="@T["And the payer's reason:"]"><i class="ki-outline ki-cross fs-3"></i></button>
                                        }
                                        else if (canBill && l.Status == HospitalClaimLineStatus.Accepted && l.RecoupedAmount == null)
                                        {
                                            <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["Recoupment"]" data-bs-toggle="tooltip" data-recoup="@l.ID" data-full="@Plain(l.AcceptedAmount ?? l.InsurerAmount)" data-ask="@string.Format(T["The payer takes back part of {0} after an audit: enter the amount."].Value, what)" data-ask2="@T["And the payer's reason:"]"><i class="ki-outline ki-arrow-circle-left fs-3"></i></button>
                                        }
                                        else if (canBill && l.Status == HospitalClaimLineStatus.Rejected)
                                        {
                                            <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Resubmit"]" data-bs-toggle="tooltip" data-resubmit="@l.ID" data-ask="@string.Format(T["Resubmit {0} in this month's batch: write the justification the payer will read."].Value, what)"><i class="ki-outline ki-arrow-circle-right fs-3"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (canBill && !draft && files != null)
{
    @* H200: the payer's answer — a FHIR ClaimResponse file, pasted or chosen *@
    <div class="modal fade" id="hp_answer_modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold">@T["Load the payer's answer"]</h2><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-8 px-lg-10">
            <div class="text-gray-600 fs-7 mb-5">@T["The payer's FHIR ClaimResponse file. Each item is recorded on its claim line through the same checks and postings as an answer typed by hand; anything unclear is left as it was and named."]</div>
            <input type="file" class="form-control form-control-solid mb-4" accept=".json,application/json,application/fhir+json" data-answer-file />
            <textarea class="form-control form-control-solid font-monospace fs-8" dir="ltr" rows="10" data-answer-raw placeholder="FHIR JSON"></textarea>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button>
            <button type="button" class="btn btn-primary" data-answer-load><i class="ki-outline ki-check fs-4"></i>@T["Record the answer"]</button></div>
    </div></div></div>
}

@if (canBill && files != null)
{
    @* H210: the payer's claim sheet — which columns, in which order, under which headers *@
    <div class="modal fade" id="hp_sheet_modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-750px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold mb-0">@T["The payer's claim sheet"]</h2><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body px-10">
            <div class="text-muted fs-7 mb-5">@T["Tick the columns the payer's TPA takes, put them in its order and write its headers. One row per claim line."] <span class="badge badge-light-info fs-8 d-none" data-sheet-std>@T["Standard sheet: not saved for this payer yet"]</span></div>
            <div class="row g-4 mb-5">
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Separator"]</label><select class="form-select form-select-solid" data-sheet="delimiter"><option value=",">@T["Comma"] ( , )</option><option value=";">@T["Semicolon"] ( ; )</option><option value="TAB">@T["Tab"]</option></select></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Date format"]</label><select class="form-select form-select-solid" data-sheet="dateFormat">@foreach (var f in HospitalClaimSheets.DateFormats) {<option value="@f">@f</option>}</select></div>
            </div>
            <div class="table-responsive mh-400px scroll-y"><table class="table table-row-dashed align-middle gs-0 gy-2 my-0">
                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start w-50px"></th><th>@T["Field"]</th><th>@T["Header in the sheet"]</th><th class="text-end pe-4 rounded-end w-100px"></th></tr></thead>
                <tbody data-sheet-rows></tbody>
            </table></div>
            <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-sheet-save>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            var root = @Json.Serialize(Url.Action("Insurance")), self = @Json.Serialize(Url.Action("ClaimBatch", new { id = b.ID })), batch = @Json.Serialize(Url.Action("ClaimBatch", new { id = 0 }));
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its toolbar and content swapped.
            function swap() {
                return fetch(self, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    ['kt_app_content', 'kt_app_toolbar'].forEach(function (id) { var f = doc.getElementById(id); if (f) document.getElementById(id).innerHTML = f.innerHTML; });
                });
            }
            function done(t, after) { return function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); (after || swap)(res); }; }
            // H200: the payer's answer file — read in the browser, recorded on the server, the outcome said in one line
            var A = { done: @Json.Serialize(T["{0} lines recorded, {1} left as they were"].Value) };
            document.addEventListener('change', function (e) {
                var f = e.target.closest('[data-answer-file]'); if (!f || !f.files || !f.files[0]) return;
                f.files[0].text().then(function (txt) { document.querySelector('[data-answer-raw]').value = txt; });
            });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-answer-load]'); if (!t) return;
                var raw = document.querySelector('[data-answer-raw]').value; t.disabled = true;
                post(root + '/Batch/' + @b.ID + '/Response', { raw: raw }).then(function (res) {
                    t.disabled = false;
                    if (!res.ok) { toast('error', res.error || W.failed); return; }
                    var m = document.getElementById('hp_answer_modal'); if (window.bootstrap) bootstrap.Modal.getOrCreateInstance(m).hide();
                    toast(res.skipped > 0 ? 'info' : 'success', A.done.replace('{0}', res.applied).replace('{1}', res.skipped));
                    swap();
                });
            });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-submit-batch],[data-accept],[data-reject],[data-resubmit],[data-remit],[data-hold],[data-recoup]'); if (!t) return;
                var ask = t.getAttribute('data-ask');
                if (t.hasAttribute('data-hold')) {
                    // H62: the claim leaves the draft batch; the page is rendered again in place
                    cbConfirm(ask, { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Claims/' + t.getAttribute('data-hold') + '/Hold').then(done(t)); });
                } else if (t.hasAttribute('data-remit')) {
                    // H20: the payer's payment, full or partial, against its reference
                    cbPrompt(ask, { value: t.getAttribute('data-owed'), number: true }).then(function (v) {
                        if (v == null) return;
                        return cbPrompt(t.getAttribute('data-ask2')).then(function (ref) {
                            if (ref == null) return; t.disabled = true;
                            post(root + '/Batch/' + @b.ID + '/Remit', { amount: Number(String(v).replace(',', '.')), reference: ref }).then(done(t));
                        });
                    });
                } else if (t.hasAttribute('data-submit-batch')) {
                    cbConfirm(ask).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Batch/' + @b.ID + '/Submit').then(done(t)); });
                } else if (t.hasAttribute('data-accept')) {
                    cbPrompt(ask, { value: t.getAttribute('data-full') }).then(function (v) {
                        if (v == null) return; t.disabled = true;
                        post(root + '/Line/' + t.getAttribute('data-accept') + '/Response', { accept: true, acceptedAmount: Number(v) }).then(done(t));
                    });
                } else if (t.hasAttribute('data-recoup')) {
                    // H82: the payer takes back part or all of an accepted line; the doctor's share follows in the next statement
                    cbPrompt(ask, { kind: 'danger', value: t.getAttribute('data-full'), number: true }).then(function (v) {
                        if (v == null) return;
                        return cbPrompt(t.getAttribute('data-ask2'), { kind: 'danger', textarea: true }).then(function (reason) {
                            if (reason == null) return; t.disabled = true;
                            post(root + '/Line/' + t.getAttribute('data-recoup') + '/Recoup', { amount: Number(String(v).replace(',', '.')), reason: reason }).then(done(t));
                        });
                    });
                } else if (t.hasAttribute('data-reject')) {
                    cbPrompt(ask, { kind: 'danger' }).then(function (code) {
                        if (code == null) return;
                        return cbPrompt(t.getAttribute('data-ask2'), { kind: 'danger', textarea: true }).then(function (reason) {
                            if (reason == null) return; t.disabled = true;
                            post(root + '/Line/' + t.getAttribute('data-reject') + '/Response', { accept: false, code: code, reason: reason }).then(done(t));
                        });
                    });
                } else {
                    cbPrompt(ask, { textarea: true }).then(function (v) {
                        if (v == null) return; t.disabled = true;
                        // the line goes into this month's draft batch: open it
                        post(root + '/Line/' + t.getAttribute('data-resubmit') + '/Resubmit', { justification: v }).then(done(t, function (res) { location.href = batch.replace(/0$/, res.id); }));
                    });
                }
            });
        })();
    </script>
    <script>
        // H210: the payer's claim sheet setup
        (function () {
            var m = document.getElementById('hp_sheet_modal'); if (!m) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, payer = null, body = m.querySelector('[data-sheet-rows]');
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
            function row(f, on, header) {
                return '<tr data-key="' + esc(f.key) + '"><td class="ps-4"><div class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox"' + (on ? ' checked' : '') + ' data-on /></div></td>'
                    + '<td class="fs-7 fw-semibold text-gray-800">' + esc(f.name) + '</td>'
                    + '<td><input class="form-control form-control-sm form-control-solid" maxlength="60" dir="auto" value="' + esc(header || f.en) + '" data-h /></td>'
                    + '<td class="text-end pe-4 text-nowrap"><button type="button" class="btn btn-sm btn-icon btn-bg-light" data-up><i class="ki-outline ki-arrow-up fs-4"></i></button><button type="button" class="btn btn-sm btn-icon btn-bg-light ms-1" data-down><i class="ki-outline ki-arrow-down fs-4"></i></button></td></tr>';
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-sheet-setup],[data-up],[data-down],[data-sheet-save]'); if (!t) return;
                if (t.hasAttribute('data-sheet-setup')) {
                    payer = t.getAttribute('data-sheet-setup');
                    fetch(@Json.Serialize(Url.Content("~/Hospital/Insurance/Payers/")) + payer + '/Sheet', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (d) {
                        if (!d.ok) { toastr.error(W.failed); return; }
                        var byKey = {}; d.fields.forEach(function (f) { byKey[f.key] = f; });
                        var used = d.columns.map(function (c) { return c.key; }), h = '';
                        d.columns.forEach(function (c) { if (byKey[c.key]) h += row(byKey[c.key], true, c.header); });
                        d.fields.forEach(function (f) { if (used.indexOf(f.key) < 0) h += row(f, false, null); });
                        body.innerHTML = h;
                        [['delimiter', d.delimiter], ['dateFormat', d.dateFormat]].forEach(function (x) { var el = m.querySelector('[data-sheet=' + x[0] + ']'); el.value = x[1]; if (window.jQuery) jQuery(el).trigger('change'); });   // the theme makes these select2
                        m.querySelector('[data-sheet-std]').classList.toggle('d-none', !!d.saved);
                        bootstrap.Modal.getOrCreateInstance(m).show();
                    });
                    return;
                }
                if (t.hasAttribute('data-up') || t.hasAttribute('data-down')) {
                    var tr = t.closest('tr'), sib = t.hasAttribute('data-up') ? tr.previousElementSibling : tr.nextElementSibling;
                    if (sib) { if (t.hasAttribute('data-up')) body.insertBefore(tr, sib); else body.insertBefore(sib, tr); }
                    return;
                }
                var cols = Array.prototype.filter.call(body.querySelectorAll('tr'), function (r) { return r.querySelector('[data-on]').checked; })
                    .map(function (r) { return { key: r.getAttribute('data-key'), header: r.querySelector('[data-h]').value }; });
                t.disabled = true;
                fetch(@Json.Serialize(Url.Content("~/Hospital/Insurance/Payers/")) + payer + '/Sheet', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token },
                    body: JSON.stringify({ columns: cols, delimiter: m.querySelector('[data-sheet=delimiter]').value, dateFormat: m.querySelector('[data-sheet=dateFormat]').value }) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(m).hide(); });
            });
        })();
    </script>
}
