@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H92 — unidentified patients: every temporary identity not yet settled (the longest waiting first), registering
    one — a real file at once, with its emergency visit — and identifying one: the file renamed to the person, or
    merged into the person's own file.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Unidentified patients"].Value;
    bool ready = ViewBag.Ready == true, canReg = ViewBag.CanRegister == true, canMerge = ViewBag.CanMerge == true; int open = ViewBag.Open is int o ? o : 0;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Unidentified patients"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Not yet identified: {0}", open]</li></ul>
        </div>
        @if (ready && canReg) {<button type="button" class="btn btn-sm btn-danger" data-modal="regModal"><i class="ki-outline ki-user-tick fs-4"></i>@T["Register an unidentified patient"]</button>}
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5"><i class="ki-outline ki-information fs-2tx text-primary me-4"></i><div class="fs-6 fw-semibold text-gray-700">@T[HospitalUnidentifiedService.NoTables]</div></div> }
        else
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="fs-6 fw-semibold text-gray-700">@T["A patient who cannot say who they are gets a real file at once, under a temporary name, so tests, medicines, blood and an admission can start without waiting. When identified, the file becomes theirs, or joins the file they already had."]</div>
            </div>
            @* H128: the theme's list page (demo39 apps/ecommerce) — search and filters in the card header, the table widget below *@
            <div class="card card-flush">
                <div class="card-header pt-5 flex-wrap gap-3">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Temporary identities"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px position-relative d-flex align-items-center"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" id="f_q" class="form-control form-control-solid form-control-sm ps-12" autocomplete="off" placeholder="@T["Search by name, file, description or police report…"]" /></div>
                        <div class="w-175px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_filter"><option value="">@T["Not yet identified"]</option><option value="done">@T["Identified"]</option></select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-icon btn-light btn-active-color-primary" title="@T["Reset"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrows-circle fs-3"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Temporary file"]</th><th class="min-w-200px">@T["Description"]</th><th>@T["Since"]</th><th>@T["Police"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="6" class="text-center text-muted py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="6"><div class="text-center py-10"><i class="ki-outline ki-user-tick fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No unidentified patient."]</div></div></td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (ready && canReg)
{
    <div class="modal fade" id="regModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
        <div class="mb-10 text-center"><h1 class="mb-3">@T["Register an unidentified patient"]</h1><div class="text-muted fw-semibold fs-6">@T["Not yet identified: {0}", open]</div></div>
        <div class="row g-6">
            <div class="col-6"><label class="form-label required">@T["Sex"]</label><select class="form-select form-select-solid" data-r="sex" data-control="none"><option value="M">@T["sex:M"]</option><option value="F">@T["sex:F"]</option></select></div>
            <div class="col-6"><label class="form-label required">@T["Estimated age"]</label><input type="number" min="0" max="120" class="form-control form-control-solid" dir="ltr" data-r="estimatedAge" value="40" /></div>
            <div class="col-12"><label class="form-label required">@T["Description"]</label><textarea rows="3" maxlength="500" class="form-control form-control-solid" data-r="description" placeholder="@T["Build, height, hair, marks or tattoos, clothing, where found…"]"></textarea></div>
            <div class="col-6"><label class="form-label">@T["Brought by"]</label><input type="text" maxlength="150" class="form-control form-control-solid" data-r="broughtBy" placeholder="@T["Ambulance, police, a passer-by…"]" /></div>
            <div class="col-6"><label class="form-label">@T["Police report number"]</label><input type="text" maxlength="60" class="form-control form-control-solid" dir="ltr" data-r="policeRef" /></div>
            <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-r="medicoLegal" checked /><span class="form-check-label">@T["Police case"]</span></label></div>
            <div class="col-12"><div class="separator separator-dashed my-1"></div></div>
            <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-r="openEmergency" checked /><span class="form-check-label fw-semibold">@T["Open the emergency visit now"]</span></label></div>
            <div class="col-4" data-er><label class="form-label required">@T["Came by"]</label><select class="form-select form-select-solid" data-r="arrivalMode" data-control="none">@foreach (var a in HospitalErArrival.All) {<option value="@a" selected="@(a == HospitalErArrival.Ambulance)">@T["era:" + a]</option>}</select></div>
            <div class="col-5" data-er><label class="form-label required">@T["Why here"]</label><input type="text" maxlength="200" class="form-control form-control-solid" data-r="complaint" placeholder="@T["Unconscious, road accident…"]" /></div>
            <div class="col-3" data-er><label class="form-label">@T["Triage level"]</label><select class="form-select form-select-solid" data-r="esi" data-control="none"><option value="">—</option>@for (int e = 1; e <= 5; e++) {<option value="@e">ESI @e</option>}</select></div>
        </div>
        <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-danger" data-reg-save>@T["Open the file"]</button></div></div>
    </div></div></div>

    <div class="modal fade" id="idModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Identify the patient"]</h1><div class="text-muted fw-semibold fs-6"><bdi id="idWho"></bdi></div></div>
            <div class="d-flex gap-3 mb-5">
                <label class="btn btn-outline btn-outline-dashed btn-active-light-primary flex-fill active mb-0"><input type="radio" name="how" value="rename" class="d-none" checked />@T["Nobody had a file: make this file theirs"]</label>
                <label class="btn btn-outline btn-outline-dashed btn-active-light-primary flex-fill mb-0 @(canMerge ? "" : "disabled")"><input type="radio" name="how" value="merge" class="d-none" @(canMerge ? "" : "disabled") />@T["They already have a file: merge into it"]</label>
            </div>
            @if (!canMerge) {<div class="text-muted fs-8 mb-3">@T["Merging files needs the hospital administrator's permission."]</div>}
            <div class="row g-4" data-part="rename">
                <div class="col-6"><label class="form-label required">@T["Real name"]</label><input type="text" maxlength="200" class="form-control form-control-solid" data-i="name" /></div>
                <div class="col-6"><label class="form-label required">@T["Name in English"]</label><input type="text" maxlength="200" class="form-control form-control-solid" dir="ltr" data-i="nameEn" /></div>
                <div class="col-4"><label class="form-label required">@T["Sex"]</label><select class="form-select form-select-solid" data-i="sex" data-control="none"><option value="M">@T["sex:M"]</option><option value="F">@T["sex:F"]</option></select></div>
                <div class="col-4"><label class="form-label">@T["Date of birth"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-i="birthDate" /></div>
                <div class="col-4"><label class="form-label">@T["ID number"]</label><input type="text" maxlength="20" class="form-control form-control-solid" dir="ltr" data-i="nationalId" /></div>
                <div class="col-6"><label class="form-label">@T["Mobile number"]</label><input type="text" maxlength="20" class="form-control form-control-solid" dir="ltr" data-i="phone" /></div>
            </div>
            <div class="row g-4 d-none" data-part="merge">
                <div class="col-12"><label class="form-label required">@T["The person's own file"]</label><select class="form-select form-select-solid" data-i="existingPatientId" data-placeholder="@T["Search by name or file…"]"><option></option></select>
                    <div class="text-muted fs-8 mt-2">@T["Everything recorded on the temporary file — visits, orders, medicines, results, the bill — moves to the person's file; the temporary file is closed and points to it."]</div></div>
            </div>
            <div class="mt-6"><label class="form-label required">@T["Who identified the patient, and how"]</label><input type="text" maxlength="300" class="form-control form-control-solid" data-i="how" placeholder="@T["His brother, with his ID card…"]" /></div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-id-save>@T["Confirm"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            var list = cbServerList({ url: @Json.Serialize(Url.Action("UnidentifiedData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('filter', document.getElementById('f_filter').value); } });
            var tokEl = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tokEl) return; var tok = tokEl.value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), reg: @Json.Serialize(T["Open a file for this unidentified patient?"].Value), id: @Json.Serialize(T["Settle this patient's identity? It cannot be undone."].Value),
                      erFail: @Json.Serialize(T["The file is open, but the emergency visit was not:"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b) })
                .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            var rm = document.getElementById('regModal'), im = document.getElementById('idModal'), current = 0;
            if (rm) rm.querySelector('[data-r="openEmergency"]').addEventListener('change', function (e) { rm.querySelectorAll('[data-er]').forEach(function (x) { x.classList.toggle('d-none', !e.target.checked); }); });
            var pick = im && im.querySelector('[data-i="existingPatientId"]');
            if (pick && window.jQuery && jQuery.fn.select2) jQuery(pick).select2({ width: '100%', dir: @Json.Serialize(isAr ? "rtl" : "ltr"), dropdownParent: jQuery(im), placeholder: pick.getAttribute('data-placeholder'),
                ajax: { url: @Json.Serialize(Url.Action("SearchPatients")), dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
            if (im) im.querySelectorAll('input[name="how"]').forEach(function (r) { r.addEventListener('change', function () {
                im.querySelectorAll('input[name="how"]').forEach(function (x) { x.closest('label').classList.toggle('active', x.checked); });
                im.querySelector('[data-part="rename"]').classList.toggle('d-none', r.value !== 'rename'); im.querySelector('[data-part="merge"]').classList.toggle('d-none', r.value !== 'merge'); }); });
            document.addEventListener('click', function (e) {
                var o = e.target.closest('[data-modal]'); if (o) { bootstrap.Modal.getOrCreateInstance(document.getElementById(o.getAttribute('data-modal'))).show(); return; }
                var idb = e.target.closest('[data-identify]'); if (idb) { current = Number(idb.getAttribute('data-identify')); document.getElementById('idWho').textContent = idb.getAttribute('data-who');
                    var sx = im.querySelector('[data-i="sex"]'); sx.value = idb.getAttribute('data-sex'); if (window.jQuery) jQuery(sx).trigger('change.select2'); bootstrap.Modal.getOrCreateInstance(im).show(); return; }
                var rs = e.target.closest('[data-reg-save]');
                if (rs) { var b = {}; rm.querySelectorAll('[data-r]').forEach(function (i) { var k = i.getAttribute('data-r'); b[k] = i.type === 'checkbox' ? i.checked : (k === 'estimatedAge' ? Number(i.value || 0) : (k === 'esi' ? (i.value ? Number(i.value) : null) : ((i.value || '').trim() || null))); });
                    cbConfirm(W.reg).then(function (ok) { if (!ok) return; rs.disabled = true;
                        post(@Json.Serialize(Url.Action("RegisterUnidentified")), b).then(function (res) { rs.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                            if (res.erError) toastr.error(W.erFail + ' ' + res.erError);
                            location.href = @Json.Serialize(Url.Content("~/Hospital/Patient/")) + res.id; }); }); return; }
                var is = e.target.closest('[data-id-save]'); if (!is) return;
                var merge = im.querySelector('input[name="how"]:checked').value === 'merge', c = {};
                im.querySelectorAll('[data-i]').forEach(function (i) { var k = i.getAttribute('data-i'), v = (window.jQuery && k === 'existingPatientId') ? (jQuery(i).val() || '') : (i.value || '').trim(); c[k] = v || null; });
                if (merge) { c = { existingPatientId: c.existingPatientId ? Number(c.existingPatientId) : 0, how: c.how }; } else { delete c.existingPatientId; }
                cbConfirm(W.id).then(function (ok) { if (!ok) return; is.disabled = true;
                    post(@Json.Serialize(Url.Content("~/Hospital/Unidentified/")) + current + '/Identify', c).then(function (res) { is.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                        location.href = @Json.Serialize(Url.Content("~/Hospital/Patient/")) + res.id; }); });
            });
        })();
    </script>
}
