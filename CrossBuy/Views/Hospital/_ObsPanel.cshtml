@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalObsPatient>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H71 — the ward's observations and risk panel on the nursing station: per patient the last NEWS2 (coloured by its
    clinical risk; no amber), the readings it came from, when the next set is due (red when overdue), the falls and
    pressure-injury scales (flagged when high, "due" when a day old), and a pain reassessment that is due.
*@
@{
    bool ready = ViewBag.Ready == true, canAdmit = ViewBag.CanAdmit == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    DateTime now = DateTime.UtcNow;
    string Hm(DateTime u) => HospitalNursingService.UtcToWard(u).ToString("HH:mm", inv);
    string RiskBadge(string? r, int? n) => r switch
    {
        HospitalNews2Risk.High => "badge-danger",
        HospitalNews2Risk.Medium => "badge-light-danger",
        HospitalNews2Risk.LowSingle => "badge-light-danger",
        _ => n == 0 ? "badge-light-success" : "badge-light-primary",
    };
    int overdue = Model.Count(p => p.ObsOverdue), high = Model.Count(p => p.Last?.News2Risk is HospitalNews2Risk.High or HospitalNews2Risk.Medium or HospitalNews2Risk.LowSingle);
}
<div class="card-header border-0 pt-6">
    <div class="card-title align-items-start flex-column m-0">
        <span class="card-label fw-bold text-gray-900 fs-4">@T["Observations and risk — NEWS2"]</span>
        <span class="text-muted mt-1 fw-semibold fs-7">@T["The early warning score, falls risk (Morse) and pressure-injury risk (Braden) of every patient on the ward"]</span>
    </div>
    @if (ready)
    {
        <div class="card-toolbar gap-2">
            <span class="badge @(overdue > 0 ? "badge-light-danger" : "badge-light") fs-7">@T["Observations overdue"] <span class="hp-num ms-1">@overdue</span></span>
            <span class="badge @(high > 0 ? "badge-light-danger" : "badge-light") fs-7">@T["Need a response"] <span class="hp-num ms-1">@high</span></span>
        </div>
    }
</div>
<div class="card-body pt-2">
    @if (!ready) { <div class="notice d-flex rounded border border-dashed p-5 hp-notice"><div class="fs-7 text-gray-700">@T[HospitalObservationService.NoTables]</div></div> }
    else if (Model.Count == 0) { <div class="text-muted fs-7 py-5">@T["No patients on this ward."]</div> }
    else
    {
        @* Metronic demo39 users/list.html: fs-7 muted header, gy-5 rows, gray-600 body, 50px avatar block, one "Actions ▾" menu. *@
        <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-5 mb-0">
            <thead><tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                <th class="min-w-200px">@T["Patient"]</th><th class="min-w-75px">NEWS2</th><th class="min-w-200px">@T["Last readings"]</th><th class="min-w-100px">@T["Next set"]</th><th class="min-w-100px">@T["Falls (Morse)"]</th><th class="min-w-100px">@T["Skin (Braden)"]</th><th class="text-end min-w-100px">@T["Actions"]</th>
            </tr></thead>
            <tbody class="text-gray-600 fw-semibold">
            @foreach (var p in Model)
            {
                var o = p.Last;
                <tr data-obs-row="@p.AdmissionId">
                    <td><div class="d-flex align-items-center">
                            <div class="symbol symbol-circle symbol-50px overflow-hidden me-3 flex-shrink-0">@if (!string.IsNullOrEmpty(p.Photo)) {<div class="symbol-label"><img src="@p.Photo" alt="" class="w-100" data-initials="@HospitalUi.Initials(p.NameEn)" /></div>} else {<div class="symbol-label fs-3 hp-initials">@HospitalUi.Initials(p.NameEn)</div>}</div>
                            <div class="d-flex flex-column align-items-start"><span class="text-gray-800 mb-1">@DisplayName.Of(p.Name, p.NameEn)</span><span class="fs-7"><bdi class="hp-num">@p.Bed</bdi> · <bdi class="hp-num">@p.Mrn</bdi></span>
                                @* A GREEN BADGE IS A CLAIM. It used to appear for every patient whenever the reconciliation
   tables were missing, because the service answered "all of them are signed" rather than "I
   cannot tell" — an uninstalled module certified the whole ward. With MedRecReady false the
   badge is neutral and says so, which is the one thing the board actually knows. *@
@if (!p.MedRecReady)
{
    <span class="badge badge-light fw-bold mt-2 text-nowrap text-muted"><i class="ki-outline ki-capsule fs-7 me-1 text-muted"></i>@T["Medication reconciliation is not installed"]</span>
}
else
{
    <a href="@Url.Action("MedRec", new { id = p.AdmissionId })" class="badge fw-bold mt-2 text-nowrap @(p.MedRecSigned ? "badge-light-success" : p.MedRecOverdue ? "badge-light-danger" : "badge-light-primary")"><i class="ki-outline ki-capsule fs-7 me-1 @(p.MedRecSigned ? "text-success" : p.MedRecOverdue ? "text-danger" : "text-primary")"></i>@(p.MedRecSigned ? T["Medicines reconciled"] : p.MedRecOverdue ? T["Reconcile medicines — overdue"] : T["Reconcile medicines"])</a>
}</div>
                        </div></td>
                    <td>@if (o?.News2 is int n) {<div class="badge @RiskBadge(o.News2Risk, n) fw-bold fs-6 hp-num px-3">@n</div><div class="fs-8 text-muted mt-1 text-nowrap">@T["news2risk:" + o.News2Risk]</div>}
                        else if (o != null) {<div class="badge badge-light fw-bold">@T["Incomplete set"]</div>}
                        else {<span class="text-muted">—</span>}</td>
                    <td>@if (o != null)
                        {
                            <div class="fs-8 text-gray-800 hp-num" dir="ltr" style="text-align:start">
                                @if (o.RespRate != null) {<span class="me-2 d-inline-block text-nowrap">RR @o.RespRate</span>}
                                @if (o.SpO2 != null) {<span class="me-2 d-inline-block text-nowrap">SpO₂ @o.SpO2%@(o.OnOxygen ? " O₂" : "")</span>}
                                @if (o.SystolicBp != null) {<span class="me-2 d-inline-block text-nowrap">BP @o.SystolicBp@(o.DiastolicBp != null ? "/" + o.DiastolicBp : "")</span>}
                                @if (o.HeartRate != null) {<span class="me-2 d-inline-block text-nowrap">HR @o.HeartRate</span>}
                                @if (o.TempC != null) {<span class="me-2 d-inline-block text-nowrap">@o.TempC.Value.ToString("0.0", inv)°</span>}
                                @if (o.Consciousness != null) {<span class="me-2 d-inline-block text-nowrap">@o.Consciousness</span>}
                            </div>
                            @if (o.PainScore != null) {<div class="fs-8 mt-1">@T["Pain"] <span class="hp-num fw-bold @(o.PainScore >= 4 ? "text-danger" : "")">@o.PainScore/10</span></div>}
                            <div class="text-muted fs-9 mt-1">@T["Taken at"] <span class="hp-num" dir="ltr">@Hm(o.TakenAt)</span></div>
                        }
                        else {<span class="text-muted fs-7">@T["No observations yet"]</span>}</td>
                    <td>@if (p.ObsOverdue) {<div class="badge badge-light-danger fw-bold text-nowrap">@T["Due now"]</div>}
                        else if (p.NextDueAt is DateTime nd) {<span class="hp-num fw-semibold" dir="ltr">@Hm(nd)</span>}
                        @if (p.PainReassessAt is DateTime pr) {<div class="fs-8 mt-1 @(pr <= now ? "text-danger fw-bold" : "text-muted")">@T["Reassess pain"] <span class="hp-num" dir="ltr">@Hm(pr)</span></div>}</td>
                    <td>@if (p.Morse != null) {<div class="badge @(HospitalRiskRules.Flags(p.Morse) ? "badge-light-danger" : "badge-light") fw-bold hp-num">@p.Morse.Score</div> <span class="fs-7">@T["riskLevel:" + p.Morse.Level]</span>}
                        @if (p.MorseDue) {<div class="badge badge-light-danger fw-bold mt-1">@T["Assessment due"]</div>}</td>
                    <td>@if (p.Braden != null) {<div class="badge @(HospitalRiskRules.Flags(p.Braden) ? "badge-light-danger" : "badge-light") fw-bold hp-num">@p.Braden.Score</div> <span class="fs-7">@T["riskLevel:" + p.Braden.Level]</span>}
                        @if (p.BradenDue) {<div class="badge badge-light-danger fw-bold mt-1">@T["Assessment due"]</div>}</td>
                    <td class="text-end">
                        <a href="#" class="btn btn-light btn-active-light-primary btn-flex btn-center btn-sm" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">@T["Actions"]<i class="ki-outline ki-down fs-5 ms-1"></i></a>
                        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-175px py-4" data-kt-menu="true">
                            @if (canAdmit)
                            {
                                <div class="menu-item px-3"><a href="#" class="menu-link px-3" data-obs-new="@p.AdmissionId" data-who="@DisplayName.Of(p.Name, p.NameEn)">@T["Record observations"]</a></div>
                                <div class="menu-item px-3"><a href="#" class="menu-link px-3" data-risk-new="@p.AdmissionId" data-kind="Morse" data-who="@DisplayName.Of(p.Name, p.NameEn)">@T["obs:falls"]</a></div>
                                <div class="menu-item px-3"><a href="#" class="menu-link px-3" data-risk-new="@p.AdmissionId" data-kind="Braden" data-who="@DisplayName.Of(p.Name, p.NameEn)">@T["obs:skin"]</a></div>
                            }
                            <div class="menu-item px-3"><a href="#" class="menu-link px-3" data-obs-chart="@p.AdmissionId" data-who="@DisplayName.Of(p.Name, p.NameEn)">@T["Chart"]</a></div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</div>
