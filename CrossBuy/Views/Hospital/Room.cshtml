@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalRoomView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    bool canManage = ViewBag.CanManage == true;
    var floor = ViewBag.Floor as HospitalFloor;
    var ward = ViewBag.Ward as HospitalWard;
    var type = Model.Type;
    ViewData["Title"] = T["Room"].Value + " " + Model.Number;

    // The room is a Communication Platform subject: the shared entity panel, answered by this module.
    ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.HospitalRoom;
    ViewBag.ConversationEntityId = Model.Id;
    ViewBag.ConversationListUrl = Url.Action("RoomConversation", new { id = Model.Id });
    ViewBag.ConversationAddUrl = Url.Action("RoomConversationAdd", new { id = Model.Id });
    ViewBag.ConversationReactUrl = Url.Action("RoomConversationReact", new { id = Model.Id });

    bool canAdmit = ViewBag.CanAdmit == true;
    var occupants = (ViewBag.Occupants as Dictionary<int, HospitalOccupantView>) ?? new();
    var currency = ViewBag.Currency as HospitalCurrency;
    var plan = new { id = Model.Id, kind = Model.Kind, layout = Model.LayoutJson, beds = Model.Beds.Select(b => new { id = b.Id, code = b.Code, status = b.Status, patient = HospitalPlanPatient.Of(occupants, b.Id) }) };
    string Initials(string en) { var q = en.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return ((q.Length > 0 ? q[0][..1] : "") + (q.Length > 1 ? q[1][..1] : "")).ToUpperInvariant(); }
    var typeJs = type == null ? null : new { features = (type.Features ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries), beds = type.BedCount };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Room"] <span class="hp-num">@Model.Number</span></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Index")" class="text-muted text-hover-primary">@T["Beds & rooms"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Model.Number</li>
            </ul>
        </div>
        @if (canManage)
        {
            <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
                <a href="@Url.Action("Designer")#room-@Model.Id" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-pencil fs-4"></i>@T["Draw this room"]</a>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8">
            <div class="col-xl-7">
                <div class="card mb-5 mb-xl-8">
                    <div class="card-header border-0 pt-6">
                        <div class="card-title align-items-start flex-column m-0">
                            <span class="card-label fw-bold text-gray-900 fs-4">@(type == null ? T["kind:" + Model.Kind].Value : (isAr ? type.Name : DisplayName.Or(type.NameEn, type.Name)))</span>
                            <span class="text-muted mt-1 fw-semibold fs-7">
                                @(floor == null ? "" : (isAr ? floor.Name : DisplayName.Or(floor.NameEn, floor.Name)))
                                @if (ward != null) { <text> · @(isAr ? ward.Name : DisplayName.Or(ward.NameEn, ward.Name))</text> }
                            </span>
                        </div>
                        @if (type != null)
                        {
                            <div class="card-toolbar"><span class="badge hp-badge fs-7 px-4 py-2"><span class="hp-num">@(currency == null ? type.DailyRate.ToString("N2") : currency.Format(type.DailyRate))</span>&nbsp;@currency?.Label(isAr) @T["per day"]</span></div>
                        }
                    </div>
                    <div class="card-body pt-4">
                        <div id="roomPlan"></div>
                        @if (type != null)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-5">
                                @foreach (var f in (type.Features ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge badge-light fs-8 fw-semibold text-gray-700">@T["feature:" + f]</span>
                                }
                                @if (type.SameSexOnly) { <span class="badge badge-light-primary fs-8">@T["Same sex only"]</span> }
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-5 mb-xl-8" id="roomBedsCard">
                    <div class="card-header border-0 pt-6"><div class="card-title"><span class="card-label fw-bold text-gray-900 fs-4">@T["Beds"]</span></div></div>
                    <div class="card-body pt-0 pb-5">
                        <div class="table-responsive">
                            <table class="table align-middle gy-4 mb-0" style="font-variant-numeric:tabular-nums;">
                                <thead><tr class="fw-bold fs-8 text-uppercase text-muted" style="border-bottom:2px solid var(--cb-brand, #3A5795);">
                                    <th class="ps-4">@T["Bed"]</th><th>@T["Status"]</th><th>@T["Patient"]</th><th class="text-end pe-4"></th>
                                </tr></thead>
                                <tbody class="fs-6">
                                    @foreach (var b in Model.Beds)
                                    {
                                        <tr style="border-bottom:1px dashed #eef1f6;">
                                            <td class="ps-4"><span class="badge fw-bold fs-8 hp-num" style="background:#E7F0FF;color:#145DBF;">@b.Code</span></td>
                                            <td data-bedstate="@b.Id"><span class="hp-bed hp-legend @b.Status me-2"></span><span class="lbl">@T[b.Status]</span></td>
                                            <td>
                                                @if (occupants.TryGetValue(b.Id, out var o))
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="symbol symbol-35px symbol-circle me-3">@if (o.PhotoPath != null) {<img src="@o.PhotoPath" alt="" style="object-fit:cover" data-initials="@Initials(o.NameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@Initials(o.NameEn)</span>}</div>
                                                        <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = o.PatientId })" class="text-gray-900 text-hover-primary fw-bold fs-7">@DisplayName.Of(o.Name, o.NameEn)</a><span class="text-muted fs-8 hp-num">@o.Mrn</span></div>
                                                    </div>
                                                }
                                                else { <span class="text-muted">—</span> }
                                            </td>
                                            <td class="text-end pe-4">
                                                @if (canAdmit && occupants.TryGetValue(b.Id, out var o2))
                                                {
                                                    <div class="d-inline-flex gap-1">
                                                        <button type="button" class="btn btn-sm btn-light-primary" data-transfer="@o2.AdmissionId" data-patient="@o2.PatientId"><i class="ki-outline ki-arrows-loop fs-5"></i>@T["Transfer"]</button>
                                                        <button type="button" class="btn btn-sm btn-light" data-discharge="@o2.AdmissionId"><i class="ki-outline ki-exit-right fs-5"></i>@T["Discharge"]</button>
                                                    </div>
                                                }
                                                else if (canAdmit && b.Status == HospitalBedStatus.Vacant)
                                                {
                                                    <button type="button" class="btn btn-sm btn-light-primary me-1" data-admit-bed="@b.Id"><i class="ki-outline ki-entrance-left fs-5"></i>@T["Accommodate"]</button>
                                                }
                                                @if (canManage && !HospitalBedStatus.HoldsPatient(b.Status))
                                                {
                                                    <div class="d-inline-flex gap-1">
                                                        @foreach (var s in new[] { HospitalBedStatus.Vacant, HospitalBedStatus.Cleaning, HospitalBedStatus.Blocked })
                                                        {
                                                            <button type="button" class="btn btn-sm btn-light @(s == b.Status ? "d-none" : "")" data-setbed="@b.Id" data-status="@s">@T["Mark " + s]</button>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @if (Model.Beds.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-8">@T["This space carries no beds"]</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-5">
                @await Html.PartialAsync("_EntityConversation")
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <partial name="_HospitalScripts" />
    <partial name="_HospitalAdmit" />
    <script>
        (function () {
            var room = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(plan));
            var type = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(typeJs));
            var canAdmit = @Json.Serialize(canAdmit);
            function drawPlan() { document.getElementById('roomPlan').innerHTML = HospitalPlan.render(room, type, { big: true, onBed: true }); }
            drawPlan();
            document.getElementById('roomPlan').addEventListener('click', function (e) {
                var b = e.target.closest('[data-bed]'); if (b) HospitalAdmit.bed(+b.getAttribute('data-bed'), canAdmit);
            });

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var url = @Json.Serialize(Url.Action("SetBedStatus", new { id = 0 }));
            // One delegated handler for the beds table, so a refreshed table needs no re-binding.
            document.addEventListener('click', function (e) {
                var t;
                if ((t = e.target.closest('[data-admit-bed]'))) { HospitalAdmit.open({ bedId: +t.getAttribute('data-admit-bed') }); return; }
                if ((t = e.target.closest('[data-transfer]'))) { HospitalAdmit.open({ patientId: +t.getAttribute('data-patient'), transferAdmissionId: +t.getAttribute('data-transfer') }); return; }
                if ((t = e.target.closest('[data-discharge]'))) { HospitalAdmit.discharge(+t.getAttribute('data-discharge')); return; }
                var btn = e.target.closest('[data-setbed]'); if (!btn) return;
                var fd = new FormData(); fd.append('status', btn.getAttribute('data-status')); fd.append('__RequestVerificationToken', token);
                btn.disabled = true;
                fetch(url.replace(/0\/Status$/, btn.getAttribute('data-setbed') + '/Status'), { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) {
                        btn.disabled = false;
                        if (!res.ok) { if (window.toastr) toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); return; }
                        if (window.toastr) toastr.success(@Json.Serialize(T["Saved"].Value));
                        refresh();
                    });
            });

            // In place, never a reload: the plan redraws from the fresh building and the beds table is
            // swapped for the server's own rendering of it.
            function refresh() {
                HospitalAdmit.refresh().then(function (b) {
                    (b.floors || []).forEach(function (f) { f.rooms.forEach(function (r) { if (r.id === room.id) room.beds = r.beds; }); });
                    drawPlan();
                });
                fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html'), fresh = doc.getElementById('roomBedsCard');
                    if (fresh) document.getElementById('roomBedsCard').innerHTML = fresh.innerHTML;
                });
            }
            HospitalAdmit.onChange(refresh);
        })();
    </script>
}
