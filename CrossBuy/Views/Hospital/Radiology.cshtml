@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalRadRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Radiology"].Value;
    var stats = (HospitalRadStats)ViewBag.Stats;
    var rooms = (ViewBag.Rooms as IReadOnlyList<HospitalRadRoomCard>) ?? Array.Empty<HospitalRadRoomCard>();
    var critical = (ViewBag.Critical as List<HospitalRadRow>) ?? new();
    string? status = ViewBag.Status as string;
    bool canRad = ViewBag.CanRad == true, canReport = ViewBag.CanReport == true;
    string Prio(string p) => p == HospitalLabPriority.Stat ? "<span class=\"badge badge-danger fs-8\">STAT</span>" : p == HospitalLabPriority.Urgent ? "<span class=\"badge badge-light-primary fs-8\">" + T["Urgent"].Value + "</span>" : "<span class=\"badge badge-light fs-8\">" + T["Routine"].Value + "</span>";
    string RoomBadge(string state) => state switch
    {
        HospitalRadiologyService.RoomFree => "<span class=\"badge badge-light-success fs-8\">" + T["Free (room)"].Value + "</span>",
        HospitalRadiologyService.RoomBusy => "<span class=\"badge hp-badge fs-8\">" + T["Scanning"].Value + "</span>",
        HospitalRadiologyService.RoomReady => "<span class=\"badge badge-light-info fs-8\">" + T["Patient ready"].Value + "</span>",
        _ => "<span class=\"badge badge-light-danger fs-8\">" + T["Maintenance"].Value + "</span>",
    };
    string St(string s) => s switch { "Scheduled" => "secondary", "Arrived" => "info", "Scanning" => "primary", "Reporting" => "primary", _ => "success" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Radiology"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Diagnostics"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Radiology"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("RadiologySetup")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-setting-3 fs-4"></i>@T["Exams & rooms"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var m in HospitalRadModality.All)
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="d-flex flex-stack"><div class="text-muted fw-semibold fs-7 mb-1">@T["mod:" + m]</div><span class="badge hp-code fw-bold fs-8 hp-num">@m</span></div>
                    <div class="fs-2hx fw-bold hp-num text-gray-900">@stats.TodayByModality.GetValueOrDefault(m)</div>
                    <div class="text-muted fs-8 mt-1">@T["on today's list"]</div>
                </div></div></div>
            }
        </div>

        @foreach (var c in critical)
        {
            <div class="notice d-flex rounded border border-dashed p-6 mb-5 bg-light-danger border-danger">
                <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label bg-danger"><i class="ki-outline ki-notification-status fs-2x text-white"></i></span></span>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                    <div class="mb-3 mb-md-0 fw-semibold pe-5">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["Critical result:"] @DisplayName.Of(c.Name, c.NameEn)</h4>
                        <div class="fs-6 text-gray-700">@DisplayName.Of(c.PatientName, c.PatientNameEn) · <span class="hp-num">@c.Mrn</span> — @T["the doctor has not been recorded as told yet."]</div>
                    </div>
                    <a href="@Url.Action("RadCritical", new { id = c.Id })" class="btn btn-sm btn-danger flex-shrink-0"><i class="ki-outline ki-notification-status fs-5"></i>@T["Notify the doctor"]</a>
                </div>
            </div>
        }

        @if (rooms.Count > 0)
        {
            <div class="row g-5 mb-5">
                @foreach (var r in rooms)
                {
                    var m = r.Room;
                    <div class="col-md-6 col-xl"><div class="card h-100"><div class="card-body p-5">
                        <div class="d-flex flex-stack mb-3"><span class="fw-bold fs-5 hp-num">@m.Code</span>
                            @Html.Raw(RoomBadge(r.State))
                        </div>
                        <div class="text-muted fs-7 mb-4">@DisplayName.Of(m.Name, m.NameEn)</div>
                        @if (r.Current != null)
                        {
                            var p = r.Current;
                            <a href="@Url.Action("RadOrder", new { id = p.Id })" class="d-flex align-items-center text-hover-primary">
                                <div class="symbol symbol-35px symbol-circle flex-shrink-0">@if (p.PatientPhoto != null) {<img src="@p.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(p.PatientNameEn)</span>}</div>
                                <div class="ms-3 min-w-0"><div class="fw-bold text-gray-900 text-truncate">@DisplayName.Of(p.PatientName, p.PatientNameEn)</div><div class="text-muted fs-8 hp-num">@p.Mrn</div></div>
                            </a>
                        }
                        else
                        {
                            <div class="text-muted fs-8">@(r.State == HospitalRadiologyService.RoomMaintenance ? (m.MaintenanceNote ?? T["In maintenance"].Value) : T["No patient"].Value)</div>
                        }
                        <div class="separator my-3"></div>
                        <div class="d-flex flex-stack">
                            <div class="fs-8 text-muted">@T["Queue"] <span class="hp-num fw-bold text-gray-800">@r.Queue</span></div>
                            @if (canRad)
                            {
                                <button type="button" class="btn btn-sm btn-light py-1 px-3 fs-8" data-maint="@m.ID" data-on="@(m.InMaintenance ? "0" : "1")"
                                        data-confirm="@(m.InMaintenance ? string.Format(T["End the maintenance of {0}? It takes patients again."].Value, m.Code) : string.Format(T["Put {0} in maintenance? It takes no patients until you end it."].Value, m.Code))">@(m.InMaintenance ? T["End maintenance"] : T["Maintenance"])</button>
                            }
                        </div>
                    </div></div></div>
                }
            </div>
        }
        else
        {
            <div class="notice d-flex rounded border border-dashed border-primary bg-light-primary p-6 mb-5">
                <i class="ki-outline ki-setting-3 fs-2tx text-primary me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["No imaging rooms yet"]</h4>
                    <div class="fs-6 text-gray-700">@T["Add the machines and their modality before patients arrive."] <a href="@Url.Action("RadiologySetup")" class="fw-bold">@T["Exams & rooms"]</a></div></div>
            </div>
        }

        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title align-items-start flex-column m-0">
                    <span class="card-label fw-bold text-gray-900 fs-4">@T["Radiology worklist"]</span>
                    <span class="text-muted mt-1 fw-semibold fs-7">@T["Every imaging order a doctor signs arrives here"]</span>
                </div>
                <div class="card-toolbar d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Radiology")" class="btn btn-sm @(status == null ? "btn-primary" : "btn-light")">@T["Open work"]</a>
                    @foreach (var st in HospitalRadStatus.All)
                    {
                        <a href="@Url.Action("Radiology", new { status = st })" class="btn btn-sm @(status == st ? "btn-primary" : "btn-light")">@T["rad:" + st] <span class="hp-num ms-1">@stats.Pipeline.GetValueOrDefault(st)</span></a>
                    }
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" data-filter class="form-control form-control-solid w-200px ps-12" placeholder="@T["Search..."]" /></div>
                </div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0) { <div class="text-center text-muted py-15"><i class="ki-outline ki-scan-barcode fs-3x text-gray-300 d-block mb-4"></i>@T["No imaging orders here."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th class="w-125px">@T["Order"]</th><th>@T["Patient"]</th><th>@T["Exam"]</th><th>@T["Priority"]</th><th>@T["State"]</th><th>@T["Ordering doctor"]</th><th class="text-end w-150px"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in Model)
                            {
                                <tr data-row>
                                    <td><a href="@Url.Action("RadOrder", new { id = r.Id })" class="badge hp-code fw-bold fs-8 hp-num">@r.AccessionNo</a></td>
                                    <td><div class="d-flex align-items-center gap-3">
                                        <div class="symbol symbol-35px symbol-circle flex-shrink-0">@if (r.PatientPhoto != null) {<img src="@r.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                        <div><a href="@Url.Action("Patient", new { id = r.PatientId })" class="fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><div class="text-muted fs-8 hp-num">@r.Mrn</div></div></div></td>
                                    <td><div class="fw-semibold text-gray-800">@DisplayName.Of(r.Name, r.NameEn)</div><div class="text-muted fs-8">@T["mod:" + r.Modality]@if (r.RoomCode != null) {<text> · <span class="hp-num">@r.RoomCode</span></text>}</div></td>
                                    <td>@Html.Raw(Prio(r.Priority))</td>
                                    <td><span class="badge badge-light-@St(r.Status) fs-8">@T["rad:" + r.Status]</span>@if (r.ContrastAlert) {<span class="badge badge-danger fs-8 ms-1">@T["Contrast allergy"]</span>}@if (r.CriticalOpen) {<span class="badge badge-danger fs-8 ms-1">@T["Critical"]</span>}</td>
                                    <td>@if (r.From != null) {<div class="d-flex align-items-center gap-2">
                                        <div class="symbol symbol-30px symbol-circle flex-shrink-0">@if (r.FromPhoto != null) {<img src="@r.FromPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.FromEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(r.FromEn)</span>}</div>
                                        <span class="fs-7 text-gray-800">@DisplayName.Of(r.From, r.FromEn)</span></div>} else {<span class="text-muted">—</span>}</td>
                                    <td class="text-end">
                                        @if (canRad && r.Status == HospitalRadStatus.Scheduled) { <button type="button" class="btn btn-sm btn-light-primary" data-step="Arrive" data-id="@r.Id" data-confirm="@string.Format(T["Mark {0} arrived for {1}? A room of the exam's type is given."].Value, DisplayName.Of(r.PatientName, r.PatientNameEn), DisplayName.Of(r.Name, r.NameEn))"><i class="ki-outline ki-entrance-left fs-5"></i>@T["Arrived"]</button> }
                                        else if (r.Status == HospitalRadStatus.Signed) { <a href="@Url.Action("RadOrder", new { id = r.Id })" class="btn btn-sm btn-light">@T["View"]</a> }
                                        else if (r.Status == HospitalRadStatus.Reporting) { <a href="@Url.Action("RadOrder", new { id = r.Id })" class="btn btn-sm @(canReport ? "btn-primary" : "btn-light")">@T["Write report"]</a> }
                                        else { <a href="@Url.Action("RadOrder", new { id = r.Id })" class="btn btn-sm btn-light-primary">@T["Open"]</a> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            var base = @Json.Serialize(Url.Action("RadOrder", new { id = 0 }));
            var maintBase = @Json.Serialize(Url.Action("RadRoomMaintenance", new { id = 0 }));
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (fresh) document.getElementById('kt_app_content').innerHTML = fresh.innerHTML;
                });
            }
            function done(t) { return function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); }; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-step],[data-maint]'); if (!t) return;
                var msg = t.getAttribute('data-confirm');
                if (msg && !t.hasAttribute('data-confirmed')) { cbConfirm(msg, { kind: t.hasAttribute('data-maint') && t.getAttribute('data-on') === '1' ? 'danger' : 'primary' }).then(function (ok) { if (ok) { t.setAttribute('data-confirmed', ''); t.click(); } }); return; }
                t.removeAttribute('data-confirmed');
                t.disabled = true;
                if (t.hasAttribute('data-maint')) { post(maintBase.replace(/0\/Maintenance$/, t.getAttribute('data-maint') + '/Maintenance'), { on: t.getAttribute('data-on') === '1' }).then(done(t)); return; }
                post(base.replace(/0$/, t.getAttribute('data-id')) + '/' + t.getAttribute('data-step')).then(done(t));
            });
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-filter]')) return;
                var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row]').forEach(function (tr) { tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none'; });
            });
        })();
    </script>
}
