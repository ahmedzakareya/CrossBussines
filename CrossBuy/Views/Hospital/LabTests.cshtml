@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalLabSetupRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Lab tests & analytes"].Value;
    bool canManage = ViewBag.CanManage == true;
    string ro = canManage ? "" : "disabled";
    string Num(decimal? v) => v?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    int unset = Model.Count(m => m.Setup == null || m.Analytes.Count == 0);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Lab tests & analytes"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Lab")" class="text-muted text-hover-primary">@T["Laboratory (module)"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Lab tests & analytes"]</li>
            </ul>
        </div>
        @if (canManage && unset > 0)
        {
            <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
                <button type="button" class="btn btn-sm btn-light-primary" data-seed><i class="ki-outline ki-arrow-down fs-4"></i>@T["Load the standard panels"]</button>
                <button type="button" class="btn btn-sm btn-light-primary" data-seed-micro><i class="ki-outline ki-flask fs-4"></i>@T["Load the microbiology dictionary"]</button>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="notice d-flex rounded border border-primary border-dashed bg-light-primary p-6 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="mb-3 mb-md-0 fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Every lab test is a service of the Lab category"]</h4>
                    <div class="fs-6 text-gray-700">@T["Its price lives in the service catalogue; here are its specimen, its section and what it measures. A value outside the reference range is flagged L or H, and past a critical limit the doctor must be told."]</div>
                </div>
                <a href="@Url.Action("Services", new { category = HospitalServiceCategories.Lab })" class="btn btn-sm btn-light flex-shrink-0">@T["Service catalogue"]</a>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="card card-flush"><div class="card-body text-center py-10"><i class="ki-outline ki-flask fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No lab services yet. Add them in the service catalogue."]</div></div></div>
        }
        @foreach (var m in Model)
        {
            var s = m.Service;
            @* H127: one test — demo39 card header over its setup fields and the analyte table widget (widgets/tables) *@
            <div class="card card-flush mb-5" data-test="@s.ID">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@DisplayName.Of(s.Name, s.NameEn) <bdi class="badge badge-light-primary fw-bold fs-7 hp-num ms-1" dir="ltr">@s.Code</bdi></span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7"><span class="hp-num">@m.Analytes.Count(a => a.IsActive)</span>&nbsp;@T["analytes"]</span>
                    </h3>
                    <div class="card-toolbar">
                        @if (m.Setup == null || m.Analytes.Count == 0) {<span class="badge badge-light-danger fs-7 fw-bold">@T["not set up yet"]</span>}
                        else {<span class="badge badge-light-primary fs-7 fw-bold"><i class="ki-outline ki-check fs-7 text-primary"></i></span>}
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="row g-4 mb-6 align-items-end">
                        <div class="col-md-2"><label class="fs-6 fw-semibold mb-2">@T["Specimen"]</label><input class="form-control form-control-solid" data-k="specimen" value="@m.Setup?.Specimen" @ro /></div>
                        <div class="col-md-2"><label class="fs-6 fw-semibold mb-2">@T["Specimen (English)"]</label><input class="form-control form-control-solid" dir="ltr" data-k="specimenEn" value="@m.Setup?.SpecimenEn" @ro /></div>
                        <div class="col-md-2"><label class="fs-6 fw-semibold mb-2">@T["Section"]</label><input class="form-control form-control-solid" data-k="section" value="@m.Setup?.Section" @ro /></div>
                        <div class="col-md-2"><label class="fs-6 fw-semibold mb-2">@T["Section (English)"]</label><input class="form-control form-control-solid" dir="ltr" data-k="sectionEn" value="@m.Setup?.SectionEn" @ro /></div>
                        @* H230: a culture is reported from its microbiology panel *@
                        <div class="col-md-2"><label class="form-check form-switch form-check-custom form-check-solid mb-3"><input class="form-check-input" type="checkbox" data-k="isCulture" @(m.Setup?.IsCulture == true ? "checked" : "") @(canManage ? "" : "disabled") /><span class="form-check-label fw-semibold text-gray-700">@T["Culture (microbiology)"]</span></label></div>
                        @if (canManage) { <div class="col-md-2"><button type="button" class="btn btn-light-primary w-100" data-save-test="@s.ID"><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div> }
                    </div>
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0 fs-7">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 min-w-80px rounded-start">@T["Code"]</th><th class="min-w-150px">@T["Name"]</th><th class="min-w-150px">@T["Name (English)"]</th><th class="min-w-80px">@T["Unit"]</th>
                            <th class="min-w-70px">@T["Low"]</th><th class="min-w-70px">@T["High"]</th><th class="min-w-70px">@T["Critical low"]</th><th class="min-w-70px">@T["Critical high"]</th><th class="w-60px">@T["Decimals"]</th><th class="w-70px" title="@T["Flag a change beyond this % from the previous result"]" data-bs-toggle="tooltip">@T["Delta %"]</th><th class="w-50px" title="@T["Release a normal value without a second person"]" data-bs-toggle="tooltip">@T["Auto"]</th><th class="w-50px">@T["Active"]</th><th class="pe-4 w-60px rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var a in m.Analytes.Append(null))
                            {
                                if (a == null && !canManage) { continue; }
                                <tr data-analyte-row data-id="@a?.ID" data-service="@s.ID">
                                    <td class="ps-4"><input class="form-control form-control-sm form-control-solid hp-num" dir="ltr" data-k="code" value="@a?.Code" maxlength="30" placeholder="@(a == null ? T["New"].Value : "")" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid" data-k="name" value="@a?.Name" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid" dir="ltr" data-k="nameEn" value="@a?.NameEn" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid" dir="ltr" data-k="unit" value="@a?.Unit" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid hp-num" dir="ltr" inputmode="decimal" data-k="refLow" data-n value="@Num(a?.RefLow)" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid hp-num" dir="ltr" inputmode="decimal" data-k="refHigh" data-n value="@Num(a?.RefHigh)" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid hp-num" dir="ltr" inputmode="decimal" data-k="criticalLow" data-n value="@Num(a?.CriticalLow)" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid hp-num" dir="ltr" inputmode="decimal" data-k="criticalHigh" data-n value="@Num(a?.CriticalHigh)" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid hp-num" dir="ltr" inputmode="numeric" data-k="decimals" data-n value="@(a?.Decimals ?? 1)" @ro /></td>
                                    <td><input class="form-control form-control-sm form-control-solid hp-num" dir="ltr" inputmode="decimal" data-k="deltaPercent" data-n value="@Num(a?.DeltaPercent)" @ro /></td>
                                    <td><div class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-k="autoVerify" @(a?.AutoVerify == true ? "checked" : "") @ro /></div></td>
                                    <td><div class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-k="isActive" @(a == null || a.IsActive ? "checked" : "") @ro /></div></td>
                                    <td class="text-end pe-4 text-nowrap">@if (a != null) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" data-ranges="@a.ID" data-name="@DisplayName.Of(a.Name, a.NameEn)" title="@T["Ranges by age and sex"]" data-bs-toggle="tooltip"><i class="ki-outline ki-people fs-3"></i></button>}@if (canManage) {<button type="button" class="btn btn-sm btn-icon @(a == null ? "btn-primary" : "btn-bg-light btn-active-color-primary")" data-save-analyte title="@(a == null ? T["Add"] : T["Save"])" data-bs-toggle="tooltip"><i class="ki-outline @(a == null ? "ki-plus" : "ki-check") fs-3"></i></button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
        }
    </div></div>
</div>

@* H233: an analyte's reference ranges by sex and age band; the most specific that fits the patient is used *@
<div class="modal fade" id="hp_ranges" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-900px"><div class="modal-content">
    <div class="modal-header"><h2 class="fw-bold mb-0">@T["Ranges by age and sex"] — <span data-rg-name></span></h2><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-8 px-lg-10">
        <div class="text-muted fs-7 mb-5">@T["The most specific range that fits the patient wins: their sex before both, then the narrowest age band. None fits: the analyte's own limits."]</div>
        <div class="table-responsive"><table class="table align-middle gs-0 gy-3 fs-7 mb-0">
            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Sex"]</th><th>@T["Age from"]</th><th>@T["Age to"]</th><th>@T["Low"]</th><th>@T["High"]</th><th>@T["Critical low"]</th><th>@T["Critical high"]</th><th class="pe-4 rounded-end"></th></tr></thead>
            <tbody data-rg-rows></tbody>
            @if (canManage)
            {
                <tfoot><tr data-rg-new>
                    <td class="ps-4"><select class="form-select form-select-sm form-select-solid" data-r="sex"><option value="">@T["Both"]</option><option value="M">@T["Male"]</option><option value="F">@T["Female"]</option></select></td>
                    <td><input class="form-control form-control-sm form-control-solid hp-num w-70px" dir="ltr" inputmode="decimal" data-r="ageFrom" value="0" /></td>
                    <td><div class="d-flex gap-1"><input class="form-control form-control-sm form-control-solid hp-num w-70px" dir="ltr" inputmode="decimal" data-r="ageTo" placeholder="∞" />
                        <select class="form-select form-select-sm form-select-solid w-100px" data-r="ageUnit"><option value="years">@T["years"]</option><option value="months">@T["months"]</option><option value="days">@T["days"]</option></select></div></td>
                    <td><input class="form-control form-control-sm form-control-solid hp-num w-70px" dir="ltr" inputmode="decimal" data-r="refLow" /></td>
                    <td><input class="form-control form-control-sm form-control-solid hp-num w-70px" dir="ltr" inputmode="decimal" data-r="refHigh" /></td>
                    <td><input class="form-control form-control-sm form-control-solid hp-num w-70px" dir="ltr" inputmode="decimal" data-r="criticalLow" /></td>
                    <td><input class="form-control form-control-sm form-control-solid hp-num w-70px" dir="ltr" inputmode="decimal" data-r="criticalHigh" /></td>
                    <td class="pe-4"><button type="button" class="btn btn-sm btn-icon btn-primary" data-rg-add title="@T["Add"]"><i class="ki-outline ki-plus fs-3"></i></button></td>
                </tr></tfoot>
            }
        </table></div>
    </div>
</div></div></div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var root = @Json.Serialize(Url.Action("LabTests"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: body ? JSON.stringify(body) : null })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    ['kt_app_content', 'kt_app_toolbar'].forEach(function (id) { var f = doc.getElementById(id); if (f) document.getElementById(id).innerHTML = f.innerHTML; });
                });
            }
            function read(scope) {
                var o = {};
                scope.querySelectorAll('[data-k]').forEach(function (i) {
                    var k = i.getAttribute('data-k');
                    if (i.type === 'checkbox') o[k] = i.checked;
                    else if (i.hasAttribute('data-n')) o[k] = i.value.trim() === '' ? null : Number(i.value);
                    else o[k] = i.value;
                });
                return o;
            }
            function done(btn) { return function (res) { btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); }; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-seed],[data-seed-micro],[data-save-test],[data-save-analyte]'); if (!t) return;
                t.disabled = true;
                if (t.hasAttribute('data-seed')) { post(root + '/SeedStandard').then(done(t)); return; }
                if (t.hasAttribute('data-seed-micro')) { post(root + '/Micro/SeedStandard').then(done(t)); return; }   // H230
                if (t.hasAttribute('data-save-test')) { post(root + '/' + t.getAttribute('data-save-test'), read(t.closest('.row'))).then(done(t)); return; }
                var tr = t.closest('tr'), body = read(tr);
                body.serviceId = Number(tr.getAttribute('data-service'));
                body.id = tr.getAttribute('data-id') ? Number(tr.getAttribute('data-id')) : null;
                post(root + '/Analyte', body).then(done(t));
            });
        })();
    </script>

    <script>
        // H233: the ranges of one analyte
        (function () {
            var m = document.getElementById('hp_ranges'); if (!m) return;
            var tk = document.querySelector('input[name="__RequestVerificationToken"]'), root = @Json.Serialize(Url.Content("~/Hospital/LabTests")), current = null;
            var L = { both: @Json.Serialize(T["Both"].Value), M: @Json.Serialize(T["Male"].Value), F: @Json.Serialize(T["Female"].Value), years: @Json.Serialize(T["years"].Value), days: @Json.Serialize(T["days"].Value),
                failed: @Json.Serialize(T["The change could not be saved"].Value), del: @Json.Serialize(T["Remove this range?"].Value), canManage: @Json.Serialize(canManage) };
            function age(d) { if (d == null) return '∞'; return d % 365 === 0 || d >= 730 ? (Math.round(d / 365.25 * 10) / 10) + ' ' + L.years : d + ' ' + L.days; }
            function n(v) { return v == null ? '—' : v; }
            function load() {
                return fetch(root + '/Analyte/' + current + '/Ranges', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (d) {
                    m.querySelector('[data-rg-rows]').innerHTML = (d.rows || []).map(function (x) {
                        return '<tr><td class="ps-4">' + (x.sex ? L[x.sex] : L.both) + '</td><td class="hp-num" dir="ltr">' + age(x.ageFromDays) + '</td><td class="hp-num" dir="ltr">' + age(x.ageToDays) + '</td><td class="hp-num" dir="ltr">' + n(x.refLow) + '</td><td class="hp-num" dir="ltr">' + n(x.refHigh) + '</td><td class="hp-num" dir="ltr">' + n(x.criticalLow) + '</td><td class="hp-num" dir="ltr">' + n(x.criticalHigh) + '</td><td class="pe-4">'
                            + (L.canManage ? '<button type="button" class="btn btn-sm btn-icon btn-light-danger" data-rg-del="' + x.id + '"><i class="ki-outline ki-trash fs-4"></i></button>' : '') + '</td></tr>';
                    }).join('');
                });
            }
            function num(v) { v = (v || '').trim(); return v === '' ? null : Number(v); }
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tk.value }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-ranges],[data-rg-add],[data-rg-del]'); if (!t) return;
                if (t.hasAttribute('data-ranges')) { current = t.getAttribute('data-ranges'); m.querySelector('[data-rg-name]').textContent = t.getAttribute('data-name'); load().then(function () { bootstrap.Modal.getOrCreateInstance(m).show(); }); return; }
                if (t.hasAttribute('data-rg-del')) { cbConfirm(L.del, { kind: 'danger' }).then(function (ok) { if (!ok) return; post(root + '/Ranges/' + t.getAttribute('data-rg-del') + '/Delete').then(function (res) { if (!res.ok) { toastr.error(res.error || L.failed); return; } load(); }); }); return; }
                var row = m.querySelector('[data-rg-new]'); function v(k) { return row.querySelector('[data-r="' + k + '"]').value; }
                t.disabled = true;
                post(root + '/Ranges', { analyteId: +current, sex: v('sex') || null, ageFrom: num(v('ageFrom')) || 0, ageTo: num(v('ageTo')), ageUnit: v('ageUnit'), refLow: num(v('refLow')), refHigh: num(v('refHigh')), criticalLow: num(v('criticalLow')), criticalHigh: num(v('criticalHigh')) })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || L.failed); return; } load(); });
            });
        })();
    </script>
}
