@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.BL.Reporting
@model CrossBuy.Controllers.HospitalController.HospitalDashboardModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H50 — the hospital dashboard, as the approved prototype draws it (#/dashboard): four figures, today's summary,
    then occupancy by ward and the ER queue beside the doctors on duty, today's theatre and this month's claims.
    Report Studio is the source: every figure is a KPI over a hospital report, every list is that report's rows,
    and every card opens the report (or the live board) it comes from. A figure the reader may not see is "—".
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Hospital dashboard"].Value;
    var m = Model;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string N(decimal? v, string fmt = "#,##0.###") => v is { } x ? x.ToString(fmt, inv) : "—";
    decimal? V(string k) => m.Kpi.GetValueOrDefault(k);
    string Day(DateTime d) => d.ToString("yyyy-MM-dd", inv);
    string Report(string code, DateTime? from = null, DateTime? to = null) =>
        Url.Action("Viewer", "Reports", from == null ? new { id = code, run = true } : (object)new { id = code, run = true, From = Day(from.Value), To = Day(to ?? from.Value) })!;
    decimal? beds = V(HospitalKpis.BedsTotal), occ = V(HospitalKpis.BedsOccupied), claimed = V(HospitalKpis.Claimed), rejected = V(HospitalKpis.ClaimsRejected);
    decimal? occPct = beds is > 0 && occ is { } o ? Math.Round(o * 100 / beds.Value) : null;
    decimal? rejPct = claimed is > 0 && rejected is { } rj ? Math.Round(rj * 100 / claimed.Value, 1) : null;
    string Esi(int? e) => e switch { 1 or 2 => "badge-danger", 3 => "badge-light-primary", 4 => "badge-light-primary", _ => "badge-light" };
    string Status(string? s) => s switch { _ when s == null => "", _ => s };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Hospital dashboard"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["hd:crumb"]</li></ul>
        </div>
        <div class="d-flex align-items-center gap-2 d-print-none">
            <a href="@Url.Action("Capacity", "Hospital")" class="btn btn-sm btn-light"><i class="ki-outline ki-home-2 fs-4"></i>@T["Capacity centre"]</a>
            <a href="@Url.Action("Staffing", "Hospital")" class="btn btn-sm btn-light"><i class="ki-outline ki-people fs-4"></i>@T["Acuity staffing"]</a>
            <a href="@Url.Action("RiskModels", "Hospital")" class="btn btn-sm btn-light"><i class="ki-outline ki-chart-line-up fs-4"></i>@T["Predictive models"]</a>
            <a href="@Url.Action("Biomed", "Hospital")" class="btn btn-sm btn-light"><i class="ki-outline ki-technology-2 fs-4"></i>@T["Biomedical engineering"]</a>
            <a href="@Url.Action("Reports", "Hospital")" class="btn btn-sm btn-light"><i class="ki-outline ki-chart-pie-simple fs-4"></i>@T["Hospital reports"]</a>
            <a href="@Url.Action("RegisterPatient", "Hospital")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-4"></i>@T["Register patient"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Outpatient visits today"].Value, N(V(HospitalKpis.Appointments)), string.Format(T["of which {0} completed"].Value, N(V(HospitalKpis.Seen))), "ki-briefcase", Report(HospitalReportCodes.DoctorProductivity, m.Today)),
                (T["ER — waiting"].Value, N(V(HospitalKpis.ErWaiting)), string.Format(T["Door-to-doctor avg {0} min"].Value, N(V(HospitalKpis.ErDoorToDoctor), "0")), "ki-pulse", Report(HospitalReportCodes.ErWaiting, m.Today)),
                (T["Bed occupancy"].Value, occPct == null ? "—" : N(occPct, "0") + "%", string.Format(T["{0} of {1}"].Value, N(occ), N(beds)) + " " + T["beds occupied"].Value, "ki-home-3", Report(HospitalReportCodes.BedOccupancy, m.Today)),
                (T["Revenue today"].Value, N(V(HospitalKpis.Revenue)), string.Format(T["Collected {0}"].Value, N(V(HospitalKpis.Collected))), "ki-dollar", Report(HospitalReportCodes.Revenue, m.Today)) })
            {
                string tone = s.Item4 == "ki-pulse" ? "danger" : s.Item4 == "ki-home-3" ? "info" : s.Item4 == "ki-dollar" ? "primary" : "primary";
                @* H128: stat tile (demo39 dashboards/logistics) — the whole tile opens its report *@
                <div class="col-sm-6 col-xl-3"><a href="@s.Item5" class="card card-flush h-100 text-decoration-none hoverable" data-hd-tile>
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2"><bdi class="hp-num" dir="ltr">@s.Item2</bdi></span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@tone"><i class="ki-outline @s.Item4 fs-2x text-@tone"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500"><div class="bullet w-8px h-6px rounded-2 bg-@tone me-3"></div><span class="hp-num">@s.Item3</span></div>
                    </div>
                </a></div>
            }
        </div>

        <div class="notice d-flex rounded border border-primary border-dashed bg-light-primary p-6 mb-5">
            <i class="ki-outline ki-calendar-tick fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="mb-3 mb-md-0 fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Today's summary"]</h4>
                    <div class="fs-6 text-gray-700" data-hd-summary>@string.Format(T["{0} critical results not yet acknowledged by the doctor, {1} pre-authorisations waiting for the insurer, and {2} waiting in the ER."].Value, N(V(HospitalKpis.CriticalOpen)), N(V(HospitalKpis.PreauthPending)), N(V(HospitalKpis.ErWaiting)))</div>
                </div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0"><bdi class="hp-num" dir="ltr">@Day(m.Today)</bdi></span>
            </div>
        </div>

        <div class="row g-5 g-xl-8">
            <div class="col-xl-7">
                @* H128: table widget (demo39 widgets/tables) *@
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Occupancy by ward"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Live from the bed board"]</span></h3>
                        <div class="card-toolbar gap-2"><a href="@Report(HospitalReportCodes.BedOccupancy, m.MonthStart, m.Today)" class="btn btn-sm btn-light">@T["hd:report"]</a><a href="@Url.Action("Index", "Hospital")" class="btn btn-sm btn-light-primary">@T["Bed board"]</a></div>
                    </div>
                    <div class="card-body pt-2">
                        @if (m.Wards.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-home-3 fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No ward yet."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0" data-hd-wards>
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Ward"]</th><th class="text-end w-90px">@T["Occupied"]</th><th class="text-end w-90px">@T["Vacant"]</th><th class="w-200px pe-4 rounded-end">@T["hd:occupancy"]</th></tr></thead>
                                <tbody>
                                    @foreach (var w in m.Wards)
                                    {
                                        int b = (int)w["Beds"]!, o2 = (int)w["OccupiedNow"]!; int pct = b == 0 ? 0 : (int)Math.Round(o2 * 100m / b);
                                        <tr>
                                            <td class="ps-4"><div class="d-flex align-items-center">
                                                <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-home-3 fs-3 text-primary"></i></span></div>
                                                <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@w["Ward"]</span><span class="text-muted fw-semibold d-block fs-7">@w["Floor"]</span></div></div></td>
                                            <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@o2</span></td>
                                            <td class="text-end">@if (b - o2 > 0) {<span class="badge badge-light-primary fs-7 fw-bold hp-num">@(b - o2)</span>} else {<span class="text-muted">—</span>}</td>
                                            <td class="pe-4"><div class="d-flex align-items-center gap-2"><div class="progress h-6px flex-grow-1 bg-light-@(pct > 85 ? "danger" : "primary")"><div class="progress-bar @(pct > 85 ? "bg-danger" : "bg-primary")" style="width:@(pct)%"></div></div><span class="hp-num fs-7 fw-bold text-gray-600 w-35px" dir="ltr">@(pct)%</span></div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Emergency queue"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Ordered by triage level"]</span></h3>
                        <div class="card-toolbar gap-2"><a href="@Report(HospitalReportCodes.ErWaiting, m.Today)" class="btn btn-sm btn-light">@T["hd:report"]</a><a href="@Url.Action("Emergency", "Hospital")" class="btn btn-sm btn-light-primary">@T["ER board"]</a></div>
                    </div>
                    <div class="card-body pt-2">
                        @if (m.Er.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-pulse fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No one is in the ER now."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0" data-hd-er>
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Patient"]</th><th class="w-70px">ESI</th><th>@T["Complaint"]</th><th class="text-end w-90px pe-4 rounded-end">@T["Wait"]</th></tr></thead>
                                <tbody>
                                    @foreach (var e in m.Er)
                                    {
                                        var face = e["PatientId"] is int pid ? m.ErPatients.GetValueOrDefault(pid) : default;
                                        string initials = HospitalUi.Initials(face.NameEn ?? e["PatientName"] as string ?? "?");
                                        int wait = e["ArrivedAt"] is DateTime at ? (int)Math.Max(0, (DateTime.Now - at).TotalMinutes) : 0;
                                        <tr>
                                            <td class="ps-4"><div class="d-flex align-items-center">
                                                <div class="symbol symbol-35px symbol-circle me-3 flex-shrink-0">@if (face.Photo != null) {<img src="@face.Photo" alt="" style="object-fit:cover" data-initials="@initials" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@initials</span>}</div>
                                                <span class="text-gray-900 fw-bold fs-6"><bdi>@e["PatientName"]</bdi></span></div></td>
                                            <td><span class="badge @Esi(e["Esi"] as int?) fs-7 fw-bold" dir="ltr">@(e["Esi"] is int esi ? "ESI " + esi : "—")</span></td>
                                            <td class="text-gray-700 fw-semibold fs-7">@e["Complaint"]</td>
                                            <td class="text-end pe-4 text-nowrap">@if (wait < 60) {<span class="hp-num fw-bold">@wait</span>@Html.Raw("&nbsp;")@T["hd:minutes"]} else if (wait < 1440) {<span class="hp-num fw-bold">@(wait / 60)</span>@Html.Raw("&nbsp;")@T["h"]} else {<span class="hp-num fw-bold text-danger">@(wait / 1440)</span>@Html.Raw("&nbsp;")@T["days"]}</td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-5">
                @* H128: list widgets (demo39 dashboards/logistics) *@
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Doctors on duty"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Today"]</span></h3>
                        <div class="card-toolbar"><a href="@Report(HospitalReportCodes.DoctorProductivity, m.Today)" class="btn btn-sm btn-light">@T["hd:report"]</a></div>
                    </div>
                    <div class="card-body pt-2" data-hd-doctors>
                        @if (m.Doctors.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-user-tick fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No appointments today."]</div></div> }
                        @for (int i = 0; i < m.Doctors.Count; i++)
                        {
                            var d = m.Doctors[i];
                            var photo = m.DoctorPhotos.GetValueOrDefault((int)d["PractitionerId"]!);
                            string initials = HospitalUi.Initials(d["Doctor"] as string ?? "?");
                            <div class="d-flex flex-stack">
                                <div class="symbol symbol-40px symbol-circle me-4 flex-shrink-0">@if (photo != null) {<img src="@photo" alt="" style="object-fit:cover" data-initials="@initials" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@initials</span>}</div>
                                <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                    <div class="me-3 min-w-0"><span class="text-gray-800 fw-bold fs-6"><bdi>@d["Doctor"]</bdi></span><span class="text-gray-500 fw-semibold fs-7 d-block">@d["Department"]</span></div>
                                    <span class="badge badge-light-primary fs-7 fw-bold text-nowrap"><bdi class="hp-num">@d["Appointments"]</bdi>&nbsp;@T["appts"]</span>
                                </div>
                            </div>
                            if (i < m.Doctors.Count - 1) { <div class="separator separator-dashed my-3"></div> }
                        }
                    </div>
                </div>
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Theatre today"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@Day(m.Today)</span></h3>
                        <div class="card-toolbar gap-2"><a href="@Report(HospitalReportCodes.Theatre, m.Today)" class="btn btn-sm btn-light">@T["hd:report"]</a><a href="@Url.Action("Theatre", "Hospital")" class="btn btn-sm btn-light-primary">@T["hd:schedule"]</a></div>
                    </div>
                    <div class="card-body pt-2" data-hd-theatre>
                        @if (m.Theatre.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-bandage fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No operations today."]</div></div> }
                        @for (int i = 0; i < m.Theatre.Count; i++)
                        {
                            var s = m.Theatre[i];
                            <div class="d-flex flex-stack">
                                <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-info"><i class="ki-outline ki-bandage fs-3 text-info"></i></span></div>
                                <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                    <div class="me-3 min-w-0"><span class="text-gray-800 fw-bold fs-6 d-block text-truncate">@s["Procedure"]</span><span class="text-gray-500 fw-semibold fs-7 d-block"><bdi>@s["PatientName"]</bdi> · <bdi>@s["Room"]</bdi></span></div>
                                    <span class="badge badge-light-primary fs-7 fw-bold text-nowrap">@s["Status"]</span>
                                </div>
                            </div>
                            if (i < m.Theatre.Count - 1) { <div class="separator separator-dashed my-3"></div> }
                        }
                    </div>
                </div>
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Claims this month"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Target below 5%"]</span></h3>
                        <div class="card-toolbar"><a href="@Report(HospitalReportCodes.PayerPerformance, m.MonthStart, m.Today)" class="btn btn-sm btn-light">@T["hd:report"]</a></div>
                    </div>
                    <div class="card-body pt-2"><div class="row g-5" data-hd-claims>
                        <div class="col-6"><div class="border border-gray-300 border-dashed rounded py-3 px-4 h-100">
                            <div class="fs-2 fw-bold text-gray-900"><bdi class="hp-num" dir="ltr">@N(claimed)</bdi></div><div class="fw-semibold fs-7 text-gray-500">@T["hd:submitted"]</div></div></div>
                        <div class="col-6"><div class="border border-gray-300 border-dashed rounded py-3 px-4 h-100">
                            <div class="fs-2 fw-bold @(rejPct > 5 ? "text-danger" : "text-gray-900")"><bdi class="hp-num" dir="ltr">@(rejPct == null ? "—" : N(rejPct, "0.#") + "%")</bdi></div><div class="fw-semibold fs-7 text-gray-500">@T["Rejection rate"]</div>
                            @if (rejPct != null) {<div class="progress h-5px mt-3 bg-light-@(rejPct > 5 ? "danger" : "primary")"><div class="progress-bar bg-@(rejPct > 5 ? "danger" : "primary")" style="width:@(Math.Min(100, (int)(rejPct.Value * 10)))%"></div></div>}</div></div>
                    </div></div>
                </div>
            </div>
        </div>
    </div></div>
</div>
