@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalRadTemplatePage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H259 — radiology report templates: the sections of each template in Arabic and English and which are required.
    A study reported on a template is not signed while a required section is empty. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Report templates"].Value;
    string q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p) => Url.Action("RadTemplates", new { q, page = p })!;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Report templates"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Radiology")" class="text-muted text-hover-primary">@T["Radiology"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Report templates"]</li>
            </ul>
        </div>
        @if (Model.Ready)
        {
            <div class="d-flex gap-2">
                <a href="@Url.Action("RadPeerReview")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-people fs-4"></i>@T["Peer review"]</a>
                <button type="button" class="btn btn-sm btn-light-primary" data-rt-seed><i class="ki-outline ki-book-open fs-4"></i>@T["Add the standard templates"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-rt-new><i class="ki-outline ki-plus fs-4"></i>@T["New template"]</button>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalRadReportingService.NoTables]</div></div>
        }
        <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T["The radiologist applies a template while writing the report; the report cannot be signed while a required section is empty."]</div></div>
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Templates"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Per modality, or for every study"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("RadTemplates")">
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-225px ps-12" placeholder="@T["Search a code or name"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Rows.Count == 0)
                {
                    <div class="text-center py-15"><i class="ki-outline ki-document fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No template yet."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Template"]</th><th>@T["Modality"]</th><th class="min-w-300px">@T["Sections"]</th><th>@T["Status"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var t in Model.Rows)
                        {
                            var secs = HospitalRadReportingRules.Parse(t.Sections);
                            var json = System.Text.Json.JsonSerializer.Serialize(new { id = t.ID, code = t.Code, name = t.Name, nameEn = t.NameEn, modality = t.Modality ?? "", active = t.Active, sections = secs.Select(s => new { heading = s.Heading, headingEn = s.HeadingEn, required = s.Required }) });
                            <tr>
                                <td><div class="fw-bold text-gray-900">@DisplayName.Of(t.Name, t.NameEn)</div><div class="text-muted fs-8 hp-num" dir="ltr">@t.Code</div></td>
                                <td><span class="badge badge-light-primary fs-8">@(t.Modality == null ? T["Every study"].Value : T["mod:" + t.Modality].Value)</span></td>
                                <td><div class="d-flex flex-wrap gap-1">@foreach (var s in secs) {<span class="badge @(s.Required ? "badge-light-primary" : "badge-light") fs-8">@DisplayName.Of(s.Heading, s.HeadingEn)@(s.Required ? " *" : "")</span>}</div></td>
                                <td><span class="badge badge-light-@(t.Active ? "primary" : "danger") fs-8">@(t.Active ? T["Active"] : T["Inactive"])</span></td>
                                <td class="text-end"><button type="button" class="btn btn-sm btn-icon btn-light-primary" title="@T["Edit"]" data-bs-toggle="tooltip" data-rt-edit="@json"><i class="ki-outline ki-pencil fs-4"></i></button></td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="rtModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-750px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Report template"]</h1><div class="text-muted fw-semibold fs-6">@T["The sections are written into the report in this order"]</div></div>
        <div class="row g-5 mb-6">
            <div class="col-md-3"><label class="required fs-6 fw-semibold mb-2">@T["Code"]</label><input class="form-control form-control-solid" maxlength="20" dir="ltr" data-rt="code" /></div>
            <div class="col-md-5"><label class="required fs-6 fw-semibold mb-2">@T["Name"] — @T["Arabic"]</label><input class="form-control form-control-solid" maxlength="100" dir="rtl" data-rt="name" /></div>
            <div class="col-md-4"><label class="required fs-6 fw-semibold mb-2">@T["Name"] — @T["English"]</label><input class="form-control form-control-solid" maxlength="100" dir="ltr" data-rt="nameEn" /></div>
            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Modality"]</label>
                <select class="form-select form-select-solid" data-rt="modality"><option value="">@T["Every study"]</option>@foreach (var m in HospitalRadModality.All) {<option value="@m">@T["mod:" + m]</option>}</select></div>
            <div class="col-md-6 d-flex align-items-end"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-rt="active" checked /><span class="form-check-label fw-semibold text-gray-700">@T["Active"]</span></label></div>
        </div>
        <div class="d-flex flex-stack mb-3"><span class="fs-6 fw-bold text-gray-800">@T["Sections"]</span><button type="button" class="btn btn-sm btn-light-primary" data-rt-add><i class="ki-outline ki-plus fs-4"></i>@T["Add a section"]</button></div>
        <div data-rt-rows></div>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-rt-save>@T["Save"]</button></div>
    </div>
</div></div></div>
<template id="rtRow"><div class="row g-3 align-items-center mb-3" data-rt-row>
    <div class="col-5"><input class="form-control form-control-solid form-control-sm" maxlength="60" dir="rtl" placeholder="@T["Heading"] — @T["Arabic"]" data-s="heading" /></div>
    <div class="col-4"><input class="form-control form-control-solid form-control-sm" maxlength="60" dir="ltr" placeholder="@T["Heading"] — @T["English"]" data-s="headingEn" /></div>
    <div class="col-2"><label class="form-check form-check-sm form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-s="required" /><span class="form-check-label fs-8">@T["Required"]</span></label></div>
    <div class="col-1 text-end"><button type="button" class="btn btn-sm btn-icon btn-light-danger" data-rt-del title="@T["Remove"]"><i class="ki-outline ki-trash fs-5"></i></button></div>
</div></template>
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Radiology/Templates"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), added: @Json.Serialize(T["Templates added: {0}"].Value) };
            var m = document.getElementById('rtModal'), rows = m.querySelector('[data-rt-rows]'), editId = null;
            function post(u, b) { return fetch(root + u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function f(k) { return m.querySelector('[data-rt="' + k + '"]'); }
            function addRow(s) {
                var n = document.getElementById('rtRow').content.firstElementChild.cloneNode(true);
                n.querySelector('[data-s=heading]').value = (s && s.heading) || ''; n.querySelector('[data-s=headingEn]').value = (s && s.headingEn) || ''; n.querySelector('[data-s=required]').checked = !!(s && s.required);
                rows.appendChild(n);
            }
            function open(d) {
                editId = d ? d.id : null; f('code').value = d ? d.code : ''; f('name').value = d ? d.name : ''; f('nameEn').value = d ? d.nameEn : ''; f('modality').value = d ? d.modality : ''; f('active').checked = d ? d.active : true;
                rows.innerHTML = ''; (d ? d.sections : [{ required: true }, {}]).forEach(addRow);
                bootstrap.Modal.getOrCreateInstance(m).show();
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-rt-new],[data-rt-edit],[data-rt-add],[data-rt-del],[data-rt-save],[data-rt-seed]'); if (!t) return;
                if (t.hasAttribute('data-rt-new')) { open(null); return; }
                if (t.hasAttribute('data-rt-edit')) { open(JSON.parse(t.getAttribute('data-rt-edit'))); return; }
                if (t.hasAttribute('data-rt-add')) { addRow({}); return; }
                if (t.hasAttribute('data-rt-del')) { t.closest('[data-rt-row]').remove(); return; }
                if (t.hasAttribute('data-rt-seed')) { t.disabled = true; post('/SeedStandard').then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.added.replace('{0}', res.id)); setTimeout(function () { location.reload(); }, 700); }); return; }
                var body = { id: editId, code: f('code').value, name: f('name').value, nameEn: f('nameEn').value, modality: f('modality').value || null, active: f('active').checked,
                    sections: Array.prototype.map.call(rows.querySelectorAll('[data-rt-row]'), function (r) { return { heading: r.querySelector('[data-s=heading]').value, headingEn: r.querySelector('[data-s=headingEn]').value, required: r.querySelector('[data-s=required]').checked }; }) };
                t.disabled = true; post('', body).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
            });
        })();
    </script>
}
