@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalPractitionerView?
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    bool isNew = Model == null;
    var p = Model?.Row ?? new HospitalPractitioner { WorkDays = "0,1,2,3,4", Privileges = "opd" };
    var title = isNew ? T["Add doctor"].Value : T["Edit doctor"].Value;
    ViewData["Title"] = title;
    var departments = (ViewBag.Departments as IReadOnlyList<HospitalDepartment>) ?? Array.Empty<HospitalDepartment>();
    var rooms = (ViewBag.ClinicRooms as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    var employees = (ViewBag.Employees as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    var feeServices = (ViewBag.FeeServices as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    var days = p.Days().ToHashSet();
    var privileges = (p.Privileges ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
    var week = new[] { DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@title</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Practitioners")" class="text-muted text-hover-primary">@T["Practitioners"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@title</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@(isNew ? Url.Action("Practitioners") : Url.Action("Practitioner", new { id = p.ID }))" class="btn btn-sm btn-light">@T["Cancel"]</a>
            <button type="button" class="btn btn-sm btn-primary" id="docSave"><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <form id="docForm" autocomplete="off">
            <input type="hidden" name="id" value="@(isNew ? "" : p.ID.ToString())" />
            <div class="row g-5 g-xl-8">
                <div class="col-xl-8">
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Doctor details"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Link the employee to show their photo and pay them through payroll"]</span></h3></div>
                        <div class="card-body pt-2"><div class="row g-6">
                            <div class="col-md-12"><label class="fs-6 fw-semibold mb-2">@T["Employee"]</label>
                                <select name="employeeId" class="form-select form-select-solid" data-placeholder="@T["Not an employee (visiting)"]" data-control="select2">
                                    <option value="">@T["Not an employee (visiting)"]</option>
                                    @foreach (var e in employees) { <option value="@e.Id" selected="@(p.EmployeeId == e.Id)" data-ar="@e.Name" data-en="@e.NameEn">@DisplayName.Of(e.Name, e.NameEn)</option> }
                                </select></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2 required">@T["Name (Arabic)"]</label><input name="name" value="@p.Name" class="form-control form-control-solid" dir="rtl" maxlength="200" /></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2 required">@T["Name (English)"]</label><input name="nameEn" value="@p.NameEn" class="form-control form-control-solid" dir="ltr" maxlength="200" /></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Title (Arabic)"]</label><input name="title" value="@p.Title" class="form-control form-control-solid" dir="rtl" maxlength="200" placeholder="استشاري الباطنة" /></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Title (English)"]</label><input name="titleEn" value="@p.TitleEn" class="form-control form-control-solid" dir="ltr" maxlength="200" placeholder="Consultant, internal medicine" /></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Department"]</label>
                                <select name="departmentId" class="form-select form-select-solid" data-control="select2"><option value="">—</option>
                                    @foreach (var d in departments) { <option value="@d.ID" selected="@(d.ID == p.DepartmentId)">@DisplayName.Of(d.Name, d.NameEn)</option> }
                                </select></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Clinic room"]</label>
                                <select name="clinicRoomId" class="form-select form-select-solid" data-control="select2"><option value="">—</option>
                                    @foreach (var r in rooms) { <option value="@r.Id" selected="@(p.ClinicRoomId == r.Id)">@T["Room"] @r.Label@(string.IsNullOrEmpty(r.Name) ? "" : " · " + DisplayName.Of(r.Name, r.NameEn))</option> }
                                </select></div>
                            <div class="col-md-12"><label class="fs-6 fw-semibold mb-2">@T["Billed as"]</label>
                                <select name="consultationServiceId" class="form-select form-select-solid" data-control="select2"><option value="">@T["The department's consultation"]</option>
                                    @foreach (var s in feeServices) { <option value="@s.Id" selected="@(p.ConsultationServiceId == s.Id)">@s.Label · @DisplayName.Of(s.Name, s.NameEn)</option> }
                                </select></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2 required">@T["Engagement"]</label>
                                <select name="engagement" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                                    @foreach (var e in HospitalEngagements.All) { <option value="@e" selected="@(e == p.Engagement)">@T["eng:" + e]</option> }
                                </select></div>
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2 required">@T["Paid through"]</label>
                                <select name="payChannel" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                                    @foreach (var c in HospitalPayChannels.All) { <option value="@c" selected="@(c == p.PayChannel)">@T["pay:" + c]</option> }
                                </select></div>
                        </div></div>
                    </div>

                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Clinic schedule"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7">@T["The appointment book offers exactly these days and slots"]</span></h3></div>
                        <div class="card-body pt-2">
                            @* H128: the work days as the theme's dashed toggle buttons (demo39 utilities/modals/forms) — still checkboxes named workDays *@
                            <div class="d-flex flex-wrap gap-2 mb-7">
                                @foreach (var d in week)
                                {
                                    <input class="btn-check" type="checkbox" name="workDays" id="wd@((int)d)" value="@((int)d)" @(days.Contains(d) ? "checked" : "") />
                                    <label class="btn btn-sm btn-outline btn-outline-dashed btn-active-light-primary fw-semibold px-5" for="wd@((int)d)">@T["day:" + d]</label>
                                }
                            </div>
                            <div class="row g-6">
                                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2" for="sessionStart">@T["From"]</label>
                                    <div class="position-relative d-flex align-items-center"><i class="ki-outline ki-time fs-2 position-absolute mx-4"></i><input name="sessionStart" id="sessionStart" type="text" value="@HospitalUi.Clock(p.SessionStartMinute)" class="form-control form-control-solid ps-12 hp-num" dir="ltr" data-hp-time /></div></div>
                                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2" for="sessionEnd">@T["To"]</label>
                                    <div class="position-relative d-flex align-items-center"><i class="ki-outline ki-time fs-2 position-absolute mx-4"></i><input name="sessionEnd" id="sessionEnd" type="text" value="@HospitalUi.Clock(p.SessionEndMinute)" class="form-control form-control-solid ps-12 hp-num" dir="ltr" data-hp-time /></div></div>
                                <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@T["Minutes per patient"]</label><input name="slotMinutes" type="number" min="5" max="120" step="5" value="@p.SlotMinutes" class="form-control form-control-solid hp-num" dir="ltr" /></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Professional licence"]</span></h3></div>
                        <div class="card-body pt-2"><div class="row g-5">
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Number"]</label><input name="licenseNumber" value="@p.LicenseNumber" class="form-control form-control-solid hp-num" dir="ltr" maxlength="60" /></div>
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Expiry"]</label><input name="licenseExpiry" type="date" value="@p.LicenseExpiry?.ToString("yyyy-MM-dd")" class="form-control form-control-solid" /></div>
                            <div class="col-12 text-muted fs-8">@T["On expiry, new bookings for this doctor stop automatically until the renewed licence is entered."]</div>
                        </div></div>
                    </div>
                    <div class="card card-flush">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Clinical privileges"]</span></h3></div>
                        <div class="card-body pt-2">
                            @foreach (var k in HospitalPrivileges.All)
                            {
                                <label class="d-flex align-items-center py-3 border-bottom border-gray-200 border-bottom-dashed form-check form-check-custom form-check-solid m-0">
                                    <input class="form-check-input me-3" type="checkbox" name="privileges" value="@k" @(privileges.Contains(k) ? "checked" : "") /><span class="fw-semibold text-gray-800">@T["priv:" + k]</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('docForm');
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            function val(n) { return (form.elements[n] ? form.elements[n].value : '').trim(); }
            function minutes(v) { var m = /^(\d{1,2}):(\d{2})/.exec(v || ''); return m ? (+m[1]) * 60 + (+m[2]) : null; }
            // H128: the session's clock is the theme's time-only picker (never the browser's native time popup); the value stays "HH:mm"
            if (window.flatpickr) form.querySelectorAll('[data-hp-time]').forEach(function (el) { flatpickr(el, { enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, allowInput: true, disableMobile: true, defaultDate: el.value || null }); });
            function checked(n) { return [].slice.call(form.querySelectorAll('[name="' + n + '"]:checked')).map(function (c) { return c.value; }); }
            // Choosing the employee fills both names when they are still empty.
            CB.onSelectChange(form.elements.employeeId, function () {
                var o = form.elements.employeeId.selectedOptions[0]; if (!o || !o.value) return;
                if (!val('name')) form.elements.name.value = o.getAttribute('data-ar') || '';
                if (!val('nameEn')) form.elements.nameEn.value = o.getAttribute('data-en') || '';
            });
            document.getElementById('docSave').addEventListener('click', function () {
                var b = this; b.disabled = true;
                var payload = {
                    id: val('id') ? +val('id') : null, employeeId: val('employeeId') ? +val('employeeId') : null,
                    name: val('name'), nameEn: val('nameEn'), title: val('title') || null, titleEn: val('titleEn') || null,
                    departmentId: val('departmentId') ? +val('departmentId') : null, clinicRoomId: val('clinicRoomId') ? +val('clinicRoomId') : null,
                    engagement: val('engagement'), payChannel: val('payChannel'), consultationServiceId: val('consultationServiceId') ? +val('consultationServiceId') : null,
                    licenseNumber: val('licenseNumber') || null, licenseExpiry: val('licenseExpiry') || null,
                    privileges: checked('privileges'), workDays: checked('workDays').map(Number),
                    sessionStartMinute: minutes(val('sessionStart')), sessionEndMinute: minutes(val('sessionEnd')), slotMinutes: +val('slotMinutes') || 15
                };
                fetch(@Json.Serialize(Url.Action("SavePractitioner")), { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(payload) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) {
                        if (!res.ok) { b.disabled = false; if (window.toastr) toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); return; }
                        var fileUrl = @Json.Serialize(Url.Action("Practitioner", new { id = 0 }));
                        location.href = fileUrl.replace(/0$/, res.id);
                    });
            });
        })();
    </script>
}
