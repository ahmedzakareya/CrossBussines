@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPortalAccountRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H47 — patient portal accounts, as the approved prototype draws it (#/portal-accounts): four figures, "staff never
    see or set a password", the accounts (patient, user name and email, family, last sign-in, state, actions), and
    what the patient receives and how the account is protected. Every change swaps in place, after a confirmation.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Patient portal accounts"].Value;
    bool ready = ViewBag.Ready == true;
    var rows = Model ?? Array.Empty<HospitalPortalAccountRow>();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var now = DateTime.UtcNow;
    string Local(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("yyyy-MM-dd HH:mm", inv);
    var monthStart = new DateTime(now.Year, now.Month, 1);
    string Badge(string st) => st switch
    {
        HospitalPortalAccountState.Active => "badge-light-success", HospitalPortalAccountState.Invited => "badge-light-primary", HospitalPortalAccountState.Unverified => "badge-light-info",
        HospitalPortalAccountState.Locked => "badge-light-danger", HospitalPortalAccountState.InviteExpired => "badge-light-danger", HospitalPortalAccountState.NoSignIn => "badge-light-secondary", _ => "badge-light-dark",
    };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Patient portal accounts"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Patient portal"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Accounts"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 d-print-none">
            <a href="@Url.Action("Login", "PatientPortal")" target="_blank" class="btn btn-sm btn-light"><i class="ki-outline ki-exit-up fs-4"></i>@T["Patient sign-in page"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><div class="fs-6 text-gray-700">@T[HospitalPortalAccountsAdminService.NoTables]</div></div>
            </div>
        }
        <div class="row g-5 g-xl-8 mb-5">
            @* H128: stat tiles (demo39 dashboards/logistics) *@
            @foreach (var s in new[] {
                (T["Portal accounts"].Value, rows.Count, "", "ki-profile-circle", "primary"),
                (T["Signed in this month"].Value, rows.Count(r => r.Account.LastSeenAt >= monthStart), "", "ki-entrance-left", "success"),
                (T["Invitations waiting"].Value, rows.Count(r => r.State == HospitalPortalAccountState.Invited), string.Format(T["Link valid {0} hours"].Value, HospitalPortalPasswordRules.InviteHours), "ki-send", "info"),
                (T["Locked accounts"].Value, rows.Count(r => r.State == HospitalPortalAccountState.Locked), string.Format(T["Unlock by themselves after {0} minutes"].Value, HospitalPortalPasswordRules.LockMinutes), "ki-lock-2", "danger") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold @(s.Item5 == "danger" && s.Item2 > 0 ? "text-danger" : "text-gray-900") me-2 lh-1 ls-n2"><bdi class="hp-num" dir="ltr">@s.Item2</bdi></span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item5"><i class="ki-outline @s.Item4 fs-2x text-@s.Item5"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500">@if (s.Item3 != "") {<div class="bullet w-8px h-6px rounded-2 bg-@s.Item5 me-3"></div><span class="hp-num">@s.Item3</span>} else {<span>&nbsp;</span>}</div>
                    </div>
                </div></div>
            }
        </div>

        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-shield-tick fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="mb-3 mb-md-0 fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Staff never see or set a password"]</h4>
                    <div class="fs-6 text-gray-700">@T["Staff open the account from the patient's file; the patient gets an email invitation with a link to set their own password. If they forget it they ask for a new link on the sign-in page, or staff send one from here. Every message is by email only."]</div>
                </div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0">@T["Email only"]</span>
            </div>
        </div>

        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Accounts"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7"><bdi class="hp-num" dir="ltr">@rows.Count</bdi></span></h3>
                <div class="card-toolbar gap-2">
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                        <input type="text" class="form-control form-control-solid form-control-sm w-225px ps-12" placeholder="@T["Search..."]" data-pa-search autocomplete="off" /></div>
                    @if (ready) { <button type="button" class="btn btn-sm btn-primary" data-pa-new><i class="ki-outline ki-plus fs-4"></i>@T["Open an account"]</button> }
                </div>
            </div>
            <div class="card-body pt-2">
                @if (rows.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-profile-circle fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No portal account yet."]</div></div> }
                else
                {
                    @* H128: table widget (demo39 widgets/tables) *@
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["User name & email"]</th><th>@T["Family"]</th><th>@T["Last sign-in"]</th><th>@T["State"]</th><th class="w-50px pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in rows)
                            {
                                var a = r.Account;
                                <tr data-pa-row>
                                    <td class="ps-4"><div class="d-flex align-items-center">
                                        <div class="symbol symbol-45px symbol-circle me-3 flex-shrink-0">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(a.NameEn ?? a.Name)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(a.NameEn ?? a.Name)</span>}</div>
                                        <div class="d-flex flex-column">@if (a.PatientId is int pid) {<a href="@Url.Action("Patient", new { id = pid })" class="text-gray-900 fw-bold text-hover-primary fs-6"><bdi>@DisplayName.Of(a.Name, a.NameEn ?? a.Name)</bdi></a>} else {<span class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(a.Name, a.NameEn ?? a.Name)</bdi></span>}
                                            @if (r.Mrn != null) {<bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi>}</div>
                                    </div></td>
                                    <td><div class="text-gray-800 fw-bold fs-6 hp-num" dir="ltr">@(r.UserName ?? "—")</div><div class="text-muted fw-semibold fs-7 hp-num" dir="ltr">@(a.Email ?? T["No email"].Value)</div></td>
                                    <td>@if (r.Family.Count > 0)
                                        {
                                            <div class="symbol-group symbol-hover">
                                                @foreach (var f in r.Family)
                                                {
                                                    <div class="symbol symbol-30px symbol-circle" title="@DisplayName.Of(f.Name, f.NameEn) · @T["rel:" + f.Relation]">@if (f.Photo != null) {<img src="@f.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(f.NameEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(f.NameEn)</span>}</div>
                                                }
                                            </div>
                                        }
                                        else { <span class="text-muted fs-8">—</span> }</td>
                                    <td>@if (a.LastSeenAt is DateTime seen) {<span class="text-gray-800 fw-bold hp-num" dir="ltr">@Local(seen)</span>} else {<span class="text-muted fw-semibold fs-7">@T["Never signed in"]</span>}</td>
                                    <td><span class="badge @Badge(r.State) fs-7 fw-bold">@T["pa:" + r.State]</span>
                                        @if (r.LockedUntil is DateTime lu) {<div class="text-muted fs-9 mt-1">@T["until"] <span class="hp-num" dir="ltr">@Local(lu)</span></div>}
                                        @if (r.InviteSentAt is DateTime sent) {<div class="text-muted fs-9 mt-1">@T["Sent"] <span class="hp-num" dir="ltr">@Local(sent)</span></div>}</td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end"><i class="ki-outline ki-dots-horizontal fs-3"></i></button>
                                        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-700 menu-state-bg-light-primary fw-semibold fs-7 w-250px py-3" data-kt-menu="true">
                                            @{
                                                var items = new List<(string Key, string Icon, string Text, bool Danger)>();
                                                bool off = r.State == HospitalPortalAccountState.Disabled;
                                                if (!off) items.Add(("email", "ki-sms", T["The patient's email"].Value, false));
                                                if (!off && r.State is HospitalPortalAccountState.NoSignIn or HospitalPortalAccountState.Invited or HospitalPortalAccountState.InviteExpired)
                                                    items.Add(("invite", "ki-send", r.State == HospitalPortalAccountState.NoSignIn ? T["Send the invitation"].Value : T["Resend the invitation"].Value, false));
                                                if (!off && r.State is HospitalPortalAccountState.Active or HospitalPortalAccountState.Unverified or HospitalPortalAccountState.Locked) items.Add(("reset", "ki-key", T["Send a password-reset link"].Value, false));
                                                if (r.State == HospitalPortalAccountState.Locked) items.Add(("unlock", "ki-lock-2", T["Unlock"].Value, false));
                                                items.Add(off ? ("enable", "ki-check-circle", T["Re-enable the account"].Value, false) : ("disable", "ki-cross-circle", T["Disable the account"].Value, true));
                                            }
                                            @foreach (var it in items)
                                            {
                                                <div class="menu-item px-3"><a href="#" class="menu-link px-3 @(it.Danger ? "text-danger" : "")" data-pa-act="@it.Key" data-id="@a.ID" data-name="@DisplayName.Of(a.Name, a.NameEn ?? a.Name)" data-email="@a.Email" data-user="@r.UserName"><i class="ki-outline @it.Icon fs-5 me-2"></i>@it.Text</a></div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        <div class="row g-5">
            @* H128: list widgets (demo39 dashboards/logistics) *@
            <div class="col-xl-6"><div class="card card-flush h-100">
                <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["What the patient receives"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Email only"]</span></h3></div>
                <div class="card-body pt-2">
                    @foreach (var (title, text) in new[] {
                        (T["Account invitation"].Value, string.Format(T["A link to set the password, valid {0} hours, single use"].Value, HospitalPortalPasswordRules.InviteHours)),
                        (T["Forgot-password link"].Value, string.Format(T["Valid {0} minutes, single use; signs out every open session once changed"].Value, HospitalPortalPasswordRules.LinkMinutes)),
                        (T["Password-changed notice"].Value, T["Sent after every change; if it wasn't them, they call the hospital"].Value) })
                    {
                        <div class="d-flex align-items-center py-3 border-bottom border-gray-300 border-bottom-dashed">
                            <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-sms fs-3 text-primary"></i></span></div>
                            <div><span class="text-gray-800 fw-bold fs-6 d-block">@title</span><span class="text-gray-500 fw-semibold fs-7 d-block">@text</span></div></div>
                    }
                </div>
            </div></div>
            <div class="col-xl-6"><div class="card card-flush h-100">
                <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Account protection"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Staff never see or set a password"]</span></h3></div>
                <div class="card-body pt-2">
                    @foreach (var text in new[] {
                        string.Format(T["{0} wrong attempts lock the account for {1} minutes"].Value, HospitalPortalPasswordRules.MaxFailures, HospitalPortalPasswordRules.LockMinutes),
                        T["One message for every failed sign-in — it never tells whether the name exists"].Value,
                        T["\"Forgot password\" answers the same whether the account exists or not"].Value,
                        T["At least 6 characters with a capital letter, a small letter, a digit and a symbol"].Value })
                    {
                        <div class="d-flex align-items-center py-3 border-bottom border-gray-300 border-bottom-dashed">
                            <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-success"><i class="ki-outline ki-shield-tick fs-3 text-success"></i></span></div>
                            <span class="text-gray-800 fw-bold fs-6">@text</span></div>
                    }
                </div>
            </div></div>
        </div>
    </div></div>
</div>

@if (ready)
{
    <div class="modal fade" id="paNewModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-600px"><div class="modal-content">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Open a portal account"]</h1><div class="text-gray-500 fw-semibold fs-5">@T["Staff never see or set a password"]</div></div>
            <div class="row g-5">
            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Patient"]</label><select class="form-select form-select-solid" data-n="patientId" data-pa-patient data-placeholder="@T["Search..."]"></select></div>
            <div class="col-md-7"><label class="fs-6 fw-semibold mb-2 required">@T["Email"]</label><input type="email" class="form-control form-control-solid" dir="ltr" maxlength="256" data-n="email" /></div>
            <div class="col-md-5"><label class="fs-6 fw-semibold mb-2 required">@T["User name"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="40" value="pt." data-n="userName" /></div>
            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Family members this account books for"]</label>
                <div class="d-flex gap-2"><div class="flex-grow-1"><select class="form-select form-select-solid" data-pa-family data-placeholder="@T["Search..."]"></select></div>
                    <div class="w-150px flex-shrink-0"><select class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-dropdown-parent="#paNewModal" data-pa-relation>@foreach (var rel in HospitalPortalRelations.All) { <option value="@rel">@T["rel:" + rel]</option> }</select></div>
                    <button type="button" class="btn btn-light-primary" data-pa-family-add><i class="ki-outline ki-plus fs-4"></i></button></div>
                <div class="mt-3" data-pa-family-list></div></div>
            <div class="col-12"><div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5"><i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="fs-6 text-gray-700 fw-semibold">@string.Format(T["The patient gets an email invitation with a link to set their password (valid {0} hours). No password is typed here."].Value, HospitalPortalPasswordRules.InviteHours)</div></div></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-pa-open><i class="ki-outline ki-send fs-4"></i>@T["Open & send the invitation"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/PortalAccounts"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), sent: @Json.Serialize(T["The email was sent"].Value),
                open: @Json.Serialize(T["Open a portal account for {0} and email the invitation to {1}?"].Value), email: @Json.Serialize(T["The email address the portal's messages go to"].Value),
                ask: { invite: @Json.Serialize(T["Email {0} an invitation to set the password? An older link stops working."].Value), reset: @Json.Serialize(T["Email {0} a password-reset link?"].Value),
                    unlock: @Json.Serialize(T["Unlock {0}'s account now?"].Value), disable: @Json.Serialize(T["Disable {0}'s account? The patient cannot sign in until it is re-enabled."].Value),
                    enable: @Json.Serialize(T["Re-enable {0}'s account?"].Value) }, userName: @Json.Serialize(T["The user name the patient will sign in with"].Value),
                picker: @Json.Serialize(Url.Content("~/Hospital/PortalAccounts/Patients")) };
            var family = [];
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function fmt(t) { var a = arguments; return t.replace(/\{(\d)\}/g, function (_, i) { return a[+i + 1]; }); }
            function post(url, body) {
                return fetch(root + url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped; the row menus wired again.
            function swap() {
                return fetch(root, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                    if (window.KTMenu) KTMenu.createInstances();
                });
            }
            function picker(el) {
                if (!el || !window.jQuery) return;
                jQuery(el).select2({ dropdownParent: jQuery('#paNewModal'), placeholder: el.getAttribute('data-placeholder'), allowClear: true,
                    ajax: { url: W.picker, delay: 250, data: function (p) { return { q: p.term || '' }; }, processResults: function (r) { return { results: r.results || [] }; } } });
            }
            var nm = document.getElementById('paNewModal');
            if (nm) { picker(nm.querySelector('[data-pa-patient]')); picker(nm.querySelector('[data-pa-family]')); }
            function drawFamily() {
                nm.querySelector('[data-pa-family-list]').innerHTML = family.map(function (f, i) { return '<span class="badge badge-light-primary fs-7 me-2 mb-2">' + f.text.replace(/</g, '&lt;') + ' · ' + f.relText + ' <a href="#" class="ms-2" data-pa-family-del="' + i + '">×</a></span>'; }).join('');
            }
            document.addEventListener('input', function (e) {
                var s = e.target.closest('[data-pa-search]'); if (!s) return;
                var q = s.value.trim().toLowerCase();
                document.querySelectorAll('[data-pa-row]').forEach(function (tr) { tr.style.display = !q || tr.innerText.toLowerCase().indexOf(q) >= 0 ? '' : 'none'; });
            });
            document.addEventListener('click', function (e) {
                var t;
                if (e.target.closest('[data-pa-new]')) { family = []; drawFamily(); bootstrap.Modal.getOrCreateInstance(nm).show(); return; }
                if (e.target.closest('[data-pa-family-add]')) {
                    var fs = jQuery(nm.querySelector('[data-pa-family]')).select2('data')[0], rel = nm.querySelector('[data-pa-relation]');
                    if (!fs || !fs.id) return;
                    family.push({ patientId: +fs.id, relation: rel.value, text: fs.text, relText: rel.options[rel.selectedIndex].text });
                    jQuery(nm.querySelector('[data-pa-family]')).val(null).trigger('change'); drawFamily(); return;
                }
                if ((t = e.target.closest('[data-pa-family-del]'))) { e.preventDefault(); family.splice(+t.getAttribute('data-pa-family-del'), 1); drawFamily(); return; }
                if ((t = e.target.closest('[data-pa-open]'))) {
                    var ps = jQuery(nm.querySelector('[data-pa-patient]')).select2('data')[0], v = function (k) { return nm.querySelector('[data-n=' + k + ']').value.trim(); };
                    if (!ps || !ps.id) { toast('error', W.failed); return; }
                    cbConfirm(fmt(W.open, ps.text, v('email'))).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post('/Open', { patientId: +ps.id, email: v('email'), userName: v('userName'), family: family.map(function (f) { return { patientId: f.patientId, relation: f.relation }; }) })
                            .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); swap(); return; } bootstrap.Modal.getOrCreateInstance(nm).hide(); toast('success', W.sent); swap(); });
                    });
                    return;
                }
                if (!(t = e.target.closest('[data-pa-act]'))) return;
                e.preventDefault();
                var act = t.getAttribute('data-pa-act'), id = t.getAttribute('data-id'), name = t.getAttribute('data-name');
                if (act === 'email') {
                    cbPrompt(W.email, { value: t.getAttribute('data-email') || '' }).then(function (val) { if (val == null) return; post('/' + id + '/Email', { email: val }).then(function (res) { if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); }); });
                    return;
                }
                if (act === 'invite' && !t.getAttribute('data-user')) {
                    cbPrompt(W.userName, { value: 'pt.' }).then(function (u) { if (!u) return; post('/' + id + '/Invite', { userName: u }).then(function (res) { if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.sent); swap(); }); });
                    return;
                }
                cbConfirm(fmt(W.ask[act], name), act === 'disable' ? { kind: 'danger' } : undefined).then(function (ok) {
                    if (!ok) return;
                    post('/' + id + '/' + act.charAt(0).toUpperCase() + act.slice(1), {}).then(function (res) {
                        if (!res.ok) { toast('error', res.error || W.failed); return; }
                        toast('success', act === 'invite' || act === 'reset' ? W.sent : W.saved); swap();
                    });
                });
            });
        })();
    </script>
}
