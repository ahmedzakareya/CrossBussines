@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPreauthRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — approvals and claims, composed from the theme (demo39): stat tiles (dashboards/logistics), a tabbed card of
    table widgets (widgets/tables) with the patient's photo first, icon actions, and the form modal
    (utilities/modals/forms/new-target). The batch month is a month field the theme's month picker takes over (crossbuy-monthpicker).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Approvals & claims"].Value;
    var stats = (HospitalInsuranceStats)ViewBag.Stats;
    var batches = (ViewBag.Batches as List<HospitalBatchRow>) ?? new();
    var rejections = (ViewBag.Rejections as IReadOnlyList<HospitalRejectionRow>) ?? Array.Empty<HospitalRejectionRow>();
    var payers = (ViewBag.Payers as List<HospitalPayerRow>) ?? new();
    string tab = (ViewBag.Tab as string) ?? "pa";
    string? cur = ViewBag.Currency as string;
    bool canBill = ViewBag.CanBill == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Money(decimal v) => v.ToString("N3", inv);
    string PaBadge(string s) => s switch { HospitalPreauthStatus.Approved => "primary", HospitalPreauthStatus.Rejected => "danger", _ => "primary" };
    string BatchBadge(string s) => s switch { HospitalClaimBatchStatus.Paid => "primary", HospitalClaimBatchStatus.Partial => "info", HospitalClaimBatchStatus.Rejected => "danger", HospitalClaimBatchStatus.Submitted => "primary", _ => "secondary" };
    // the person, not a glyph: the patient's photo, or their initials
    string Avatar(string? photo, string nameEn, int px) => photo != null
        ? $"<div class=\"symbol symbol-{px}px symbol-circle flex-shrink-0 me-3\"><img src=\"{photo}\" alt=\"\" style=\"object-fit:cover\" data-initials=\"{HospitalUi.Initials(nameEn)}\" /></div>"
        : $"<div class=\"symbol symbol-{px}px symbol-circle flex-shrink-0 me-3\"><span class=\"symbol-label fw-bold fs-7 hp-initials\">{HospitalUi.Initials(nameEn)}</span></div>";
    var claimMonth = DateTime.UtcNow.AddMonths(-1).ToString("yyyy-MM", inv);
    var tiles = new[] {
        (Num: stats.PendingPreauths.ToString(), Label: T["Approvals pending"].Value, Icon: "shield-tick", Tone: stats.PendingPreauths > 0 ? "primary" : "primary", Ltr: false),
        (Num: Money(stats.ClaimedThisMonth), Label: T["Claims this month"].Value, Icon: "send", Tone: "info", Ltr: true),
        (Num: stats.RejectionRate is decimal rr ? rr.ToString("0.0", inv) + "%" : "—", Label: T["Rejection rate"].Value, Icon: "cross-circle", Tone: stats.RejectionRate > 5 ? "danger" : "primary", Ltr: true),
        (Num: stats.DaysToCollect?.ToString() ?? "—", Label: T["Days to collect"].Value, Icon: "time", Tone: "primary", Ltr: false) };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Approvals & claims"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Insurance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Approvals & claims"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("FhirExchange")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-message-text-2 fs-4"></i>@T["Payer messages (FHIR)"]</a>
            <a href="@Url.Action("Drg")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-chart-simple fs-4"></i>@T["DRG coding"]</a>
            <a href="@Url.Action("Denials")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-cross-circle fs-4"></i>@T["Denial work-queue"]</a>
            <a href="@Url.Action("Payers")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Payers & contracts"]</a>
            @if (canBill)
            {
                <button type="button" class="btn btn-sm btn-light-primary" data-bs-toggle="modal" data-bs-target="#paModal"><i class="ki-outline ki-plus fs-4"></i>@T["New approval request"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#batchModal"><i class="ki-outline ki-send fs-4"></i>@T["Build month batch"]</button>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* stat tiles — demo39 dashboards/logistics *@
        <div class="row g-5 g-xl-8 mb-5">
            @for (int i = 0; i < tiles.Length; i++)
            {
                var s = tiles[i];
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold me-2 lh-1 ls-n2 hp-num @(i == 2 && s.Tone == "danger" ? "text-danger" : "text-gray-900")" dir="@(s.Ltr ? "ltr" : "auto")">@s.Num</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Label</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Tone"><i class="ki-outline ki-@s.Icon fs-2x text-@s.Tone"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500"><div class="bullet w-8px h-6px rounded-2 bg-@s.Tone me-3"></div>
                            @if (i == 0) { if (stats.OldestPendingMinutes is int om) {<span>@T["oldest"] <span class="hp-num">@om</span>&nbsp;@T["min"]</span>} else {<span>@T["None waiting"]</span>} }
                            else if (i == 1) {<span class="hp-num">@cur</span>}
                            else if (i == 2) {<span>@T["Target below 5%"]</span>}
                            else {<span>@T["from submission"]</span>}
                        </div>
                    </div>
                </div></div>
            }
        </div>

        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["E-claims channel: not connected"]</h4>
                <div class="fs-6 text-gray-700">@T["A batch is sent to the payer outside the system; record its submission and the payer's answer for each line here."]</div></div>
        </div>

        @* one card, three table widgets behind the theme's line tabs — demo39 widgets/tables *@
        <div class="card card-flush">
            <div class="card-header pt-5">
                <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
                    <li class="nav-item"><a class="nav-link text-active-primary pb-4 me-6 @(tab == "pa" ? "active" : "")" data-bs-toggle="tab" href="#ins_pa"><i class="ki-outline ki-shield-tick fs-3 me-2"></i>@T["Pre-authorisations"] <span class="badge badge-light-primary ms-2 hp-num">@Model.Count</span></a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary pb-4 me-6 @(tab == "cl" ? "active" : "")" data-bs-toggle="tab" href="#ins_cl"><i class="ki-outline ki-send fs-3 me-2"></i>@T["Claim batches"] <span class="badge badge-light-primary ms-2 hp-num">@batches.Count</span></a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary pb-4 @(tab == "rj" ? "active" : "")" data-bs-toggle="tab" href="#ins_rj"><i class="ki-outline ki-cross-circle fs-3 me-2"></i>@T["Rejections"] <span class="badge badge-light-danger ms-2 hp-num">@rejections.Count</span></a></li>
                </ul>
            </div>
            <div class="card-body pt-6"><div class="tab-content">
                <div class="tab-pane fade @(tab == "pa" ? "show active" : "")" id="ins_pa">
                    @if (Model.Count == 0)
                    {
                        <div class="text-center py-10"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 mb-4 d-block"></i>
                            <div class="fs-6 fw-bold text-gray-700">@T["No approval requests yet."]</div></div>
                    }
                    else
                    {
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light">
                                <th class="ps-4 rounded-start">@T["Request"]</th><th>@T["Patient"]</th><th>@T["Payer"]</th><th>@T["Service (catalogue)"]</th><th class="text-end">@T["Amount"]</th><th>@T["Status"]</th><th class="text-end pe-4 rounded-end"></th>
                            </tr></thead>
                            <tbody>
                                @foreach (var r in Model)
                                {
                                    var a = r.Preauth; var who = DisplayName.Of(r.PatientName, r.PatientNameEn);
                                    <tr>
                                        <td class="ps-4"><div class="d-flex flex-column">
                                            <bdi class="text-gray-900 fw-bold fs-6 hp-num" dir="ltr">@a.RequestNo</bdi>
                                            <span class="text-muted fw-semibold d-block fs-7 hp-num" data-fmt data-utc="@a.RequestedAt.ToString("o")">@a.RequestedAt.ToString("yyyy-MM-dd HH:mm")</span></div></td>
                                        <td><div class="d-flex align-items-center">@Html.Raw(Avatar(r.Photo, r.PatientNameEn, 35))
                                            <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = a.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6">@who</a><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi></div></div></td>
                                        <td class="text-gray-800 fw-bold fs-7">@DisplayName.Of(r.Payer, r.PayerEn)</td>
                                        <td><span class="text-gray-800 fw-bold fs-7 d-block">@DisplayName.Of(r.Service, r.ServiceEn)</span><bdi class="text-muted fw-semibold fs-7 hp-num" dir="ltr">@r.ServiceCode</bdi>
                                            @if (a.Reason != null) {<span class="text-danger fw-semibold d-block fs-7"><bdi>@a.Reason</bdi></span>}
                                            @if (a.ApprovalRef != null) {<span class="text-muted fw-semibold d-block fs-7">@T["Ref."] <bdi class="hp-num" dir="ltr">@a.ApprovalRef</bdi></span>}</td>
                                        <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@Money(a.Amount)</span></td>
                                        <td><span class="badge badge-light-@PaBadge(a.Status) fs-7 fw-bold">@T["pa:" + a.Status]</span></td>
                                        <td class="text-end pe-4 text-nowrap">
                                            @if (canBill && a.Status == HospitalPreauthStatus.Pending)
                                            {
                                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" title="@T["pa:Approved"]" data-bs-toggle="tooltip" data-decide="@a.ID" data-approve="1" data-ask="@string.Format(T["The payer approved {0} for {1}: enter its approval reference."].Value, DisplayName.Of(r.Service, r.ServiceEn), who)"><i class="ki-outline ki-check fs-3"></i></button>
                                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["pa:Rejected"]" data-bs-toggle="tooltip" data-decide="@a.ID" data-approve="0" data-ask="@string.Format(T["The payer rejected {0} for {1}: enter its reason."].Value, DisplayName.Of(r.Service, r.ServiceEn), who)"><i class="ki-outline ki-cross fs-3"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>

                <div class="tab-pane fade @(tab == "cl" ? "show active" : "")" id="ins_cl">
                    @if (batches.Count == 0)
                    {
                        <div class="text-center py-10"><i class="ki-outline ki-send fs-3x text-gray-300 mb-4 d-block"></i>
                            <div class="fs-6 fw-bold text-gray-700">@T["No claim batches yet. Build one from a month's closed bills."]</div></div>
                    }
                    else
                    {
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light">
                                <th class="ps-4 rounded-start">@T["Batch"]</th><th>@T["Payer"]</th><th class="text-end">@T["Claims"]</th><th class="text-end">@T["Amount"]</th><th class="text-end">@T["Accepted"]</th><th class="text-end">@T["Rejected"]</th><th class="pe-4 rounded-end">@T["Status"]</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var b in batches)
                                {
                                    <tr>
                                        <td class="ps-4"><div class="d-flex align-items-center">
                                            <div class="symbol symbol-45px me-4 flex-shrink-0"><span class="symbol-label bg-light-@BatchBadge(b.Batch.Status)"><i class="ki-outline ki-send fs-2 text-@(BatchBadge(b.Batch.Status) == "secondary" ? "gray-600" : BatchBadge(b.Batch.Status))"></i></span></div>
                                            <div class="d-flex flex-column"><a href="@Url.Action("ClaimBatch", new { id = b.Batch.ID })" class="text-gray-900 fw-bold text-hover-primary fs-6"><bdi class="hp-num" dir="ltr">@b.Batch.BatchNo</bdi></a>
                                                <span class="text-muted fw-semibold d-block fs-7">@T["Period"] <span class="hp-num">@b.Batch.Period</span></span></div>
                                        </div></td>
                                        <td class="text-gray-800 fw-bold fs-7">@DisplayName.Of(b.Payer, b.PayerEn)</td>
                                        <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@b.Claims</span></td>
                                        <td class="text-end text-nowrap"><span class="text-gray-900 fw-bold fs-6 hp-num">@Money(b.Amount)</span>@if (b.Currency != null) {<span class="badge badge-light-info fs-8 fw-bold ms-1 hp-num">@b.Currency</span>}</td>
                                        <td class="text-end">@if (b.Accepted > 0) {<span class="badge badge-light-primary fs-7 fw-bold hp-num">@Money(b.Accepted)</span>} else {<span class="text-muted">—</span>}</td>
                                        <td class="text-end">@if (b.Rejected > 0) {<span class="badge badge-light-danger fs-7 fw-bold hp-num">@Money(b.Rejected)</span>} else {<span class="text-muted">—</span>}</td>
                                        <td class="pe-4"><span class="badge badge-light-@BatchBadge(b.Batch.Status) fs-7 fw-bold">@T["cb:" + b.Batch.Status]</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>

                <div class="tab-pane fade @(tab == "rj" ? "show active" : "")" id="ins_rj">
                    @if (rejections.Count == 0)
                    {
                        <div class="text-center py-10"><i class="ki-outline ki-check-circle fs-3x text-gray-300 mb-4 d-block"></i>
                            <div class="fs-6 fw-bold text-gray-700">@T["No rejected lines waiting."]</div></div>
                    }
                    else
                    {
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light">
                                <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Batch"]</th><th>@T["Line"]</th><th>@T["Reason"]</th><th class="text-end">@T["Amount"]</th><th class="text-end pe-4 rounded-end"></th>
                            </tr></thead>
                            <tbody>
                                @foreach (var r in rejections)
                                {
                                    var l = r.Line;
                                    <tr>
                                        <td class="ps-4"><div class="d-flex align-items-center">@Html.Raw(Avatar(r.Photo, r.PatientNameEn, 35))<span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(r.PatientName, r.PatientNameEn)</span></div></td>
                                        <td><a href="@Url.Action("ClaimBatch", new { id = r.BatchId })" class="text-gray-800 fw-bold text-hover-primary fs-7"><bdi class="hp-num" dir="ltr">@r.BatchNo</bdi></a></td>
                                        <td><span class="text-gray-800 fw-bold fs-7 d-block">@DisplayName.Of(l.Description, l.DescriptionEn)</span><bdi class="text-muted fw-semibold fs-7 hp-num" dir="ltr">@l.Code</bdi></td>
                                        <td><span class="badge badge-light-danger fs-7 fw-bold hp-num me-1">@l.RejectCode</span><span class="text-gray-600 fw-semibold fs-7"><bdi>@l.RejectReason</bdi></span></td>
                                        <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@Money(l.InsurerAmount)</span></td>
                                        <td class="text-end pe-4">@if (canBill) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Resubmit"]" data-bs-toggle="tooltip" data-resubmit="@l.ID" data-ask="@string.Format(T["Resubmit {0} in this month's batch: write the justification the payer will read."].Value, DisplayName.Of(l.Description, l.DescriptionEn))"><i class="ki-outline ki-arrow-circle-right fs-3"></i></button>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div></div>
        </div>
    </div></div>
</div>

@if (canBill)
{
    @* the form modals — demo39 utilities/modals/forms/new-target *@
    <div class="modal fade" id="paModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["New approval request"]</h1>
                <div class="text-muted fw-semibold fs-5">@T["Pre-authorisations"]</div></div>
            <div class="d-flex flex-column mb-8 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Patient"]</label><select class="form-select form-select-solid" data-pa-patient data-no-select2 data-placeholder="@T["Search by name or MRN"]"></select>
                <div class="fs-7 mt-2" data-pa-cover></div></div>
            <div class="d-flex flex-column mb-8 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Service (catalogue)"]</label><select class="form-select form-select-solid" data-pa-service data-no-select2 data-placeholder="@T["Search by code or name"]"></select></div>
            <div class="d-flex flex-column fv-row"><label class="fs-6 fw-semibold mb-2">@T["Amount"] <span class="text-muted fs-8">@cur</span></label><input class="form-control form-control-solid hp-num" dir="ltr" data-pa-amount placeholder="@T["The service price"]" /></div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-pa-send>@T["Send request"]</button></div>
        </div>
    </div></div></div>

    <div class="modal fade" id="batchModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Build month batch"]</h1>
                <div class="text-muted fw-semibold fs-5">@T["The month's closed bills of the payer's covered patients, not claimed yet, are gathered into its draft batch."]</div></div>
            <div class="d-flex flex-column mb-8 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Payer"]</label>
                <select class="form-select form-select-solid" data-b-payer data-control="select2" data-hide-search="true" data-dropdown-parent="#batchModal">
                    @foreach (var p in payers) { <option value="@p.Payer.ID">@p.Payer.Code · @DisplayName.Of(p.Payer.Name, p.Payer.NameEn)</option> }
                </select></div>
            <div class="d-flex flex-column fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Month"]</label>
                <input type="month" class="form-control form-control-solid hp-num" data-b-period value="@claimMonth" /></div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-b-build @(payers.Count == 0 ? "disabled" : "")>@T["Build batch"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var isAr = document.documentElement.dir === 'rtl';
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), choose: @Json.Serialize(T["Choose the patient and the service"].Value),
                built: @Json.Serialize(T["Build the {0} batch of {1}? Each closed bill is split into the payer's share and the patient's."].Value) };
            var urls = { root: @Json.Serialize(Url.Action("Insurance")), patients: @Json.Serialize(Url.Action("SearchInsurancePatients")), services: @Json.Serialize(Url.Action("SearchServices")),
                eligibility: @Json.Serialize(Url.Action("Eligibility", new { patientId = 0 })), batch: @Json.Serialize(Url.Action("ClaimBatch", new { id = 0 })) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped (the open tab kept).
            function swap() {
                var active = document.querySelector('.nav-line-tabs .nav-link.active'), tab = active ? active.getAttribute('href').replace('#ins_', '') : 'pa';
                return fetch(urls.root + '?tab=' + tab, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    var f = doc.getElementById('kt_app_content'); if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function done(t, after) { return function (res) { if (t) t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); (after || swap)(res); }; }

            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-decide],[data-resubmit]'); if (!t) return;
                var approve = t.getAttribute('data-approve') === '1';
                cbPrompt(t.getAttribute('data-ask'), { kind: t.hasAttribute('data-resubmit') || approve ? 'primary' : 'danger', textarea: !approve }).then(function (v) {
                    if (v == null) return;
                    t.disabled = true;
                    if (t.hasAttribute('data-resubmit')) { post(urls.root + '/Line/' + t.getAttribute('data-resubmit') + '/Resubmit', { justification: v }).then(done(t)); return; }
                    post(urls.root + '/Preauth/' + t.getAttribute('data-decide') + '/Decide', approve ? { approve: true, approvalRef: v } : { approve: false, reason: v }).then(done(t));
                });
            });

            var paEl = document.getElementById('paModal');
            if (paEl && window.$ && $.fn.select2) {
                var pSel = paEl.querySelector('[data-pa-patient]'), sSel = paEl.querySelector('[data-pa-service]'), cover = paEl.querySelector('[data-pa-cover]');
                function picker(el, url) {
                    $(el).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', dropdownParent: $(paEl), placeholder: el.getAttribute('data-placeholder'),
                        ajax: { url: url, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
                }
                picker(pSel, urls.patients); picker(sSel, urls.services);
                // The patient's cover is shown as soon as the patient is chosen: a request for an uncovered patient is refused anyway.
                $(pSel).on('select2:select', function () {
                    cover.textContent = '';
                    fetch(urls.eligibility.replace(/0$/, pSel.value), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (d) {
                        cover.className = 'fs-7 mt-2 fw-semibold ' + (d.eligible ? 'text-primary' : 'text-danger');
                        cover.textContent = d.eligible ? d.payer + ' · ' + d.policyNo + (d.memberClass ? ' · ' + d.memberClass : '') : d.reason;
                    });
                });
                paEl.querySelector('[data-pa-send]').addEventListener('click', function (e) {
                    var btn = e.currentTarget, amt = paEl.querySelector('[data-pa-amount]').value.trim();
                    if (!pSel.value || !sSel.value) { toast('error', W.choose); return; }
                    btn.disabled = true;
                    post(urls.root + '/Preauth', { patientId: Number(pSel.value), serviceId: Number(sSel.value), amount: amt ? Number(amt) : null })
                        .then(done(btn, function () { bootstrap.Modal.getOrCreateInstance(paEl).hide(); swap(); }));
                });
            }

            var bEl = document.getElementById('batchModal');
            if (bEl) bEl.querySelector('[data-b-build]').addEventListener('click', function (e) {
                var btn = e.currentTarget, payer = bEl.querySelector('[data-b-payer]'), period = bEl.querySelector('[data-b-period]').value;
                var name = payer.options[payer.selectedIndex] ? payer.options[payer.selectedIndex].text : '';
                cbConfirm(W.built.replace('{0}', period).replace('{1}', name)).then(function (ok) {
                    if (!ok) return;
                    btn.disabled = true;
                    post(urls.root + '/Batch', { payerId: Number(payer.value), period: period })
                        .then(done(btn, function (res) { location.href = urls.batch.replace(/0$/, res.id); }));
                });
            });
        })();
    </script>
}
