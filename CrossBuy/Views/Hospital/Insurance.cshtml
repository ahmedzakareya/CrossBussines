@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalPreauthRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Approvals & claims"].Value;
    var stats = (HospitalInsuranceStats)ViewBag.Stats;
    var batches = (ViewBag.Batches as List<HospitalBatchRow>) ?? new();
    var rejections = (ViewBag.Rejections as IReadOnlyList<HospitalRejectionRow>) ?? Array.Empty<HospitalRejectionRow>();
    var payers = (ViewBag.Payers as List<HospitalPayerRow>) ?? new();
    string tab = (ViewBag.Tab as string) ?? "pa";
    string? cur = ViewBag.Currency as string;
    bool canBill = ViewBag.CanBill == true;
    string Money(decimal v) => v.ToString("N3", System.Globalization.CultureInfo.InvariantCulture);
    string PaBadge(string s) => s switch { HospitalPreauthStatus.Approved => "success", HospitalPreauthStatus.Rejected => "danger", _ => "primary" };
    string BatchBadge(string s) => s switch { HospitalClaimBatchStatus.Paid => "success", HospitalClaimBatchStatus.Partial => "info", HospitalClaimBatchStatus.Rejected => "danger", HospitalClaimBatchStatus.Submitted => "primary", _ => "secondary" };
    string Avatar(string? photo, string nameEn, int px) => photo != null
        ? $"<div class=\"symbol symbol-{px}px symbol-circle flex-shrink-0\"><img src=\"{photo}\" alt=\"\" style=\"object-fit:cover\" data-initials=\"{HospitalUi.Initials(nameEn)}\" /></div>"
        : $"<div class=\"symbol symbol-{px}px symbol-circle flex-shrink-0\"><span class=\"symbol-label fw-bold fs-8 hp-initials\">{HospitalUi.Initials(nameEn)}</span></div>";
    var claimMonth = DateTime.UtcNow.AddMonths(-1).ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Approvals & claims"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Insurance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Approvals & claims"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("Payers")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Payers & contracts"]</a>
            @if (canBill)
            {
                <button type="button" class="btn btn-sm btn-light-primary" data-bs-toggle="modal" data-bs-target="#paModal"><i class="ki-outline ki-plus fs-4"></i>@T["New approval request"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#batchModal"><i class="ki-outline ki-send fs-4"></i>@T["Build month batch"]</button>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="row g-5 g-xl-8 mb-5">
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Approvals pending"]</div>
                <div class="fs-2hx fw-bold hp-num text-gray-900">@stats.PendingPreauths</div>
                <div class="text-muted fs-8 mt-1">@if (stats.OldestPendingMinutes is int om) {<text>@T["oldest"] <span class="hp-num">@om</span> @T["min"]</text>} else {<text>@T["None waiting"]</text>}</div>
            </div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Claims this month"]</div>
                <div class="fs-2hx fw-bold hp-num text-gray-900">@Money(stats.ClaimedThisMonth)</div>
                <div class="text-muted fs-8 mt-1">@cur</div>
            </div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Rejection rate"]</div>
                <div class="fs-2hx fw-bold hp-num @(stats.RejectionRate > 5 ? "text-danger" : "text-gray-900")">@(stats.RejectionRate is decimal rr ? rr.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "%" : "—")</div>
                <div class="text-muted fs-8 mt-1">@T["Target below 5%"]</div>
            </div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                <div class="text-muted fw-semibold fs-7 mb-1">@T["Days to collect"]</div>
                <div class="fs-2hx fw-bold hp-num text-gray-900">@(stats.DaysToCollect?.ToString() ?? "—")</div>
                <div class="text-muted fs-8 mt-1">@T["from submission"]</div>
            </div></div></div>
        </div>

        <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice">
            <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label"><i class="ki-outline ki-arrows-circle fs-2x text-white"></i></span></span>
            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["E-claims channel: not connected"]</h4>
                <div class="fs-6 text-gray-700">@T["A batch is sent to the payer outside the system; record its submission and the payer's answer for each line here."]</div></div>
        </div>

        <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold mb-5">
            <li class="nav-item"><a class="nav-link text-active-primary @(tab == "pa" ? "active" : "")" data-bs-toggle="tab" href="#ins_pa">@T["Pre-authorisations"] <span class="badge badge-light ms-2 hp-num">@Model.Count</span></a></li>
            <li class="nav-item"><a class="nav-link text-active-primary @(tab == "cl" ? "active" : "")" data-bs-toggle="tab" href="#ins_cl">@T["Claim batches"] <span class="badge badge-light ms-2 hp-num">@batches.Count</span></a></li>
            <li class="nav-item"><a class="nav-link text-active-primary @(tab == "rj" ? "active" : "")" data-bs-toggle="tab" href="#ins_rj">@T["Rejections"] <span class="badge badge-light-danger ms-2 hp-num">@rejections.Count</span></a></li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade @(tab == "pa" ? "show active" : "")" id="ins_pa"><div class="card"><div class="card-body pt-6">
                @if (Model.Count == 0) { <div class="text-center text-muted py-15"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 d-block mb-4"></i>@T["No approval requests yet."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th class="w-125px">@T["Request"]</th><th>@T["Patient"]</th><th>@T["Payer"]</th><th>@T["Service (catalogue)"]</th><th class="text-end">@T["Amount"]</th><th>@T["Status"]</th><th class="text-end w-175px"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in Model)
                            {
                                var a = r.Preauth; var who = DisplayName.Of(r.PatientName, r.PatientNameEn);
                                <tr>
                                    <td><span class="badge hp-code fw-bold fs-8 hp-num">@a.RequestNo</span><div class="text-muted fs-8 hp-num mt-1" data-fmt data-utc="@a.RequestedAt.ToString("o")">@a.RequestedAt.ToString("yyyy-MM-dd HH:mm")</div></td>
                                    <td><div class="d-flex align-items-center gap-3">@Html.Raw(Avatar(r.Photo, r.PatientNameEn, 35))
                                        <div><a href="@Url.Action("Patient", new { id = a.PatientId })" class="fw-bold text-gray-900 text-hover-primary">@who</a><div class="text-muted fs-8 hp-num">@r.Mrn</div></div></div></td>
                                    <td>@DisplayName.Of(r.Payer, r.PayerEn)</td>
                                    <td><div class="text-gray-800">@DisplayName.Of(r.Service, r.ServiceEn)</div><div class="text-muted fs-8 hp-num">@r.ServiceCode</div>
                                        @if (a.Reason != null) {<div class="text-danger fs-8">@a.Reason</div>}
                                        @if (a.ApprovalRef != null) {<div class="text-muted fs-8">@T["Ref."] <span class="hp-num">@a.ApprovalRef</span></div>}</td>
                                    <td class="text-end hp-num">@Money(a.Amount)</td>
                                    <td><span class="badge badge-light-@PaBadge(a.Status) fs-8">@T["pa:" + a.Status]</span></td>
                                    <td class="text-end">
                                        @if (canBill && a.Status == HospitalPreauthStatus.Pending)
                                        {
                                            <button type="button" class="btn btn-sm btn-light-success" data-decide="@a.ID" data-approve="1" data-ask="@string.Format(T["The payer approved {0} for {1}: enter its approval reference."].Value, DisplayName.Of(r.Service, r.ServiceEn), who)">@T["pa:Approved"]</button>
                                            <button type="button" class="btn btn-sm btn-light-danger" data-decide="@a.ID" data-approve="0" data-ask="@string.Format(T["The payer rejected {0} for {1}: enter its reason."].Value, DisplayName.Of(r.Service, r.ServiceEn), who)">@T["pa:Rejected"]</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div></div></div>

            <div class="tab-pane fade @(tab == "cl" ? "show active" : "")" id="ins_cl"><div class="card"><div class="card-body pt-6">
                @if (batches.Count == 0) { <div class="text-center text-muted py-15"><i class="ki-outline ki-send fs-3x text-gray-300 d-block mb-4"></i>@T["No claim batches yet. Build one from a month's closed bills."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th class="w-175px">@T["Batch"]</th><th>@T["Payer"]</th><th>@T["Period"]</th><th class="text-end">@T["Claims"]</th><th class="text-end">@T["Amount"]</th><th class="text-end">@T["Accepted"]</th><th class="text-end">@T["Rejected"]</th><th>@T["Status"]</th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var b in batches)
                            {
                                <tr>
                                    <td><a href="@Url.Action("ClaimBatch", new { id = b.Batch.ID })" class="badge hp-code fw-bold fs-8 hp-num">@b.Batch.BatchNo</a></td>
                                    <td>@DisplayName.Of(b.Payer, b.PayerEn)</td>
                                    <td class="hp-num">@b.Batch.Period</td>
                                    <td class="text-end hp-num">@b.Claims</td>
                                    <td class="text-end hp-num">@Money(b.Amount)@if (b.Currency != null) {<span class="badge badge-light fs-9 ms-1">@b.Currency</span>}</td>
                                    <td class="text-end hp-num">@(b.Accepted > 0 ? Money(b.Accepted) : "—")</td>
                                    <td class="text-end hp-num">@if (b.Rejected > 0) {<span class="text-danger">@Money(b.Rejected)</span>} else {<span class="text-muted">—</span>}</td>
                                    <td><span class="badge badge-light-@BatchBadge(b.Batch.Status) fs-8">@T["cb:" + b.Batch.Status]</span></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div></div></div>

            <div class="tab-pane fade @(tab == "rj" ? "show active" : "")" id="ins_rj"><div class="card"><div class="card-body pt-6">
                @if (rejections.Count == 0) { <div class="text-center text-muted py-15"><i class="ki-outline ki-check-circle fs-3x text-gray-300 d-block mb-4"></i>@T["No rejected lines waiting."]</div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th class="w-175px">@T["Batch"]</th><th>@T["Patient"]</th><th>@T["Line"]</th><th>@T["Reason"]</th><th class="text-end">@T["Amount"]</th><th class="text-end w-150px"></th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in rejections)
                            {
                                var l = r.Line;
                                <tr>
                                    <td><a href="@Url.Action("ClaimBatch", new { id = r.BatchId })" class="badge hp-code fw-bold fs-8 hp-num">@r.BatchNo</a></td>
                                    <td><div class="d-flex align-items-center gap-2">@Html.Raw(Avatar(r.Photo, r.PatientNameEn, 30))<span class="text-gray-800">@DisplayName.Of(r.PatientName, r.PatientNameEn)</span></div></td>
                                    <td><div class="text-gray-800">@DisplayName.Of(l.Description, l.DescriptionEn)</div><div class="text-muted fs-8 hp-num">@l.Code</div></td>
                                    <td><span class="badge hp-code fs-8 hp-num">@l.RejectCode</span> <span class="text-gray-700 fs-7">@l.RejectReason</span></td>
                                    <td class="text-end hp-num">@Money(l.InsurerAmount)</td>
                                    <td class="text-end">@if (canBill) {<button type="button" class="btn btn-sm btn-light-primary" data-resubmit="@l.ID" data-ask="@string.Format(T["Resubmit {0} in this month's batch: write the justification the payer will read."].Value, DisplayName.Of(l.Description, l.DescriptionEn))"><i class="ki-outline ki-arrow-circle-right fs-5"></i>@T["Resubmit"]</button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div></div></div>
        </div>
    </div></div>
</div>

@if (canBill)
{
    <div class="modal fade" id="paModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["New approval request"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-8 px-lg-10">
            <div class="mb-6"><label class="form-label required">@T["Patient"]</label><select class="form-select form-select-solid" data-pa-patient data-placeholder="@T["Search by name or MRN"]"></select>
                <div class="fs-7 mt-2" data-pa-cover></div></div>
            <div class="mb-6"><label class="form-label required">@T["Service (catalogue)"]</label><select class="form-select form-select-solid" data-pa-service data-placeholder="@T["Search by code or name"]"></select></div>
            <div class="mb-2"><label class="form-label">@T["Amount"] <span class="text-muted fs-8">@cur</span></label><input class="form-control form-control-solid hp-num" dir="ltr" data-pa-amount placeholder="@T["The service price"]" /></div>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-pa-send>@T["Send request"]</button></div>
    </div></div></div>

    <div class="modal fade" id="batchModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["Build month batch"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-8 px-lg-10">
            <div class="mb-6"><label class="form-label required">@T["Payer"]</label>
                <select class="form-select form-select-solid" data-b-payer data-control="select2" data-hide-search="true" data-dropdown-parent="#batchModal">
                    @foreach (var p in payers) { <option value="@p.Payer.ID">@p.Payer.Code · @DisplayName.Of(p.Payer.Name, p.Payer.NameEn)</option> }
                </select></div>
            <div class="mb-4"><label class="form-label required">@T["Month"]</label><input type="month" class="form-control form-control-solid hp-num" data-b-period value="@claimMonth" /></div>
            <div class="text-muted fs-7">@T["The month's closed bills of the payer's covered patients, not claimed yet, are gathered into its draft batch."]</div>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-b-build @(payers.Count == 0 ? "disabled" : "")>@T["Build batch"]</button></div>
    </div></div></div>
}

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var isAr = document.documentElement.dir === 'rtl';
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), choose: @Json.Serialize(T["Choose the patient and the service"].Value),
                built: @Json.Serialize(T["Build the {0} batch of {1}? Each closed bill is split into the payer's share and the patient's."].Value) };
            var urls = { root: @Json.Serialize(Url.Action("Insurance")), patients: @Json.Serialize(Url.Action("SearchInsurancePatients")), services: @Json.Serialize(Url.Action("SearchServices")),
                eligibility: @Json.Serialize(Url.Action("Eligibility", new { patientId = 0 })), batch: @Json.Serialize(Url.Action("ClaimBatch", new { id = 0 })) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped (the open tab kept).
            function swap() {
                var active = document.querySelector('.nav-line-tabs .nav-link.active'), tab = active ? active.getAttribute('href').replace('#ins_', '') : 'pa';
                return fetch(urls.root + '?tab=' + tab, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    var f = doc.getElementById('kt_app_content'); if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function done(t, after) { return function (res) { if (t) t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); (after || swap)(res); }; }

            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-decide],[data-resubmit]'); if (!t) return;
                var approve = t.getAttribute('data-approve') === '1';
                cbPrompt(t.getAttribute('data-ask'), { kind: t.hasAttribute('data-resubmit') || approve ? 'primary' : 'danger', textarea: !approve }).then(function (v) {
                    if (v == null) return;
                    t.disabled = true;
                    if (t.hasAttribute('data-resubmit')) { post(urls.root + '/Line/' + t.getAttribute('data-resubmit') + '/Resubmit', { justification: v }).then(done(t)); return; }
                    post(urls.root + '/Preauth/' + t.getAttribute('data-decide') + '/Decide', approve ? { approve: true, approvalRef: v } : { approve: false, reason: v }).then(done(t));
                });
            });

            var paEl = document.getElementById('paModal');
            if (paEl && window.$ && $.fn.select2) {
                var pSel = paEl.querySelector('[data-pa-patient]'), sSel = paEl.querySelector('[data-pa-service]'), cover = paEl.querySelector('[data-pa-cover]');
                function picker(el, url) {
                    $(el).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', dropdownParent: $(paEl), placeholder: el.getAttribute('data-placeholder'),
                        ajax: { url: url, dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
                }
                picker(pSel, urls.patients); picker(sSel, urls.services);
                // The patient's cover is shown as soon as the patient is chosen: a request for an uncovered patient is refused anyway.
                $(pSel).on('select2:select', function () {
                    cover.textContent = '';
                    fetch(urls.eligibility.replace(/0$/, pSel.value), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (d) {
                        cover.className = 'fs-7 mt-2 fw-semibold ' + (d.eligible ? 'text-success' : 'text-danger');
                        cover.textContent = d.eligible ? d.payer + ' · ' + d.policyNo + (d.memberClass ? ' · ' + d.memberClass : '') : d.reason;
                    });
                });
                paEl.querySelector('[data-pa-send]').addEventListener('click', function (e) {
                    var btn = e.currentTarget, amt = paEl.querySelector('[data-pa-amount]').value.trim();
                    if (!pSel.value || !sSel.value) { toast('error', W.choose); return; }
                    btn.disabled = true;
                    post(urls.root + '/Preauth', { patientId: Number(pSel.value), serviceId: Number(sSel.value), amount: amt ? Number(amt) : null })
                        .then(done(btn, function () { bootstrap.Modal.getOrCreateInstance(paEl).hide(); swap(); }));
                });
            }

            var bEl = document.getElementById('batchModal');
            if (bEl) bEl.querySelector('[data-b-build]').addEventListener('click', function (e) {
                var btn = e.currentTarget, payer = bEl.querySelector('[data-b-payer]'), period = bEl.querySelector('[data-b-period]').value;
                var name = payer.options[payer.selectedIndex] ? payer.options[payer.selectedIndex].text : '';
                cbConfirm(W.built.replace('{0}', period).replace('{1}', name)).then(function (ok) {
                    if (!ok) return;
                    btn.disabled = true;
                    post(urls.root + '/Batch', { payerId: Number(payer.value), period: period })
                        .then(done(btn, function (res) { location.href = urls.batch.replace(/0$/, res.id); }));
                });
            });
        })();
    </script>
}
