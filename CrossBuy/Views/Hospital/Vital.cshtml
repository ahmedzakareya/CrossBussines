@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalBirthRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H58 — births (and, H59, deaths): register a birth on the mother's file (a live birth opens the newborn's own file),
    the registered births with their print (Report Studio, Hospital.BirthNotice) and their void. Every write asks first
    and the list swaps in place.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Births & deaths"].Value;
    bool ready = ViewBag.BirthsReady == true, canAdmit = ViewBag.CanAdmit == true, canVoid = ViewBag.CanVoid == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string At(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("yyyy-MM-dd HH:mm", inv);
    var nowW = HospitalNursingService.UtcToWard(DateTime.UtcNow).ToString("yyyy-MM-ddTHH:mm", inv);
    var deaths = (ViewBag.Deaths as IReadOnlyList<HospitalDeathRow>) ?? Array.Empty<HospitalDeathRow>();   // H59
    bool deathsReady = ViewBag.DeathsReady == true, canCertify = ViewBag.CanCertify == true;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Births & deaths"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Patients"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Medical records"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalBirthService.NoTables]</div></div> }
        <div class="row g-5">
            @if (ready && canAdmit)
            {
                <div class="col-xl-4">
                    <div class="card card-flush mb-5" data-birth-form>
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Register a birth"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["A live birth opens the newborn's own file, linked to the mother."]</span></h3>
                            <div class="card-toolbar"><div class="symbol symbol-40px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-heart fs-2 text-primary"></i></span></div></div></div>
                        <div class="card-body pt-2"><div class="row g-4">
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["The mother"]</label>
                                <select class="form-select form-select-solid" data-b="motherPatientId" data-birth-mother data-placeholder="—"></select></div>
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Time of birth"]</label><input type="datetime-local" class="form-control form-control-solid" data-b="bornAt" value="@nowW" max="@nowW" /></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2 required">@T["Outcome"]</label>
                                <select class="form-select form-select-solid" data-b="outcome">@foreach (var o in HospitalBirthOutcome.All) { <option value="@o">@T["bo:" + o]</option> }</select></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2 required">@T["Baby's sex"]</label>
                                <select class="form-select form-select-solid" data-b="sex"><option value="M">@T["bs:M"]</option><option value="F">@T["bs:F"]</option></select></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2 required">@T["Delivery"]</label>
                                <select class="form-select form-select-solid" data-b="deliveryMode">@foreach (var m in HospitalDeliveryMode.All) { <option value="@m">@T["dm:" + m]</option> }</select></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Gestation (weeks)"]</label><input type="number" min="20" max="45" class="form-control form-control-solid hp-num" data-b="gestationWeeks" /></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2 required">@T["Weight (g)"]</label><input type="number" min="200" max="7000" class="form-control form-control-solid hp-num" data-b="weightGrams" /></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Birth order"]</label><input type="number" min="1" max="6" value="1" class="form-control form-control-solid hp-num" data-b="birthOrder" /></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Length (cm)"]</label><input type="number" step="0.1" class="form-control form-control-solid hp-num" data-b="lengthCm" /></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Head (cm)"]</label><input type="number" step="0.1" class="form-control form-control-solid hp-num" data-b="headCm" /></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Apgar at 1 min"]</label><input type="number" min="0" max="10" class="form-control form-control-solid hp-num" data-b="apgar1" /></div>
                            <div class="col-6"><label class="fs-6 fw-semibold mb-2">@T["Apgar at 5 min"]</label><input type="number" min="0" max="10" class="form-control form-control-solid hp-num" data-b="apgar5" /></div>
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["sl:notes"]</label><input type="text" maxlength="500" dir="auto" class="form-control form-control-solid" data-b="note" /></div>
                            <div class="col-12"><button type="button" class="btn btn-primary w-100" data-birth-register><i class="ki-outline ki-heart fs-4"></i>@T["Register the birth"]</button></div>
                        </div></div>
                    </div>
                </div>
            }
            <div class="@(ready && canAdmit ? "col-xl-8" : "col-12")">
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Births"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@Model.Count</span></h3></div>
                    <div class="card-body pt-2" data-birth-list>
                        @if (Model.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-heart fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No birth registered yet."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Registration"]</th><th>@T["The mother"]</th><th>@T["The baby"]</th><th>@T["Delivery"]</th><th class="text-end pe-4 rounded-end">@T["Actions"]</th></tr></thead>
                                <tbody class="fw-semibold text-gray-700">
                                    @foreach (var r in Model)
                                    {
                                        var b = r.Birth; bool isVoid = b.VoidedAt != null;
                                        <tr data-birth-row="@b.ID" class="@(isVoid ? "opacity-75" : "")">
                                            <td class="ps-4"><span class="text-gray-900 fw-bold fs-6 hp-num d-block">@b.BirthNo</span><span class="text-muted fw-semibold d-block fs-7 hp-num" dir="ltr">@At(b.BornAt)</span>
                                                @if (isVoid) {<span class="badge badge-light-danger fs-7 fw-bold mt-1">@T["sl:void"]</span><div class="text-muted fs-8" dir="auto">@b.VoidReason</div>}</td>
                                            <td><div class="d-flex align-items-center">
                                                <div class="symbol symbol-35px symbol-circle me-3 flex-shrink-0"><span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.MotherEn ?? r.Mother)</span></div>
                                                <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = b.MotherPatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(r.Mother, r.MotherEn ?? r.Mother)</a><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.MotherMrn</bdi></div></div></td>
                                            <td>@if (b.NewbornPatientId is int nid) {<a href="@Url.Action("Patient", new { id = nid })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(r.Newborn ?? "", r.NewbornEn ?? r.Newborn ?? "")</a><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.NewbornMrn</bdi>}
                                                else {<span class="badge badge-light-dark fs-7 fw-bold">@T["bo:Stillbirth"]</span>}
                                                <div class="text-muted fs-7 mt-1">@T["bs:" + b.Sex] · <span class="hp-num">@b.WeightGrams</span>&nbsp;@T["g"] @if (b.Apgar1 != null || b.Apgar5 != null) {<text> · </text>@T["Apgar"] <span class="hp-num" dir="ltr">@(b.Apgar1?.ToString() ?? "—")/@(b.Apgar5?.ToString() ?? "—")</span>}</div></td>
                                            <td><span class="badge badge-light-primary fs-7 fw-bold">@T["dm:" + b.DeliveryMode]</span>@if (b.GestationWeeks is int gw) {<div class="text-muted fs-7 mt-1"><span class="hp-num">@gw</span>&nbsp;@T["weeks"]</div>}</td>
                                            <td class="text-end pe-4"><div class="d-flex justify-content-end gap-2">
                                                @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalBirth, DocumentId = b.ID.ToString(), DocumentTitle = b.BirthNo })
                                                @if (!isVoid && canVoid) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" data-birth-void="@b.ID" data-no="@b.BirthNo" title="@T["sl:voidAction"]" data-bs-toggle="tooltip"><i class="ki-outline ki-trash fs-4"></i></button> }
                                            </div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ================= H59: deaths ================= *@
        <div class="row g-5">
            @if (deathsReady && canCertify)
            {
                <div class="col-xl-4">
                    <div class="card card-flush mb-5" data-death-form>
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Certify a death"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["The cause of death in the international form: the chain from the immediate cause down to the underlying cause."]</span></h3>
                            <div class="card-toolbar"><div class="symbol symbol-40px"><span class="symbol-label bg-light-dark"><i class="ki-outline ki-document fs-2 text-gray-800"></i></span></div></div></div>
                        <div class="card-body pt-2"><div class="row g-4">
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Patient"]</label>
                                <select class="form-select form-select-solid" data-d="patientId" data-death-patient data-placeholder="—"></select></div>
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Time of death"]</label><input type="datetime-local" class="form-control form-control-solid" data-d="diedAt" value="@nowW" max="@nowW" /></div>
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Place of death"]</label>
                                <select class="form-select form-select-solid" data-d="place">@foreach (var pl in HospitalDeathPlace.All) { <option value="@pl">@T["dp:" + pl]</option> }</select></div>
                            <div class="col-12"><div class="separator separator-dashed mb-4"></div><div class="fw-bold text-gray-800 fs-6">@T["Part I — the chain of events"]</div></div>
                            <div class="col-12"><label class="fs-7 fw-semibold mb-2 required">@T["(a) Immediate cause"]</label><input type="text" maxlength="300" dir="auto" class="form-control form-control-solid" data-d="immediateCause" /></div>
                            <div class="col-12"><label class="fs-7 fw-semibold mb-2">@T["(b) Due to"]</label><input type="text" maxlength="300" dir="auto" class="form-control form-control-solid" data-d="dueTo1" /></div>
                            <div class="col-12"><label class="fs-7 fw-semibold mb-2">@T["(c) Due to"]</label><input type="text" maxlength="300" dir="auto" class="form-control form-control-solid" data-d="dueTo2" /></div>
                            <div class="col-12"><label class="fs-7 fw-semibold mb-2">@T["(d) Due to (underlying cause)"]</label><input type="text" maxlength="300" dir="auto" class="form-control form-control-solid" data-d="underlyingCause" /></div>
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Part II — other significant conditions"]</label><input type="text" maxlength="500" dir="auto" class="form-control form-control-solid" data-d="otherConditions" /></div>
                            <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Manner of death"]</label>
                                <select class="form-select form-select-solid" data-d="manner">@foreach (var m in HospitalDeathManner.All) { <option value="@m">@T["mn:" + m]</option> }</select></div>
                            <div class="col-12"><label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-d="autopsyRequested" /><span class="form-check-label fs-7">@T["Autopsy requested"]</span></label></div>
                            <div class="col-12"><button type="button" class="btn btn-dark w-100" data-death-certify><i class="ki-outline ki-document fs-4"></i>@T["Certify the death"]</button></div>
                        </div></div>
                    </div>
                </div>
            }
            <div class="@(deathsReady && canCertify ? "col-xl-8" : "col-12")">
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Deaths"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@deaths.Count</span></h3></div>
                    <div class="card-body pt-2" data-death-list>
                        @if (deaths.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-document fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No death certified."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Certificate"]</th><th>@T["Patient"]</th><th>@T["Cause of death"]</th><th>@T["Doctor"]</th><th class="text-end pe-4 rounded-end">@T["Actions"]</th></tr></thead>
                                <tbody class="fw-semibold text-gray-700">
                                    @foreach (var r in deaths)
                                    {
                                        var dd = r.Death; bool isVoid = dd.VoidedAt != null;
                                        <tr data-death-row="@dd.ID" class="@(isVoid ? "opacity-75" : "")">
                                            <td class="ps-4"><span class="text-gray-900 fw-bold fs-6 hp-num d-block">@dd.DeathNo</span><span class="text-muted fw-semibold d-block fs-7"><span class="hp-num" dir="ltr">@At(dd.DiedAt)</span> · @T["dp:" + dd.Place]</span>
                                                @if (isVoid) {<span class="badge badge-light-danger fs-7 fw-bold mt-1">@T["sl:void"]</span><div class="text-muted fs-8" dir="auto">@dd.VoidReason</div>}</td>
                                            <td><div class="d-flex align-items-center">
                                                <div class="symbol symbol-35px symbol-circle me-3 flex-shrink-0">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientEn ?? r.Patient)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.PatientEn ?? r.Patient)</span>}</div>
                                                <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = dd.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(r.Patient, r.PatientEn ?? r.Patient)</a><bdi class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</bdi></div></div></td>
                                            <td><div class="text-gray-900 fw-bold" dir="auto">@dd.ImmediateCause</div><div class="text-muted fs-7" dir="auto">@T["Underlying"]: @HospitalDeathRules.Underlying(dd)</div><span class="badge badge-light fs-7 fw-bold mt-1">@T["mn:" + dd.Manner]</span></td>
                                            <td><span class="text-gray-800 fw-semibold">@DisplayName.Of(r.Doctor ?? "", r.DoctorEn ?? r.Doctor ?? "")</span></td>
                                            <td class="text-end pe-4"><div class="d-flex justify-content-end gap-2">
                                                @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDeath, DocumentId = dd.ID.ToString(), DocumentTitle = dd.DeathNo })
                                                @if (!isVoid && canVoid) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" data-death-void="@dd.ID" data-no="@dd.DeathNo" title="@T["sl:voidAction"]" data-bs-toggle="tooltip"><i class="ki-outline ki-trash fs-4"></i></button> }
                                            </div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@await Html.PartialAsync("_ReportPreviewModal", (object)T["Births & deaths"].Value)

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), ask: @Json.Serialize(T["Register this birth on the mother's file? A live birth opens the newborn's file."].Value),
                done: @Json.Serialize(T["The birth is registered"].Value), voidWhy: @Json.Serialize(T["Why is registration {0} void?"].Value), voided: @Json.Serialize(T["The registration is void"].Value),
                patients: @Json.Serialize(Url.Content("~/Hospital/Patients/Search")), register: @Json.Serialize(Url.Action("RegisterBirth")), voidUrl: @Json.Serialize(Url.Content("~/Hospital/Vital/Births/")) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function swap() {
                return fetch(location.pathname, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.querySelector('[data-birth-list]');
                    if (f) document.querySelector('[data-birth-list]').innerHTML = f.innerHTML;
                    if (window.KTMenu) KTMenu.createInstances();
                });
            }
            var mp = document.querySelector('[data-birth-mother]');
            if (mp && window.jQuery) jQuery(mp).select2({ placeholder: '—', allowClear: true,
                ajax: { url: W.patients, delay: 250, data: function (p) { return { q: p.term || '' }; }, processResults: function (r) { return { results: r.results || [] }; } } });
            // H59: deaths — the patient in the same picker, certify and void ask first, the list swaps in place
            var dp = document.querySelector('[data-death-patient]');
            if (dp && window.jQuery) jQuery(dp).select2({ placeholder: '—', allowClear: true,
                ajax: { url: W.patients, delay: 250, data: function (p) { return { q: p.term || '' }; }, processResults: function (r) { return { results: r.results || [] }; } } });
            var D = { ask: @Json.Serialize(T["Certify this death? The patient's file is marked deceased, and an open stay is discharged."].Value), done: @Json.Serialize(T["The death is certified"].Value),
                stayOpen: @Json.Serialize(T["The stay could not be discharged: discharge it from the ward."].Value), voidWhy: @Json.Serialize(T["Why is certificate {0} void?"].Value),
                certify: @Json.Serialize(Url.Action("CertifyDeath")), voidUrl: @Json.Serialize(Url.Content("~/Hospital/Vital/Deaths/")) };
            function swapDeaths() {
                return fetch(location.pathname, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.querySelector('[data-death-list]');
                    if (f) document.querySelector('[data-death-list]').innerHTML = f.innerHTML;
                    if (window.KTMenu) KTMenu.createInstances();
                });
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-death-certify],[data-death-void]'); if (!t) return;
                if (t.hasAttribute('data-death-certify')) {
                    var f = document.querySelector('[data-death-form]'), v = function (k) { var el = f.querySelector('[data-d=' + k + ']'); return el.type === 'checkbox' ? el.checked : el.value; };
                    cbConfirm(D.ask, { kind: 'danger' }).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post(D.certify, { patientId: +v('patientId') || 0, diedAt: v('diedAt') || null, place: v('place'), immediateCause: v('immediateCause') || null, dueTo1: v('dueTo1') || null,
                            dueTo2: v('dueTo2') || null, underlyingCause: v('underlyingCause') || null, otherConditions: v('otherConditions') || null, manner: v('manner'), autopsyRequested: v('autopsyRequested') })
                            .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', D.done); if (res.stay === 'stay-open') toast('info', D.stayOpen); swapDeaths(); });
                    });
                    return;
                }
                cbPrompt(D.voidWhy.replace('{0}', t.getAttribute('data-no'))).then(function (why) {
                    if (why == null) return; t.disabled = true;
                    post(D.voidUrl + t.getAttribute('data-death-void') + '/Void', { reason: why })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.voided); swapDeaths(); });
                });
            });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-birth-register],[data-birth-void]'); if (!t) return;
                if (t.hasAttribute('data-birth-register')) {
                    var f = document.querySelector('[data-birth-form]'), v = function (k) { var el = f.querySelector('[data-b=' + k + ']'); return el ? el.value : ''; };
                    var n = function (k) { var x = v(k); return x === '' ? null : +x; };
                    cbConfirm(W.ask).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post(W.register, { motherPatientId: n('motherPatientId') || 0, bornAt: v('bornAt') || null, sex: v('sex'), outcome: v('outcome'), deliveryMode: v('deliveryMode'),
                            gestationWeeks: n('gestationWeeks'), birthOrder: n('birthOrder') || 1, weightGrams: n('weightGrams') || 0, lengthCm: n('lengthCm'), headCm: n('headCm'),
                            apgar1: n('apgar1'), apgar5: n('apgar5'), note: v('note') || null })
                            .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.done); swap(); });
                    });
                    return;
                }
                cbPrompt(W.voidWhy.replace('{0}', t.getAttribute('data-no'))).then(function (why) {
                    if (why == null) return; t.disabled = true;
                    post(W.voidUrl + t.getAttribute('data-birth-void') + '/Void', { reason: why })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.voided); swap(); });
                });
            });
        })();
    </script>
}
