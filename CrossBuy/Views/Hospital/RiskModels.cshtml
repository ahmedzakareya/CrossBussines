@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model HospitalRiskPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H253 — predictive models validated on this hospital's own patients: the 30-day readmission score (LACE) with its
    discrimination (AUC), calibration by band and drift (PSI), and today's inpatients ranked by it. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Predictive models"].Value;
    string q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p) => Url.Action("RiskModels", new { q, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string AucTone(decimal? a) => a is not decimal x ? "secondary" : x >= 0.7m ? "primary" : x >= 0.6m ? "info" : "danger";
    string DriftTone(string d) => d switch { "Stable" => "primary", "Watch" => "info", "Shifted" => "danger", _ => "secondary" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Predictive models"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Quality"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["Predictive models"]</li></ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush mb-5">
            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["30-day readmission (LACE index)"]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Length of stay, acute admission, comorbidity (Charlson), emergency visits in six months — measured here before it is relied on"]</span></h3></div>
            <div class="card-body pt-2">
                <div class="row g-5">
                    <div class="col-6 col-xl-3"><div class="border border-dashed border-gray-300 rounded p-5 h-100">
                        <div class="fs-2hx fw-bold hp-num text-@AucTone(Model.Auc)" dir="ltr" style="text-align:start">@(Model.Auc?.ToString("0.00", inv) ?? "—")</div>
                        <div class="fw-semibold text-gray-700">@T["Discrimination (AUC)"]</div><div class="text-muted fs-8">@T["0.5 is chance; 0.7 or more is useful"]</div></div></div>
                    <div class="col-6 col-xl-3"><div class="border border-dashed border-gray-300 rounded p-5 h-100">
                        <div class="fs-2hx fw-bold hp-num text-gray-900">@Model.Validated</div>
                        <div class="fw-semibold text-gray-700">@T["Discharges measured"]</div><div class="text-muted fs-8">@T["{0} readmitted within 30 days", Model.Readmitted]</div></div></div>
                    <div class="col-6 col-xl-3"><div class="border border-dashed border-gray-300 rounded p-5 h-100">
                        <div class="fs-2hx fw-bold hp-num text-@DriftTone(Model.Drift)" dir="ltr" style="text-align:start">@(Model.Psi?.ToString("0.000", inv) ?? "—")</div>
                        <div class="fw-semibold text-gray-700">@T["Drift (PSI)"] <span class="badge badge-light-@DriftTone(Model.Drift) fs-8 ms-1">@T["drift:" + Model.Drift]</span></div>
                        <div class="text-muted fs-8">@T["Last 90 days ({0}) against the year before ({1})", Model.Recent, Model.Baseline]</div></div></div>
                    <div class="col-6 col-xl-3"><div class="border border-dashed border-gray-300 rounded p-5 h-100">
                        <div class="fs-2hx fw-bold hp-num text-@(Model.HighRisk > 0 ? "danger" : "gray-900")">@Model.HighRisk</div>
                        <div class="fw-semibold text-gray-700">@T["Inpatients at high risk (LACE ≥ 10)"]</div></div></div>
                </div>
                <div class="table-responsive mt-6"><table class="table table-row-dashed align-middle gs-0 gy-3 mb-0">
                    <thead><tr class="fw-bold text-muted fs-7"><th>@T["Score band"]</th><th>@T["Discharges"]</th><th>@T["Readmitted"]</th><th class="min-w-200px">@T["Observed rate"]</th></tr></thead>
                    <tbody>
                    @foreach (var b in Model.Calibration)
                    {
                        <tr><td class="fw-bold hp-num" dir="ltr">@b.Band</td><td class="hp-num">@b.Cases</td><td class="hp-num">@b.Events</td>
                            <td><div class="d-flex align-items-center gap-3"><div class="progress h-8px flex-grow-1 bg-light"><div class="progress-bar bg-primary" style="width:@((b.ObservedPct ?? 0).ToString("0", inv))%"></div></div><span class="hp-num fw-bold w-50px text-end" dir="ltr">@(b.ObservedPct?.ToString("0.#", inv) ?? "—")%</span></div></td></tr>
                    }
                    </tbody>
                </table></div>
                <div class="text-muted fs-8 mt-3">@T["A good score climbs band by band. Until enough discharges are measured here, read it as a prompt for discharge planning, not a prediction."]</div>
            </div>
        </div>

        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title"><span class="card-label fw-bold text-gray-800">@T["Inpatients by readmission risk"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("RiskModels")">
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search a patient"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Inpatients.Count == 0) {<div class="text-center py-15 text-gray-600 fw-semibold">@T["No inpatient here."]</div>}
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th>L</th><th>A</th><th>C</th><th>E</th><th>LACE</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Inpatients)
                        {
                            <tr>
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Photo, DisplayName.Of(r.Name, r.NameEn), 35)<div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = r.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(r.Name, r.NameEn)</a><span class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn</span></div></div></td>
                                <td class="hp-num fs-7" dir="ltr">@r.LosDays @T["d"]</td>
                                <td>@if (r.Acute) {<span class="badge badge-light-info fs-8">@T["Emergency"]</span>} else {<span class="text-muted fs-8">—</span>}</td>
                                <td class="hp-num fs-7">@r.Charlson</td>
                                <td class="hp-num fs-7">@r.EdVisits</td>
                                <td><span class="badge badge-light-@(r.Lace >= HospitalReadmissionRules.HighRisk ? "danger" : "primary") fs-6 hp-num">@r.Lace</span></td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>
