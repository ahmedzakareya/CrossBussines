@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalIcPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H76 — infection prevention and control: who is isolated now, which invasive devices are in and for how many days
    (a line kept a week is the one to question), the case register (suspected, confirmed, ruled out; searched and paged),
    and the month's rates per ward per 1,000 patient-days and device-days.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Infection control"].Value;
    bool canManage = ViewBag.CanManage == true, canEnd = ViewBag.CanEnd == true, canWard = ViewBag.CanWard == true;
    int year = ViewBag.Year, month = ViewBag.Month;
    var rates = (ViewBag.Rates as IReadOnlyList<HospitalIcRateRow>) ?? Array.Empty<HospitalIcRateRow>();
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var total = new HospitalIcRateRow(null, "", "", rates.Sum(r => r.PatientDays), rates.Sum(r => r.LineDays), rates.Sum(r => r.CatheterDays), rates.Sum(r => r.VentDays),
        rates.Sum(r => r.Hai), rates.Sum(r => r.Clabsi), rates.Sum(r => r.Cauti), rates.Sum(r => r.Vap));
    string R(double? v) => v == null ? "—" : v.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    string U(double? v) => v == null ? "—" : v.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    string Local(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("yyyy-MM-dd HH:mm");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Infection control"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Inpatient"]</li></ul>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><div class="fs-6 text-gray-700">@T[HospitalInfectionService.NoTables]</div></div>
            </div>
        }
        else
        {
            @* H128: stat tiles (demo39 dashboards/logistics) *@
            <div class="row g-5 mb-5">
                @foreach (var s in new (string, string, string, string)[] {
                    (T["Patients in isolation"].Value, Model.Isolations.Select(i => i.Patient.PatientId).Distinct().Count().ToString(), "ki-shield-cross", "danger"),
                    (T["Devices in place"].Value, Model.Devices.Count.ToString(), "ki-syringe", "primary"),
                    (T["Suspected cases to review"].Value, Model.Suspected.ToString(), "ki-search-list", "info"),
                    (T["Hospital-acquired per 1,000 patient-days this month"].Value, R(total.HaiRate), "ki-chart-line-down", "success") })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column">
                                <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2 hp-num" dir="ltr">@s.Item2</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                            </div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item4"><i class="ki-outline @s.Item3 fs-2x text-@s.Item4"></i></span></div></div>
                        </div>
                    </div></div>
                }
            </div>

            <div class="row g-5 mb-5">
                <div class="col-xl-6"><div class="card card-flush h-100">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Isolation now"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Started from the nursing station; ended by a doctor or infection control."]</span></h3></div>
                    <div class="card-body pt-2">
                        @if (Model.Isolations.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Nobody is in isolation."]</div></div> }
                        else
                        {
                            @* H128: table widget (demo39 widgets/tables) *@
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Precautions"]</th><th>@T["Since"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                                <tbody>
                                @foreach (var r in Model.Isolations)
                                {
                                    var p = r.Patient; var i = r.Isolation;
                                    <tr>
                                        <td class="ps-4"><div class="d-flex align-items-center">
                                            <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-shield-cross fs-3 text-danger"></i></span></div>
                                            <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = p.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6"><bdi>@DisplayName.Of(p.Name, p.NameEn)</bdi></a>
                                            <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num">@p.Mrn</bdi>@if (p.Bed != null) {<text> · @DisplayName.Of(p.Ward ?? "", p.WardEn ?? p.Ward ?? "") · @T["Bed"]&nbsp;<bdi class="hp-num fw-bold">@p.Bed</bdi></text>}</span></div></div></td>
                                        <td><span class="badge badge-light-danger fs-7 fw-bold">@T["prec:" + i.Precaution]</span>
                                            <div class="fs-7 mt-1">@if (i.Organism != null) {<bdi dir="ltr" class="fw-semibold">@i.Organism</bdi>} @if (i.Reason != null) {<span class="text-muted">@(i.Organism != null ? " · " : "")<bdi>@i.Reason</bdi></span>}</div></td>
                                        <td class="text-nowrap"><span class="text-gray-800 fw-bold hp-num">@Local(i.StartedAt)</span>@if (i.StartedByEmployeeId is int sb && Model.People.TryGetValue(sb, out var who)) {<div class="text-muted fw-semibold fs-7">@who</div>}</td>
                                        <td class="text-end pe-4">@if (canEnd) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["End"]" data-bs-toggle="tooltip" data-end-iso="@i.ID" data-what="@DisplayName.Of(p.Name, p.NameEn) — @T["prec:" + i.Precaution]"><i class="ki-outline ki-cross-circle fs-3"></i></button>}</td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div></div>
                <div class="col-xl-6"><div class="card card-flush h-100">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Devices in place"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Longest first: every day a line stays in, ask whether it is still needed."]</span></h3></div>
                    <div class="card-body pt-2">
                        @if (Model.Devices.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-syringe fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No invasive device is in place."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Device"]</th><th>@T["Day"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                                <tbody>
                                @foreach (var r in Model.Devices)
                                {
                                    var p = r.Patient; var d = r.Device;
                                    <tr>
                                        <td class="ps-4"><div class="d-flex align-items-center">
                                            <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-syringe fs-3 text-primary"></i></span></div>
                                            <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = p.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6"><bdi>@DisplayName.Of(p.Name, p.NameEn)</bdi></a>
                                            <span class="text-muted fw-semibold d-block fs-7">@if (p.Bed != null) {<text>@DisplayName.Of(p.Ward ?? "", p.WardEn ?? p.Ward ?? "") · @T["Bed"]&nbsp;<bdi class="hp-num fw-bold">@p.Bed</bdi></text>}</span></div></div></td>
                                        <td><span class="text-gray-800 fw-bold fs-6">@T["dev:" + d.Kind]</span>@if (d.Site != null) {<div class="text-muted fw-semibold fs-7"><bdi>@d.Site</bdi></div>}</td>
                                        <td><span class="badge @(d.Day >= 7 ? "badge-light-danger" : "badge-light-primary") fs-7 fw-bold hp-num">@T["Day {0}", d.Day]</span></td>
                                        <td class="text-end pe-4">@if (canWard) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Removed"]" data-bs-toggle="tooltip" data-remove-dev="@d.Id" data-what="@DisplayName.Of(p.Name, p.NameEn) — @T["dev:" + d.Kind]"><i class="ki-outline ki-exit-up fs-3"></i></button>}</td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div></div>
            </div>

            <div class="card card-flush mb-5">
                <div class="card-header pt-5 flex-wrap gap-3">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Infection cases"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-300px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by case, patient, file or organism…"]" /></div>
                        <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_status"><option value="">@T["All states"]</option>@foreach (var st in HospitalInfectionStatus.All) { <option value="@st">@T["ics:" + st]</option> }</select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Infection"]</th><th>@T["Date of the event"]</th><th>@T["Acquired"]</th><th>@T["Ward"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="7" class="text-center text-muted py-10">@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="7" class="text-center py-10"><i class="ki-outline ki-virus fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No infection case yet."]</div></td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>

            <div class="card card-flush">
                <div class="card-header pt-5 flex-wrap gap-3">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Infection rates"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Confirmed hospital-acquired infections per 1,000 patient-days and per 1,000 device-days (NHSN). Utilisation is device-days over patient-days."]</span></h3>
                    <div class="card-toolbar"><form method="get" class="d-flex gap-2 align-items-center">
                        <input type="month" name="ym" id="f_month" class="form-control form-control-solid form-control-sm w-175px" dir="ltr" value="@($"{year:0000}-{month:00}")" />
                    </form></div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-3 fs-7 mb-0">
                        <thead>
                            <tr class="fw-bold text-muted bg-light fs-7">
                                <th rowspan="2" class="align-bottom ps-4 rounded-start">@T["Ward"]</th>
                                <th colspan="3" class="text-center border-bottom">@T["All hospital-acquired"]</th>
                                <th colspan="4" class="text-center border-bottom">@T["dev:CentralLine"] — CLABSI</th>
                                <th colspan="4" class="text-center border-bottom">@T["dev:UrinaryCatheter"] — CAUTI</th>
                                <th colspan="4" class="text-center border-bottom">@T["dev:Ventilator"] — VAP</th>
                            </tr>
                            <tr class="fw-bold text-muted bg-light fs-8">
                                <th class="text-end">@T["Patient-days"]</th><th class="text-end">@T["Cases"]</th><th class="text-end">@T["Per 1,000"]</th>
                                @for (int k = 0; k < 3; k++) { <th class="text-end">@T["Device-days"]</th><th class="text-end">@T["Use"]</th><th class="text-end">@T["Cases"]</th><th class="text-end">@T["Per 1,000"]</th> }
                            </tr>
                        </thead>
                        <tbody class="hp-num">
                            @if (rates.Count == 0) { <tr><td colspan="16" class="text-center text-muted py-10" style="font-family:inherit">@T["Nobody lay on a ward this month."]</td></tr> }
                            @foreach (var r in rates.Append(total))
                            {
                                bool isTotal = ReferenceEquals(r, total);
                                <tr class="@(isTotal ? "fw-bold bg-light-primary" : "text-gray-700 fw-semibold")">
                                    <td class="ps-4 text-gray-900 fw-bold" style="font-family:inherit">@(isTotal ? T["Total"].Value : r.WardId == null ? T["No ward"].Value : DisplayName.Of(r.Ward, r.WardEn))</td>
                                    <td class="text-end">@r.PatientDays</td><td class="text-end">@r.Hai</td><td class="text-end">@R(r.HaiRate)</td>
                                    <td class="text-end">@r.LineDays</td><td class="text-end">@U(r.LineUse)</td><td class="text-end">@r.Clabsi</td><td class="text-end">@R(r.ClabsiRate)</td>
                                    <td class="text-end">@r.CatheterDays</td><td class="text-end">@U(r.CatheterUse)</td><td class="text-end">@r.Cauti</td><td class="text-end">@R(r.CautiRate)</td>
                                    <td class="text-end">@r.VentDays</td><td class="text-end">@U(r.VentUse)</td><td class="text-end">@r.Vap</td><td class="text-end">@R(r.VapRate)</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var m = document.getElementById('f_month');
            if (m) m.addEventListener('change', function () { var v = (m.value || '').split('-'); if (v.length === 2) location.href = @Json.Serialize(Url.Action("Infection")) + '?year=' + v[0] + '&month=' + Number(v[1]); });
            if (!document.getElementById('rows')) return;
            var list = cbServerList({ url: @Json.Serialize(Url.Action("InfectionCases")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('status', document.getElementById('f_status').value); } });
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = {
                failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                endIso: @Json.Serialize(T["End these precautions?"].Value), endNote: @Json.Serialize(T["Why they end"].Value),
                removeDev: @Json.Serialize(T["Record that this device was removed now?"].Value),
                confirm: @Json.Serialize(T["Confirm this infection? It counts in the rates from now on."].Value),
                ruleOut: @Json.Serialize(T["Rule out this infection"].Value), ruleOutWhy: @Json.Serialize(T["Why it is ruled out"].Value)
            };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(res, reloadPage) { if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); if (reloadPage) location.reload(); else list.reload(); }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-end-iso],[data-remove-dev],[data-confirm-case],[data-ruleout-case]'); if (!t) return;
                var what = t.getAttribute('data-what') || '';
                if (t.hasAttribute('data-end-iso')) {
                    cbPrompt(what, { title: W.endIso, placeholder: W.endNote }).then(function (note) { if (!note) return;
                        post(@Json.Serialize(Url.Content("~/Hospital/Infection/Isolation/")) + t.getAttribute('data-end-iso') + '/End', { note: note }).then(function (r) { done(r, true); }); });
                } else if (t.hasAttribute('data-remove-dev')) {
                    cbConfirm(W.removeDev + '\n' + what).then(function (ok) { if (!ok) return;
                        post(@Json.Serialize(Url.Content("~/Hospital/Infection/Device/")) + t.getAttribute('data-remove-dev') + '/Remove', {}).then(function (r) { done(r, true); }); });
                } else if (t.hasAttribute('data-confirm-case')) {
                    cbConfirm(W.confirm + '\n' + what).then(function (ok) { if (!ok) return;
                        post(@Json.Serialize(Url.Content("~/Hospital/Infection/Case/")) + t.getAttribute('data-confirm-case') + '/Decide', { decision: 'Confirmed' }).then(function (r) { done(r, true); }); });
                } else {
                    cbPrompt(what, { title: W.ruleOut, placeholder: W.ruleOutWhy, kind: 'danger' }).then(function (note) { if (!note) return;
                        post(@Json.Serialize(Url.Content("~/Hospital/Infection/Case/")) + t.getAttribute('data-ruleout-case') + '/Decide', { decision: 'RuledOut', note: note }).then(function (r) { done(r, false); }); });
                }
            });
        })();
    </script>
}
