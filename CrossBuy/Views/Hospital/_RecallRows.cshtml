@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalLotRecallRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H134: one recall per row, in the theme's table widget. Each row shows:
     · the recall's number and day;
     · the medicine, the batch and its expiry;
     · the class (I red), who issued the notice, the units moved into quarantine;
     · the state. The row opens the recall. *@
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string ClassTone(string c) => c == HospitalLotRecallClass.I ? "danger" : c == HospitalLotRecallClass.II ? "primary" : "info";
    string StateTone(string s) => s == HospitalLotRecallStatus.Quarantined ? "danger" : s == HospitalLotRecallStatus.Released ? "success" : "dark";
}
@foreach (var r in Model)
{
    var href = Url.Action("Recall", "Hospital", new { id = r.Id });
    <tr data-href="@href" class="cursor-pointer">
        <td class="ps-4 text-nowrap"><a href="@href" class="text-gray-900 fw-bold text-hover-primary hp-num d-block">@r.RecallNo</a><span class="text-muted fs-8 hp-num" data-fmt data-utc="@r.OpenedAt.ToString("o")">@r.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd")</span></td>
        <td><div class="d-flex align-items-center">
            <div class="symbol symbol-40px me-3 flex-shrink-0"><span class="symbol-label bg-light-@StateTone(r.Status)"><i class="ki-outline ki-capsule fs-3 text-@StateTone(r.Status)"></i></span></div>
            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(r.Name, r.NameEn)</bdi></span><bdi class="text-muted fw-semibold fs-7" dir="ltr">@r.Code</bdi></div>
        </div></td>
        <td><span class="badge badge-light fs-7 fw-bold" dir="ltr">@r.BatchNo</span>@if (r.Expiry is DateTime e) {<span class="text-muted fs-8 d-block mt-1 hp-num" dir="ltr">@e.ToString("yyyy-MM-dd")</span>}</td>
        <td><span class="badge badge-light-@ClassTone(r.RecallClass) fs-7 fw-bold">@T["Class {0}", r.RecallClass]</span></td>
        <td><span class="text-gray-800 fw-semibold fs-7 d-block">@T["rsrc:" + r.Source]</span>@if (r.Reference != null) {<bdi class="text-muted fs-8" dir="auto">@r.Reference</bdi>}</td>
        <td class="text-end"><span class="text-gray-900 fw-bold hp-num">@r.Quantity.ToString("0.###", inv)</span></td>
        <td><span class="badge badge-light-@StateTone(r.Status) fs-7 fw-bold">@T["recall:" + r.Status]</span></td>
        <td class="text-end pe-4"><a href="@href" class="btn btn-sm btn-icon btn-light btn-active-light-primary"><i class="ki-outline ki-arrow-@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "left" : "right") fs-4"></i></a></td>
    </tr>
}
