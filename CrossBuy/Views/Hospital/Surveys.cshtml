@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalSurveyStats
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H65 — satisfaction surveys: the period's figures (NPS, the average, each question), a survey to take for a recent
    visit / stay / emergency visit, the responses (follow-ups first; searched and paged on the server), the questions.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Satisfaction surveys"].Value;
    bool ready = ViewBag.Ready == true, canManage = ViewBag.CanManage == true;
    var questions = (ViewBag.Questions as IReadOnlyList<HospitalSurveyQuestion>) ?? Array.Empty<HospitalSurveyQuestion>();
    var episodes = (ViewBag.Episodes as IReadOnlyList<HospitalSurveyEpisode>) ?? Array.Empty<HospitalSurveyEpisode>();
    string? kind = ViewBag.Kind as string; int days = ViewBag.Days as int? ?? 90;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    int missing = HospitalSurveyRules.Standard().Count(s => !questions.Any(q => q.Code == s.Code));
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Satisfaction surveys"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Supply & quality"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@string.Format(T["The last {0} days"].Value, days)</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm">
                <a href="@Url.Action("Surveys", new { days })" class="btn btn-sm @(kind == null ? "btn-primary" : "btn-light")">@T["All kinds"]</a>
                @foreach (var k in HospitalSurveyKind.All) { <a href="@Url.Action("Surveys", new { kind = k, days })" class="btn btn-sm @(kind == k ? "btn-primary" : "btn-light")">@T["sv:" + k]</a> }
            </div>
            @if (ready && missing > 0 && canManage) { <button type="button" class="btn btn-sm btn-light-primary" data-survey-standard><i class="ki-outline ki-document fs-4"></i>@T["Add the standard questions"] <span class="badge badge-primary ms-1 hp-num">@missing</span></button> }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><div class="fs-6 text-gray-700">@T[HospitalSurveyService.NoTables]</div></div>
            </div>
        }
        else
        {
            @* H128: stat tiles (demo39 dashboards/logistics) *@
            <div class="row g-5 mb-5">
                @foreach (var t in new (string Label, string Value, string? Sub, string Icon, string Tone, string NumTone)[] {
                    (T["Surveys"].Value, Model.Responses.ToString(inv), null, "ki-questionnaire-tablet", "primary", "text-gray-900"),
                    (T["Net promoter score"].Value, Model.Nps?.ToString(inv) ?? "—", T["Promoters (9–10) less detractors (0–6)"].Value, "ki-like", Model.Nps is < 0 ? "danger" : "success", Model.Nps is >= 30 ? "text-success" : Model.Nps is < 0 ? "text-danger" : "text-gray-900"),
                    (T["Average satisfaction"].Value, Model.Average?.ToString("0.0", inv) ?? "—", Model.Average == null ? null : string.Format(T["{0} of {1}"].Value, Model.Average.Value.ToString("0.0", inv), 5), "ki-star", "info", "text-gray-900"),
                    (T["Follow-ups open"].Value, Model.OpenFollowUps.ToString(inv), null, "ki-message-question", Model.OpenFollowUps > 0 ? "danger" : "success", Model.OpenFollowUps > 0 ? "text-danger" : "text-gray-900") })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column">
                                <span class="fs-2hx fw-bold @t.NumTone me-2 lh-1 ls-n2 hp-num" dir="ltr">@t.Value</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@t.Label</span>
                            </div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@t.Tone"><i class="ki-outline @t.Icon fs-2x text-@t.Tone"></i></span></div></div>
                        </div>
                        <div class="card-body d-flex align-items-end pt-0">
                            <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500">@if (t.Sub != null) {<div class="bullet w-8px h-6px rounded-2 bg-@t.Tone me-3"></div><span class="hp-num">@t.Sub</span>} else {<span>&nbsp;</span>}</div>
                        </div>
                    </div></div>
                }
            </div>
            <div class="row g-5 mb-5">
                <div class="col-xl-7">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Each question"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Each kind of care has its own questions, answered 1 to 5."]</span></h3></div>
                        <div class="card-body pt-2">
                            @if (Model.ByQuestion.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-questionnaire-tablet fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["There are no questions for this kind of care yet"]</div></div> }
                            @foreach (var (q, avg, count) in Model.ByQuestion)
                            {
                                var pct = avg is decimal a ? (int)Math.Round((a - 1) / 4 * 100) : 0;
                                <div class="mb-5">
                                    <div class="d-flex flex-stack mb-2"><span class="text-gray-800 fw-bold fs-6" dir="auto">@DisplayName.Of(q.Text, q.TextEn) @if (!q.IsActive) {<span class="badge badge-light fs-8">@T["cf:inactive"]</span>}</span>
                                        <span class="text-nowrap"><span class="badge badge-light-@(avg is <= 2.5m ? "danger" : "primary") fs-7 fw-bold hp-num" dir="ltr">@(avg?.ToString("0.0", inv) ?? "—")</span> <span class="text-gray-500 fw-semibold fs-7 hp-num">(@count)</span></span></div>
                                    <div class="progress h-6px bg-light-@(avg is <= 2.5m ? "danger" : "primary")"><div class="progress-bar @(avg is <= 2.5m ? "bg-danger" : "bg-primary")" style="width:@(pct)%"></div></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-xl-5">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Take a survey"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@string.Format(T["A visit, stay or emergency visit of the last {0} days, not surveyed yet. Hand the tablet to the patient."].Value, HospitalSurveyRules.WindowDays)</span></h3>
                            <div class="card-toolbar"><div class="symbol symbol-40px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-tablet fs-2 text-primary"></i></span></div></div></div>
                        <div class="card-body pt-2">
                            @if (episodes.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-tablet fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No recent visit is waiting for a survey."]</div></div> }
                            else
                            {
                                <label class="fs-6 fw-semibold mb-2">@T["Choose the visit"]</label>
                                <select class="form-select form-select-solid" data-episode-pick data-placeholder="@T["Choose the visit"]"><option value=""></option>
                                    @foreach (var e in episodes) { <option value="@Url.Action("TakeSurvey", new { kind = e.Kind, id = e.Id })">@DisplayName.Of(e.PatientName, e.PatientNameEn) · @e.Mrn · @T["sv:" + e.Kind] · @HospitalNursingService.UtcToWard(e.EndedAt).ToString("yyyy-MM-dd", inv)</option> }
                                </select>
                                <button type="button" class="btn btn-primary w-100 mt-4" data-episode-go><i class="ki-outline ki-tablet fs-4"></i>@T["Open the survey"]</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="card card-flush mb-5">
                <div class="card-header pt-5 flex-wrap gap-3">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Responses"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-200px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by patient, number or comment…"]" /></div>
                        <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_state"><option value="">@T["All states"]</option><option value="followup">@T["svf:Open"]</option><option value="settled">@T["No follow-up needed or done"]</option></select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    @* H128: table widget (demo39 widgets/tables) *@
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["sv:kind"]</th><th>@T["sv:score"]</th><th>@T["sv:recommend"]</th><th>@T["sv:comment"]</th><th class="pe-4 rounded-end">@T["sv:followup"]</th></tr></thead>
                        <tbody id="rows"></tbody>
                    </table></div>
                    <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm me-2"></span>@T["Loading…"]</div>
                    <div class="text-center py-10 d-none" id="emptyRow"><i class="ki-outline ki-questionnaire-tablet fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No survey yet."]</div></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
            @if (canManage)
            {
                <div class="card card-flush">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["The questions"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Each kind of care has its own questions, answered 1 to 5."]</span></h3></div>
                    <div class="card-body pt-2">
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-5">
                            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Code"]</th><th>@T["sv:kind"]</th><th>@T["Question"]</th><th>@T["Status"]</th><th class="pe-4 rounded-end"></th></tr></thead>
                            <tbody>
                            @foreach (var q in questions)
                            {
                                <tr><td class="ps-4"><span class="badge badge-light fs-7 fw-bold hp-num" dir="ltr">@q.Code</span></td><td class="text-gray-700 fw-semibold fs-7">@T["sv:" + q.Kind]</td><td class="text-gray-900 fw-bold fs-6" dir="auto">@DisplayName.Of(q.Text, q.TextEn)</td>
                                    <td>@if (q.IsActive) {<span class="badge badge-light-success fs-7 fw-bold">@T["cf:active"]</span>} else {<span class="badge badge-light fs-7 fw-bold">@T["cf:inactive"]</span>}</td>
                                    <td class="text-end pe-4"><button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Edit"]" data-bs-toggle="tooltip" data-q-edit='@Json.Serialize(new { id = q.ID, code = q.Code, kind = q.Kind, text = q.Text, textEn = q.TextEn, sortOrder = q.SortOrder, isActive = q.IsActive })'><i class="ki-outline ki-pencil fs-5"></i></button></td></tr>
                            }
                        </tbody></table></div>
                        <div class="row g-4 border border-dashed border-gray-300 rounded p-5 mx-0 bg-light" data-q-form>
                            <div class="col-md-2"><label class="fs-6 fw-semibold mb-2 required">@T["Code"]</label><input class="form-control form-control-solid form-control-sm" maxlength="20" dir="ltr" data-qf="code" /></div>
                            <div class="col-md-2"><label class="fs-6 fw-semibold mb-2 required">@T["sv:kind"]</label><select class="form-select form-select-solid form-select-sm" data-qf="kind">@foreach (var k in HospitalSurveyKind.All) { <option value="@k">@T["sv:" + k]</option> }</select></div>
                            <div class="col-md-1"><label class="fs-6 fw-semibold mb-2">@T["Order"]</label><input type="number" class="form-control form-control-solid form-control-sm hp-num" data-qf="sortOrder" value="1" /></div>
                            <div class="col-md-3"><label class="fs-6 fw-semibold mb-2 required">السؤال (عربي)</label><input class="form-control form-control-solid form-control-sm" maxlength="300" dir="rtl" data-qf="text" /></div>
                            <div class="col-md-3"><label class="fs-6 fw-semibold mb-2 required">Question (English)</label><input class="form-control form-control-solid form-control-sm" maxlength="300" dir="ltr" data-qf="textEn" /></div>
                            <div class="col-md-1 d-flex align-items-end"><label class="form-check form-check-custom form-check-solid mb-2"><input class="form-check-input" type="checkbox" data-qf="isActive" checked /></label></div>
                            <div class="col-12"><button type="button" class="btn btn-sm btn-primary" data-q-save><i class="ki-outline ki-check fs-5"></i>@T["Save"]</button></div>
                        </div>
                    </div>
                </div>
            }
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            var list = cbServerList({ url: @Json.Serialize(Url.Action("SurveysData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('state', document.getElementById('f_state').value); p.set('kind', @Json.Serialize(kind ?? "")); } });
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { saved: @Json.Serialize(T["Saved"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), save: @Json.Serialize(T["Save this question?"].Value),
                std: @Json.Serialize(T["Add the standard survey questions? You can change them afterwards."].Value), added: @Json.Serialize(T["{0} questions were added"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            var pick = document.querySelector('[data-episode-pick]');
            if (pick && window.jQuery) jQuery(pick).select2({ width: '100%', placeholder: pick.getAttribute('data-placeholder') });
            var form = document.querySelector('[data-q-form]'), editing = null, qf = function (k) { return form.querySelector('[data-qf=' + k + ']'); };
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-episode-go],[data-survey-follow],[data-survey-standard],[data-q-edit],[data-q-save]'); if (!t) return;
                if (t.hasAttribute('data-episode-go')) { if (pick.value) location.href = pick.value; return; }
                if (t.hasAttribute('data-survey-follow')) {
                    cbPrompt(t.getAttribute('data-ask')).then(function (note) { if (note == null) return; t.disabled = true;
                        post(@Json.Serialize(Url.Content("~/Hospital/Surveys/")) + t.getAttribute('data-survey-follow') + '/FollowUp', { note: note }).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); list.reload(); }); });
                    return;
                }
                if (t.hasAttribute('data-survey-standard')) {
                    cbConfirm(W.std).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("AddStandardSurveyQuestions"))).then(function (res) { if (!res.ok) { t.disabled = false; toastr.error(res.error || W.failed); return; } toastr.success(W.added.replace('{0}', res.added)); location.reload(); }); });
                    return;
                }
                if (t.hasAttribute('data-q-edit')) {
                    var d = JSON.parse(t.getAttribute('data-q-edit')); editing = d.id;
                    ['code', 'kind', 'text', 'textEn', 'sortOrder'].forEach(function (k) { qf(k).value = d[k]; }); qf('isActive').checked = d.isActive;
                    if (window.jQuery) jQuery(qf('kind')).trigger('change.select2');   // H128: the kind is a select2; show the value just set
                    form.scrollIntoView({ behavior: 'smooth', block: 'center' }); return;
                }
                cbConfirm(W.save).then(function (ok) { if (!ok) return; t.disabled = true;
                    post(@Json.Serialize(Url.Action("SaveSurveyQuestion")) + (editing ? '?id=' + editing : ''), { code: qf('code').value, kind: qf('kind').value, text: qf('text').value, textEn: qf('textEn').value, sortOrder: +qf('sortOrder').value || 0, isActive: qf('isActive').checked })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }); });
            });
        })();
    </script>
}
