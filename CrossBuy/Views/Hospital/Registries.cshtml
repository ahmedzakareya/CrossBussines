@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalRegistryPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H262 — disease registries: diabetes, hypertension and chronic kidney disease, computed from the record; each
    member's care gaps and the last outreach about them. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Disease registries"].Value;
    string reg = Model.Registry, gap = ViewBag.Gap as string ?? "", q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages; bool canReach = ViewBag.CanReach == true;
    string Link(int p, string? r = null, string? g = null) => Url.Action("Registries", new { registry = r ?? reg, gap = g ?? gap, q, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var gapLabels = new Dictionary<string, string>
    {
        ["hba1c-due"] = "HbA1c not done in 6 months", ["hba1c-high"] = "HbA1c above target (≥ 8 %)", ["kidney-due"] = reg == HospitalRegistryKind.Ckd ? "Kidney function not checked in 6 months" : "Kidney function not checked in 12 months",
        ["bp-due"] = "No blood pressure in 6 months", ["bp-high"] = "Blood pressure above target (≥ 140/90)", ["egfr-low"] = "eGFR below 30: nephrology review",
    };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Disease registries"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")" class="text-muted text-hover-primary">@T["Hospital"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Disease registries"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalRegistryService.NoTables]</div></div>
        }
        <div class="row g-5 mb-5">
            @foreach (var c in Model.Counts)
            {
                <div class="col-md-4"><a href="@Link(1, c.Registry, "")" class="card card-flush h-100 @(reg == c.Registry ? "border border-primary" : "") text-hover-primary"><div class="card-body d-flex align-items-center gap-5 py-6">
                    <div class="symbol symbol-50px"><span class="symbol-label bg-light-primary"><i class="ki-outline @(c.Registry == HospitalRegistryKind.Diabetes ? "ki-drop" : c.Registry == HospitalRegistryKind.Hypertension ? "ki-pulse" : "ki-filter-search") fs-2x text-primary"></i></span></div>
                    <div class="flex-grow-1"><div class="text-gray-800 fw-bold fs-5">@T["reg:" + c.Registry]</div><div class="text-gray-500 fw-semibold fs-7">@T["Members"] <span class="hp-num">@c.Members</span></div></div>
                    <div class="text-end"><div class="fs-2 fw-bold hp-num @(c.WithGaps > 0 ? "text-danger" : "text-gray-900")">@c.WithGaps</div><div class="text-muted fs-8">@T["with a care gap"]</div></div>
                </div></a></div>
            }
        </div>
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["reg:" + reg]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Drawn from the problem list, signed diagnoses, laboratory results and recorded blood pressure"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("Registries")">
                    <input type="hidden" name="registry" value="@reg" />
                    <select name="gap" class="form-select form-select-sm form-select-solid w-250px" data-control="select2" data-hide-search="true" onchange="this.form.submit()">
                        <option value="">@T["All members"]</option>
                        @foreach (var kv in gapLabels.Where(k => Model.GapCounts.ContainsKey(k.Key) || gap == k.Key)) {<option value="@kv.Key" selected="@(gap == kv.Key)">@T[kv.Value] (@Model.GapCounts.GetValueOrDefault(kv.Key))</option>}
                        <option value="none" selected="@(gap == "none")">@T["No gap"]</option>
                    </select>
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search a patient or MRN"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Rows.Count == 0)
                {
                    <div class="text-center py-15"><i class="ki-outline ki-people fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No patient here."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th class="min-w-150px">@T["Latest"]</th><th class="min-w-250px">@T["Care gaps"]</th><th class="min-w-175px">@T["Last outreach"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var f = r.Facts;
                            <tr>
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Photo, DisplayName.Of(r.Name, r.NameEn), 35)<div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = r.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(r.Name, r.NameEn)</a><span class="text-muted fs-8"><span class="hp-num" dir="ltr">@r.Mrn</span>@(r.Age != null ? " · " + r.Age + " " + T["y"].Value : "")</span></div></div></td>
                                <td class="fs-7 text-gray-700">
                                    @if (reg == HospitalRegistryKind.Diabetes) {<div>HbA1c <span class="fw-bold hp-num" dir="ltr">@(f.LastHba1c?.ToString("0.0", inv) ?? "—")@(f.LastHba1c != null ? " %" : "")</span> <span class="text-muted fs-8 hp-num">@f.LastHba1cAt?.ToLocalTime().ToString("dd/MM/yyyy", inv)</span></div>}
                                    @if (reg == HospitalRegistryKind.Hypertension) {<div>@T["BP"] <span class="fw-bold hp-num" dir="ltr">@(f.LastSystolic != null ? f.LastSystolic + "/" + f.LastDiastolic : "—")</span> <span class="text-muted fs-8 hp-num">@f.LastBpAt?.ToLocalTime().ToString("dd/MM/yyyy", inv)</span></div>}
                                    @if (reg != HospitalRegistryKind.Hypertension) {<div>eGFR <span class="fw-bold hp-num" dir="ltr">@(f.LastEgfr?.ToString("0", inv) ?? "—")</span> <span class="text-muted fs-8 hp-num">@f.LastCreatinineAt?.ToLocalTime().ToString("dd/MM/yyyy", inv)</span></div>}
                                </td>
                                <td><div class="d-flex flex-wrap gap-1">@if (r.Gaps.Count == 0) {<span class="badge badge-light-primary fs-8">@T["No gap"]</span>}@foreach (var g in r.Gaps) {<span class="badge badge-light-danger fs-8">@T[g.Label]</span>}</div></td>
                                <td>@if (r.LastOutreach is { } o) {<div class="d-flex align-items-center gap-2">@HospitalUi.Avatar(r.OutreachBy?.Photo, r.OutreachBy == null ? "" : DisplayName.Of(r.OutreachBy.Name ?? "", r.OutreachBy.NameEn ?? r.OutreachBy.Name ?? ""), 25)<div><div class="fs-8 text-gray-700" dir="auto">@o.Note</div><div class="text-muted fs-9 hp-num">@o.At.ToLocalTime().ToString("dd/MM/yyyy", inv)</div></div></div>} else {<span class="text-muted fs-8">—</span>}</td>
                                <td class="text-end">@if (canReach && Model.Ready) {<button type="button" class="btn btn-sm btn-light-primary" data-reach="@r.PatientId">@T["Record outreach"]</button>}</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
        <div class="text-muted fs-8 mt-4">@T["Targets follow common guidelines (ADA, ESC/ESH, KDIGO) and are to be confirmed by the clinical lead."]</div>
    </div></div>
</div>
@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, url = @Json.Serialize(Url.Action("RegistryOutreach")), reg = @Json.Serialize(reg);
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), ask: @Json.Serialize(T["What was agreed with the patient?"].Value) };
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-reach]'); if (!t) return;
                cbPrompt(W.ask, { kind: 'primary', textarea: true }).then(function (v) {
                    if (!v) return;
                    fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ patientId: +t.getAttribute('data-reach'), registry: reg, note: v }) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
                });
            });
        })();
    </script>
}
