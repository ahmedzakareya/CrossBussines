@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model HospitalDeskGrid
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H140: the day as a time grid — doctors across, every booked or free time down. An appointment opens its patient at
   the counter; a free slot books the patient at the counter into it and checks them in. The current half-hour is tinted. *@
@{
    string Tone(string s) => s switch { "Waiting" => "danger", "WithDoctor" => "info", "Done" => "success", "NoShow" or "Cancelled" => "secondary", _ => "primary" };
    string Time(int minute) => (minute / 60).ToString("00") + ":" + (minute % 60).ToString("00");
}
@if (Model.Doctors.Count == 0 || Model.Minutes.Count == 0)
{
    <div class="text-center text-muted py-12"><i class="ki-outline ki-element-11 fs-3x text-gray-300 d-block mb-3"></i>@T["No clinic works today."]</div>
}
else
{
    @* The doctors row and the time column stay put while the grid scrolls inside its own box. Sticky cells lose
       their collapsed borders, so the edge is drawn as an inset shadow. *@
    <style>.hp-dg thead th{position:sticky;top:0;z-index:2;background:var(--bs-gray-100);box-shadow:inset 0 -1px 0 var(--bs-gray-300)}
        .hp-dg .hp-dg-time{position:sticky;left:0;z-index:1;background:var(--bs-body-bg);box-shadow:inset -1px 0 0 var(--bs-gray-300)}
        [dir=rtl] .hp-dg .hp-dg-time{left:auto;right:0;box-shadow:inset 1px 0 0 var(--bs-gray-300)}
        .hp-dg thead th.hp-dg-time{z-index:3;background:var(--bs-gray-100)}
        .hp-dg tr.bg-light-danger .hp-dg-time{background:var(--bs-danger-light)}</style>
    <div class="table-responsive mh-700px scroll-y hp-dg"><table class="table table-bordered align-middle mb-0 fs-7">
        <thead><tr class="fw-bold text-muted bg-light">
            <th class="w-70px ps-3 hp-dg-time">@T["Time"]</th>
            @foreach (var d in Model.Doctors)
            {
                <th class="min-w-150px"><div class="d-flex align-items-center">
                    <div class="symbol symbol-25px symbol-circle flex-shrink-0">@if (d.PhotoPath != null) {<img src="@d.PhotoPath" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(d.Row.NameEn ?? d.Row.Name)</span>}</div>
                    <span class="ms-2 fs-8 text-gray-800 text-truncate"><bdi>@DisplayName.Of(d.Row.Name, d.Row.NameEn)</bdi></span></div></th>
            }
        </tr></thead>
        <tbody>
            @for (int i = 0; i < Model.Minutes.Count; i++)
            {
                int m = Model.Minutes[i]; int nextM = i + 1 < Model.Minutes.Count ? Model.Minutes[i + 1] : m + 30;
                bool now = m <= Model.NowMinute && Model.NowMinute < nextM;
                <tr class="@(now ? "bg-light-danger" : "")">
                    <td class="ps-3 fw-bold hp-num hp-dg-time">@Time(m)</td>
                    @foreach (var d in Model.Doctors)
                    {
                        <td class="p-1">
                            @if (Model.Taken.TryGetValue((d.Row.ID, m), out var r))
                            {
                                <a href="#" data-open-patient="@r.A.PatientId" class="d-flex align-items-center gap-2 rounded px-2 py-2 bg-light-@Tone(r.Stage)">
                                    <div class="symbol symbol-30px symbol-circle flex-shrink-0">@if (r.A.PatientPhoto != null) {<img src="@r.A.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.A.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(r.A.PatientNameEn)</span>}</div>
                                    <div class="min-w-0" style="min-width:0"><div class="fw-bold text-gray-800 fs-8 text-truncate"><bdi>@DisplayName.Of(r.A.PatientName, r.A.PatientNameEn)</bdi></div>
                                    <div class="fs-9 text-muted">@T["desk:" + r.Stage]@if (r.A.QueueNumber is int q) {<text> · </text><span class="hp-num">@q</span>}</div></div>
                                </a>
                            }
                            else if (Model.Free.Contains((d.Row.ID, m)))
                            {
                                <a href="#" class="d-block rounded px-3 py-2 border border-dashed border-gray-300 text-center text-muted fs-8 bg-hover-light-primary" data-grid-free="@m" data-doctor="@d.Row.ID" data-time="@Time(m)"><i class="ki-outline ki-plus fs-7"></i> @T["free"]</a>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table></div>
}
