@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H87 — every patient on an active dialysis plan (searched, paged): the days and the shift, the last session, the last
    Kt/V, the days missed in thirty, and the last session's warnings; and a new plan for a patient.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Dialysis patients"].Value;
    bool ready = ViewBag.Ready == true, canPlan = ViewBag.CanPlan == true;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Dialysis patients"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("Dialysis")" class="text-muted text-hover-primary">@T["Dialysis unit"]</a></li></ul>
        </div>
        @if (ready && canPlan) {<button type="button" class="btn btn-sm btn-primary" data-plan-open><i class="ki-outline ki-plus fs-4"></i>@T["New dialysis plan"]</button>}
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalDialysisService.NoTables]</div></div> }
        else
        {
            <div class="card">
                <div class="card-header border-0 pt-6 flex-wrap gap-3">
                    <div class="card-title flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["On a dialysis plan"]</span><span class="text-muted fs-7 mt-1"><span id="resultCount">—</span></span></div>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by name, file or phone…"]" /></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-8 text-uppercase gs-0"><th>@T["Patient"]</th><th>@T["Dialysis days"]</th><th>@T["Prescription"]</th><th>@T["Last session"]</th><th>@T["Last Kt/V"]</th><th>@T["Missed in 30 days"]</th><th class="min-w-150px">@T["Warnings"]</th><th class="text-end"></th></tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="8" class="text-center text-muted py-10">@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="8" class="text-center text-muted py-10">@T["Nobody is on a dialysis plan."]</td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>
@if (ready && canPlan) { <partial name="_DialysisPlanModal" model="null" /> }

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            cbServerList({ url: @Json.Serialize(Url.Action("DialysisPatientsData")), isAr: @(isAr ? "true" : "false") });
        })();
    </script>
}
