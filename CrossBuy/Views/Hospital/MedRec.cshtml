@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalMedReconView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H72 — medication reconciliation for one admission. On admission: the home medicines (what, how much, how often, when
    last taken, who said so) and a doctor's decision for each — continue, change, hold, stop — then the stage signed (or
    "takes nothing at home"). On discharge: every home medicine and every medicine still running in hospital decided for
    home, medicines new for home added, the stage signed, and the home list written into the discharge summary. A
    signed stage is locked. Every write asks first.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Medication reconciliation"].Value;
    var m = Model;
    string stage = ViewBag.Stage as string ?? HospitalMedReconStage.Admission;
    bool canDecide = ViewBag.CanDecide == true, canList = ViewBag.CanList == true, active = m.AdmissionStatus == HospitalAdmissionStatus.Active;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string At(DateTime u) => HospitalNursingService.UtcToWard(u).ToString("dd/MM/yyyy HH:mm", inv);
    string Who(int? id) => id is int i && m.People.TryGetValue(i, out var n) ? n : "—";
    bool admSigned = m.AdmissionDone != null, disSigned = m.DischargeDone != null;
    bool overdue = HospitalMedReconRules.AdmissionOverdue(m.AdmittedAt, m.AdmissionDone, DateTime.UtcNow);
    var home = m.Lines.Where(l => l.Kind == HospitalMedLineKind.Home).ToList();
    var inpatient = m.Lines.Where(l => l.Kind == HospitalMedLineKind.Inpatient).ToList();
    var fresh = m.Lines.Where(l => l.Kind == HospitalMedLineKind.New).ToList();
    var undecidedOrders = m.OpenOrders.Where(o => !inpatient.Any(l => l.MedOrderId == o.ID)).ToList();
    string DecisionBadge(string? d) => d switch { HospitalMedDecision.Continue => "badge-light-primary", HospitalMedDecision.Stop => "badge-light-danger", null => "badge-light", _ => "badge-light-primary" };
    string Med(string drug, string? dose, string? route, string? freq) => string.Join(" · ", new[] { dose, route, freq }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

@functions {
    // One decision cell: the decided state, or (for the doctor, while the stage is open) the choice, why, and save.
    Microsoft.AspNetCore.Html.IHtmlContent DecideCell(string stg, int? lineId, int? orderId, string? decision, string? reason, DateTime? at, string who, bool open)
    {
        var sb = new System.Text.StringBuilder();
        string E(string s) => System.Net.WebUtility.HtmlEncode(s);
        if (decision != null)
        {
            var cls = decision == HospitalMedDecision.Continue ? "badge-light-primary" : decision == HospitalMedDecision.Stop ? "badge-light-danger" : "badge-light-primary";
            sb.Append($"<span class=\"badge {cls} fs-7 fw-bold\">{E(T["mrd:" + decision].Value)}</span>");
            if (!string.IsNullOrWhiteSpace(reason)) sb.Append($"<div class=\"fs-8 text-gray-700 mt-1\" dir=\"auto\">{E(reason)}</div>");
            sb.Append($"<div class=\"fs-9 text-muted mt-1\">{E(who)}</div>");
        }
        if (open)
        {
            sb.Append($"<div class=\"d-flex flex-wrap gap-2 mt-2\" data-decide data-stage=\"{stg}\" data-line=\"{lineId}\" data-order=\"{orderId}\">");
            sb.Append("<select class=\"form-select form-select-solid form-select-sm w-125px\" data-d>");
            foreach (var d in HospitalMedDecision.For(stg)) sb.Append($"<option value=\"{d}\"{(d == decision ? " selected" : "")}>{E(T["mrd:" + d].Value)}</option>");
            sb.Append("</select>");
            sb.Append($"<input class=\"form-control form-control-solid form-control-sm w-175px\" maxlength=\"300\" dir=\"auto\" data-r placeholder=\"{E(T["Why, or the new dose"].Value)}\" value=\"{E(reason ?? "")}\" />");
            sb.Append($"<button type=\"button\" class=\"btn btn-sm btn-light-primary\" data-decide-save>{E(T["Save"].Value)}</button></div>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Medication reconciliation"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Patient", new { id = m.PatientId })" class="text-muted text-hover-primary">@DisplayName.Of(m.Name, m.NameEn)</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Admissions"]</li>
            </ul>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("DischargeSummary", new { id = m.AdmissionId })" class="btn btn-sm btn-light"><i class="ki-outline ki-document fs-4"></i>@T["Discharge summary"]</a>
            <a href="@Url.Action("Nursing")" class="btn btn-sm btn-light"><i class="ki-outline ki-heart-circle fs-4"></i>@T["Nursing station"]</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!m.Ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalMedReconService.NoTables]</div></div> }
        else
        {
            @* H128: the patient's header and the two stages — the theme's profile header with its tab row (demo39 apps/user-management/users/view) *@
            <div class="card card-flush mb-5"><div class="card-body pt-8 pb-0">
                <div class="d-flex flex-wrap flex-sm-nowrap gap-6 mb-6">
                    <div class="symbol symbol-75px symbol-circle flex-shrink-0">@if (!string.IsNullOrEmpty(m.Photo)) {<img src="@m.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(m.NameEn)" />} else {<span class="symbol-label fs-2 fw-bold hp-initials">@HospitalUi.Initials(m.NameEn)</span>}</div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2"><a href="@Url.Action("Patient", new { id = m.PatientId })" class="text-gray-900 text-hover-primary fs-2 fw-bold">@DisplayName.Of(m.Name, m.NameEn)</a><span class="badge hp-code fw-bold fs-8 hp-num">@m.Mrn</span></div>
                        <div class="d-flex flex-wrap fw-semibold fs-6 gap-4 text-gray-500">
                            <span class="d-flex align-items-center"><i class="ki-outline ki-entrance-left fs-4 me-1"></i>@T["Admitted"]&nbsp;<span class="hp-num" dir="ltr">@At(m.AdmittedAt)</span></span>
                            <span class="d-flex align-items-center"><i class="ki-outline ki-capsule fs-4 me-1"></i><span class="hp-num">@home.Count</span>&nbsp;@T["Home medicines"]</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(m.Allergies)) { <div class="align-self-start"><span class="badge badge-light-danger fs-7 fw-bold py-3 px-4" dir="auto"><i class="ki-outline ki-shield-cross text-danger fs-4 me-2"></i>@T["Allergy"]: @m.Allergies</span></div> }
                </div>
                <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
                    <li class="nav-item"><a class="nav-link text-active-primary py-5 me-6 @(stage == HospitalMedReconStage.Admission ? "active" : "")" href="@Url.Action("MedRec", new { id = m.AdmissionId, stage = HospitalMedReconStage.Admission })">@T["On admission"]
                        <span class="badge ms-2 fs-8 fw-bold @(admSigned ? "badge-light-primary" : overdue ? "badge-light-danger" : "badge-light")">@(admSigned ? T["Signed"] : overdue ? T["Overdue"] : T["Open"])</span></a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary py-5 me-6 @(stage == HospitalMedReconStage.Discharge ? "active" : "")" href="@Url.Action("MedRec", new { id = m.AdmissionId, stage = HospitalMedReconStage.Discharge })">@T["On discharge"]
                        <span class="badge ms-2 fs-8 fw-bold @(disSigned ? "badge-light-primary" : "badge-light")">@(disSigned ? T["Signed"] : T["Open"])</span></a></li>
                </ul>
            </div></div>

            @if (stage == HospitalMedReconStage.Admission)
            {
                @if (admSigned)
                {
                    <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5"><i class="ki-outline ki-check-circle fs-2tx text-primary me-4"></i>
                        <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Signed"]</h4>
                        <div class="fs-6 text-gray-700">@string.Format(T["Signed by {0} on {1}"].Value, Who(m.AdmissionDone!.CompletedByEmployeeId), At(m.AdmissionDone.CompletedAt))@if (m.AdmissionDone.NoHomeMeds) {<text> — @T["The patient takes no medicines at home"]</text>}</div></div></div>
                }
                else if (overdue)
                {
                    <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><i class="ki-outline ki-time fs-2tx text-danger me-4"></i>
                        <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Overdue"]</h4>
                        <div class="fs-6 text-gray-700">@T["More than a day since admission and the home medicines are not reconciled."]</div></div></div>
                }
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Home medicines"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["What the patient takes at home, and the doctor's decision for the stay"]</span></h3></div>
                    <div class="card-body pt-2">
                        @if (home.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-capsule fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No home medicines listed yet."]</div></div> }
                        else
                        {
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Medicine"]</th><th>@T["Last taken"]</th><th>@T["Source"]</th><th class="min-w-300px">@T["Decision"]</th><th class="pe-4 rounded-end"></th></tr></thead>
                                <tbody>
                                @foreach (var l in home)
                                {
                                    <tr>
                                        <td class="ps-4"><div class="d-flex align-items-center">
                                            <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-capsule fs-3 text-primary"></i></span></div>
                                            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6" dir="auto">@l.Drug</span><span class="text-muted fw-semibold d-block fs-7" dir="auto">@Med(l.Drug, l.Dose, l.Route, l.Frequency)</span><span class="fs-8 text-gray-500">@Who(l.CreatedByEmployeeId)</span></div></div></td>
                                        <td class="text-gray-800 fw-semibold" dir="auto">@(l.LastTaken ?? "—")</td>
                                        <td>@if (l.Source != null) {<span class="badge badge-light fs-7 fw-bold">@T["mrs:" + l.Source]</span>} else {<span class="text-muted">—</span>}</td>
                                        <td>@DecideCell(HospitalMedReconStage.Admission, l.ID, null, l.AdmitDecision, l.AdmitReason, l.DecidedAt, Who(l.DecidedByEmployeeId), canDecide && !admSigned && active)</td>
                                        <td class="text-end pe-4">@if (!admSigned && l.AdmitDecision == null && (canDecide || canList)) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["Remove"]" data-bs-toggle="tooltip" data-remove="@l.ID" data-what="@l.Drug"><i class="ki-outline ki-trash fs-4"></i></button> }</td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        }
                        @if (!admSigned && active && canList)
                        {
                            <div class="separator separator-dashed my-5"></div>
                            <div class="fw-bold text-gray-800 fs-6 mb-3"><i class="ki-outline ki-plus-square fs-4 text-primary me-1"></i>@T["Add a home medicine"]</div>
                            <div class="row g-3" data-line-form data-kind="Home">
                                <div class="col-md-4"><input class="form-control form-control-solid" maxlength="200" dir="auto" data-f="drug" placeholder="@T["Medicine"]" /></div>
                                <div class="col-md-2"><input class="form-control form-control-solid" maxlength="60" dir="auto" data-f="dose" placeholder="@T["Dose"]" /></div>
                                <div class="col-md-2"><select class="form-select form-select-solid" data-f="route"><option value="">@T["Route"]</option>@foreach (var r in HospitalMedRoute.All) { <option value="@r">@T["route:" + r]</option> }</select></div>
                                <div class="col-md-4"><input class="form-control form-control-solid" maxlength="100" dir="auto" data-f="frequency" placeholder="@T["How often"]" /></div>
                                <div class="col-md-4"><input class="form-control form-control-solid" maxlength="60" dir="auto" data-f="lastTaken" placeholder="@T["Last taken"]" /></div>
                                <div class="col-md-4"><select class="form-select form-select-solid" data-f="source"><option value="">@T["Source"]</option>@foreach (var s in HospitalMedSource.All) { <option value="@s">@T["mrs:" + s]</option> }</select></div>
                                <div class="col-md-4"><button type="button" class="btn btn-light-primary w-100" data-line-add><i class="ki-outline ki-plus fs-4"></i>@T["Add"]</button></div>
                            </div>
                        }
                        @if (!admSigned && active && canDecide)
                        {
                            <div class="separator separator-dashed my-5"></div>
                            <div class="d-flex flex-wrap align-items-center gap-4">
                                <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-no-home /><span class="form-check-label fs-7">@T["The patient takes no medicines at home"]</span></label>
                                <button type="button" class="btn btn-primary ms-auto" data-complete="Admission"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Sign the admission reconciliation"]</button>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                @if (disSigned)
                {
                    <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5"><i class="ki-outline ki-check-circle fs-2tx text-primary me-4"></i>
                        <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Signed"]</h4>
                        <div class="fs-6 text-gray-700">@string.Format(T["Signed by {0} on {1}"].Value, Who(m.DischargeDone!.CompletedByEmployeeId), At(m.DischargeDone.CompletedAt))</div></div></div>
                }
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Medicines for home"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Every home medicine and every medicine still given in hospital: continue at home, change, or stop"]</span></h3></div>
                    <div class="card-body pt-2">
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Medicine"]</th><th>@T["Where it comes from"]</th><th class="min-w-300px pe-4 rounded-end">@T["For home"]</th></tr></thead>
                            <tbody>
                            @foreach (var l in home)
                            {
                                <tr><td class="ps-4"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light"><i class="ki-outline ki-home-2 fs-3 text-gray-700"></i></span></div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6" dir="auto">@l.Drug</span><span class="text-muted fw-semibold d-block fs-7" dir="auto">@Med(l.Drug, l.Dose, l.Route, l.Frequency)</span></div></div></td>
                                    <td><span class="badge badge-light fs-7 fw-bold">@T["Home medicine"]</span>@if (l.AdmitDecision != null) {<div class="fs-8 text-muted mt-1">@T["On admission:"] @T["mrd:" + l.AdmitDecision]</div>}</td>
                                    <td class="pe-4">@DecideCell(HospitalMedReconStage.Discharge, l.ID, null, l.DischargeDecision, l.DischargeNote, l.DecidedAt, Who(l.DecidedByEmployeeId), canDecide && !disSigned && active)</td></tr>
                            }
                            @foreach (var l in inpatient)
                            {
                                <tr><td class="ps-4"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-capsule fs-3 text-primary"></i></span></div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6" dir="auto">@l.Drug</span><span class="text-muted fw-semibold d-block fs-7" dir="auto">@Med(l.Drug, l.Dose, l.Route, l.Frequency)</span></div></div></td>
                                    <td><span class="badge badge-light-primary fs-7 fw-bold">@T["Given in hospital"]</span></td>
                                    <td class="pe-4">@DecideCell(HospitalMedReconStage.Discharge, l.ID, null, l.DischargeDecision, l.DischargeNote, l.DecidedAt, Who(l.DecidedByEmployeeId), canDecide && !disSigned && active)</td></tr>
                            }
                            @foreach (var o in undecidedOrders)
                            {
                                <tr><td class="ps-4"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-capsule fs-3 text-primary"></i></span></div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6" dir="auto">@o.Drug</span><span class="text-muted fw-semibold d-block fs-7" dir="auto">@Med(o.Drug, o.Dose, o.Route, o.AsNeeded ? "PRN" : o.Hours)</span></div></div></td>
                                    <td><span class="badge badge-light-primary fs-7 fw-bold">@T["Given in hospital"]</span></td>
                                    <td class="pe-4">@DecideCell(HospitalMedReconStage.Discharge, null, o.ID, null, null, null, "", canDecide && !disSigned && active)</td></tr>
                            }
                            @foreach (var l in fresh)
                            {
                                <tr><td class="ps-4"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-plus-square fs-3 text-primary"></i></span></div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6" dir="auto">@l.Drug</span><span class="text-muted fw-semibold d-block fs-7" dir="auto">@Med(l.Drug, l.Dose, l.Route, l.Frequency)</span>@if (l.DischargeNote != null) {<span class="fs-7 text-gray-700" dir="auto">@l.DischargeNote</span>}</div></div></td>
                                    <td><span class="badge badge-light-primary fs-7 fw-bold">@T["New for home"]</span></td>
                                    <td class="pe-4"><span class="badge badge-light-primary fs-7 fw-bold">@T["mrd:Continue"]</span>
                                        @if (!disSigned && active && canDecide) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger ms-2" title="@T["Remove"]" data-bs-toggle="tooltip" data-remove="@l.ID" data-what="@l.Drug"><i class="ki-outline ki-trash fs-4"></i></button> }</td></tr>
                            }
                            @if (home.Count + inpatient.Count + undecidedOrders.Count + fresh.Count == 0) { <tr><td colspan="3"><div class="text-center py-10"><i class="ki-outline ki-capsule fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No medicines to reconcile."]</div></div></td></tr> }
                            </tbody>
                        </table></div>
                        @if (!disSigned && active && canDecide)
                        {
                            <div class="separator separator-dashed my-5"></div>
                            <div class="fw-bold text-gray-800 fs-6 mb-3"><i class="ki-outline ki-plus-square fs-4 text-primary me-1"></i>@T["Add a medicine new for home"]</div>
                            <div class="row g-3" data-line-form data-kind="New">
                                <div class="col-md-4"><input class="form-control form-control-solid" maxlength="200" dir="auto" data-f="drug" placeholder="@T["Medicine"]" /></div>
                                <div class="col-md-2"><input class="form-control form-control-solid" maxlength="60" dir="auto" data-f="dose" placeholder="@T["Dose"]" /></div>
                                <div class="col-md-2"><select class="form-select form-select-solid" data-f="route"><option value="">@T["Route"]</option>@foreach (var r in HospitalMedRoute.All) { <option value="@r">@T["route:" + r]</option> }</select></div>
                                <div class="col-md-4"><input class="form-control form-control-solid" maxlength="100" dir="auto" data-f="frequency" placeholder="@T["How often"]" /></div>
                                <div class="col-md-8"><input class="form-control form-control-solid" maxlength="300" dir="auto" data-f="note" placeholder="@T["How long, or what to watch for"]" /></div>
                                <div class="col-md-4"><button type="button" class="btn btn-light-primary w-100" data-line-add><i class="ki-outline ki-plus fs-4"></i>@T["Add"]</button></div>
                            </div>
                            <div class="separator separator-dashed my-5"></div>
                            <div class="d-flex"><button type="button" class="btn btn-primary ms-auto" data-complete="Discharge"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Sign the discharge reconciliation"]</button></div>
                        }
                    </div>
                </div>
                @if (disSigned)
                {
                    var list = HospitalMedReconRules.HomeLines(m.Lines);
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["The list the patient goes home with"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@list.Count</span></h3>
                            @if (canDecide) { <div class="card-toolbar">@if (m.SummaryDraft) { <button type="button" class="btn btn-sm btn-primary" data-to-summary><i class="ki-outline ki-document fs-4"></i>@T["Write it into the discharge summary"]</button> } else { <span class="text-muted fs-7">@T["Start the discharge summary to write the list into it"]</span> }</div> }
                        </div>
                        <div class="card-body pt-2">
                            @if (list.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-capsule fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No medicines for home."]</div></div> }
                            @for (int xi = 0; xi < list.Count; xi++)
                            {
                                var x = list[xi];
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-capsule fs-3 text-primary"></i></span></div>
                                    <div class="d-flex flex-column flex-grow-1">
                                        <div class="d-flex flex-wrap gap-2">@for (int k = 0; k < x.Parts.Length; k++) { <bdi class="@(k == 0 ? "text-gray-800 fw-bold fs-6" : "text-gray-600 fw-semibold fs-7 align-self-center")">@x.Parts[k]</bdi> }</div>
                                        @if (x.Note != null) { <bdi class="text-gray-500 fw-semibold fs-7">@x.Note</bdi> }
                                    </div>
                                </div>
                                if (xi < list.Count - 1) { <div class="separator separator-dashed my-3"></div> }
                            }
                        </div>
                    </div>
                }
            }
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, adm = @m.AdmissionId, base = @Json.Serialize(Url.Content("~/Hospital/Admissions/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                add: @Json.Serialize(T["Add {0} to the list?"].Value), remove: @Json.Serialize(T["Take {0} off the list?"].Value), decide: @Json.Serialize(T["Record the decision for this medicine?"].Value),
                signA: @Json.Serialize(T["Sign the admission reconciliation? It cannot change after."].Value), signD: @Json.Serialize(T["Sign the discharge reconciliation? It cannot change after."].Value),
                summary: @Json.Serialize(T["Write the home list into the discharge summary? Its medicines field is replaced."].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            // in place, never a reload: the page is drawn again and its content swapped
            function swap() { return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content'); if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML; }); }
            function done(btn) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); swap(); }; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-line-add],[data-remove],[data-decide-save],[data-complete],[data-to-summary]'); if (!t) return;
                if (t.hasAttribute('data-line-add')) {
                    var f = t.closest('[data-line-form]'), body = { admissionId: adm, kind: f.getAttribute('data-kind') };
                    f.querySelectorAll('[data-f]').forEach(function (i) { body[i.getAttribute('data-f')] = i.value.trim() || null; });
                    cbConfirm(W.add.replace('{0}', body.drug || '')).then(function (ok) { if (!ok) return; t.disabled = true; post(base + 'MedRec/Line', body).then(done(t)); });
                    return;
                }
                if (t.hasAttribute('data-remove')) {
                    cbConfirm(W.remove.replace('{0}', t.getAttribute('data-what')), { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true; post(base + 'MedRec/Line/' + t.getAttribute('data-remove') + '/Remove').then(done(t)); });
                    return;
                }
                if (t.hasAttribute('data-decide-save')) {
                    var d = t.closest('[data-decide]'), line = d.getAttribute('data-line'), order = d.getAttribute('data-order');
                    var body = { admissionId: adm, stage: d.getAttribute('data-stage'), lineId: line ? Number(line) : null, medOrderId: order ? Number(order) : null, decision: d.querySelector('[data-d]').value, reason: d.querySelector('[data-r]').value.trim() || null };
                    cbConfirm(W.decide).then(function (ok) { if (!ok) return; t.disabled = true; post(base + 'MedRec/Decide', body).then(done(t)); });
                    return;
                }
                if (t.hasAttribute('data-complete')) {
                    var st = t.getAttribute('data-complete'), none = document.querySelector('[data-no-home]');
                    cbConfirm(st === 'Admission' ? W.signA : W.signD).then(function (ok) { if (!ok) return; t.disabled = true; post(base + adm + '/MedRec/Complete', { stage: st, noHomeMeds: !!(none && none.checked) }).then(done(t)); });
                    return;
                }
                cbConfirm(W.summary).then(function (ok) { if (!ok) return; t.disabled = true; post(base + adm + '/MedRec/ToSummary').then(done(t)); });
            });
        })();
    </script>
}
