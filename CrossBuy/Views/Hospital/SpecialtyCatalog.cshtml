@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalSpecialtyCard>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H98 — the specialty catalogue (the approved prototype screen sc-catalog): the specialties built on the engine, and
    every other one with what it records and its key alert — its clinic, templates and visits read from the system.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Specialty catalogue"].Value;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var built = (IReadOnlyList<HospitalSpecialtyCard>)ViewBag.Built;
    string Nm(HospitalDepartment? d, string key) => d == null ? T["spc:" + key].Value : (isAr ? d.Name : d.NameEn ?? d.Name);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Specialty catalogue"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Specialty clinics"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["The catalogue"]</li></ul>
        </div>
        <div class="d-flex gap-2">
            @* H268: the standard forms of the clinics that had none (managers; idempotent) *@
            @if (ViewBag.CanManagePack == true) {@Html.AntiForgeryToken()<button type="button" class="btn btn-sm btn-light-primary" id="spcPack"><i class="ki-outline ki-add-files fs-4"></i>@T["Add the specialty pack"]</button>}
            <a href="@Url.Action("Templates")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-notepad-edit fs-4"></i>@T["Template designer"]</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Most specialties are templates only"]</h4><div class="fs-6 text-gray-700">@T["Once the engine exists, a specialty like psychiatry or cardiology is built from templates and scores with no code; code goes only to the 8 drawn widgets."]</div></div>
        </div>
        @* H127: the built specialties as the theme's stat tiles (demo39 dashboards/logistics) — the clinic's visits over its name *@
        <div class="row g-5 mb-5">
            @foreach (var b in built)
            {
                string href = b.Entry.Kind == "DentalChart" ? Url.Action("DentalChart")! : Url.Action("SpecialtyClinic", new { code = b.Entry.Dept })!;
                bool dental = b.Entry.Dept == "DENT";
                <div class="col-6 col-md-4 col-xl"><a href="@href" class="card card-flush h-100 hoverable">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            @if (dental) {<span class="lh-1"><i class="ki-outline ki-check-circle fs-2x text-primary"></i></span>}
                            else {<span class="fs-2hx fw-bold text-gray-900 lh-1 hp-num">@b.Visits</span>}
                            <span class="text-gray-800 pt-2 fw-bold fs-6">@Nm(b.Clinic, b.Entry.Dept)</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-primary"><i class="ki-outline @b.Entry.Icon fs-2 text-primary"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0"><span class="text-gray-500 fw-semibold fs-7">@(dental ? T["Exists and built"] : T["Built: {0} visits", b.Visits])</span></div>
                </a></div>
            }
        </div>
        @* every specialty: what it records, its key alert, its clinic and templates — a card per specialty (demo39 widgets/lists) *@
        <div class="row g-5">
            @foreach (var c in Model)
            {
                var e = c.Entry;
                string kindKey = e.Kind == "Built" ? "Exists (H85)" : e.Kind == "Widget" ? "spc:" + e.Key + ":widget" : "Template only";
                string tone = e.Kind == "Built" ? "primary" : e.Kind == "Widget" ? "info" : "primary";
                <div class="col-md-6 col-xl-4"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex align-items-center">
                            <div class="symbol symbol-45px me-4 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline @e.Icon fs-2 text-@tone"></i></span></div>
                            <span class="card-label fw-bold text-gray-800 fs-5">@Nm(c.Clinic, e.Key)</span>
                        </div>
                        <div class="card-toolbar"><span class="badge badge-light-@(e.Kind == "Built" ? "primary" : e.Kind == "Widget" ? "info" : "secondary") fw-bold fs-8 text-nowrap">@T[kindKey]</span></div>
                    </div>
                    <div class="card-body pt-2 d-flex flex-column">
                        <div class="d-flex flex-column gap-2 mb-4">
                            @foreach (var i in e.Items) {<div class="d-flex align-items-center"><span class="bullet bullet-dot bg-primary h-6px w-6px me-3 flex-shrink-0"></span><span class="text-gray-700 fw-semibold fs-7">@T["spc:" + e.Key + ":" + i]</span></div>}
                        </div>
                        <div class="d-flex align-items-center bg-light-danger rounded px-4 py-3 mb-4 mt-auto"><i class="ki-outline ki-notification-bing text-danger fs-3 me-3 flex-shrink-0"></i><span class="text-danger fw-semibold fs-7">@T["spc:" + e.Key + ":alert"]</span></div>
                        <div class="separator separator-dashed mb-4"></div>
                        <div class="d-flex flex-wrap gap-2">
                            @if (c.Clinic == null) {<span class="badge badge-light fs-7 fw-bold">@T["No clinic yet"]</span>}
                            else {<a href="@Url.Action("SpecialtyClinic", new { code = e.Dept })" class="badge badge-light-primary fs-7 fw-bold">@T["Clinic: {0} visits", c.Visits]</a>}
                            <span class="badge badge-light-@(c.Templates > 0 ? "primary" : "secondary") fs-7 fw-bold">@T["Published templates: {0}", c.Templates]</span>
                        </div>
                    </div>
                </div></div>
            }
        </div>
    </div></div>
</div>
@section Scripts {
    <script>
        (function () {
            var b = document.getElementById('spcPack'); if (!b) return;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), done: @Json.Serialize(T["Added: {0} clinics, {1} forms"].Value), none: @Json.Serialize(T["The pack is already in place"].Value) };
            b.addEventListener('click', function () {
                b.disabled = true;
                fetch(@Json.Serialize(Url.Action("SpecialtyPack")), { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }, body: '{}' })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) {
                        b.disabled = false;
                        if (!res.ok) { toastr.error(res.error || W.failed); return; }
                        toastr.success(res.templates === 0 && res.departments === 0 ? W.none : W.done.replace('{0}', res.departments).replace('{1}', res.templates));
                        setTimeout(function () { location.reload(); }, 900);
                    });
            });
        })();
    </script>
}
