@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalCharityFund>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H63 — charity cases: the requests to decide (oldest first) and the decisions, searched and paged on the server; the
    funds and their expense accounts (the administrator). A request is made from a closed bill.
    H127 — stat tiles (demo39 dashboards/logistics), the list as the table widget with a toolbar of filters (apps/ecommerce),
    the funds as list-widget rows.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Charity cases"].Value;
    bool ready = ViewBag.Ready == true, canManage = ViewBag.CanManage == true;
    var accounts = (ViewBag.Accounts as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    string? cur = ViewBag.Currency as string;
    int pending = ViewBag.Pending as int? ?? 0; decimal approved = ViewBag.Approved as decimal? ?? 0;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Charity cases"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance & insurance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Billing & cashier"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready)
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Charity cases"]</h4>
                    <div class="fs-6 text-gray-700">@T[HospitalCharityService.NoTables]</div>
                </div></div>
            </div>
        }
        else
        {
            @* stat tiles — demo39 dashboards/logistics *@
            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] {
                    (T["Waiting for a decision"].Value, pending.ToString(), (string?)null, "primary", "time"),
                    (T["Waived so far"].Value, approved.ToString("N3", inv), cur, "success", "heart"),
                    (T["Funds"].Value, Model.Count(f => f.IsActive).ToString(), T["A request is made from a closed bill."].Value, "info", "bank") })
                {
                    <div class="col-md-4"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column">
                                <span class="fs-2hx fw-bold text-gray-900 lh-1 hp-num" dir="ltr">@s.Item2</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                            </div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item4"><i class="ki-outline ki-@s.Item5 fs-2 text-@s.Item4"></i></span></div></div>
                        </div>
                        @if (!string.IsNullOrEmpty(s.Item3)) {<div class="card-body d-flex align-items-end pt-0"><span class="d-flex align-items-center fs-7 fw-semibold text-gray-500"><span class="bullet bullet-dot bg-@s.Item4 me-2"></span>@s.Item3</span></div>}
                    </div></div>
                }
            </div>
            <div class="row g-5 g-xl-8">
                <div class="col-xl-8">
                    <div class="card card-flush">
                        <div class="card-header pt-5 flex-wrap gap-3">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Requests and decisions"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                            <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                                <div class="w-200px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by patient, MRN or bill…"]" /></div>
                                <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_status"><option value="">@T["All states"]</option>@foreach (var st in HospitalCharityStatus.All) { <option value="@st">@T["ch:" + st]</option> }</select></div>
                                <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                                <button type="button" id="f_reset" class="btn btn-sm btn-icon btn-light btn-active-color-primary" title="@T["Reset"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrows-circle fs-3"></i></button>
                            </div>
                        </div>
                        <div class="card-body pt-2">
                            @* table widget — demo39 widgets/tables *@
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["ch:no"]</th><th>@T["Fund"]</th><th class="text-end">@T["Amount"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                                <tbody id="rows"></tbody>
                            </table></div>
                            <div class="text-center text-muted py-10 d-none" id="loadingRow"><span class="spinner-border spinner-border-sm text-primary me-2"></span>@T["Loading…"]</div>
                            <div class="text-center py-10 d-none" id="emptyRow"><i class="ki-outline ki-heart fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No charity request yet."]</div>
                                <div class="fs-7 text-gray-500">@T["A request is made from a closed bill."]</div></div>
                            <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 fw-semibold text-gray-500" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card card-flush">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Charity funds"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Each fund's waivers are posted to its own expense account."]</span></h3>
                        </div>
                        <div class="card-body pt-2">
                            @* list-widget rows — demo39 dashboards/logistics *@
                            @foreach (var f in Model)
                            {
                                var acc = accounts.FirstOrDefault(a => a.Id == f.AccountId);
                                <div class="d-flex flex-stack">
                                    <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@(f.IsActive ? "success" : "secondary")"><i class="ki-outline ki-heart fs-3 text-@(f.IsActive ? "success" : "gray-500")"></i></span></div>
                                    <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                        <div class="me-3"><span class="text-gray-800 fw-bold fs-6"><bdi>@DisplayName.Of(f.Name, f.NameEn)</bdi></span> <bdi class="badge badge-light fs-8 fw-bold hp-num">@f.Code</bdi>@if (!f.IsActive) {<span class="badge badge-light-secondary fs-8 ms-1">@T["cf:inactive"]</span>}
                                            <span class="text-gray-500 fw-semibold fs-7 d-block"><bdi>@(acc == null ? T["No account"].Value : acc.Label + " · " + DisplayName.Of(acc.Name, acc.NameEn))</bdi></span></div>
                                        @if (canManage) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" data-fund-edit='@Json.Serialize(new { id = f.ID, code = f.Code, name = f.Name, nameEn = f.NameEn, accountId = f.AccountId, isActive = f.IsActive })' title="@T["Edit"]" data-bs-toggle="tooltip"><i class="ki-outline ki-pencil fs-3"></i></button> }
                                    </div>
                                </div>
                                <div class="separator separator-dashed my-3"></div>
                            }
                            @if (Model.Count == 0)
                            {
                                <div class="text-center py-6"><i class="ki-outline ki-bank fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No fund yet."]</div></div>
                            }
                            @if (canManage)
                            {
                                <div class="rounded border border-dashed border-gray-300 p-6 mt-4" data-fund-form>
                                    <div class="fs-5 fw-bold text-gray-900 mb-5" data-fund-heading>@T["New fund"]</div>
                                    <div class="row g-4">
                                        <div class="col-4"><label class="fs-6 fw-semibold mb-2 required">@T["Code"]</label><input class="form-control form-control-solid form-control-sm hp-num" maxlength="20" dir="ltr" data-fd="code" /></div>
                                        <div class="col-8"><label class="fs-6 fw-semibold mb-2 required">@T["Name (Arabic)"]</label><input class="form-control form-control-solid form-control-sm" maxlength="150" dir="rtl" data-fd="name" /></div>
                                        <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Name (English)"]</label><input class="form-control form-control-solid form-control-sm" maxlength="150" dir="ltr" data-fd="nameEn" /></div>
                                        <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Expense account"]</label>
                                            <select class="form-select form-select-solid form-select-sm" data-fd="accountId" data-placeholder="—"><option value=""></option>@foreach (var a in accounts) { <option value="@a.Id">@a.Label · @DisplayName.Of(a.Name, a.NameEn)</option> }</select></div>
                                        <div class="col-12"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-fd="isActive" checked /><span class="form-check-label fw-semibold text-gray-700">@T["cf:active"]</span></label></div>
                                        <div class="col-12"><button type="button" class="btn btn-sm btn-primary w-100" data-fund-save><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            var list = cbServerList({ url: @Json.Serialize(Url.Action("CharityData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('status', document.getElementById('f_status').value); } });
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { saved: @Json.Serialize(T["Saved"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), save: @Json.Serialize(T["Save this charity fund?"].Value),
                edit: @Json.Serialize(T["Edit the fund"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            var form = document.querySelector('[data-fund-form]'), editing = null;
            var fd = function (k) { return form.querySelector('[data-fd=' + k + ']'); };
            var acc = form ? fd('accountId') : null;
            if (acc && window.jQuery) jQuery(acc).select2({ width: '100%', allowClear: true, placeholder: '—' });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-fund-edit],[data-fund-save],[data-charity-decide]'); if (!t) return;
                if (t.hasAttribute('data-fund-edit')) {
                    var d = JSON.parse(t.getAttribute('data-fund-edit')); editing = d.id;
                    form.querySelector('[data-fund-heading]').textContent = W.edit;
                    fd('code').value = d.code; fd('name').value = d.name; fd('nameEn').value = d.nameEn; fd('isActive').checked = d.isActive;
                    if (window.jQuery) jQuery(acc).val(d.accountId ? String(d.accountId) : '').trigger('change'); else acc.value = d.accountId || '';
                    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }
                if (t.hasAttribute('data-fund-save')) {
                    cbConfirm(W.save).then(function (ok) {
                        if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("SaveCharityFund")) + (editing ? '?id=' + editing : ''), { code: fd('code').value, name: fd('name').value, nameEn: fd('nameEn').value, accountId: acc.value ? +acc.value : null, isActive: fd('isActive').checked })
                            .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); });
                    });
                    return;
                }
                var url = @Json.Serialize(Url.Content("~/Hospital/Charity/")) + t.getAttribute('data-charity-decide') + '/Decide';
                var go = function (b) { t.disabled = true; post(url, b).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); list.reload(); }); };
                if (t.getAttribute('data-approve') === '1') cbConfirm(t.getAttribute('data-ask')).then(function (ok) { if (ok) go({ approve: true }); });
                else cbPrompt(t.getAttribute('data-ask'), { kind: 'danger' }).then(function (why) { if (why != null) go({ approve: false, note: why }); });
            });
        })();
    </script>
}
