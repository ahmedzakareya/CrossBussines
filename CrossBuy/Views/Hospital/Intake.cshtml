@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H91 — the reception desk's self-intake list: the danger signs nobody has acknowledged first, then the waiting
    intakes oldest first (searched, filtered, paged; refreshed every 20 seconds), and the way to the tablet screen.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Reception desk"].Value;
    var counts = ViewBag.Counts as HospitalDeskCounts;   // H114
    bool ready = ViewBag.Ready == true; int urgent = ViewBag.Urgent is int u ? u : 0;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Reception desk"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Where a patient is now, today at a glance, and what patients entered on the reception tablet"]</li></ul>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Map")" class="btn btn-sm btn-light"><i class="ki-outline ki-map fs-4"></i>@T["Hospital map"]</a>
            <a href="@Url.Action("RegisterPatient")" class="btn btn-sm btn-light"><i class="ki-outline ki-user-tick fs-4"></i>@T["Register patient"]</a>
            <a href="@Url.Action("IntakeKiosk")" target="_blank" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-tablet fs-4"></i>@T["Open the tablet screen"]</a>
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalSelfIntakeService.NoTables]</div></div> }
        else
        {
            @* H125: the theme's notice (demo39 utilities) — icon, heading, the line under it *@
            <div id="urgentBar" class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-6 mb-5 @(urgent == 0 ? "d-none" : "")">
                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Danger signs waiting:"] <span id="urgentN" class="hp-num text-danger">@urgent</span></h4>
                    <div class="fs-6 text-gray-700">@T["see the patient now and acknowledge"]</div>
                </div></div>
            </div>
            @if (counts != null)
            {
                var tiles = new (string Icon, string Color, int N, string Label)[]
                {
                    ("ki-home-2", "primary", counts.Admitted, T["Admitted now"].Value),
                    ("ki-user-tick", "primary", counts.InClinic, T["With a doctor now"].Value),
                    ("ki-time", "info", counts.WaitingClinic, T["Waiting for a clinic"].Value),
                    ("ki-pulse", "danger", counts.InEmergency, T["In the emergency department"].Value),
                    ("ki-heart-circle", "danger", counts.InTheatre, T["In an operation"].Value),
                    ("ki-scan-barcode", "primary", counts.InImaging, T["At imaging"].Value),
                    ("ki-calendar-tick", "primary", counts.ArrivalsToday, T["Clinic arrivals today"].Value),
                };
                @* H125: the theme's stat tile (demo39 dashboards/logistics) — symbol, the large figure, its label *@
                <div class="row g-5 mb-5">
                    @foreach (var x in tiles)
                    {
                        <div class="col-6 col-md-4 col-xl"><div class="card card-flush h-100"><div class="card-body d-flex flex-column justify-content-between p-6">
                            <div class="symbol symbol-45px mb-6"><span class="symbol-label bg-light-@x.Color"><i class="ki-outline @x.Icon fs-2x text-@x.Color"></i></span></div>
                            <div><span class="fs-2hx fw-bold @(x.N > 0 ? "text-gray-800" : "text-gray-400") lh-1 ls-n2 hp-num d-block mb-2">@x.N</span>
                                <span class="fs-7 fw-semibold text-gray-500">@x.Label</span></div>
                        </div></div></div>
                    }
                </div>
            }
            <div class="card card-flush mb-5">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Where is the patient now?"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Name, file number, mobile or ID number: the ward bed, the clinic, imaging, an operation or the emergency department, as it is this minute."]</span></h3>
                    <div class="card-toolbar"><span class="symbol symbol-40px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-geolocation fs-2 text-primary"></i></span></span></div>
                </div>
                <div class="card-body pt-2">
                    <div class="position-relative mb-6"><i class="ki-outline ki-magnifier fs-2 text-gray-500 position-absolute top-50 translate-middle-y ms-5"></i>
                        <input type="text" id="w_q" class="form-control form-control-lg form-control-solid ps-14" autocomplete="off" placeholder="@T["Type at least two letters or digits…"]" /></div>
                    <div id="w_out"><div class="text-center py-6"><i class="ki-outline ki-geolocation fs-3x text-gray-300 d-block mb-3"></i><div class="fs-6 fw-semibold text-gray-500">@T["Results appear as you type."]</div></div></div>
                </div>
            </div>
            <div class="card card-flush">
                <div class="card-header pt-5 flex-wrap gap-3">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Self-intake"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                    <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                        <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by number, name, mobile or ID…"]" /></div>
                        <div class="w-175px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_filter">
                            <option value="">@T["Waiting for the desk"]</option><option value="urgent">@T["Danger signs"]</option><option value="done">@T["Linked or new file"]</option><option value="closed">@T["Rejected or expired"]</option>
                        </select></div>
                        <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                        <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 min-w-125px rounded-start">@T["Number"]</th><th class="min-w-200px">@T["Name entered"]</th><th class="min-w-150px">@T["Visit"]</th><th>@T["Waited"]</th><th class="min-w-150px">@T["State"]</th><th class="pe-4 text-end rounded-end"></th></tr></thead>
                        <tbody id="rows"><tr id="loadingRow"><td colspan="6" class="text-center text-muted py-10">@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="6" class="text-center text-muted py-10">@T["No intake waiting."]</td></tr></tbody>
                    </table></div>
                    <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                </div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            // H114: where is the patient now — searched as the desk types
            var W = { none: @Json.Serialize(T["No patient matches."].Value), out: @Json.Serialize(T["Not in the hospital now"].Value), live: @Json.Serialize(T["now"].Value),
                      since: @Json.Serialize(T["since {0}"].Value), map: @Json.Serialize(T["On the map"].Value), file: @Json.Serialize(T["Open file"].Value),
                      restricted: @Json.Serialize(T["Restricted file: the location is not given at the desk — ask the care team"].Value), hint: @Json.Serialize(T["Results appear as you type."].Value),
                      kind: @Json.Serialize(new[] { "Theatre", "Emergency", "Imaging", "ClinicInRoom", "ClinicWaiting", "Ward" }.ToDictionary(k => k, k => T["where:" + k].Value)) };
            var ICON = { Theatre: 'ki-heart-circle text-danger', Emergency: 'ki-pulse text-danger', Imaging: 'ki-scan-barcode text-primary', ClinicInRoom: 'ki-user-tick text-primary', ClinicWaiting: 'ki-time text-info', Ward: 'ki-home-2 text-primary' };
            function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
            function ini(n) { return (n || '?').trim().split(/\s+/).slice(0, 2).map(function (x) { return x[0]; }).join(''); }
            var wq = document.getElementById('w_q'), wo = document.getElementById('w_out'), wt = null, wseq = 0;
            // H125: the theme's list widget — the person (photo, name over the file number), each place a tinted block (demo39 widgets/lists)
            var TONE = { Theatre: 'danger', Emergency: 'danger', Imaging: 'primary', ClinicInRoom: 'primary', ClinicWaiting: 'info', Ward: 'primary' };
            function wrender(rows) {
                if (!rows.length) { wo.innerHTML = '<div class="text-center py-6"><i class="ki-outline ki-user fs-3x text-gray-300 d-block mb-3"></i><div class="fs-6 fw-semibold text-gray-600">' + esc(W.none) + '</div></div>'; return; }
                wo.innerHTML = rows.map(function (r, i) {
                    var face = r.photo ? '<img src="' + esc(r.photo) + '" alt="" style="object-fit:cover" />' : '<span class="symbol-label bg-light-primary text-primary fw-bold fs-5 hp-initials">' + esc(ini(r.name)) + '</span>';
                    var now = r.restricted ? '<div class="d-flex align-items-center bg-light rounded p-4"><i class="ki-outline ki-lock fs-1 text-gray-600 me-4"></i><span class="fw-semibold text-gray-700 fs-7">' + esc(W.restricted) + '</span></div>'
                        : !r.now.length ? '<div class="d-flex align-items-center bg-light rounded p-4"><i class="ki-outline ki-exit-right fs-1 text-gray-500 me-4"></i><span class="fw-semibold text-gray-600 fs-6">' + esc(W.out) + '</span></div>'
                        : r.now.map(function (w) { var tone = TONE[w.kind] || 'primary';
                            return '<div class="d-flex align-items-center bg-light-' + tone + ' rounded p-4 mb-3">' +
                                '<i class="ki-outline ' + (ICON[w.kind] || 'ki-geolocation') + ' fs-1 me-4"></i>' +
                                '<div class="flex-grow-1 me-2"><span class="fw-bold text-gray-800 fs-6">' + esc(W.kind[w.kind] || w.kind) + '</span>' + (w.live ? ' <span class="badge badge-' + tone + ' fs-8 fw-bold ms-1">' + esc(W.live) + '</span>' : '') +
                                '<span class="text-gray-700 fw-semibold d-block fs-7"><bdi>' + esc(w.place) + '</bdi></span>' +
                                (w.detail || w.since ? '<span class="text-muted fw-semibold d-block fs-8">' + (w.detail ? '<bdi>' + esc(w.detail) + '</bdi>' : '') + (w.since ? (w.detail ? ' · ' : '') + esc(W.since.replace('{0}', w.since)) : '') + '</span>' : '') + '</div>' +
                                (w.map ? '<a class="btn btn-sm btn-light btn-active-light-' + tone + ' text-nowrap" href="' + esc(w.map) + '"><i class="ki-outline ki-map fs-4"></i>' + esc(W.map) + '</a>' : '') + '</div>'; }).join('');
                    return (i ? '<div class="separator separator-dashed my-5"></div>' : '') +
                        '<div class="d-flex flex-stack mb-4"><div class="d-flex align-items-center">' +
                        '<div class="symbol symbol-50px symbol-circle me-4">' + face + '</div>' +
                        '<div class="d-flex flex-column"><a class="text-gray-900 fw-bold text-hover-primary fs-5" href="' + esc(r.url) + '"><bdi>' + esc(r.name) + '</bdi></a><span class="text-muted fw-semibold d-block fs-7 hp-num" dir="ltr">' + esc(r.mrn) + '</span></div></div>' +
                        '<a class="btn btn-sm btn-light-primary text-nowrap" href="' + esc(r.url) + '"><i class="ki-outline ki-document fs-4"></i>' + esc(W.file) + '</a></div>' + now;
                }).join('');
            }
            function wsearch() {
                var q = wq.value.trim(), my = ++wseq;
                if (q.length < 2) { wo.innerHTML = '<div class="text-center py-6"><i class="ki-outline ki-geolocation fs-3x text-gray-300 d-block mb-3"></i><div class="fs-6 fw-semibold text-gray-500">' + esc(W.hint) + '</div></div>'; return; }
                fetch(@Json.Serialize(Url.Action("IntakeWhere")) + '?q=' + encodeURIComponent(q), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); }).then(function (res) { if (my === wseq && res.ok) wrender(res.rows); });
            }
            wq.addEventListener('input', function () { clearTimeout(wt); wt = setTimeout(wsearch, 250); });

            var list = cbServerList({ url: @Json.Serialize(Url.Action("IntakeData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('filter', document.getElementById('f_filter').value); } });
            // the desk sees a new intake (and a danger sign) without reloading
            setInterval(function () { if (document.hidden) return; list.reload();
                fetch(@Json.Serialize(Url.Action("IntakeData")) + '?pageSize=1&filter=urgent').then(function (r) { var n = Number(r.headers.get('X-Urgent') || 0);
                    document.getElementById('urgentN').textContent = n; document.getElementById('urgentBar').classList.toggle('d-none', n === 0); }); }, 20000);
        })();
    </script>
}
