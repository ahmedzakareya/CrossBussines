@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalDeskRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H139/H140: one appointment of the day per row, as the prototype's board:
     · the time, the visit type and the queue number;
     · the patient's face and file; the flags the desk must see (allergy, money owed, insurance to verify, first visit, walk-in);
     · the doctor and the payer; the stage with the wait since arrival (or "late");
     · check in for the expected, collect for those who owe, and the rest in the theme's dropdown menu. *@
@{
    bool canBook = ViewBag.CanBook == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture; int dp = ViewBag.MoneyDp is int d0 ? d0 : 2; string cur = ViewBag.Currency as string ?? "";
    string Tone(string s) => s switch { "Waiting" => "danger", "WithDoctor" => "info", "Done" => "success", "NoShow" or "Cancelled" => "secondary", _ => "primary" };
    string Mins(int m) => m < 60 ? string.Format(T["{0} min"].Value, m) : string.Format(T["{0} h {1} min"].Value, m / 60, m % 60);
    string Time(int minute) => (minute / 60).ToString("00") + ":" + (minute % 60).ToString("00");
}
@foreach (var r in Model)
{
    var a = r.A; var f = r.Flags; string tone = Tone(r.Stage); string name = DisplayName.Of(a.PatientName, a.PatientNameEn);
    <tr>
        <td class="ps-4 text-nowrap"><span class="text-gray-800 fw-bold hp-num fs-6">@Time(a.StartMinute)</span>
            <span class="text-muted fs-8 d-block">@T["visit:" + a.VisitType]</span>
            @if (a.QueueNumber is int qn) {<span class="badge badge-light-primary fs-8 fw-bold hp-num mt-1">@qn</span>}</td>
        <td><a href="#" class="d-flex align-items-center text-hover-primary" data-open-patient="@a.PatientId">
            <div class="symbol symbol-35px symbol-circle me-3 flex-shrink-0">@if (a.PatientPhoto != null) {<img src="@a.PatientPhoto" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(a.PatientNameEn)</span>}</div>
            <div class="d-flex flex-column min-w-0"><span class="text-gray-900 fw-bold fs-6 text-truncate"><bdi>@name</bdi></span><span class="text-muted fs-7"><span class="hp-num">@a.Mrn</span> · @T["sex:" + a.Sex]</span></div></a></td>
        <td><div class="d-flex gap-2">
            @if (f?.Allergies != null) {<i class="ki-outline ki-shield-cross fs-4 text-danger" data-bs-toggle="tooltip" title="@T["Allergy"]: @HospitalAllergyText.Display(f.Allergies)"></i>}
            @if (f?.Owed > 0) {<i class="ki-outline ki-wallet fs-4 text-danger" data-bs-toggle="tooltip" title="@T["Owes"] @f.Owed.ToString("N" + dp, inv) @cur"></i>}
            @if (f?.Unverified == true) {<i class="ki-outline ki-shield-search fs-4 text-info" data-bs-toggle="tooltip" title="@T["Insurance does not cover today"]"></i>}
            @if (f?.FirstVisit == true) {<i class="ki-outline ki-star fs-4 text-success" data-bs-toggle="tooltip" title="@T["First visit"]"></i>}
            @if (f?.WalkIn == true) {<i class="ki-outline ki-entrance-right fs-4 text-gray-600" data-bs-toggle="tooltip" title="@T["Walk-in"]"></i>}
        </div></td>
        <td><div class="d-flex align-items-center">
            <div class="symbol symbol-30px symbol-circle me-2 flex-shrink-0">@if (r.DoctorPhoto != null) {<img src="@r.DoctorPhoto" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(r.DoctorEn ?? r.Doctor)</span>}</div>
            <div class="d-flex flex-column min-w-0"><span class="text-gray-800 fw-semibold fs-7 text-truncate mw-125px"><bdi>@DisplayName.Of(r.Doctor, r.DoctorEn)</bdi></span>
                <span class="text-muted fs-8 text-truncate mw-125px"><bdi>@(f?.Payer != null ? DisplayName.Of(f.Payer, f.PayerEn) : T["Self-pay"].Value)</bdi></span></div></div></td>
        <td><div class="d-flex flex-column align-items-start gap-1">
            <span class="badge badge-light-@tone fs-8 fw-bold">@T["desk:" + r.Stage]</span>
            @if (r.WaitMinutes is int w) {<span class="badge badge-light-@(r.Stage == HospitalDeskStage.Waiting && w > 30 ? "danger" : "success") fs-8 fw-bold text-nowrap"><i class="ki-outline ki-timer fs-8 me-1"></i>@Mins(w)</span>}
            else if (r.Late) {<span class="badge badge-light-danger fs-8 fw-bold text-nowrap"><i class="ki-outline ki-time fs-8 me-1"></i>@T["Late"]</span>}
        </div></td>
        <td class="text-end pe-4"><div class="d-flex justify-content-end gap-1">
            @if (canBook && r.Stage == HospitalDeskStage.Expected)
            {
                <button type="button" class="btn btn-sm btn-primary py-2 px-3 text-nowrap" data-move="Arrived" data-appt="@a.Id"><i class="ki-outline ki-check fs-5"></i>@T["Check in"]</button>
            }
            else if (f?.Owed > 0 && ViewBag.CanBill == true)
            {
                <button type="button" class="btn btn-sm btn-light-danger py-2 px-3 text-nowrap" data-desk-pay="@a.PatientId"><i class="ki-outline ki-wallet fs-5"></i>@T["Collect payment"]</button>
            }
            <button type="button" class="btn btn-sm btn-icon btn-light btn-active-light-primary w-30px h-30px" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end"><i class="ki-outline ki-dots-horizontal fs-4"></i></button>
            <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-700 menu-state-bg-light-primary fw-semibold fs-7 w-225px py-3" data-kt-menu="true">
                <div class="menu-item px-3"><a href="#" class="menu-link px-3" data-open-patient="@a.PatientId"><i class="ki-outline ki-profile-circle fs-5 me-3"></i>@T["Open at the counter"]</a></div>
                <div class="menu-item px-3"><a href="#" class="menu-link px-3" data-desk-pay="@a.PatientId"><i class="ki-outline ki-wallet fs-5 me-3"></i>@T["Collect at the counter"]</a></div>
                <div class="menu-item px-3"><a href="@Url.Action("Patient", "Hospital", new { id = a.PatientId })" class="menu-link px-3"><i class="ki-outline ki-document fs-5 me-3"></i>@T["Open the file"]</a></div>
                @if (canBook && r.Stage == HospitalDeskStage.Expected)
                {
                    <div class="menu-item px-3"><a href="#" class="menu-link px-3" data-desk-resched="@a.Id"><i class="ki-outline ki-calendar-edit fs-5 me-3"></i>@T["Move the appointment"]</a></div>
                    <div class="separator my-2"></div>
                    <div class="menu-item px-3"><a href="#" class="menu-link px-3 text-danger" data-move="NoShow" data-appt="@a.Id" data-ask="@string.Format(T["Mark {0} as a no-show?"].Value, name)"><i class="ki-outline ki-cross-circle fs-5 me-3 text-danger"></i>@T["No-show"]</a></div>
                }
            </div>
        </div></td>
    </tr>
}
