@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalCatalogEntry>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Services & items"].Value;
    bool canManage = ViewBag.CanManage == true;
    string tab = (ViewBag.Tab as string) ?? HospitalPriceGroups.Service;
    var fac = (HospitalPriceCurrency)ViewBag.Facility;
    var lists = ((ViewBag.Lists as IReadOnlyList<HospitalPriceListRow>) ?? Array.Empty<HospitalPriceListRow>()).Where(r => r.List.Status != HospitalPriceListStatus.Archived).ToList();
    var mapped = ((ViewBag.Mapped as IReadOnlyList<HospitalItemCategory>) ?? Array.Empty<HospitalItemCategory>()).ToDictionary(c => c.ItemCategoryId, c => c.Kind);
    var categories = (ViewBag.Categories as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    var state = (ViewBag.LineState as Dictionary<string, (int On, int Stale)>) ?? new();
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Services & items"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Services & items"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("PriceLists")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-price-tag fs-4"></i>@T["Price lists"]</a>
            @if (canManage)
            {
                <button type="button" class="btn btn-sm btn-primary" data-join><i class="ki-outline ki-plus fs-4"></i>@T["Add from the inventory"]</button>
                <a href="@Url.Action("CreateItem", "Inventory")" class="btn btn-sm btn-light-primary" target="_blank"><i class="ki-outline ki-package fs-4"></i>@T["New item or consumable"]</a>
                <a href="@Url.Action("Services")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-plus fs-4"></i>@T["New service"]</a>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                <div class="mb-3 mb-md-0 fw-semibold pe-5">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Each item is defined once"]</h4>
                    <div class="fs-6 text-gray-700">@T["Services are created in the service catalogue. Any item already in the inventory joins as a medicine or a consumable, one at a time from the inventory or a whole category below; its selling price is the main-list price."]</div>
                </div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0"><span class="hp-num">@Model.Count</span>&nbsp;@T["items"]</span>
            </div>
        </div>

        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-6 fw-bold">
                    @foreach (var g in HospitalPriceGroups.All)
                    {
                        <li class="nav-item"><a class="nav-link text-active-primary py-4 me-6 @(g == tab ? "active" : "")" data-bs-toggle="tab" href="#cat_@g">@T["group:" + g] <span class="badge badge-light-primary fs-7 fw-bold ms-1 hp-num">@Model.Count(e => e.Group == g)</span></a></li>
                    }
                </ul>
            </div>
            <div class="card-body pt-4"><div class="tab-content">
                @foreach (var g in HospitalPriceGroups.All)
                {
                    var rows = Model.Where(e => e.Group == g).ToList();
                    <div class="tab-pane fade @(g == tab ? "show active" : "")" id="cat_@g" role="tabpanel">
                        @if (rows.Count == 0)
                        {
                            <div class="text-center py-10"><i class="ki-outline @(g == HospitalPriceGroups.Service ? "ki-price-tag" : "ki-capsule") fs-3x text-gray-300 mb-4 d-block"></i>
                                <div class="fs-6 fw-bold text-gray-700">@(g == HospitalPriceGroups.Service ? T["No services yet."] : T["Map an inventory category to the hospital below; its items appear here."])</div></div>
                        }
                        else
                        {
                            @* H128: table widget (demo39 widgets/tables) — the code rides under the name *@
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light">
                                    <th class="ps-4 rounded-start">@T["Item"]</th><th>@T["Type"]</th><th class="text-end">@T["Selling price"] (<span class="hp-num">@fac.Code</span>)</th>@if (g == HospitalPriceGroups.Medicine) {<th class="text-end">@T["Public price"]</th>}<th class="pe-4 rounded-end">@T["On other lists"]</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var e in rows)
                                    {
                                        var st = state.GetValueOrDefault(e.Key);
                                        <tr>
                                            <td class="ps-4"><div class="d-flex align-items-center">
                                                <div class="symbol symbol-40px me-3 flex-shrink-0"><span class="symbol-label bg-light-@(g == HospitalPriceGroups.Service ? "primary" : g == HospitalPriceGroups.Medicine ? "success" : "info")"><i class="ki-outline @(g == HospitalPriceGroups.Service ? "ki-price-tag" : g == HospitalPriceGroups.Medicine ? "ki-capsule" : "ki-package") fs-2 text-@(g == HospitalPriceGroups.Service ? "primary" : g == HospitalPriceGroups.Medicine ? "success" : "info")"></i></span></div>
                                                <div class="d-flex flex-column"><a href="@Url.Action("CatalogEntry", new { key = e.Key })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(e.Name, e.NameEn)</a><bdi class="text-muted fw-semibold d-block fs-7 hp-num" dir="ltr" style="text-align:start">@e.Code</bdi></div></div></td>
                                            <td class="text-gray-700 fw-semibold fs-7">@(g == HospitalPriceGroups.Service ? T["cat:" + e.Category].Value : T["group:" + g].Value)</td>
                                            <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@fac.Format(e.MainPrice)</span></td>
                                            @if (g == HospitalPriceGroups.Medicine) {<td class="text-end hp-num text-gray-700 fw-semibold">@(e.PublicPrice is decimal pp ? fac.Format(pp) : "—")</td>}
                                            <td class="pe-4"><span class="badge badge-light fs-7 fw-bold hp-num">@T["{0} of {1}", st.On, lists.Count]</span>@if (st.Stale > 0) {<span class="badge badge-light-danger fs-7 fw-bold ms-2"><span class="hp-num">@st.Stale</span>&nbsp;@T["not updated (count)"]</span>}@if (st.On < lists.Count) {<span class="badge badge-light-info fs-7 fw-bold ms-2">@T["New — not added"]</span>}</td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                    </div>
                }
            </div></div>
        </div>

        @if (canManage)
        {
            <div class="card card-flush">
                <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Inventory categories in the hospital"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Every active item of a mapped category is a hospital medicine or consumable, priced at its selling price on the main list"]</span>
                </h3>
                    <div class="card-toolbar"><button type="button" class="btn btn-sm btn-primary" data-save-map><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div>
                </div>
                <div class="card-body pt-2">
                    @if (categories.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-category fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Inventory has no categories yet."]</div></div> }
                    else
                    {
                        <div class="row g-4" id="catMap">
                            @foreach (var c in categories)
                            {
                                var k = mapped.GetValueOrDefault(c.Id);
                                @* The picker sits under the name at the card's full width: "Not hospital" never gets cut. *@
                                <div class="col-md-6 col-xl-4"><div class="d-flex flex-column gap-2 h-100 border border-dashed border-gray-300 rounded p-4">
                                    <div class="d-flex align-items-center gap-3"><div class="symbol symbol-35px flex-shrink-0"><span class="symbol-label bg-light-@(k == null ? "secondary" : "primary")"><i class="ki-outline ki-category fs-3 text-@(k == null ? "gray-600" : "primary")"></i></span></div>
                                        <div class="d-flex flex-column min-w-0"><span class="text-gray-800 fw-bold fs-6">@DisplayName.Of(c.Name, c.NameEn)</span><bdi class="text-muted fw-semibold fs-7 hp-num">@c.Label</bdi></div></div>
                                    <select class="form-select form-select-sm form-select-solid" data-cat="@c.Id">
                                        <option value="">@T["Not hospital"]</option>
                                        @foreach (var kind in HospitalPriceGroups.ItemKinds) { <option value="@kind" selected="@(k == kind)">@T["group:" + kind]</option> }
                                    </select>
                                </div></div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div></div>
</div>

@if (canManage)
{
    <div class="modal fade" id="joinModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-8 text-center"><h1 class="mb-3">@T["Add from the inventory"]</h1>
                <div class="text-gray-500 fw-semibold fs-6">@T["Any item already in the inventory, whatever its category. Choose whether it is a medicine or a consumable: that decides which of the list's percentages prices it."]</div></div>
            <div class="position-relative mb-4"><i class="ki-outline ki-magnifier fs-3 text-gray-500 position-absolute top-50 translate-middle-y ms-4"></i>
                <input type="text" class="form-control form-control-solid ps-12" data-inv-q autocomplete="off" placeholder="@T["Search by code, barcode or name"]" /></div>
            <div class="table-responsive mh-350px overflow-auto"><table class="table align-middle gs-0 gy-3 fs-7 mb-0">
                <thead><tr class="fw-bold text-muted bg-light"><th class="w-30px ps-4 rounded-start"></th><th>@T["Item"]</th><th>@T["Category"]</th><th style="text-align:end">@T["Main price"] (<span class="hp-num">@fac.Code</span>)</th><th class="w-175px pe-4 rounded-end">@T["Type"]</th></tr></thead>
                <tbody data-inv-rows><tr><td colspan="5" class="text-center text-muted py-8">@T["Type at least two letters to search."]</td></tr></tbody>
            </table></div>
            <div class="mt-4"><span class="badge badge-light-primary fs-7 fw-bold"><span data-inv-count class="hp-num">0</span>&nbsp;@T["items selected"]</span></div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-join-save><i class="ki-outline ki-plus fs-4"></i>@T["Add selected"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            var url = @Json.Serialize(Url.Action("SaveItemCategories"));
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function swap() {
                var active = document.querySelector('.nav-line-tabs .nav-link.active'), tab = active ? active.getAttribute('href').replace('#cat_', '') : '';
                return fetch(location.pathname + (tab ? '?tab=' + tab : ''), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (fresh) document.getElementById('kt_app_content').innerHTML = fresh.innerHTML;
                    if (window.jQuery && jQuery.fn.select2) jQuery('#kt_app_content select.form-select:not([data-no-select2])').select2({ minimumResultsForSearch: Infinity, width: '100%', dir: document.documentElement.dir === 'rtl' ? 'rtl' : 'ltr', dropdownParent: jQuery(document.body) });
                });
            }
            // Any inventory item joins the catalogue: the same search as a price list's, ticks kept across searches
            var W2 = { none: @Json.Serialize(T["Nothing matches."].Value), inCat: @Json.Serialize(T["In the hospital catalogue"].Value), notIn: @Json.Serialize(T["Not in the hospital catalogue yet"].Value),
                choose: @Json.Serialize(T["Choose the items to add"].Value), kinds: { Medicine: @Json.Serialize(T["group:Medicine"].Value), Consumable: @Json.Serialize(T["group:Consumable"].Value) } };
            var inv = { picked: {}, last: [], timer: null }, searchUrl = @Json.Serialize(Url.Action("CatalogItemSearch")), joinUrl = @Json.Serialize(Url.Action("CatalogAddItems"));
            function esc(v) { var d = document.createElement('div'); d.textContent = v == null ? '' : String(v); return d.innerHTML; }
            function render() {
                var tb = document.querySelector('[data-inv-rows]'); if (!tb) return;
                document.querySelector('[data-inv-count]').textContent = Object.keys(inv.picked).length;
                if (!inv.last.length) { if (inv.searched) tb.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-8">' + esc(W2.none) + '</td></tr>'; return; }
                tb.innerHTML = inv.last.map(function (h) {
                    var kind = inv.picked[h.id] || h.kind || 'Medicine', on = h.onList;
                    var opts = ['Medicine', 'Consumable'].map(function (k) { return '<option value="' + k + '"' + (k === kind ? ' selected' : '') + '>' + esc(W2.kinds[k]) + '</option>'; }).join('');
                    return '<tr><td class="ps-4"><div class="form-check form-check-sm form-check-custom form-check-solid"><input type="checkbox" class="form-check-input" data-inv-pick="' + h.id + '"' + (on ? ' disabled' : '') + (inv.picked[h.id] ? ' checked' : '') + ' /></div></td>' +
                        '<td><span class="text-gray-900 fw-bold fs-6">' + esc(h.name) + '</span> <span class="badge ' + (on ? 'badge-light-success' : 'badge-light-info') + ' fs-8 fw-bold">' + esc(on ? W2.inCat : W2.notIn) + '</span><bdi class="text-muted fw-semibold d-block fs-7 hp-num">' + esc(h.code) + '</bdi></td>' +
                        '<td class="text-gray-600 fw-semibold">' + esc(h.category) + '</td><td class="hp-num text-gray-900 fw-bold" style="text-align:end">' + Number(h.price).toFixed(3) + '</td>' +
                        '<td class="pe-4"><select class="form-select form-select-sm form-select-solid" data-inv-kind="' + h.id + '"' + (on ? ' disabled' : '') + '>' + opts + '</select></td></tr>';
                }).join('');
                kinds(tb);
            }
            // H128: the kind of each found item is the theme's select2 inside the modal; its change reaches the listener below
            function kinds(scope) {
                if (!window.jQuery || !jQuery.fn.select2) return;
                var rtl = (document.documentElement.getAttribute('dir') || '').toLowerCase() === 'rtl', $m = jQuery('#joinModal');
                scope.querySelectorAll('select[data-inv-kind]').forEach(function (el) {
                    var $el = jQuery(el); if ($el.hasClass('select2-hidden-accessible')) return;
                    $el.select2({ width: '100%', dir: rtl ? 'rtl' : 'ltr', minimumResultsForSearch: Infinity, dropdownParent: $m.length ? $m : jQuery(document.body) });
                    $el.on('change.relay', function () { if (el.__relaying) return; el.__relaying = true; el.dispatchEvent(new Event('change', { bubbles: true })); el.__relaying = false; });
                });
            }
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-inv-q]')) return;
                clearTimeout(inv.timer); var q = e.target.value.trim();
                inv.timer = setTimeout(function () {
                    if (q.length < 2) { inv.last = []; inv.searched = false; render(); return; }
                    fetch(searchUrl + '?q=' + encodeURIComponent(q), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); })
                        .then(function (res) { inv.last = res.items || []; inv.searched = true; render(); });
                }, 300);
            });
            document.addEventListener('change', function (e) {
                var c = e.target.closest('[data-inv-pick]');
                if (c) { var id = c.getAttribute('data-inv-pick'); if (c.checked) inv.picked[id] = document.querySelector('[data-inv-kind="' + id + '"]').value; else delete inv.picked[id]; render(); return; }
                var k = e.target.closest('[data-inv-kind]'); if (k) { var kid = k.getAttribute('data-inv-kind'); if (inv.picked[kid]) inv.picked[kid] = k.value; }
            });
            document.addEventListener('click', function (e) {
                var j = e.target.closest('[data-join]');
                if (j) { bootstrap.Modal.getOrCreateInstance(document.getElementById('joinModal')).show(); return; }
                var js = e.target.closest('[data-join-save]');
                if (js) {
                    var items = Object.keys(inv.picked).map(function (id) { return { itemId: +id, kind: inv.picked[id] }; });
                    if (!items.length) { toast('error', W2.choose); return; }
                    js.disabled = true;
                    fetch(joinUrl, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ items: items }) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) {
                            js.disabled = false;
                            if (!res.ok) { toast('error', res.error || W.failed); return; }
                            bootstrap.Modal.getInstance(document.getElementById('joinModal')).hide();
                            inv.picked = {}; inv.last = []; inv.searched = false; document.querySelector('[data-inv-q]').value = ''; render();
                            toast('success', W.saved); swap();
                        });
                    return;
                }
                var t = e.target.closest('[data-save-map]'); if (!t) return;
                var map = {};
                document.querySelectorAll('[data-cat]').forEach(function (s) { if (s.value) map[s.getAttribute('data-cat')] = s.value; });
                t.disabled = true;
                fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ map: map }) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); });
            });
        })();
    </script>
}
