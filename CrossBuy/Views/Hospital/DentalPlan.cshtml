@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDentalPlanView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var r = Model.Row;
    ViewData["Title"] = T["Treatment plan"].Value + " " + r.Plan.PlanNo;
    bool canConsult = ViewBag.CanConsult == true, canDecide = ViewBag.CanDecide == true;
    string N(decimal v) => v.ToString("N" + r.Decimals, System.Globalization.CultureInfo.InvariantCulture);
    string St(string state) => state switch { "Accepted" => "success", "Partial" => "info", "Declined" => "secondary", _ => "primary" };
    var firstPending = Model.Phases.FirstOrDefault(p => p.Phase.Decision == HospitalDentalDecision.Pending && p.Lines.Any());
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Treatment plan"] <bdi class="hp-num">@r.Plan.PlanNo</bdi></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Dental")" class="text-muted text-hover-primary">@T["Dentistry"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("DentalPlans")" class="text-muted text-hover-primary">@T["Treatment plans"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><bdi class="hp-num">@r.Plan.PlanNo</bdi></li>
            </ul>
        </div>
        <div class="d-flex gap-2">
            @* the claim form (and any other layout of the plan) prints through Report Studio — see _ReportPrintMenu *@
            @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
            {
                ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDentalPlan,
                DocumentId = r.Plan.ID.ToString(),
                DocumentTitle = r.Plan.PlanNo,
            })
            <a href="@Url.Action("DentalChart", new { patientId = r.Plan.PatientId })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-emoji-happy fs-4"></i>@T["Patient chart"]</a>
            @if (canConsult) { <button type="button" class="btn btn-sm btn-primary" data-add-phase><i class="ki-outline ki-plus fs-4"></i>@T["Add a phase"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H127: the profile header — demo39 account/overview (photo · name and file number · details with icons · dashed figures) *@
        <div class="card mb-5"><div class="card-body pt-8 pb-4">
            <div class="d-flex flex-wrap flex-sm-nowrap">
                <div class="me-7 mb-4">
                    <a href="@Url.Action("DentalChart", new { patientId = r.Plan.PatientId })" class="symbol symbol-75px symbol-lg-100px symbol-circle symbol-fixed">
                        @if (r.PatientPhoto != null) {<img src="@r.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fs-2 fw-bold hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}
                    </a>
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <a href="@Url.Action("DentalChart", new { patientId = r.Plan.PatientId })" class="text-gray-900 text-hover-primary fs-2 fw-bold me-1">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a>
                        <span class="badge badge-light-primary fw-bold fs-7 hp-num" dir="ltr">@r.Mrn</span>
                        <span class="badge badge-light-@St(r.State) fw-bold fs-7">@T["plan:" + r.State]</span>
                    </div>
                    <div class="d-flex flex-wrap fw-semibold fs-6 mb-4 pe-2">
                        <span class="d-flex align-items-center text-gray-500 me-5 mb-2"><i class="ki-outline ki-document fs-4 me-1"></i>@T["Treatment plan"]&nbsp;<bdi class="hp-num text-gray-800 fw-bold">@r.Plan.PlanNo</bdi></span>
                        <span class="d-flex align-items-center text-gray-500 me-5 mb-2"><i class="ki-outline ki-shield-tick fs-4 me-1"></i>@(Model.Payer == null ? T["Self-pay"].Value : DisplayName.Of(Model.Payer, Model.PayerEn ?? Model.Payer))</span>
                    </div>
                    <div class="d-flex flex-wrap">
                        @foreach (var (label, value, icon, tone) in new[] { (T["Phases"].Value, Model.Phases.Count.ToString(), "ki-element-11", "primary"), (T["Plan total"].Value, N(r.Quote.Gross), "ki-bill", "info"),
                            (T["Estimated patient share"].Value, N(r.Quote.PatientShare), "ki-wallet", "success") })
                        {
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center"><i class="ki-outline @icon fs-3 text-@tone me-2"></i><div class="fs-2 fw-bold hp-num">@value</div></div>
                                <div class="fw-semibold fs-6 text-gray-500">@label</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div></div>

        <div class="row g-5">
            <div class="col-xl-8">
                @foreach (var ph in Model.Phases)
                {
                    var dec = ph.Phase.Decision;
                    @* H127: one phase — demo39 widgets/tables *@
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-800">@T["Phase"] <span class="hp-num">@ph.Phase.Seq</span> — @DisplayName.Of(ph.Phase.Title, ph.Phase.TitleEn)</span>
                                @if (ph.Phase.Signatory != null) { <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Signed by"] <bdi>@ph.Phase.Signatory</bdi> · <span class="hp-num">@ph.Phase.DecidedAt?.ToLocalTime().ToString("yyyy-MM-dd")</span></span> }
                            </h3>
                            <div class="card-toolbar gap-2">
                                @if (dec == HospitalDentalDecision.Accepted) { <span class="badge badge-light-success fs-7 fw-bold">@T["Accepted"]</span> }
                                else if (dec == HospitalDentalDecision.Declined) { <span class="badge badge-light-secondary fs-7 fw-bold">@T["Declined"]</span> }
                                else
                                {
                                    <span class="badge badge-light-primary fs-7 fw-bold">@T["Awaiting the patient"]</span>
                                    @if (canDecide && ph.Lines.Count > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-light-primary" data-decide="@ph.Phase.ID" data-accept="1" data-what="@DisplayName.Of(ph.Phase.Title, ph.Phase.TitleEn)"><i class="ki-outline ki-check fs-4"></i>@T["Accept"]</button>
                                        <button type="button" class="btn btn-sm btn-light" data-decide="@ph.Phase.ID" data-accept="0" data-what="@DisplayName.Of(ph.Phase.Title, ph.Phase.TitleEn)">@T["Decline"]</button>
                                    }
                                }
                            </div>
                        </div>
                        <div class="card-body pt-2">
                            @if (ph.Lines.Count == 0)
                            {
                                <div class="text-center py-8"><i class="ki-outline ki-element-plus fs-3x text-gray-300 mb-4 d-block"></i>
                                    <div class="fs-6 fw-bold text-gray-700">@T["No work in this phase yet: add it from the patient's chart."]</div></div>
                            }
                            else
                            {
                                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                    <thead><tr class="fw-bold text-muted bg-light">
                                        <th class="ps-4 rounded-start">@T["Procedure"]</th><th>@T["Surfaces"]</th><th>@T["By"]</th><th class="text-end">@T["Fee"]</th><th class="text-end">@T["Cover"]</th><th class="text-end">@T["Patient"]</th><th class="text-end pe-4 rounded-end"></th>
                                    </tr></thead>
                                    <tbody>
                                        @foreach (var l in ph.Lines)
                                        {
                                            var pr = l.Procedure.Procedure;
                                            var q = l.Quote;
                                            <tr>
                                                <td class="ps-4"><div class="d-flex align-items-center">
                                                    <div class="symbol symbol-45px me-4 flex-shrink-0" title="@T["Tooth"]">@if (l.Line.Tooth != null) {<span class="symbol-label bg-light-primary text-primary fw-bold fs-5 hp-num">@l.Line.Tooth</span>} else {<span class="symbol-label bg-light"><i class="ki-outline ki-abstract-26 fs-2 text-gray-500"></i></span>}</div>
                                                    <div class="d-flex flex-column">
                                                        <span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(l.Procedure.Name, l.Procedure.NameEn)</span>
                                                        <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num">@l.Procedure.Code</bdi> · @T["dcat:" + pr.Category]</span>
                                                        @if (pr.NeedsPreauth || pr.NeedsLab || pr.NotCovered || q?.Repeat == true)
                                                        {
                                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                                @if (pr.NeedsPreauth) { <span class="badge badge-light-primary fs-8 fw-bold">@T["Pre-auth"]</span> }
                                                                @if (pr.NeedsLab) { <span class="badge badge-light-info fs-8 fw-bold">@T["Lab"]</span> }
                                                                @if (pr.NotCovered) { <span class="badge badge-light fs-8 fw-bold">@T["Not covered"]</span> }
                                                                @if (q?.Repeat == true) { <span class="badge badge-light-danger fs-8 fw-bold">@T["Repeated within two years"]</span> }
                                                            </div>
                                                        }
                                                    </div>
                                                </div></td>
                                                <td>@if (l.Line.Surfaces != null) {<span class="badge badge-light-primary fs-7 fw-bold hp-num">@l.Line.Surfaces</span>} else {<span class="text-muted">—</span>}</td>
                                                <td>@if (l.By != null)
                                                    {
                                                        <div class="d-flex align-items-center gap-2"><div class="symbol symbol-30px symbol-circle flex-shrink-0">@if (l.By.Photo != null) {<img src="@l.By.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(l.By.NameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(l.By.NameEn)</span>}</div><span class="text-gray-800 fw-semibold fs-7">@DisplayName.Of(l.By.Name, l.By.NameEn)</span></div>
                                                    } else {<span class="text-muted">—</span>}</td>
                                                <td class="text-end"><span class="text-gray-800 fw-bold hp-num">@N(l.Line.Fee)</span></td>
                                                <td class="text-end">@if (q != null && q.CoverPct > 0) {<span class="badge badge-light-info fs-7 fw-bold hp-num">@q.CoverPct.ToString("0.##")%</span>} else {<span class="text-muted">—</span>}</td>
                                                <td class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num">@(q == null ? "—" : N(q.Fee - q.PayerShare))</span></td>
                                                <td class="text-end pe-4 text-nowrap">
                                                    @if (l.Line.Status == HospitalDentalLineStatus.Completed) { <span class="badge badge-light-success fs-7 fw-bold">@T["Done"]</span> }
                                                    else if (canConsult && dec == HospitalDentalDecision.Accepted) { <button type="button" class="btn btn-sm btn-light-primary" data-line-done="@l.Line.ID" data-what="@DisplayName.Of(l.Procedure.Name, l.Procedure.NameEn)"><i class="ki-outline ki-check fs-4"></i>@T["Mark done"]</button> }
                                                    else if (canConsult && dec == HospitalDentalDecision.Pending) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger" title="@T["Take out of the plan"]" data-bs-toggle="tooltip" data-line-cancel="@l.Line.ID" data-what="@DisplayName.Of(l.Procedure.Name, l.Procedure.NameEn)"><i class="ki-outline ki-cross fs-3"></i></button> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="col-xl-4">
                @* H127: the quotation — demo39 list widget *@
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Quotation"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@(Model.Payer == null ? T["Self-pay"].Value : DisplayName.Of(Model.Payer, Model.PayerEn ?? Model.Payer))</span></h3>
                    </div>
                    <div class="card-body pt-2">
                        @{ var quote = new[] { (T["Plan total"].Value, r.Quote.Gross, "bill", "primary"), (T["Estimated payer share"].Value, r.Quote.PayerShare, "shield-tick", "info"), (T["Estimated patient share"].Value, r.Quote.PatientShare, "wallet", "success") }; }
                        @for (int i = 0; i < quote.Length; i++)
                        {
                            var (label, v, icon, tone) = quote[i];
                            <div class="d-flex flex-stack">
                                <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@icon fs-3 text-@tone"></i></span></div>
                                <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                    <span class="text-gray-800 fw-bold fs-6">@label</span>
                                    <span class="text-nowrap"><span class="fw-bold fs-4 hp-num @(i == 2 ? "text-primary" : "text-gray-900")">@N(v)</span>&nbsp;<span class="fs-8 text-muted">@r.Currency</span></span>
                                </div>
                            </div>
                            if (i < quote.Length - 1) { <div class="separator separator-dashed my-3"></div> }
                        }
                        <div class="separator separator-dashed my-4"></div>
                        @if (Model.YearlyLimit is decimal lim && lim > 0)
                        {
                            <div class="text-gray-600 fw-semibold fs-7">@T["The payer share is capped at the yearly dental limit"] <span class="hp-num">@N(lim)</span>@if (Model.UsedThisYear > 0) {<text> · </text>@T["used this year"] <span class="hp-num">@N(Model.UsedThisYear)</span>}@if (r.Quote.Capped) {<text> — </text><span class="text-danger fw-bold">@T["the limit is reached"]</span>}</div>
                        }
                        else if (Model.Payer == null) { <div class="text-gray-600 fw-semibold fs-7">@T["Self-pay: the patient pays the whole plan."]</div> }
                        else { <div class="text-gray-600 fw-semibold fs-7">@T["This payer has no dental benefit set: the cover is shown as none."]</div> }
                        @if (canDecide && firstPending != null)
                        {
                            <div class="d-grid mt-6">
                                <button type="button" class="btn btn-primary" data-decide="@firstPending.Phase.ID" data-accept="1" data-what="@DisplayName.Of(firstPending.Phase.Title, firstPending.Phase.TitleEn)"><i class="ki-outline ki-check fs-4"></i>@T["Accept a phase with the patient's signature"]</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Dental billing rules"]</span></h3></div>
                    <div class="card-body pt-2">
                        @{ var rules = new[] { "Several restorations on one tooth bill as one multi-surface code, never one line per surface.", "A filling on the same surface is not repeated within two years (payer rule).", "Root canal, crown and surgical extraction need pre-authorisation with the X-ray.", "The record keeps complaint, diagnosis, plan and procedure with its date — a condition of payment." }; }
                        @for (int i = 0; i < rules.Length; i++)
                        {
                            <div class="d-flex align-items-start">
                                <div class="symbol symbol-30px me-4 flex-shrink-0"><span class="symbol-label bg-light-success"><i class="ki-outline ki-check fs-4 text-success"></i></span></div>
                                <span class="fs-7 fw-semibold text-gray-700 pt-1">@T[rules[i]]</span>
                            </div>
                            if (i < rules.Length - 1) { <div class="separator separator-dashed my-3"></div> }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@await Html.PartialAsync("_ReportPreviewModal", (object)(T["Treatment plan"].Value + " " + r.Plan.PlanNo))

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Dental")), planId = @r.Plan.ID;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                accept: @Json.Serialize(T["Who signs for the patient to accept \"{0}\"?"].Value), decline: @Json.Serialize(T["Who signs for the patient to decline \"{0}\"?"].Value),
                done: @Json.Serialize(T["Mark \"{0}\" done?"].Value), cancel: @Json.Serialize(T["Take \"{0}\" out of the plan?"].Value),
                phase: @Json.Serialize(T["The new phase's name in Arabic"].Value), phaseEn: @Json.Serialize(T["The new phase's name in English"].Value),
                name: @Json.Serialize(DisplayName.Of(r.PatientName, r.PatientNameEn)) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (x) { return x.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (x) { return x.text(); }).then(function (html) {
                    var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function done(btn) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); }; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-decide],[data-line-done],[data-line-cancel],[data-add-phase]'); if (!t) return;
                if (t.hasAttribute('data-decide')) {
                    var accept = t.getAttribute('data-accept') === '1';
                    cbPrompt((accept ? W.accept : W.decline).replace('{0}', t.getAttribute('data-what')), { kind: accept ? 'primary' : 'danger', value: W.name }).then(function (who) {
                        if (!who) return; t.disabled = true; post(root + '/Phase/' + t.getAttribute('data-decide') + '/Decide', { accept: accept, signatory: who }).then(done(t));
                    });
                    return;
                }
                if (t.hasAttribute('data-line-done')) {
                    cbConfirm(W.done.replace('{0}', t.getAttribute('data-what'))).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Line/' + t.getAttribute('data-line-done') + '/Done').then(done(t)); });
                    return;
                }
                if (t.hasAttribute('data-line-cancel')) {
                    cbConfirm(W.cancel.replace('{0}', t.getAttribute('data-what')), { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Line/' + t.getAttribute('data-line-cancel') + '/Cancel').then(done(t)); });
                    return;
                }
                cbPrompt(W.phase).then(function (ar) {
                    if (!ar) return;
                    cbPrompt(W.phaseEn).then(function (en) { if (!en) return; t.disabled = true; post(root + '/Plan/' + planId + '/Phase', { title: ar, titleEn: en }).then(done(t)); });
                });
            });
        })();
    </script>
}
