@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalDentalPlanView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var r = Model.Row;
    ViewData["Title"] = T["Treatment plan"].Value + " " + r.Plan.PlanNo;
    bool canConsult = ViewBag.CanConsult == true, canDecide = ViewBag.CanDecide == true;
    string N(decimal v) => v.ToString("N" + r.Decimals, System.Globalization.CultureInfo.InvariantCulture);
    string St(string state) => state switch { "Accepted" => "success", "Partial" => "info", "Declined" => "secondary", _ => "primary" };
    var firstPending = Model.Phases.FirstOrDefault(p => p.Phase.Decision == HospitalDentalDecision.Pending && p.Lines.Any());
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Treatment plan"] <span class="hp-num">@r.Plan.PlanNo</span></h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Dentistry"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("DentalPlans")" class="text-muted text-hover-primary">@T["Treatment plans"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted hp-num">@r.Plan.PlanNo</li>
            </ul>
        </div>
        <div class="d-flex gap-2">
            @* the claim form (and any other layout of the plan) prints through Report Studio — see _ReportPrintMenu *@
            @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel
            {
                ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDentalPlan,
                DocumentId = r.Plan.ID.ToString(),
                DocumentTitle = r.Plan.PlanNo,
            })
            <a href="@Url.Action("DentalChart", new { patientId = r.Plan.PatientId })" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-emoji-happy fs-4"></i>@T["Patient chart"]</a>
            @if (canConsult) { <button type="button" class="btn btn-sm btn-primary" data-add-phase><i class="ki-outline ki-plus fs-4"></i>@T["Add a phase"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card mb-5"><div class="card-body d-flex flex-wrap align-items-center gap-5 py-6">
            <a href="@Url.Action("DentalChart", new { patientId = r.Plan.PatientId })" class="d-flex align-items-center gap-4 text-hover-primary">
                <div class="symbol symbol-50px symbol-circle flex-shrink-0">@if (r.PatientPhoto != null) {<img src="@r.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                <div><div class="fw-bold fs-5 text-gray-900">@DisplayName.Of(r.PatientName, r.PatientNameEn)</div>
                    <div class="text-muted fs-7"><span class="hp-num">@r.Mrn</span> · @(Model.Payer == null ? T["Self-pay"].Value : DisplayName.Of(Model.Payer, Model.PayerEn ?? Model.Payer))</div></div>
            </a>
            <span class="ms-auto badge badge-light-@St(r.State) fs-7">@T["plan:" + r.State]</span>
        </div></div>

        <div class="row g-5">
            <div class="col-xl-8">
                @foreach (var ph in Model.Phases)
                {
                    var dec = ph.Phase.Decision;
                    <div class="card mb-5">
                        <div class="card-header border-0 pt-6">
                            <div class="card-title align-items-start flex-column m-0">
                                <span class="card-label fw-bold text-gray-900 fs-4">@T["Phase"] <span class="hp-num">@ph.Phase.Seq</span> — @DisplayName.Of(ph.Phase.Title, ph.Phase.TitleEn)</span>
                                @if (ph.Phase.Signatory != null) { <span class="text-muted mt-1 fw-semibold fs-8">@T["Signed by"] @ph.Phase.Signatory · <span class="hp-num">@ph.Phase.DecidedAt?.ToLocalTime().ToString("yyyy-MM-dd")</span></span> }
                            </div>
                            <div class="card-toolbar gap-2">
                                @if (dec == HospitalDentalDecision.Accepted) { <span class="badge badge-success fs-8">@T["Accepted"]</span> }
                                else if (dec == HospitalDentalDecision.Declined) { <span class="badge badge-secondary fs-8">@T["Declined"]</span> }
                                else
                                {
                                    <span class="badge badge-primary fs-8">@T["Awaiting the patient"]</span>
                                    @if (canDecide && ph.Lines.Count > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-light-primary py-1 px-3" data-decide="@ph.Phase.ID" data-accept="1" data-what="@DisplayName.Of(ph.Phase.Title, ph.Phase.TitleEn)">@T["Accept"]</button>
                                        <button type="button" class="btn btn-sm btn-light py-1 px-3" data-decide="@ph.Phase.ID" data-accept="0" data-what="@DisplayName.Of(ph.Phase.Title, ph.Phase.TitleEn)">@T["Decline"]</button>
                                    }
                                }
                            </div>
                        </div>
                        <div class="card-body pt-2">
                            @if (ph.Lines.Count == 0) { <div class="text-center text-muted py-6">@T["No work in this phase yet: add it from the patient's chart."]</div> }
                            else
                            {
                                <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                                    <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                                        <th class="w-70px">@T["Tooth"]</th><th class="w-80px">@T["Surfaces"]</th><th>@T["Procedure"]</th><th>@T["By"]</th><th class="text-end">@T["Fee"]</th><th class="text-end">@T["Cover"]</th><th class="text-end">@T["Patient"]</th><th class="text-end"></th>
                                    </tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                        @foreach (var l in ph.Lines)
                                        {
                                            var pr = l.Procedure.Procedure;
                                            var q = l.Quote;
                                            <tr>
                                                <td>@if (l.Line.Tooth != null) {<span class="hp-num fw-bold fs-5">@l.Line.Tooth</span>} else {<span class="text-muted">—</span>}</td>
                                                <td>@if (l.Line.Surfaces != null) {<span class="badge hp-code hp-num">@l.Line.Surfaces</span>} else {<text>—</text>}</td>
                                                <td><div class="fw-semibold text-gray-800">@DisplayName.Of(l.Procedure.Name, l.Procedure.NameEn)</div>
                                                    <div class="text-muted fs-8"><span class="hp-num">@l.Procedure.Code</span> · @T["dcat:" + pr.Category]</div>
                                                    @if (pr.NeedsPreauth) { <span class="badge badge-light-primary fs-9 me-1">@T["Pre-auth"]</span> }
                                                    @if (pr.NeedsLab) { <span class="badge badge-light-info fs-9 me-1">@T["Lab"]</span> }
                                                    @if (pr.NotCovered) { <span class="badge badge-light fs-9 me-1">@T["Not covered"]</span> }
                                                    @if (q?.Repeat == true) { <span class="badge badge-light-danger fs-9">@T["Repeated within two years"]</span> }</td>
                                                <td>@if (l.By != null)
                                                    {
                                                        <div class="d-flex align-items-center gap-2"><div class="symbol symbol-25px symbol-circle flex-shrink-0">@if (l.By.Photo != null) {<img src="@l.By.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(l.By.NameEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(l.By.NameEn)</span>}</div><span class="fs-7">@DisplayName.Of(l.By.Name, l.By.NameEn)</span></div>
                                                    } else {<text>—</text>}</td>
                                                <td class="text-end"><span class="hp-num">@N(l.Line.Fee)</span></td>
                                                <td class="text-end">@if (q != null && q.CoverPct > 0) {<span class="hp-num">@q.CoverPct.ToString("0.##")%</span>} else {<span class="text-muted">—</span>}</td>
                                                <td class="text-end"><span class="hp-num fw-bold">@(q == null ? "—" : N(q.Fee - q.PayerShare))</span></td>
                                                <td class="text-end text-nowrap">
                                                    @if (l.Line.Status == HospitalDentalLineStatus.Completed) { <span class="badge badge-success fs-8">@T["Done"]</span> }
                                                    else if (canConsult && dec == HospitalDentalDecision.Accepted) { <button type="button" class="btn btn-sm btn-light-primary py-1 px-3" data-line-done="@l.Line.ID" data-what="@DisplayName.Of(l.Procedure.Name, l.Procedure.NameEn)"><i class="ki-outline ki-check fs-5"></i>@T["Mark done"]</button> }
                                                    else if (canConsult && dec == HospitalDentalDecision.Pending) { <button type="button" class="btn btn-icon btn-sm btn-active-light-danger" title="@T["Take out of the plan"]" data-line-cancel="@l.Line.ID" data-what="@DisplayName.Of(l.Procedure.Name, l.Procedure.NameEn)"><i class="ki-outline ki-cross fs-4"></i></button> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="col-xl-4">
                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Quotation"]</span></div></div>
                    <div class="card-body pt-2">
                        @foreach (var (label, v, i) in new[] { (T["Plan total"].Value, r.Quote.Gross, 0), (T["Estimated payer share"].Value, r.Quote.PayerShare, 1), (T["Estimated patient share"].Value, r.Quote.PatientShare, 2) })
                        {
                            <div class="d-flex flex-stack py-3 border-bottom border-gray-200"><span class="fw-semibold text-gray-700">@label</span><span class="fw-bold fs-4 hp-num @(i == 2 ? "text-primary" : "text-gray-900")">@N(v) <span class="fs-8 text-muted">@r.Currency</span></span></div>
                        }
                        @if (Model.YearlyLimit is decimal lim && lim > 0)
                        {
                            <div class="text-muted fs-8 mt-3">@T["The payer share is capped at the yearly dental limit"] <span class="hp-num">@N(lim)</span>@if (Model.UsedThisYear > 0) {<text> · </text>@T["used this year"] <span class="hp-num">@N(Model.UsedThisYear)</span>}@if (r.Quote.Capped) {<text> — </text><span class="text-danger">@T["the limit is reached"]</span>}</div>
                        }
                        else if (Model.Payer == null) { <div class="text-muted fs-8 mt-3">@T["Self-pay: the patient pays the whole plan."]</div> }
                        else { <div class="text-muted fs-8 mt-3">@T["This payer has no dental benefit set: the cover is shown as none."]</div> }
                        <div class="d-grid gap-2 mt-5">
                            @if (canDecide && firstPending != null)
                            {
                                <button type="button" class="btn btn-primary" data-decide="@firstPending.Phase.ID" data-accept="1" data-what="@DisplayName.Of(firstPending.Phase.Title, firstPending.Phase.TitleEn)"><i class="ki-outline ki-check fs-4"></i>@T["Accept a phase with the patient's signature"]</button>
                            }
                        </div>
                    </div>
                </div>
                <div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Dental billing rules"]</span></div></div>
                    <div class="card-body pt-2">
                        @foreach (var rule in new[] { "Several restorations on one tooth bill as one multi-surface code, never one line per surface.", "A filling on the same surface is not repeated within two years (payer rule).", "Root canal, crown and surgical extraction need pre-authorisation with the X-ray.", "The record keeps complaint, diagnosis, plan and procedure with its date — a condition of payment." })
                        {
                            <div class="d-flex gap-2 py-2"><i class="ki-outline ki-check-circle fs-4 text-success"></i><span class="fs-7 text-gray-700">@T[rule]</span></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

@await Html.PartialAsync("_ReportPreviewModal", (object)(T["Treatment plan"].Value + " " + r.Plan.PlanNo))

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Dental")), planId = @r.Plan.ID;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                accept: @Json.Serialize(T["Who signs for the patient to accept \"{0}\"?"].Value), decline: @Json.Serialize(T["Who signs for the patient to decline \"{0}\"?"].Value),
                done: @Json.Serialize(T["Mark \"{0}\" done?"].Value), cancel: @Json.Serialize(T["Take \"{0}\" out of the plan?"].Value),
                phase: @Json.Serialize(T["The new phase's name in Arabic"].Value), phaseEn: @Json.Serialize(T["The new phase's name in English"].Value),
                name: @Json.Serialize(DisplayName.Of(r.PatientName, r.PatientNameEn)) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (x) { return x.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (x) { return x.text(); }).then(function (html) {
                    var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                });
            }
            function done(btn) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); }; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-decide],[data-line-done],[data-line-cancel],[data-add-phase]'); if (!t) return;
                if (t.hasAttribute('data-decide')) {
                    var accept = t.getAttribute('data-accept') === '1';
                    cbPrompt((accept ? W.accept : W.decline).replace('{0}', t.getAttribute('data-what')), { kind: accept ? 'primary' : 'danger', value: W.name }).then(function (who) {
                        if (!who) return; t.disabled = true; post(root + '/Phase/' + t.getAttribute('data-decide') + '/Decide', { accept: accept, signatory: who }).then(done(t));
                    });
                    return;
                }
                if (t.hasAttribute('data-line-done')) {
                    cbConfirm(W.done.replace('{0}', t.getAttribute('data-what'))).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Line/' + t.getAttribute('data-line-done') + '/Done').then(done(t)); });
                    return;
                }
                if (t.hasAttribute('data-line-cancel')) {
                    cbConfirm(W.cancel.replace('{0}', t.getAttribute('data-what')), { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Line/' + t.getAttribute('data-line-cancel') + '/Cancel').then(done(t)); });
                    return;
                }
                cbPrompt(W.phase).then(function (ar) {
                    if (!ar) return;
                    cbPrompt(W.phaseEn).then(function (en) { if (!en) return; t.disabled = true; post(root + '/Plan/' + planId + '/Phase', { title: ar, titleEn: en }).then(done(t)); });
                });
            });
        })();
    </script>
}
