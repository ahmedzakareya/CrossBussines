@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalBedsideScanRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H205 — bedside scanning: each ward's compliance (doses scanned over doses given; the HIMSS line is 95 %) as theme stat
    cards, then every scan in a table widget with search, filters and pages — a refused scan is a near-miss.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Bedside scanning"].Value;
    var rows = (ViewBag.Compliance as List<(HospitalWardOption? Ward, HospitalScanCompliance? Meds)>) ?? new();
    var wards = (ViewBag.Wards as IReadOnlyList<HospitalWardOption>) ?? Array.Empty<HospitalWardOption>();
    int? ward = ViewBag.Ward as int?; string kind = ViewBag.Kind as string ?? "", outcome = ViewBag.Outcome as string ?? "", q = ViewBag.Q as string ?? "";
    int days = (int)ViewBag.Days, page = (int)ViewBag.Page, pages = (int)ViewBag.Pages, total = (int)ViewBag.Total;
    bool ready = ViewBag.Ready == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Link(int p) => Url.Action("BedsideScans", new { ward, kind, outcome, q, days, page = p })!;
    string Tone(string o) => o switch { HospitalBedsideScanOutcome.Matched => "primary", HospitalBedsideScanOutcome.Refused => "danger", _ => "info" };
    string Detail(HospitalBedsideScan s)
    {
        if (string.IsNullOrEmpty(s.Detail)) return "";
        if (s.Outcome != HospitalBedsideScanOutcome.Refused) return s.Detail;
        var p = s.Detail.Split('\t');
        return p.Length == 1 ? T[p[0]].Value : string.Format(T[p[0]].Value, p[1..].Select(a => (object)("⁦" + a + "⁩")).ToArray());
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Bedside scanning"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Nursing")" class="text-muted text-hover-primary">@T["Nursing"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Bedside scanning"]</li>
            </ul>
        </div>
        <div class="d-flex gap-2">
            @foreach (var d in new[] { 7, 30, 90 }) {<a href="@Url.Action("BedsideScans", new { ward, kind, outcome, q, days = d })" class="btn btn-sm @(d == days ? "btn-primary" : "btn-light")">@T["{0} days", d]</a>}
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-scan-barcode fs-2tx text-primary me-4"></i>
            <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Every dose is scanned at the bedside: the patient's wristband and the medicine's pack"]</h4>
                <div class="fs-6 text-gray-700">@T["A wrong patient, a wrong medicine, an expired or recalled pack stops the dose and is kept here. A dose given without the scan needs its reason and counts against the ward. The target is 95%."]</div></div>
        </div>
        @if (!ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["The bedside scanning table is not created yet (hospital_h205_bedside_scans.sql)."]</div></div>
        }
        else
        {
            <div class="row g-5 mb-5">
                @foreach (var (w, c) in rows)
                {
                    bool low = c?.Percent is double pc && pc < HospitalBedsideScanRules.Target;
                    <div class="col-sm-6 col-xl-3"><a href="@Url.Action("BedsideScans", new { ward = w?.Id, days })" class="card card-flush h-100 text-hover-primary @(w?.Id == ward && (w != null || ward == null) ? "border border-primary" : "")">
                        <div class="card-body d-flex flex-column justify-content-between py-6">
                            <div class="d-flex flex-stack mb-3"><span class="fs-6 fw-bold text-gray-800">@(w == null ? T["All wards"].Value : DisplayName.Of(w.Name, w.NameEn))</span>
                                @if (c?.Refused > 0) {<span class="badge badge-light-danger fw-bold">@T["{0} stopped", c.Refused]</span>}</div>
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="fs-2hx fw-bold hp-num @(low ? "text-danger" : "text-gray-900")" dir="ltr">@(c?.Percent is double p ? p.ToString("0.#", inv) + "%" : "—")</span>
                            </div>
                            <div class="text-muted fs-7">@T["{0} scanned · {1} without the scan", c?.Matched ?? 0, c?.Overrides ?? 0]</div>
                        </div></a></div>
                }
            </div>
        }
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Scan log"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} scans", total]</span>
                </h3>
                <form class="card-toolbar gap-2 flex-wrap" method="get" action="@Url.Action("BedsideScans")">
                    <input type="hidden" name="days" value="@days" />
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" name="q" value="@q" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Patient or pack"]" /></div>
                    <div class="w-150px"><select name="ward" class="form-select form-select-solid" data-control="select2" data-placeholder="@T["All wards"]" onchange="this.form.submit()"><option value="">@T["All wards"]</option>@foreach (var w in wards) {<option value="@w.Id" selected="@(w.Id == ward)">@DisplayName.Of(w.Name, w.NameEn)</option>}</select></div>
                    <div class="w-150px"><select name="outcome" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="@T["All"]" onchange="this.form.submit()"><option value="">@T["All"]</option>@foreach (var o in HospitalBedsideScanOutcome.All) {<option value="@o" selected="@(o == outcome)">@T["bso:" + o]</option>}</select></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-scan-barcode fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No scan in this period."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-3 my-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 min-w-100px rounded-start">@T["When"]</th><th class="min-w-150px">@T["Patient"]</th><th class="min-w-100px">@T["Step"]</th><th class="min-w-150px">@T["Scanned"]</th><th class="min-w-100px">@T["Result"]</th><th class="min-w-200px pe-4 rounded-end">@T["Detail"]</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var s = r.Scan;
                                <tr>
                                    <td class="ps-4 text-nowrap"><span class="hp-num text-gray-800" dir="ltr">@HospitalNursingService.UtcToWard(s.At).ToString("MM-dd HH:mm")</span>@if (r.By != null) {<div class="text-muted fs-8">@r.By</div>}</td>
                                    <td><span class="text-gray-900 fw-bold d-block fs-7">@DisplayName.Of(r.Patient, r.PatientEn)</span><bdi class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn</bdi></td>
                                    <td><span class="badge badge-light fw-semibold">@T["bsk:" + s.Kind]</span></td>
                                    <td class="fs-8 text-gray-700"><div><span class="text-muted">@T["Wristband"]</span> <bdi class="hp-num" dir="ltr">@(s.Wristband ?? "—")</bdi></div>
                                        <div><span class="text-muted">@T["Pack"]</span> <bdi class="hp-num" dir="ltr">@(s.Gtin ?? s.Item ?? "—")</bdi>@if (s.BatchNo != null) {<text> · </text><bdi class="hp-num" dir="ltr">@s.BatchNo</bdi>}</div></td>
                                    <td><span class="badge badge-light-@Tone(s.Outcome) fs-7 fw-bold">@T["bso:" + s.Outcome]</span></td>
                                    <td class="fs-7 text-gray-700 pe-4"><bdi>@Detail(s)</bdi></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination pt-6 justify-content-end">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int p = Math.Max(1, page - 3); p <= Math.Min(pages, page + 3); p++) {<li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>
