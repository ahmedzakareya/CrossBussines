@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalPatient
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var name = DisplayName.Of(Model.Name, Model.NameEn);
    ViewData["Title"] = name;

    // The patient is a Communication Platform subject: the shared entity panel, answered by this module.
    ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.HospitalPatient;
    ViewBag.ConversationEntityId = Model.ID;
    ViewBag.ConversationListUrl = Url.Action("PatientConversation", new { id = Model.ID });
    ViewBag.ConversationAddUrl = Url.Action("PatientConversationAdd", new { id = Model.ID });
    ViewBag.ConversationReactUrl = Url.Action("PatientConversationReact", new { id = Model.ID });
    bool canRegister = ViewBag.CanRegister == true;
    var age = HospitalPatientService.AgeOn(Model.BirthDate, DateTime.UtcNow);
    var log = (ViewBag.AccessLog as IReadOnlyList<HospitalPatientAccessView>) ?? Array.Empty<HospitalPatientAccessView>();
    var people = (ViewBag.People as Dictionary<int, string>) ?? new();
    var photos = (ViewBag.Photos as Dictionary<int, string>) ?? new();
    string? nationality = ViewBag.Nationality as string;
    string[] Lines(string? s) => (s ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var allergies = Lines(Model.Allergies);
    var chronic = Lines(Model.ChronicConditions);
    var parts = Model.NameEn.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = ((parts.Length > 0 ? parts[0][..1] : "") + (parts.Length > 1 ? parts[1][..1] : "")).ToUpperInvariant();
    bool canAdmit = ViewBag.CanAdmit == true;
    var current = ViewBag.Current as (HospitalAdmission Admission, HospitalBedStay Stay, string RoomNumber, string BedCode)?;
    var whereNow = (ViewBag.Now as IReadOnlyList<HospitalWhere>) ?? Array.Empty<HospitalWhere>();   // H114
    bool isArNow = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var stays = (ViewBag.Stays as IReadOnlyList<HospitalStayView>) ?? Array.Empty<HospitalStayView>();
    var sick = (ViewBag.SickLeaves as IReadOnlyList<HospitalSickLeaveRow>) ?? Array.Empty<HospitalSickLeaveRow>();   // H56
    bool sickReady = ViewBag.SickReady == true, canConsult = ViewBag.CanConsult == true;
    var consents = (ViewBag.Consents as IReadOnlyList<HospitalConsentRow>) ?? Array.Empty<HospitalConsentRow>();   // H60
    bool consentsReady = ViewBag.ConsentsReady == true;
    // H64: a restricted file — its banner, how this reader got in, and the administrator's restrict / lift
    var restriction = ViewBag.Restriction as HospitalRestrictedFile;
    string fileAccess = ViewBag.FileAccess as string ?? HospitalFileAccess.Open;
    // H155: a reception-only reader sees the administrative file; results, imaging and diagnoses are the care team's
    bool canClinical = ViewBag.CanClinical != false;
    var glassUntil = ViewBag.GlassUntil as DateTime?;
    bool canManageFile = ViewBag.CanManage == true;
    var appointments = (ViewBag.Appointments as IReadOnlyList<HospitalAppointmentView>) ?? Array.Empty<HospitalAppointmentView>();
    var doctors = (ViewBag.Doctors as Dictionary<int, HospitalPractitionerView>) ?? new();
    var visits = (ViewBag.Visits as IReadOnlyList<HospitalEncounterSummary>) ?? Array.Empty<HospitalEncounterSummary>();
    var bills = (ViewBag.Bills as IReadOnlyList<HospitalBillRow>) ?? Array.Empty<HospitalBillRow>();
    var rad = (ViewBag.Rad as HospitalRadHistory) ?? new HospitalRadHistory(Array.Empty<HospitalRadOrder>(), 0, false);
    var lab = (ViewBag.Lab as HospitalLabHistory) ?? new HospitalLabHistory(Array.Empty<(HospitalLabOrder, IReadOnlyList<HospitalLabResult>)>(), 0, false);
    var billCurrency = ViewBag.Currency as HospitalCurrency;
    string BM(decimal v) => billCurrency == null ? v.ToString("N2") : billCurrency.Format(v);
    string Initials(string n) { var q = n.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return ((q.Length > 0 ? q[0][..1] : "") + (q.Length > 1 ? q[1][..1] : "")).ToUpperInvariant(); }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@name</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Patients")" class="text-muted text-hover-primary">@T["Patients"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted hp-num">@Model.Mrn</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @* printing — every paper of this patient in one place (Report Studio layouts, see _ReportPrintMenu) *@
            @if (ViewBag.PrintBillId is int pBill) { @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalBill, ButtonLabel = T["Bill"].Value, DocumentId = pBill.ToString(), DocumentTitle = T["Bill"].Value }) }
            @if (ViewBag.PrintEncounterId is int pVisit) { @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalConsult, ButtonLabel = T["Prescription"].Value, DocumentId = pVisit.ToString(), DocumentTitle = T["Prescription"].Value }) }
            @if (ViewBag.PrintPlanId is int pPlan) { @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalDentalPlan, ButtonLabel = T["Dental claim"].Value, DocumentId = pPlan.ToString(), DocumentTitle = T["Treatment plan"].Value }) }
            @if (canAdmit && current == null && Model.DeceasedAt == null)
            {
                <button type="button" class="btn btn-sm btn-primary" data-admit-me><i class="ki-outline ki-entrance-left fs-4"></i>@T["Accommodate a patient"]</button>
            }
            @if (canAdmit && current != null)
            {
                <button type="button" class="btn btn-sm btn-light-primary" data-transfer-me="@current.Value.Admission.ID"><i class="ki-outline ki-arrows-loop fs-4"></i>@T["Transfer"]</button>
                <button type="button" class="btn btn-sm btn-light" data-discharge-me="@current.Value.Admission.ID"><i class="ki-outline ki-exit-right fs-4"></i>@T["Discharge"]</button>
            }
            @if (canRegister)
            {
                <a href="@Url.Action("EditPatient", new { id = Model.ID })" class="btn btn-sm btn-light"><i class="ki-outline ki-pencil fs-4"></i>@T["Edit file"]</a>
            }
            @if (canManageFile)
            {
                if (restriction == null) { <button type="button" class="btn btn-sm btn-light" data-file-restrict data-ask="@T["Why is this file restricted? Only its care team and those allowed confidential files will open it; anyone else needs an emergency opening."]"><i class="ki-outline ki-lock fs-4"></i>@T["Restrict the file"]</button> }
                else { <button type="button" class="btn btn-sm btn-light" data-file-unrestrict data-ask="@T["Lift the restriction on this file?"]"><i class="ki-outline ki-lock-3 fs-4"></i>@T["Lift the restriction"]</button> }
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (whereNow.Count > 0)
        {
            @* H114: where the patient is this minute — the most immediate place first *@
            <div class="notice d-flex flex-wrap align-items-center gap-4 rounded border border-primary border-dashed bg-light-primary px-5 py-3 mb-5">
                <span class="fw-bold text-primary fs-6"><i class="ki-outline ki-geolocation fs-3 text-primary me-1"></i>@T["Now:"]</span>
                @foreach (var w in whereNow)
                {
                    <span class="fs-7 text-gray-800"><span class="fw-bold">@T["where:" + w.Kind]</span> · <bdi>@(isArNow ? w.Place : w.PlaceEn)</bdi>@if ((isArNow ? w.Detail : w.DetailEn) is string d) {<text> · <bdi class="text-muted">@d</bdi></text>}@if (w.Live) {<span class="badge badge-light-primary fs-9 ms-1">@T["now"]</span>}</span>
                }
            </div>
        }

        @* H126: the profile header — demo39 account/overview (photo · name and file number · details with icons · dashed figures) *@
        <div class="card mb-5"><div class="card-body pt-9 pb-6">
            <div class="d-flex flex-wrap flex-sm-nowrap">
                <div class="me-7 mb-4">
                    <label class="symbol symbol-100px symbol-lg-125px symbol-circle symbol-fixed position-relative m-0 @(canRegister ? "hp-photo-edit" : "")" title="@(canRegister ? T["Change photo"].Value : "")">
                        @if (Model.PhotoPath != null) { <img src="@Model.PhotoPath" alt="@name" style="object-fit:cover" data-photo-img /> }
                        else { <span class="symbol-label fs-1 fw-bold bg-light-primary text-primary" data-photo-img>@initials</span> }
                        @if (canRegister)
                        {
                            <span class="hp-photo-btn"><i class="ki-outline ki-picture fs-6 text-white"></i></span>
                            <input type="file" accept="image/jpeg,image/png,image/webp" class="d-none" data-photo-input />
                        }
                        @if (current != null) {<div class="position-absolute translate-middle bottom-0 start-100 mb-6 bg-primary rounded-circle border border-4 border-body h-20px w-20px" title="@T["Admitted"]"></div>}
                    </label>
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="text-gray-900 fs-2 fw-bold me-1">@name</span>
                        <span class="badge badge-light-primary fw-bold fs-7 hp-num" dir="ltr">@Model.Mrn</span>
                        @if (Model.DeceasedAt != null) {<span class="badge badge-light-dark fw-bold fs-7">@T["Deceased"]</span>}
                        @if (restriction != null) {<span class="badge badge-light-danger fw-bold fs-7"><i class="ki-outline ki-lock-2 fs-7 text-danger me-1"></i>@T["Restricted file"]</span>}
                        @if (allergies.Length > 0) {<span class="badge badge-light-danger fw-bold fs-7"><i class="ki-outline ki-shield-cross fs-7 text-danger me-1"></i>@T["Allergy"]</span>}
                    </div>
                    <div class="d-flex flex-wrap fw-semibold fs-6 mb-4 pe-2">
                        <span class="d-flex align-items-center text-gray-500 me-5 mb-2"><i class="ki-outline ki-profile-circle fs-4 me-1"></i>@if (age != null) {<span class="hp-num">@age</span><text>&nbsp;@T["y"]&nbsp;·&nbsp;</text>}@(Model.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])</span>
                        @if (Model.BloodGroup != null) {<span class="d-flex align-items-center text-gray-500 me-5 mb-2"><i class="ki-outline ki-drop fs-4 me-1"></i>@T["Blood group"]&nbsp;<bdi class="hp-num text-gray-800 fw-bold" dir="ltr">@Model.BloodGroup</bdi></span>}
                        @if (nationality != null) {<span class="d-flex align-items-center text-gray-500 me-5 mb-2"><i class="ki-outline ki-flag fs-4 me-1"></i>@nationality</span>}
                        @if (Model.Phone != null) {<span class="d-flex align-items-center text-gray-500 me-5 mb-2"><i class="ki-outline ki-phone fs-4 me-1"></i><bdi class="hp-num" dir="ltr">@Model.Phone</bdi></span>}
                        @if (Model.NationalId != null) {<span class="d-flex align-items-center text-gray-500 me-5 mb-2"><i class="ki-outline ki-badge fs-4 me-1"></i><bdi class="hp-num" dir="ltr">@Model.NationalId</bdi></span>}
                        @if (current != null) {<span class="d-flex align-items-center text-primary fw-bold me-5 mb-2"><i class="ki-outline ki-geolocation fs-4 text-primary me-1"></i>@T["Room"]&nbsp;<bdi class="hp-num">@current.Value.RoomNumber</bdi>&nbsp;·&nbsp;@T["Bed"]&nbsp;<bdi class="hp-num">@current.Value.BedCode</bdi></span>}
                    </div>
                    <div class="d-flex flex-wrap">
                        @foreach (var (label, n, icon, tone) in new[] { (T["Visits"].Value, visits.Count, "ki-notepad-edit", "primary"), (T["Admissions"].Value, stays.Count, "ki-home-2", "info"),
                            (T["Appointments"].Value, appointments.Count, "ki-calendar", "primary"), (T["Bills"].Value, bills.Count, "ki-bill", "danger") })
                        {
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center"><i class="ki-outline @icon fs-3 text-@tone me-2"></i><div class="fs-2 fw-bold hp-num">@n</div></div>
                                <div class="fw-semibold fs-6 text-gray-500">@label</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div></div>

        @if (allergies.Length > 0)
        {
            <div class="notice d-flex rounded border border-danger border-dashed bg-light-danger p-6 mb-5">
                <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                    <div class="mb-3 mb-md-0 fw-semibold pe-5">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["Recorded allergy"]</h4>
                        <div class="fs-6 text-gray-700">@string.Join(DisplayName.IsArabic ? "، " : ", ", allergies)</div>
                    </div>
                    <span class="badge badge-danger fs-7 fw-bold px-4 py-2 flex-shrink-0">@T["Allergy"]</span>
                </div>
            </div>
        }

        @if (restriction != null)
        {
            @* H64: a restricted file says so, and how this reader got in *@
            <div class="notice d-flex rounded border border-danger border-dashed bg-light-danger p-5 mb-5" data-restricted>
                <i class="ki-outline ki-lock-2 fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Restricted file"]</h4>
                    <div class="fs-7 text-gray-700" dir="auto">@restriction.Reason</div>
                    @if (fileAccess == HospitalFileAccess.BreakGlass && glassUntil is DateTime gu)
                    {
                        <div class="fs-7 text-danger fw-bold mt-1">@T["You opened it as an emergency until"] <span class="hp-num" dir="ltr">@HospitalNursingService.UtcToWard(gu).ToString("HH:mm")</span> — @T["the opening is reviewed by the hospital administrator."]</div>
                    }
                </div>
            </div>
        }
        @if (Model.DeceasedAt is DateTime died)
        {
            @* H59: the death certificate marks the file *@
            <div class="notice d-flex rounded border border-dark border-dashed bg-light p-5 mb-5" data-deceased>
                <i class="ki-outline ki-information-5 fs-2tx text-gray-700 me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Deceased"]</h4>
                    <div class="fs-7 text-gray-700">@T["Died on"] <span class="hp-num" dir="ltr">@HospitalNursingService.UtcToWard(died).ToString("yyyy-MM-dd HH:mm")</span> — <a href="@Url.Action("Vital")" class="link-primary">@T["The death certificate"]</a></div></div>
            </div>
        }
        <div class="row g-5 g-xl-8">
            <div class="col-xl-8">
                <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold mb-5">
                    <li class="nav-item"><a class="nav-link text-active-primary pb-3 active" data-bs-toggle="tab" href="#pfOverview">@T["Overview"]</a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfVisits">@T["Visits"] <span class="badge badge-light-primary ms-1 hp-num">@visits.Count</span></a></li>
                    @if (canClinical)
                    {
                        <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfLab">@T["Lab results"] <span class="badge badge-light-primary ms-1 hp-num">@lab.Verified.Count</span></a></li>
                        <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfRad">@T["Imaging"] <span class="badge badge-light-primary ms-1 hp-num">@rad.Signed.Count</span></a></li>
                    }
                    <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfAppts">@T["Appointments"] <span class="badge badge-light-primary ms-1 hp-num">@appointments.Count</span></a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfStays">@T["Admissions"] <span class="badge badge-light-primary ms-1 hp-num">@stays.Count</span></a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfSick">@T["Sick leave"] <span class="badge badge-light-primary ms-1 hp-num" data-sick-count>@sick.Count</span></a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfConsents">@T["Consents"] <span class="badge badge-light-primary ms-1 hp-num" data-consent-count>@consents.Count</span></a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfAccount">@T["Account"] <span class="badge badge-light-primary ms-1 hp-num">@bills.Count</span></a></li>
                    <li class="nav-item"><a class="nav-link text-active-primary pb-3" data-bs-toggle="tab" href="#pfAccess">@T["Access log"] <span class="badge badge-light-primary ms-1 hp-num">@log.Count</span></a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="pfOverview">
                        <div class="row g-5">
                            <div class="col-md-6">
                                <div class="card card-flush h-100">
                                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Patient details"]</span></h3></div>
                                    <div class="card-body pt-2">
                                        @foreach (var f in new (string Label, string? Value, bool Num)[] {
                                            (T["Name (Arabic)"].Value, Model.Name, false), (T["Name (English)"].Value, Model.NameEn, false),
                                            (T["ID number"].Value, Model.NationalId, true), (T["Date of birth"].Value, Model.BirthDate?.ToString("yyyy-MM-dd"), true),
                                            (T["Nationality"].Value, nationality, false), (T["Mobile"].Value, Model.Phone, true) })
                                        {
                                            <div class="d-flex flex-stack py-3 border-bottom border-gray-200 border-bottom-dashed">
                                                <span class="text-muted fw-semibold fs-7">@f.Label</span>
                                                <span class="fw-bold text-gray-800 fs-6 @(f.Num ? "hp-num" : "")" dir="auto">@(f.Value ?? "—")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card card-flush mb-5">
                                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Chronic conditions"]</span></h3></div>
                                    <div class="card-body pt-2">
                                        @if (!canClinical) { <div class="text-muted fs-7 py-2"><i class="ki-outline ki-lock-2 fs-7 me-1"></i>@T["For the care team"]</div> }
                                        else if (chronic.Length == 0) { <div class="text-muted fs-7 py-2">@T["None recorded"]</div> }
                                        @foreach (var c in canClinical ? chronic : Array.Empty<string>())
                                        {
                                            <div class="d-flex align-items-center py-2"><span class="bullet bullet-dot bg-primary me-3"></span><span class="fw-semibold text-gray-800">@c</span></div>
                                        }
                                    </div>
                                </div>
                                <div class="card card-flush">
                                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Emergency contact"]</span></h3></div>
                                    <div class="card-body pt-2">
                                        @if (Model.EmergencyName == null && Model.EmergencyPhone == null) { <div class="text-muted fs-7 py-2">@T["None recorded"]</div> }
                                        else
                                        {
                                            <div class="fw-bold text-gray-900 fs-6">@Model.EmergencyName</div>
                                            <div class="text-muted fs-7">@Model.EmergencyRelation @if (Model.EmergencyPhone != null) {<text> · </text><span class="hp-num">@Model.EmergencyPhone</span>}</div>
                                        }
                                        <div class="separator separator-dashed my-4"></div>
                                        <div class="fs-7 fw-semibold @(Model.ConsentSigned ? "text-primary" : "text-danger")">
                                            <i class="ki-outline @(Model.ConsentSigned ? "ki-check-circle text-primary" : "ki-cross-circle text-danger") fs-5 me-1"></i>@(Model.ConsentSigned ? T["General consent signed"] : T["General consent not signed"])
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="pfVisits">
                        <div class="card card-flush"><div class="card-body pt-6">
                            @if (visits.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-notepad-edit fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["No visits yet."]</div></div> }
                            else
                            {
                                <table class="table align-middle gs-4 gy-4 fs-6 mb-0">
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="rounded-start">@T["Date"]</th><th>@T["Doctor"]</th><th>@T["Diagnosis"]</th><th>@T["Status"]</th><th class="text-end rounded-end"></th></tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                        @foreach (var v in visits)
                                        {
                                            doctors.TryGetValue(v.PractitionerId, out var vd);
                                            <tr>
                                                <td class="hp-num">@v.StartedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                                <td class="fs-7">@(vd == null ? "—" : DisplayName.Of(vd.Row.Name, vd.Row.NameEn))</td>
                                                <td>@if (!canClinical) {<span class="text-muted fs-8"><i class="ki-outline ki-lock-2 fs-8 me-1"></i>@T["For the care team"]</span>} else if (v.PrimaryCode != null) {<span class="badge hp-code fs-9 hp-num me-1">@v.PrimaryCode</span>@DisplayName.Of(v.PrimaryName, v.PrimaryNameEn)} else {<span class="text-muted">@(v.ChiefComplaint ?? "—")</span>}</td>
                                                <td><span class="badge @(v.Status == HospitalEncounterStatus.Signed ? "badge-light-primary" : "badge-light-primary") fs-8">@T["enc:" + v.Status]</span></td>
                                                <td class="text-end"><a href="@Url.Action("Consult", new { id = v.Id })" class="btn btn-sm btn-light-primary">@T["Open"]</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div></div>
                    </div>

                    @if (canClinical)
                    {
                        <div class="tab-pane fade" id="pfLab"><partial name="_HospitalLabResults" model="lab" /></div>
                        <div class="tab-pane fade" id="pfRad"><partial name="_HospitalRadResults" model="rad" /></div>
                    }

                    <div class="tab-pane fade" id="pfAppts">
                        <div class="card card-flush"><div class="card-body pt-6">
                            @if (appointments.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-calendar fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["No appointments yet."]</div></div> }
                            else
                            {
                                <table class="table align-middle gs-4 gy-4 fs-6 mb-0">
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="rounded-start">@T["Date"]</th><th>@T["Doctor"]</th><th>@T["Visit type"]</th><th class="text-end rounded-end">@T["Status"]</th></tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                        @foreach (var a in appointments)
                                        {
                                            doctors.TryGetValue(a.PractitionerId, out var dv);
                                            <tr>
                                                <td class="hp-num">@a.Date.ToString("yyyy-MM-dd") <span class="text-muted">@HospitalUi.Clock(a.StartMinute)</span></td>
                                                <td>@if (dv != null) {<div class="d-flex align-items-center"><div class="symbol symbol-30px symbol-circle me-3">@if (dv.PhotoPath != null) {<img src="@dv.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(dv.Row.NameEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(dv.Row.NameEn)</span>}</div><a href="@Url.Action("Practitioner", new { id = dv.Row.ID })" class="text-gray-800 text-hover-primary fw-bold fs-7">@DisplayName.Of(dv.Row.Name, dv.Row.NameEn)</a></div>} else {<text>—</text>}</td>
                                                <td class="fs-7">@T["visit:" + a.VisitType]</td>
                                                <td class="text-end"><span class="hp-slot @a.Status d-inline-block px-3">@T["appt:" + a.Status]</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div></div>
                    </div>

                    <div class="tab-pane fade" id="pfStays">
                        <div class="card card-flush"><div class="card-body pt-6">
                            @if (stays.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-home-2 fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["No admissions yet."]</div></div> }
                            else
                            {
                                <table class="table align-middle gs-4 gy-4 fs-6 mb-0">
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="rounded-start">@T["Room"]</th><th>@T["Bed"]</th><th>@T["From"]</th><th>@T["To"]</th><th>@T["Diagnosis"]</th><th class="text-end rounded-end"></th></tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                        @foreach (var s in stays)
                                        {
                                            <tr>
                                                <td class="hp-num fw-bold text-gray-900">@s.RoomNumber</td>
                                                <td><span class="badge hp-code fw-bold fs-8 hp-num">@s.BedCode</span></td>
                                                <td><span class="hp-num" data-utc="@s.StartedAt.ToString("o")">@s.StartedAt.ToString("yyyy-MM-dd HH:mm")</span></td>
                                                <td>@if (s.EndedAt is DateTime e) {<span class="hp-num" data-utc="@e.ToString("o")">@e.ToString("yyyy-MM-dd HH:mm")</span> <span class="text-muted fs-8">@T["end:" + s.EndReason]</span>} else {<span class="badge badge-light-primary">@T["Current"]</span>}</td>
                                                <td>@if (!canClinical) {<span class="text-muted fs-8"><i class="ki-outline ki-lock-2 fs-8 me-1"></i>@T["For the care team"]</span>} else {@(s.Diagnosis ?? "—")}</td>
                                                <td class="text-end"><a href="@Url.Action("DischargeSummary", new { id = s.AdmissionId })" class="btn btn-sm btn-light-primary" data-ds-open="@s.AdmissionId"><i class="ki-outline ki-document fs-5"></i>@T["Discharge summary"]</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div></div>
                    </div>

                    <div class="tab-pane fade" id="pfAccount">
                        <div class="row g-5 mb-5">
                            @foreach (var k in new[] { (T["Billed"].Value, bills.Sum(b => b.Total), "text-gray-900"), (T["Collected"].Value, bills.Sum(b => b.Paid), "text-primary"), (T["Still owed"].Value, bills.Sum(b => b.Total - b.Paid), bills.Sum(b => b.Total - b.Paid) > 0 ? "text-danger" : "text-gray-900") })
                            {
                                <div class="col-md-4"><div class="card card-flush h-100"><div class="card-body py-5"><div class="text-muted fw-semibold fs-7 mb-1">@k.Item1</div><div class="fs-2x fw-bold @k.Item3 hp-num">@BM(k.Item2)</div><div class="text-muted fs-8">@billCurrency?.Label(DisplayName.IsArabic)</div></div></div></div>
                            }
                        </div>
                        <div class="card card-flush"><div class="card-body pt-6">
                            @* H63: the patient's account statement — bills, payments and charity, with the running balance (Report Studio) *@
                            <div class="d-flex justify-content-end mb-4">@await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalPatientStatement, DocumentId = Model.ID.ToString(), DocumentTitle = Model.Mrn })</div>
                            @if (bills.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-bill fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["No bills yet."]</div></div> }
                            else
                            {
                                <table class="table align-middle gs-4 gy-4 fs-6 mb-0">
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="rounded-start">@T["Bill"]</th><th>@T["Type"]</th><th>@T["Opened"]</th><th class="text-end">@T["Total"]</th><th class="text-end">@T["Due"]</th><th>@T["Status"]</th><th class="text-end rounded-end"></th></tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                        @foreach (var b in bills)
                                        {
                                            <tr>
                                                <td><span class="badge hp-code fs-8 hp-num">@b.BillNo</span></td>
                                                <td class="fs-7">@(b.Inpatient ? T["Inpatient stay"] : T["Outpatient visit"])</td>
                                                <td class="hp-num fs-7">@b.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                                <td class="text-end hp-num">@BM(b.Total)</td>
                                                <td class="text-end hp-num fw-bold @(b.Total - b.Paid > 0 ? "text-danger" : "")">@BM(b.Total - b.Paid)</td>
                                                <td><span class="badge @(b.Status == HospitalBillStatus.Open ? "badge-light-primary" : "badge-light-primary") fs-8">@T["bill:" + b.Status]</span></td>
                                                <td class="text-end"><a href="@Url.Action("Bill", new { id = b.Id })" class="btn btn-sm btn-light-primary">@T["Open"]</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div></div>
                    </div>

                    @* H56: sick leave certificates — issued by a doctor, voided with a reason, printed through Report Studio *@
                    <div class="tab-pane fade" id="pfSick">
                        <div class="card card-flush"><div class="card-body pt-6" data-sick-body>
                            @if (!sickReady) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalSickLeaveService.NoTables]</div></div> }
                            @if (sickReady && canConsult)
                            {
                                var todayW = HospitalNursingService.UtcToWard(DateTime.UtcNow).ToString("yyyy-MM-dd");
                                <div class="border border-dashed border-gray-300 rounded p-5 mb-6" data-sick-form>
                                    <div class="fw-bold text-gray-900 mb-4">@T["New sick leave"]</div>
                                    <div class="row g-4">
                                        <div class="col-md-3"><label class="form-label required fs-7">@T["First day"]</label><input type="date" class="form-control form-control-solid" data-s="fromDate" value="@todayW" /></div>
                                        <div class="col-md-3"><label class="form-label required fs-7">@T["Last day"]</label><input type="date" class="form-control form-control-solid" data-s="toDate" value="@todayW" /></div>
                                        <div class="col-md-6"><label class="form-label required fs-7">@T["Recommendation"]</label>
                                            <select class="form-select form-select-solid" data-s="kind">@foreach (var k in HospitalSickLeaveKind.All) { <option value="@k">@T["sl:" + k]</option> }</select></div>
                                        <div class="col-md-8"><label class="form-label fs-7">@T["Diagnosis"]</label><input type="text" class="form-control form-control-solid" maxlength="500" dir="auto" data-s="diagnosis" /></div>
                                        <div class="col-md-4 d-flex align-items-end"><label class="form-check form-check-custom form-check-solid mb-3"><input class="form-check-input" type="checkbox" data-s="showDiagnosis" /><span class="form-check-label fs-7">@T["Print the diagnosis on the certificate"]</span></label></div>
                                        <div class="col-md-9"><label class="form-label fs-7">@T["sl:notes"]</label><input type="text" class="form-control form-control-solid" maxlength="500" dir="auto" data-s="note" /></div>
                                        <div class="col-md-3 d-flex align-items-end"><button type="button" class="btn btn-primary w-100" data-sick-issue><i class="ki-outline ki-document fs-4"></i>@T["Issue"]</button></div>
                                    </div>
                                </div>
                            }
                            @if (sick.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-document fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["No sick leave yet."]</div></div> }
                            else
                            {
                                <table class="table align-middle gs-4 gy-4 fs-7 mb-0" data-sick-list>
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="rounded-start">@T["Certificate"]</th><th>@T["Period"]</th><th>@T["Recommendation"]</th><th>@T["Doctor"]</th><th>@T["State"]</th><th class="text-end rounded-end"></th></tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                        @foreach (var r in sick)
                                        {
                                            var l = r.Leave; bool isVoid = l.VoidedAt != null;
                                            <tr data-sick-row="@l.ID" class="@(isVoid ? "opacity-75" : "")">
                                                <td><span class="badge hp-code fs-8 hp-num">@l.LeaveNo</span><div class="text-muted fs-9 mt-1 hp-num" dir="ltr">@HospitalNursingService.UtcToWard(l.IssuedAt).ToString("yyyy-MM-dd HH:mm")</div></td>
                                                <td><span class="hp-num" dir="ltr">@l.FromDate.ToString("yyyy-MM-dd") → @l.ToDate.ToString("yyyy-MM-dd")</span><div class="text-muted fs-8"><span class="hp-num">@l.Days</span> @T["days"]</div></td>
                                                <td>@T["sl:" + l.Kind]@if (l.Diagnosis != null && canClinical) {<div class="text-muted fs-8" dir="auto">@l.Diagnosis @if (!l.ShowDiagnosis) {<span class="badge badge-light fs-9">@T["not printed"]</span>}</div>}</td>
                                                <td>@DisplayName.Of(r.Doctor ?? "", r.DoctorEn ?? r.Doctor ?? "")</td>
                                                <td>@if (isVoid) {<span class="badge badge-light-danger">@T["sl:void"]</span><div class="text-muted fs-9 mt-1" dir="auto">@l.VoidReason</div>} else {<span class="badge badge-light-primary">@T["sl:valid"]</span>}
                                                    @* H208: the Ministry's authentication, and the code the QR carries *@
                                                    @if (l.MohAuthAt != null) {<div class="mt-1"><span class="badge badge-light-info fs-9">@T["MOH authenticated"]</span> <bdi class="text-muted fs-9 hp-num" dir="ltr">@l.MohAuthRef</bdi></div>} else if (!isVoid) {<div class="mt-1"><span class="badge badge-light fs-9">@T["Awaiting MOH authentication"]</span></div>}
                                                    @if (l.VerifyCode != null) {<div class="text-muted fs-9 mt-1">@T["Verification code"]: <bdi class="hp-num fw-bold" dir="ltr">@l.VerifyCode</bdi></div>}</td>
                                                <td class="text-end"><div class="d-flex justify-content-end gap-2">
                                                    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalSickLeave, DocumentId = l.ID.ToString(), DocumentTitle = l.LeaveNo })
                                                    @if (!isVoid && l.MohAuthAt == null) { <button type="button" class="btn btn-sm btn-light-primary" data-sick-moh="@l.ID" data-no="@l.LeaveNo">@T["Record MOH authentication"]</button> }
                                                    @if (!isVoid && canConsult) { <button type="button" class="btn btn-sm btn-light-danger" data-sick-void="@l.ID" data-no="@l.LeaveNo">@T["sl:voidAction"]</button> }
                                                </div></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div></div>
                    </div>

                    @* H60: signed consents (and signed refusals) — taken on their own signing page, the signature shown here,
                       printed through Report Studio, withdrawn with a reason (never edited) *@
                    <div class="tab-pane fade" id="pfConsents">
                        <div class="card card-flush"><div class="card-body pt-6" data-consent-body>
                            @if (!consentsReady) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalConsentService.NoTables]</div></div> }
                            @if (consentsReady && canConsult && Model.DeceasedAt == null)
                            {
                                <div class="d-flex justify-content-end mb-5"><a href="@Url.Action("NewConsent", new { id = Model.ID })" class="btn btn-sm btn-primary"><i class="ki-outline ki-pencil fs-4"></i>@T["New consent"]</a></div>
                            }
                            @if (consents.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["No consent signed yet."]</div></div> }
                            else
                            {
                                <div class="table-responsive"><table class="table align-middle gs-4 gy-4 fs-7 mb-0" data-consent-list>
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="rounded-start">@T["cn:consent"]</th><th class="min-w-200px">@T["Form"]</th><th>@T["cn:decision"]</th><th class="min-w-150px rounded-end">@T["cn:signedBy"]</th></tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                        @foreach (var r in consents)
                                        {
                                            var c = r.Consent; bool withdrawn = c.WithdrawnAt != null;
                                            <tr data-consent-row="@c.ID" class="@(withdrawn ? "opacity-75" : "")">
                                                <td><span class="badge hp-code fs-8 hp-num">@c.ConsentNo</span><div class="text-muted fs-9 mt-1 hp-num" dir="ltr">@HospitalNursingService.UtcToWard(c.SignedAt).ToString("yyyy-MM-dd HH:mm")</div></td>
                                                <td><div class="text-gray-900" dir="auto">@c.Title</div>
                                                    @if (c.ProcedureName != null) {<div class="text-muted fs-8" dir="auto">@c.ProcedureName</div>}
                                                    @if (r.CaseNo != null) {<div class="text-muted fs-9 hp-num">@r.CaseNo</div>}
                                                <div class="d-flex flex-wrap gap-2 mt-3">
                                                    <button type="button" class="btn btn-sm btn-light" data-consent-sign="@c.ID" data-no="@c.ConsentNo" data-sha="@c.SignatureSha256"><i class="ki-outline ki-pencil fs-5"></i>@T["cn:signature"]</button>
                                                    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalConsent, DocumentId = c.ID.ToString(), DocumentTitle = c.ConsentNo })
                                                    @if (!withdrawn && c.Decision == HospitalConsentDecision.Given && canConsult) { <button type="button" class="btn btn-sm btn-light-danger" data-consent-withdraw="@c.ID" data-no="@c.ConsentNo">@T["cn:withdraw"]</button> }
                                                </div></td>
                                                <td>@if (c.Decision == HospitalConsentDecision.Given) {<span class="badge badge-light-primary">@T["cns:Given"]</span>} else {<span class="badge badge-light-danger">@T["cns:Refused"]</span>}
                                                    <div class="mt-1">@if (withdrawn) {<span class="badge badge-light-danger">@T["cn:withdrawn"]</span><div class="text-muted fs-9 mt-1" dir="auto">@c.WithdrawReason</div>} else {<span class="badge badge-light-primary">@T["cn:inForce"]</span>}</div></td>
                                                <td><div dir="auto">@c.SignerName</div>@if (c.SignerKind == HospitalConsentSigner.Representative) {<div class="text-muted fs-8" dir="auto">@c.SignerRelation · @T["cp:" + c.ProxyReason]</div>}
                                                    <div class="text-muted fs-8 mt-1">@T["cn:explainedBy"]: @DisplayName.Of(r.ExplainedBy, r.ExplainedByEn)</div><div class="text-muted fs-8">@T["Witness"]: @DisplayName.Of(r.Witness, r.WitnessEn)</div></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                            }
                        </div></div>
                    </div>

                    <div class="tab-pane fade" id="pfAccess">
                        <div class="card">
                            <div class="card-body pt-6">
                                <table class="table align-middle gs-4 gy-4 fs-6 mb-0">
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="rounded-start">@T["Who"]</th><th>@T["What"]</th><th class="text-end rounded-end">@T["When"]</th></tr></thead>
                                    <tbody class="fw-semibold text-gray-700">
                                        @foreach (var a in log)
                                        {
                                            var who = a.EmployeeId is int e && people.TryGetValue(e, out var nm) ? nm : T["System"].Value;
                                            string? photo = a.EmployeeId is int e2 && photos.TryGetValue(e2, out var ph) ? ph : null;
                                            <tr>
                                                <td><div class="d-flex align-items-center">
                                                    <div class="symbol symbol-30px symbol-circle me-3">@if (photo != null) {<img src="@photo" alt="@who" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@Initials(who)</span>}</div>
                                                    <span class="text-gray-800 fw-bold">@who</span></div></td>
                                                <td>@T["access:" + a.Action]</td>
                                                <td class="text-end"><span class="hp-num" data-utc="@a.At.ToString("o")">@a.At.ToString("yyyy-MM-dd HH:mm")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="text-muted fs-8 mt-4"><i class="ki-outline ki-eye fs-7 me-1"></i>@T["Opening this file is recorded in the access log with your name and time."]</div>
            </div>
            <div class="col-xl-4">
                @await Html.PartialAsync("_EntityConversation")
            </div>
        </div>
    </div></div>
</div>

@await Html.PartialAsync("_ReportPreviewModal", (object)(DisplayName.Of(Model.Name, Model.NameEn)))

<div class="modal fade" id="hpConsentSignModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h3 class="modal-title" data-cs-title></h3><button type="button" class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></button></div>
    <div class="modal-body text-center"><img data-cs-img alt="" class="mw-100 border border-gray-300 rounded" style="max-height:260px" />
        <div class="text-muted fs-9 mt-4">SHA-256</div><div class="fs-9 hp-num text-gray-700 text-break" dir="ltr" data-cs-sha></div></div>
</div></div></div>

@section Scripts {
    <partial name="_HospitalScripts" />
    <partial name="_HospitalPrompt" />
    <partial name="_HospitalAdmit" />
    <script>
        (function () {
            var id = @Model.ID;
            // H56: sick leave — issue and void ask first, and the tab swaps in place (never a reload)
            (function () {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var W = { issue: @Json.Serialize(T["Issue a sick leave of {0} days for this patient?"].Value), voidWhy: @Json.Serialize(T["Why is certificate {0} void?"].Value),
                    issued: @Json.Serialize(T["The certificate is issued"].Value), voided: @Json.Serialize(T["The certificate is void"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value),
                    mohRef: @Json.Serialize(T["The Ministry of Health's authentication reference for certificate {0}"].Value), mohDone: @Json.Serialize(T["The Ministry's authentication is recorded"].Value) };
                function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
                function toast(k, m) { if (window.toastr) toastr[k](m); }
                function swap() {
                    return fetch(location.pathname, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                        var d = new DOMParser().parseFromString(html, 'text/html');
                        var f = d.querySelector('[data-sick-body]'); if (f) document.querySelector('[data-sick-body]').innerHTML = f.innerHTML;
                        var c = d.querySelector('[data-sick-count]'); if (c) document.querySelector('[data-sick-count]').textContent = c.textContent;
                        if (window.KTMenu) KTMenu.createInstances();
                    });
                }
                document.addEventListener('click', function (e) {
                    var t = e.target.closest('[data-sick-issue],[data-sick-void],[data-sick-moh]'); if (!t) return;
                    if (t.hasAttribute('data-sick-moh')) {   // H208
                        var mid = t.getAttribute('data-sick-moh');
                        cbPrompt(W.mohRef.replace('{0}', t.getAttribute('data-no'))).then(function (ref) {
                            if (ref == null) return; t.disabled = true;
                            post(@Json.Serialize(Url.Content("~/Hospital/SickLeaves/")) + mid + '/Moh', { reference: ref })
                                .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.mohDone); swap(); });
                        });
                        return;
                    }
                    if (t.hasAttribute('data-sick-issue')) {
                        var f = document.querySelector('[data-sick-form]'), v = function (k) { return f.querySelector('[data-s=' + k + ']'); };
                        var from = v('fromDate').value, to = v('toDate').value;
                        var days = from && to ? Math.round((new Date(to) - new Date(from)) / 864e5) + 1 : 0;
                        cbConfirm(W.issue.replace('{0}', days)).then(function (ok) {
                            if (!ok) return; t.disabled = true;
                            post(@Json.Serialize(Url.Action("IssueSickLeave", new { id = Model.ID })), { fromDate: from || null, toDate: to || null, kind: v('kind').value, diagnosis: v('diagnosis').value || null, showDiagnosis: v('showDiagnosis').checked, note: v('note').value || null })
                                .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.issued); swap(); });
                        });
                        return;
                    }
                    var lid = t.getAttribute('data-sick-void');
                    cbPrompt(W.voidWhy.replace('{0}', t.getAttribute('data-no'))).then(function (why) {
                        if (why == null) return; t.disabled = true;
                        post(@Json.Serialize(Url.Content("~/Hospital/SickLeaves/"))+ lid + '/Void', { reason: why })
                            .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.voided); swap(); });
                    });
                });
            })();
            // H60: consents — the signature opens in a modal; a withdrawal asks why and the tab swaps in place
            (function () {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var W = { why: @Json.Serialize(T["Why is consent {0} withdrawn?"].Value), done: @Json.Serialize(T["The consent is withdrawn"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value) };
                document.addEventListener('click', function (e) {
                    var t = e.target.closest('[data-consent-sign],[data-consent-withdraw]'); if (!t) return;
                    if (t.hasAttribute('data-consent-sign')) {
                        var m = document.getElementById('hpConsentSignModal');
                        m.querySelector('[data-cs-title]').textContent = t.getAttribute('data-no');
                        m.querySelector('[data-cs-img]').src = @Json.Serialize(Url.Content("~/Hospital/Consents/")) + t.getAttribute('data-consent-sign') + '/Signature';
                        m.querySelector('[data-cs-sha]').textContent = t.getAttribute('data-sha');
                        bootstrap.Modal.getOrCreateInstance(m).show();
                        return;
                    }
                    var cid = t.getAttribute('data-consent-withdraw');
                    cbPrompt(W.why.replace('{0}', t.getAttribute('data-no'))).then(function (why) {
                        if (why == null) return; t.disabled = true;
                        fetch(@Json.Serialize(Url.Content("~/Hospital/Consents/")) + cid + '/Withdraw', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ reason: why }) })
                            .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                            .then(function (res) {
                                t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                                toastr.success(W.done);
                                return fetch(location.pathname, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                                    var d = new DOMParser().parseFromString(html, 'text/html');
                                    var b = d.querySelector('[data-consent-body]'); if (b) document.querySelector('[data-consent-body]').innerHTML = b.innerHTML;
                                    if (window.KTMenu) KTMenu.createInstances();
                                });
                            });
                    });
                });
                // a link to a tab of the file (#pfConsents after signing) opens that tab
                if (location.hash) { var tab = document.querySelector('[data-bs-toggle="tab"][href="' + location.hash + '"]'); if (tab && window.bootstrap) bootstrap.Tab.getOrCreateInstance(tab).show(); }
            })();
            // H64: restrict (with the reason) and lift — both ask first
            (function () {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                function send(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
                function done(res) { if (!res.ok) { toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); return; } location.reload(); }
                var r = document.querySelector('[data-file-restrict]');
                if (r) r.addEventListener('click', function () { cbPrompt(r.getAttribute('data-ask')).then(function (why) { if (why != null) send(@Json.Serialize(Url.Action("RestrictFile", new { id = Model.ID })), { reason: why }).then(done); }); });
                var u = document.querySelector('[data-file-unrestrict]');
                if (u) u.addEventListener('click', function () { cbConfirm(u.getAttribute('data-ask')).then(function (ok) { if (ok) send(@Json.Serialize(Url.Action("UnrestrictFile", new { id = Model.ID }))).then(done); }); });
            })();
            var reload = function () { location.reload(); };   // the file's banner, buttons and tabs all change together
            HospitalAdmit.onChange(reload);
            var a = document.querySelector('[data-admit-me]'); if (a) a.addEventListener('click', function () { HospitalAdmit.open({ patientId: id }); });
            var tr = document.querySelector('[data-transfer-me]'); if (tr) tr.addEventListener('click', function () { HospitalAdmit.open({ patientId: id, transferAdmissionId: +tr.getAttribute('data-transfer-me') }); });
            var d = document.querySelector('[data-discharge-me]'); if (d) d.addEventListener('click', function () { HospitalAdmit.discharge(+d.getAttribute('data-discharge-me')); });

            // The photo: pick a file, it uploads at once and replaces the avatar in place.
            var input = document.querySelector('[data-photo-input]');
            if (input) input.addEventListener('change', function () {
                if (!input.files.length) return;
                var fd = new FormData(); fd.append('photo', input.files[0]);
                fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                fetch(@Json.Serialize(Url.Action("PatientPhoto", new { id = Model.ID })), { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) {
                        input.value = '';
                        if (!res.ok) { if (window.toastr) toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); return; }
                        var old = document.querySelector('[data-photo-img]'), img = document.createElement('img');
                        img.src = res.photo; img.alt = ''; img.style.objectFit = 'cover'; img.setAttribute('data-photo-img', '');
                        old.replaceWith(img);
                        if (window.toastr) toastr.success(@Json.Serialize(T["Saved"].Value));
                    });
            });
        })();
    </script>
    <script>
        // A stored time is UTC; show it in the reader's own clock.
        document.querySelectorAll('[data-utc]').forEach(function (el) {
            var d = new Date(el.getAttribute('data-utc').replace(/Z?$/, 'Z'));
            if (isNaN(d)) return;
            function two(n) { return (n < 10 ? '0' : '') + n; }
            el.textContent = d.getFullYear() + '-' + two(d.getMonth() + 1) + '-' + two(d.getDate()) + ' ' + two(d.getHours()) + ':' + two(d.getMinutes());
        });
    </script>
}
