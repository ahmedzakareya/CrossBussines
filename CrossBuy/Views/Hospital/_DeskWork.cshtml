@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalDeskWorkItem>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@* H141: one of the desk's queues, the oldest (or most urgent) first: who, what, since when, and the screen where the act
   lives. Eight at most; "see all" opens the queue's own screen. *@
@{
    string kind = (string)ViewBag.Kind;
    var inv = System.Globalization.CultureInfo.InvariantCulture; int dp = ViewBag.MoneyDp is int d0 ? d0 : 2; string cur = ViewBag.Currency as string ?? "";
    var (href, go) = kind switch
    {
        "portal" => (Url.Action("PortalRequests", "Hospital"), T["Book or decline"].Value),
        "waitlist" => (Url.Action("PortalWaitlist", "Hospital"), T["Open"].Value),
        "intake" => (Url.Action("Intake", "Hospital"), T["Review & link"].Value),
        "preauth" => (Url.Action("Insurance", "Hospital"), T["Open"].Value),
        "unidentified" => (Url.Action("Unidentified", "Hospital"), T["Identify"].Value),
        _ => (Url.Action("Duplicates", "Hospital"), T["Review and merge"].Value),
    };
    string Ago(DateTime? utc) { if (utc is not DateTime u) return ""; var m = (int)(DateTime.UtcNow - u).TotalMinutes; return m < 60 ? string.Format(T["{0} min"].Value, Math.Max(0, m)) : m < 1440 ? string.Format(T["{0} h"].Value, m / 60) : string.Format(T["{0} days"].Value, m / 1440); }
}
@if (Model.Count == 0)
{
    <div class="notice d-flex bg-light rounded border border-dashed border-gray-300 p-6">
        <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label bg-light-success"><i class="ki-outline ki-check-circle fs-2x text-success"></i></span></span>
        <div class="d-flex flex-stack flex-grow-1 flex-wrap gap-3"><div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Nothing waiting"]</h4><div class="fs-6 text-gray-700">@T["This queue is clear."]</div></div>
            <a href="@href" class="btn btn-sm btn-light">@T["Open the screen"]</a></div>
    </div>
}
else
{
    <div class="table-responsive"><table class="table align-middle gs-0 gy-3 mb-0">
        <tbody class="fs-7">
            @foreach (var w in Model)
            {
                <tr>
                    <td class="ps-2">
                        @if (w.PatientId is int pid)
                        {
                            <a href="#" class="d-flex align-items-center text-hover-primary" data-open-patient="@pid">
                                <div class="symbol symbol-35px symbol-circle me-3 flex-shrink-0">@if (w.Photo != null) {<img src="@w.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(w.NameEn ?? w.Name)</span>}</div>
                                <div class="d-flex flex-column min-w-0"><span class="text-gray-900 fw-bold fs-7 text-truncate"><bdi>@DisplayName.Of(w.Name, w.NameEn)</bdi></span>@if (w.Mrn != null) {<span class="text-muted fs-8 hp-num">@w.Mrn</span>}</div></a>
                        }
                        else
                        {
                            <div class="d-flex align-items-center"><div class="symbol symbol-35px symbol-circle me-3 flex-shrink-0"><span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(w.NameEn ?? w.Name)</span></div>
                                <div class="d-flex flex-column min-w-0"><span class="text-gray-900 fw-bold fs-7 text-truncate"><bdi>@DisplayName.Of(w.Name, w.NameEn)</bdi></span><span class="text-muted fs-8">@T["No file yet"]</span></div></div>
                        }
                    </td>
                    <td class="text-gray-700">
                        @switch (kind)
                        {
                            case "portal": <span><bdi>@DisplayName.Of(w.Line ?? "—", w.LineEn)</bdi> · @T["tod:" + (w.Extra ?? "Any")]</span><div class="text-muted fs-8 hp-num">@w.Code</div>; break;
                            case "waitlist": <span>@T["Doctor"]: <bdi>@DisplayName.Of(w.Line ?? "—", w.LineEn)</bdi></span><div class="text-muted fs-8"><span class="hp-num">@w.At?.ToString("yyyy-MM-dd") · @w.Code</span></div>; break;
                            case "intake": <span><bdi>@(w.Line ?? "—")</bdi></span><div class="text-muted fs-8">@T["Ticket"] <span class="hp-num">@w.Code</span>@if (w.Amount is decimal sc) {<text> · @T["Match"] </text><span class="hp-num">@sc.ToString("0", inv)%</span>}</div>; break;
                            case "preauth": <span><bdi>@DisplayName.Of(w.Line ?? "—", w.LineEn)</bdi></span><div class="text-muted fs-8"><span class="hp-num">@w.Code · @(w.Amount?.ToString("N" + dp, inv))</span> @cur</div>; break;
                            case "unidentified": <span><bdi>@(w.Line ?? "—")</bdi></span><div class="text-muted fs-8">@string.Format(T["About {0} years"].Value, w.Code)@if (w.Extra != null) {<text> · </text><bdi>@w.Extra</bdi>}</div>; break;
                            default: <span>@T["Looks like"] <bdi class="fw-bold">@DisplayName.Of(w.Line ?? "—", w.LineEn)</bdi> <span class="hp-num">@w.Code</span></span>
                                <div class="mt-1">@foreach (var why in (w.Extra ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)) {<span class="badge badge-light-primary fs-9 fw-bold me-1">@T["dupwhy:" + why]</span>}</div>; break;
                        }
                    </td>
                    <td class="text-nowrap">
                        @if (w.Urgent) {<span class="badge badge-light-danger fs-8 fw-bold me-1">@(kind == "unidentified" ? T["Medico-legal"] : T["Urgent"])</span>}
                        @if (kind == "waitlist" && w.Due is DateTime due) {<span class="badge badge-light-primary fs-8 fw-bold">@T["Expires"] <span class="hp-num ms-1">@HospitalNursingService.UtcToWard(due).ToString("MM-dd HH:mm")</span></span>}
                        else if (w.At != null && kind != "waitlist") {<span class="badge badge-light fs-8 fw-bold"><i class="ki-outline ki-time fs-8 me-1"></i>@Ago(w.At)</span>}
                    </td>
                    <td class="text-end pe-2"><a href="@href" class="btn btn-sm btn-light-primary text-nowrap">@go</a></td>
                </tr>
            }
        </tbody>
    </table></div>
    <div class="d-flex justify-content-end mt-3"><a href="@href" class="btn btn-sm btn-light btn-active-light-primary">@T["See all"] <i class="ki-outline ki-arrow-@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "left" : "right") fs-5 ms-1"></i></a></div>
}
