@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H70 — SMS to patients. What waits to go, what went today, what failed and who could not be reached; a message typed
    to a patient (their file's number) or to any number; the outbox searched and paged on the server; the words of each
    kind of message; and the patients who asked for no messages. With no provider connected the screen says so and the
    queue is kept — nothing pretends to have been sent. Every write asks first.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Patient SMS"].Value;
    var f = ViewBag.Figures as HospitalSmsFigures ?? new HospitalSmsFigures(false, 0, 0, 0, 0, 0);
    var templates = (ViewBag.Templates as IReadOnlyList<HospitalSmsTemplateView>) ?? Array.Empty<HospitalSmsTemplateView>();
    var optOuts = (ViewBag.OptOuts as IReadOnlyList<HospitalSmsOptOutRow>) ?? Array.Empty<HospitalSmsOptOutRow>();
    string? provider = ViewBag.Provider as string;
    bool canManage = ViewBag.CanManage == true, canBook = ViewBag.CanBook == true;
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Patient SMS"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Patients & front desk"]</li></ul>
        </div>
        @if (canManage && provider != null && f.Ready)
        {
            <button type="button" class="btn btn-sm btn-primary" data-sms-dispatch><i class="ki-outline ki-send fs-4"></i>@T["Send the queue"]</button>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!f.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><div class="fs-6 text-gray-700">@T[HospitalSmsService.NoTables]</div></div>
            </div>
        }
        else
        {
            @if (provider == null)
            {
                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                    <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["No SMS provider is connected yet"]</h4>
                        <div class="fs-6 text-gray-700">@T["Every message is written here and waits; nothing goes out until a provider is connected. Then the waiting messages are sent from this screen."]</div></div>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center mb-5"><span class="badge badge-light-primary fs-7 fw-bold py-3 px-4"><i class="ki-outline ki-check-circle fs-5 text-primary me-2"></i>@T["Connected provider:"]&nbsp;<bdi class="text-gray-800">@provider</bdi></span></div>
            }
            <div class="row g-5 mb-5">
                @* H128: stat tiles (demo39 dashboards/logistics) *@
                @foreach (var s in new[] {
                    (T["Waiting to go"].Value, f.Queued, "ki-time", "primary"), (T["Sent today"].Value, f.SentToday, "ki-send", "primary"),
                    (T["Failed"].Value, f.Failed, "ki-cross-circle", f.Failed > 0 ? "danger" : "gray"), (T["Not reachable (30 days)"].Value, f.Skipped30, "ki-disconnect", "gray"),
                    (T["Asked for no messages"].Value, f.OptOuts, "ki-notification-bing", "gray") })
                {
                    <div class="col-6 col-md"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column">
                                <span class="fs-2hx fw-bold @(s.Item4 == "danger" ? "text-danger" : "text-gray-900") me-2 lh-1 ls-n2 hp-num" dir="ltr">@s.Item2</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                            </div>
                            <div class="card-toolbar"><div class="symbol symbol-40px"><span class="symbol-label bg-light-@(s.Item4 == "gray" ? "secondary" : s.Item4)"><i class="ki-outline @s.Item3 fs-2 text-@(s.Item4 == "gray" ? "gray-600" : s.Item4)"></i></span></div></div>
                        </div>
                    </div></div>
                }
            </div>
            <div class="row g-5 mb-5">
                <div class="col-xl-4 d-flex flex-column gap-5">
                    @if (canBook)
                    {
                        <div class="card card-flush" data-sms-form>
                            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Write a message"]</span></h3>
                                <div class="card-toolbar"><div class="symbol symbol-40px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-sms fs-2 text-primary"></i></span></div></div></div>
                            <div class="card-body pt-2"><div class="row g-4">
                                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Patient"]</label>
                                    <select class="form-select form-select-solid" data-s="patientId" data-sms-patient data-placeholder="—"></select></div>
                                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Mobile number"]</label>
                                    <input class="form-control form-control-solid hp-num" dir="ltr" maxlength="30" data-s="phone" placeholder="@T["The patient's file number, or write one"]" /></div>
                                <div class="col-12"><div class="btn-group w-100">
                                    <button type="button" class="btn btn-sm btn-primary" data-s-lang="ar">العربية</button>
                                    <button type="button" class="btn btn-sm btn-light" data-s-lang="en">English</button>
                                </div></div>
                                <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Message"]</label>
                                    <textarea class="form-control form-control-solid" rows="4" maxlength="640" dir="auto" data-s="body"></textarea>
                                    <div class="text-muted fs-8 mt-1" data-s-count><span class="hp-num" data-n>0</span> @T["characters"] · <span class="hp-num" data-p>0</span> @T["SMS parts"]</div></div>
                                <div class="col-12"><button type="button" class="btn btn-primary w-100" data-sms-send><i class="ki-outline ki-send fs-4"></i>@T["Add to the queue"]</button></div>
                            </div></div>
                        </div>
                    }
                    <div class="card card-flush">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Asked for no messages"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Nothing is written to them until they are allowed again"]</span></h3></div>
                        <div class="card-body pt-2">
                            @if (optOuts.Count == 0) { <div class="text-center py-8"><i class="ki-outline ki-notification-on fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Nobody."]</div></div> }
                            @foreach (var o in optOuts)
                            {
                                @* H128: list-widget row (demo39 dashboards/logistics) *@
                                <div class="d-flex flex-stack py-3 border-bottom border-gray-300 border-bottom-dashed">
                                    <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-notification-bing fs-3 text-danger"></i></span></div>
                                    <div class="d-flex flex-stack flex-row-fluid gap-2">
                                        <div class="me-3"><span class="text-gray-800 fw-bold fs-6"><bdi>@DisplayName.Of(o.Name, o.NameEn)</bdi></span>
                                            <span class="text-gray-500 fw-semibold fs-7 d-block"><bdi class="hp-num">@o.Mrn</bdi>@if (o.Row.Reason != null) {<text> · </text><span dir="auto">@o.Row.Reason</span>}</span></div>
                                        @if (canBook) { <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary flex-shrink-0" title="@T["Allow again"]" data-bs-toggle="tooltip" data-sms-optin="@o.Row.PatientId" data-ask="@string.Format(T["Allow messages to {0} again?"].Value, DisplayName.Of(o.Name, o.NameEn))"><i class="ki-outline ki-notification-on fs-3"></i></button> }
                                    </div>
                                </div>
                            }
                            @if (canBook)
                            {
                                <div class="row g-3 mt-2" data-optout-form>
                                    <div class="col-12"><select class="form-select form-select-solid" data-optout-patient data-placeholder="@T["Patient"]"></select></div>
                                    <div class="col-12"><input class="form-control form-control-solid" maxlength="200" dir="auto" data-optout-reason placeholder="@T["Why (optional)"]" /></div>
                                    <div class="col-12"><button type="button" class="btn btn-sm btn-light-danger w-100" data-optout-add><i class="ki-outline ki-notification-bing fs-4"></i>@T["Stop messages to this patient"]</button></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-xl-8">
                    <div class="card card-flush">
                        <div class="card-header pt-5 flex-wrap gap-3">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Messages"]</span><span class="text-gray-500 mt-1 fw-semibold fs-7"><span id="resultCount">—</span></span></h3>
                            <div class="card-toolbar d-flex flex-wrap align-items-center gap-2">
                                <div class="w-250px"><input type="text" id="f_q" class="form-control form-control-solid form-control-sm" autocomplete="off" placeholder="@T["Search by number, patient, phone or text…"]" /></div>
                                <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_kind"><option value="">@T["All kinds"]</option>@foreach (var k in HospitalSmsKind.All) { <option value="@k">@T["smk:" + k]</option> }</select></div>
                                <div class="w-150px"><select class="form-select form-select-solid form-select-sm cb-filter" id="f_state"><option value="">@T["All states"]</option><option value="waiting">@T["sms:waiting"]</option>@foreach (var s in HospitalSmsStatus.All) { <option value="@s">@T["sms:" + s]</option> }</select></div>
                                <div class="w-75px"><select id="f_size" class="form-select form-select-solid form-select-sm"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
                                <button type="button" id="f_reset" class="btn btn-sm btn-light" title="@T["Reset"]"><i class="ki-outline ki-arrows-circle fs-4"></i></button>
                            </div>
                        </div>
                        <div class="card-body pt-2">
                            @* H128: table widget (demo39 widgets/tables) *@
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["sms:kind"]</th><th>@T["sms:to"]</th><th class="min-w-150px">@T["Message"]</th><th>@T["State"]</th><th class="pe-4 rounded-end"></th></tr></thead>
                                <tbody id="rows"><tr id="loadingRow"><td colspan="5" class="text-center text-muted py-10">@T["Loading…"]</td></tr><tr id="emptyRow" class="d-none"><td colspan="5" class="text-center py-10"><i class="ki-outline ki-sms fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No messages."]</div></td></tr></tbody>
                            </table></div>
                            <div class="d-flex flex-stack flex-wrap pt-5"><div class="fs-7 text-muted" id="pageInfo"></div><ul class="pagination" id="pager"></ul></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card card-flush">
                <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["The words of each message"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Use:"] @foreach (var ph in HospitalSmsRules.Placeholders) { <code class="mx-1" dir="ltr">{@ph}</code> }</span></h3></div>
                <div class="card-body pt-2">
                    @foreach (var t in templates)
                    {
                        <div class="row g-4 py-5 border-bottom border-gray-300 border-bottom-dashed" data-tpl="@t.Kind">
                            <div class="col-lg-2"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-message-text-2 fs-3 text-primary"></i></span></div>
                                <div><div class="text-gray-900 fw-bold fs-6">@T["smk:" + t.Kind]</div>
                                <div class="text-gray-500 fw-semibold fs-7">@(t.Edited ? T["Edited"] : T["As shipped"])</div></div></div>
                                <label class="form-check form-switch form-check-custom form-check-solid mt-3"><input class="form-check-input h-20px w-35px" type="checkbox" data-t="active" @(t.IsActive ? "checked" : "") @(canManage ? "" : "disabled") /><span class="form-check-label fs-8">@T["sms:on"]</span></label></div>
                            <div class="col-lg-5"><label class="fs-6 fw-semibold mb-2">العربية</label><textarea class="form-control form-control-solid fs-7" rows="3" maxlength="480" dir="rtl" data-t="ar" @(canManage ? "" : "readonly")>@t.BodyAr</textarea></div>
                            <div class="col-lg-4"><label class="fs-6 fw-semibold mb-2">English</label><textarea class="form-control form-control-solid fs-7" rows="3" maxlength="480" dir="ltr" data-t="en" @(canManage ? "" : "readonly")>@t.BodyEn</textarea></div>
                            <div class="col-lg-1 d-flex align-items-end">@if (canManage) { <button type="button" class="btn btn-sm btn-light-primary w-100" data-tpl-save="@t.Kind"><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button> }</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!document.getElementById('rows')) return;
            var list = cbServerList({ url: @Json.Serialize(Url.Action("SmsData")), isAr: @(isAr ? "true" : "false"), addParams: function (p) { p.set('kind', document.getElementById('f_kind').value); p.set('state', document.getElementById('f_state').value); } });
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { saved: @Json.Serialize(T["Saved"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), ask: @Json.Serialize(T["Add this message to the queue?"].Value),
                      tpl: @Json.Serialize(T["Save the words of this message?"].Value), stop: @Json.Serialize(T["Stop all messages to this patient? What is waiting for them is cancelled."].Value),
                      dispatch: @Json.Serialize(T["Send every waiting message now?"].Value), sent: @Json.Serialize(T["Sent: {0}"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function patientPicker(el) {
                if (el && window.jQuery) jQuery(el).select2({ width: '100%', allowClear: true, placeholder: el.getAttribute('data-placeholder') || '—', ajax: { url: @Json.Serialize(Url.Content("~/Hospital/Patients/Search")), delay: 250, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: (d.results || d || []).map(function (x) { return { id: x.id, text: x.text || x.name }; }) }; } } });
            }
            // SMS parts: Arabic (anything outside ASCII) is 70 a part, 67 when split; Latin 160, 153 when split
            function parts(s) { if (!s) return 0; var u = /[^\x00-\x7F]/.test(s), n = s.length; return u ? (n <= 70 ? 1 : Math.ceil(n / 67)) : (n <= 160 ? 1 : Math.ceil(n / 153)); }
            var form = document.querySelector('[data-sms-form]'), lang = 'ar';
            if (form) {
                var s = function (k) { return form.querySelector('[data-s=' + k + ']'); };
                patientPicker(form.querySelector('[data-sms-patient]'));
                var count = function () { var v = s('body').value; form.querySelector('[data-n]').textContent = v.length; form.querySelector('[data-p]').textContent = parts(v); };
                s('body').addEventListener('input', count);
                form.addEventListener('click', function (e) {
                    var l = e.target.closest('[data-s-lang]');
                    if (l) { lang = l.getAttribute('data-s-lang'); form.querySelectorAll('[data-s-lang]').forEach(function (b) { b.classList.toggle('btn-primary', b === l); b.classList.toggle('btn-light', b !== l); }); s('body').setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr'); return; }
                    var t = e.target.closest('[data-sms-send]'); if (!t) return;
                    cbConfirm(W.ask).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("ComposeSms")), { patientId: s('patientId').value ? +s('patientId').value : null, phone: s('phone').value || null, language: lang, body: s('body').value })
                            .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); s('body').value = ''; count(); list.reload(); }); });
                });
            }
            var oo = document.querySelector('[data-optout-form]');
            if (oo) patientPicker(oo.querySelector('[data-optout-patient]'));
            document.addEventListener('click', function (e) {
                var t;
                if ((t = e.target.closest('[data-sms-cancel]'))) {
                    cbConfirm(t.getAttribute('data-ask'), { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Content("~/Hospital/Sms/")) + t.getAttribute('data-sms-cancel') + '/Cancel').then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); list.reload(); }); });
                } else if ((t = e.target.closest('[data-sms-optin]'))) {
                    cbConfirm(t.getAttribute('data-ask')).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("SmsOptIn")), { patientId: +t.getAttribute('data-sms-optin') }).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }); });
                } else if ((t = e.target.closest('[data-optout-add]'))) {
                    var pid = oo.querySelector('[data-optout-patient]').value; if (!pid) { toastr.error(@Json.Serialize(T["Choose the patient"].Value)); return; }
                    cbConfirm(W.stop, { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("SmsOptOut")), { patientId: +pid, reason: oo.querySelector('[data-optout-reason]').value || null }).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); }); });
                } else if ((t = e.target.closest('[data-tpl-save]'))) {
                    var row = t.closest('[data-tpl]'), q = function (k) { return row.querySelector('[data-t=' + k + ']'); };
                    cbConfirm(W.tpl).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("SaveSmsTemplate")), { kind: row.getAttribute('data-tpl'), bodyAr: q('ar').value, bodyEn: q('en').value, isActive: q('active').checked })
                            .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); }); });
                } else if ((t = e.target.closest('[data-sms-dispatch]'))) {
                    cbConfirm(W.dispatch).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("SendSmsQueue"))).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.sent.replace('{0}', res.sent)); list.reload(); }); });
                }
            });
        })();
    </script>
}
