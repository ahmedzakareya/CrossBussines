@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalRadPeerPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H259 — radiologist peer review (RADPEER): a sample of reports signed by others in the last 90 days, scored
    1 / 2 / 3 with whether the discrepancy is clinically significant; each radiologist's rates over 12 months.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Peer review"].Value;
    string q = ViewBag.Q as string ?? "", view = ViewBag.View as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p, string? v = null) => Url.Action("RadPeerReview", new { q, view = v ?? view, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Peer review"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Radiology")" class="text-muted text-hover-primary">@T["Radiology"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Peer review"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalRadReportingService.NoTables]</div></div>
        }
        <div class="row g-5">
            <div class="col-xl-8">
                <div class="card card-flush">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@(view == "mine" ? T["Reviewed by me"] : T["To review"])</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Reports signed by other radiologists in the last 90 days, in a random sample order"]</span></h3>
                        <div class="card-toolbar gap-2">
                            <a href="@Link(1, "")" class="btn btn-sm @(view == "" ? "btn-primary" : "btn-light-primary")">@T["To review"]</a>
                            <a href="@Link(1, "mine")" class="btn btn-sm @(view == "mine" ? "btn-primary" : "btn-light-primary")">@T["Reviewed by me"]</a>
                            <form class="d-flex gap-2" method="get" action="@Url.Action("RadPeerReview")">
                                <input type="hidden" name="view" value="@view" />
                                <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                                    <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search a patient, accession or study"]" /></div>
                                <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                            </form>
                        </div>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Rows.Count == 0)
                        {
                            <div class="text-center py-15"><i class="ki-outline ki-shield-tick fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No report here."]</div></div>
                        }
                        else
                        {
                            <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-175px">@T["Patient"]</th><th class="min-w-150px">@T["Study"]</th><th class="min-w-150px">@T["Radiologist"]</th><th>@T["Score"]</th><th class="text-end"></th></tr></thead>
                                <tbody>
                                @foreach (var r in Model.Rows)
                                {
                                    var rad = r.Radiologist == null ? "—" : DisplayName.Of(r.Radiologist.Name ?? "", r.Radiologist.NameEn ?? r.Radiologist.Name ?? "");
                                    <tr>
                                        <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Photo, DisplayName.Of(r.PatientName, r.PatientNameEn), 35)<div class="d-flex flex-column"><span class="text-gray-900 fw-bold">@DisplayName.Of(r.PatientName, r.PatientNameEn)</span><span class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn</span></div></div></td>
                                        <td><a href="@Url.Action("RadOrder", new { id = r.Order.ID })" target="_blank" class="fw-bold text-gray-800 text-hover-primary fs-7">@DisplayName.Of(r.Order.Name, r.Order.NameEn)</a><div class="text-muted fs-8 hp-num" dir="ltr">@r.Order.AccessionNo · @r.Order.SignedAt?.ToLocalTime().ToString("dd/MM/yyyy", inv)</div></td>
                                        <td><div class="d-flex align-items-center gap-2">@HospitalUi.Avatar(r.Radiologist?.Photo, rad, 30)<span class="fs-7 fw-semibold text-gray-800">@rad</span></div></td>
                                        <td>@if (r.Mine != null) {<span class="badge badge-light-@(r.Mine.Score == 1 ? "primary" : "danger") fs-7">@T["peer:" + r.Mine.Score]@(r.Mine.Significant ? " · " + T["Significant"].Value : "")</span>} else {<span class="text-muted fs-8">—</span>}</td>
                                        <td class="text-end"><button type="button" class="btn btn-sm btn-light-primary" data-pr="@r.Order.ID" data-score="@(r.Mine?.Score ?? 0)" data-sig="@((r.Mine?.Significant ?? false) ? "1" : "0")" data-note="@r.Mine?.Note">@(r.Mine == null ? T["Review"] : T["Edit"])</button></td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                            @if (pages > 1)
                            {
                                <ul class="pagination mt-6">
                                    <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                                    @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                                    <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                                </ul>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="card card-flush">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Discrepancy rates"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Last 12 months, per radiologist"]</span></h3></div>
                    <div class="card-body pt-2">
                        @if (Model.Stats.Count == 0) {<div class="text-muted fs-7 py-5">@T["No review yet."]</div>}
                        @foreach (var s in Model.Stats)
                        {
                            var nm = s.Face == null ? "—" : DisplayName.Of(s.Face.Name ?? "", s.Face.NameEn ?? s.Face.Name ?? "");
                            <div class="d-flex align-items-center gap-3 py-3 border-bottom border-gray-200 border-bottom-dashed">
                                @HospitalUi.Avatar(s.Face?.Photo, nm, 35)
                                <div class="flex-grow-1"><div class="fw-bold text-gray-800 fs-7">@nm</div><div class="text-muted fs-8">@T["Reviewed reports"] <span class="hp-num">@s.Reviewed</span></div></div>
                                <div class="text-end"><div class="fw-bold fs-6 hp-num @(s.Discrepancy > 5 ? "text-danger" : "text-gray-900")">@s.Discrepancy.ToString("0.0", inv)%</div><div class="text-muted fs-8">@T["Significant"] <span class="hp-num">@s.Significant.ToString("0.0", inv)%</span></div></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="prModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-600px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Peer review"]</h1><div class="text-muted fw-semibold fs-6">@T["Read the report and its images, then score it"]</div></div>
        @foreach (var n in new[] { 1, 2, 3 })
        {
            <label class="d-flex align-items-start gap-3 border border-dashed border-gray-300 rounded p-4 mb-3 cursor-pointer">
                <input class="form-check-input mt-1" type="radio" name="pr-score" value="@n" />
                <span><span class="fw-bold text-gray-800 d-block">@T["peer:" + n]</span><span class="text-muted fs-7">@T["peerdesc:" + n]</span></span>
            </label>
        }
        <label class="form-check form-switch form-check-custom form-check-solid my-4"><input class="form-check-input" type="checkbox" data-pr-sig /><span class="form-check-label fw-semibold text-gray-700">@T["Clinically significant"]</span></label>
        <label class="fs-6 fw-semibold mb-2">@T["Note"]</label><textarea class="form-control form-control-solid" rows="3" maxlength="500" dir="auto" data-pr-note></textarea>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-pr-save>@T["Save"]</button></div>
    </div>
</div></div></div>
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Radiology/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), pick: @Json.Serialize(T["Choose the score: 1, 2 or 3"].Value) };
            var m = document.getElementById('prModal'), cur = null;
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-pr],[data-pr-save]'); if (!t) return;
                if (t.hasAttribute('data-pr')) {
                    cur = t.getAttribute('data-pr');
                    m.querySelectorAll('input[name=pr-score]').forEach(function (r) { r.checked = r.value === t.getAttribute('data-score'); });
                    m.querySelector('[data-pr-sig]').checked = t.getAttribute('data-sig') === '1'; m.querySelector('[data-pr-note]').value = t.getAttribute('data-note') || '';
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                var s = m.querySelector('input[name=pr-score]:checked'); if (!s) { toastr.error(W.pick); return; }
                t.disabled = true;
                fetch(root + cur + '/PeerReview', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token },
                    body: JSON.stringify({ score: +s.value, significant: m.querySelector('[data-pr-sig]').checked, note: m.querySelector('[data-pr-note]').value || null }) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
            });
        })();
    </script>
}
