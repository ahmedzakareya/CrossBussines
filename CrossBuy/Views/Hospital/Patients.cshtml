@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalPatientPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Patient registry"].Value;
    bool canRegister = ViewBag.CanRegister == true;
    string? q = ViewBag.Query as string;
    var today = DateTime.UtcNow;
    int pages = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Model.PageSize));
    string Initials(string en) { var p = (en ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return ((p.Length > 0 ? p[0][..1] : "") + (p.Length > 1 ? p[1][..1] : "")).ToUpperInvariant(); }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Patient registry"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Hospital"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Patients"]</li>
            </ul>
        </div>
        @if (canRegister)
        {
            <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
                <a href="@Url.Action("RegisterPatient")" class="btn btn-sm btn-primary"><i class="ki-outline ki-plus fs-4"></i>@T["Register patient"]</a>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        @* H128: stat tiles (demo39 dashboards/logistics) — number over its label, a toned symbol, a bullet line *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Total patients"].Value, Model.Stats.Total, T["Every open file"].Value, "primary", "ki-profile-user"),
                (T["Registered this month"].Value, Model.Stats.ThisMonth, T["New files since the 1st"].Value, "info", "ki-calendar-add"),
                (T["Possible duplicates"].Value, Model.Stats.PossibleDuplicates, T["Same name and date of birth"].Value, Model.Stats.PossibleDuplicates > 0 ? "danger" : "primary", "ki-copy"),
                (T["Recorded allergy"].Value, Model.Stats.WithAllergy, T["Files carrying an allergy alert"].Value, "danger", "ki-shield-cross") })
            {
                <div class="col-sm-6 col-xl-3">
                    <div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column">
                                <span class="fs-2hx fw-bold text-gray-900 lh-1 hp-num">@s.Item2.ToString("N0")</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                            </div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item4"><i class="ki-outline @s.Item5 fs-2x text-@s.Item4"></i></span></div></div>
                        </div>
                        <div class="card-body d-flex align-items-end pt-0 pb-5">
                            <span class="d-flex align-items-center fs-7 fw-semibold text-gray-500"><span class="bullet bullet-dot bg-@s.Item4 me-2"></span>@s.Item3</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Patient registry"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7" data-pt-count><span class="hp-num">@Model.Total.ToString("N0")</span> @T["file(s)"]</span>
                </h3>
                <div class="card-toolbar">
                    <form method="get" action="@Url.Action("Patients")" class="d-flex align-items-center position-relative my-1" data-pt-search>
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-solid w-250px ps-12" placeholder="@T["Name, MRN, ID or mobile..."]" autocomplete="off" />
                    </form>
                </div>
            </div>
            <div class="card-body pt-2" data-pt-results>
                @if (Model.Rows.Count == 0)
                {
                    <div class="text-center py-10">
                        <i class="ki-outline ki-profile-user fs-3x text-gray-300 mb-4 d-block"></i>
                        <div class="fs-6 fw-bold text-gray-700">@(string.IsNullOrEmpty(q) ? T["No patients yet. Register the first file."] : T["No file matches this search."])</div>
                    </div>
                }
                else
                {
                    @* H128: the theme's table widget (demo39 widgets/tables) — photo (initials only when none) · name over a muted line *@
                    <div class="table-responsive">
                        <table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light">
                                <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["MRN"]</th><th>@T["ID number"]</th><th>@T["Mobile"]</th><th>@T["Registered"]</th><th class="text-end pe-4 rounded-end"></th>
                            </tr></thead>
                            <tbody>
                                @foreach (var p in Model.Rows)
                                {
                                    var age = HospitalPatientService.AgeOn(p.BirthDate, today);
                                    var url = Url.Action("Patient", new { id = p.Id });
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center min-w-0">
                                                <div class="symbol symbol-45px symbol-circle flex-shrink-0 me-4">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@Initials(p.NameEn)" />} else {<span class="symbol-label fw-bold bg-light-primary text-primary">@Initials(p.NameEn)</span>}</div>
                                                <div class="d-flex flex-column min-w-0">
                                                    <a href="@url" class="text-gray-900 text-hover-primary fs-6 fw-bold text-truncate">@DisplayName.Of(p.Name, p.NameEn)</a>
                                                    <span class="text-muted fw-semibold d-block fs-7 text-truncate">@if (age != null) {<span class="hp-num">@age</span><text>&nbsp;@T["y"] · </text>}@(p.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])@if (p.HasAllergy) {<span class="badge badge-light-danger fs-8 fw-bold ms-2">@T["Allergy"]</span>}</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@p.Mrn</span></td>
                                        <td><bdi class="text-gray-800 fw-bold fs-6 hp-num" dir="ltr">@(p.NationalId ?? "—")</bdi></td>
                                        <td><bdi class="text-gray-800 fw-bold fs-6 hp-num" dir="ltr">@(p.Phone ?? "—")</bdi></td>
                                        <td><span class="text-gray-600 fw-semibold fs-7 hp-num" dir="ltr">@p.CreatedAt.ToString("yyyy-MM-dd")</span></td>
                                        <td class="text-end pe-4"><a href="@url" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Open file"]" data-bs-toggle="tooltip"><i class="ki-outline ki-eye fs-3"></i></a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (pages > 1)
                    {
                        <div class="d-flex flex-stack flex-wrap pt-5">
                            <div class="fs-7 text-muted">@T["Page"] <span class="hp-num">@T["{0} of {1}", Model.Page, pages]</span></div>
                            <ul class="pagination">
                                <li class="page-item previous @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Patients", new { q, page = Model.Page - 1 })"><i class="previous"></i></a></li>
                                @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(pages, Model.Page + 2); i++)
                                {
                                    <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link hp-num" href="@Url.Action("Patients", new { q, page = i })">@i</a></li>
                                }
                                <li class="page-item next @(Model.Page >= pages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Patients", new { q, page = Model.Page + 1 })"><i class="next"></i></a></li>
                            </ul>
                        </div>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        // The registry searches as the desk types: the list and its count are fetched and swapped in place (never a
        // reload, the box keeps its focus); the address follows so Back and a shared link land on the same search.
        (function () {
            var form = document.querySelector('[data-pt-search]'); if (!form) return;
            var box = form.querySelector('input[name="q"]'), timer = null, seq = 0;
            function run() {
                var q = box.value.trim(), url = form.getAttribute('action') + (q ? '?q=' + encodeURIComponent(q) : ''), mine = ++seq;
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    if (mine !== seq) return;   // a newer search already went out
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    ['[data-pt-results]', '[data-pt-count]'].forEach(function (sel) { var f = doc.querySelector(sel), t = document.querySelector(sel); if (f && t) t.innerHTML = f.innerHTML; });
                    history.replaceState(null, '', url);
                });
            }
            box.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(run, 300); });
            form.addEventListener('submit', function (e) { e.preventDefault(); clearTimeout(timer); run(); });
        })();
    </script>
}
