@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalNicuBoard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H252 — the neonatal board: each admitted newborn as a card (photo, bed, day of life, postmenstrual age, weight
    against birth weight, the week's growth velocity, today's feeds per kilo) with a seven-day weight line; the day's
    record in a modal. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Neonatal unit"].Value;
    string q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages; bool canAdmit = ViewBag.CanAdmit == true;
    string Link(int p) => Url.Action("Nicu", new { q, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Spark(IReadOnlyList<HospitalNicuDay> d)
    {
        var w = d.Where(x => x.WeightGrams != null).ToList();
        if (w.Count < 2) return "";
        int min = w.Min(x => x.WeightGrams!.Value), max = w.Max(x => x.WeightGrams!.Value), span = Math.Max(1, max - min);
        return string.Join(" ", w.Select((x, i) => (i * 160 / (w.Count - 1)).ToString(inv) + "," + (36 - (x.WeightGrams!.Value - min) * 32 / span).ToString(inv)));
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Neonatal unit"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item"><a href="@Url.Action("LabourWard")" class="text-muted text-hover-primary">@T["Labour ward"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["Neonatal unit"]</li></ul>
        </div>
        <form class="d-flex gap-2" method="get" action="@Url.Action("Nicu")">
            <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search a baby"]" /></div>
            <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
        </form>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready) {<div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalNicuService.NoTables]</div></div>}
        @if (Model.Babies.Count == 0)
        {
            <div class="card card-flush"><div class="card-body text-center py-15"><i class="ki-outline ki-heart fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No newborn is admitted."]</div></div></div>
        }
        <div class="row g-5">
        @foreach (var b in Model.Babies)
        {
            var cls = HospitalNicuRules.BirthWeightClass(b.BirthWeight);
            <div class="col-md-6 col-xl-4"><div class="card card-flush h-100"><div class="card-body py-6">
                <div class="d-flex align-items-center gap-3 mb-4">
                    @HospitalUi.Avatar(b.Photo, DisplayName.Of(b.Name, b.NameEn), 45)
                    <div class="flex-grow-1 min-w-0"><a href="@Url.Action("Patient", new { id = b.PatientId })" class="fw-bold text-gray-900 text-hover-primary fs-5">@DisplayName.Of(b.Name, b.NameEn)</a>
                        <div class="text-muted fs-8">@T["Bed"] <span class="hp-num" dir="ltr">@(b.Bed ?? "—")</span> · @T["Day of life {0}", b.DayOfLife]</div></div>
                    @if (canAdmit && Model.Ready) {<button type="button" class="btn btn-sm btn-icon btn-light-primary" title="@T["Today's record"]" data-bs-toggle="tooltip" data-nicu="@b.AdmissionId" data-name="@DisplayName.Of(b.Name, b.NameEn)" data-t="@(b.Today == null ? "" : Json.Serialize(new { b.Today.WeightGrams, b.Today.LengthCm, b.Today.HeadCm, b.Today.FeedsMl, b.Today.FeedType, b.Today.Tpn, b.Today.Phototherapy, b.Today.Bilirubin }).ToString())"><i class="ki-outline ki-notepad-edit fs-3"></i></button>}
                </div>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @if (b.GestationWeeks is int ga) {<span class="badge badge-light fs-8">@T["Born at {0} weeks", ga]</span>}
                    @if (b.Pma is { } pma) {<span class="badge badge-light-primary fs-8 hp-num" dir="ltr">PMA @(pma.Weeks)+@(pma.Days)</span>}
                    @if (cls != null) {<span class="badge badge-light-@(cls == "LBW" ? "info" : "danger") fs-8">@T["bw:" + cls]</span>}
                    @if (b.Today?.Phototherapy == true) {<span class="badge badge-light-info fs-8">@T["Phototherapy"]</span>}
                    @if (b.Today?.Tpn == true) {<span class="badge badge-light-info fs-8">TPN</span>}
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-4"><div class="text-muted fs-8">@T["Weight"]</div><div class="fw-bold fs-5 hp-num" dir="ltr">@(b.Weight?.ToString(inv) ?? "—") g</div><div class="text-muted fs-9 hp-num" dir="ltr">@T["birth"] @b.BirthWeight g
                        @if (b.PercentOfBirth is decimal pc)
                        {
                            <text> · @pc.ToString("0.#", inv)%</text>
                        }
                    </div></div>
                    <div class="col-4"><div class="text-muted fs-8">@T["Growth (7 days)"]</div><div class="fw-bold fs-5 hp-num @(b.Velocity7 is < 15m ? "text-danger" : "text-primary")" dir="ltr">@(b.Velocity7?.ToString("0.#", inv) ?? "—")</div><div class="text-muted fs-9">g/kg/@T["d"]</div></div>
                    <div class="col-4"><div class="text-muted fs-8">@T["Feeds today"]</div><div class="fw-bold fs-5 hp-num" dir="ltr">@(b.FeedsPerKg?.ToString("0", inv) ?? "—")</div><div class="text-muted fs-9">mL/kg/@T["d"]@if (b.Today?.FeedType is string ft) {<text> · @T["feed:" + ft]</text>}</div></div>
                </div>
                @if (Spark(b.Recent) is string pts && pts != "") {<svg viewBox="0 0 160 40" class="w-100" style="height:40px"><polyline points="@pts" fill="none" stroke="var(--bs-primary)" stroke-width="2" /></svg>}
                @if (b.Today?.Bilirubin is int bili) {<div class="text-muted fs-8 mt-2">@T["Bilirubin"] <span class="fw-bold hp-num" dir="ltr">@bili µmol/L</span></div>}
            </div></div></div>
        }
        </div>
        @if (pages > 1)
        {
            <ul class="pagination mt-6">
                <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
            </ul>
        }
    </div></div>
</div>

@if (canAdmit && Model.Ready)
{
<div class="modal fade" id="nicuModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Today's record"]</h1><div class="text-muted fw-semibold fs-6" data-nicu-name></div></div>
        <div class="row g-4">
            <div class="col-4"><label class="fs-7 fw-semibold mb-1">@T["Weight"] (g)</label><input type="number" class="form-control form-control-solid hp-num" dir="ltr" data-nf="weightGrams" /></div>
            <div class="col-4"><label class="fs-7 fw-semibold mb-1">@T["Length"] (cm)</label><input type="number" step="0.1" class="form-control form-control-solid hp-num" dir="ltr" data-nf="lengthCm" /></div>
            <div class="col-4"><label class="fs-7 fw-semibold mb-1">@T["Head"] (cm)</label><input type="number" step="0.1" class="form-control form-control-solid hp-num" dir="ltr" data-nf="headCm" /></div>
            <div class="col-6"><label class="fs-7 fw-semibold mb-1">@T["Feeds today"] (mL)</label><input type="number" class="form-control form-control-solid hp-num" dir="ltr" data-nf="feedsMl" /></div>
            <div class="col-6"><label class="fs-7 fw-semibold mb-1">@T["Feed"]</label><select class="form-select form-select-solid" data-nf="feedType"><option value="">—</option>@foreach (var f in HospitalNicuFeed.All) {<option value="@f">@T["feed:" + f]</option>}</select></div>
            <div class="col-6"><label class="fs-7 fw-semibold mb-1">@T["Bilirubin"] (µmol/L)</label><input type="number" class="form-control form-control-solid hp-num" dir="ltr" data-nf="bilirubin" /></div>
            <div class="col-6 d-flex flex-column justify-content-end gap-2">
                <label class="form-check form-check-custom form-check-solid form-check-sm"><input class="form-check-input" type="checkbox" data-nf="tpn" /><span class="form-check-label fs-7">TPN</span></label>
                <label class="form-check form-check-custom form-check-solid form-check-sm"><input class="form-check-input" type="checkbox" data-nf="phototherapy" /><span class="form-check-label fs-7">@T["Phototherapy"]</span></label>
            </div>
        </div>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-nicu-save>@T["Save"]</button></div>
    </div>
</div></div></div>
}
@section Scripts {
    <script>
        (function () {
            var m = document.getElementById('nicuModal'); if (!m) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Nicu/")), id = 0, W = { failed: @Json.Serialize(T["The change could not be saved"].Value) };
            function f(k) { return m.querySelector('[data-nf=' + k + ']'); }
            function n(k) { return f(k).value === '' ? null : +f(k).value; }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-nicu],[data-nicu-save]'); if (!t) return;
                if (t.hasAttribute('data-nicu')) {
                    id = +t.getAttribute('data-nicu'); m.querySelector('[data-nicu-name]').textContent = t.getAttribute('data-name');
                    var d = t.getAttribute('data-t') ? JSON.parse(t.getAttribute('data-t')) : {};
                    ['weightGrams', 'lengthCm', 'headCm', 'feedsMl', 'bilirubin'].forEach(function (k) { f(k).value = d[k] == null ? '' : d[k]; });
                    f('feedType').value = d.feedType || ''; f('tpn').checked = !!d.tpn; f('phototherapy').checked = !!d.phototherapy;
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                fetch(root + id + '/Day', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token },
                    body: JSON.stringify({ weightGrams: n('weightGrams'), lengthCm: n('lengthCm'), headCm: n('headCm'), feedsMl: n('feedsMl'), feedType: f('feedType').value || null, bilirubin: n('bilirubin'), tpn: f('tpn').checked, phototherapy: f('phototherapy').checked }) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
            });
        })();
    </script>
}
