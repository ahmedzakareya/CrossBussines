@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalCarePanel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H79 — the patient's problem list (all visits) and this stay's nursing care plan, loaded into the nursing station's
    window. Suggestions from the latest Morse / Braden come first; the forms add a problem (doctors) or a plan (the ward).
*@
@{
    bool canConsult = ViewBag.CanConsult == true, canWard = ViewBag.CanWard == true;
    string Who(int? id) => id is int i && Model.People.TryGetValue(i, out var n) ? n : "";
    string D(DateTime utc) => HospitalNursingService.UtcToWard(utc).ToString("yyyy-MM-dd");
}
@if (!Model.Ready) { <div class="notice d-flex rounded border border-dashed p-6 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalCarePlanService.NoTables]</div></div> }
else
{
    <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-6 fw-bold mb-6">
        <li class="nav-item"><a class="nav-link text-active-primary active" data-bs-toggle="tab" href="#cpPlan"><i class="ki-outline ki-clipboard fs-4 me-2"></i>@T["Care plan"] <span class="badge badge-light-primary fs-8 fw-bold ms-2 hp-num">@Model.Plan.Count(p => p.Status == HospitalCarePlanStatus.Active)</span></a></li>
        <li class="nav-item"><a class="nav-link text-active-primary" data-bs-toggle="tab" href="#cpProblems"><i class="ki-outline ki-notepad fs-4 me-2"></i>@T["Problem list"] <span class="badge badge-light fs-8 fw-bold ms-2 hp-num">@Model.Problems.Count(p => p.Status == HospitalProblemStatus.Active)</span></a></li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane fade show active" id="cpPlan">
            @foreach (var s in Model.Suggestions)
            {
                <div class="notice d-flex align-items-center bg-light-primary rounded border-primary border border-dashed p-5 mb-4">
                    <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                    <div class="flex-grow-1 fs-6 fw-semibold text-gray-700">@T["Suggested: a {0} plan — the latest {1} is {2} ({3}).", T["need:" + s.Need].Value, s.Kind, s.Score, T["riskLevel:" + s.Level].Value]</div>
                    @if (canWard && Model.Active) {<button type="button" class="btn btn-sm btn-primary ms-3 text-nowrap" data-cp-use="@s.Need">@T["Write the plan"]</button>}
                </div>
            }
            @if (canWard && Model.Active)
            {
                <div class="border border-dashed border-gray-300 rounded p-6 mb-6" data-cp-form>
                    <div class="fw-bold text-gray-800 fs-6 mb-4"><i class="ki-outline ki-plus-square fs-4 text-primary me-1"></i>@T["Add to the plan"]</div>
                    <div class="row g-4">
                        <div class="col-md-5"><label class="fs-7 fw-semibold mb-2 required">@T["Nursing need"]</label><select class="form-select form-select-solid form-select-sm" data-cp="need">@foreach (var n in HospitalCareNeed.All) {<option value="@n" data-goal="@T["cpg:" + n]" data-iv="@T["cpi:" + n]">@T["need:" + n]</option>}</select></div>
                        <div class="col-md-4"><label class="fs-7 fw-semibold mb-2">@T["Need in your words"]</label><input class="form-control form-control-solid form-control-sm" maxlength="200" data-cp="needText" /></div>
                        <div class="col-md-3"><label class="fs-7 fw-semibold mb-2 required">@T["Review by"]</label><input type="date" class="form-control form-control-solid form-control-sm" dir="ltr" data-cp="reviewBy" value="@Model.Today.AddDays(2).ToString("yyyy-MM-dd")" min="@Model.Today.ToString("yyyy-MM-dd")" max="@Model.Today.AddDays(30).ToString("yyyy-MM-dd")" /></div>
                        <div class="col-12"><label class="fs-7 fw-semibold mb-2 required">@T["Goal"]</label><input class="form-control form-control-solid form-control-sm" maxlength="500" data-cp="goal" /></div>
                        <div class="col-12"><label class="fs-7 fw-semibold mb-2 required">@T["Interventions"]</label><textarea class="form-control form-control-solid form-control-sm" rows="3" maxlength="2000" data-cp="interventions"></textarea></div>
                        <div class="col-12 text-end"><button type="button" class="btn btn-sm btn-primary" data-cp-save><i class="ki-outline ki-plus fs-5"></i>@T["Add to the plan"]</button></div>
                    </div>
                </div>
            }
            @if (Model.Plan.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-clipboard fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No care plan for this stay yet."]</div></div> }
            @foreach (var p in Model.Plan)
            {
                bool open = p.Status == HospitalCarePlanStatus.Active, due = HospitalCarePlanRules.ReviewDue(p, Model.Today);
                string tone = !open ? (p.Status == HospitalCarePlanStatus.Met ? "success" : "secondary") : due ? "danger" : "primary";
                @* one plan — the theme's feed item (demo39 widgets/feeds): symbol · need over the goal · state *@
                <div class="card card-bordered mb-4 @(open ? "" : "bg-light opacity-75")"><div class="card-body p-5">
                    <div class="d-flex flex-stack flex-wrap gap-2 mb-4">
                        <div class="d-flex align-items-center">
                            <div class="symbol symbol-40px me-4 flex-shrink-0"><span class="symbol-label bg-light-@tone"><i class="ki-outline ki-@(open ? "clipboard" : p.Status == HospitalCarePlanStatus.Met ? "check-circle" : "cross-circle") fs-2 text-@(tone == "secondary" ? "gray-600" : tone)"></i></span></div>
                            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@T["need:" + p.Need]</span>@if (p.NeedText != null) {<bdi class="text-gray-500 fw-semibold fs-7">@p.NeedText</bdi>}</div>
                        </div>
                        @if (open) {<span class="badge @(due ? "badge-light-danger" : "badge-light-primary") fs-7 fw-bold">@if (due) {@T["Review due"]} else {@T["Review by {0}", p.ReviewBy.ToString("yyyy-MM-dd")]}</span>}
                        else {<span class="badge @(p.Status == HospitalCarePlanStatus.Met ? "badge-light-success" : "badge-light") fs-7 fw-bold">@T["cps:" + p.Status]</span>}
                    </div>
                    <div class="mb-3"><div class="text-gray-500 fw-semibold fs-7">@T["Goal"]</div><bdi class="text-gray-800 fw-semibold fs-6">@p.Goal</bdi></div>
                    <div><div class="text-gray-500 fw-semibold fs-7">@T["Interventions"]</div><bdi class="text-gray-800 fs-6 d-block" style="white-space:pre-wrap">@p.Interventions</bdi></div>
                    @if (!open) {<div class="mt-3"><div class="text-gray-500 fw-semibold fs-7">@T["Outcome"]</div><bdi class="text-gray-800 fs-6">@p.Outcome</bdi></div>}
                    <div class="separator separator-dashed my-4"></div>
                    <div class="d-flex flex-stack flex-wrap gap-2">
                        <div class="text-gray-500 fw-semibold fs-7">@Who(p.CreatedByEmployeeId) · <span class="hp-num">@D(p.CreatedAt)</span>@if (!open) {<text> → @Who(p.ClosedByEmployeeId) · <span class="hp-num">@D(p.ClosedAt!.Value)</span></text>}</div>
                        @if (open && canWard) {<div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-light-success" data-cp-close="@p.ID" data-status="Met" data-what="@T["need:" + p.Need]"><i class="ki-outline ki-check fs-5"></i>@T["Goal met"]</button>
                            <button type="button" class="btn btn-sm btn-light" data-cp-close="@p.ID" data-status="Discontinued" data-what="@T["need:" + p.Need]">@T["Discontinue"]</button></div>}
                    </div>
                </div></div>
            }
        </div>
        <div class="tab-pane fade" id="cpProblems">
            @if (canConsult)
            {
                <div class="border border-dashed border-gray-300 rounded p-6 mb-6" data-pb-form>
                    <div class="fw-bold text-gray-800 fs-6 mb-4"><i class="ki-outline ki-plus-square fs-4 text-primary me-1"></i>@T["Add to the list"]</div>
                    <div class="row g-4">
                        <div class="col-12"><label class="fs-7 fw-semibold mb-2">@T["Diagnosis (ICD-10)"]</label><select class="form-select form-select-solid form-select-sm" data-pb="code" data-placeholder="@T["Search by code or name…"]"><option></option></select></div>
                        <div class="col-md-8"><label class="fs-7 fw-semibold mb-2">@T["Or write the problem"]</label><input class="form-control form-control-solid form-control-sm" maxlength="200" data-pb="name" /></div>
                        <div class="col-md-4"><label class="fs-7 fw-semibold mb-2 required">@T["Kind"]</label><select class="form-select form-select-solid form-select-sm" data-pb="kind">@foreach (var k in HospitalProblemKind.All) {<option value="@k">@T["pk:" + k]</option>}</select></div>
                        <div class="col-md-4"><label class="fs-7 fw-semibold mb-2">@T["Since"]</label><input type="date" class="form-control form-control-solid form-control-sm" dir="ltr" data-pb="onsetDate" max="@Model.Today.ToString("yyyy-MM-dd")" /></div>
                        <div class="col-md-8"><label class="fs-7 fw-semibold mb-2">@T["Notes"]</label><input class="form-control form-control-solid form-control-sm" maxlength="500" data-pb="note" /></div>
                        <div class="col-12 text-end"><button type="button" class="btn btn-sm btn-primary" data-pb-save><i class="ki-outline ki-plus fs-5"></i>@T["Add to the list"]</button></div>
                    </div>
                </div>
            }
            @if (Model.Problems.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-notepad fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No problem on the patient's list yet."]</div></div> }
            else
            {
                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                    <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Problem"]</th><th>@T["Kind"]</th><th>@T["Since"]</th><th>@T["State"]</th><th class="text-end pe-4 rounded-end"></th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.Problems)
                    {
                        bool active = p.Status == HospitalProblemStatus.Active;
                        <tr class="@(active ? "" : "opacity-75")">
                            <td class="ps-4"><div class="d-flex align-items-center">
                                <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label bg-light-@(active ? "danger" : "secondary")"><i class="ki-outline ki-notepad fs-3 text-@(active ? "danger" : "gray-600")"></i></span></div>
                                <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(p.Name, p.NameEn ?? p.Name)</span>
                                    <span class="text-muted fw-semibold d-block fs-7">@if (p.Code != null) {<bdi class="hp-num me-2" dir="ltr">@p.Code</bdi>}@if (p.Note != null) {<bdi>@p.Note</bdi>}</span></div></div></td>
                            <td><span class="badge @(p.Kind == HospitalProblemKind.Chronic ? "badge-light-info" : "badge-light-primary") fs-7 fw-bold">@T["pk:" + p.Kind]</span></td>
                            <td><span class="text-gray-800 fw-semibold hp-num" dir="ltr">@(p.OnsetDate?.ToString("yyyy-MM-dd") ?? "—")</span></td>
                            <td>@if (active) {<span class="badge badge-light-danger fs-7 fw-bold">@T["pbs:Active"]</span>} else {<span class="badge badge-light fs-7 fw-bold">@T["pbs:Resolved"]</span><div class="fs-8 text-muted hp-num mt-1">@D(p.ResolvedAt!.Value)</div>}</td>
                            <td class="text-end pe-4">@if (active && canConsult) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-success" title="@T["Resolved"]" data-bs-toggle="tooltip" data-pb-resolve="@p.ID" data-what="@DisplayName.Of(p.Name, p.NameEn ?? p.Name)"><i class="ki-outline ki-check-circle fs-3"></i></button>}</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>
    </div>
}
