@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalSurveillanceRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H212 — clinical surveillance, composed from the theme (demo39): three stat badges, a filter bar, the alerts with what
    fired each (the criteria as badges), where the patient lies, the time it is due by (overdue in red) and the answer;
    answering opens a modal with the decisions of that kind and the reason a "no" needs.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Clinical surveillance"].Value;
    string q = ViewBag.Q as string ?? "", kind = ViewBag.Kind as string ?? "", status = ViewBag.Status as string ?? "all";
    bool overdue = ViewBag.Overdue == true, ready = ViewBag.Ready == true;
    int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages, total = (int)ViewBag.Total, sepsis = (int)ViewBag.Sepsis, vte = (int)ViewBag.Vte, late = (int)ViewBag.Late;
    string Link(int p, bool? od = null, string? st = null) => Url.Action("Surveillance", new { q, kind, status = st ?? status, overdue = od ?? overdue, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0 d-flex align-items-center gap-3">@T["Clinical surveillance"]
                <span class="badge badge-danger fs-7 fw-bold">@T["{0} possible sepsis", sepsis]</span>
                <span class="badge badge-light-primary fs-7 fw-bold">@T["{0} VTE assessments due", vte]</span>
                @if (late > 0) {<a href="@Link(1, true, "all")" class="badge badge-light-danger fs-7 fw-bold">@T["{0} overdue", late]</a>}</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Nursing")" class="text-muted text-hover-primary">@T["Nursing station"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Clinical surveillance"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["The surveillance table is not created yet (hospital_h212_surveillance.sql)."]</div></div>
        }
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Alerts"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} alerts", total] · @T["Sepsis: answer within the hour · VTE: assess within 24 hours of admission"]</span>
                </h3>
                <form class="card-toolbar gap-2 flex-wrap" method="get" action="@Url.Action("Surveillance")">
                    @if (overdue) {<input type="hidden" name="overdue" value="true" />}
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" name="q" value="@q" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Patient name or file"]" /></div>
                    <div class="w-150px"><select name="kind" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="@T["All"]" onchange="this.form.submit()"><option value="">@T["All"]</option>@foreach (var k in HospitalSurveillanceKind.All) {<option value="@k" selected="@(k == kind)">@T["svk:" + k]</option>}</select></div>
                    <div class="w-150px"><select name="status" class="form-select form-select-solid" data-control="select2" data-hide-search="true" onchange="this.form.submit()"><option value="all" selected="@(status == "all")">@T["All"]</option>@foreach (var s in HospitalSurveillanceStatus.All) {<option value="@s" selected="@(s == status)">@T["svs:" + s]</option>}</select></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                    @if (overdue) {<a href="@Url.Action("Surveillance")" class="btn btn-sm btn-light">@T["Show all"]</a>}
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No alert here."]</div>
                        <div class="text-muted fs-7 mt-1">@T["The record is checked after every set of observations and on every visit to this screen."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-top gs-0 gy-4 my-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 min-w-175px rounded-start">@T["Patient"]</th><th class="min-w-125px">@T["Alert"]</th><th class="min-w-200px">@T["What fired it"]</th><th class="min-w-100px">@T["Answer due by"]</th><th class="min-w-150px">@T["Answer"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var a = row.Alert; bool open = a.Status == HospitalSurveillanceStatus.Open;
                                var parts = a.Criteria.Split(';', StringSplitOptions.RemoveEmptyEntries);
                                <tr>
                                    <td class="ps-4"><a href="@Url.Action("Patient", new { id = a.PatientId })" class="text-gray-900 fw-bold text-hover-primary d-flex align-items-center gap-2 fs-7 mb-1">@HospitalUi.Avatar(row.PatientPhoto, row.PatientEn)<span>@DisplayName.Of(row.Patient, row.PatientEn)</span></a>
                                        <span class="text-muted fs-8"><bdi class="hp-num" dir="ltr">@row.Mrn</bdi>@if (row.Bed != null) {<text> · @DisplayName.Of(row.Ward ?? "", row.WardEn) · <bdi class="hp-num" dir="ltr">@row.Bed</bdi></text>}</span></td>
                                    <td><span class="badge badge-@(a.Kind == HospitalSurveillanceKind.Sepsis ? "danger" : "light-primary") fs-7 fw-bold">@T["svk:" + a.Kind]</span>
                                        <div class="text-muted fs-8 mt-1 hp-num" dir="ltr">@HospitalNursingService.UtcToWard(a.RaisedAt).ToString("MM-dd HH:mm", inv)</div></td>
                                    <td class="fs-7">
                                        @foreach (var p in parts)
                                        {
                                            var kv = p.Split('=', 2);
                                            if (kv.Length == 2) {<span class="badge badge-light-danger fw-semibold me-1 mb-1">@T["svc:" + kv[0]] <bdi class="hp-num ms-1" dir="ltr">@kv[1]</bdi></span>}
                                            else {<span class="badge badge-light fw-semibold me-1 mb-1">@T["svc:" + p]</span>}
                                        }
                                        @if (a.Score != null) {<div class="text-muted fs-8">@T["Score"] <span class="hp-num fw-bold">@a.Score</span></div>}
                                    </td>
                                    <td class="fs-7 text-nowrap"><span class="hp-num @(row.Overdue ? "text-danger fw-bold" : "text-gray-700")" dir="ltr">@HospitalNursingService.UtcToWard(a.DueAt).ToString("MM-dd HH:mm", inv)</span>@if (row.Overdue) {<div class="text-danger fs-8 fw-bold">@T["Overdue"]</div>}</td>
                                    <td class="fs-7">@if (a.Response != null) {<span class="badge badge-light-primary fw-bold">@T["svr:" + a.Response]</span>@if (a.Note != null) {<div class="text-muted fs-8 mt-1"><bdi>@a.Note</bdi></div>}<div class="mt-2">@await Html.PartialAsync("_HospitalFace", row.AnsweredBy)</div>} else {<span class="text-muted">—</span>}</td>
                                    <td class="text-end pe-4">@if (open && ready) {<button type="button" class="btn btn-sm btn-primary" data-sv-answer="@a.ID" data-kind="@a.Kind"><i class="ki-outline ki-check-square fs-4"></i>@T["Answer"]</button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination pt-6 justify-content-end">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int p = Math.Max(1, page - 3); p <= Math.Min(pages, page + 3); p++) {<li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="svModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Answer the alert"]</h1><div class="text-muted fw-semibold fs-6">@T["Your decision is kept with the alert; a \"no\" needs its reason."]</div></div>
        @foreach (var k in HospitalSurveillanceKind.All)
        {
            <div class="d-flex flex-column gap-3 mb-5 d-none" data-sv-for="@k">
                @foreach (var r in HospitalSurveillanceResponse.For(k))
                {
                    <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="radio" name="sv-@k" value="@r" /><span class="form-check-label fw-semibold text-gray-800">@T["svr:" + r]</span></label>
                }
            </div>
        }
        @* the Padua prediction score for a VTE answer: 4 or more is high risk *@
        <div class="d-none mb-5" data-sv-padua>
            <div class="fs-6 fw-bold mb-3">@T["Padua score"] <span class="badge badge-light-primary ms-2 hp-num" data-padua-total>0</span> <span class="badge badge-danger ms-1 d-none" data-padua-high>@T["High risk"]</span></div>
            <div class="row g-2">
                @foreach (var (k, pts) in HospitalSurveillanceRules.PaduaItems)
                {
                    <div class="col-md-6"><label class="form-check form-check-custom form-check-solid form-check-sm"><input class="form-check-input" type="checkbox" value="@k" data-points="@pts" /><span class="form-check-label fs-7">@T["padua:" + k] <span class="text-muted hp-num">(@pts)</span></span></label></div>
                }
            </div>
        </div>
        <label class="fs-6 fw-semibold mb-2">@T["Reason / note"]</label>
        <textarea class="form-control form-control-solid" rows="3" maxlength="500" data-sv-note></textarea>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-sv-save>@T["Save"]</button></div>
    </div>
</div></div></div>

@section Scripts {
    <script>
        (function () {
            var tk = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tk) return;
            var token = tk.value, root = @Json.Serialize(Url.Content("~/Hospital/Wards/Surveillance/")), m = document.getElementById('svModal'), id = null, kind = null;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), choose: @Json.Serialize(T["Choose the decision"].Value) };
            function score() {
                var n = 0; m.querySelectorAll('[data-sv-padua] input:checked').forEach(function (c) { n += Number(c.getAttribute('data-points')); });
                m.querySelector('[data-padua-total]').textContent = n; m.querySelector('[data-padua-high]').classList.toggle('d-none', n < 4);
            }
            m.addEventListener('change', function (e) { if (e.target.closest('[data-sv-padua]')) score(); });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-sv-answer],[data-sv-save]'); if (!t) return;
                if (t.hasAttribute('data-sv-answer')) {
                    id = t.getAttribute('data-sv-answer'); kind = t.getAttribute('data-kind');
                    m.querySelectorAll('[data-sv-for]').forEach(function (d) { d.classList.toggle('d-none', d.getAttribute('data-sv-for') !== kind); });
                    m.querySelectorAll('input[type=radio]').forEach(function (r) { r.checked = false; });
                    m.querySelector('[data-sv-note]').value = '';
                    var pd = m.querySelector('[data-sv-padua]'); pd.classList.toggle('d-none', kind !== 'Vte');
                    pd.querySelectorAll('input').forEach(function (c) { c.checked = false; }); score();
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                var picked = m.querySelector('input[name="sv-' + kind + '"]:checked');
                if (!picked) { toastr.error(W.choose); return; }
                t.disabled = true;
                fetch(root + id + '/Answer', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token },
                    body: JSON.stringify({ response: picked.value, note: m.querySelector('[data-sv-note]').value,
                        padua: kind === 'Vte' ? Array.prototype.map.call(m.querySelectorAll('[data-sv-padua] input:checked'), function (c) { return c.value; }) : null }) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(m).hide(); setTimeout(function () { location.reload(); }, 400); });
            });
        })();
    </script>
}
