@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model HospitalSessionKitCard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H122/H130 — a unit's kit card, one for the three treatment units: the theme's table widget (demo39 widgets/tables) with
    the components and what the unit's store holds. On one session's page (SessionId) it also says whether that session's
    kit left, offers to issue it, and warns while it waits for the store; on a course or an episode page it shows what each
    session draws (each row carries its own state, _SessionKitCell).
*@
@if (Model?.Kit is { Ready: true } kit)
{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    bool one = Model.SessionId != null;
    bool kitShort = kit.IssuedAt == null && kit.Lines.Any(l => l.InStore < l.Qty);
    string unitPage = Url.Action(HospitalSessionKitRules.UnitAction(Model.Unit), "Hospital") + "#unit-settings";
    <div class="card card-flush mb-5" data-kit>
        <div class="card-header pt-5">
            <h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold text-gray-800">@T[one ? "Session kit" : "kitcard:" + Model.Unit]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7">@(kit.KitItemId != null ? DisplayName.Of(kit.KitName ?? "", kit.KitNameEn ?? "") : T["The unit has no kit set"].Value) · @T["From the unit's store"]: <bdi>@(kit.StoreName ?? T["not set"].Value)</bdi></span>
            </h3>
            <div class="card-toolbar gap-2">
                @if (one && kit.IssuedAt != null) { <span class="badge badge-light-success fs-7 fw-bold py-3 px-4"><i class="ki-outline ki-check-circle fs-5 text-success me-2"></i>@T["Issued from the store"] <bdi class="hp-num ms-2" data-fmt data-utc="@kit.IssuedAt?.ToString("o")">@kit.IssuedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</bdi></span> }
                else if (one && Model.Completed && kit.KitItemId != null) { <button type="button" class="btn btn-sm btn-primary" data-kit-issue-unit="@Model.Unit" data-kit-id="@Model.SessionId"><i class="ki-outline ki-exit-up fs-4"></i>@T["Issue the kit now"]</button> }
                else if (kit.KitItemId != null) { <span class="badge badge-light-primary fs-7 fw-bold py-3 px-4"><i class="ki-outline ki-time fs-5 text-primary me-2"></i>@T["kitwhen:" + Model.Unit]</span> }
            </div>
        </div>
        <div class="card-body pt-2">
            @if (one && kitShort && Model.Completed)
            {
                <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5">
                    <i class="ki-outline ki-information fs-2tx text-danger me-4"></i>
                    <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["The kit is waiting for the store"]</h4>
                        <div class="fs-6 text-gray-700">@T["The session is finished; its kit leaves the store once the store holds every component."]</div>
                    </div></div>
                </div>
            }
            @if (kit.Lines.Count > 0)
            {
                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                    <thead><tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-250px rounded-start">@T["Item"]</th><th class="text-end min-w-100px">@T["Qty"]</th><th class="text-end pe-4 min-w-150px rounded-end">@T["In the unit's store"]</th></tr></thead>
                    <tbody>@foreach (var l in kit.Lines)
                    {
                        bool lineShort = kit.IssuedAt == null && l.InStore < l.Qty;
                        <tr>
                            <td class="ps-4"><div class="d-flex align-items-center">
                                <div class="symbol symbol-45px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-capsule fs-2 text-primary"></i></span></div>
                                <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(l.Name, l.NameEn)</span><bdi class="text-muted fw-semibold d-block fs-7" dir="ltr">@l.Code</bdi></div>
                            </div></td>
                            <td class="text-end"><span class="text-gray-900 fw-bold d-block fs-6 hp-num">@l.Qty.ToString("0.###", inv)</span></td>
                            <td class="text-end pe-4">@if (one && kit.IssuedAt != null) {<span class="text-muted fw-bold hp-num">@l.InStore.ToString("0.###", inv)</span>}
                                else {<span class="badge badge-light-@(lineShort ? "danger" : "success") fs-7 fw-bold hp-num">@l.InStore.ToString("0.###", inv)</span>}</td>
                        </tr>
                    }</tbody>
                </table></div>
            }
            else if (kit.KitItemId == null)
            {
                <div class="text-center py-10">
                    <i class="ki-outline ki-parcel fs-3x text-gray-300 mb-4 d-block"></i>
                    <div class="fs-5 fw-bold text-gray-700 mb-1">@T["The unit has no kit set"]</div>
                    <div class="fs-7 text-muted mb-5">@T["An inventory bundle whose bill of materials lists the consumables of one session."]</div>
                    @if (Model.CanManage) {<a href="@unitPage" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-setting-2 fs-4"></i>@T["Unit settings"]</a>}
                </div>
            }
        </div>
    </div>
    @await Html.PartialAsync("_SessionKitScript")
}
