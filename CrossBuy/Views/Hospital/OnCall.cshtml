@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalOnCallWeek
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H68 — on-call. Who every department calls now (first on call, then the backup), the week board — departments down,
    Saturday to Friday across, each shift on the day it starts (a night shift shows where it ends) — and, for the
    administrator, a shift planned in a minute or cancelled with why. Every write asks first.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["On-call"].Value;
    bool canManage = ViewBag.CanManage == true;
    DateTime today = ViewBag.Today is DateTime td ? td : DateTime.Today;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var days = Enumerable.Range(0, 7).Select(i => Model.From.AddDays(i)).ToList();
    string Hm(DateTime d) => d.ToString("HH:mm", inv);
    string Span(HospitalOnCallShift s) => Hm(s.StartsAt) + "–" + Hm(s.EndsAt) + (s.EndsAt.Date > s.StartsAt.Date ? " +1" : "");
    string Ymd(DateTime d) => d.ToString("yyyy-MM-dd", inv);
    var wardNow = HospitalNursingService.UtcToWard(DateTime.UtcNow);
    bool rtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()
<style>
    .hp-oc-grid { table-layout: fixed; width: 100%; min-width: 900px; }
    .hp-oc-grid th, .hp-oc-grid td { vertical-align: top; padding-inline: .3rem !important; }
    .hp-oc-grid col.hp-oc-dept { width: 120px; }
    .hp-oc-grid .hp-oc-today { background: var(--bs-primary-light); }
    .hp-oc-chip { border-radius: .6rem; padding: .45rem .5rem; overflow: hidden; margin-bottom: .4rem; border: 1px solid var(--bs-gray-200); background: var(--bs-body-bg); }
    .hp-oc-chip.is-first { border-inline-start: 3px solid var(--bs-primary); }
    .hp-oc-chip.is-backup { border-inline-start: 3px solid var(--bs-gray-400); }
    .hp-oc-chip.is-cancelled { opacity: .55; }
    .hp-oc-chip.is-cancelled .hp-oc-time { text-decoration: line-through; }
</style>

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["On-call"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Doctors & staff"]</li></ul>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("OnCall", new { week = Ymd(Model.From.AddDays(-7)) })" class="btn btn-sm btn-icon btn-light" title="@T["Previous week"]"><i class="ki-outline @(rtl ? "ki-arrow-right" : "ki-arrow-left") fs-3"></i></a>
            <span class="fw-bold fs-6 text-gray-800 px-2"><bdi class="hp-num" dir="ltr">@Model.From.ToString("dd/MM", inv) – @Model.From.AddDays(6).ToString("dd/MM/yyyy", inv)</bdi></span>
            <a href="@Url.Action("OnCall", new { week = Ymd(Model.From.AddDays(7)) })" class="btn btn-sm btn-icon btn-light" title="@T["Next week"]"><i class="ki-outline @(rtl ? "ki-arrow-left" : "ki-arrow-right") fs-3"></i></a>
            @if (Model.From != HospitalOnCallRules.WeekStart(today)) { <a href="@Url.Action("OnCall")" class="btn btn-sm btn-light-primary">@T["This week"]</a> }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalOnCallService.NoTables]</div></div> }
        else
        {
            <div class="row g-5 mb-5">
                <div class="@(canManage ? "col-xl-7" : "col-12")">
                    <div class="card h-100">
                        <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["On call now"]</span><span class="text-muted fs-7 mt-1">@T["Whom each department calls at this moment"]</span></div></div>
                        <div class="card-body pt-2">
                            @if (Model.Now.Count == 0) { <div class="notice d-flex rounded border border-dashed p-5 hp-notice"><div class="fs-7 text-gray-700">@T["Nobody is on call right now."]</div></div> }
                            else
                            {
                                <div class="row g-3">
                                @foreach (var g in Model.Now.GroupBy(r => r.Shift.DepartmentId))
                                {
                                    var f = g.First();
                                    <div class="col-md-6"><div class="border border-gray-200 rounded p-4 h-100">
                                        <div class="fw-bold text-gray-800 fs-7 mb-3">@DisplayName.Of(f.Department, f.DepartmentEn ?? f.Department)</div>
                                        @foreach (var r in g)
                                        {
                                            <div class="d-flex align-items-center gap-3 mb-2">
                                                <div class="symbol symbol-40px symbol-circle">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(r.DoctorEn)</span>}</div>
                                                <div class="flex-grow-1"><div class="fw-bold text-gray-900 fs-7">@DisplayName.Of(r.Doctor, r.DoctorEn)</div>
                                                    <div class="text-muted fs-8">@T["oc:until"] <bdi class="hp-num" dir="ltr">@Hm(r.Shift.EndsAt)</bdi></div></div>
                                                <span class="badge @(r.Shift.Level == HospitalOnCallLevel.First ? "badge-light-primary" : "badge-light") fs-8">@T["oc:" + r.Shift.Level]</span>
                                            </div>
                                        }
                                    </div></div>
                                }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                @if (canManage)
                {
                    <div class="col-xl-5">
                        <div class="card h-100" data-oc-form>
                            <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Plan a shift"]</span></div></div>
                            <div class="card-body pt-2"><div class="row g-4">
                                <div class="col-6"><label class="form-label fs-7 required">@T["Department"]</label>
                                    <select class="form-select form-select-solid" data-oc="departmentId"><option value="">—</option>@foreach (var d in Model.Departments) { <option value="@d.ID">@DisplayName.Of(d.Name, d.NameEn ?? d.Name)</option> }</select></div>
                                <div class="col-6"><label class="form-label fs-7 required">@T["Doctor"]</label>
                                    <select class="form-select form-select-solid" data-oc="practitionerId"><option value="">—</option>@foreach (var p in Model.Doctors) { <option value="@p.ID" data-dept="@p.DepartmentId">@DisplayName.Of(p.Name, p.NameEn)</option> }</select></div>
                                <div class="col-12"><div class="btn-group w-100">
                                    @foreach (var l in HospitalOnCallLevel.All) { <button type="button" class="btn btn-sm @(l == HospitalOnCallLevel.First ? "btn-primary" : "btn-light")" data-oc-level="@l">@T["oc:" + l]</button> }
                                </div></div>
                                <div class="col-4"><label class="form-label fs-7 required">@T["Day"]</label><input type="date" class="form-control form-control-solid hp-num" data-oc="date" value="@Ymd(today)" /></div>
                                <div class="col-4"><label class="form-label fs-7 required">@T["From"]</label><input class="form-control form-control-solid hp-num" data-oc="from" data-oc-time value="20:00" /></div>
                                <div class="col-4"><label class="form-label fs-7 required">@T["To"]</label><input class="form-control form-control-solid hp-num" data-oc="to" data-oc-time value="08:00" /></div>
                                <div class="col-12 text-muted fs-8">@T["An end at or before the start runs into the next morning."]</div>
                                <div class="col-12"><label class="form-label fs-7">@T["Note"]</label><input class="form-control form-control-solid" maxlength="300" dir="auto" data-oc="note" /></div>
                                <div class="col-12"><button type="button" class="btn btn-primary w-100" data-oc-plan><i class="ki-outline ki-calendar-add fs-4"></i>@T["Add the shift"]</button></div>
                            </div></div>
                        </div>
                    </div>
                }
            </div>
            <div class="card">
                <div class="card-header border-0 pt-6"><div class="card-title flex-column m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["The week"]</span>
                    <span class="text-muted fs-7 mt-1"><span class="hp-num">@Model.Shifts.Count(s => s.Shift.CancelledAt == null)</span> @T["shifts"]</span></div></div>
                <div class="card-body pt-2"><div class="table-responsive"><table class="table table-row-dashed align-top fs-7 gy-3 mb-0 hp-oc-grid">
                    <colgroup><col class="hp-oc-dept" />@foreach (var d in days) {<col />}</colgroup>
                    <thead><tr class="text-gray-500 fw-bold fs-8 text-uppercase">
                        <th>@T["Department"]</th>
                        @foreach (var d in days) { <th class="@(d == today ? "hp-oc-today rounded" : "")">@T["day:" + d.DayOfWeek]<div class="hp-num fw-semibold text-gray-600" dir="ltr">@d.ToString("dd/MM", inv)</div></th> }
                    </tr></thead>
                    <tbody>
                        @foreach (var dep in Model.Departments)
                        {
                            <tr>
                                <td class="fw-bold text-gray-800">@DisplayName.Of(dep.Name, dep.NameEn ?? dep.Name)</td>
                                @foreach (var d in days)
                                {
                                    <td class="@(d == today ? "hp-oc-today" : "")">
                                        @foreach (var r in Model.Shifts.Where(s => s.Shift.DepartmentId == dep.ID && s.Shift.StartsAt.Date == d).OrderBy(s => s.Shift.StartsAt).ThenBy(s => s.Shift.Level == HospitalOnCallLevel.First ? 0 : 1))
                                        {
                                            var s = r.Shift; bool off = s.CancelledAt != null;
                                            <div class="hp-oc-chip @(off ? "is-cancelled" : s.Level == HospitalOnCallLevel.First ? "is-first" : "is-backup")" data-oc-row="@s.ID" title="@(off ? s.CancelReason : s.Note)">
                                                <div class="d-flex align-items-start justify-content-between gap-1"><div class="hp-num fw-bold text-gray-800 hp-oc-time fs-8 text-nowrap" dir="ltr">@Span(s)</div>@if (canManage && !off && s.EndsAt > wardNow) { <button type="button" class="btn btn-icon btn-sm btn-active-light-danger w-20px h-20px" title="@T["Cancel"]" data-oc-cancel="@s.ID" data-prompt="@string.Format(T["Why is this shift of {0} cancelled?"].Value, DisplayName.Of(r.Doctor, r.DoctorEn))"><i class="ki-outline ki-cross fs-6"></i></button> }</div>
                                                <span class="badge @(s.Level == HospitalOnCallLevel.First ? "badge-light-primary" : "badge-light") fs-9 mt-1">@T["oc:" + s.Level]</span>
                                                <div class="d-flex align-items-center gap-2 mt-2 min-w-0">
                                                    <div class="symbol symbol-25px flex-shrink-0 symbol-circle">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" />} else {<span class="symbol-label fs-9 fw-bold hp-initials">@HospitalUi.Initials(r.DoctorEn)</span>}</div>
                                                    <span class="fs-8 text-gray-800 flex-grow-1 lh-sm">@DisplayName.Of(r.Doctor, r.DoctorEn)</span>
                                                </div>
                                                @if (off) {<div class="text-muted fs-9 mt-1" dir="auto">@T["Cancelled"]: @s.CancelReason</div>}
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table></div></div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { saved: @Json.Serialize(T["Saved"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), ask: @Json.Serialize(T["Add this on-call shift?"].Value) };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            var form = document.querySelector('[data-oc-form]'), level = 'First';
            if (form) {
                var f = function (k) { return form.querySelector('[data-oc=' + k + ']'); };
                if (window.flatpickr) form.querySelectorAll('[data-oc-time]').forEach(function (el) { flatpickr(el, { enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, allowInput: true, disableMobile: true }); });
                // a department chosen puts its own doctors first in the list
                f('departmentId').addEventListener('change', function () {
                    var dep = this.value, sel = f('practitionerId'), opts = Array.prototype.slice.call(sel.options, 1);
                    opts.sort(function (a, b) { return (b.getAttribute('data-dept') === dep) - (a.getAttribute('data-dept') === dep) || a.text.localeCompare(b.text); }).forEach(function (o) { sel.appendChild(o); });
                    var mine = opts.filter(function (o) { return o.getAttribute('data-dept') === dep; }); if (mine.length && !sel.value) sel.value = mine[0].value;
                });
                form.addEventListener('click', function (e) {
                    var l = e.target.closest('[data-oc-level]');
                    if (l) { level = l.getAttribute('data-oc-level'); form.querySelectorAll('[data-oc-level]').forEach(function (b) { b.classList.toggle('btn-primary', b === l); b.classList.toggle('btn-light', b !== l); }); return; }
                    var t = e.target.closest('[data-oc-plan]'); if (!t) return;
                    cbConfirm(W.ask).then(function (ok) { if (!ok) return; t.disabled = true;
                        post(@Json.Serialize(Url.Action("PlanOnCall")), { departmentId: +f('departmentId').value || 0, practitionerId: +f('practitionerId').value || 0, level: level,
                            date: f('date').value, from: f('from').value, to: f('to').value, note: f('note').value || null })
                            .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }); });
                });
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-oc-cancel]'); if (!t) return;
                cbPrompt(t.getAttribute('data-prompt'), { kind: 'danger' }).then(function (v) { if (v == null) return; t.disabled = true;
                    post(@Json.Serialize(Url.Content("~/Hospital/OnCall/")) + t.getAttribute('data-oc-cancel') + '/Cancel', { reason: v })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }); });
            });
        })();
    </script>
}
