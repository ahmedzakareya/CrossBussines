@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalLabourRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H86 — the labour ward: every labour in progress, the most worrying first (its latest warnings, then the longest since
    anyone looked), and starting a partograph for a woman admitted.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Labour ward"].Value;
    bool ready = ViewBag.Ready == true, canWard = ViewBag.CanWard == true;
    var cands = (ViewBag.Candidates as List<(int Id, string Text)>) ?? new();
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Labour ward"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Maternity"]</li></ul>
        </div>
        @if (ready && canWard && cands.Count > 0)
        {
            <div class="d-flex gap-2 align-items-center">
                <select id="startPick" class="form-select form-select-solid form-select-sm w-300px"><option value="">@T["Choose an admitted woman…"]</option>@foreach (var c in cands) {<option value="@c.Id">@c.Text</option>}</select>
                <input type="datetime-local" id="startAt" class="form-control form-control-solid form-control-sm w-200px" dir="ltr" title="@T["Labour started at (empty means now)"]" />
                <button type="button" class="btn btn-sm btn-primary text-nowrap" data-start><i class="ki-outline ki-plus fs-4"></i>@T["Start a partograph"]</button>
            </div>
        }
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready) { <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice"><div class="fs-6 text-gray-700">@T[HospitalLabourService.NoTables]</div></div> }
        else if (Model.Count == 0) { <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-heart fs-3x text-gray-300 d-block mb-4"></i>@T["No labour in progress."]</div></div> }
        else
        {
            <div class="row g-5">
                @foreach (var r in Model)
                {
                    var o = r.Last;
                    <div class="col-md-6 col-xl-4"><div class="card h-100 border-top border-3 border-@(r.Warnings.Count > 0 ? "danger" : "primary")"><div class="card-body py-5">
                        <div class="d-flex flex-stack mb-3">
                            <div><a href="@Url.Action("Partograph", new { id = r.Labour.ID })" class="fs-5 fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(r.Name, r.NameEn)</a>
                                <div class="text-muted fs-8"><bdi class="hp-num">@r.Mrn</bdi>@if (r.Bed != null) {<text> · @T["Bed"] <bdi class="hp-num fw-bold">@r.Bed</bdi></text>}</div></div>
                            <span class="badge @(r.MinutesSinceLast > 60 ? "badge-light-danger" : "badge-light") fs-8">@T["{0} min since the last look", r.MinutesSinceLast]</span>
                        </div>
                        <div class="d-flex gap-5 mb-3 hp-num">
                            <div><div class="text-muted fs-9">@T["Cervix"]</div><div class="fs-2 fw-bold">@(o?.CervixCm?.ToString("0.#") ?? "—") <span class="fs-8 text-muted">cm</span></div></div>
                            <div><div class="text-muted fs-9">@T["Fetal heart"]</div><div class="fs-2 fw-bold @(o?.FetalHeartRate is int f && (f < 110 || f > 160) ? "text-danger" : "")">@(o?.FetalHeartRate?.ToString() ?? "—")</div></div>
                            <div><div class="text-muted fs-9">@T["Contractions"]</div><div class="fs-2 fw-bold">@(o?.ContractionsPer10?.ToString() ?? "—")<span class="fs-8 text-muted">/10</span></div></div>
                        </div>
                        <div class="d-flex flex-wrap gap-1">@foreach (var w in r.Warnings) {<span class="badge badge-light-danger fs-9">@T["lbw:" + w]</span>}</div>
                        <a href="@Url.Action("Partograph", new { id = r.Labour.ID })" class="btn btn-sm btn-light-primary w-100 mt-4">@T["Open the partograph"]</a>
                    </div></div></div>
                }
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var b = document.querySelector('[data-start]'); if (!b) return;
            var tok = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), ask: @Json.Serialize(T["Start a partograph for this woman?"].Value), pick: @Json.Serialize(T["Choose an admitted woman…"].Value) };
            b.addEventListener('click', function () {
                var id = document.getElementById('startPick').value; if (!id) { toastr.error(W.pick); return; }
                cbConfirm(W.ask).then(function (ok) { if (!ok) return; b.disabled = true;
                    fetch(@Json.Serialize(Url.Content("~/Hospital/Labour/Start/")) + id, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify({ startedAt: document.getElementById('startAt').value || null }) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { b.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } location.href = @Json.Serialize(Url.Content("~/Hospital/Labour/")) + res.id; }); });
            });
        })();
    </script>
}
