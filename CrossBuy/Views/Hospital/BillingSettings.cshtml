@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalBillingSettings
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Billing settings"].Value;
    var accounts = (ViewBag.Accounts as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    var currency = ViewBag.Currency as HospitalCurrency;
    var maps = new (string Key, string Label, string Hint, int? Value)[] {
        ("cashAccountId", T["Cash"].Value, T["Cash payments and the cashier's till"].Value, Model.CashAccountId),
        ("bankAccountId", T["Bank"].Value, T["Card, transfer and wallet payments"].Value, Model.BankAccountId),
        ("receivableAccountId", T["Patient receivables"].Value, T["What patients owe once a bill closes"].Value, Model.ReceivableAccountId),
        ("revenueAccountId", T["Revenue (default)"].Value, T["Used for a service with no revenue account of its own"].Value, Model.RevenueAccountId),
        ("vatAccountId", T["Output VAT"].Value, T["Tax on taxable services"].Value, Model.VatAccountId),
        ("cashOverShortAccountId", T["Cash over/short"].Value, T["A difference found when a shift is counted"].Value, Model.CashOverShortAccountId),
        ("fxDifferenceAccountId", T["Exchange differences"].Value, T["A foreign-currency bill paid at a rate other than its closing rate"].Value, Model.FxDifferenceAccountId) };
    // H20: the insurance accounts (their own tables: Ready = false until hospital_h20_claim_accounting.sql runs)
    var ins = ViewBag.Insurance is ValueTuple<bool, HospitalInsuranceAccounts?, IReadOnlyDictionary<int, int>> im ? im : (false, null, new Dictionary<int, int>());
    var payers = (ViewBag.Payers as List<HospitalPayer>) ?? new();
    var bloodMap = (ViewBag.BloodMap as IReadOnlyDictionary<string, int>) ?? new Dictionary<string, int>();
    var services = (ViewBag.Services as IReadOnlyList<HospitalService>) ?? Array.Empty<HospitalService>();
    var insMaps = new (string Key, string Label, string Hint, int? Value)[] {
        ("payerReceivableAccountId", T["Payer receivables"].Value, T["What payers owe once an insured bill closes; never the patients' account"].Value, ins.Item2?.PayerReceivableAccountId),
        ("claimAdjustmentAccountId", T["Claim adjustments"].Value, T["What a payer accepts short of what was claimed"].Value, ins.Item2?.ClaimAdjustmentAccountId),
        ("claimRejectionAccountId", T["Claim rejections"].Value, T["What a payer rejects, and recovers when a resubmission is accepted"].Value, ins.Item2?.ClaimRejectionAccountId) };
}
@* H127 — billing settings as demo39 form cards (card-flush headers, labelled solid fields), notices by tone. *@
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Billing settings"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Billing settings"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <button type="button" class="btn btn-sm btn-primary" data-save><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <form id="settingsForm" autocomplete="off">
        <div class="row g-5 g-xl-8">
            <div class="col-xl-4">
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Tax"]</span></h3>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-percentage fs-2 text-primary"></i></span></div></div>
                    </div>
                    <div class="card-body pt-2">
                        <label class="fs-6 fw-semibold mb-2">@T["VAT rate"]</label>
                        <div class="input-group input-group-solid"><input name="vatRatePercent" type="number" min="0" max="100" step="0.01" value="@Model.VatRatePercent.ToString("0.##")" class="form-control form-control-solid hp-num" dir="ltr" /><span class="input-group-text">%</span></div>
                        <div class="text-gray-500 fw-semibold fs-7 mt-3">@T["Applies only to services marked taxable. Medical services are usually exempt; Kuwait has no VAT."]</div>
                    </div>
                </div>
                <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5">
                    <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                    <div class="fw-semibold">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["Through the accounting engine"]</h4>
                        <div class="fs-6 text-gray-700">@T["Bills, payments and cash differences post through the same journal engine as the rest of the system, into these accounts, in"] <span class="hp-num">@(currency?.Code ?? "")</span>.</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-8">
                <div class="card card-flush">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Accounts"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Only active posting accounts of this company are offered"]</span></h3>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-success"><i class="ki-outline ki-book fs-2 text-success"></i></span></div></div>
                    </div>
                    <div class="card-body pt-2"><div class="row g-6">
                        @foreach (var m in maps)
                        {
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@m.Label</label>
                                <select name="@m.Key" class="form-select form-select-solid"><option value="">—</option>
                                    @foreach (var a in accounts) { <option value="@a.Id" selected="@(a.Id == m.Value)">@a.Label · @DisplayName.Of(a.Name, a.NameEn)</option> }
                                </select>
                                <div class="text-gray-500 fw-semibold fs-7 mt-2">@m.Hint</div></div>
                        }
                    </div></div>
                </div>

                <div class="card card-flush mt-5" data-insurance>
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Insurance accounts"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Until these are mapped, an insured bill cannot close and a payer's answer cannot be recorded"]</span></h3>
                    @if (ins.Item1) { <div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-save-insurance><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div> }
                    </div>
                    <div class="card-body pt-2">
                        @if (!ins.Item1)
                        {
                            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5">
                                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Insurance accounting is not set up yet"]</h4>
                                    <div class="fs-6 text-gray-700">@T["Its tables are created by the database update hospital_h20_claim_accounting.sql. Until then, self-pay bills close as before, and insured bills wait."]</div></div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-6">
                                @foreach (var m in insMaps)
                                {
                                    <div class="col-md-4"><label class="fs-6 fw-semibold mb-2">@m.Label</label>
                                        <select name="@m.Key" class="form-select form-select-solid"><option value="">—</option>
                                            @foreach (var a in accounts) { <option value="@a.Id" selected="@(a.Id == m.Value)">@a.Label · @DisplayName.Of(a.Name, a.NameEn)</option> }
                                        </select>
                                        <div class="text-gray-500 fw-semibold fs-7 mt-2">@m.Hint</div></div>
                                }
                            </div>
                            @if (payers.Count > 0)
                            {
                                <div class="separator separator-dashed my-6"></div>
                                <div class="fw-bold text-gray-800 fs-5 mb-1">@T["A payer's own receivable"]</div>
                                <div class="text-gray-500 fw-semibold fs-7 mb-4">@T["Leave a payer on the company's payer receivable, or give it an account of its own"]</div>
                                <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                    <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Payer"]</th><th class="pe-4 rounded-end">@T["Account"]</th></tr></thead>
                                    <tbody>
                                        @foreach (var p in payers)
                                        {
                                            int? own = ins.Item3.TryGetValue(p.ID, out var o) ? o : null;
                                            <tr>
                                                <td class="ps-4 w-250px"><div class="d-flex align-items-center"><div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-shield-tick fs-3 text-primary"></i></span></div>
                                                    <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(p.Name, p.NameEn)</bdi></span><bdi class="text-muted fw-semibold fs-7 hp-num">@p.Code</bdi></div></div></td>
                                                <td class="pe-4"><select class="form-select form-select-solid form-select-sm" data-payer-account="@p.ID"><option value="">@T["The company's payer receivable"]</option>
                                                    @foreach (var a in accounts) { <option value="@a.Id" selected="@(a.Id == own)">@a.Label · @DisplayName.Of(a.Name, a.NameEn)</option> }
                                                </select></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                            }
                        }
                    </div>
                </div>
                @* H51: what an issued blood request is charged as *@
                <div class="card card-flush mt-5" data-blood>
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Blood products"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Issuing a blood request charges the bags to the patient's bill as this service; a product with none is issued uncharged"]</span></h3>
                    <div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-save-blood><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div>
                    </div>
                    <div class="card-body pt-2"><div class="row g-6">
                        @foreach (var p in HospitalBloodProduct.All)
                        {
                            int? cur = bloodMap.TryGetValue(p, out var sid) ? sid : null;
                            <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["bp:" + p]</label>
                                <select class="form-select form-select-solid" data-blood-product="@p"><option value="">@T["Not charged"]</option>
                                    @foreach (var s in services) { <option value="@s.ID" selected="@(s.ID == cur)">@s.Code · @DisplayName.Of(s.Name, s.NameEn)</option> }
                                </select></div>
                        }
                    </div></div>
                </div>
            </div>
        </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('settingsForm');
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            function n(k) { var v = form.elements[k].value; return v === '' ? null : +v; }
            document.querySelector('[data-save]').addEventListener('click', function () {
                var b = this; b.disabled = true;
                var body = { vatRatePercent: +(form.elements.vatRatePercent.value || 0), cashAccountId: n('cashAccountId'), bankAccountId: n('bankAccountId'), receivableAccountId: n('receivableAccountId'),
                    revenueAccountId: n('revenueAccountId'), vatAccountId: n('vatAccountId'), cashOverShortAccountId: n('cashOverShortAccountId'), fxDifferenceAccountId: n('fxDifferenceAccountId') };
                fetch(@Json.Serialize(Url.Action("SaveBillingSettings")), { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { b.disabled = false; if (window.toastr) { if (res.ok) toastr.success(@Json.Serialize(T["Saved"].Value)); else toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); } });
            });
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            function told(res) { if (window.toastr) { if (res.ok) toastr.success(@Json.Serialize(T["Saved"].Value)); else toastr.error(res.error || @Json.Serialize(T["The change could not be saved"].Value)); } return res; }
            var ins = document.querySelector('[data-save-insurance]');
            if (ins) ins.addEventListener('click', function () {
                var b = this; b.disabled = true;
                post(@Json.Serialize(Url.Action("SaveInsuranceAccounts")), { payerReceivableAccountId: n('payerReceivableAccountId'), claimAdjustmentAccountId: n('claimAdjustmentAccountId'), claimRejectionAccountId: n('claimRejectionAccountId') })
                    .then(function (res) { b.disabled = false; told(res); });
            });
            // H51: the blood products, saved together after a confirmation
            var blood = document.querySelector('[data-save-blood]');
            if (blood) blood.addEventListener('click', function () {
                var b = this;
                cbConfirm(@Json.Serialize(T["Save what each blood product is charged as?"].Value)).then(function (ok) {
                    if (!ok) return; b.disabled = true;
                    var map = {}; document.querySelectorAll('[data-blood-product]').forEach(function (s) { map[s.getAttribute('data-blood-product')] = s.value === '' ? null : +s.value; });
                    post(@Json.Serialize(Url.Action("SaveBloodProductServices")), { map: map }).then(function (res) { b.disabled = false; told(res); });
                });
            });
            // a payer's override saves on its own, the moment it changes (select2 raises jQuery's change only)
            var payerUrl = @Json.Serialize(Url.Action("SavePayerReceivable", new { id = 0 }));
            function payerChanged(sel) {
                var prev = sel.getAttribute('data-was') || '';
                post(payerUrl.replace(/0$/, sel.getAttribute('data-payer-account')), { accountId: sel.value === '' ? null : +sel.value })
                    .then(function (res) { told(res); if (res.ok) sel.setAttribute('data-was', sel.value); else { sel.value = prev; if (window.jQuery) jQuery(sel).trigger('change.select2'); } });
            }
            document.querySelectorAll('[data-payer-account]').forEach(function (sel) {
                sel.setAttribute('data-was', sel.value);
                if (window.jQuery) jQuery(sel).on('change', function () { payerChanged(sel); }); else sel.addEventListener('change', function () { payerChanged(sel); });
            });
        })();
    </script>
}
