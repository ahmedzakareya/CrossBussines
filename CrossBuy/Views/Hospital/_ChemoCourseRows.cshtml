@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalChemoCourseRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{ var today = (DateTime)ViewBag.Today; }
@foreach (var r in Model)
{
    var c = r.Course;
    <tr>
        <td><a href="@Url.Action("ChemoCourse", new { id = c.ID })" class="fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(r.Name, r.NameEn)</a>
            <div class="text-muted fs-8"><span class="badge hp-code fs-9 hp-num me-1">@c.CourseNo</span><bdi class="hp-num">@r.Mrn</bdi></div></td>
        <td class="fs-8"><bdi>@r.Regimen</bdi><div class="text-muted">@T["cin:" + c.Intent]</div></td>
        <td class="fs-8"><bdi>@c.Diagnosis</bdi>@if (c.Stage != null) {<div class="text-muted"><bdi dir="ltr">@c.Stage</bdi></div>}</td>
        <td><span class="fw-bold hp-num">@r.Given / @r.MaxCycles</span>
            <div class="progress h-4px w-75px mt-1 bg-light"><div class="progress-bar bg-primary" style="width:@(r.MaxCycles == 0 ? 0 : r.Given * 100 / r.MaxCycles)%"></div></div></td>
        <td class="text-nowrap">@if (r.NextDue is DateTime d) {<span class="hp-num fw-semibold @(r.Overdue ? "text-danger" : d <= today.AddDays(2) ? "text-primary" : "")">@d.ToString("yyyy-MM-dd")</span>
                if (r.Overdue) {<div class="text-danger fs-9 fw-bold">@T["Overdue"]</div>} else if (r.Held) {<div class="text-muted fs-9">@T["Held"]</div>}} else {<span class="text-muted fs-8">@T["All cycles given"]</span>}</td>
        <td>@if (r.LastToxicity is int g) {<span class="badge @(g >= 3 ? "badge-light-danger" : g >= 1 ? "badge-light-primary" : "badge-light") fs-8">@T["Grade {0}", g]</span>} else {<span class="text-muted fs-8">—</span>}</td>
        <td class="text-end"><a href="@Url.Action("ChemoCourse", new { id = c.ID })" class="btn btn-sm btn-light-primary text-nowrap">@T["Open"]</a></td>
    </tr>
}
