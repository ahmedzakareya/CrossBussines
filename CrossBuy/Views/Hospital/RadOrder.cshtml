@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalRadOrderView
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    var o = Model.Order;
    var p = Model.Patient;
    var name = DisplayName.Of(p.Name, p.NameEn);
    ViewData["Title"] = DisplayName.Of(o.Name, o.NameEn) + " — " + o.AccessionNo;
    bool canRad = ViewBag.CanRad == true, canReport = ViewBag.CanReport == true;
    var previous = (ViewBag.Previous as List<HospitalRadOrder>) ?? new();
    // H31: the exam's pictures; attached by the radiographer or the radiologist until the report is signed
    var images = (ViewBag.Images as IReadOnlyList<HospitalRadImageRow>) ?? Array.Empty<HospitalRadImageRow>();
    bool canAttach = (canRad || canReport) && o.Status != HospitalRadStatus.Signed;
    bool signed = o.Status == HospitalRadStatus.Signed;
    bool writing = canReport && o.Status == HospitalRadStatus.Reporting;
    var age = HospitalPatientService.AgeOn(p.BirthDate, DateTime.UtcNow);
    string Who(int? id) => id != null && Model.People.TryGetValue(id.Value, out var n) ? n : "—";
    string Clock(DateTime? t) => t?.ToLocalTime().ToString("HH:mm") ?? "—";
    string CatClass(string? c) => c == HospitalRadImpression.Critical ? "badge-danger" : c == HospitalRadImpression.Abnormal ? "badge-light-danger" : "badge-light-success";
    var trail = new (string Label, DateTime? At, int? By, string Icon)[] {
        (T["Ordered"].Value, o.OrderedAt, o.OrderedByEmployeeId, "ki-document"),
        (T["Arrived at radiology"].Value, o.ArrivedAt, o.ArrivedByEmployeeId, "ki-entrance-left"),
        (T["Scan started"].Value, o.ScanStartedAt, o.ScannedByEmployeeId, "ki-scan-barcode"),
        (T["Scan ended"].Value, o.ScanEndedAt, o.ScannedByEmployeeId, "ki-check-square"),
        (T["Report written"].Value, o.ReportedAt, o.ReportedByEmployeeId, "ki-notepad-edit"),
        (T["Report signed"].Value, o.SignedAt, o.SignedByEmployeeId, "ki-shield-tick") };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@(signed ? T["Imaging report"] : o.Status == HospitalRadStatus.Reporting ? T["Reporting"] : T["Imaging order"])</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Radiology")" class="text-muted text-hover-primary">@T["Radiology"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted hp-num">@o.AccessionNo</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            @if (canRad && o.Status == HospitalRadStatus.Scheduled)
            {
                <select class="form-select form-select-sm form-select-solid w-175px" data-room data-control="select2" data-hide-search="true">
                    <option value="">@T["Room with the shortest queue"]</option>
                    @foreach (var m in Model.Rooms) { <option value="@m.ID" disabled="@m.InMaintenance">@m.Code · @DisplayName.Of(m.Name, m.NameEn)@(m.InMaintenance ? " — " + T["Maintenance"].Value : "")</option> }
                </select>
                <button type="button" class="btn btn-sm btn-primary" data-step="Arrive" data-confirm="@string.Format(T["Mark {0} arrived for {1}? A room of the exam's type is given."].Value, name, DisplayName.Of(o.Name, o.NameEn))"><i class="ki-outline ki-entrance-left fs-4"></i>@T["Arrived"]</button>
            }
            @if (canRad && o.Status == HospitalRadStatus.Arrived) { <button type="button" class="btn btn-sm btn-primary" data-step="Start" data-confirm="@(Model.ContrastAlert ? string.Format(T["{0} has a recorded contrast allergy. Start the scan anyway?"].Value, name) : string.Format(T["Start the scan of {0} in {1}?"].Value, name, Model.Room?.Code ?? "—"))" data-confirm-kind="@(Model.ContrastAlert ? "danger" : "primary")"><i class="ki-outline ki-scan-barcode fs-4"></i>@T["Start scan"]</button> }
            @if (canRad && o.Status == HospitalRadStatus.Scanning) { <button type="button" class="btn btn-sm btn-primary" data-step="End" data-confirm="@T["End the scan? The room is freed and the report can be written."]"><i class="ki-outline ki-check-square fs-4"></i>@T["End scan"]</button> }
            @if (writing)
            {
                <button type="button" class="btn btn-sm btn-light" data-save><i class="ki-outline ki-save-2 fs-4"></i>@T["Save"]</button>
                <button type="button" class="btn btn-sm btn-primary" data-sign><i class="ki-outline ki-check-circle fs-4"></i>@T["Sign report"]</button>
            }
            @if (signed) { <span class="badge badge-light-success fs-7 px-4 py-3"><i class="ki-outline ki-shield-tick fs-5 text-success me-1"></i>@T["Signed"] <span class="hp-num ms-1" data-fmt data-utc="@o.SignedAt?.ToString("o")">@o.SignedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></span> }
            <partial name="_HospitalPortalRelease" model="@((HospitalPortalResultSource.Radiology, o.ID, signed, ViewBag.PortalRelease as HospitalPortalRelease, (bool)(ViewBag.CanConsult == true)))" />
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @* H127: the patient — demo39 account/overview profile header (photo · name and file number · details with icons) *@
        <div class="card mb-5"><div class="card-body pt-7 pb-4">
            <div class="d-flex flex-wrap flex-sm-nowrap align-items-center">
                <div class="me-6 mb-3"><div class="symbol symbol-75px symbol-circle flex-shrink-0">@if (p.PhotoPath != null) {<img src="@p.PhotoPath" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label fs-2 fw-bold bg-light-primary text-primary hp-initials">@HospitalUi.Initials(p.NameEn)</span>}</div></div>
                <div class="flex-grow-1 min-w-0 mb-3">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2"><a href="@Url.Action("Patient", new { id = p.ID })" class="text-gray-900 text-hover-primary fs-2 fw-bold me-1">@name</a><span class="badge badge-light-primary fw-bold fs-7 hp-num" dir="ltr">@p.Mrn</span>
                        @if (Model.ContrastAlert) {<span class="badge badge-light-danger fw-bold fs-7"><i class="ki-outline ki-shield-cross fs-7 text-danger me-1"></i>@T["Contrast allergy"]</span>}</div>
                    <div class="d-flex flex-wrap fw-semibold fs-6">
                        <span class="d-flex align-items-center text-gray-500 me-5 mb-1"><i class="ki-outline ki-profile-circle fs-4 me-1"></i>@if (age != null) {<span class="hp-num">@age</span><text>&nbsp;@T["y"]&nbsp;·&nbsp;</text>}@(p.Sex == HospitalPatientSex.Male ? T["Male"] : T["Female"])</span>
                        @if (o.OrderedByEmployeeId != null) { <span class="d-flex align-items-center text-gray-500 me-5 mb-1"><i class="ki-outline ki-briefcase fs-4 me-1"></i>@Who(o.OrderedByEmployeeId)</span> }
                        @if (Model.Room != null) { <span class="d-flex align-items-center text-gray-500 me-5 mb-1"><i class="ki-outline ki-geolocation fs-4 me-1"></i><bdi class="hp-num text-gray-800 fw-bold" dir="ltr">@Model.Room.Code</bdi>&nbsp;·&nbsp;@DisplayName.Of(Model.Room.Name, Model.Room.NameEn)</span> }
                    </div>
                </div>
            </div>
        </div></div>

        @if (Model.ContrastAlert)
        {
            <div class="notice d-flex rounded border border-dashed border-danger bg-light-danger p-6 mb-5">
                <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Contrast allergy"]</h4>
                    <div class="fs-6 text-gray-700">@T["This exam uses contrast and the patient's file records an allergy to it:"] @p.Allergies</div></div>
            </div>
        }
        @if (o.IsCritical)
        {
            <div class="notice d-flex rounded border border-dashed p-6 mb-5 @(o.CriticalAcknowledgedAt == null ? "bg-light-danger border-danger" : "bg-light-success border-success")">
                <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label @(o.CriticalAcknowledgedAt == null ? "bg-danger" : "bg-success")"><i class="ki-outline @(o.CriticalAcknowledgedAt == null ? "ki-notification-status" : "ki-check-circle") fs-2x text-white"></i></span></span>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                    <div class="mb-3 mb-md-0 fw-semibold pe-5">
                        <h4 class="text-gray-900 fw-bold mb-1">@(o.CriticalAcknowledgedAt == null ? T["A critical result — tell the doctor now"] : T["The doctor was told of the critical result"])</h4>
                        <div class="fs-6 text-gray-700">@o.Impression</div>
                    </div>
                    <a href="@Url.Action("RadCritical", new { id = o.ID })" class="btn btn-sm @(o.CriticalAcknowledgedAt == null ? "btn-danger" : "btn-light") flex-shrink-0">@(o.CriticalAcknowledgedAt == null ? T["Notify the doctor"] : T["Following it up"])</a>
                </div>
            </div>
        }

        <div class="row g-5 g-xl-8">
            <div class="col-xl-8">
                @* H127: the report — demo39 card header over the report's fields *@
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800">@DisplayName.Of(o.Name, o.NameEn) <bdi class="badge badge-light-primary fw-bold fs-7 hp-num ms-1" dir="ltr">@o.AccessionNo</bdi></span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["mod:" + o.Modality]@if (o.Contrast) {<text> · @T["with contrast"]</text>}@if (Model.Room != null) {<text> · <bdi class="hp-num" dir="ltr">@Model.Room.Code</bdi></text>}</span>
                        </h3>
                        <div class="card-toolbar"><span class="badge badge-light-@(signed ? "success" : "primary") fs-7 fw-bold">@T["rad:" + o.Status]</span></div>
                    </div>
                    <div class="card-body pt-2">
                        @if (o.Status is HospitalRadStatus.Scheduled or HospitalRadStatus.Arrived or HospitalRadStatus.Scanning)
                        {
                            <div class="text-center py-10"><i class="ki-outline ki-scan-barcode fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["The report is written once the scan has ended."]</div></div>
                        }
                        else if (writing)
                        {
                            <div class="row g-5 mb-5">
                                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Impression category"]</label>
                                    <select class="form-select form-select-solid" data-k="category" data-control="select2" data-hide-search="true">
                                        <option value="">—</option>
                                        @foreach (var c in HospitalRadImpression.All) { <option value="@c" selected="@(o.ImpressionCategory == c)">@T["imp:" + c]</option> }
                                    </select></div>
                                <div class="col-md-6 d-flex align-items-end"><button type="button" class="btn btn-light-primary w-100" disabled title="@T["Not connected yet"]"><i class="ki-outline ki-picture fs-4"></i>@T["Open images in PACS"] <span class="text-muted fs-8 ms-1">— @T["Not connected yet"]</span></button></div>
                            </div>
                            @* H33: the patient reads the report in their language — both are written; English is optional *@
                            <div class="row g-4">
                                <div class="col-xl-6"><label class="fs-6 fw-semibold mb-2">@T["Findings"] — @T["Arabic"]</label>
                                    <textarea class="form-control form-control-solid" rows="8" maxlength="4000" dir="auto" data-k="findings">@o.Findings</textarea></div>
                                <div class="col-xl-6"><label class="fs-6 fw-semibold mb-2">@T["Findings"] — @T["English"]</label>
                                    <textarea class="form-control form-control-solid" rows="8" maxlength="4000" dir="auto" data-k="findingsEn">@o.FindingsEn</textarea></div>
                                <div class="col-xl-6"><label class="fs-6 fw-semibold mb-2">@T["Impression"] — @T["Arabic"]</label>
                                    <textarea class="form-control form-control-solid" rows="3" maxlength="1000" dir="auto" data-k="impression">@o.Impression</textarea></div>
                                <div class="col-xl-6"><label class="fs-6 fw-semibold mb-2">@T["Impression"] — @T["English"]</label>
                                    <textarea class="form-control form-control-solid" rows="3" maxlength="1000" dir="auto" data-k="impressionEn">@o.ImpressionEn</textarea></div>
                            </div>
                        }
                        else
                        {
                            @if (o.ImpressionCategory != null) { <span class="badge @CatClass(o.ImpressionCategory) fs-7 fw-bold mb-5">@T["imp:" + o.ImpressionCategory]</span> }
                            <div class="text-gray-500 fs-7 fw-bold mb-2">@T["Findings"]</div>
                            <div class="text-gray-800 fs-6 mb-5" style="white-space:pre-line" dir="auto">@(o.Findings == null && o.FindingsEn == null ? "—" : DisplayName.Of(o.Findings ?? "", o.FindingsEn ?? ""))</div>
                            <div class="separator separator-dashed my-5"></div>
                            <div class="text-gray-500 fs-7 fw-bold mb-2">@T["Impression"]</div>
                            <div class="text-gray-900 fs-5 fw-bold" style="white-space:pre-line" dir="auto">@(o.Impression == null && o.ImpressionEn == null ? "—" : DisplayName.Of(o.Impression ?? "", o.ImpressionEn ?? ""))</div>
                            @if (signed) { <div class="d-flex align-items-center text-gray-500 fw-semibold fs-7 mt-5"><i class="ki-outline ki-shield-tick fs-4 text-success me-2"></i>@T["Signed by"]&nbsp;<span class="text-gray-800">@Who(o.SignedByEmployeeId)</span></div> }
                            @* H34: English added after signing — the signed Arabic is not changed; who added it and when is shown *@
                            @if (signed && o.TranslatedAt != null) { <div class="text-muted fs-8 mt-1"><i class="ki-outline ki-message-text fs-7 me-1"></i>@T["Translation added by"] @Who(o.TranslatedByEmployeeId) · <span class="hp-num" data-fmt data-utc="@o.TranslatedAt?.ToString("o")">@o.TranslatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div> }
                            @if (signed && canReport)
                            {
                                <button type="button" class="btn btn-sm btn-light-primary mt-4" data-translate data-fen="@o.FindingsEn" data-ien="@o.ImpressionEn">
                                    <i class="ki-outline ki-message-text fs-4"></i>@(o.FindingsEn == null && o.ImpressionEn == null ? T["Add translation"] : T["Edit translation"])</button>
                            }
                        }
                    </div>
                </div>
                @* H31: the pictures — on this page, in the dentist's chart, and to the patient once released *@
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800">@T["Images"] <span class="badge badge-light-primary fs-7 fw-bold hp-num ms-1">@images.Count</span></span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@(signed ? T["Locked with the signed report"] : T["JPEG, PNG or WebP, up to 15 MB each; the patient sees them once the report is released"])</span>
                        </h3>
                        @if (canAttach)
                        {
                            <div class="card-toolbar"><label class="btn btn-sm btn-light-primary mb-0"><i class="ki-outline ki-picture fs-4"></i>@T["Attach images"]
                                <input type="file" accept="image/jpeg,image/png,image/webp" multiple class="d-none" data-rad-upload="@o.ID" /></label></div>
                        }
                    </div>
                    <div class="card-body pt-2">
                        @if (images.Count == 0) { <div class="text-center py-10"><i class="ki-outline ki-picture fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No images attached yet"]</div></div> }
                        else
                        {
                            <div class="row g-4">
                                @foreach (var im in images)
                                {
                                    var src = Url.Action("RadImage", new { id = im.Id });
                                    <div class="col-6 col-md-4 col-xxl-3"><div class="position-relative">
                                        <a href="@src" target="_blank" rel="noopener" class="d-block rounded overflow-hidden bg-dark" style="height:150px"><img src="@src" alt="" style="width:100%;height:100%;object-fit:cover" loading="lazy" /></a>
                                        @if (canAttach) { <button type="button" class="btn btn-icon btn-sm btn-light-danger position-absolute top-0 end-0 m-2 w-25px h-25px" data-rad-image-remove="@im.Id" title="@T["Remove"]"><i class="ki-outline ki-trash fs-6"></i></button> }
                                        <div class="text-gray-800 fw-bold fs-7 mt-2 text-truncate"><bdi>@(im.Caption ?? im.FileName)</bdi></div>
                                        <div class="text-muted fw-semibold fs-8 hp-num" dir="ltr" data-fmt data-utc="@im.UploadedAt.ToString("o")">@im.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                    </div></div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="notice d-flex rounded border border-dashed border-primary bg-light-primary p-6 mb-5">
                    <i class="ki-outline ki-shield-tick fs-2tx text-primary me-4"></i>
                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Two-step verification"]</h4>
                        <div class="fs-6 text-gray-700">@T["The radiographer performs the scan and the radiologist writes and signs the report; only a signed report reaches the doctor and the patient file."]</div></div>
                </div>
                @* H127: the exam trail — demo39 dashboards/logistics list widget *@
                <div class="card card-flush mb-5">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Exam trail"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["rad:" + o.Status]</span></h3></div>
                    <div class="card-body pt-2">
                        @for (int i = 0; i < trail.Length; i++)
                        {
                            var s = trail[i];
                            <div class="d-flex flex-stack">
                                <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label @(s.At != null ? "bg-light-primary" : "bg-light")"><i class="ki-outline @s.Icon fs-3 @(s.At != null ? "text-primary" : "text-gray-400")"></i></span></div>
                                <div class="d-flex flex-stack flex-row-fluid gap-2">
                                    <div class="me-3"><span class="fw-bold fs-6 @(s.At != null ? "text-gray-800" : "text-gray-400")">@s.Label</span>@if (s.At != null) {<span class="text-gray-500 fw-semibold fs-7 d-block">@Who(s.By)</span>}</div>
                                    <span class="hp-num fw-bold fs-6 @(s.At != null ? "text-gray-800" : "text-gray-400")" dir="ltr" data-fmt data-utc="@s.At?.ToString("o")">@Clock(s.At)</span>
                                </div>
                            </div>
                            if (i < trail.Length - 1) { <div class="separator separator-dashed my-3"></div> }
                        }
                    </div>
                </div>
                @if (canRad && !signed)
                {
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Priority"]</span></h3></div>
                        <div class="card-body pt-2 d-flex gap-2">
                            @foreach (var pr in HospitalLabPriority.All)
                            {
                                <button type="button" class="btn btn-sm flex-grow-1 @(o.Priority == pr ? (pr == HospitalLabPriority.Stat ? "btn-danger" : "btn-primary") : "btn-light")" data-priority="@pr" data-confirm="@string.Format(T["Change the priority of {0} to {1}?"].Value, o.AccessionNo, pr == HospitalLabPriority.Stat ? "STAT" : T[pr].Value)">@(pr == HospitalLabPriority.Stat ? "STAT" : T[pr].Value)</button>
                            }
                        </div>
                    </div>
                }
                @if (previous.Count > 0)
                {
                    @* H127: earlier reports — demo39 dashboards/logistics list widget *@
                    <div class="card card-flush">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Earlier reports"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7 hp-num">@previous.Count</span></h3></div>
                        <div class="card-body pt-2">
                            @for (int i = 0; i < previous.Count; i++)
                            {
                                var r = previous[i];
                                <a href="@Url.Action("RadOrder", new { id = r.ID })" class="d-flex align-items-center text-hover-primary">
                                    <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-document fs-3 text-primary"></i></span></div>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex flex-stack gap-2"><span class="text-gray-800 fw-bold fs-6 text-truncate">@DisplayName.Of(r.Name, r.NameEn)</span><span class="hp-num text-gray-500 fw-semibold fs-7 text-nowrap" dir="ltr" data-fmt data-utc="@r.SignedAt?.ToString("o")">@r.SignedAt?.ToLocalTime().ToString("yyyy-MM-dd")</span></div>
                                        <div class="text-gray-500 fw-semibold fs-7 text-truncate" dir="auto">@r.Impression</div>
                                    </div>
                                </a>
                                if (i < previous.Count - 1) { <div class="separator separator-dashed my-3"></div> }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div></div>
</div>

@if (signed && canReport)
{
    @* H34: the English of a signed report — two English texts only; the signed Arabic is shown for reference, read-only *@
    @* H127: demo39 utilities/modals/forms/new-target — borderless header, centred title over a muted line, labelled fields, centred footer *@
    <div class="modal fade" id="hp_translate" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-750px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
            <div class="mb-10 text-center"><h1 class="mb-3">@T["Add translation"]</h1>
                <div class="text-muted fw-semibold fs-5">@T["The report stays as it was signed. Only its English is added, with your name and the time."]</div></div>
            <div class="row g-5">
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Findings"] — @T["Arabic"]</label>
                    <div class="form-control form-control-solid bg-light h-auto min-h-150px" style="white-space:pre-line" dir="auto">@o.Findings</div></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Findings"] — @T["English"]</label>
                    <textarea class="form-control form-control-solid" rows="7" maxlength="4000" dir="ltr" data-tr="findingsEn"></textarea></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Impression"] — @T["Arabic"]</label>
                    <div class="form-control form-control-solid bg-light h-auto" style="white-space:pre-line" dir="auto">@o.Impression</div></div>
                <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Impression"] — @T["English"]</label>
                    <textarea class="form-control form-control-solid" rows="3" maxlength="1000" dir="ltr" data-tr="impressionEn"></textarea></div>
            </div>
            <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button>
                <button type="button" class="btn btn-primary" data-translate-save><i class="ki-outline ki-check fs-4"></i>@T["Save translation"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var base = @Json.Serialize(Url.Action("RadOrder", new { id = o.ID }));
            var critUrl = @Json.Serialize(Url.Action("RadCritical", new { id = o.ID }));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), signed: @Json.Serialize(T["Report signed — the doctor can see it"].Value),
                      sign: @Json.Serialize(T["Sign this report? Once signed it reaches the doctor and the patient file and can no longer be changed."].Value),
                      signCritical: @Json.Serialize(T["Sign this report as CRITICAL? You will then choose the doctor to tell."].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(step, body) {
                return fetch(base + '/' + step, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content and actions swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    ['kt_app_content', 'kt_app_toolbar'].forEach(function (id) { var f = doc.getElementById(id); if (f) document.getElementById(id).innerHTML = f.innerHTML; });
                    if (window.KTApp && KTApp.createSelect2) KTApp.createSelect2();
                });
            }
            // H31: attach pictures (multipart) and take one off; both swap the page in place
            document.addEventListener('change', function (e) {
                var t = e.target.closest('[data-rad-upload]'); if (!t || !t.files.length) return;
                var fd = new FormData(); for (var i = 0; i < t.files.length; i++) fd.append('files', t.files[i]);
                fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                cbConfirm(@Json.Serialize(T["Attach these images to the exam?"].Value)).then(function (ok) {
                    if (!ok) { t.value = ''; return; }
                    fetch(@Json.Serialize(Url.Content("~/Hospital/Radiology/")) + t.getAttribute('data-rad-upload') + '/Images', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: fd })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }).then(done(null));
                });
            });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-rad-image-remove]'); if (!t) return;
                cbConfirm(@Json.Serialize(T["Remove this image from the exam?"].Value), { kind: 'danger' }).then(function (ok) {
                    if (!ok) return; t.disabled = true;
                    fetch(@Json.Serialize(Url.Content("~/Hospital/Radiology/Images/")) + t.getAttribute('data-rad-image-remove') + '/Remove', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token } })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }).then(done(t));
                });
            });
            // H34: English for the signed report, in place
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-translate],[data-translate-save]'); if (!t) return;
                var m = document.getElementById('hp_translate'); if (!m) return;
                if (t.hasAttribute('data-translate')) {
                    m.querySelector('[data-tr=findingsEn]').value = t.getAttribute('data-fen') || '';
                    m.querySelector('[data-tr=impressionEn]').value = t.getAttribute('data-ien') || '';
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                t.disabled = true;
                post('Translate', { findingsEn: m.querySelector('[data-tr=findingsEn]').value || null, impressionEn: m.querySelector('[data-tr=impressionEn]').value || null })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } bootstrap.Modal.getOrCreateInstance(m).hide(); toast('success', W.saved); swap(); });
            });
            function done(btn, msg) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', msg || W.saved); swap(); }; }
            function report() {
                var o = {}; document.querySelectorAll('[data-k]').forEach(function (i) { o[i.getAttribute('data-k')] = i.value || null; }); return o;
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-step],[data-save],[data-sign],[data-priority]'); if (!t) return;
                var msg = t.getAttribute('data-confirm');
                if (msg && !t.hasAttribute('data-confirmed')) { cbConfirm(msg, { kind: t.getAttribute('data-confirm-kind') || 'primary' }).then(function (ok) { if (ok) { t.setAttribute('data-confirmed', ''); t.click(); } }); return; }
                t.removeAttribute('data-confirmed');
                if (t.hasAttribute('data-sign')) {
                    var r = report(), critical = r.category === 'Critical';
                    cbConfirm(critical ? W.signCritical : W.sign, { kind: critical ? 'danger' : 'primary' }).then(function (ok) {
                        if (!ok) return;
                        t.disabled = true;
                        post('Sign', r).then(function (res) {
                            t.disabled = false;
                            if (!res.ok) { toast('error', res.error || W.failed); return; }
                            toast('success', W.signed);
                            if (critical) location.href = critUrl; else swap();
                        });
                    });
                    return;
                }
                t.disabled = true;
                if (t.hasAttribute('data-save')) { post('Report', report()).then(done(t)); return; }
                if (t.hasAttribute('data-priority')) { post('Priority', { priority: t.getAttribute('data-priority') }).then(done(t)); return; }
                var step = t.getAttribute('data-step'), room = document.querySelector('[data-room]');
                post(step, step === 'Arrive' ? { roomId: room && room.value ? +room.value : null } : null).then(done(t));
            });
        })();
    </script>
}
