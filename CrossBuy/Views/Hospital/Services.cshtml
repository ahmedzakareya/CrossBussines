@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalService>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — the service catalogue: a notice, category pills over the theme's table widget (demo39 widgets/tables,
    apps/ecommerce/catalog), and its form modal (utilities/modals/forms/new-target).
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Service catalogue"].Value;
    bool canManage = ViewBag.CanManage == true;
    string? category = ViewBag.Category as string;
    var all = (ViewBag.All as IReadOnlyList<HospitalService>) ?? Array.Empty<HospitalService>();
    var departments = (ViewBag.Departments as IReadOnlyList<HospitalDepartment>) ?? Array.Empty<HospitalDepartment>();
    var accounts = (ViewBag.Accounts as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    var currency = ViewBag.Currency as HospitalCurrency;
    string M(decimal v) => currency == null ? v.ToString("N2") : currency.Format(v);
    string cur = currency?.Label(DisplayName.IsArabic) ?? "";
    var deptName = departments.ToDictionary(d => d.ID, d => DisplayName.Of(d.Name, d.NameEn));
    var accName = accounts.ToDictionary(a => a.Id, a => a.Label + " · " + DisplayName.Of(a.Name, a.NameEn));
    var rows = Model.Select(s => new { id = s.ID, code = s.Code, name = s.Name, nameEn = s.NameEn, category = s.Category, departmentId = s.DepartmentId, price = s.Price, taxable = s.Taxable, revenueAccountId = s.RevenueAccountId, isActive = s.IsActive });
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Service catalogue"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Finance"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Service catalogue"]</li>
            </ul>
        </div>
        @if (canManage)
        {
            <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
                @if (all.Count == 0) { <button type="button" class="btn btn-sm btn-light-primary" data-seed><i class="ki-outline ki-arrow-down fs-4"></i>@T["Load the standard services"]</button> }
                <button type="button" class="btn btn-sm btn-primary" data-new><i class="ki-outline ki-plus fs-4"></i>@T["New service"]</button>
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
            <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
            <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-3">
                <div class="fw-semibold">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["One price list for the whole hospital"]</h4>
                    <div class="fs-6 text-gray-700">@T["Every charge on a bill comes from here: the consultation a doctor is billed as, what the doctor orders, and what the desk adds. A bill keeps the price it was charged at."]</div>
                </div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0"><span class="hp-num">@all.Count</span>&nbsp;@T["services"]</span>
            </div>
        </div>

        <script type="application/json" id="serviceRows">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(rows))</script>
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Service catalogue"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} of {1}", Model.Count, all.Count]</span></h3>
            </div>
            <div class="card-body pt-2">
                <div class="d-flex flex-wrap gap-2 mb-6">
                    <a href="@Url.Action("Services")" class="btn btn-sm @(category == null ? "btn-primary" : "btn-light btn-active-light-primary")">@T["All"] <span class="badge badge-circle @(category == null ? "badge-light" : "badge-light-primary") hp-num ms-1">@all.Count</span></a>
                    @foreach (var c in HospitalServiceCategories.All.Where(c => c != HospitalServiceCategories.Accommodation))
                    {
                        <a href="@Url.Action("Services", new { category = c })" class="btn btn-sm @(category == c ? "btn-primary" : "btn-light btn-active-light-primary")">@T["cat:" + c] <span class="badge badge-circle @(category == c ? "badge-light" : "badge-light-primary") hp-num ms-1">@all.Count(s => s.Category == c)</span></a>
                    }
                </div>
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-price-tag fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No services yet."]</div></div>
                }
                else
                {
                    @* table widget — demo39 widgets/tables *@
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 rounded-start">@T["Service"]</th><th>@T["Department"]</th><th class="text-end">@T["Price"]</th><th>@T["Tax"]</th><th>@T["Revenue account"]</th><th class="text-end pe-4 rounded-end"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr class="@(s.IsActive ? "" : "opacity-50")">
                                    <td class="ps-4"><div class="d-flex align-items-center">
                                        <div class="symbol symbol-45px me-4 flex-shrink-0"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-price-tag fs-2 text-primary"></i></span></div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(s.Name, s.NameEn)</span>
                                            <span class="text-muted fw-semibold d-block fs-7"><bdi class="hp-num">@s.Code</bdi> · @T["cat:" + s.Category]@if (!s.IsActive) {<span class="badge badge-light fs-8 ms-2">@T["Inactive"]</span>}</span></div>
                                    </div></td>
                                    <td><span class="text-gray-700 fw-semibold fs-7">@(s.DepartmentId is int d && deptName.TryGetValue(d, out var dn) ? dn : "—")</span></td>
                                    <td class="text-end text-nowrap"><span class="text-gray-900 fw-bold fs-6 hp-num" dir="ltr">@M(s.Price)</span>&nbsp;<span class="text-muted fs-8 fw-semibold">@cur</span></td>
                                    <td>@if (s.Taxable) {<span class="badge badge-light-primary fs-7 fw-bold">@T["Taxable"]</span>} else {<span class="badge badge-light fs-7 fw-bold">@T["Exempt"]</span>}</td>
                                    <td><bdi class="text-gray-500 fw-semibold fs-7">@(s.RevenueAccountId is int a && accName.TryGetValue(a, out var an) ? an : T["Default"].Value)</bdi></td>
                                    <td class="text-end pe-4">@if (canManage) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" data-edit="@s.ID" title="@T["Edit"]" data-bs-toggle="tooltip"><i class="ki-outline ki-pencil fs-3"></i></button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    </div></div>
</div>

@if (canManage)
{
    @* form modal — demo39 utilities/modals/forms/new-target *@
    <div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end">
            <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div>
        </div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
            <div class="mb-10 text-center">
                <h1 class="mb-3" data-title></h1>
                <div class="text-muted fw-semibold fs-5">@T["One price list for the whole hospital"]</div>
            </div>
            <form id="serviceForm"><input type="hidden" name="id" /><div class="row g-6 mb-8">
                <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Code"]</label><input name="code" maxlength="40" class="form-control form-control-solid hp-num" dir="ltr" /></div>
                <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Category"]</label>
                    <select name="category" class="form-select form-select-solid">@foreach (var c in HospitalServiceCategories.All.Where(c => c != HospitalServiceCategories.Accommodation)) { <option value="@c">@T["cat:" + c]</option> }</select></div>
                <div class="col-md-4 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Price"]</label>
                    <div class="input-group input-group-solid"><input name="price" type="number" min="0" step="0.001" class="form-control form-control-solid hp-num" dir="ltr" /><span class="input-group-text">@cur</span></div></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Name (Arabic)"]</label><input name="name" maxlength="200" class="form-control form-control-solid" dir="rtl" /></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2 required">@T["Name (English)"]</label><input name="nameEn" maxlength="200" class="form-control form-control-solid" dir="ltr" /></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Department"]</label>
                    <select name="departmentId" class="form-select form-select-solid"><option value="">—</option>@foreach (var d in departments) { <option value="@d.ID">@DisplayName.Of(d.Name, d.NameEn)</option> }</select></div>
                <div class="col-md-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Revenue account"]</label>
                    <select name="revenueAccountId" class="form-select form-select-solid"><option value="">@T["Default (billing settings)"]</option>@foreach (var a in accounts) { <option value="@a.Id">@a.Label · @DisplayName.Of(a.Name, a.NameEn)</option> }</select></div>
                <div class="col-md-6"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" name="taxable" /><span class="form-check-label fw-semibold text-gray-700">@T["Taxable"]</span></label></div>
                <div class="col-md-6"><label class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" name="isActive" checked /><span class="form-check-label fw-semibold text-gray-700">@T["Active"]</span></label></div>
            </div></form>
            <div class="text-center pt-5">
                <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button>
                <button type="button" class="btn btn-primary" data-save>@T["Save"]</button>
            </div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var rows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rows));
            // The edit form reads its rows from the page, so a swapped page brings fresh rows with it.
            function reloadRows() { var el = document.getElementById('serviceRows'); if (el) rows = JSON.parse(el.textContent); }
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, $ = window.jQuery;
            var W = { newT: @Json.Serialize(T["New service"].Value), editT: @Json.Serialize(T["Edit service"].Value), failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) };
            var urls = { save: @Json.Serialize(Url.Action("SaveService")), seed: @Json.Serialize(Url.Action("SeedDefaultServices")) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            // In place, never a reload: the server renders the page again and its content is swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (fresh) document.getElementById('kt_app_content').innerHTML = fresh.innerHTML;
                    var tb = new DOMParser().parseFromString(html, 'text/html').querySelector('.app-toolbar .d-print-none');
                    var cur = document.querySelector('.app-toolbar .d-print-none'); if (tb && cur) cur.innerHTML = tb.innerHTML;
                });
            }
            var modal = document.getElementById('serviceModal'), form = document.getElementById('serviceForm');
            function setSel(n, v) { form.elements[n].value = v == null ? '' : String(v); if ($) $(form.elements[n]).trigger('change'); }
            function open(r) {
                modal.querySelector('[data-title]').textContent = r ? W.editT : W.newT;
                form.elements.id.value = r ? r.id : ''; form.elements.code.value = r ? r.code : ''; form.elements.name.value = r ? r.name : ''; form.elements.nameEn.value = r ? r.nameEn : '';
                form.elements.price.value = r ? r.price : ''; form.elements.taxable.checked = r ? r.taxable : false; form.elements.isActive.checked = r ? r.isActive : true;
                setSel('category', r ? r.category : 'Lab'); setSel('departmentId', r ? r.departmentId : null); setSel('revenueAccountId', r ? r.revenueAccountId : null);
                bootstrap.Modal.getOrCreateInstance(modal).show();
            }
            document.addEventListener('click', function (e) {
                var t;
                if ((t = e.target.closest('[data-new]'))) open(null);
                else if ((t = e.target.closest('[data-edit]'))) open(rows.filter(function (r) { return r.id === +t.getAttribute('data-edit'); })[0]);
                else if ((t = e.target.closest('[data-save]'))) {
                    var f = form.elements;
                    var body = { id: f.id.value ? +f.id.value : null, code: f.code.value, name: f.name.value, nameEn: f.nameEn.value, category: f.category.value, price: +f.price.value || 0,
                        departmentId: f.departmentId.value ? +f.departmentId.value : null, revenueAccountId: f.revenueAccountId.value ? +f.revenueAccountId.value : null, taxable: f.taxable.checked, isActive: f.isActive.checked };
                    t.disabled = true;
                    fetch(urls.save, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { t.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } bootstrap.Modal.getInstance(modal).hide(); toast('success', W.saved); swap().then(reloadRows); });
                } else if ((t = e.target.closest('[data-seed]'))) {
                    t.disabled = true;
                    var fd = new FormData(); fd.append('__RequestVerificationToken', token);
                    fetch(urls.seed, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); })
                        .then(function (res) { if (!res.ok) { t.disabled = false; toast('error', res.error || W.failed); return; } toast('success', W.saved); swap().then(reloadRows); });
                }
            });
        })();
    </script>
}
