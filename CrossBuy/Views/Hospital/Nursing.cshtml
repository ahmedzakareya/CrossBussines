                    dEl.querySelectorAll('[data-prio]').forEach(function (b) { b.classList.toggle('btn-primary', b.getAttribute('data-prio') === 'Routine'); b.classList.toggle('btn-light', b.getAttribute('data-prio') !== 'Routine'); });
