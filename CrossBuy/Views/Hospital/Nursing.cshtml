@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalNursingBoard?
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Nursing station"].Value;
    var wards = (ViewBag.Wards as IReadOnlyList<HospitalWardOption>) ?? Array.Empty<HospitalWardOption>();
    var staff = (ViewBag.Staff as IReadOnlyList<(int Id, string Name, string? Photo, string? NameEn)>) ?? Array.Empty<(int, string, string?, string?)>();
    bool canAdmit = ViewBag.CanAdmit == true, canConsult = ViewBag.CanConsult == true;
    var b = Model;
    string Person(int? id) => id is int i && b != null && b.People.TryGetValue(i, out var n) ? n : "—";
    string Dot(HospitalMarDose d) => d.State switch
    {
        HospitalMarStatus.Given => "<span class=\"mar-dot mar-given\">✓</span>",
        HospitalMarStatus.Held => "<span class=\"mar-dot mar-held\">—</span>",
        HospitalMarStatus.Missed => "<span class=\"mar-dot mar-missed\">!</span>",
        HospitalNursingRules.Overdue => "<span class=\"mar-dot mar-overdue\">!</span>",
        HospitalNursingRules.Due => "<span class=\"mar-dot mar-due\">•</span>",
        _ => "<span class=\"mar-dot mar-upcoming\">·</span>",
    };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@* MAR marks. No amber/yellow (house rule): due is the brand blue, overdue and missed red, held grey. *@
<style>
    .mar-dot { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; font-weight: 700; font-size: .85rem; }
    .mar-given { background: #DCF7E6; color: #0E7A39; } .mar-due { box-shadow: inset 0 0 0 2px var(--cb-brand, #3A5795); color: var(--cb-brand, #3A5795); }
    .mar-overdue { box-shadow: inset 0 0 0 2px #DC2626; color: #DC2626; } .mar-missed { background: #DC2626; color: #fff; }
    .mar-held { background: #EEF0F4; color: #4B5468; } .mar-upcoming { background: #F4F6FA; color: #A1A5B7; }
    button.mar-hit { border: 0; background: none; padding: 0; }
    .mar-cell { width: 64px; text-align: center; }
</style>
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Nursing station"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Inpatient"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Nursing"]</li>
            </ul>
        </div>
        <form method="get" id="wardForm" class="d-print-none" style="width:260px">
            <select name="ward" class="form-select form-select-sm form-select-solid" data-control="select2" data-hide-search="true">
                @foreach (var w in wards) { <option value="@w.Id" selected="@(b?.Ward.Id == w.Id)">@w.Code · @DisplayName.Of(w.Name, w.NameEn ?? w.Name)</option> }
            </select>
        </form>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (b == null)
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-home-2 fs-3x text-gray-300 d-block mb-4"></i>@T["No wards yet: add them in the facility."]</div></div>
        }
        else
        {
            @* H126: the shift's figures — demo39 dashboards/logistics card widget (number over its label, the symbol in the toolbar) *@
            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] {
                    (T["Doses due now"].Value, b.DueNow, string.Format(T["within {0} minutes of their hour"].Value, HospitalNursingRules.WindowMinutes), "ki-capsule", "primary"),
                    (T["Overdue doses"].Value, b.Overdue, T["need recording or a documented reason"].Value, "ki-time", b.Overdue > 0 ? "danger" : "primary"),
                    (T["Nursing tasks due"].Value, b.TasksDue, T["within the next hour"].Value, "ki-notepad-edit", "info"),
                    (T["Patients on the ward"].Value, b.Patients.Count, System.Text.RegularExpressions.Regex.Replace(T["shift:" + b.Shift].Value, @"\s*\([^)]*\)", ""), "ki-profile-user", "primary") })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column">
                                <span class="fs-2hx fw-bold me-2 lh-1 ls-n2 hp-num @(s.Item5 == "danger" ? "text-danger" : "text-gray-900")">@s.Item2</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                            </div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item5"><i class="ki-outline @s.Item4 fs-2x text-@s.Item5"></i></span></div></div>
                        </div>
                        <div class="card-body d-flex align-items-end pt-0">
                            <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500"><div class="bullet w-8px h-6px rounded-2 bg-@s.Item5 me-3"></div>@s.Item3</div>
                        </div>
                    </div></div>
                }
            </div>

            <div class="card card-flush mb-5" data-obs-panel="@b.Ward.Id"><div class="card-body d-flex align-items-center justify-content-center gap-3 text-gray-500 fs-7 py-10"><span class="spinner-border spinner-border-sm text-primary"></span>@T["Loading…"]</div></div>

            @* the medication administration record — demo39 widgets/tables (light rounded header, roomy rows, symbols, badges) *@
            <div class="card card-flush mb-5">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@string.Format(T["Medication administration record — {0}"].Value, DisplayName.Of(b.Ward.Name, b.Ward.NameEn ?? b.Ward.Name))</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Click a due dose to record what happened to it"]</span>
                    </h3>
                    <div class="card-toolbar d-flex flex-wrap gap-4 fs-7 fw-semibold text-gray-600">
                        <span class="d-inline-flex align-items-center gap-2"><span class="mar-dot mar-given" style="width:20px;height:20px">✓</span>@T["mar:Given"]</span>
                        <span class="d-inline-flex align-items-center gap-2"><span class="mar-dot mar-due" style="width:20px;height:20px">•</span>@T["Due"]</span>
                        <span class="d-inline-flex align-items-center gap-2"><span class="mar-dot mar-overdue" style="width:20px;height:20px">!</span>@T["Overdue"]</span>
                        <span class="d-inline-flex align-items-center gap-2"><span class="mar-dot mar-missed" style="width:20px;height:20px">!</span>@T["mar:Missed"]</span>
                        <span class="d-inline-flex align-items-center gap-2"><span class="mar-dot mar-held" style="width:20px;height:20px">—</span>@T["mar:Held"]</span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    @if (b.Patients.Count == 0)
                    {
                        <div class="text-center py-10"><i class="ki-outline ki-home-2 fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["Nobody is accommodated on this ward."]</div></div>
                    }
                    else
                    {
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light">
                                <th class="ps-4 min-w-225px rounded-start">@T["Patient"]</th><th class="min-w-225px">@T["Medication"]</th>
                                @foreach (var h in b.Hours) { <th class="mar-cell"><span class="hp-num">@h.ToString("00"):00</span></th> }
                                <th class="text-end pe-4 rounded-end">@T["Actions"]</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var p in b.Patients)
                                {
                                    var live = p.Lines.Where(l => l.Order.Status != HospitalMedOrderStatus.Stopped).ToList();
                                    var gone = p.Lines.Where(l => l.Order.Status == HospitalMedOrderStatus.Stopped).ToList();
                                    var rows = live.Count == 0 ? 1 : live.Count;
                                    for (int i = 0; i < rows; i++)
                                    {
                                        var line = live.Count == 0 ? null : live[i];
                                        <tr class="@(i == rows - 1 ? "border-bottom border-gray-200" : "")">
                                            @if (i == 0)
                                            {
                                                var who = DisplayName.Of(p.Name, p.NameEn);
                                                <td rowspan="@rows" class="align-top ps-4">
                                                    <div class="d-flex align-items-center">
                                                        <div class="symbol symbol-45px symbol-circle me-3 flex-shrink-0">@if (p.Photo != null) {<img src="@p.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(p.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold fs-7 hp-initials">@HospitalUi.Initials(p.NameEn)</span>}</div>
                                                        <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = p.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6">@who</a>
                                                            <span class="text-gray-500 fw-semibold fs-7 text-nowrap">@T["Bed"] <bdi class="hp-num text-gray-800 fw-bold" dir="ltr">@p.Bed</bdi> · <bdi class="hp-num" dir="ltr">@p.Mrn</bdi></span></div>
                                                    </div>
                                                    @if (p.Allergies != null) {<div class="mt-3"><span class="badge badge-light-danger fs-8 fw-bold text-wrap text-start"><i class="ki-outline ki-information-5 fs-7 text-danger me-1"></i><bdi>@HospitalAllergyText.Display(p.Allergies)</bdi></span></div>}
                                                    @{ var ic = (ViewBag.Ic as IReadOnlyDictionary<int, HospitalIcBadge>) is { } icAll && icAll.TryGetValue(p.AdmissionId, out var icOne) ? icOne : null; }
                                                    @if (ic != null) {<div class="d-flex flex-wrap gap-1 mt-2">
                                                        @foreach (var iso in ic.Isolations) {<span class="badge badge-light-danger fs-8 fw-bold" title="@iso.Reason"><i class="ki-outline ki-shield-cross fs-8 text-danger me-1"></i>@T["prec:" + iso.Precaution]@if (iso.Organism != null) {<text> · <bdi dir="ltr">@iso.Organism</bdi></text>}</span>}
                                                        @foreach (var dv in ic.Devices) {if (canAdmit || canConsult) {<button type="button" class="badge @(dv.Day >= 7 ? "badge-light-danger" : "badge-light-primary") fs-8 fw-bold border-0" data-ic-remove="@dv.Id" data-what="@who — @T["dev:" + dv.Kind]" title="@T["Record its removal"]">@T["dev:" + dv.Kind] · @T["Day {0}", dv.Day] <i class="ki-outline ki-cross fs-8 ms-1"></i></button>} else {<span class="badge @(dv.Day >= 7 ? "badge-light-danger" : "badge-light-primary") fs-8 fw-bold">@T["dev:" + dv.Kind] · @T["Day {0}", dv.Day]</span>}}
                                                    </div>}
                                                    @{ var cr = (ViewBag.Cr as IReadOnlyDictionary<int, IReadOnlyList<HospitalConsultBadge>>) is { } crAll && crAll.TryGetValue(p.AdmissionId, out var crOne) ? crOne : null; }
                                                    @if (cr != null) {<div class="d-flex flex-wrap gap-1 mt-2">@foreach (var c in cr) {<a href="@Url.Action("Consults", new { scope = "all" })" class="badge @(c.Overdue ? "badge-light-danger" : c.Status == HospitalConsultRequestStatus.Answered ? "badge-light-primary" : "badge-light-info") fs-8 fw-bold" title="@c.RequestNo"><i class="ki-outline ki-messages fs-8 me-1 @(c.Overdue ? "text-danger" : c.Status == HospitalConsultRequestStatus.Answered ? "text-primary" : "text-info")"></i>@DisplayName.Of(c.Department, c.DepartmentEn) · @(c.Overdue ? T["Overdue"].Value : T["crs:" + c.Status].Value)</a>}</div>}
                                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                                        @if ((ViewBag.Fb as IReadOnlyDictionary<int, HospitalFluidBadge>) is { } fbAll && fbAll.TryGetValue(p.AdmissionId, out var fb)) {<button type="button" class="badge badge-light fs-8 fw-bold border-0" data-fluid="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-drop fs-8 text-primary me-1"></i>@T["Fluid balance"] <bdi dir="ltr" class="hp-num ms-1 @(fb.Balance < 0 ? "text-danger" : "text-primary")">@((fb.Balance > 0 ? "+" : fb.Balance < 0 ? "−" : "") + Math.Abs(fb.Balance).ToString("#,0", System.Globalization.CultureInfo.InvariantCulture))&nbsp;ml</bdi></button>}
                                                        @if ((ViewBag.Cp as IReadOnlyDictionary<int, HospitalCareBadge>) is { } cpAll && cpAll.TryGetValue(p.AdmissionId, out var cpb)) {<button type="button" class="badge @(cpb.ReviewDue > 0 || cpb.Suggested > 0 ? "badge-light-danger" : "badge-light-primary") fs-8 fw-bold border-0" data-careplan="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-notepad-edit fs-8 me-1"></i>@T["Care plan"] · <span class="hp-num">@cpb.ActivePlans</span>@if (cpb.ReviewDue > 0) {<text> · @T["Review due"]</text>}@if (cpb.Suggested > 0) {<text> · @T["Plan suggested"]</text>}</button>}
                                                    </div>
                                                    @* H270: the patient's actions, NAMED - the medication order as the one primary button, the rest in a
                                                       menu of words (the owner: a row of seven bare icons was unreadable) *@
                                                    @if (canConsult || canAdmit)
                                                    {
                                                        <div class="d-flex flex-wrap gap-2 mt-3">
                                                            @if (canConsult) {<button type="button" class="btn btn-sm btn-primary" data-new-order="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-capsule fs-4"></i>@T["Medication order"]</button>}
                                                            <div class="dropdown">
                                                                <button type="button" class="btn btn-sm btn-light-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">@T["More"]</button>
                                                                <ul class="dropdown-menu dropdown-menu-end py-2 min-w-200px">
                                                                    @if (canConsult)
                                                                    {
                                                                        <li><button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 fs-7 fw-semibold" data-set-order="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-questionnaire-tablet fs-4 text-primary"></i>@T["Order set"]</button></li>
                                                                        <li><button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 fs-7 fw-semibold" data-diag-order="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-flask fs-4 text-primary"></i>@T["Tests & imaging"]</button></li>
                                                                        <li><button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 fs-7 fw-semibold" data-cr-new="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-messages fs-4 text-primary"></i>@T["Ask a specialty"]</button></li>
                                                                        <li><hr class="dropdown-divider" /></li>
                                                                    }
                                                                    <li><button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 fs-7 fw-semibold" data-fluid="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-drop fs-4 text-primary"></i>@T["Fluids"]</button></li>
                                                                    <li><button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 fs-7 fw-semibold" data-careplan="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-notepad-edit fs-4 text-primary"></i>@T["Problems & care plan"]</button></li>
                                                                    <li><button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 fs-7 fw-semibold text-danger" data-ic="@p.AdmissionId" data-who="@who"><i class="ki-outline ki-shield-cross fs-4 text-danger"></i>@T["Infection control"]</button></li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    }
                                                    @* H270: stopped orders leave the grid; they are one line away, not four rows of grey *@
                                                    @if (gone.Count > 0)
                                                    {
                                                        <div class="mt-3"><a href="#stopped-@p.AdmissionId" class="fs-7 fw-semibold text-gray-600 text-hover-primary" data-bs-toggle="collapse" role="button"><i class="ki-outline ki-down fs-7 me-1"></i>@T["Stopped orders ({0})", gone.Count]</a>
                                                            <div class="collapse" id="stopped-@p.AdmissionId"><div class="d-flex flex-column gap-1 mt-2">@foreach (var g in gone) {<span class="fs-8 text-gray-500 d-block text-truncate mw-225px" title="@g.Order.Drug · @g.Order.Dose"><bdi>@g.Order.Drug</bdi> · <bdi class="hp-num">@g.Order.Dose</bdi></span>}</div></div></div>
                                                    }
                                                </td>
                                            }
                                            @if (line == null)
                                            {
                                                <td colspan="@(b.Hours.Count + 2)"><span class="text-gray-500 fw-semibold fs-7"><i class="ki-outline ki-capsule fs-5 text-gray-400 me-1"></i>@T["No medication orders."]</span></td>
                                            }
                                            else
                                            {
                                                var o = line.Order; bool stopped = o.Status == HospitalMedOrderStatus.Stopped;
                                                <td class="@(stopped ? "opacity-50" : "")">
                                                    <div class="d-flex align-items-center">
                                                        <div class="symbol symbol-35px me-3 flex-shrink-0"><span class="symbol-label @(o.Controlled ? "bg-light-danger" : "bg-light-primary")"><i class="ki-outline ki-capsule fs-3 @(o.Controlled ? "text-danger" : "text-primary")"></i></span></div>
                                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi>@o.Drug</bdi></span>
                                                            <span class="text-gray-500 fw-semibold fs-7"><bdi class="hp-num">@o.Dose</bdi> · @T["route:" + o.Route] · @if (o.AsNeeded) {@T["As needed"]} else {<bdi class="hp-num" dir="ltr">@o.Hours</bdi>}</span>
                                                            @if (o.Controlled || stopped || o.ItemId == null) {<div class="d-flex flex-wrap gap-1 mt-1">@if (o.Controlled) {<span class="badge badge-light-danger fs-8 fw-bold">@T["Controlled — two signatures"]</span>}@if (o.ItemId == null) {<span class="badge badge-light-info fs-8 fw-bold" title="@o.Note">@T["Outside the pharmacy's list"]</span>}@if (stopped) {<span class="badge badge-light fs-8 fw-bold">@T["Stopped"]</span>}</div>}
                                                            @{ string? nextDose = null;
                                                               if (!o.AsNeeded && !stopped)
                                                               {
                                                                   var up = line.Doses.FirstOrDefault(x => x.Entry == null && x.State == HospitalNursingRules.Upcoming);
                                                                   var hrs = HospitalNursingRules.ParseHours(o.Hours);
                                                                   if (up != null) nextDose = string.Format(T["Next dose today at {0}"].Value, up.Hour.ToString("00") + ":00");
                                                                   else if (hrs is { Count: > 0 } && !line.Doses.Any(x => x.Entry == null)) nextDose = string.Format(T["Next dose tomorrow at {0}"].Value, hrs.Min().ToString("00") + ":00");
                                                               } }
                                                            @if (nextDose != null) {<span class="fs-8 fw-semibold text-primary mt-1"><i class="ki-outline ki-time fs-8 text-primary me-1"></i>@nextDose</span>}
                                                        </div>
                                                    </div>
                                                </td>
                                                @foreach (var h in b.Hours)
                                                {
                                                    var d = line.Doses.FirstOrDefault(x => x.Hour == h);
                                                    <td class="mar-cell">
                                                        @if (d != null)
                                                        {
                                                            var whoD = DisplayName.Of(p.Name, p.NameEn);
                                                            if (d.Entry == null && canAdmit && d.State != HospitalNursingRules.Upcoming)
                                                            {
                                                                <button type="button" class="mar-hit" data-dose="@o.ID" data-due="@d.DueAt.ToString("o")" data-who="@whoD" data-mrn="@p.Mrn" data-photo="@p.Photo" data-drug="@o.Drug" data-dosetxt="@o.Dose · @T["route:" + o.Route]" data-when="@h.ToString("00"):00" data-allergy="@(p.Allergies == null ? "" : HospitalAllergyText.Display(p.Allergies))" data-controlled="@(o.Controlled ? "1" : "0")" data-what="@whoD — @o.Drug @o.Dose (@h.ToString("00"):00)">@Html.Raw(Dot(d))</button>
                                                            }
                                                            else
                                                            {
                                                                <span title="@(d.Entry == null ? "" : T["mar:" + d.Entry.Status].Value + " · " + Person(d.Entry.RecordedByEmployeeId) + (d.Entry.WitnessEmployeeId != null ? " + " + Person(d.Entry.WitnessEmployeeId) : "") + (d.Entry.Reason != null ? " · " + d.Entry.Reason : ""))">@Html.Raw(Dot(d))</span>
                                                            }
                                                        }
                                                    </td>
                                                }
                                                <td class="text-end pe-4"><div class="d-flex flex-column align-items-end gap-2">
                                                    @if (!o.AsNeeded && !stopped && canAdmit)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                                            @if (line.AsNeededGiven.Any()) {<span class="badge badge-light-primary fs-8 fw-bold hp-num" dir="ltr">@line.AsNeededGiven.Count(x => x.Status == HospitalMarStatus.Given)×</span>}
                                                            <button type="button" class="btn btn-sm btn-light-primary py-1 px-3 fs-7 text-nowrap" data-dose="@o.ID" data-due="" data-extra="1" data-who="@DisplayName.Of(p.Name, p.NameEn)" data-mrn="@p.Mrn" data-photo="@p.Photo" data-drug="@o.Drug" data-dosetxt="@o.Dose · @T["route:" + o.Route]" data-when="@T["Outside its hours"]" data-allergy="@(p.Allergies == null ? "" : HospitalAllergyText.Display(p.Allergies))" data-controlled="@(o.Controlled ? "1" : "0")" data-what="@DisplayName.Of(p.Name, p.NameEn) — @o.Drug @o.Dose"><i class="ki-outline ki-time fs-5"></i>@T["Dose now"]</button>
                                                        </div>
                                                    }
                                                    @if (o.AsNeeded)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                                            <span class="badge badge-light-primary fs-8 fw-bold hp-num" dir="ltr">@line.AsNeededGiven.Count(x => x.Status == HospitalMarStatus.Given)×</span>
                                                            @if (canAdmit && !stopped) {<button type="button" class="btn btn-sm btn-light-primary py-1 px-3 fs-7" data-dose="@o.ID" data-due="" data-who="@DisplayName.Of(p.Name, p.NameEn)" data-mrn="@p.Mrn" data-photo="@p.Photo" data-drug="@o.Drug" data-dosetxt="@o.Dose · @T["route:" + o.Route]" data-when="@T["As needed"]" data-allergy="@(p.Allergies == null ? "" : HospitalAllergyText.Display(p.Allergies))" data-controlled="@(o.Controlled ? "1" : "0")" data-what="@DisplayName.Of(p.Name, p.NameEn) — @o.Drug @o.Dose">@T["Give"]</button>}
                                                        </div>
                                                    }
                                                    @if (canConsult && !stopped) {<button type="button" class="btn btn-sm btn-light-danger py-1 px-3 fs-7 text-nowrap" data-stop-order="@o.ID" data-what="@o.Drug @o.Dose"><i class="ki-outline ki-cross-circle fs-5"></i>@T["Stop"]</button>}
                                                </div></td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>

            <div class="row g-5 g-xl-8">
                @* nursing tasks — demo39 widgets/lists: a symbol, the task over a muted line, its hour as a badge *@
                <div class="col-xl-6"><div class="card card-flush h-100">
                    @{ var tasks = b.Patients.SelectMany(p => p.Tasks.Select(t => (p, t))).OrderBy(x => x.t.DoneAt != null).ThenBy(x => x.t.DueAt).ToList(); }
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800">@T["Nursing tasks"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} of {1}", tasks.Count(x => x.t.DoneAt != null), tasks.Count] · @T["Done"]</span>
                        </h3>
                    </div>
                    <div class="card-body pt-2">
                        @if (tasks.Count == 0)
                        {
                            <div class="text-center py-8"><i class="ki-outline ki-notepad-edit fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-semibold text-gray-600">@T["No nursing tasks."]</div></div>
                        }
                        @for (int k = 0; k < tasks.Count; k++)
                        {
                            var (p, t) = tasks[k];
                            bool late = t.DoneAt == null && t.DueAt < DateTime.UtcNow, urgent = t.Title.StartsWith("NEWS2|");
                            string tone = t.DoneAt != null ? "primary" : urgent || late ? "danger" : "primary";
                            <div class="d-flex flex-stack">
                                <div class="form-check form-check-custom form-check-solid me-4"><input type="checkbox" class="form-check-input" @(t.DoneAt != null ? "checked disabled" : "") @(canAdmit && t.DoneAt == null ? "" : "disabled") data-task-done="@t.ID" data-what="@HospitalNews2Text.TaskText(t.Title, k2 => T[k2].Value)" /></div>
                                <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                    <div class="me-3"><span class="fw-bold fs-6 @(t.DoneAt != null ? "text-gray-500 text-decoration-line-through" : urgent ? "text-danger" : "text-gray-800")">@HospitalNews2Text.TaskText(t.Title, k2 => T[k2].Value)</span>
                                        <span class="text-gray-500 fw-semibold fs-7 d-block">@T["Bed"] <bdi class="hp-num">@p.Bed</bdi> · @DisplayName.Of(p.Name, p.NameEn)@if (t.DoneAt != null) {<text> · @Person(t.DoneByEmployeeId)</text>}</span></div>
                                    <span class="badge badge-light-@tone fs-7 fw-bold hp-num" data-fmt data-utc="@t.DueAt.ToString("o")">@t.DueAt.ToString("HH:mm")</span>
                                </div>
                            </div>
                            if (k < tasks.Count - 1) { <div class="separator separator-dashed my-3"></div> }
                        }
                        @if (canAdmit && b.Patients.Count > 0)
                        {
                            <div class="separator separator-dashed my-5"></div>
                            <div class="row g-3 align-items-end" data-task-form>
                                <div class="col-md-4"><label class="form-label fs-7 fw-semibold text-gray-600 mb-1">@T["Patient"]</label>
                                    <select class="form-select form-select-sm form-select-solid" data-k="admissionId" data-nurse-select>@foreach (var p in b.Patients) { <option value="@p.AdmissionId">@p.Bed · @DisplayName.Of(p.Name, p.NameEn)</option> }</select></div>
                                <div class="col-md-5"><label class="form-label fs-7 fw-semibold text-gray-600 mb-1">@T["Nursing tasks"]</label>
                                    <input class="form-control form-control-sm form-control-solid" maxlength="200" data-k="title" placeholder="@T["e.g. dressing change"]" /></div>
                                <div class="col-md-2"><label class="form-label fs-7 fw-semibold text-gray-600 mb-1">@T["Time"]</label>
                                    <input type="text" class="form-control form-control-sm form-control-solid hp-num" dir="ltr" data-k="time" data-nurse-time value="@NowWard()" /></div>
                                <div class="col-md-1"><button type="button" class="btn btn-sm btn-icon btn-primary" data-task-add title="@T["Add"]"><i class="ki-outline ki-plus fs-3"></i></button></div>
                            </div>
                        }
                    </div>
                </div></div>
                @* shift handover — the card header carries who wrote it and when *@
                <div class="col-xl-6"><div class="card card-flush h-100">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800">@T["Shift handover"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["shift:" + b.Shift] · <bdi class="hp-num">@b.ShiftDate.ToString("yyyy-MM-dd")</bdi>@if (b.Handover != null) {<text> · @Person(b.Handover.UpdatedByEmployeeId) <span class="hp-num" data-fmt data-utc="@b.Handover.UpdatedAt.ToString("o")">@b.Handover.UpdatedAt.ToString("HH:mm")</span></text>}</span>
                        </h3>
                        @if (canAdmit) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-primary" data-handover-save><i class="ki-outline ki-check fs-4"></i>@T["Save handover"]</button></div>}
                    </div>
                    <div class="card-body pt-2">
                        <textarea class="form-control form-control-solid" rows="9" maxlength="2000" dir="auto" data-handover @(canAdmit ? "" : "readonly")>@b.Handover?.Note</textarea>
                    </div>
                </div></div>
            </div>
        }
    </div></div>
</div>
@functions { private static string NowWard() => DateTime.Now.AddHours(1).ToString("HH:00"); }

<div class="modal fade" id="doseModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
    @* H271: the dose window, designed (the owner: it was left out of the redesign) - who and what at the top with the
       allergy, the answer as three clear choices, the bedside scan as two numbered steps that say what they read *@
    <div class="modal-header py-5"><h2 class="fw-bold m-0 fs-3"><i class="ki-outline ki-capsule fs-2 text-primary me-2"></i>@T["Record a dose"]</h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10">
        <span class="d-none" data-d-what></span>
        <div class="d-flex align-items-center gap-4 p-4 rounded bg-light-primary mb-4">
            <div class="symbol symbol-50px symbol-circle flex-shrink-0" data-d-photo></div>
            <div class="flex-grow-1 min-w-0">
                <div class="fw-bold fs-5 text-gray-900" data-d-who></div>
                <div class="text-gray-600 fs-7 hp-num" dir="ltr" style="text-align:start" data-d-mrn></div>
            </div>
            <div class="text-end min-w-0">
                <div class="fw-bold fs-6 text-gray-900" data-d-drug dir="auto"></div>
                <div class="text-gray-600 fs-7"><span data-d-dosetxt></span> · <span class="fw-semibold text-primary" data-d-when></span></div>
            </div>
        </div>
        <div class="d-none align-items-center gap-2 p-3 rounded bg-light-danger text-danger fw-semibold fs-7 mb-5" data-d-allergy-wrap><i class="ki-outline ki-information-5 fs-4 text-danger"></i><span>@T["Allergy"]:</span><bdi data-d-allergy></bdi></div>

        <label class="form-label fw-bold">@T["What happened to the dose"]</label>
        <div class="row g-3 mb-6">
            @foreach (var s in HospitalMarStatus.All)
            {
                var icon = s == HospitalMarStatus.Given ? "check-circle" : s == HospitalMarStatus.Held ? "time" : "cross-circle";
                <div class="col-4"><input type="radio" class="btn-check" name="d-status" id="d-st-@s" value="@s" @(s == HospitalMarStatus.Given ? "checked" : "") />
                    <label class="btn btn-outline btn-outline-dashed btn-active-light-primary w-100 d-flex flex-column align-items-center gap-1 py-3" for="d-st-@s"><i class="ki-outline ki-@icon fs-2x"></i><span class="fw-bold fs-7">@T["mar:" + s]</span></label></div>
            }
        </div>

        @* H205: the bedside scan - the wristband, then the pack; a scanner types the code and presses Enter *@
        <div class="border border-dashed border-gray-300 rounded p-5 mb-5" data-d-scan-wrap>
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="fw-bold fs-6 text-gray-900"><i class="ki-outline ki-scan-barcode fs-3 text-primary me-2"></i>@T["Bedside scan"]</div>
                <button type="button" class="btn btn-sm btn-light-danger" data-d-noscan><i class="ki-outline ki-information-5 fs-5"></i>@T["The scan cannot be made"]</button>
            </div>
            <div class="row g-4">
                <div class="col-md-6"><label class="form-label fw-semibold"><span class="badge badge-circle badge-primary me-2">1</span>@T["Wristband"]</label>
                    <div class="input-group input-group-solid"><span class="input-group-text"><i class="ki-outline ki-user-square fs-3"></i></span><input class="form-control form-control-solid hp-num" dir="ltr" autocomplete="off" maxlength="60" data-d-wrist placeholder="@T["Scan the wristband"]" /></div>
                    <div class="fs-7 fw-semibold mt-2 d-none" data-d-wrist-note></div></div>
                <div class="col-md-6"><label class="form-label fw-semibold"><span class="badge badge-circle badge-primary me-2">2</span>@T["Medicine pack"]</label>
                    <div class="input-group input-group-solid"><span class="input-group-text"><i class="ki-outline ki-capsule fs-3"></i></span><input class="form-control form-control-solid hp-num" dir="ltr" autocomplete="off" maxlength="200" data-d-pack placeholder="@T["Scan the pack"]" /></div>
                    <div class="fs-7 fw-semibold mt-2 d-none" data-d-pack-note></div></div>
            </div>
            <div class="mt-4 d-none" data-d-override-wrap><label class="form-label required">@T["Why the scan cannot be made"]</label><input class="form-control form-control-solid" maxlength="300" data-d-override placeholder="@T["e.g. the wristband is torn — a new one is being printed"]" />
                <div class="form-text text-danger">@T["A dose given without the scan counts against the ward's scanning."]</div></div>
        </div>
        <div class="mb-4 d-none" data-d-reason-wrap><label class="form-label required" data-d-reason-label>@T["Reason"]</label><input class="form-control form-control-solid" maxlength="300" data-d-reason placeholder="@T["e.g. BP 85/50, doctor informed"]" /></div>
        <div class="mb-2 d-none" data-d-witness-wrap><label class="form-label required">@T["Witness"]</label><select class="form-select form-select-solid" data-d-witness data-person-select data-allow-clear data-placeholder="@T["Witness"]"><option value=""></option>@foreach (var s in staff) { <option value="@s.Id" data-photo="@s.Photo" data-initials="@HospitalUi.Initials(s.NameEn)">@s.Name</option> }</select>
            <div class="form-text">@T["A controlled drug is given with a second signature."]</div></div>
    </div>
    <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-d-save><i class="ki-outline ki-check fs-4"></i>@T["Record the dose"]</button></div>
</div></div></div>

@if (canConsult)
{
    <div class="modal fade" id="orderModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
        <div class="modal-header"><h2 class="fw-bold m-0">@T["Medication order"] <span class="text-muted fs-6" data-o-who></span></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body py-6 px-lg-10" data-o-form>
            <div class="row g-4">
                @* H270: picked from the pharmacy's medicines (the item links the pack scan at the bedside); a drug the pharmacy
                   does not stock can still be typed — it is then given with the reason the pack could not be scanned *@
                <div class="col-12"><label class="form-label required">@T["Drug"]</label>
                    <select class="form-select form-select-solid" data-o-drug data-placeholder="@T["Drug name and strength"]"><option value=""></option>
                        @foreach (var f in ((IReadOnlyList<(int Id, string Code, string Name, string NameEn, decimal? Price)>?)ViewBag.Formulary ?? Array.Empty<(int, string, string, string, decimal?)>()))
                        { var shown = CrossBuy.BL.DisplayName.Of(f.Name, f.NameEn); var other = shown == f.Name ? f.NameEn : f.Name;
                          <option value="i:@f.Id" data-alt="@(other == shown ? "" : other)" data-code="@f.Code">@shown · @f.Code</option> }
                    </select>
                    <input type="hidden" data-k="drug" /><input type="hidden" data-k="itemId" /></div>
                <div class="col-12"><div class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-o-outside /><label class="form-check-label fw-semibold">@T["A drug outside the pharmacy's list (the patient's own medicine)"]</label></div></div>
                <div class="col-12 d-none" data-o-outside-wrap><div class="row g-4">
                    <div class="col-md-6"><label class="form-label required">@T["Drug name and strength"]</label><input class="form-control form-control-solid" maxlength="200" data-o-outside-name /></div>
                    <div class="col-md-6"><label class="form-label required">@T["Why it is outside the list"]</label><input class="form-control form-control-solid" maxlength="250" data-o-outside-reason placeholder="@T["e.g. the patient's own inhaler, brought from home"]" /></div>
                </div></div>
                <div class="col-md-4"><label class="form-label required">@T["Dose"]</label><input class="form-control form-control-solid hp-num" maxlength="60" data-k="dose" placeholder="1 g" /></div>
                <div class="col-md-4"><label class="form-label required">@T["Route"]</label><select class="form-select form-select-solid" data-k="route">@foreach (var r in HospitalMedRoute.All) { <option value="@r">@T["route:" + r]</option> }</select></div>
                <div class="col-md-4"><label class="form-label">@T["Hours"] <span class="text-muted fs-8">06,14,22</span></label><input class="form-control form-control-solid hp-num" dir="ltr" maxlength="60" data-k="hours" placeholder="06,14,22" /></div>
                <div class="col-md-6"><div class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-k="asNeeded" /><label class="form-check-label">@T["As needed (PRN)"]</label></div></div>
                <div class="col-md-6"><div class="form-check form-switch form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-k="controlled" /><label class="form-check-label">@T["Controlled drug"]</label></div></div>
                <div class="col-12"><label class="form-label">@T["Note"]</label><input class="form-control form-control-solid" maxlength="300" data-k="note" /></div>
            </div>
        </div>
        <div class="modal-footer flex-center"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-o-save>@T["Write the order"]</button></div>
    </div></div></div>
}

@{
    var morseItems = new[] {
        ("History of falling (last 3 months)", new[] { ("No", 0), ("Yes", 25) }),
        ("Secondary diagnosis", new[] { ("No", 0), ("Yes", 15) }),
        ("Ambulatory aid", new[] { ("None, bed rest or nurse assists", 0), ("Crutches, cane or walker", 15), ("Holds on to furniture", 30) }),
        ("IV line or heparin lock", new[] { ("No", 0), ("Yes", 20) }),
        ("Gait", new[] { ("Normal, bed rest or wheelchair", 0), ("Weak", 10), ("Impaired", 20) }),
        ("Mental status", new[] { ("Knows own ability", 0), ("Overestimates or forgets limitations", 15) }) };
    var bradenItems = new[] {
        ("Sensory perception", new[] { ("Completely limited", 1), ("Very limited", 2), ("Slightly limited", 3), ("No impairment", 4) }),
        ("Moisture", new[] { ("Constantly moist", 1), ("Very moist", 2), ("Occasionally moist", 3), ("Rarely moist", 4) }),
        ("Activity", new[] { ("Bedfast", 1), ("Chairfast", 2), ("Walks occasionally", 3), ("Walks frequently", 4) }),
        ("Mobility", new[] { ("Completely immobile", 1), ("Very limited", 2), ("Slightly limited", 3), ("No limitation", 4) }),
        ("Nutrition", new[] { ("Very poor", 1), ("Probably inadequate", 2), ("Adequate", 3), ("Excellent", 4) }),
        ("Friction and shear", new[] { ("Problem", 1), ("Potential problem", 2), ("No apparent problem", 3) }) };
}
<div class="modal fade" id="diagModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-800px"><div class="modal-content">
    <div class="modal-header"><h2 class="fw-bold m-0">@T["Tests & imaging"] — <span data-diag-who></span></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10">
        <input class="form-control form-control-solid mb-4" data-diag-find placeholder="@T["Find a test or exam…"]" />
        <div class="row g-5">
            <div class="col-md-6"><div class="fw-bold text-gray-800 fs-6 mb-2"><i class="ki-outline ki-flask text-primary fs-4 me-1"></i>@T["Lab tests"]</div><div class="mh-250px overflow-auto pe-2" data-diag-list="Lab"></div></div>
            <div class="col-md-6"><div class="fw-bold text-gray-800 fs-6 mb-2"><i class="ki-outline ki-scan-barcode text-info fs-4 me-1"></i>@T["Imaging"]</div><div class="mh-250px overflow-auto pe-2" data-diag-list="Rad"></div></div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-5">
            <div class="btn-group" data-diag-prio>
                @foreach (var pr in new[] { "Routine", "Urgent", "Stat" }) { <button type="button" class="btn btn-sm @(pr == "Routine" ? "btn-primary" : "btn-light")" data-prio="@pr">@T["prio:" + pr]</button> }
            </div>
            <input class="form-control form-control-solid flex-grow-1 w-auto" maxlength="300" dir="auto" data-diag-note placeholder="@T["Note for the lab or radiology"]" />
        </div>
        <div class="text-muted fs-8 mt-2">@T["Each test and exam is charged to the stay's bill and goes to the lab's or radiology's own worklist."]</div>
        <div class="separator separator-dashed my-5"></div>
        <div class="fw-bold text-gray-800 fs-6 mb-2">@T["This stay's tests and imaging"]</div>
        <div data-diag-orders></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Close"]</button><button type="button" class="btn btn-primary" data-diag-place>@T["Order the ticked"]</button></div>
</div></div></div>
<div class="modal fade" id="setModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-650px"><div class="modal-content">
    <div class="modal-header"><h2 class="fw-bold m-0">@T["Order set"] — <span data-set-who></span></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10">
        <select class="form-select form-select-solid mb-5" data-set-pick><option value="">@T["Choose the order set"]</option></select>
        <div data-set-lines></div>
        <div class="text-muted fs-8 mt-4">@T["Untick what does not fit this patient. Every medicine goes through the drug-safety check; the tasks go on the ward board."]</div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-set-place>@T["Place the chosen lines"]</button></div>
</div></div></div>
<div class="modal fade" id="obsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
    <div class="modal-header"><h2 class="fw-bold m-0">@T["Record observations"] — <span data-obs-who></span></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10"><div class="row g-4">
        <div class="col-4"><label class="form-label fs-7">@T["Respiration /min"]</label><input type="number" class="form-control form-control-solid hp-num" data-ob="respRate" min="0" max="80" /></div>
        <div class="col-4"><label class="form-label fs-7">SpO₂ %</label><input type="number" class="form-control form-control-solid hp-num" data-ob="spO2" min="50" max="100" /></div>
        <div class="col-4 d-flex flex-column justify-content-end gap-2">
            <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-ob="onOxygen" /><span class="form-check-label fs-7">@T["On oxygen"]</span></label>
            <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" data-ob="spO2Scale2" /><span class="form-check-label fs-8">@T["SpO₂ scale 2 (target 88–92%)"]</span></label></div>
        <div class="col-4"><label class="form-label fs-7">@T["Systolic BP"]</label><input type="number" class="form-control form-control-solid hp-num" data-ob="systolicBp" min="40" max="300" /></div>
        <div class="col-4"><label class="form-label fs-7">@T["Diastolic BP"]</label><input type="number" class="form-control form-control-solid hp-num" data-ob="diastolicBp" min="20" max="200" /></div>
        <div class="col-4"><label class="form-label fs-7">@T["Pulse /min"]</label><input type="number" class="form-control form-control-solid hp-num" data-ob="heartRate" min="20" max="250" /></div>
        <div class="col-4"><label class="form-label fs-7">@T["Temperature °C"]</label><input type="number" step="0.1" class="form-control form-control-solid hp-num" data-ob="tempC" min="30" max="45" /></div>
        <div class="col-4"><label class="form-label fs-7">@T["Pain (0–10)"]</label><select class="form-select form-select-solid" data-ob="painScore"><option value="">—</option>@for (int i = 0; i <= 10; i++) { <option value="@i">@i</option> }</select></div>
        <div class="col-12"><label class="form-label fs-7">@T["Consciousness (ACVPU)"]</label><div class="btn-group w-100" data-ob-acvpu>
            @foreach (var c in HospitalConsciousness.All) { <button type="button" class="btn btn-sm btn-light" data-acvpu="@c" title="@T["acvpu:" + c]">@c · @T["acvpu:" + c]</button> }
        </div></div>
        <div class="col-12"><label class="form-label fs-7">@T["Note"]</label><input class="form-control form-control-solid" maxlength="300" dir="auto" data-ob="note" /></div>
        <div class="col-12 text-muted fs-8">@T["NEWS2 is worked out when all seven readings are entered; a score that needs a response opens an urgent task for the ward."]</div>
    </div></div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-obs-save>@T["Save"]</button></div>
</div></div></div>
<div class="modal fade" id="riskModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-700px"><div class="modal-content">
    <div class="modal-header"><h2 class="fw-bold m-0"><span data-risk-title></span> — <span data-risk-who></span></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10">
        @foreach (var (kind, items) in new[] { ("Morse", morseItems), ("Braden", bradenItems) })
        {
            <div data-risk-kind="@kind" class="d-none">
                @for (int k = 0; k < items.Length; k++)
                {
                    <div class="mb-5"><div class="fw-bold text-gray-800 fs-7 mb-2">@T["rk:" + items[k].Item1]</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var (label, v) in items[k].Item2) { <label class="btn btn-sm btn-light btn-active-light-primary border border-gray-300 text-start" data-ri="@k"><input type="radio" class="d-none" name="ri-@kind-@k" value="@v" /><span class="fs-8">@T["rk:" + label]</span> <span class="badge badge-light hp-num ms-1">@v</span></label> }
                        </div></div>
                }
            </div>
        }
        <div class="d-flex align-items-center gap-3 border-top pt-4"><span class="text-muted fs-7">@T["Total"]</span><span class="fs-2 fw-bold hp-num" data-risk-total>—</span></div>
        <input class="form-control form-control-solid mt-4" maxlength="300" dir="auto" data-risk-note placeholder="@T["Note"]" />
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-risk-save>@T["Save"]</button></div>
</div></div></div>
<div class="modal fade" id="careModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-800px"><div class="modal-content">
    <div class="modal-header"><div><h2 class="fw-bold m-0">@T["Problems & care plan"]</h2><div class="text-muted fs-7 mt-1" data-care-who></div></div><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10"><div data-care-body><div class="text-muted fs-7 py-8 text-center">@T["Loading…"]</div></div></div>
</div></div></div>
<div class="modal fade" id="fluidModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-750px"><div class="modal-content">
    <div class="modal-header"><div><h2 class="fw-bold m-0">@T["Fluid chart"]</h2><div class="text-muted fs-7 mt-1" data-fluid-who></div></div><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10">
        @if (canAdmit || canConsult) {<div class="row g-3 align-items-end mb-6 pb-6 border-bottom border-dashed" data-fluid-form>
            <div class="col-md-4"><label class="form-label required fs-7">@T["In or out"]</label><select class="form-select form-select-solid form-select-sm" data-ff="kind">
                <optgroup label="@T["Fluid in"]">@foreach (var k in HospitalFluidKind.In) {<option value="@k">@T["fluid:" + k]</option>}</optgroup>
                <optgroup label="@T["Fluid out"]">@foreach (var k in HospitalFluidKind.Out) {<option value="@k">@T["fluid:" + k]</option>}</optgroup></select></div>
            <div class="col-md-2"><label class="form-label required fs-7">ml</label><input type="number" min="1" max="5000" step="1" class="form-control form-control-solid form-control-sm" dir="ltr" data-ff="volumeMl" /></div>
            <div class="col-md-3"><label class="form-label fs-7">@T["Time"]</label><input type="datetime-local" class="form-control form-control-solid form-control-sm" dir="ltr" data-ff="at" /></div>
            <div class="col-md-3"><button type="button" class="btn btn-sm btn-primary w-100" data-fluid-save><i class="ki-outline ki-plus fs-5"></i>@T["Record"]</button></div>
            <div class="col-12"><input class="form-control form-control-solid form-control-sm" maxlength="200" data-ff="note" placeholder="@T["Note (optional) — e.g. normal saline 0.9%"]" /></div>
        </div>}
        <div data-fluid-body><div class="text-muted fs-7 py-8 text-center">@T["Loading…"]</div></div>
    </div>
</div></div></div>
<div class="modal fade" id="crModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-600px"><div class="modal-content">
    <div class="modal-header"><div><h2 class="fw-bold m-0">@T["Ask for a consultation"]</h2><div class="text-muted fs-7 mt-1" data-cr-who></div></div><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10"><div class="row g-4">
        <div class="col-6"><label class="form-label required">@T["Specialty"]</label><select class="form-select form-select-solid" data-cr="departmentId"></select></div>
        <div class="col-6"><label class="form-label">@T["Doctor"]</label><select class="form-select form-select-solid" data-cr="practitionerId"><option value="">@T["Any doctor of the specialty"]</option></select></div>
        <div class="col-12"><label class="form-label required">@T["How urgent"]</label><div class="d-flex flex-wrap gap-5">
            @foreach (var u in HospitalConsultUrgency.All) {<label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="radio" name="crUrgency" value="@u" @(u == HospitalConsultUrgency.Routine ? "checked" : "") /><span class="form-check-label">@T["cru:" + u] <span class="text-muted fs-8">(@T["cruw:" + u])</span></span></label>}
        </div></div>
        <div class="col-12"><label class="form-label required">@T["Question"]</label><textarea class="form-control form-control-solid" rows="4" maxlength="1000" data-cr="question" placeholder="@T["The problem and what you want the consultant to answer"]"></textarea></div>
    </div></div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-cr-save>@T["Send the request"]</button></div>
</div></div></div>
<div class="modal fade" id="icModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content">
    <div class="modal-header"><div><h2 class="fw-bold m-0">@T["Infection control"]</h2><div class="text-muted fs-7 mt-1" data-ic-who></div></div><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10">
        <ul class="nav nav-tabs nav-line-tabs mb-6 fs-6">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#icIso">@T["Isolation"]</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#icDev">@T["Device"]</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#icCase">@T["Report an infection"]</a></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="icIso" data-ic-form="iso"><div class="row g-4">
                <div class="col-6"><label class="form-label required">@T["Precautions"]</label><select class="form-select form-select-solid" data-f="precaution">@foreach (var x in HospitalPrecaution.All) { <option value="@x">@T["prec:" + x]</option> }</select></div>
                <div class="col-6"><label class="form-label">@T["Organism"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="100" data-f="organism" placeholder="MRSA" /></div>
                <div class="col-12"><label class="form-label">@T["Why"]</label><input class="form-control form-control-solid" maxlength="300" data-f="reason" placeholder="@T["Suspected, awaiting the culture"]" /></div>
                <div class="col-12 text-end"><button type="button" class="btn btn-danger" data-ic-save="iso">@T["Start isolation"]</button></div>
            </div></div>
            <div class="tab-pane fade" id="icDev" data-ic-form="dev"><div class="row g-4">
                <div class="col-6"><label class="form-label required">@T["Device"]</label><select class="form-select form-select-solid" data-f="kind">@foreach (var x in HospitalDeviceKind.All) { <option value="@x">@T["dev:" + x]</option> }</select></div>
                <div class="col-6"><label class="form-label">@T["Inserted at"]</label><input type="datetime-local" class="form-control form-control-solid" dir="ltr" data-f="at" /><div class="form-text">@T["Empty means now."]</div></div>
                <div class="col-12"><label class="form-label">@T["Site"]</label><input class="form-control form-control-solid" maxlength="100" data-f="site" placeholder="@T["Right subclavian"]" /></div>
                <div class="col-12 text-end"><button type="button" class="btn btn-primary" data-ic-save="dev">@T["Record the device"]</button></div>
            </div></div>
            <div class="tab-pane fade" id="icCase" data-ic-form="case"><div class="row g-4">
                <div class="col-6"><label class="form-label required">@T["Infection"]</label><select class="form-select form-select-solid" data-f="kind">@foreach (var x in HospitalInfectionKind.All) { <option value="@x">@T["ick:" + x]</option> }</select></div>
                <div class="col-6"><label class="form-label required">@T["Date of the event"]</label><input type="date" class="form-control form-control-solid" dir="ltr" data-f="onsetDate" /></div>
                <div class="col-12"><label class="form-label">@T["Organism"]</label><input class="form-control form-control-solid" dir="ltr" maxlength="100" data-f="organism" placeholder="Klebsiella pneumoniae (ESBL)" /></div>
                <div class="col-12"><label class="form-label">@T["Notes"]</label><textarea class="form-control form-control-solid" rows="2" maxlength="1000" data-f="notes" placeholder="@T["Fever, the specimen sent, what was seen"]"></textarea></div>
                <div class="col-12 text-muted fs-8">@T["Infection control confirms or rules it out. Whether it is hospital-acquired follows from the dates."]</div>
                <div class="col-12 text-end"><button type="button" class="btn btn-primary" data-ic-save="case">@T["Report"]</button></div>
            </div></div>
        </div>
    </div>
</div></div></div>
<div class="modal fade" id="chartModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-900px"><div class="modal-content">
    <div class="modal-header"><h2 class="fw-bold m-0">@T["Observation chart"] — <span data-chart-who></span></h2><div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body py-6 px-lg-10" data-chart-body></div>
</div></div></div>

@section Scripts {
    <partial name="_PersonSelect" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                record: @Json.Serialize(T["Record \"{1}\" for {0}?"].Value), stop: @Json.Serialize(T["Stop the order {0}? Its future doses are no longer given."].Value),
                done: @Json.Serialize(T["Mark \"{0}\" done?"].Value), order: @Json.Serialize(T["Write the order {0} for {1}?"].Value),
                noMed: @Json.Serialize(T["No medicine of the pharmacy's list has this name — for one outside it, use the switch below"].Value),
                pickMed: @Json.Serialize(T["Choose a medicine of the pharmacy's list"].Value), outsideNeeds: @Json.Serialize(T["A drug outside the pharmacy's list needs its name and reason"].Value),
                extraWhy: @Json.Serialize(T["Why this dose is given outside its hours"].Value), extraEg: @Json.Serialize(T["e.g. first dose now, as the doctor ordered"].Value),
                heldWhy: @Json.Serialize(T["Why the dose is held"].Value), heldEg: @Json.Serialize(T["e.g. BP 85/50, doctor informed"].Value),
                missedWhy: @Json.Serialize(T["Why the dose was missed"].Value), missedEg: @Json.Serialize(T["e.g. the patient was off the ward for imaging"].Value) };
            var root = @Json.Serialize(Url.Action("Nursing")), wardId = @(b?.Ward.Id ?? 0);
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (f) { document.getElementById('kt_app_content').innerHTML = f.innerHTML; if (window.__themeTaskForm) window.__themeTaskForm(); }
                });
            }
            // H126: the task form's theme controls — select2 and the theme's time picker — set again after every swap
            function themeTaskForm() {
                var sel = document.querySelector('[data-nurse-select]');
                if (sel && window.jQuery && jQuery.fn.select2 && !sel.classList.contains('select2-hidden-accessible')) jQuery(sel).select2({ minimumResultsForSearch: 8, width: '100%' });
                var tm = document.querySelector('[data-nurse-time]');
                if (tm && window.flatpickr && !tm._flatpickr) flatpickr(tm, { enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, disableMobile: true });
            }
            window.__themeTaskForm = themeTaskForm; themeTaskForm();
            function done(btn, modal) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); if (modal) bootstrap.Modal.getOrCreateInstance(modal).hide(); swap(); }; }
            // Choosing another ward reloads the board for it (a filter is a GET, never a write).
            var wardSel = document.querySelector('#wardForm [name=ward]');
            if (wardSel && window.CB && CB.onSelectChange) CB.onSelectChange(wardSel, function () { document.getElementById('wardForm').submit(); });

            var dEl = document.getElementById('doseModal'), dose = null;
            function reasonShown() { var s = (dEl.querySelector('[name=d-status]:checked') || {}).value, extra = !!(dose && dose.extra);
                // H271: the reason's words follow the answer (the generic "Reason" read "why refused" on every choice)
                var why = s === 'Held' ? [W.heldWhy, W.heldEg] : s === 'Missed' ? [W.missedWhy, W.missedEg] : [W.extraWhy, W.extraEg];
                dEl.querySelector('[data-d-reason-label]').textContent = why[0]; dEl.querySelector('[data-d-reason]').placeholder = why[1];
                dEl.querySelector('[data-d-reason-wrap]').classList.toggle('d-none', s === 'Given' && !extra); dEl.querySelector('[data-d-scan-wrap]').classList.toggle('d-none', s !== 'Given'); dEl.querySelector('[data-d-witness-wrap]').classList.toggle('d-none', !(s === 'Given' && dose && dose.controlled)); }
            // H205: Enter from the scanner moves from the wristband to the pack; "cannot be scanned" opens the reason
            dEl.addEventListener('keydown', function (e) { if (e.key !== 'Enter') return; if (e.target.hasAttribute('data-d-wrist')) { e.preventDefault(); look(); dEl.querySelector('[data-d-pack]').focus(); } else if (e.target.hasAttribute('data-d-pack')) { e.preventDefault(); look(); } });
            // H270: what was read, said under each box (the owner: Enter gave no sign); spaces around a scan are dropped
            function note(k, r) { var n = dEl.querySelector('[data-d-' + k + '-note]'); if (!r) { n.classList.add('d-none'); n.innerHTML = ''; return; }
                n.className = 'fs-7 fw-semibold mt-2 d-flex align-items-start gap-1 ' + (r.ok ? 'text-primary' : 'text-danger');
                n.innerHTML = '<i class="ki-outline ki-' + (r.ok ? 'check-circle' : 'information-5') + ' fs-5 ' + (r.ok ? 'text-primary' : 'text-danger') + '"></i><span dir="auto"></span>'; n.querySelector('span').textContent = r.text; }
            function look() {
                var w = dEl.querySelector('[data-d-wrist]'), p = dEl.querySelector('[data-d-pack]'); w.value = w.value.trim(); p.value = p.value.trim();
                if (!dose || (!w.value && !p.value)) { note('wrist', null); note('pack', null); return; }
                fetch(root + '/ScanLook?orderId=' + dose.orderId + '&wristband=' + encodeURIComponent(w.value) + '&pack=' + encodeURIComponent(p.value), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (x) { return x.json(); }).then(function (res) { if (!res || !res.ok) return; note('wrist', res.wristband); note('pack', res.pack); }).catch(function () { });
            }
            dEl.addEventListener('change', function (e) { if (e.target.hasAttribute('data-d-wrist') || e.target.hasAttribute('data-d-pack')) look(); });
            dEl.addEventListener('click', function (e) { if (!e.target.closest('[data-d-noscan]')) return; e.preventDefault(); dEl.querySelector('[data-d-override-wrap]').classList.remove('d-none'); dEl.querySelector('[data-d-override]').focus(); });
            dEl.addEventListener('shown.bs.modal', function () { var w = dEl.querySelector('[data-d-wrist]'); if (!dEl.querySelector('[data-d-scan-wrap]').classList.contains('d-none')) w.focus(); });
            dEl.addEventListener('change', function (e) { if (e.target.name === 'd-status') reasonShown(); });
            var oEl = document.getElementById('orderModal'), orderFor = null;
            // H270: an as-needed order has no fixed hours (the owner's walk-through hit the refusal after typing them) -
            // the hours box empties and locks while "as needed" is on, so the form cannot ask for what the rule refuses
            function prnHours() { var prn = oEl.querySelector('[data-k=asNeeded]').checked, h = oEl.querySelector('[data-k=hours]'); if (prn) h.value = ''; h.disabled = prn; }
            oEl.querySelector('[data-k=asNeeded]').addEventListener('change', prnHours);
            // H270: the drug picker - a medicine of the pharmacy's list only (its item links the pack scan); a drug outside the
            // list is the explicit switch under it, with its name and its reason (the owner: words the search did not find
            // must not become an order)
            (function () {
                var sel = oEl.querySelector('[data-o-drug]'), drug = oEl.querySelector('[data-k=drug]'), item = oEl.querySelector('[data-k=itemId]');
                var out = oEl.querySelector('[data-o-outside]'), wrap = oEl.querySelector('[data-o-outside-wrap]');
                if (!sel || !window.jQuery || !jQuery.fn.select2) return;
                var $s = jQuery(sel);
                function norm(t) { return String(t || '').toLowerCase().replace(/[\u2010-\u2015\u2212]/g, '-').replace(/\s+/g, ' ').trim(); }
                $s.select2({ width: '100%', placeholder: $s.data('placeholder'), allowClear: true, dropdownParent: jQuery(oEl), dir: document.documentElement.dir || 'ltr',
                        language: { noResults: function () { return W.noMed; } },
                        // dashes and spaces as anyone types them ("-" finds "—")
                        // H271: Arabic or English finds the medicine (owner: a drug is searched in either language), and the
                        // result shows both names with the code
                        matcher: function (params, data) { var t = norm(params.term); if (!t) return data;
                            var alt = data.element ? data.element.getAttribute('data-alt') || '' : ''; return norm(data.text + ' ' + alt).indexOf(t) >= 0 ? data : null; },
                        templateResult: function (d) { if (!d.element || !/^i:/.test(d.id || '')) return d.text;
                            var name = d.text.replace(/\s·\s[^·]*$/, ''), alt = d.element.getAttribute('data-alt') || '', code = d.element.getAttribute('data-code') || '';
                            var $r = jQuery('<div class="d-flex flex-column"><span class="fw-semibold"></span><span class="fs-8 text-muted"></span></div>');
                            $r.children().eq(0).text(name); $r.children().eq(1).text((alt ? alt + ' · ' : '') + code); return $r; } })
                  .on('change', function () { var v = $s.val() || '', o = sel.options[sel.selectedIndex];
                      if (/^i:/.test(v)) { item.value = v.slice(2); drug.value = (o ? o.text : '').replace(/\s·\s[^·]*$/, ''); } else { item.value = ''; drug.value = ''; } });
                out.addEventListener('change', function () {
                    wrap.classList.toggle('d-none', !out.checked); $s.prop('disabled', out.checked);
                    if (out.checked) { $s.val(null).trigger('change'); oEl.querySelector('[data-o-outside-name]').focus(); }
                });
                window.__orderReset = function () { out.checked = false; wrap.classList.add('d-none'); $s.prop('disabled', false).val(null).trigger('change');
                    oEl.querySelector('[data-o-outside-name]').value = ''; oEl.querySelector('[data-o-outside-reason]').value = ''; };
            })();
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-dose],[data-stop-order],[data-new-order],[data-task-add],[data-handover-save]'); if (!t) return;
                if (t.hasAttribute('data-dose')) {
                    dose = { orderId: Number(t.getAttribute('data-dose')), dueAt: t.getAttribute('data-due') || null, controlled: t.getAttribute('data-controlled') === '1', what: t.getAttribute('data-what'), extra: t.getAttribute('data-extra') === '1' };
                    dEl.querySelector('[data-d-what]').textContent = dose.what;
                    // H271: who and what, with the allergy, at the top of the window
                    ['who', 'mrn', 'drug', 'dosetxt', 'when'].forEach(function (k) { dEl.querySelector('[data-d-' + k + ']').textContent = t.getAttribute('data-' + k) || ''; });
                    var ph = t.getAttribute('data-photo'), pEl = dEl.querySelector('[data-d-photo]'); pEl.innerHTML = '';
                    if (ph) { var im = document.createElement('img'); im.src = ph; im.alt = ''; im.style.objectFit = 'cover'; pEl.appendChild(im); }
                    else { var sp = document.createElement('span'); sp.className = 'symbol-label bg-white text-primary fw-bold'; sp.textContent = (t.getAttribute('data-who') || '?').trim().charAt(0); pEl.appendChild(sp); }
                    var al = t.getAttribute('data-allergy') || ''; dEl.querySelector('[data-d-allergy]').textContent = al;
                    dEl.querySelector('[data-d-allergy-wrap]').classList.toggle('d-none', !al); dEl.querySelector('[data-d-allergy-wrap]').classList.toggle('d-flex', !!al);
                    dEl.querySelector('[name=d-status][value=Given]').checked = true; dEl.querySelector('[data-d-reason]').value = ''; $(dEl.querySelector('[data-d-witness]')).val(null).trigger('change');
                    ['[data-d-wrist]', '[data-d-pack]', '[data-d-override]'].forEach(function (k) { dEl.querySelector(k).value = ''; }); dEl.querySelector('[data-d-override-wrap]').classList.add('d-none'); note('wrist', null); note('pack', null);
                    reasonShown(); bootstrap.Modal.getOrCreateInstance(dEl).show(); return;
                }
                if (t.hasAttribute('data-stop-order')) {
                    cbConfirm(W.stop.replace('{0}', t.getAttribute('data-what')), { kind: 'danger' }).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Order/' + t.getAttribute('data-stop-order') + '/Stop').then(done(t)); });
                    return;
                }
                if (t.hasAttribute('data-new-order')) {
                    orderFor = { admissionId: Number(t.getAttribute('data-new-order')), who: t.getAttribute('data-who') };
                    oEl.querySelector('[data-o-who]').textContent = orderFor.who;
                    oEl.querySelectorAll('[data-k]').forEach(function (i) { if (i.type === 'checkbox') i.checked = false; else if (i.tagName !== 'SELECT') i.value = ''; });
                    if (window.__orderReset) window.__orderReset();
                    prnHours();
                    bootstrap.Modal.getOrCreateInstance(oEl).show(); return;
                }
                if (t.hasAttribute('data-task-add')) {
                    var f = t.closest('[data-task-form]'), title = f.querySelector('[data-k=title]').value.trim(), time = f.querySelector('[data-k=time]').value;
                    if (!title || !time) return;
                    var d = new Date(); var due = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0') + 'T' + time + ':00';
                    t.disabled = true; post(root + '/Task', { admissionId: Number(f.querySelector('[data-k=admissionId]').value), title: title, dueAt: due }).then(done(t)); return;
                }
