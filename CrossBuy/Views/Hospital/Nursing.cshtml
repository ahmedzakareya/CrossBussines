                            '<span class="badge hp-code fs-9">' + esc(o.accession) + '</span><bdi class="fw-semibold fs-7">' + esc(o.name) + '</bdi>' +
                            '<span class="badge ' + (o.priorityCode === 'Stat' ? 'badge-danger' : o.priorityCode === 'Urgent' ? 'badge-light-danger' : 'badge-light') + ' fs-9">' + esc(o.priority) + '</span>' +
                            '<span class="badge badge-light-primary fs-9">' + esc(o.status) + '</span>' + (o.contrastAlert ? '<span class="badge badge-light-danger fs-9">' + esc(W.contrastFlag) + '</span>' : '') +
                            '<span class="text-muted fs-9 ms-auto hp-num" dir="ltr">' + esc(o.at) + '</span>' +
                            (o.cancellable ? '<button type="button" class="btn btn-sm btn-light-danger py-1" data-diag-cancel="' + o.id + '" data-what="' + esc(o.accession) + '">' + esc(W.cancel) + '</button>' : '') +
                            (o.cancelled && o.reason ? '<div class="w-100 text-muted fs-9" dir="auto">' + esc(o.reason) + '</div>' : '') + '</div>';
                    }).join('') : '<div class="text-muted fs-7">' + esc(W.none) + '</div>';
                });
            }
            dEl.querySelector('[data-diag-find]').addEventListener('input', function () {
                var q = this.value.trim().toLowerCase();
                dEl.querySelectorAll('[data-find]').forEach(function (l) { l.classList.toggle('d-none', !!q && l.getAttribute('data-find').indexOf(q) < 0); });
            });
