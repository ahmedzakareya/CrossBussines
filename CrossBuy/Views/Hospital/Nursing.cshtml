    <script>
        // H71 — observations and risk on the nursing station.
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, base = @Json.Serialize(Url.Content("~/Hospital/Observations"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
                askObs: @Json.Serialize(T["Record these observations for {0}?"].Value), askRisk: @Json.Serialize(T["Save this assessment for {0}?"].Value),
                score: @Json.Serialize(T["NEWS2 {0} — {1}"].Value), incomplete: @Json.Serialize(T["Saved. NEWS2 needs all seven readings, so this set is not scored."].Value),
                escalated: @Json.Serialize(T["An urgent task was opened on the ward board: tell the doctor now."].Value),
                titles: { Morse: @Json.Serialize(T["Falls risk (Morse)"].Value), Braden: @Json.Serialize(T["Pressure-injury risk (Braden)"].Value) },
                risk: { Low: @Json.Serialize(T["news2risk:Low"].Value), LowSingle: @Json.Serialize(T["news2risk:LowSingle"].Value), Medium: @Json.Serialize(T["news2risk:Medium"].Value), High: @Json.Serialize(T["news2risk:High"].Value) } };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function loadPanel() {
                var el = document.querySelector('[data-obs-panel]:not([data-loaded])'); if (!el) return;
                el.setAttribute('data-loaded', '1');
                fetch(base + '/Ward/' + el.getAttribute('data-obs-panel'), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (h) { el.innerHTML = h;
                    // the rows carry Metronic "Actions" menus; injected markup needs the menus bound
                    if (window.KTMenu && KTMenu.createInstances) { try { KTMenu.createInstances(); } catch (x) { } } });
            }
            // the escalation task belongs to the board's own list: the page is rendered again and its content swapped (never a reload)
            function swapPage() {
                fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (f) { document.getElementById('kt_app_content').innerHTML = f.innerHTML; if (window.__themeTaskForm) window.__themeTaskForm(); }
                });
            }
            function redraw() { var el = document.querySelector('[data-obs-panel]'); if (el) el.removeAttribute('data-loaded'); loadPanel(); }
            loadPanel();
            // the board redraws its content after each of its own saves; a fresh panel placeholder loads itself
            new MutationObserver(function () { loadPanel(); }).observe(document.getElementById('kt_app_content'), { childList: true, subtree: false });
            var oEl = document.getElementById('obsModal'), rEl = document.getElementById('riskModal'), cEl = document.getElementById('chartModal'), cur = null, acvpu = '';
            function num(v) { return v === '' || v == null ? null : Number(v); }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-obs-new],[data-risk-new],[data-obs-chart],[data-acvpu]'); if (!t) return;
                if (t.tagName === 'A') e.preventDefault();
                if (t.hasAttribute('data-acvpu')) {
                    acvpu = acvpu === t.getAttribute('data-acvpu') ? '' : t.getAttribute('data-acvpu');
                    oEl.querySelectorAll('[data-acvpu]').forEach(function (b) { var on = b.getAttribute('data-acvpu') === acvpu; b.classList.toggle('btn-primary', on); b.classList.toggle('btn-light', !on); });
                    return;
                }
                cur = { id: Number(t.getAttribute('data-obs-new') || t.getAttribute('data-risk-new') || t.getAttribute('data-obs-chart')), who: t.getAttribute('data-who'), kind: t.getAttribute('data-kind') };
                if (t.hasAttribute('data-obs-new')) {
                    oEl.querySelector('[data-obs-who]').textContent = cur.who;
                    oEl.querySelectorAll('[data-ob]').forEach(function (i) { if (i.type === 'checkbox') i.checked = false; else i.value = ''; });
                    acvpu = ''; oEl.querySelectorAll('[data-acvpu]').forEach(function (b) { b.classList.remove('btn-primary'); b.classList.add('btn-light'); });
                    bootstrap.Modal.getOrCreateInstance(oEl).show(); return;
                }
                if (t.hasAttribute('data-risk-new')) {
                    rEl.querySelector('[data-risk-title]').textContent = W.titles[cur.kind]; rEl.querySelector('[data-risk-who]').textContent = cur.who;
                    rEl.querySelectorAll('[data-risk-kind]').forEach(function (d) { d.classList.toggle('d-none', d.getAttribute('data-risk-kind') !== cur.kind); });
                    rEl.querySelectorAll('input[type=radio]').forEach(function (r) { r.checked = false; }); rEl.querySelectorAll('[data-ri]').forEach(function (l) { l.classList.remove('active'); });
                    rEl.querySelector('[data-risk-total]').textContent = '—'; rEl.querySelector('[data-risk-note]').value = '';
                    bootstrap.Modal.getOrCreateInstance(rEl).show(); return;
                }
                cEl.querySelector('[data-chart-who]').textContent = cur.who; cEl.querySelector('[data-chart-body]').innerHTML = '…';
                bootstrap.Modal.getOrCreateInstance(cEl).show();
                fetch(base + '/' + cur.id + '/Chart', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (h) { cEl.querySelector('[data-chart-body]').innerHTML = h; });
            });
            function picks() { var box = rEl.querySelector('[data-risk-kind="' + cur.kind + '"]'), n = box.querySelectorAll('.mb-5').length, out = [];
                for (var k = 0; k < n; k++) { var r = box.querySelector('input[name="ri-' + cur.kind + '-' + k + '"]:checked'); out.push(r ? Number(r.value) : null); } return out; }
            rEl.addEventListener('change', function (e) {
                var r = e.target; if (r.type !== 'radio') return;
                r.closest('.d-flex').querySelectorAll('[data-ri]').forEach(function (l) { l.classList.toggle('active', l.contains(r)); });
                var v = picks(); rEl.querySelector('[data-risk-total]').textContent = v.indexOf(null) >= 0 ? '—' : v.reduce(function (a, b) { return a + b; }, 0);
            });
            oEl.querySelector('[data-obs-save]').addEventListener('click', function (e) {
                var btn = e.currentTarget, g = function (k) { return oEl.querySelector('[data-ob=' + k + ']'); };
                var body = { admissionId: cur.id, respRate: num(g('respRate').value), spO2: num(g('spO2').value), onOxygen: g('onOxygen').checked, spO2Scale2: g('spO2Scale2').checked,
                    systolicBp: num(g('systolicBp').value), diastolicBp: num(g('diastolicBp').value), heartRate: num(g('heartRate').value), tempC: num(g('tempC').value),
                    painScore: num(g('painScore').value), consciousness: acvpu || null, note: g('note').value.trim() || null };
                cbConfirm(W.askObs.replace('{0}', cur.who)).then(function (ok) { if (!ok) return; btn.disabled = true;
                    post(base, body).then(function (res) { btn.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                        bootstrap.Modal.getOrCreateInstance(oEl).hide();
                        var text = res.news2 == null ? W.incomplete : W.score.replace('{0}', res.news2).replace('{1}', W.risk[res.risk] || '') + (res.escalated ? '\n' + W.escalated : '');
                        if (res.escalated && window.Swal) Swal.fire({ text: text, icon: 'error', confirmButtonText: 'OK', customClass: { confirmButton: 'btn btn-danger' }, buttonsStyling: false });
                        else toastr.success(text);
                        if (res.escalated) swapPage(); else redraw(); }); });
            });
            rEl.querySelector('[data-risk-save]').addEventListener('click', function (e) {
                var btn = e.currentTarget, items = picks();
                cbConfirm(W.askRisk.replace('{0}', cur.who)).then(function (ok) { if (!ok) return; btn.disabled = true;
                    post(base + '/Assess', { admissionId: cur.id, kind: cur.kind, items: items.map(function (x) { return x == null ? -1 : x; }), note: rEl.querySelector('[data-risk-note]').value.trim() || null })
                        .then(function (res) { btn.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(rEl).hide(); redraw(); }); });
            });
        })();
    </script>
    <script>
        // H74 — placing an order set from the nursing station.
        (function () {
            var sEl = document.getElementById('setModal'); if (!sEl) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, base = @Json.Serialize(Url.Content("~/Hospital/OrderSets/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), ask: @Json.Serialize(T["Place {0} lines of this set for {1}?"].Value),
                placed: @Json.Serialize(T["Placed: {0} lines"].Value), none: @Json.Serialize(T["No order sets yet: the administrator writes them under Pharmacy."].Value),
                why: @Json.Serialize(T["Write why this order is still right (it is kept with the order)"].Value), go: @Json.Serialize(T["Order anyway"].Value),
                med: @Json.Serialize(T["Medicine"].Value), task: @Json.Serialize(T["Nursing task"].Value) };
            var sets = [], cur = null;
            function esc(v) { return String(v == null ? '' : v).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function draw() {
                var id = Number(sEl.querySelector('[data-set-pick]').value), set = sets.filter(function (x) { return x.id === id; })[0], box = sEl.querySelector('[data-set-lines]');
                box.innerHTML = !set ? '' : set.items.map(function (i) {
                    return '<label class="d-flex align-items-start gap-3 py-3 border-bottom border-gray-200 border-bottom-dashed"><input class="form-check-input mt-1" type="checkbox" data-line="' + i.id + '"' + (i.preselected ? ' checked' : '') + ' />' +
                        '<div class="flex-grow-1"><span class="badge ' + (i.kind === 'Med' ? 'badge-light-primary' : 'badge-light-primary') + ' fs-9 me-2">' + (i.kind === 'Med' ? W.med : W.task) + '</span>' +
                        '<bdi class="fw-semibold text-gray-800">' + esc(i.text) + '</bdi>' + (i.note ? '<div class="text-muted fs-8" dir="auto">' + esc(i.note) + '</div>' : '') + '</div></label>';
                }).join('');
            }
            sEl.querySelector('[data-set-pick]').addEventListener('change', draw);
            if (window.CB && CB.onSelectChange) CB.onSelectChange(sEl.querySelector('[data-set-pick]'), draw);
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-set-order]'); if (!t) return;
                cur = { admissionId: Number(t.getAttribute('data-set-order')), who: t.getAttribute('data-who') };
                sEl.querySelector('[data-set-who]').textContent = cur.who; sEl.querySelector('[data-set-lines]').innerHTML = '';
                fetch(base + 'Active', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (list) {
                    sets = list || []; var pick = sEl.querySelector('[data-set-pick]');
                    pick.innerHTML = '<option value="">' + esc(pick.options[0].text) + '</option>' + sets.map(function (x) { return '<option value="' + x.id + '">' + esc(x.code + ' — ' + x.name) + '</option>'; }).join('');
                    if (!sets.length) sEl.querySelector('[data-set-lines]').innerHTML = '<div class="text-muted fs-7">' + esc(W.none) + '</div>';
                    bootstrap.Modal.getOrCreateInstance(sEl).show();
                });
            });
            function place(id, body, btn) {
                post(base + id + '/Apply', body).then(function (res) {
                    btn.disabled = false;
                    if (!res.ok && res.code === 'clinical_alert') {
                        var list = (res.alerts || []).map(function (a) { return '• [' + a.severityText + '] ' + a.text; }).join('   ');
                        cbPrompt(list + '   — ' + W.why, { kind: 'danger', textarea: true, title: res.error, ok: W.go }).then(function (why) { if (why == null) return; body.overrideReason = why; btn.disabled = true; place(id, body, btn); });
                        return;
                    }
                    if (!res.ok) { toastr.error(res.error || W.failed); return; }
                    (res.warnings || []).forEach(function (a) { toastr.info('[' + a.severityText + '] ' + a.text); });
                    toastr.success(W.placed.replace('{0}', res.placed));
                    bootstrap.Modal.getOrCreateInstance(sEl).hide();
                    fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                        var f = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content'); if (f) { document.getElementById('kt_app_content').innerHTML = f.innerHTML; if (window.__themeTaskForm) window.__themeTaskForm(); } });
                });
            }
            sEl.querySelector('[data-set-place]').addEventListener('click', function (e) {
                var btn = e.currentTarget, id = Number(sEl.querySelector('[data-set-pick]').value);
                var ids = Array.prototype.map.call(sEl.querySelectorAll('[data-line]:checked'), function (c) { return Number(c.getAttribute('data-line')); });
                if (!id || !ids.length) return;
                cbConfirm(W.ask.replace('{0}', ids.length).replace('{1}', cur.who)).then(function (ok) { if (!ok) return; btn.disabled = true; place(id, { admissionId: cur.admissionId, itemIds: ids }, btn); });
            });
        })();
    </script>
    <script>
        // H75 — lab tests and imaging for an inpatient.
        (function () {
            var dEl = document.getElementById('diagModal'); if (!dEl) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, base = @Json.Serialize(Url.Content("~/Hospital/Admissions/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), ask: @Json.Serialize(T["Order {0} tests and exams for {1}?"].Value),
                placed: @Json.Serialize(T["Ordered: {0}"].Value), contrast: @Json.Serialize(T["Contrast exam and the file records a contrast allergy: {0}"].Value),
                why: @Json.Serialize(T["Why is {0} cancelled?"].Value), none: @Json.Serialize(T["Nothing ordered yet."].Value), cancel: @Json.Serialize(T["Cancel"].Value),
                contrastFlag: @Json.Serialize(T["Contrast allergy"].Value), contrastExam: @Json.Serialize(T["contrast"].Value) };
            var cur = null, prio = 'Routine';
            function esc(v) { return String(v == null ? '' : v).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
