                if (t.hasAttribute('data-diag-cancel')) {
                    cbPrompt(W.why.replace('{0}', t.getAttribute('data-what')), { kind: 'danger' }).then(function (v) { if (v == null) return; t.disabled = true;
                        post(base + 'Diagnostics/' + t.getAttribute('data-diag-cancel') + '/Cancel', { reason: v }).then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } load(); }); });
