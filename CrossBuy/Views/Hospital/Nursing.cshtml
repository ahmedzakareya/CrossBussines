    // H76 — infection control from the nursing station
    (function () {
        var mEl = document.getElementById('icModal'); if (!mEl) return;
        var tok = document.querySelector('input[name="__RequestVerificationToken"]'), adm = 0;
        var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
            iso: @Json.Serialize(T["Start isolation for this patient?"].Value), dev: @Json.Serialize(T["Record this device?"].Value),
            kase: @Json.Serialize(T["Report this infection to infection control?"].Value), remove: @Json.Serialize(T["Record that this device was removed now?"].Value) };
        var urls = { iso: @Json.Serialize(Url.Content("~/Hospital/Infection/Isolation")), dev: @Json.Serialize(Url.Content("~/Hospital/Infection/Device")), kase: @Json.Serialize(Url.Content("~/Hospital/Infection/Case")) };
        function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok ? tok.value : '' }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
        function today() { var d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
        document.addEventListener('click', function (e) {
            var o = e.target.closest('[data-ic]');
            if (o) {
                adm = Number(o.getAttribute('data-ic'));
                mEl.querySelector('[data-ic-who]').textContent = o.getAttribute('data-who') || '';
                mEl.querySelectorAll('[data-f]').forEach(function (i) { if (i.tagName !== 'SELECT') i.value = ''; else i.selectedIndex = 0; });
                mEl.querySelector('#icCase [data-f="onsetDate"]').value = today();
                bootstrap.Modal.getOrCreateInstance(mEl).show();
                return;
            }
            var r = e.target.closest('[data-ic-remove]');
            if (r) {
                cbConfirm(W.remove + '\n' + (r.getAttribute('data-what') || '')).then(function (ok) { if (!ok) return;
                    post(urls.dev + '/' + r.getAttribute('data-ic-remove') + '/Remove', {}).then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); location.reload(); }); });
                return;
            }
            var s = e.target.closest('[data-ic-save]'); if (!s) return;
            var k = s.getAttribute('data-ic-save'), pane = mEl.querySelector('[data-ic-form="' + k + '"]'), body = { admissionId: adm };
            pane.querySelectorAll('[data-f]').forEach(function (i) { body[i.getAttribute('data-f')] = i.value.trim() || null; });
            var key = k === 'case' ? 'kase' : k;
            cbConfirm(W[key]).then(function (ok) { if (!ok) return; s.disabled = true;
                post(urls[key], body).then(function (res) { s.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                    toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(mEl).hide(); location.reload(); }); });
        });
    })();

    // H77 — consultation requests from the nursing station
    (function () {
        var mEl = document.getElementById('crModal'); if (!mEl) return;
        var tok = document.querySelector('input[name="__RequestVerificationToken"]'), adm = 0, specs = null;
        var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), ask: @Json.Serialize(T["Send this consultation request?"].Value),
            any: @Json.Serialize(T["Any doctor of the specialty"].Value), pick: @Json.Serialize(T["Choose the specialty"].Value) };
        var dep = mEl.querySelector('[data-cr="departmentId"]'), doc = mEl.querySelector('[data-cr="practitionerId"]');
        function opt(v, l) { var o = document.createElement('option'); o.value = v; o.textContent = l; return o; }
        function fillDocs() { doc.innerHTML = ''; doc.appendChild(opt('', W.any)); var s = (specs || []).find(function (x) { return String(x.id) === dep.value; });
            (s ? s.doctors : []).forEach(function (d) { doc.appendChild(opt(d.id, d.name)); }); }
        dep.addEventListener('change', fillDocs);
        function loadSpecs() { if (specs) return Promise.resolve();
            return fetch(@Json.Serialize(Url.Action("ConsultSpecialties")), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); }).then(function (d) {
                specs = d; dep.innerHTML = ''; dep.appendChild(opt('', W.pick)); d.forEach(function (s) { dep.appendChild(opt(s.id, s.name)); }); fillDocs(); }); }
        function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok ? tok.value : '' }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
        document.addEventListener('click', function (e) {
            var o = e.target.closest('[data-cr-new]');
            if (o) {
                adm = Number(o.getAttribute('data-cr-new'));
                mEl.querySelector('[data-cr-who]').textContent = o.getAttribute('data-who') || '';
                loadSpecs().then(function () { dep.value = ''; fillDocs(); mEl.querySelector('[data-cr="question"]').value = '';
                    mEl.querySelector('input[name="crUrgency"][value="Routine"]').checked = true; bootstrap.Modal.getOrCreateInstance(mEl).show(); });
                return;
            }
            var s = e.target.closest('[data-cr-save]'); if (!s) return;
            var u = mEl.querySelector('input[name="crUrgency"]:checked');
            var body = { admissionId: adm, departmentId: Number(dep.value || 0), practitionerId: doc.value ? Number(doc.value) : null, urgency: u ? u.value : null, question: mEl.querySelector('[data-cr="question"]').value.trim() || null };
            cbConfirm(W.ask).then(function (ok) { if (!ok) return; s.disabled = true;
                post(@Json.Serialize(Url.Action("RequestConsult")), body).then(function (res) { s.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                    toastr.success(W.saved); bootstrap.Modal.getOrCreateInstance(mEl).hide(); location.reload(); }); });
        });
    })();

    // H78 — the fluid chart from the nursing station
    (function () {
        var mEl = document.getElementById('fluidModal'); if (!mEl) return;
        var tok = document.querySelector('input[name="__RequestVerificationToken"]'), adm = 0, back = 0, dirty = false;
        var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), ask: @Json.Serialize(T["Record this volume on the fluid chart?"].Value),
            voidTitle: @Json.Serialize(T["Void this entry"].Value), voidWhy: @Json.Serialize(T["Why it is voided"].Value) };
        var body = mEl.querySelector('[data-fluid-body]');
        function load() { fetch(@Json.Serialize(Url.Content("~/Hospital/Admissions/"))+ adm + '/Fluids?back=' + back, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); }).then(function (h) { body.innerHTML = h; }); }
        function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok ? tok.value : '' }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
        mEl.addEventListener('hidden.bs.modal', function () { if (dirty) location.reload(); });
        document.addEventListener('click', function (e) {
            var o = e.target.closest('[data-fluid]');
            if (o) { adm = Number(o.getAttribute('data-fluid')); back = 0; dirty = false;
                mEl.querySelector('[data-fluid-who]').textContent = o.getAttribute('data-who') || '';
                mEl.querySelectorAll('[data-ff]').forEach(function (i) { if (i.tagName !== 'SELECT') i.value = ''; });
                body.innerHTML = '<div class="text-muted fs-7 py-8 text-center">…</div>'; load(); bootstrap.Modal.getOrCreateInstance(mEl).show(); return; }
            var d = e.target.closest('[data-fluid-day]'); if (d && mEl.contains(d)) { back = Number(d.getAttribute('data-fluid-day')); load(); return; }
            var v = e.target.closest('[data-fluid-void]');
            if (v) { cbPrompt(v.getAttribute('data-what') || '', { title: W.voidTitle, placeholder: W.voidWhy, kind: 'danger' }).then(function (why) { if (!why) return;
                post(@Json.Serialize(Url.Content("~/Hospital/Admissions/Fluids/")) + v.getAttribute('data-fluid-void') + '/Void', { reason: why }).then(function (res) {
                    if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); dirty = true; load(); }); }); return; }
            var s = e.target.closest('[data-fluid-save]'); if (!s) return;
            var f = { admissionId: adm }; mEl.querySelectorAll('[data-ff]').forEach(function (i) { var k = i.getAttribute('data-ff'); f[k] = k === 'volumeMl' ? Number(i.value || 0) : (i.value.trim() || null); });
            cbConfirm(W.ask).then(function (ok) { if (!ok) return; s.disabled = true;
                post(@Json.Serialize(Url.Action("AddFluid")), f).then(function (res) { s.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; }
                    toastr.success(W.saved); dirty = true; back = 0; mEl.querySelector('[data-ff="volumeMl"]').value = ''; mEl.querySelector('[data-ff="note"]').value = ''; load(); }); });
        });
    })();

    // H79 — the problem list and the care plan from the nursing station
    (function () {
        var mEl = document.getElementById('careModal'); if (!mEl) return;
        var tok = document.querySelector('input[name="__RequestVerificationToken"]'), adm = 0, dirty = false, tab = '#cpPlan';
        var body = mEl.querySelector('[data-care-body]'), isAr = document.documentElement.getAttribute('dir') === 'rtl';
        var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value),
            addPlan: @Json.Serialize(T["Add this to the care plan?"].Value), addProblem: @Json.Serialize(T["Add this problem to the patient's list?"].Value),
            resolve: @Json.Serialize(T["Mark this problem as resolved?"].Value), closeTitle: @Json.Serialize(T["Close this plan"].Value), outcome: @Json.Serialize(T["The outcome"].Value) };
        var base = @Json.Serialize(Url.Content("~/Hospital/Admissions/"));
        function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok ? tok.value : '' }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
        function fill(need) { var f = mEl.querySelector('[data-cp-form]'); if (!f) return; var s = f.querySelector('[data-cp="need"]'); if (need) { s.value = need; if (window.jQuery && s.classList.contains('select2-hidden-accessible')) jQuery(s).trigger('change.select2'); }
            var o = s.options[s.selectedIndex]; f.querySelector('[data-cp="goal"]').value = o.getAttribute('data-goal') || ''; f.querySelector('[data-cp="interventions"]').value = o.getAttribute('data-iv') || ''; }
        function wire() {
            var s = mEl.querySelector('[data-cp="need"]'); if (s) { s.addEventListener('change', function () { fill(); }); fill(); }
            // H128: the panel arrives by innerHTML after the modal opens, past the layout's select2 enhancer — the need and the
            // problem's kind get the theme's dropdown here, and select2's choice is relayed as the native change the form listens to
            if (window.jQuery && jQuery.fn.select2) mEl.querySelectorAll('[data-cp="need"],[data-pb="kind"]').forEach(function (el) {
                if (el.classList.contains('select2-hidden-accessible')) return;
                jQuery(el).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', dropdownParent: jQuery(mEl), minimumResultsForSearch: el.options.length > 8 ? 0 : Infinity })
                    .on('select2:select select2:clear', function () { el.dispatchEvent(new Event('change', { bubbles: true })); });
            });
            var a = mEl.querySelector('a[href="' + tab + '"]'); if (a) bootstrap.Tab.getOrCreateInstance(a).show();
            mEl.querySelectorAll('a[data-bs-toggle="tab"]').forEach(function (x) { x.addEventListener('shown.bs.tab', function () { tab = x.getAttribute('href'); }); });
            var pk = mEl.querySelector('[data-pb="code"]');
            if (pk && window.jQuery && jQuery.fn.select2) jQuery(pk).select2({ width: '100%', dir: isAr ? 'rtl' : 'ltr', allowClear: true, dropdownParent: jQuery(mEl), placeholder: pk.getAttribute('data-placeholder'),
                ajax: { url: @Json.Serialize(Url.Action("SearchDiagnosisCodes")), dataType: 'json', delay: 200, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: d.results || [] }; } } });
        }
        function load() { fetch(base + adm + '/CarePlan', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (h) { body.innerHTML = h; wire(); }); }
        function done(res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(W.saved); dirty = true; load(); }
        mEl.addEventListener('hidden.bs.modal', function () { if (dirty) location.reload(); });
        document.addEventListener('click', function (e) {
            var o = e.target.closest('[data-careplan]');
            if (o) { adm = Number(o.getAttribute('data-careplan')); dirty = false; tab = '#cpPlan'; mEl.querySelector('[data-care-who]').textContent = o.getAttribute('data-who') || '';
                body.innerHTML = '<div class="text-muted fs-7 py-8 text-center">…</div>'; load(); bootstrap.Modal.getOrCreateInstance(mEl).show(); return; }
            if (!mEl.contains(e.target)) return;
            var u = e.target.closest('[data-cp-use]'); if (u) { fill(u.getAttribute('data-cp-use')); mEl.querySelector('[data-cp="goal"]').focus(); return; }
            var s = e.target.closest('[data-cp-save]');
            if (s) { var f = { admissionId: adm }; mEl.querySelectorAll('[data-cp]').forEach(function (i) { f[i.getAttribute('data-cp')] = i.value.trim() || null; });
                cbConfirm(W.addPlan).then(function (ok) { if (ok) post(base + 'CarePlan', f).then(done); }); return; }
            var c = e.target.closest('[data-cp-close]');
            if (c) { cbPrompt(c.getAttribute('data-what') || '', { title: W.closeTitle, placeholder: W.outcome, textarea: true }).then(function (why) { if (!why) return;
                post(base + 'CarePlan/' + c.getAttribute('data-cp-close') + '/Close', { status: c.getAttribute('data-status'), outcome: why }).then(done); }); return; }
            var p = e.target.closest('[data-pb-save]');
            if (p) { var g = { admissionId: adm }; mEl.querySelectorAll('[data-pb]').forEach(function (i) { var v = window.jQuery && i.tagName === 'SELECT' && i.getAttribute('data-pb') === 'code' ? jQuery(i).val() : i.value; g[i.getAttribute('data-pb')] = (v || '').trim() || null; });
                tab = '#cpProblems'; cbConfirm(W.addProblem).then(function (ok) { if (ok) post(base + 'Problems', g).then(done); }); return; }
            var r = e.target.closest('[data-pb-resolve]');
            if (r) { tab = '#cpProblems'; cbConfirm(W.resolve + '\n' + (r.getAttribute('data-what') || '')).then(function (ok) { if (ok) post(base + 'Problems/' + r.getAttribute('data-pb-resolve') + '/Resolve').then(done); }); }
        });
    })();
</script>
}
