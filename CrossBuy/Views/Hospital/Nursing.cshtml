                    if (!nm || !why) { toast('error', W.outsideNeeds); return; }
                    body.drug = nm; body.itemId = null; body.note = why + (body.note ? ' · ' + body.note : '');
                } else if (!body.itemId) { toast('error', W.pickMed); return; }
                cbConfirm(W.order.replace('{0}', (body.drug || '') + ' ' + (body.dose || '')).replace('{1}', orderFor.who)).then(function (ok) { if (!ok) return; btn.disabled = true; placeOrder(body, btn); });
