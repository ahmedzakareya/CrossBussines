                c.checked = false;
                cbConfirm(W.done.replace('{0}', c.getAttribute('data-what'))).then(function (ok) { if (!ok) return; c.disabled = true; post(root + '/Task/' + c.getAttribute('data-task-done') + '/Done').then(done(null)); });
            });
            dEl.querySelector('[data-d-save]').addEventListener('click', function (e) {
                var btn = e.currentTarget, status = (dEl.querySelector('[name=d-status]:checked') || {}).value, label = dEl.querySelector('[name=d-status]:checked').nextElementSibling.textContent.trim();
                var w = dEl.querySelector('[data-d-witness]').value;
                var body = { orderId: dose.orderId, dueAt: dose.dueAt, status: status, reason: dEl.querySelector('[data-d-reason]').value.trim() || null, witnessEmployeeId: w ? Number(w) : null,
                    wristband: dEl.querySelector('[data-d-wrist]').value.trim() || null, pack: dEl.querySelector('[data-d-pack]').value.trim() || null, scanOverride: dEl.querySelector('[data-d-override]').value.trim() || null };
                cbConfirm(W.record.replace('{0}', dose.what).replace('{1}', label), { kind: status === 'Given' ? 'primary' : 'danger' }).then(function (ok) { if (!ok) return; btn.disabled = true; post(root + '/Record', body).then(done(btn, dEl)); });
            });
            // H73: an order that meets a stopping alert (a contraindication, a major interaction, a dose above its limit)
            // comes back; the doctor reads the alerts and writes why it is still right, and the order goes again with it.
            // A moderate interaction comes back with the saved order and is shown, never stopping it.
            var WA = { why: @Json.Serialize(T["Write why this order is still right (it is kept with the order)"].Value), go: @Json.Serialize(T["Order anyway"].Value) };
            function placeOrder(body, btn) {
                post(root + '/Order', body).then(function (res) {
                    if (!res.ok && res.code === 'clinical_alert') {
                        btn.disabled = false;
                        var list = (res.alerts || []).map(function (a) { return '• [' + a.severityText + '] ' + a.text; }).join('   ');
                        cbPrompt(list + '   — ' + WA.why, { kind: 'danger', textarea: true, title: res.error, ok: WA.go }).then(function (why) {
