@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalConceptRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    bool canManage = ViewBag.CanManage == true;
    var rangeCounts = ViewBag.RangeCounts as Dictionary<int, int> ?? new();   // H115
}
@foreach (var r in Model)
{
    var c = r.Concept; bool calc = c.ValueType is HospitalConceptType.Calculated or HospitalConceptType.Score;
    var used = isAr ? r.UsedBy : r.UsedByEn;
    @* H127: the theme's table rows (demo39 widgets/tables) *@
    <tr class="@(c.IsActive ? "" : "opacity-50")">
        <td class="ps-4"><span class="badge badge-light-primary fw-bold fs-7 hp-num" dir="ltr">@c.Code</span><span class="text-gray-500 fw-semibold d-block fs-8 mt-1" dir="ltr">@c.CodeSystem</span></td>
        <td><span class="text-gray-900 fw-bold fs-6 d-block">@(isAr ? c.Name : c.NameEn)</span>@if (!c.IsActive) {<span class="badge badge-light fs-8 fw-bold mt-1">@T["Inactive"]</span>}</td>
        <td><span class="badge badge-light-@(calc ? "primary" : "secondary") fw-bold fs-7">@T["ctype:" + c.ValueType]</span></td>
        <td class="text-nowrap"><span class="text-gray-800 fw-semibold fs-7 hp-num" dir="ltr">@(c.Unit ?? "—")</span></td>
        <td class="text-nowrap"><span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@HospitalConceptRules.NormalDisplay(c, isAr)</span>@if (rangeCounts.TryGetValue(c.ID, out var rn)) {<span class="text-primary fw-semibold d-block fs-8 mt-1">@T["+{0} by patient", rn]</span>}</td>
        <td class="text-nowrap"><span class="badge badge-light-danger fs-7 fw-bold hp-num" dir="ltr">@HospitalConceptRules.CriticalDisplay(c, isAr)</span></td>
        <td>@if (c.HasLaterality) {<span class="badge badge-light-info fw-bold fs-7">@T["Right / left"]</span>} else {<span class="text-gray-400">—</span>}</td>
        <td class="mw-200px"><span class="text-gray-600 fw-semibold fs-7">@(used.Count == 0 ? "—" : string.Join(" · ", used))</span></td>
        <td class="text-end text-nowrap pe-4">@if (c.ValueType is HospitalConceptType.Number or HospitalConceptType.Score or HospitalConceptType.Panel) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" data-ranges="@c.ID" data-pair="@(c.ValueType == HospitalConceptType.Panel ? "1" : "")" data-name="@(isAr ? c.Name : c.NameEn)" data-unit="@c.Unit" title="@T["Ranges by patient"]" data-bs-toggle="tooltip"><i class="ki-outline ki-people fs-3"></i></button>}@if (canManage) {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" data-edit="@c.ID" title="@T["Edit"]" data-bs-toggle="tooltip"><i class="ki-outline ki-pencil fs-3"></i></button>}</td>
    </tr>
}
