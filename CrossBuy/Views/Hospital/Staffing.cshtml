@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalAcuityBoard
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H246 — acuity-based staffing for a day and shift: per ward the patients by level, the nurses needed and planned;
    per patient the classification (factors → level). An unclassified patient counts as moderate. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Acuity staffing"].Value;
    string q = ViewBag.Q as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages; bool canAdmit = ViewBag.CanAdmit == true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string dayS = Model.Day.ToString("yyyy-MM-dd", inv);
    string Link(int p, string? sh = null, DateTime? d = null) => Url.Action("Staffing", new { day = (d ?? Model.Day).ToString("yyyy-MM-dd", inv), shift = sh ?? Model.Shift, q, page = p })!;
    string LTone(int l) => l switch { 4 => "danger", 3 => "info", _ => "primary" };
    string GTone(string g) => g switch { "Short" => "danger", "Unplanned" => "info", _ => "primary" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Acuity staffing"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Inpatient"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["Acuity staffing"]</li></ul>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Link(1, null, Model.Day.AddDays(-1))" class="btn btn-sm btn-icon btn-light"><i class="ki-outline @(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "ki-arrow-right" : "ki-arrow-left") fs-4"></i></a>
            <span class="fw-bold hp-num px-2" dir="ltr">@Model.Day.ToString("dd/MM/yyyy", inv)</span>
            <a href="@Link(1, null, Model.Day.AddDays(1))" class="btn btn-sm btn-icon btn-light"><i class="ki-outline @(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "ki-arrow-left" : "ki-arrow-right") fs-4"></i></a>
            @foreach (var s in HospitalShift.All) {<a href="@Link(1, s)" class="btn btn-sm @(Model.Shift == s ? "btn-primary" : "btn-light")">@T["shift:" + s]</a>}
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalAcuityService.NoTables]</div></div>
        }
        <div class="card card-flush mb-5">
            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Wards this shift"]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Nurses needed from the patients' care hours (8-hour shift); an unclassified patient counts as moderate"]</span></h3></div>
            <div class="card-body pt-2">
                @if (Model.Wards.Count == 0) {<div class="text-muted fs-7 py-4">@T["No inpatient here."]</div>}
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th>@T["Ward"]</th><th>@T["Patients"]</th><th class="min-w-200px">@T["By level"]</th><th>@T["Needed"]</th><th>@T["Planned"]</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var w in Model.Wards)
                        {
                            <tr>
                                <td class="fw-bold">@DisplayName.Of(w.Name, w.NameEn)</td>
                                <td class="hp-num">@w.Patients <span class="text-muted fs-8">(@T["{0} classified", w.Classified])</span></td>
                                <td>@for (int l = 1; l <= 4; l++) {<span class="badge badge-light-@LTone(l) fs-8 me-1 hp-num" title="@T["lvl:" + l]" data-bs-toggle="tooltip">L@l · @w.ByLevel[l]</span>}</td>
                                <td class="fw-bold fs-5 hp-num">@w.Needed</td>
                                <td>@if (canAdmit && Model.Ready && w.WardId is int wid)
                                    {<input type="number" min="0" max="100" class="form-control form-control-sm form-control-solid w-75px hp-num d-inline-block" value="@w.Planned" data-plan="@wid" />}
                                    else {<span class="hp-num">@(w.Planned?.ToString(inv) ?? "—")</span>}</td>
                                <td><span class="badge badge-light-@GTone(w.Gap) fs-7">@T["gap:" + w.Gap]</span></td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Patients"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Unclassified first"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("Staffing")">
                    <input type="hidden" name="day" value="@dayS" /><input type="hidden" name="shift" value="@Model.Shift" />
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search a patient, bed or ward"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Patients.Count == 0) {<div class="text-center py-15"><div class="text-gray-600 fw-semibold fs-6">@T["No inpatient here."]</div></div>}
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th>@T["Bed"]</th><th>@T["Level"]</th><th class="min-w-200px">@T["Care factors"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.Patients)
                        {
                            var s = p.Score; var fs = (s?.Factors ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <tr>
                                <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(p.Photo, DisplayName.Of(p.Name, p.NameEn), 35)<a href="@Url.Action("Patient", new { id = p.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(p.Name, p.NameEn)</a></div></td>
                                <td><span class="fw-bold hp-num" dir="ltr">@p.Bed</span>@if (p.Ward != null) {<div class="text-muted fs-8">@DisplayName.Of(p.Ward, p.WardEn)</div>}</td>
                                <td>@if (s != null) {<span class="badge badge-light-@LTone(s.Level) fs-7">@T["lvl:" + s.Level]</span>} else {<span class="badge badge-light fs-8">@T["Not classified"]</span>}</td>
                                <td class="fs-8">@foreach (var f in fs) {var def = HospitalAcuityRules.Factors.FirstOrDefault(x => x.Code == f); if (def != null) {<span class="badge badge-light fs-8 me-1 mb-1">@DisplayName.Of(def.Ar, def.En)</span>}}</td>
                                <td class="text-end">@if (canAdmit && Model.Ready) {<button type="button" class="btn btn-sm btn-light-primary" data-acu="@p.AdmissionId" data-name="@DisplayName.Of(p.Name, p.NameEn)" data-f="@s?.Factors">@(s == null ? T["Classify"] : T["Change"])</button>}</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

@if (canAdmit && Model.Ready)
{
<div class="modal fade" id="acuModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3">@T["Classify the patient"]</h1><div class="text-muted fw-semibold fs-6" data-acu-name></div></div>
        <div class="d-flex flex-column gap-3">
            @foreach (var f in HospitalAcuityRules.Factors) {<label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" value="@f.Code" data-acu-f /><span class="form-check-label fw-semibold text-gray-700">@DisplayName.Of(f.Ar, f.En) <span class="text-muted fs-8 hp-num">(+@f.Points)</span></span></label>}
        </div>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-acu-save>@T["Save"]</button></div>
    </div>
</div></div></div>
}
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Staffing/"));
            var ctx = { day: @Json.Serialize(dayS), shift: @Json.Serialize(Model.Shift) }, W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value) }, m = document.getElementById('acuModal'), id = 0;
            function post(u, b) { return fetch(root + u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            document.querySelectorAll('[data-plan]').forEach(function (el) {
                el.addEventListener('change', function () {
                    post('Plan/' + el.getAttribute('data-plan'), { day: ctx.day, shift: ctx.shift, nurses: el.value === '' ? 0 : +el.value }).then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
                });
            });
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-acu],[data-acu-save]'); if (!t) return;
                if (t.hasAttribute('data-acu')) {
                    id = +t.getAttribute('data-acu'); m.querySelector('[data-acu-name]').textContent = t.getAttribute('data-name');
                    var fs = (t.getAttribute('data-f') || '').split(','); m.querySelectorAll('[data-acu-f]').forEach(function (c) { c.checked = fs.indexOf(c.value) >= 0; });
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                var f = []; m.querySelectorAll('[data-acu-f]:checked').forEach(function (c) { f.push(c.value); });
                post('Classify/' + id, { day: ctx.day, shift: ctx.shift, factors: f }).then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
            });
        })();
    </script>
}
