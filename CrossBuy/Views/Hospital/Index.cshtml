@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalFloorView>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Beds & rooms"].Value;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    bool canManage = ViewBag.CanManage == true;
    bool canAdmit = ViewBag.CanAdmit == true;
    var occupants = (ViewBag.Occupants as Dictionary<int, HospitalOccupantView>) ?? new();
    var currency = ViewBag.Currency as HospitalCurrency;
    string Money(decimal v) => currency == null ? v.ToString("N2") : currency.Format(v);
    var rooms = Model.SelectMany(f => f.Rooms).ToList();
    var beds = rooms.SelectMany(r => r.Beds).ToList();
    int Count(string s) => beds.Count(b => b.Status == s);
    int occupancy = beds.Count == 0 ? 0 : (int)Math.Round(Count(HospitalBedStatus.Occupied) * 100.0 / beds.Count);
    var types = rooms.Where(r => r.Type != null).Select(r => r.Type!).GroupBy(t => t.ID).Select(g => g.First())
        .ToDictionary(t => t.ID, t => new { features = (t.Features ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries), beds = t.BedCount });
    var planData = rooms.ToDictionary(r => r.Id, r => new { id = r.Id, kind = r.Kind, layout = r.LayoutJson, typeId = r.Type?.ID, beds = r.Beds.Select(b => new { id = b.Id, code = b.Code, status = b.Status, patient = HospitalPlanPatient.Of(occupants, b.Id) }) });
}
@* _LayoutBackend renders no Styles section, so the module stylesheet rides in the body. *@
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Beds & rooms"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Hospital"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Beds & rooms"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("RoomTypes")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-element-11 fs-4"></i>@T["Room types"]</a>
            @if (canAdmit && rooms.Count > 0)
            {
                <button type="button" class="btn btn-sm btn-primary" data-admit-open><i class="ki-outline ki-entrance-left fs-4"></i>@T["Accommodate a patient"]</button>
            }
            @if (canManage)
            {
                <a href="@Url.Action("Designer")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-pencil fs-4"></i>@T["Floor & room designer"]</a>
            }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Rooms / beds"].Value, $"{rooms.Count(r => r.Beds.Count > 0)} / {beds.Count}", T.GetString("across {0} floors", Model.Count).Value, "text-gray-900"),
                (T["Occupied"].Value, Count(HospitalBedStatus.Occupied).ToString(), T.GetString("{0}% occupancy", occupancy).Value, "text-primary"),
                (T["Available now"].Value, Count(HospitalBedStatus.Vacant).ToString(), T.GetString("{0} being cleaned", Count(HospitalBedStatus.Cleaning)).Value, "text-success"),
                (T["Reserved or blocked"].Value, (Count(HospitalBedStatus.Reserved) + Count(HospitalBedStatus.Blocked)).ToString(), T["not available to accommodate"].Value, "text-gray-900") })
            {
                <div class="col-sm-6 col-xl-3">
                    <div class="card card-flush h-100"><div class="card-body py-5">
                        <div class="text-muted fw-semibold fs-7 mb-1">@s.Item1</div>
                        <div class="fs-2hx fw-bold @s.Item4 hp-num">@s.Item2</div>
                        <div class="text-muted fs-8 mt-1">@s.Item3</div>
                    </div></div>
                </div>
            }
        </div>

        @if (Model.Count == 0)
        {
            <div class="notice d-flex rounded border border-dashed p-6 mb-5 hp-notice">
                <span class="symbol symbol-45px me-5 flex-shrink-0"><span class="symbol-label"><i class="ki-outline ki-home-3 fs-2x text-white"></i></span></span>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap">
                    <div class="mb-3 mb-md-0 fw-semibold pe-5">
                        <h4 class="text-gray-900 fw-bold mb-1">@T["The building has not been drawn yet"]</h4>
                        <div class="fs-6 text-gray-700">@T["Add the floors and rooms in the designer; they appear here with their beds at once."]</div>
                    </div>
                    @if (canManage)
                    {
                        <a href="@Url.Action("Designer")" class="btn btn-sm btn-primary flex-shrink-0">@T["Open the designer"]</a>
                    }
                </div>
            </div>
        }

        <div class="d-flex flex-wrap gap-5 mb-5">
            @foreach (var st in HospitalBedStatus.All)
            {
                <span class="d-inline-flex align-items-center gap-2 fs-7 fw-semibold text-gray-700"><span class="hp-bed hp-legend @st"></span>@T[st]</span>
            }
        </div>

        @foreach (var floor in Model)
        {
            var groups = floor.Rooms.Where(r => r.Beds.Count > 0).GroupBy(r => r.WardId).ToList();
            if (groups.Count == 0) { continue; }
            <div class="card mb-5 mb-xl-8">
                <div class="card-header border-0 pt-6">
                    <div class="card-title align-items-start flex-column m-0">
                        <span class="card-label fw-bold text-gray-900 fs-4">@(isAr ? floor.Name : DisplayName.Or(floor.NameEn, floor.Name))</span>
                        <span class="text-muted mt-1 fw-semibold fs-7"><span class="hp-num">@floor.Rooms.Sum(r => r.Beds.Count(b => b.Status == HospitalBedStatus.Occupied)) / @floor.Rooms.Sum(r => r.Beds.Count)</span> @T["beds occupied"]</span>
                    </div>
                </div>
                <div class="card-body pt-4">
                    @foreach (var g in groups)
                    {
                        var ward = floor.Wards.FirstOrDefault(w => w.Id == g.Key);
                        if (ward != null)
                        {
                            <div class="d-flex align-items-center gap-3 mb-4 mt-2">
                                <span class="fw-bold fs-5 text-gray-800">@(isAr ? ward.Name : DisplayName.Or(ward.NameEn, ward.Name))</span>
                                @if (ward.SexPolicy != HospitalSexPolicy.Any) { <span class="badge badge-light-primary fs-8">@T[ward.SexPolicy]</span> }
                            </div>
                        }
                        <div class="row g-5 mb-6">
                            @foreach (var r in g)
                            {
                                var type = r.Type;
                                <div class="@(r.Beds.Count >= 4 ? "col-xl-6" : "col-md-6 col-xl-3")">
                                    <div class="card h-100"><div class="card-body p-5">
                                        <div class="d-flex flex-stack mb-1">
                                            <a href="@Url.Action("Room", new { id = r.Id })" class="fw-bold fs-4 text-gray-900 text-hover-primary">@T["Room"] <span class="hp-num">@r.Number</span></a>
                                            @if (type != null) { <span class="badge hp-badge fs-8">@(isAr ? type.Name : DisplayName.Or(type.NameEn, type.Name))</span> }
                                        </div>
                                        <div class="d-flex flex-wrap gap-3 text-muted fs-8 fw-semibold mb-4">
                                            <span><span class="hp-num text-gray-800 fw-bold" data-occ="@r.Id">@r.Beds.Count(b => b.Status == HospitalBedStatus.Occupied) / @r.Beds.Count</span> @T["occupied (count)"]</span>
                                            @if (type != null) { <span><span class="hp-num">@Money(type.DailyRate)</span> @currency?.Label(isAr) @T["per day"]</span> }
                                        </div>
                                        <div data-plan="@r.Id"></div>
                                    </div></div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <partial name="_HospitalScripts" />
    <partial name="_HospitalAdmit" />
    <script>
        (function () {
            var rooms = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(planData));
            var types = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(types));
            var canAdmit = @Json.Serialize(canAdmit);
            function draw() {
                document.querySelectorAll('[data-plan]').forEach(function (el) {
                    var r = rooms[el.getAttribute('data-plan')]; if (!r) return;
                    el.innerHTML = HospitalPlan.render(r, types[r.typeId], { onBed: true });
                    var occ = document.querySelector('[data-occ="' + r.id + '"]');
                    if (occ) occ.textContent = r.beds.filter(function (b) { return b.status === 'Occupied'; }).length + ' / ' + r.beds.length;
                });
            }
            // A bed opens its window: who lies in it, or "accommodate a patient here".
            document.addEventListener('click', function (e) {
                var b = e.target.closest('[data-plan] [data-bed]'); if (!b) return;
                e.preventDefault(); HospitalAdmit.bed(+b.getAttribute('data-bed'), canAdmit);
            });
            var openBtn = document.querySelector('[data-admit-open]');
            if (openBtn) openBtn.addEventListener('click', function () { HospitalAdmit.open(); });
            // After admit / transfer / discharge: redraw from the fresh building, no reload.
            HospitalAdmit.onChange(function () {
                var b = HospitalAdmit.building(); if (!b) return;
                b.floors.forEach(function (f) { f.rooms.forEach(function (r) { if (rooms[r.id]) rooms[r.id].beds = r.beds; }); });
                draw();
                var all = []; Object.keys(rooms).forEach(function (k) { all = all.concat(rooms[k].beds); });
                var n = function (s) { return all.filter(function (x) { return x.status === s; }).length; };
                var cards = document.querySelectorAll('.app-content .row.mb-5 .fs-2hx');
                if (cards.length >= 4) { cards[1].textContent = n('Occupied'); cards[2].textContent = n('Vacant'); cards[3].textContent = n('Reserved') + n('Blocked'); }
            });
            draw();
        })();
    </script>
}
