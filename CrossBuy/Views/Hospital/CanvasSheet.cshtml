@using System.Globalization
@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalCanvasPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H99 — one drawing of a visit (the approved prototype screens cv-body and cv-fundus).
    Body map: coded marks on the front and back figures, free ink on top, marks carried from the last visit shown grey
    until the doctor confirms them, a photo per mark, compare with the last visit. Fundus: the CMS colour code is
    enforced — the finding sets the colour — and every mark is written with its SNOMED code, eye, zone and clock hour.
    The drawing is saved as the visit's draft and signed with the visit.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    bool isAr = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var e = Model.Visit.Encounter; var p = Model.Patient; bool canEdit = Model.CanEdit; bool ready = ViewBag.Ready ?? true;
    var name = DisplayName.Of(p.Name, p.NameEn);
    bool body = Model.Kind == HospitalCanvasKind.Body, burn = Model.Kind == HospitalCanvasKind.Burn, audio = Model.Kind == HospitalCanvasKind.Audio, joints = Model.Kind == HospitalCanvasKind.Joints, pedigree = Model.Kind == HospitalCanvasKind.Pedigree;
    string title = body ? T["Body map"].Value : burn ? T["Burn chart"].Value : audio ? T["Audiogram"].Value : joints ? T["Rheumatoid joints — DAS28"].Value : pedigree ? T["Pedigree"].Value : T["Fundus drawing"].Value;
    var treeNow = pedigree ? HospitalPedigreeRules.Read(Model.Sheet?.StateJson, p.Sex).Result : null;
    var dasNow = joints ? HospitalDas28Rules.Read(Model.Sheet?.StateJson).Result : null;
    var audioNow = audio ? HospitalAudioRules.Read(Model.Sheet?.StateJson).Result : null;
    // H100: the burn chart reads its depths and weight back; the shares follow the patient's age (Lund–Browder under 15)
    int? ageYears = HospitalPatientService.AgeOn(p.BirthDate, e.StartedAt);
    var burnLimits = (ViewBag.BurnLimits as HospitalBurnThresholds) ?? new HospitalBurnThresholds();   // H172: the clinic's approved thresholds
    var burnNow = burn ? HospitalBurnRules.Read(Model.Sheet?.StateJson, ageYears, burnLimits).Result : null;
    decimal? burnKg = burnNow?.Kg ?? e.WeightKg;
    string[] depthCol = { "#F6E7DD", "#FCA5A5", "#EF4444", "#7F1D1D" };
    string[] depthKey = { "No burn", "Superficial partial", "Deep partial", "Full thickness" };
    ViewData["Title"] = title + " — " + name;
    var findings = HospitalCanvasRules.FindingsOf(Model.Kind);
    string D(decimal? d) => d?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";
    // H112: what the patient drew of their pain on the tablet — a separate, patient-reported layer
    var pain = body ? Model.PatientPain : null;
    // H113: a mark's measure on its photo, read again from its own points; the consent its photo was taken under
    object? Measured(HospitalCanvasMark m)
    {
        if (HospitalPhotoMeasureRules.Read(m.MeasureJson) is not { } r) return null;
        var i = System.Text.Json.JsonSerializer.Deserialize<HospitalPhotoMeasureInput>(m.MeasureJson!, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })!;
        return new { ruler = i.Ruler, rulerMm = i.RulerMm, length = i.Length, width = i.Width, l = r.LengthMm, w = r.WidthMm, pm = r.PlusMinusMm };
    }
    object? ConsentOf(HospitalCanvasMark m) => m.PhotoConsentId is int c && Model.MarkConsents != null && Model.MarkConsents.TryGetValue(c, out var v) ? new { no = v.No, scope = v.Scope, wd = v.Withdrawn } : null;
    // H110/H127: this measure on earlier signed visits (stored as observations, so it trends) — the theme's list-widget rows
    void Earlier()
    {
        if (Model.History is not { Count: > 0 } hx) return;
        var rows = hx.Take(8).ToList();
        <div class="separator separator-dashed my-5"></div>
        <div class="text-gray-800 fw-bold fs-6 mb-4">@T["Earlier results"]</div>
        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            <div class="d-flex flex-stack">
                <div class="d-flex align-items-center me-3">
                    <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-chart-line fs-3 text-primary"></i></span></div>
                    <div><span class="text-gray-800 fw-bold fs-6 hp-num" dir="ltr">@r.At.ToLocalTime().ToString("yyyy-MM-dd")</span>
                        @if (r.Side == "R" || r.Side == "L") {<span class="text-gray-500 fw-semibold fs-7 d-block">@(r.Side == "R" ? T["right ear"] : T["left ear"])</span>}</div>
                </div>
                <span class="badge badge-light-primary fs-7 fw-bold hp-num" dir="ltr">@r.Value.ToString("0.##", CultureInfo.InvariantCulture)@(r.Code == "TBSA" ? "%" : r.Code == "PTA" ? " dB" : "")</span>
            </div>
            if (i < rows.Count - 1) {<div class="separator separator-dashed my-3"></div>}
        }
    }
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
<style>
    .cv-wrap { position: relative; background: var(--bs-body-bg); border: 1px dashed var(--bs-gray-300); border-radius: .75rem; touch-action: none; user-select: none; }
    .cv-wrap svg { display: block; width: 100%; height: auto; direction: ltr; }
    /* H127: the drawing tools as the theme's light buttons (demo39 btn-light / btn-light-primary when chosen) */
    .cv-tools { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .cv-tool { border: 1px solid transparent; background: var(--bs-gray-100); color: var(--bs-gray-700); border-radius: .475rem; padding: .55rem 1rem; font-size: .925rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: background-color .15s, color .15s; }
    .cv-tool:hover { color: var(--bs-primary); }
    .cv-tool.on { background: var(--bs-primary-light); color: var(--bs-primary); border-color: var(--bs-primary); }
    .cv-tool.on i { color: var(--bs-primary); }
    .cv-sw { width: 14px; height: 14px; border-radius: 50%; display: inline-block; border: 1px solid rgba(0,0,0,.15); flex: 0 0 14px; }
    /* the marks list: the theme's list-widget rows (demo39 widgets/lists) */
    .cv-mark { display: flex; align-items: center; gap: 12px; padding: 12px 8px; border-bottom: 1px dashed var(--bs-gray-300); border-radius: .475rem; cursor: pointer; }
    .cv-mark:last-child { border-bottom: 0; }
    .cv-mark:hover { background: var(--bs-gray-100); }
    .cv-mark.sel { background: var(--bs-primary-light); }
    .cv-skin { fill: #F6E7DD; stroke: #C9A68F; stroke-width: 1.5; }
</style>
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@title</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("CanvasHome")" class="text-muted text-hover-primary">@T["Clinical canvas"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("SpecialtyVisit", new { id = e.ID })" class="text-muted text-hover-primary">@T["The visit"]</a></li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@(body ? T["Body map"] : burn ? T["Burns"] : audio ? T["Audiogram"] : joints ? T["DAS28"] : pedigree ? T["Pedigree"] : T["Fundus"])</li>
            </ul>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (body)
            {
                if (canEdit) {<button type="button" class="btn btn-sm btn-light" data-photo-btn><i class="ki-outline ki-picture fs-4"></i>@T["Attach a photo to a mark"]</button>}
                <button type="button" class="btn btn-sm btn-light" data-compare @(Model.Last.Count == 0 ? "disabled" : "")><i class="ki-outline ki-switch fs-4"></i>@T["Compare with last visit"]</button>
                @if (canEdit || (pain != null && pain.Sheet.Status != HospitalCanvasStatus.Signed))
                {
                    <a class="btn btn-sm btn-light-primary" href="@Url.Action("CanvasPatient", new { id = e.ID })"><i class="ki-outline ki-tablet fs-4"></i>@T["Patient mode — hand the tablet over"]</a>
                }
            }
            @if (canEdit)
            {
                <span class="text-muted fs-8 align-self-center" id="saveState"></span>
                <button type="button" class="btn btn-sm btn-primary" data-save><i class="ki-outline ki-check fs-4"></i>@(body ? T["Save this visit's version"] : T["Save the drawing to the visit"])</button>
            }
            else if (Model.Sheet?.Status == HospitalCanvasStatus.Signed)
            {
                <span class="badge badge-light-success fs-7 px-4 py-3"><i class="ki-outline ki-check-circle fs-5 text-success me-1"></i>@T["Signed"]</span>
                @* H111: the signed drawing's paper — through Report Studio only *@
                @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalCanvasSheet, DocumentId = Model.Sheet.ID.ToString(), DocumentTitle = title })
            }
        </div>
    </div></div>
    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready)
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5"><i class="ki-outline ki-information fs-2tx text-primary me-4"></i><div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["The clinical canvas is not installed yet (hospital_h99_canvas.sql)."]</h4></div></div>
        }
        else if (body)
        {
            <div class="row g-5">
                <div class="col-xl-8">
                    @if (canEdit && Model.PhotoConsent == null)
                    {
                        <div class="notice d-flex align-items-center rounded border border-primary border-dashed bg-light-primary p-5 mb-5">
                            <i class="ki-outline ki-picture fs-2tx text-primary me-4"></i>
                            <div class="flex-grow-1 fw-semibold"><div class="fs-6 text-gray-900 fw-bold">@T["No photography consent on file"]</div><div class="fs-7 text-gray-700">@T["A photo of a mark is taken only under the patient's signed photography consent, within its scope."]</div></div>
                            <a class="btn btn-sm btn-primary ms-4" href="@Url.Action("NewConsent", new { id = p.ID, kind = HospitalConsentKind.Photography })"><i class="ki-outline ki-notepad-edit fs-4"></i>@T["Record the photography consent"]</a>
                        </div>
                    }
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@T["Body map — {0}", name]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Choose \"mark\" and tap the body; or \"pen\" and draw freely. Grey marks are carried from the last visit, not yet verified."]</span></h3>
                        @if (Model.PhotoConsent is { } pcn)
                        {
                            <div class="card-toolbar"><span class="badge badge-light-success fs-7 fw-bold py-3 px-4"><i class="ki-outline ki-shield-tick fs-5 text-success me-2"></i>@T["Photos under consent {0} — {1}", pcn.No, T["photo-scope-short:" + pcn.Scope].Value]</span></div>
                        }</div>
                        <div class="card-body pt-3">
                            @if (canEdit)
                            {
                                <div class="cv-tools" id="bm_tools">
                                    <button type="button" class="cv-tool on" data-k="mark"><i class="ki-outline ki-geolocation fs-5"></i>@T["Coded mark"]</button>
                                    <button type="button" class="cv-tool" data-k="pen"><i class="ki-outline ki-pencil fs-5"></i>@T["Free pen"]</button>
                                    <button type="button" class="cv-tool" data-k="undo"><i class="ki-outline ki-arrow-circle-left fs-5"></i>@T["Undo"]</button>
                                </div>
                            }
                            <div class="cv-wrap" id="cv_wrap"><svg id="cv" viewBox="0 0 440 460">
                                @foreach (var (ox, lbl) in new[] { (0, T["Front view"].Value), (230, T["Back view"].Value) })
                                {
                                    <g transform="translate(@ox,0)">
                                        <ellipse cx="100" cy="34" rx="24" ry="28" class="cv-skin" /><rect x="90" y="58" width="20" height="14" class="cv-skin" />
                                        <path d="M62 74 Q100 64 138 74 L136 206 Q100 214 64 206 Z" class="cv-skin" />
                                        <path d="M62 76 L40 90 L24 210 L38 214 L54 110 L62 104 Z" class="cv-skin" /><path d="M138 76 L160 90 L176 210 L162 214 L146 110 L138 104 Z" class="cv-skin" />
                                        <path d="M64 206 L98 214 L96 428 L72 430 L66 300 Z" class="cv-skin" /><path d="M136 206 L102 214 L104 428 L128 430 L134 300 Z" class="cv-skin" />
                                        <text x="100" y="452" text-anchor="middle" font-size="13" fill="#6B7280">@lbl</text>
                                    </g>
                                }
                                <g id="cv_prev"></g>
                                @if (pain != null)
                                {
                                    <g id="cv_pat" opacity=".55">
                                        @foreach (var st in System.Text.Json.JsonDocument.Parse(string.IsNullOrEmpty(pain.Sheet.InkJson) ? "[]" : pain.Sheet.InkJson).RootElement.EnumerateArray())
                                        {
                                            <polyline fill="none" stroke="#DC2626" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="@string.Join(" ", st.GetProperty("p").EnumerateArray().Select(q => q[0].GetDecimal().ToString("0.#", CultureInfo.InvariantCulture) + "," + q[1].GetDecimal().ToString("0.#", CultureInfo.InvariantCulture)))" />
                                        }
                                        @foreach (var m in pain.Marks)
                                        {
                                            <circle cx="@D(m.X)" cy="@D(m.Y)" r="14" fill="#DC2626" fill-opacity=".35" stroke="#DC2626" stroke-width="1.5" stroke-dasharray="4 3" />
                                        }
                                    </g>
                                }
                                <g id="cv_ink"></g><g id="cv_marks"></g>
                            </svg></div>
                        </div></div>
                </div>
                <div class="col-xl-4">
                    @if (canEdit)
                    {
                        <div class="card card-flush mb-5"><div class="card-header pt-5 flex-nowrap gap-3"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Next mark"]</span></h3>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-primary"><i class="ki-outline ki-geolocation fs-2x text-primary"></i></span></div></div></div>
                            <div class="card-body pt-2"><div class="row g-4">
                                <div class="col-7 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Mark type"]</label>
                                    <select class="form-select form-select-solid" id="bm_type" data-control="select2" data-hide-search="true">
                                        @foreach (var f in findings) {<option value="@f.Key">@(isAr ? f.Ar : f.En)</option>}
                                    </select></div>
                                <div class="col-5 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Size mm"]</label><input type="number" min="0" max="500" step="0.5" class="form-control form-control-solid" dir="ltr" id="bm_size" value="4" /></div>
                            </div></div></div>
                    }
                    @if (pain != null)
                    {
                        var painPlaces = pain.Marks.Select(m => HospitalCanvasRules.BodyRegions.FirstOrDefault(r => r.Key == m.Region) is { } r ? (isAr ? r.Ar : r.En) + " — " + (m.Side == "B" ? T["back side"].Value : T["front side"].Value) : m.Region ?? "").Distinct().ToList();
                        <div class="card card-flush mb-5 border border-danger border-dashed"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-gray-800"><i class="ki-outline ki-user fs-3 text-danger me-1"></i>@T["From the patient"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Patient-reported on the tablet — kept apart from your marks"]</span></h3>
                            <div class="card-toolbar gap-2"><button type="button" class="btn btn-sm btn-light" data-pat-toggle><i class="ki-outline ki-eye fs-5"></i>@T["Show on the figures"]</button>
                                @if (pain.Sheet.Status == HospitalCanvasStatus.Signed)
                                {
                                    @* the patient's signed drawing has its own paper, apart from the body map's *@
                                    @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalCanvasSheet, DocumentId = pain.Sheet.ID.ToString(), DocumentTitle = T["From the patient"].Value })
                                }
                            </div></div>
                            <div class="card-body pt-2">
                                @* H127: the patient's answers as the theme's list-widget rows *@
                                <div class="d-flex flex-stack">
                                    <div class="d-flex align-items-center me-3">
                                        <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-chart-simple fs-3 text-danger"></i></span></div>
                                        <span class="text-gray-800 fw-bold fs-6">@T["Pain now"]</span>
                                    </div>
                                    @if (pain.Report.Nrs is int n)
                                    {
                                        <span class="badge fs-5 fw-bold px-4 py-2 text-white hp-num" style="background:@(n >= 7 ? "#DC2626" : n >= 4 ? "#7239EA" : "#3A5795")">@T["{0} out of 10", n]</span>
                                    }
                                    else {<span class="text-muted">—</span>}
                                </div>
                                @if (pain.Report.Words.Count > 0)
                                {
                                    <div class="separator separator-dashed my-3"></div>
                                    <div class="d-flex align-items-center">
                                        <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-message-text fs-3 text-danger"></i></span></div>
                                        <div class="d-flex flex-wrap gap-2">@foreach (var w in pain.Report.Words) {<span class="badge badge-light-danger fs-7 fw-bold">@T["pain:" + w]</span>}</div>
                                    </div>
                                }
                                <div class="separator separator-dashed my-3"></div>
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label bg-light-danger"><i class="ki-outline ki-geolocation fs-3 text-danger"></i></span></div>
                                    <div><span class="text-gray-800 fw-bold fs-6">@(painPlaces.Count > 0 ? string.Join(isAr ? "، " : ", ", painPlaces) : T["No places tapped"].Value)@(pain.Sheet.InkJson is { Length: > 2 } ? " · " + T["drawn by hand"].Value : "")</span>
                                        <span class="text-gray-500 fw-semibold fs-7 d-block">@(pain.Sheet.Status == HospitalCanvasStatus.Signed ? T["Signed with the visit"] : T["Saved as a measurement from the patient when the visit is signed"])</span></div>
                                </div>
                            </div></div>
                    }
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Marks (stored as observations)"]</span>
                        @if (Model.LastAt != null) {<span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Last drawing {0}", Model.LastAt.Value.ToString("yyyy-MM-dd")]</span>}</h3></div>
                        <div class="card-body pt-2"><div id="cv_list"></div></div></div>
                </div>
            </div>
            <input type="file" accept="image/jpeg,image/png,image/webp" class="d-none" id="cv_photo" />
            @* H127: the theme's form modal (demo39 utilities/modals/forms/new-target) around the photo; the photo and its points are untouched *@
            <div class="modal fade" id="ms_modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content rounded">
                <div class="modal-header pb-0 border-0 justify-content-end">
                    <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
                <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
                    <div class="mb-8 text-center"><h1 class="mb-3">@T["Measure on the photo"] <span class="text-gray-500 fs-4 fw-semibold" data-ms-title></span></h1>
                        <div class="text-muted fw-semibold fs-6">@T["Lay a ruler beside the lesion, in the same plane, when taking the photo. The server computes the size from your points; the margin is one pixel at each end."]</div></div>
                    <div class="row g-8">
                    <div class="col-lg-8"><div class="cv-wrap" style="cursor:crosshair"><svg id="ms_svg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet"><image id="ms_img" x="0" y="0" /><g id="ms_lines"></g></svg></div></div>
                    <div class="col-lg-4">
                        <div class="d-flex flex-column gap-2 mb-6" id="ms_steps">
                            <button type="button" class="cv-tool on justify-content-start text-start" data-ms-step="ruler"><span class="cv-sw" style="background:#3A5795"></span>@T["1 · The ruler: tap both ends of a known length"]</button>
                            <button type="button" class="cv-tool justify-content-start text-start" data-ms-step="length"><span class="cv-sw" style="background:#DC2626"></span>@T["2 · The lesion's longest length"]</button>
                            <button type="button" class="cv-tool justify-content-start text-start" data-ms-step="width"><span class="cv-sw" style="background:#7239EA"></span>@T["3 · Its widest across (optional)"]</button>
                        </div>
                        <label class="fs-6 fw-semibold mb-2">@T["The ruler's length you marked (mm)"]</label>
                        <input type="number" min="1" max="300" step="0.5" class="form-control form-control-solid mb-6" dir="ltr" id="ms_mm" value="10" />
                        <div class="border border-gray-300 border-dashed rounded py-4 px-5 mb-4"><div class="text-gray-500 fw-semibold fs-7 mb-1">@T["Measured size"]</div><div class="fs-2 fw-bold text-gray-900 lh-1"><bdi class="hp-num" dir="ltr" data-ms-out>—</bdi></div><div class="text-muted fs-7 mt-2" data-ms-note></div></div>
                        <button type="button" class="btn btn-sm btn-light btn-active-light-primary" data-ms-clear><i class="ki-outline ki-arrow-circle-left fs-4"></i>@T["Start again"]</button>
                    </div>
                    </div>
                    <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-ms-save><i class="ki-outline ki-check fs-4"></i>@T["Save the size to the mark"]</button></div>
                </div>
            </div></div></div>
        }
        else if (burn)
        {
            <div class="notice d-flex rounded border border-danger border-dashed bg-light-danger p-6 mb-5">
                <i class="ki-outline ki-information-5 fs-2tx text-danger me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["The calculator beats the paper"]</h4><div class="fs-6 text-gray-700">@T["In studies manual %TBSA was wrong more often than apps, especially for non-specialists — and the % sets the fluids."]</div></div>
            </div>
            <div class="row g-5">
                <div class="col-xl-7">
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@(ageYears is < 15 ? T["Burn chart — Lund–Browder (age {0})", ageYears] : T["Burn chart — rule of nines (adult)"])</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Tap a region to cycle the depth: none → superficial → deep → full. A child uses the Lund–Browder table for their age."]</span></h3></div>
                        <div class="card-body pt-3">
                            <div class="d-flex flex-wrap gap-5 mb-4 fs-7 fw-semibold text-gray-600">
                                @for (int i = 0; i < 4; i++) {<span class="d-flex align-items-center"><span class="cv-sw me-2" style="background:@depthCol[i]"></span>@T[depthKey[i]]</span>}
                            </div>
                            <div class="cv-wrap"><svg id="cv" viewBox="0 0 440 460">
                                @foreach (var (ox, lbl) in new[] { (0, T["Front view"].Value), (230, T["Back view"].Value) })
                                {
                                    <g transform="translate(@ox,0)">
                                        <ellipse cx="100" cy="34" rx="24" ry="28" class="cv-skin" /><rect x="90" y="58" width="20" height="14" class="cv-skin" />
                                        <path d="M62 74 Q100 64 138 74 L136 206 Q100 214 64 206 Z" class="cv-skin" />
                                        <path d="M62 76 L40 90 L24 210 L38 214 L54 110 L62 104 Z" class="cv-skin" /><path d="M138 76 L160 90 L176 210 L162 214 L146 110 L138 104 Z" class="cv-skin" />
                                        <path d="M64 206 L98 214 L96 428 L72 430 L66 300 Z" class="cv-skin" /><path d="M136 206 L102 214 L104 428 L128 430 L134 300 Z" class="cv-skin" />
                                        <text x="100" y="452" text-anchor="middle" font-size="13" fill="#6B7280">@lbl</text>
                                    </g>
                                }
                                <g id="bn_regs"></g>
                            </svg></div>
                        </div></div>
                </div>
                <div class="col-xl-5">
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["The calculation"]</span></h3></div>
                        <div class="card-body pt-2">
                            @* H127: the result as the theme's stat (demo39 dashboards/logistics) beside the weight; the fluids as a tinted block *@
                            <div class="row g-4 align-items-end">
                                <div class="col-6"><div class="border border-gray-300 border-dashed rounded py-3 px-4 h-100">
                                    <div class="text-gray-500 fw-semibold fs-7 mb-1">@T["TBSA (partial + full)"]</div>
                                    <div class="fs-2hx fw-bold lh-1 hp-num" id="bn_tbsa">0%</div></div></div>
                                <div class="col-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Weight kg"]</label>
                                    <input type="number" min="1" max="400" step="0.1" class="form-control form-control-solid" dir="ltr" id="bn_kg" value="@(burnKg?.ToString("0.#", CultureInfo.InvariantCulture))" @(canEdit ? "" : "disabled") /></div>
                            </div>
                            <div class="d-flex align-items-center bg-light-primary rounded p-5 mt-5">
                                <div class="symbol symbol-45px me-4 flex-shrink-0"><span class="symbol-label bg-white"><i class="ki-outline ki-drop fs-2x text-primary"></i></span></div>
                                <div class="flex-grow-1"><div class="text-gray-800 fw-bold fs-6">@T["Parkland fluids (24 h)"]</div><div class="fs-2 fw-bold text-gray-900 hp-num" dir="ltr" id="bn_fl">—</div><div class="fs-7 text-gray-700" id="bn_half"></div></div>
                            </div>
                            @* H172: what the chart cannot draw, and the referral by the ABA criteria with each reason named *@
                            <div class="d-flex flex-column gap-3 mt-5">
                                <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" id="bn_hf" @(burnNow?.Hands == true ? "checked" : "") @(canEdit ? "" : "disabled") /><span class="form-check-label fw-semibold text-gray-700">@T["The burn involves the hands, feet or major joints"]</span></label>
                                <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" id="bn_mx" @(burnNow?.Mechanism == true ? "checked" : "") @(canEdit ? "" : "disabled") /><span class="form-check-label fw-semibold text-gray-700">@T["Electrical, chemical or inhalation injury"]</span></label>
                            </div>
                            <div class="d-none bg-light-danger rounded border-danger border border-dashed p-4 mt-5" id="bn_refer">
                                <div class="fw-bold text-gray-900 fs-6 mb-2">@T["Refer to a burn centre"]</div>
                                <ul class="mb-0 ps-5 fs-7 text-gray-800" id="bn_why"></ul>
                            </div>
                            <div class="mt-5" id="bn_list"></div>
                            <div class="text-muted fs-8 mt-3">@T["The server recomputes these figures when the drawing is saved."]</div>
                            @{ Earlier(); }
                        </div></div>
                </div>
            </div>
        }
        else if (audio)
        {
            <div class="row g-5">
                <div class="col-xl-8">
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@T["Audiogram"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["ASHA symbols: O right / X left air, < right / > left bone; red right, blue left. Tap to place; snaps to the frequency and nearest 5 dB."] @T["Tap a point again to remove it."]</span></h3></div>
                        <div class="card-body pt-3">
                            @if (canEdit)
                            {
                                <div class="cv-tools" id="au_tools">
                                    @foreach (var (k, sym, col, lbl) in new[] { ("AR", "O", "#DC2626", "Air — right"), ("AL", "X", "#2563EB", "Air — left"), ("BR", "<", "#DC2626", "Bone — right"), ("BL", ">", "#2563EB", "Bone — left") })
                                    {
                                        <button type="button" class="cv-tool @(k == "AR" ? "on" : "")" data-k="@k"><b style="color:@col" dir="ltr">@sym</b> @T[lbl]</button>
                                    }
                                </div>
                            }
                            <div class="cv-wrap"><svg id="au" viewBox="0 0 520 420"></svg></div>
                            @* H190: the onset makes a 30 dB / three-frequency sensorineural loss an emergency *@
                            <label class="form-check form-check-custom form-check-solid mt-4"><input class="form-check-input" type="checkbox" id="au_sudden" @(audioNow?.Sudden == true ? "checked" : "") @(canEdit ? "" : "disabled") /><span class="form-check-label fw-semibold text-gray-800">@T["The loss came on suddenly, within 72 hours"]</span></label>
                        </div></div>
                </div>
                <div class="col-xl-4">
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["The calculation"]</span></h3></div>
                        <div class="card-body pt-2"><div id="au_out"></div>
                            <div class="text-muted fs-8 mt-3">@T["The server recomputes these figures when the drawing is saved."]</div>
                            @{ Earlier(); }</div></div>
                </div>
            </div>
        }
        else if (joints)
        {
            <div class="row g-5">
                <div class="col-xl-7">
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-800">@T["The 28-joint map"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Tap a joint: tender → swollen → both → clear"]</span></h3></div>
                        <div class="card-body pt-3">
                            <div class="d-flex flex-wrap gap-5 mb-4 fs-7 fw-semibold text-gray-600">
                                <span class="d-flex align-items-center"><span class="cv-sw me-2" style="background:#F87171"></span>@T["Tender"]</span><span class="d-flex align-items-center"><span class="cv-sw me-2" style="background:#60A5FA"></span>@T["Swollen"]</span><span class="d-flex align-items-center"><span class="cv-sw me-2" style="background:#7C3AED"></span>@T["Both"]</span>
                            </div>
                            <div class="cv-wrap"><svg id="jt" viewBox="0 0 400 420"></svg></div>
                        </div></div>
                </div>
                <div class="col-xl-5">
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">DAS28-ESR</span></h3></div>
                        <div class="card-body pt-2">
                            <div class="row g-4">
                                <div class="col-6 fv-row"><label class="fs-6 fw-semibold mb-2" dir="ltr">ESR mm/h</label><input type="number" min="1" max="150" class="form-control form-control-solid" dir="ltr" id="jt_esr" value="@dasNow?.Esr?.ToString("0", CultureInfo.InvariantCulture)" @(canEdit ? "" : "disabled") /></div>
                                <div class="col-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Patient global 0–100"]</label><input type="number" min="0" max="100" class="form-control form-control-solid" dir="ltr" id="jt_pga" value="@dasNow?.Global" @(canEdit ? "" : "disabled") /></div>
                            </div>
                            <div id="jt_out" class="mt-5"></div>
                            <div class="text-muted fs-8 mt-3">@T["The server recomputes these figures when the drawing is saved."]</div>
                            @{ Earlier(); }
                        </div></div>
                </div>
            </div>
        }
        else if (pedigree)
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Standard NSGC symbols (2022 revision)"]</h4><div class="fs-6 text-gray-700">@T["Square male, circle female, filled = affected, slash = deceased, arrow = proband, double line = consanguinity — very important in the Gulf and Egypt for inherited disease."]</div></div>
            </div>
            <div class="row g-5">
                <div class="col-xl-8">
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Pedigree"]</span></h3>
                        @if (canEdit) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-light-primary" data-add-rel><i class="ki-outline ki-plus fs-4"></i>@T["Add a relative"]</button></div>}</div>
                        <div class="card-body pt-3">
                            @if (canEdit) {<div class="text-gray-500 fw-semibold fs-7 mb-4"><i class="ki-outline ki-mouse-square fs-5 text-gray-500 me-1"></i>@T["Tap a person to edit them."]</div>}
                            <div class="cv-wrap p-3" style="overflow-x:auto"><svg id="pd" viewBox="0 0 640 360"></svg></div>
                        </div></div>
                </div>
                <div class="col-xl-4">
                    <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["What the tree yields"]</span></h3></div>
                        <div class="card-body pt-2"><div id="pd_yield"></div></div></div>
                </div>
            </div>
            @* H127: the theme's form modal (demo39 utilities/modals/forms/new-target) *@
            <div class="modal fade" id="pd_modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
                <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
                <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                    <div class="mb-10 text-center"><h1 class="mb-3" id="pd_title">@T["Add a relative"]</h1>
                        <div class="text-muted fw-semibold fs-5">@T["Standard NSGC symbols (2022 revision)"]</div></div>
                    <div class="row g-6">
                    <div class="col-6 fv-row" data-new><label class="required fs-6 fw-semibold mb-2">@T["Relative of"]</label><select class="form-select form-select-solid" id="pd_of" data-control="select2" data-dropdown-parent="#pd_modal" data-hide-search="true"></select></div>
                    <div class="col-6 fv-row" data-new><label class="required fs-6 fw-semibold mb-2">@T["Relation"]</label><select class="form-select form-select-solid" id="pd_rel" data-control="select2" data-dropdown-parent="#pd_modal" data-hide-search="true">
                        @foreach (var r in new[] { "father", "mother", "brother", "sister", "son", "daughter", "husband", "wife" }) {<option value="@r">@T["rel:" + r]</option>}
                    </select></div>
                    <div class="col-12" data-new><label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" id="pd_cons" /><span class="form-check-label fw-semibold text-gray-700 fs-6">@T["The partners are relatives (consanguinity)"]</span></label></div>
                    <div class="col-12"><div class="d-flex flex-wrap gap-5 bg-light rounded p-4">
                        <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" id="pd_aff" /><span class="form-check-label fw-semibold text-gray-700 fs-6">@T["Affected"]</span></label>
                        <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" id="pd_dead" /><span class="form-check-label fw-semibold text-gray-700 fs-6">@T["Deceased"]</span></label>
                        <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" id="pd_car" /><span class="form-check-label fw-semibold text-gray-700 fs-6">@T["Carrier"]</span></label>
                    </div></div>
                    <div class="col-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Condition"]</label><input type="text" maxlength="60" class="form-control form-control-solid" id="pd_cond" /></div>
                    <div class="col-6 fv-row"><label class="fs-6 fw-semibold mb-2">@T["Note (age, cause of death)"]</label><input type="text" maxlength="60" class="form-control form-control-solid" id="pd_note" /></div>
                    </div>
                    <div class="d-flex flex-center flex-wrap gap-3 pt-10"><button type="button" class="btn btn-light-danger d-none" id="pd_del"><i class="ki-outline ki-trash fs-4"></i>@T["Remove from the tree"]</button><button type="button" class="btn btn-light" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" id="pd_ok">@T["Save"]</button></div>
                </div>
            </div></div></div>
        }
        else
        {
            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["The finding sets the colour, not the doctor"]</h4><div class="fs-6 text-gray-700">@T["The CMS retinal colour code is enforced: haemorrhage red, detachment blue, exudate yellow, new vessels purple. Each mark writes a SNOMED-coded finding into the visit."]</div></div>
            </div>
            <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold text-gray-800">@T["Fundus — {0}", name]</span>
                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Pick the finding, then tap its place; drawn inverted as the indirect ophthalmoscope shows it"]</span></h3></div>
                <div class="card-body pt-3">
                    @if (canEdit)
                    {
                        <div class="cv-tools" id="fd_tools">
                            @foreach (var f in findings) {<button type="button" class="cv-tool @(f == findings[0] ? "on" : "")" data-k="@f.Key"><span class="cv-sw" style="background:@f.Color"></span>@(isAr ? f.Ar : f.En)</button>}
                            <button type="button" class="cv-tool" data-k="undo"><i class="ki-outline ki-arrow-circle-left fs-5"></i>@T["Undo"]</button>
                        </div>
                    }
                    <div class="row g-4">
                        @foreach (var (id, side, lbl) in new[] { ("od", "R", "OD — " + T["Right"].Value), ("os", "L", "OS — " + T["Left"].Value) })
                        {
                            int disc = id == "od" ? 120 : 180, mac = id == "od" ? 168 : 132, far = id == "od" ? 240 : 60, mid = id == "od" ? 170 : 130;
                            <div class="col-md-6"><div class="text-center mb-3"><span class="badge badge-light-@(side == "R" ? "primary" : "info") fs-6 fw-bold px-4 py-2">@lbl</span></div><div class="cv-wrap"><svg id="@id" data-side="@side" viewBox="0 0 300 300">
                                <circle cx="150" cy="150" r="140" fill="#FFF7ED" stroke="#9CA3AF" /><circle cx="150" cy="150" r="105" fill="none" stroke="#D1D5DB" stroke-dasharray="4 4" /><circle cx="150" cy="150" r="60" fill="none" stroke="#E5E7EB" stroke-dasharray="2 4" />
                                <circle cx="@disc" cy="150" r="13" fill="#FDE68A" stroke="#D97706" /><circle cx="@mac" cy="152" r="5" fill="#9A3412" opacity=".5" />
                                <path d="M@(disc) 140 Q@(mid) 90 @(far) 70" stroke="#DC2626" fill="none" stroke-width="2" /><path d="M@(disc) 160 Q@(mid) 210 @(far) 232" stroke="#2563EB" fill="none" stroke-width="2" />
                                <g class="fm"></g></svg></div></div>
                        }
                    </div>
                </div></div>
            <div class="card card-flush mb-5"><div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Findings written automatically"]</span></h3></div>
                <div class="card-body pt-2"><div id="cv_list"></div></div></div>
        }
        @* H177: addenda and corrections on the locked record *@
        @if (ViewBag.Addenda is CrossBuy.BL.Hospital.HospitalAddendaBlock adb) { <partial name="_Addenda" model="adb" /> }
    </div></div>
</div>

@await Html.PartialAsync("_ReportPreviewModal", (object)name)

@section Scripts {
    <script>
        (function () {
            var tokEl = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tokEl) return; var tok = tokEl.value;
            var KIND = @Json.Serialize(Model.Kind), canEdit = @Json.Serialize(canEdit), isAr = @Json.Serialize(isAr), NS = 'http://www.w3.org/2000/svg';
            var saveUrl = @Json.Serialize(Url.Content("~/Hospital/Consult/" + e.ID + "/Canvas/" + Model.Kind + "/Save"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), save: @Json.Serialize(T["Save this drawing to the visit? It is signed with the visit."].Value), saved: @Json.Serialize(T["Saved"].Value),
                      onBody: @Json.Serialize(T["Tap on the body itself"].Value), unsaved: @Json.Serialize(T["Choose a saved mark from the list first"].Value), photo: @Json.Serialize(T["Attach this photo to mark {0}?"].Value),
                      confirm: @Json.Serialize(T["Confirm"].Value), verified: @Json.Serialize(T["Verified"].Value), carried: @Json.Serialize(T["Carried — unverified"].Value), was: @Json.Serialize(T["Last visit: {0} mm"].Value),
                      grew: @Json.Serialize(T["Grew since the last visit"].Value), none: @Json.Serialize(T["No marks yet"].Value), remove: @Json.Serialize(T["Remove"].Value), eye: @Json.Serialize(T["Eye"].Value),
                      finding: @Json.Serialize(T["Finding"].Value), where: @Json.Serialize(T["Where"].Value), code: @Json.Serialize(T["Code"].Value), front: @Json.Serialize(T["front side"].Value), back: @Json.Serialize(T["back side"].Value),
                      pp: @Json.Serialize(T["posterior pole"].Value), mp: @Json.Serialize(T["mid-periphery"].Value), fp: @Json.Serialize(T["far periphery"].Value), at: @Json.Serialize(T["at {0} o'clock"].Value) };
            var F = @Json.Serialize(findings.Select(f => new { k = f.Key, t = isAr ? f.Ar : f.En, c = f.Color, code = f.Code }));
            var REG = @Json.Serialize(HospitalCanvasRules.BodyRegions.Select(r => new { k = r.Key, t = isAr ? r.Ar : r.En, r = new[] { r.X, r.Y, r.W, r.H } }));
            var marks = @Json.Serialize(Model.Marks.Select(m => new { id = m.ID == 0 ? (int?)null : m.ID, f = m.Finding, v = m.Side, x = m.X, y = m.Y, s = m.SizeMm, no = m.LesionNo, carried = m.Carried, from = m.CarriedFromMarkId, photo = m.PhotoDocumentId != null, ms = Measured(m), pc = ConsentOf(m) }));
            var last = @Json.Serialize(Model.Last.Select(m => new { id = m.ID, f = m.Finding, v = m.Side, x = m.X, y = m.Y, s = m.SizeMm, no = m.LesionNo }));
            var ink = @Json.Serialize(System.Text.Json.JsonDocument.Parse(string.IsNullOrEmpty(Model.Sheet?.InkJson) ? "[]" : Model.Sheet!.InkJson).RootElement);
            var nextNo = @Model.NextLesion, hist = [], sel = null, compare = false;
            // H113: photos under the patient's consent; the measure on a photo
            var hasConsent = @Json.Serialize(Model.PhotoConsent != null);
            W.onPhoto = @Json.Serialize(T["on the photo"].Value); W.underConsent = @Json.Serialize(T["Consent {0}"].Value); W.withdrawn = @Json.Serialize(T["consent withdrawn"].Value);
            W.measure = @Json.Serialize(T["Measure on the photo"].Value); W.noConsent = @Json.Serialize(T["Record the patient's photography consent first"].Value);
            W.msSave = @Json.Serialize(T["Save the measured size to mark {0}? It replaces the size typed by hand."].Value);
            W.msNeed = @Json.Serialize(T["Mark the ruler and the lesion's length first"].Value); W.msShort = @Json.Serialize(T["Mark a longer stretch of the ruler: at least 50 pixels on the photo"].Value);
            W.msWide = @Json.Serialize(T["The width is across the length: it cannot be longer than the length"].Value); W.msScale = @Json.Serialize(T["{0} mm per pixel on this photo"].Value);
            W.scope = @Json.Serialize(HospitalConsentPhotoScope.All.ToDictionary(s => s, s => T["photo-scope-short:" + s].Value));
            function fOf(k) { return F.filter(function (x) { return x.k === k; })[0] || { t: k, c: '#3A5795' }; }
            function fmt(s, a) { return s.replace('{0}', a); }
            function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
            function pt(svg, ev) { var r = svg.getBoundingClientRect(), vb = svg.viewBox.baseVal; return [(ev.clientX - r.left) * vb.width / r.width, (ev.clientY - r.top) * vb.height / r.height]; }
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': tok }, body: JSON.stringify(b || {}) })
                .then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function regionAt(x, y) { var side = x < 220 ? 'F' : 'B', lx = side === 'F' ? x : x - 230;
                var hit = REG.filter(function (r) { return lx >= r.r[0] && lx <= r.r[0] + r.r[2] && y >= r.r[1] && y <= r.r[1] + r.r[3]; })[0];
                // from behind the patient's right is on the viewer's right (the server places it the same way)
                var MIR = { armR: 'armL', armL: 'armR', legR: 'legL', legL: 'legR' };
                if (hit && side === 'B' && MIR[hit.k]) hit = REG.filter(function (r) { return r.k === MIR[hit.k]; })[0];
                return hit ? hit.t + ' — ' + (side === 'F' ? W.front : W.back) : null; }
