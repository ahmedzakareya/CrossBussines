                        document.querySelectorAll('#pd_modal [data-new]').forEach(function (e) { e.classList.toggle('d-none', !!x); });
                        $('pd_del').classList.toggle('d-none', !x || x.proband);
                        $('pd_of').innerHTML = P.map(function (q) { return '<option value="' + q.id + '"' + (q.proband ? ' selected' : '') + '>' + esc(label(q)) + '</option>'; }).join('');
                        $('pd_aff').checked = !!(x && x.affected); $('pd_dead').checked = !!(x && x.deceased); $('pd_car').checked = !!(x && x.carrier); $('pd_cons').checked = false;
                        $('pd_cond').value = (x && x.cond) || ''; $('pd_note').value = (x && x.note) || '';
                        if (window.jQuery) jQuery('#pd_of, #pd_rel').trigger('change.select2');   // H127: the select2 faces follow the rebuilt options
                        modal.show(); }
                    document.querySelector('[data-add-rel]').addEventListener('click', function () { open(null); });
                    svg.addEventListener('click', function (ev) { var gp = ev.target.closest('[data-p]'); if (gp) open(byId(+gp.getAttribute('data-p'))); });
                    $('pd_del').addEventListener('click', function () { var x = editing; if (!x) return; cbConfirm(PT.del).then(function (ok) { if (!ok) return;
                        P = P.filter(function (q) { return q !== x; }); P.forEach(function (q) { if (q.father === x.id) q.father = null; if (q.mother === x.id) q.mother = null; });
                        C = C.filter(function (c) { return c.a !== x.id && c.b !== x.id; }); modal.hide(); draw(); }); });
                    $('pd_ok').addEventListener('click', function () {
                        var aff = $('pd_aff').checked, cond = $('pd_cond').value.trim(); if (aff && !cond) { toastr.error(PT.cond); return; }
                        var x = editing;
                        if (!x) {
                            var of = byId(+$('pd_of').value), rel = $('pd_rel').value, id = P.reduce(function (m, q) { return Math.max(m, q.id); }, 0) + 1;
                            x = { id: id, sex: /^(father|brother|son|husband)$/.test(rel) ? 'M' : 'F', gen: of.gen, father: null, mother: null, proband: false };
                            if (rel === 'father') { if (of.father) { toastr.error(PT.hasFather); return; } x.gen = of.gen - 1; of.father = id; if (of.mother) C.push({ a: id, b: of.mother, cons: $('pd_cons').checked }); }
                            else if (rel === 'mother') { if (of.mother) { toastr.error(PT.hasMother); return; } x.gen = of.gen - 1; of.mother = id; if (of.father) C.push({ a: of.father, b: id, cons: $('pd_cons').checked }); }
                            else if (rel === 'brother' || rel === 'sister') { x.father = of.father; x.mother = of.mother; }
                            else if (rel === 'son' || rel === 'daughter') { x.gen = of.gen + 1; var sp = partners(of)[0]; var m = of.sex === 'F' ? of : sp, f = of.sex === 'F' ? sp : of;
                                x.father = f && f.sex !== 'F' ? f.id : null; x.mother = m && m.sex !== 'M' ? m.id : null; }
                            else { C.push({ a: of.id, b: id, cons: $('pd_cons').checked }); }
                            P.push(x);
                        }
                        x.affected = aff; x.cond = aff ? cond : null; x.deceased = $('pd_dead').checked; x.carrier = $('pd_car').checked; x.note = $('pd_note').value.trim() || null;
                        modal.hide(); draw(); });
                }
                draw();
            } else {
                var cur = F[0];
                function shape(m) { var f = fOf(m.f), x = +m.x, y = +m.y;
                    switch (m.f) {
                        case 'ma': return '<circle cx="' + x + '" cy="' + y + '" r="3" fill="' + f.c + '"/>';
                        case 'nv': return '<circle cx="' + x + '" cy="' + y + '" r="9" fill="none" stroke="' + f.c + '" stroke-width="3"/>';
                        case 'detach': return '<ellipse cx="' + x + '" cy="' + y + '" rx="22" ry="14" fill="' + f.c + '" opacity=".55"/>';
                        case 'vh': return '<ellipse cx="' + x + '" cy="' + y + '" rx="22" ry="14" fill="' + f.c + '" opacity=".55" stroke="#16A34A" stroke-width="3"/>';
                        case 'break': return '<path d="M' + (x - 10) + ' ' + y + ' l10 -12 l10 12 z" fill="' + f.c + '" stroke="#2563EB" stroke-width="2.5"/>';
                        default: return '<circle cx="' + x + '" cy="' + y + '" r="7" fill="' + f.c + '"/>';
                    } }
                function draw() {
                    ['od', 'os'].forEach(function (id) { var svg = document.getElementById(id), side = svg.getAttribute('data-side'); svg.querySelector('.fm').innerHTML = marks.filter(function (m) { return m.v === side; }).map(shape).join(''); });
                    document.getElementById('cv_list').innerHTML = marks.length ? '<div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0"><thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">' + W.eye + '</th><th>' + W.finding + '</th><th>' + W.where + '</th><th class="pe-4 rounded-end">' + W.code + '</th></tr></thead><tbody>' +
                        marks.map(function (m) { var f = fOf(m.f); return '<tr><td class="ps-4"><span class="badge badge-light-' + (m.v === 'R' ? 'primary' : 'info') + ' fs-7 fw-bold" dir="ltr">' + (m.v === 'R' ? 'OD' : 'OS') + '</span></td><td><div class="d-flex align-items-center"><span class="cv-sw me-3" style="background:' + f.c + '"></span><span class="text-gray-900 fw-bold fs-6">' + esc(f.t) + '</span></div></td><td><span class="text-gray-600 fw-semibold fs-7">' + esc(fundusAt(+m.x, +m.y)) + '</span></td><td class="pe-4"><span class="badge badge-light fs-7 fw-bold hp-num" dir="ltr">' + esc(f.code || '') + '</span></td></tr>'; }).join('') + '</tbody></table></div>'
                        : '<div class="text-center py-10"><i class="ki-outline ki-eye fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">' + W.none + '</div></div>';
                }
                if (canEdit) {
                    document.getElementById('fd_tools').addEventListener('click', function (ev) { var b = ev.target.closest('.cv-tool'); if (!b) return; var k = b.getAttribute('data-k');
                        if (k === 'undo') { marks.pop(); draw(); return; }
                        cur = fOf(k); this.querySelectorAll('.cv-tool').forEach(function (x) { x.classList.toggle('on', x === b); }); });
                    ['od', 'os'].forEach(function (id) { var svg = document.getElementById(id); svg.addEventListener('click', function (ev) { var q = pt(svg, ev); if (!fundusAt(q[0], q[1])) return;
                        marks.push({ id: null, f: cur.k, v: svg.getAttribute('data-side'), x: +q[0].toFixed(2), y: +q[1].toFixed(2), s: null, no: 0, carried: false, from: null }); draw(); }); });
                }
                draw();
            }
        })();
    </script>
