                    document.getElementById('cv_list').innerHTML = marks.length ? '<div class="table-responsive"><table class="table align-middle table-row-dashed fs-7 gy-3 mb-0"><thead><tr class="text-start text-muted fw-bold fs-8 text-uppercase"><th>' + W.eye + '</th><th>' + W.finding + '</th><th>' + W.where + '</th><th>' + W.code + '</th></tr></thead><tbody>' +
                        marks.map(function (m) { var f = fOf(m.f); return '<tr><td><span class="badge badge-light-' + (m.v === 'R' ? 'primary' : 'info') + '">' + (m.v === 'R' ? 'OD' : 'OS') + '</span></td><td><span class="cv-sw me-2" style="background:' + f.c + '"></span>' + esc(f.t) + '</td><td>' + esc(fundusAt(+m.x, +m.y)) + '</td><td><code dir="ltr">' + esc(f.code || '') + '</code></td></tr>'; }).join('') + '</tbody></table></div>'
                        : '<div class="text-muted fs-7 py-3">' + W.none + '</div>';
                }
                if (canEdit) {
                    document.getElementById('fd_tools').addEventListener('click', function (ev) { var b = ev.target.closest('.cv-tool'); if (!b) return; var k = b.getAttribute('data-k');
                        if (k === 'undo') { marks.pop(); draw(); return; }
                        cur = fOf(k); this.querySelectorAll('.cv-tool').forEach(function (x) { x.classList.toggle('on', x === b); }); });
                    ['od', 'os'].forEach(function (id) { var svg = document.getElementById(id); svg.addEventListener('click', function (ev) { var q = pt(svg, ev); if (!fundusAt(q[0], q[1])) return;
                        marks.push({ id: null, f: cur.k, v: svg.getAttribute('data-side'), x: +q[0].toFixed(2), y: +q[1].toFixed(2), s: null, no: 0, carried: false, from: null }); draw(); }); });
                }
                draw();
            }
        })();
    </script>
}
