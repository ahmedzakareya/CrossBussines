@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalStewardshipPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H235 — antimicrobial stewardship: every running antimicrobial with where it stands (approval of a restricted agent
    within 24 h, the 48–72 h time-out), the team's decision in a modal, and the last 30 days' days of therapy per
    1 000 patient-days. The patient is shown with their photo. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Antimicrobial stewardship"].Value;
    string q = ViewBag.Q as string ?? "", state = ViewBag.State as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p, string? s = null) => Url.Action("Stewardship", new { q, state = s ?? state, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Tone(string s) => HospitalAbxState.Urgent(s) ? "danger" : s is HospitalAbxState.AwaitingApproval or HospitalAbxState.TimeOutDue ? "info" : "primary";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Antimicrobial stewardship"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Pharmacy")" class="text-muted text-hover-primary">@T["Pharmacy"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Antimicrobial stewardship"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["Stewardship is not installed yet (hospital_h235_stewardship.sql)."]</div></div>
        }
        <div class="row g-5 mb-5">
            @foreach (var s in new[] { HospitalAbxState.ApprovalOverdue, HospitalAbxState.TimeOutOverdue, HospitalAbxState.AwaitingApproval, HospitalAbxState.TimeOutDue })
            {
                <div class="col-6 col-xl-3"><a href="@Link(1, state == s ? "" : s)" class="card card-flush h-100 @(state == s ? "border border-primary" : "") text-hover-primary"><div class="card-body d-flex flex-column justify-content-between py-6">
                    <span class="fs-2hx fw-bold text-@(HospitalAbxState.Urgent(s) && Model.Counts.GetValueOrDefault(s) > 0 ? "danger" : "gray-900") hp-num">@Model.Counts.GetValueOrDefault(s)</span>
                    <span class="text-gray-600 fw-semibold fs-6">@T["abx:" + s]</span>
                </div></a></div>
            }
        </div>
        <div class="row g-5">
            <div class="col-xl-8">
                <div class="card card-flush">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Running antimicrobials"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["A restricted agent needs approval within 24 h; every agent gets its time-out at 48–72 h."]</span></h3>
                        <form class="card-toolbar gap-2" method="get" action="@Url.Action("Stewardship")">
                            <input type="hidden" name="state" value="@state" />
                            <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                                <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-225px ps-12" placeholder="@T["Search a patient or medicine"]" /></div>
                            <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                        </form>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Rows.Count == 0)
                        {
                            <div class="text-center py-15"><i class="ki-outline ki-capsule fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No running antimicrobial here."]</div></div>
                        }
                        else
                        {
                            <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-200px">@T["Patient"]</th><th class="min-w-175px">@T["Medicine"]</th><th class="w-100px">@T["On therapy"]</th><th class="min-w-150px">@T["Status"]</th><th class="text-end"></th></tr></thead>
                                <tbody>
                                @foreach (var r in Model.Rows)
                                {
                                    <tr>
                                        <td><div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.Photo, DisplayName.Of(r.PatientName, r.PatientNameEn), 35)<div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = r.Order.PatientId })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><span class="text-muted fs-7 hp-num" dir="ltr">@r.Mrn</span></div></div></td>
                                        <td><div class="fw-bold text-gray-800" dir="ltr">@r.Order.Drug</div><div class="text-muted fs-7 hp-num" dir="ltr">@r.Order.Dose · @r.Order.Route@if (r.Restricted) {<span class="badge badge-light-danger fs-8 ms-2">@T["Restricted"]</span>}</div></td>
                                        <td class="hp-num" dir="ltr">@((r.Hours / 24).ToString("0.0", inv)) @T["d"]</td>
                                        <td><span class="badge badge-light-@Tone(r.State) fs-7 fw-bold">@T["abx:" + r.State]</span>
                                            @if (r.LastReview is { } lr) {<div class="text-muted fs-8 mt-1">@T["abxd:" + lr.Decision]@if (lr.Note != null) {<text> — <span dir="auto">@lr.Note</span></text>}</div>}</td>
                                        <td class="text-end text-nowrap">
                                            @if (r.Restricted && r.State is HospitalAbxState.AwaitingApproval or HospitalAbxState.ApprovalOverdue or HospitalAbxState.RejectedRunning)
                                            {<button type="button" class="btn btn-sm btn-light-primary" data-abx="@r.Order.ID" data-kind="Approval" data-name="@r.Order.Drug">@T["Approve or reject"]</button>}
                                            else if (r.State != HospitalAbxState.Reviewed)
                                            {<button type="button" class="btn btn-sm btn-light-primary" data-abx="@r.Order.ID" data-kind="TimeOut" data-name="@r.Order.Drug">@T["Time-out"]</button>}
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                            @if (pages > 1)
                            {
                                <ul class="pagination mt-6">
                                    <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                                    @for (int p = Math.Max(1, page - 3); p <= Math.Min(pages, page + 3); p++) {<li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>}
                                    <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                                </ul>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="card card-flush">
                    <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Use in the last 30 days"]</span>
                        <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Days of therapy per 1 000 patient-days"] · <span class="hp-num">@Model.PatientDays</span> @T["patient-days"]</span></h3>
                        @if (Model.TotalPer1000 is decimal tot) {<div class="card-toolbar"><span class="badge badge-light-primary fs-6 hp-num">@tot.ToString("0.0", inv)</span></div>}
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.Use.Count == 0) {<div class="text-muted fs-7">@T["No antimicrobial given in the period."]</div>}
                        @foreach (var u in Model.Use)
                        {
                            <div class="d-flex flex-stack py-2 border-bottom border-gray-200 border-bottom-dashed">
                                <span class="fw-semibold text-gray-800" dir="ltr">@u.Drug</span>
                                <span class="text-gray-700 fs-7 hp-num" dir="ltr">@u.Dot DOT · @(u.Per1000?.ToString("0.0", inv) ?? "—")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div></div>
</div>

<div class="modal fade" id="abxModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-550px"><div class="modal-content rounded">
    <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
    <div class="modal-body px-10 pt-0 pb-10">
        <div class="mb-8 text-center"><h1 class="mb-3" data-abx-title></h1><div class="text-muted fw-semibold fs-6" dir="ltr" data-abx-drug></div></div>
        @foreach (var (kind, list) in new[] { (HospitalAbxReviewKind.Approval, HospitalAbxDecision.ForApproval), (HospitalAbxReviewKind.TimeOut, HospitalAbxDecision.ForTimeOut) })
        {
            <div class="d-flex flex-column gap-3 mb-5 d-none" data-abx-for="@kind">
                @foreach (var d in list)
                {
                    <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="radio" name="abx-@kind" value="@d" /><span class="form-check-label fw-semibold text-gray-800">@T["abxd:" + d]</span></label>
                }
            </div>
        }
        <label class="fs-6 fw-semibold mb-2">@T["Reason / note"]</label>
        <textarea class="form-control form-control-solid" rows="3" maxlength="500" dir="auto" data-abx-note></textarea>
        <div class="text-muted fs-8 mt-2">@T["Stop stops the order on the ward at once."]</div>
        <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-abx-save>@T["Save"]</button></div>
    </div>
</div></div></div>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, m = document.getElementById('abxModal'), current = null, kind = null;
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), choose: @Json.Serialize(T["Choose the decision"].Value),
                titles: { Approval: @Json.Serialize(T["Approve or reject"].Value), TimeOut: @Json.Serialize(T["Time-out"].Value) } };
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-abx],[data-abx-save]'); if (!t) return;
                if (t.hasAttribute('data-abx')) {
                    current = t.getAttribute('data-abx'); kind = t.getAttribute('data-kind');
                    m.querySelector('[data-abx-title]').textContent = W.titles[kind]; m.querySelector('[data-abx-drug]').textContent = t.getAttribute('data-name');
                    m.querySelectorAll('[data-abx-for]').forEach(function (b) { b.classList.toggle('d-none', b.getAttribute('data-abx-for') !== kind); });
                    m.querySelectorAll('input[type=radio]').forEach(function (r) { r.checked = false; }); m.querySelector('[data-abx-note]').value = '';
                    bootstrap.Modal.getOrCreateInstance(m).show(); return;
                }
                var pick = m.querySelector('input[name="abx-' + kind + '"]:checked'); if (!pick) { toastr.error(W.choose); return; }
                t.disabled = true;
                fetch(@Json.Serialize(Url.Content("~/Hospital/Stewardship/")) + current + '/Review', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token },
                    body: JSON.stringify({ kind: kind, decision: pick.value, note: m.querySelector('[data-abx-note]').value || null }) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                    .then(function (res) { t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } bootstrap.Modal.getOrCreateInstance(m).hide(); toastr.success(W.saved); setTimeout(function () { location.reload(); }, 600); });
            });
        })();
    </script>
}
