@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalPrivacyPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H255 — behavioural privacy monitoring: alerts read from who opened whose file (same family name, no care link for a
    doctor, an unusual day's volume, a restricted file after hours), each with the employee's and the patient's photo;
    the officer clears it (explained) or confirms it (a breach to follow), with what was found. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Privacy monitoring"].Value;
    string q = ViewBag.Q as string ?? "", view = ViewBag.View as string ?? "", kind = ViewBag.Kind as string ?? ""; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p, string? v = null, string? k = null) => Url.Action("Privacy", new { q, view = v ?? view, kind = k ?? kind, page = p })!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Privacy monitoring"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0"><li class="breadcrumb-item text-muted">@T["Quality"]</li><li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li><li class="breadcrumb-item text-muted">@T["Privacy monitoring"]</li></ul>
        </div>
        <div class="d-flex gap-2">
            <a href="@Link(1, "", "")" class="btn btn-sm @(view == "" ? "btn-primary" : "btn-light")">@T["Open alerts"] (@Model.Open)</a>
            <a href="@Link(1, "reviewed", "")" class="btn btn-sm @(view == "reviewed" ? "btn-primary" : "btn-light")">@T["Reviewed alerts"]</a>
            <a href="@Url.Action("AccessLog")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-eye fs-4"></i>@T["Access log"]</a>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!Model.Ready) {<div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T[HospitalPrivacyService.NoTables]</div></div>}
        <div class="row g-5 mb-5">
            @foreach (var k in HospitalPrivacyKind.All)
            {
                <div class="col-6 col-xl-3"><a href="@Link(1, null, kind == k ? "" : k)" class="card card-flush h-100 @(kind == k ? "border border-primary" : "") text-hover-primary"><div class="card-body py-6">
                    <span class="fs-2hx fw-bold hp-num text-@(Model.OpenByKind.GetValueOrDefault(k) > 0 ? "danger" : "gray-900")">@Model.OpenByKind.GetValueOrDefault(k)</span>
                    <div class="text-gray-700 fw-semibold fs-6">@T["pk:" + k]</div><div class="text-muted fs-8">@T["pkh:" + k]</div></div></a></div>
            }
        </div>
        <div class="card card-flush">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Alerts"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Read from the record-access log of the last 14 days; the log itself is never changed"]</span></h3>
                <form class="card-toolbar gap-2" method="get" action="@Url.Action("Privacy")"><input type="hidden" name="view" value="@view" /><input type="hidden" name="kind" value="@kind" />
                    <div class="position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute top-50 translate-middle-y ms-4"></i>
                        <input type="text" name="q" value="@q" class="form-control form-control-sm form-control-solid w-200px ps-12" placeholder="@T["Search an employee or patient"]" /></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button></form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Rows.Count == 0) {<div class="text-center py-15"><i class="ki-outline ki-shield-tick fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["No alert here."]</div></div>}
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-175px">@T["Employee"]</th><th class="min-w-175px">@T["Patient"]</th><th>@T["Pattern"]</th><th>@T["Day"]</th><th class="min-w-150px">@T["Review"]</th><th class="text-end"></th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var a = r.Alert;
                            <tr>
                                <td>@if (r.Employee is { } e) {<div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(e.Photo, DisplayName.Of(e.Name ?? "", e.NameEn), 35)<span class="fw-bold text-gray-800">@DisplayName.Of(e.Name ?? "", e.NameEn)</span></div>} else {<span class="text-muted">#@a.EmployeeId</span>}</td>
                                <td>@if (a.PatientId is int pid) {<div class="d-flex align-items-center gap-3">@HospitalUi.Avatar(r.PatientPhoto, DisplayName.Of(r.PatientName ?? "", r.PatientNameEn), 35)<div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = pid })" class="text-gray-900 fw-bold text-hover-primary">@DisplayName.Of(r.PatientName ?? "", r.PatientNameEn)</a><span class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn</span></div></div>} else {<span class="text-muted fs-7">@T["{0} files in the day", a.Count]</span>}</td>
                                <td><span class="badge badge-light-danger fs-8">@T["pk:" + a.Kind]</span>@if (a.PatientId != null && a.Count > 1) {<div class="text-muted fs-8 hp-num">×@a.Count</div>}</td>
                                <td class="hp-num fs-7" dir="ltr">@a.Day.ToString("dd/MM/yyyy", inv)</td>
                                <td>@if (a.Status != HospitalPrivacyStatus.Open) {<span class="badge badge-light-@(a.Status == HospitalPrivacyStatus.Confirmed ? "danger" : "primary") fs-8">@T["ps:" + a.Status]</span><div class="text-muted fs-8" dir="auto">@a.Note</div>@if (r.Reviewer is { } rv) {<div class="d-flex align-items-center gap-1 mt-1">@HospitalUi.Avatar(rv.Photo, DisplayName.Of(rv.Name ?? "", rv.NameEn), 20)<span class="text-muted fs-9">@DisplayName.Of(rv.Name ?? "", rv.NameEn)</span></div>}}</td>
                                <td class="text-end text-nowrap">@if (a.Status == HospitalPrivacyStatus.Open)
                                    {
                                        <button type="button" class="btn btn-sm btn-light-primary" data-pv="@a.ID" data-s="Cleared">@T["Clear"]</button>
                                        <button type="button" class="btn btn-sm btn-light-danger ms-1" data-pv="@a.ID" data-s="Confirmed">@T["Confirm"]</button>
                                    }</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination mt-6">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>
@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Privacy/"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), clear: @Json.Serialize(T["What explains this access?"].Value), confirm: @Json.Serialize(T["What was found, and what follows?"].Value) };
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-pv]'); if (!t) return;
                var s = t.getAttribute('data-s');
                cbPrompt(s === 'Cleared' ? W.clear : W.confirm, { kind: s === 'Cleared' ? 'primary' : 'danger', textarea: true }).then(function (v) {
                    if (!v) return;
                    fetch(root + t.getAttribute('data-pv'), { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify({ status: s, note: v }) })
                        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
                        .then(function (res) { if (!res.ok) { toastr.error(res.error || W.failed); return; } location.reload(); });
                });
            });
        })();
    </script>
}
