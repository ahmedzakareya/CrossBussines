@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalVaccineDueRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    var today = HospitalNursingService.UtcToWard(DateTime.UtcNow).Date;
    string AgeOf(DateTime b) { var m = (today.Year - b.Year) * 12 + today.Month - b.Month - (today.Day < b.Day ? 1 : 0); return m < 1 ? string.Format(T["{0} days"].Value, (today - b.Date).Days) : m < 24 ? string.Format(T["{0} month(s)"].Value, m) : string.Format(T["{0} year(s)"].Value, m / 12); }
}
@foreach (var r in Model)
{
    string tone = r.Status == HospitalImmunizationStatus.Overdue ? "badge-light-danger" : r.Status == HospitalImmunizationStatus.Due ? "badge-light-primary" : "badge-light";
    <tr>
        <td><a href="@Url.Action("PatientVaccines", new { id = r.PatientId })" class="fw-bold text-gray-900 text-hover-primary">@DisplayName.Of(r.Name, r.NameEn)</a>
            <div class="text-muted fs-8"><bdi class="hp-num">@r.Mrn</bdi>@if (r.Phone != null) {<text> · <bdi class="hp-num" dir="ltr">@r.Phone</bdi></text>}</div></td>
        <td class="fs-8">@AgeOf(r.BirthDate)</td>
        <td><span class="fw-semibold text-gray-800">@DisplayName.Of(r.Vaccine, r.VaccineEn)</span> <span class="text-muted fs-8">· @T["Dose {0}", r.DoseNo]</span></td>
        <td class="hp-num text-nowrap">@r.DueOn.ToString("yyyy-MM-dd")@if (r.DaysLate > 0) {<div class="fs-9 @(r.Status == HospitalImmunizationStatus.Overdue ? "text-danger fw-bold" : "text-muted")">@T["{0} days late", r.DaysLate]</div>}</td>
        <td><span class="badge @tone">@T["vxs:" + r.Status]</span></td>
        <td class="text-end"><a href="@Url.Action("PatientVaccines", new { id = r.PatientId })" class="btn btn-sm btn-light-primary text-nowrap">@T["Open the card"]</a></td>
    </tr>
}
