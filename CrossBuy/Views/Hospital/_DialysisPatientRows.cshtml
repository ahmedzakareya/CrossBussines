@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@model IReadOnlyList<HospitalDialysisPatientRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H128 — the dialysis patients' rows in the theme's table widget (demo39 widgets/tables): the patient over a muted
    line, the days over the shift, the prescription over its detail, the last Kt/V and the missed days as badges, and an
    icon button to open.
*@
@{
    var names = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.AbbreviatedDayNames;
    string Days(int mask) => string.Join(" · ", Enumerable.Range(0, 7).Where(i => (mask & (1 << i)) != 0).Select(i => names[i]));
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}
@foreach (var r in Model)
{
    var p = r.Plan;
    <tr>
        <td class="ps-4"><div class="d-flex align-items-center">
            <div class="symbol symbol-40px symbol-circle me-3 flex-shrink-0"><span class="symbol-label bg-light-primary text-primary fw-bold fs-7">@HospitalUi.Initials(r.NameEn)</span></div>
            <div class="d-flex flex-column"><a href="@Url.Action("DialysisPatient", new { patientId = p.PatientId })" class="text-gray-900 fw-bold text-hover-primary fs-6">@DisplayName.Of(r.Name, r.NameEn)</a>
                <span class="text-gray-500 fw-semibold fs-7"><bdi class="hp-num">@r.Mrn</bdi></span></div>
        </div></td>
        <td class="text-nowrap"><span class="text-gray-800 fw-bold fs-7 d-block">@Days(p.DaysMask)</span><span class="text-gray-500 fw-semibold fs-7">@T["Shift {0}", p.Shift]</span></td>
        <td><span class="text-gray-800 fw-bold fs-7 d-block">@T["dxa:" + p.Access] · <span class="text-nowrap">@T["{0} h", (p.DurationMin / 60m).ToString("0.#")]</span></span>
            <span class="text-gray-500 fw-semibold fs-7">@T["Dry weight"] <bdi class="hp-num" dir="ltr">@p.DryWeightKg.ToString("0.0")&nbsp;kg</bdi> · <bdi class="hp-num" dir="ltr">Qb&nbsp;@p.BloodFlow</bdi></span></td>
        <td><span class="text-gray-800 fw-bold fs-6 hp-num text-nowrap">@(r.LastSession?.ToString("yyyy-MM-dd") ?? "—")</span></td>
        <td>@if (r.LastKtV is decimal k) {<span class="badge badge-light-@(k < HospitalDialysisRules.MinKtV ? "danger" : "success") fs-7 fw-bold hp-num" dir="ltr">@k.ToString("0.00")</span>} else {<span class="text-gray-400">—</span>}</td>
        <td>@if (r.Missed30 > 0) {<span class="badge badge-light-danger fs-7 fw-bold hp-num">@r.Missed30</span>} else {<span class="badge badge-light-success fs-7 fw-bold hp-num">0</span>}</td>
        <td>@if (r.LastWarnings.Count == 0) {<span class="text-gray-400">—</span>} else {<div class="d-flex flex-wrap gap-1">@foreach (var w in r.LastWarnings) {<span class="badge badge-light-danger fs-8 fw-bold">@T["dxw:" + w]</span>}</div>}</td>
        <td class="text-end pe-4"><a href="@Url.Action("DialysisPatient", new { patientId = p.PatientId })" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" title="@T["Open"]" data-bs-toggle="tooltip"><i class="ki-outline ki-arrow-@(isAr ? "left" : "right") fs-2"></i></a></td>
    </tr>
}
