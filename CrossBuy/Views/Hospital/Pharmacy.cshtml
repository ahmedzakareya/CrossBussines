@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalRxRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Pharmacy (module)"].Value;
    var stats = (HospitalPharmacyStats)ViewBag.Stats;
    var sel = ViewBag.Selected as HospitalRxView;
    var settings = (HospitalPharmacySettings)ViewBag.Settings;
    var warehouses = (ViewBag.Warehouses as IReadOnlyList<(int Id, string Code, string Name, string? NameEn)>) ?? Array.Empty<(int, string, string, string?)>();
    string? status = ViewBag.Status as string;
    bool canPharmacy = ViewBag.CanPharmacy == true, canManage = ViewBag.CanManage == true;
    string Src(string s) => s == HospitalDispenseSource.Inpatient ? T["Inpatient"].Value : s == HospitalDispenseSource.Emergency ? T["Emergency"].Value
        : s == HospitalDispenseSource.Oncology ? T["Oncology"].Value : T["Outpatient"].Value;   // H120: a chemotherapy cycle's drugs
    string St(string s) => s switch { "New" => "<span class=\"badge badge-light fs-8\">" + T["rx:New"].Value + "</span>", "Verified" => "<span class=\"badge badge-light-primary fs-8\">" + T["rx:Verified"].Value + "</span>",
        "Rejected" => "<span class=\"badge badge-light-dark fs-8\">" + T["rx:Rejected"].Value + "</span>",
        "Partial" => "<span class=\"badge badge-light-danger fs-8\">" + T["rx:Partial"].Value + "</span>",   // H145: some is still owed
        _ => "<span class=\"badge badge-light-primary fs-8\">" + T["rx:Dispensed"].Value + "</span>" };
    // H136: the priority as a badge (STAT solid red), and the review clock in hours and minutes
    string PriClass(string pr) => pr == HospitalRxPriority.Stat ? "badge-danger" : pr == HospitalRxPriority.Urgent ? "badge-light-danger" : "badge-light";
    string Dur(int m) => m < 60 ? string.Format(T["{0} min"].Value, m)
        : m >= 1440 ? (m / 60 % 24 == 0 ? string.Format(T["{0} d"].Value, m / 1440) : string.Format(T["{0} d {1} h"].Value, m / 1440, m / 60 % 24))
        : m % 60 == 0 ? string.Format(T["{0} h"].Value, m / 60) : string.Format(T["{0} h {1} min"].Value, m / 60, m % 60);
    var now = DateTime.UtcNow;
    var clinical = ViewBag.Clinical as HospitalRxClinical;
    var interventions = (ViewBag.Interventions as IReadOnlyList<HospitalInterventionView>) ?? Array.Empty<HospitalInterventionView>();
    string Money(decimal v) => v.ToString("N3", System.Globalization.CultureInfo.InvariantCulture);
    string WarnText(string w, HospitalRxLineView l) => w switch
    {
        HospitalPharmacyService.WarnAllergy => string.Format(T["{0} — the file records an allergy it mentions: {1}"].Value, l.Drug, string.Join(", ", HospitalPharmacyService.AllergiesIn(l.MatchText ?? l.Drug, sel?.Patient.Allergies))),
        HospitalPharmacyService.WarnDuplicate => string.Format(T["{0} is prescribed twice"].Value, l.Drug),
        HospitalPharmacyService.WarnInteraction => string.Format(T["{0} interacts with another medicine of this patient — see the drug-safety list"].Value, l.Drug),
        HospitalPharmacyService.WarnNotStocked => string.Format(T["{0} is not stocked — the patient buys it outside; it is not charged"].Value, l.Drug),
        HospitalPharmacyService.WarnShort => string.Format(T["{0}: the store holds {1}, the prescription asks {2}"].Value, l.Drug, HospitalUi.LabNum(l.OnHand ?? 0, 0), HospitalUi.LabNum(l.Line.Quantity, 0)),
        HospitalPharmacyService.WarnUnavailable => string.Format(T["{0} is withdrawn from the formulary and cannot be dispensed"].Value, l.Drug),
        HospitalPharmacyService.WarnNonFormulary => string.Format(T["{0} is off the formulary: {1}"].Value, l.Drug, l.Master?.RestrictionNote ?? ""),
        HospitalPharmacyService.WarnRestricted => string.Format(T["{0} is restricted: {1}"].Value, l.Drug, l.Master?.RestrictionNote ?? ""),
        HospitalPharmacyService.WarnHighAlert => string.Format(T["{0} is a high-alert medicine — a second pharmacist checks it before it leaves"].Value, l.Drug),
        HospitalPharmacyService.WarnLasa => string.Format(T["{0} is confused with {1} — read the label twice"].Value, l.Drug, l.Master?.LasaWith ?? ""),
        _ => string.Format(T["{0}: the batch that leaves first expires soon"].Value, l.Drug),
    };
    string Who(int? id) => id != null && sel != null && sel.People.TryGetValue(id.Value, out var n) ? n : "—";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Pharmacy (module)"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Pharmacy (module)"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("Formulary")" class="btn btn-sm btn-light btn-active-light-primary"><i class="ki-outline ki-book-open fs-4"></i>@T["Drug formulary"]</a>
            <a href="@Url.Action("PharmacyStock")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-package fs-4"></i>@T["Pharmacy stock"]</a>
            @if (canManage) { <button type="button" class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#pharmacySettings"><i class="ki-outline ki-setting-3 fs-4"></i>@T["Pharmacy settings"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (settings.WarehouseId == null)
        {
            <div class="notice d-flex rounded border border-dashed border-primary bg-light-primary p-6 mb-5">
                <i class="ki-outline ki-setting-3 fs-2tx text-primary me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Choose the pharmacy store"]</h4>
                    <div class="fs-6 text-gray-700">@T["Medicines are dispensed from one warehouse of the inventory. Choose it in the pharmacy settings before dispensing."]</div></div>
            </div>
        }

        @* H125/H136: the day's figures — demo39 stat tiles, the symbol above the figure *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Prescriptions waiting"].Value, stats.Waiting.ToString(), T["with the pharmacy now"].Value, "ki-capsule", "primary"),
                (T["Late for review"].Value, stats.Late.ToString(), T["past the priority's target"].Value, "ki-timer", stats.Late > 0 ? "danger" : "primary"),
                (T["Average dispense time"].Value, stats.AvgDispenseMinutes?.ToString() ?? "—", T["minutes, today"].Value, "ki-time", "info"),
                (T["Interventions this month"].Value, stats.Interventions.ToString(), stats.AcceptedPct is int ap ? string.Format(T["{0}% accepted by prescribers"].Value, ap) : T["no answer recorded yet"].Value, "ki-shield-tick", "primary"),
                (T["Near-expiry batches"].Value, stats.NearExpiry.ToString(), string.Format(T["within {0} days"].Value, stats.NearExpiryDays), "ki-calendar-remove", stats.NearExpiry > 0 ? "danger" : "primary") })
            {
                <div class="col-sm-6 col-xl"><div class="card card-flush h-100">
                    <div class="card-body d-flex flex-column justify-content-between pt-6 pb-0 px-6">
                        <div class="symbol symbol-45px mb-5"><span class="symbol-label bg-light-@s.Item5"><i class="ki-outline @s.Item4 fs-2x text-@s.Item5"></i></span></div>
                        <div class="d-flex flex-column">
                            <span class="fs-2hx fw-bold text-@(s.Item5 == "danger" ? "danger" : "gray-900") lh-1 ls-n2 hp-num">@s.Item2</span>
                            <span class="text-gray-500 pt-2 fw-semibold fs-6">@s.Item1</span>
                        </div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-3 pb-6 px-6">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500"><div class="bullet w-8px h-6px rounded-2 bg-@s.Item5 me-3 flex-shrink-0"></div><span>@s.Item3</span></div>
                    </div>
                </div></div>
            }
        </div>

        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Dispensing queue"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Every prescription a doctor signs arrives here"] · <span class="hp-num">@Model.Count</span></span>
                </h3>
                <div class="card-toolbar d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Pharmacy")" class="btn btn-sm @(status == null ? "btn-primary" : "btn-light")">@T["Open work"]</a>
                    @foreach (var st in HospitalDispenseStatus.All) { <a href="@Url.Action("Pharmacy", new { status = st })" class="btn btn-sm @(status == st ? "btn-primary" : "btn-light")">@T["rx:" + st]</a> }
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" data-filter class="form-control form-control-solid w-200px ps-12" placeholder="@T["Search..."]" /></div>
                </div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0) { <div class="text-center py-15"><i class="ki-outline ki-capsule fs-3x text-gray-300 d-block mb-4"></i><div class="fs-6 fw-semibold text-gray-600">@T["No prescriptions here."]</div></div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 w-125px rounded-start">@T["Prescription"]</th><th class="min-w-200px">@T["Patient"]</th><th>@T["Priority"]</th><th>@T["Review clock"]</th><th>@T["Source"]</th><th>@T["Items (count)"]</th><th>@T["Doctor"]</th><th class="pe-4 rounded-end">@T["State"]</th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in Model)
                            {
                                <tr data-row class="cursor-pointer @(sel?.Dispense.ID == r.Id ? "bg-light-primary" : "")" data-href="@(Url.Action("Pharmacy", new { rx = r.Id, status }))#rx-detail">
                                    <td class="ps-4"><a href="@(Url.Action("Pharmacy", new { rx = r.Id, status }))#rx-detail" class="text-gray-900 fw-bold text-hover-primary fs-6 hp-num">@r.RxNo</a></td>
                                    <td><div class="d-flex align-items-center gap-3">
                                        <div class="symbol symbol-35px symbol-circle flex-shrink-0">@if (r.PatientPhoto != null) {<img src="@r.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                        <div class="d-flex flex-column"><a href="@Url.Action("Patient", new { id = r.PatientId })" class="text-gray-900 fw-bold fs-6 text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><span class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</span></div></div></td>
                                    @{ int waited = HospitalReviewRules.WaitingMinutes(r.PrescribedAt, r.ReviewedAt, now); bool late = waited > HospitalRxPriority.TargetMinutes(r.Priority); bool waiting = r.Status == HospitalDispenseStatus.New; }
                                    <td><span class="badge @PriClass(r.Priority) fs-7 fw-bold">@T["rxp:" + r.Priority]</span></td>
                                    <td>@if (r.Status == HospitalDispenseStatus.New || r.Status == HospitalDispenseStatus.Verified)
                                        {<span class="badge badge-light-@(late ? "danger" : "primary") fs-7 fw-bold text-nowrap"><i class="ki-outline ki-timer fs-7 me-1 text-@(late ? "danger" : "primary")"></i>@Dur(waited)</span>
                                         <span class="text-muted fs-8 d-block mt-1">@(waiting ? string.Format(T["target {0}"].Value, Dur(HospitalRxPriority.TargetMinutes(r.Priority))) : T["reviewed"].Value)</span>}
                                        else {<span class="text-gray-400">—</span>}</td>
                                    <td><span class="badge badge-light-@(r.Source == HospitalDispenseSource.Oncology ? "info" : r.Source == HospitalDispenseSource.Inpatient ? "primary" : r.Source == HospitalDispenseSource.Emergency ? "danger" : "primary") fs-7 fw-bold">@Src(r.Source)</span></td>
                                    <td><span class="text-gray-800 fw-bold hp-num">@r.Items</span></td>
                                    <td>@if (r.Doctor != null) {<div class="d-flex align-items-center gap-2">
                                        <div class="symbol symbol-30px symbol-circle flex-shrink-0">@if (r.DoctorPhoto != null) {<img src="@r.DoctorPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.DoctorEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(r.DoctorEn)</span>}</div>
                                        <span class="fs-7 text-gray-800">@DisplayName.Of(r.Doctor, r.DoctorEn)</span></div>} else {<span class="text-muted">—</span>}</td>
                                    <td class="pe-4">@Html.Raw(St(r.Status))@if (r.HasWarning) {<span class="badge badge-light-danger fs-8 fw-bold ms-1"><i class="ki-outline ki-shield-cross fs-8 text-danger me-1"></i>@T["Check"]</span>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        @if (sel != null)
        {
            var d = sel.Dispense; var p = sel.Patient;
            var warnings = sel.Lines.SelectMany(l => l.Warnings.Select(w => (w, l))).ToList();
            <div class="row g-5 g-xl-8" id="rx-detail" style="scroll-margin-top:90px">
                <div class="col-xl-8">
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-800">@T["Dispense"] <bdi class="text-primary hp-num ms-1">@d.RxNo</bdi></span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7"><a href="@Url.Action("Patient", new { id = p.ID })" class="text-gray-700 text-hover-primary">@DisplayName.Of(p.Name, p.NameEn)</a> · <span class="hp-num">@p.Mrn</span> · @(sel.PriceListName ?? T["Main price list"].Value)@if (sel.BillNo != null) {<text> · </text><span class="text-nowrap"><i class="ki-outline ki-bill fs-7"></i> @(sel.OnStay ? T["The stay's bill"] : T["Bill"]) <bdi class="hp-num">@sel.BillNo</bdi></span>}</span>
                            </h3>
                            @{ var pri = HospitalRxPriority.Effective(d.Priority, d.Source); int selWait = HospitalReviewRules.WaitingMinutes(d.PrescribedAt, d.VerifiedAt ?? d.RejectedAt, now); bool selLate = selWait > HospitalRxPriority.TargetMinutes(pri); }
                            <div class="card-toolbar gap-2"><span class="badge @PriClass(pri) fs-7 fw-bold">@T["rxp:" + pri]</span>
                                @if (d.Status != HospitalDispenseStatus.Dispensed && d.Status != HospitalDispenseStatus.Rejected) {<span class="badge badge-light-@(selLate ? "danger" : "primary") fs-7 fw-bold"><i class="ki-outline ki-timer fs-7 me-1 text-@(selLate ? "danger" : "primary")"></i>@Dur(selWait)</span>}
                                <span class="badge badge-light fs-7 fw-bold">@Src(d.Source)</span>@Html.Raw(St(d.Status))</div>
                        </div>
                        <div class="card-body pt-2">
                            @if (warnings.Count > 0 && d.Status != HospitalDispenseStatus.Dispensed && d.Status != HospitalDispenseStatus.Rejected)
                            {
                                <div class="notice d-flex rounded border border-dashed border-danger bg-light-danger p-5 mb-5">
                                    <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                                    <div class="fw-semibold flex-grow-1">
                                        <h4 class="text-gray-900 fw-bold mb-2">@T["Check before dispensing"]</h4>
                                        @foreach (var (w, l) in warnings)
                                        {
                                            <div class="d-flex align-items-center fs-7 text-gray-800 mb-2">
                                                <span class="bullet bullet-dot bg-danger h-6px w-6px me-3 flex-shrink-0"></span><span>@WarnText(w, l)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @{ bool giving = HospitalDispenseStatus.Dispensable(d.Status) && canPharmacy; }
                            @{ var returnedQ = ViewBag.Returned as Dictionary<int, decimal> ?? new(); var returnRows = ViewBag.Returns as IReadOnlyList<HospitalReturnView> ?? Array.Empty<HospitalReturnView>(); }   @* H145: the quantity to give now *@
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light">
                                    <th class="ps-4 min-w-200px rounded-start">@T["Item"]</th><th>@T["Batch"]</th><th>@T["Expiry"]</th><th class="text-end">@T["Qty"]</th><th class="text-end">@T["On hand"]</th>
                                    @if (giving) {<th class="text-end w-100px">@T["Give now"]</th>}
                                    <th class="text-end pe-4 rounded-end">@T["Amount"]</th>
                                </tr></thead>
                                <tbody class="fw-semibold text-gray-700">
                                    @foreach (var l in sel.Lines)
                                    {
                                        var dispensed = d.Status == HospitalDispenseStatus.Dispensed || d.Status == HospitalDispenseStatus.Partial;
                                        var owed = HospitalPartialDispenseRules.Owed(l.Line);
                                        var batch = dispensed ? l.Line.Batches : l.NextBatch;
                                        var exp = dispensed ? l.Line.NearestExpiry : l.NextExpiry;
                                        <tr>
                                            <td class="ps-4"><div class="d-flex align-items-center">
                                                <div class="symbol symbol-40px me-3 flex-shrink-0"><span class="symbol-label bg-light-@(l.Line.ItemId == null ? "danger" : l.Warnings.Count > 0 ? "danger" : "primary")"><i class="ki-outline ki-capsule fs-2 text-@(l.Line.ItemId == null || l.Warnings.Count > 0 ? "danger" : "primary")"></i></span></div>
                                                <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi>@l.Drug</bdi> @if (l.Line.ItemId == null) {<span class="badge badge-light-danger fs-8 fw-bold ms-1">@T["Not stocked"]</span>}</span>
                                                    @if (l.Master is { } dm)
                                                    {
                                                        @* H133: the generic as the formulary spells it (Tall Man), its strength and form, and its flags *@
                                                        <span class="text-gray-700 fw-semibold fs-7 d-flex flex-wrap align-items-center gap-1"><bdi dir="ltr">@HospitalDrugRules.Shown(dm)</bdi>@if (HospitalDrugRules.StrengthText(dm) is string st) {<span class="text-muted">· <bdi dir="ltr" class="hp-num">@st</bdi></span>}@if (dm.Form != null) {<span class="text-muted">· @T["form:" + dm.Form]</span>}
                                                            @if (dm.HighAlert) {<span class="badge badge-danger fs-9 fw-bold">@T["High-alert"]</span>}
                                                            @if (dm.LasaWith != null) {<span class="badge badge-light-danger fs-9 fw-bold">LASA</span>}
                                                            @if (dm.ControlledSchedule != null) {<span class="badge badge-light-dark fs-9 fw-bold">@T["sched:" + dm.ControlledSchedule]</span>}
                                                            @if (dm.FormularyStatus != HospitalFormularyStatus.Formulary) {<span class="badge badge-light-danger fs-9 fw-bold">@T["fstat:" + dm.FormularyStatus]</span>}</span>
                                                    }
                                                    @if (l.Instructions != null) {<span class="text-muted fw-semibold d-block fs-7"><bdi>@l.Instructions</bdi></span>}
                                                    @{ var back = returnedQ.GetValueOrDefault(l.Line.ID); var canBack = dispensed && canPharmacy && l.Line.ItemId != null && HospitalReturnRules.Returnable(l.Line, back) > 0; }
                                                    @if (back > 0) {<span class="text-primary fw-semibold d-block fs-8">@string.Format(T["{0} returned"].Value, HospitalUi.LabNum(back, 0))</span>}
                                                    @if (canBack) {<a href="#" class="fw-bold fs-8" data-return-line="@l.Line.ID" data-id="@d.ID" data-max="@HospitalReturnRules.Returnable(l.Line, back).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-drug="@l.Drug"><i class="ki-outline ki-arrow-circle-left fs-7 me-1"></i>@T["Patient returned some"]</a>}</div></div></td>
                                            <td>@if (batch != null) {<span class="badge badge-light fs-7 fw-bold hp-num">@batch</span>} else {<span class="text-muted">—</span>}</td>
                                            <td class="hp-num fs-7 @(l.Warnings.Contains(HospitalPharmacyService.WarnNearExpiry) ? "text-danger fw-bold" : "")">@(exp?.ToString("yyyy-MM") ?? "—")</td>
                                            <td class="text-end"><span class="text-gray-900 fw-bold hp-num">@HospitalUi.LabNum(l.Line.DispensedQty ?? l.Line.Quantity, 0)</span>
                                                @if (l.Line.DispensedQty != null && owed > 0) {<span class="d-block text-danger fw-bold fs-8 text-nowrap">@string.Format(T["{0} of {1} given"].Value, HospitalUi.LabNum(l.Line.DispensedQty, 0), HospitalUi.LabNum(l.Line.Quantity, 0))</span>}</td>
                                            <td class="text-end hp-num text-gray-600 @(l.Warnings.Contains(HospitalPharmacyService.WarnShort) ? "text-danger fw-bold" : "")">@(l.OnHand == null ? "—" : HospitalUi.LabNum(l.OnHand, 0))</td>
                                            @if (giving)
                                            {
                                                <td class="text-end">@if (l.Line.ItemId != null && owed > 0) {<input type="number" min="0" max="@owed.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="any" class="form-control form-control-sm form-control-solid text-end hp-num w-80px ms-auto" data-give="@l.Line.ID" value="@Math.Min(owed, Math.Max(0, l.OnHand ?? 0)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />} else {<span class="text-muted">—</span>}</td>
                                            }
                                            <td class="text-end pe-4"><span class="text-gray-900 fw-bold hp-num">@(l.Line.ItemId == null || l.Price == null ? "—" : Money(l.Price.Value * (l.Line.DispensedQty ?? l.Line.Quantity)))</span></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot><tr class="border-top border-dashed"><td colspan="@(giving ? 6 : 5)" class="ps-4 pt-5"><span class="text-gray-800 fw-bold fs-5">@T["Patient pays"]</span> @if (sel.CurrencyLabel != null) {<span class="text-muted fw-semibold fs-7">(@sel.CurrencyLabel)</span>}</td>
                                    <td class="text-end pe-4 pt-5"><span class="fs-2 fw-bold text-primary hp-num">@Money(sel.Total - returnRows.Sum(x => x.Return.Credited))</span></td></tr></tfoot>
                            </table></div>
                            @if (returnRows.Count > 0)
                            {
                                @* H146: what the patient brought back — back on the shelf, off the bill *@
                                <div class="separator separator-dashed my-5"></div>
                                <div class="fw-bold text-gray-800 fs-6 mb-3">@T["Returned by the patient"]</div>
                                @foreach (var rr in returnRows)
                                {
                                    var rl = sel.Lines.FirstOrDefault(x => x.Line.ID == rr.Return.LineId);
                                    <div class="d-flex flex-stack flex-wrap gap-2 py-2 border-bottom border-dashed">
                                        <div class="d-flex flex-column"><span class="text-gray-800 fw-bold fs-7"><bdi>@(rl?.Drug ?? "—")</bdi> · <span class="hp-num">@HospitalUi.LabNum(rr.Return.Quantity, 0)</span></span>
                                            <span class="text-muted fs-8"><bdi>@rr.Return.Reason</bdi> · @(rr.By ?? "—") · <span class="hp-num" data-fmt data-utc="@rr.Return.At.ToString("o")">@rr.Return.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></span></div>
                                        <div class="text-end"><span class="fw-bold hp-num">−@Money(rr.Return.Credited)</span>@if (rr.Return.DepositId != null) {<span class="badge badge-light-primary fs-8 fw-bold d-block mt-1">@T["Credit to the patient's deposit"]</span>}</div>
                                    </div>
                                }
                            }
                            <div class="d-flex flex-wrap gap-2 align-items-center mt-5">
                                <span class="badge badge-light-primary fs-7 fw-semibold py-2 px-3"><i class="ki-outline ki-arrows-loop fs-6 text-primary me-2"></i>@T["Inventory — nearest-expiry batch first (FEFO)"]</span>
                                @if (sel.WarehouseName != null) { <span class="badge badge-light fs-7 fw-semibold py-2 px-3"><i class="ki-outline ki-shop fs-6 me-2"></i><bdi>@sel.WarehouseName</bdi></span> }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    @* H136: what the review weighs — demo39's account-overview details list *@
                    @if (clinical != null)
                    {
                        string eTone = clinical.Egfr == null ? "gray-500" : clinical.Egfr.Value < 30 ? "danger" : clinical.Egfr.Value < 60 ? "primary" : "primary";
                        <div class="card card-flush mb-5">
                            <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Clinical picture"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["What the review weighs"]</span></h3></div>
                            <div class="card-body pt-2">
                                @{ var facts = new List<(string Icon, string Tone, string Label, string Value, string? Sub)> {
                                    ("ki-profile-circle", "primary", T["Age and sex"].Value, (clinical.AgeYears is int ag ? string.Format(T["{0} years"].Value, ag) + " · " : "") + T["sex:" + clinical.Sex].Value, clinical.Admitted ? T["In hospital now"].Value : null),
                                    ("ki-chart-simple", "info", T["Weight"].Value, clinical.WeightKg is decimal kg ? kg.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " " + T["kg"].Value : T["Not recorded"].Value, clinical.WeightAt?.ToLocalTime().ToString("yyyy-MM-dd")),
                                    ("ki-drop", eTone, "eGFR", clinical.Egfr is HospitalEgfr eg ? eg.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) + " mL/min" : T["Not recorded"].Value,
                                        clinical.Egfr is HospitalEgfr eg2 ? eg2.At.ToLocalTime().ToString("yyyy-MM-dd") + (eg2.Previous is decimal pv ? " · " + string.Format(T["was {0}"].Value, pv.ToString("0", System.Globalization.CultureInfo.InvariantCulture)) : "") : null) }; }
                                @for (int i = 0; i < facts.Count; i++)
                                {
                                    var f = facts[i];
                                    <div class="d-flex flex-stack">
                                        <div class="d-flex align-items-center me-3"><div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@(f.Tone == "gray-500" ? "secondary" : f.Tone)"><i class="ki-outline @f.Icon fs-3 text-@f.Tone"></i></span></div>
                                            <span class="text-gray-600 fw-semibold fs-7">@f.Label</span></div>
                                        <div class="text-end"><span class="text-gray-900 fw-bold fs-6 hp-num d-block" dir="auto">@f.Value</span>@if (f.Sub != null) {<span class="text-muted fs-8 hp-num">@f.Sub</span>}</div>
                                    </div>
                                    <div class="separator separator-dashed my-3"></div>
                                }
                                <div class="d-flex align-items-start">
                                    <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@(clinical.Allergies != null ? "danger" : "primary")"><i class="ki-outline ki-shield-cross fs-3 text-@(clinical.Allergies != null ? "danger" : "primary")"></i></span></div>
                                    <div class="d-flex flex-column"><span class="text-gray-600 fw-semibold fs-7 mb-1">@T["Allergies"]</span>
                                        @if (clinical.Allergies != null) {<div class="d-flex flex-wrap gap-1">@foreach (var a in HospitalAllergyText.Display(clinical.Allergies).Split(new[] { '\n', ',', '،', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) {<span class="badge badge-light-danger fs-7 fw-bold"><bdi>@a</bdi></span>}</div>}
                                        else {<span class="text-gray-800 fw-bold fs-7">@T["None recorded"]</span>}</div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Pharmacist's review"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@Html.Raw(St(d.Status))</span></h3>
                        </div>
                        <div class="card-body pt-2">
                            @if ((d.Status == HospitalDispenseStatus.New || d.Status == HospitalDispenseStatus.Verified) && canPharmacy)
                            {
                                <label class="fs-6 fw-semibold mb-2">@T["Priority"]</label>
                                <select class="form-select form-select-solid mb-2" data-priority data-id="@d.ID" data-hide-search="true">@foreach (var pr in HospitalRxPriority.All) { <option value="@pr" selected="@(pr == pri)">@T["rxp:" + pr] (@Dur(HospitalRxPriority.TargetMinutes(pr)))</option> }</select>
                                <div class="text-muted fs-8 mb-6">@string.Format(T["review within {0}"].Value, Dur(HospitalRxPriority.TargetMinutes(pri))) · @string.Format(T["Waiting {0} since it was prescribed"].Value, Dur(selWait))</div>
                            }
                            @if (d.Status == HospitalDispenseStatus.New && canPharmacy)
                            {
                                <label class="fs-6 fw-semibold mb-2">@T["Pharmacist's note (optional)"]</label>
                                <textarea class="form-control form-control-solid mb-5" rows="3" maxlength="400" data-note placeholder="@T["Pharmacist's note (optional)"]"></textarea>
                                <button type="button" class="btn btn-light-primary w-100 mb-3" data-step="Verify" data-id="@d.ID" data-confirm="@string.Format(T["Mark prescription {0} as reviewed?"].Value, d.RxNo)"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Reviewed by the pharmacist"]</button>
                                <button type="button" class="btn btn-light-danger w-100" data-reject="@d.ID" data-ask="@string.Format(T["Why is prescription {0} refused? It will not be dispensed."].Value, d.RxNo)"><i class="ki-outline ki-cross-circle fs-4"></i>@T["Refuse the prescription"]</button>
                            }
                            else if (HospitalDispenseStatus.Dispensable(d.Status) && canPharmacy)
                            {
                                @if (d.Status == HospitalDispenseStatus.Partial)
                                {
                                    <div class="notice d-flex rounded border border-dashed border-danger bg-light-danger p-4 mb-5">
                                        <i class="ki-outline ki-time fs-2tx text-danger me-3"></i>
                                        <div class="fw-semibold"><div class="fs-6 text-gray-900 fw-bold">@T["Partly dispensed"]</div>
                                            <div class="fs-7 text-gray-700">@T["The rest is owed to the patient: give it when the stock arrives."]</div>
                                            @if (d.BillId != null) { <a href="@Url.Action("Bill", new { id = d.BillId })" class="fw-bold fs-7">@T["Open the bill"]</a> }</div>
                                    </div>
                                }
                                @if (d.PharmacistNote != null) { <div class="d-flex align-items-start bg-light rounded p-4 mb-5"><i class="ki-outline ki-message-text fs-3 text-gray-500 me-3"></i><div class="fs-7 text-gray-700"><div class="fw-bold text-gray-800 mb-1">@Who(d.VerifiedByEmployeeId)</div><bdi>@d.PharmacistNote</bdi></div></div> }
                                <button type="button" class="btn btn-primary w-100 mb-3" data-step="Dispense" data-id="@d.ID" data-confirm="@string.Format(T["Dispense {0} to {1}? The stock leaves the pharmacy store and the items are charged on the bill."].Value, d.RxNo, DisplayName.Of(p.Name, p.NameEn))"><i class="ki-outline ki-check fs-4"></i>@(d.Status == HospitalDispenseStatus.Partial ? T["Dispense what is owed"] : T["Confirm dispensing"])</button>
                                <button type="button" class="btn btn-light-danger w-100" data-reject="@d.ID" data-ask="@string.Format(T["Why is prescription {0} refused? It will not be dispensed."].Value, d.RxNo)"><i class="ki-outline ki-cross-circle fs-4"></i>@T["Refuse the prescription"]</button>
                            }
                            else if (d.Status == HospitalDispenseStatus.Dispensed)
                            {
                                <div class="notice d-flex rounded border border-dashed border-primary bg-light-primary p-5">
                                    <i class="ki-outline ki-check-circle fs-2tx text-primary me-4"></i>
                                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Dispensed"]</h4>
                                        <div class="fs-7 text-gray-700">@Who(d.DispensedByEmployeeId) · <span class="hp-num" data-fmt data-utc="@d.DispensedAt?.ToString("o")">@d.DispensedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div>
                                        @if (d.BillId != null) { <a href="@Url.Action("Bill", new { id = d.BillId })" class="fw-bold fs-7">@T["Open the bill"]</a> }</div>
                                </div>
                            }
                            else if (d.Status == HospitalDispenseStatus.Rejected)
                            {
                                <div class="notice d-flex rounded border border-dashed border-danger bg-light-danger p-5">
                                    <i class="ki-outline ki-cross-circle fs-2tx text-danger me-4"></i>
                                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Refused by the pharmacist"]</h4>
                                        <div class="fs-7 text-gray-800 mb-1"><bdi>@d.RejectReason</bdi></div>
                                        <div class="fs-8 text-gray-600">@Who(d.RejectedByEmployeeId) · <span class="hp-num" data-fmt data-utc="@d.RejectedAt?.ToString("o")">@d.RejectedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div></div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-6"><i class="ki-outline ki-lock fs-3x text-gray-300 d-block mb-3"></i><div class="fs-7 fw-semibold text-gray-600">@T["Waiting for the pharmacist"]</div></div>
                            }
                        </div>
                    </div>

                    @* H136: the pharmacist's interventions — demo39's timeline-style list, each with its answer *@
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Pharmacist interventions"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Problems raised with the prescriber, and the answer"]</span></h3>
                            @if (canPharmacy) {<div class="card-toolbar"><button type="button" class="btn btn-sm btn-icon btn-light-primary" data-bs-toggle="modal" data-bs-target="#ivModal" title="@T["Record an intervention"]"><i class="ki-outline ki-plus fs-3"></i></button></div>}
                        </div>
                        <div class="card-body pt-2">
                            @if (interventions.Count == 0)
                            {
                                <div class="text-center py-6"><i class="ki-outline ki-shield-tick fs-3x text-gray-300 d-block mb-3"></i><div class="fs-7 fw-semibold text-gray-600">@T["No intervention on this prescription."]</div></div>
                            }
                            @for (int i = 0; i < interventions.Count; i++)
                            {
                                var v = interventions[i]; var iv = v.I;
                                string sevTone = iv.Severity == HospitalInterventionSeverity.High ? "danger" : iv.Severity == HospitalInterventionSeverity.Moderate ? "primary" : "info";
                                <div class="d-flex flex-column">
                                    <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                                        <span class="badge badge-light-@sevTone fs-8 fw-bold">@T["ivs:" + iv.Severity]</span>
                                        <span class="badge badge-light fs-8 fw-bold">@T["ivc:" + iv.Category]</span>
                                        @if (iv.Drug != null) {<span class="text-gray-800 fw-bold fs-7"><bdi>@iv.Drug</bdi></span>}
                                    </div>
                                    <div class="text-gray-800 fs-7 mb-1"><bdi dir="auto">@iv.Problem</bdi></div>
                                    <div class="text-gray-600 fs-7 mb-2"><i class="ki-outline ki-arrow-right fs-8 text-primary me-1"></i><bdi dir="auto">@iv.Recommendation</bdi></div>
                                    <div class="d-flex flex-stack flex-wrap gap-2">
                                        <div class="d-flex align-items-center">
                                            <div class="symbol symbol-25px symbol-circle me-2">@if (v.RecordedByPhoto != null) {<img src="@v.RecordedByPhoto" alt="" style="object-fit:cover" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(v.RecordedByEn ?? v.RecordedBy)</span>}</div>
                                            <span class="text-muted fs-8"><span>@DisplayName.Of(v.RecordedBy ?? "—", v.RecordedByEn)</span> · <span class="hp-num" data-fmt data-utc="@iv.RecordedAt.ToString("o")">@iv.RecordedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>@if (iv.Minutes is int mn) {<text> · </text><span class="hp-num">@string.Format(T["{0} min"].Value, mn)</span>}</span>
                                        </div>
                                        @if (iv.Outcome == HospitalInterventionOutcome.Pending && canPharmacy)
                                        {
                                            <div class="d-flex gap-1">
                                                <button type="button" class="btn btn-sm btn-light-primary py-1 px-3 fs-8" data-outcome="Accepted" data-iv="@iv.ID"><i class="ki-outline ki-check fs-7"></i>@T["Prescriber accepted"]</button>
                                                <button type="button" class="btn btn-sm btn-light-danger py-1 px-3 fs-8" data-outcome="Declined" data-iv="@iv.ID"><i class="ki-outline ki-cross fs-7"></i>@T["Prescriber declined"]</button>
                                            </div>
                                        }
                                        else {<span class="badge badge-light-@(iv.Outcome == HospitalInterventionOutcome.Accepted ? "primary" : iv.Outcome == HospitalInterventionOutcome.Declined ? "danger" : "secondary") fs-8 fw-bold">@T["ivo:" + iv.Outcome]</span>}
                                    </div>
                                </div>
                                if (i < interventions.Count - 1) { <div class="separator separator-dashed my-4"></div> }
                            }
                        </div>
                    </div>

                    @if (canPharmacy)
                    {
                        <div class="modal fade" id="ivModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
                            <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
                            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
                                <div class="mb-8 text-center"><h1 class="mb-2">@T["Record an intervention"]</h1><div class="text-muted fw-semibold fs-6"><bdi class="hp-num">@d.RxNo</bdi> · @DisplayName.Of(p.Name, p.NameEn)</div></div>
                                <div class="row g-6">
                                    <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["About"]</label>
                                        <select class="form-select form-select-solid" data-iv-k="lineId"><option value="">@T["The prescription as a whole"]</option>@foreach (var l in sel.Lines) { <option value="@l.Line.ID">@l.Drug</option> }</select></div>
                                    <div class="col-md-7"><label class="fs-6 fw-semibold mb-2 required">@T["Kind of problem"]</label>
                                        <select class="form-select form-select-solid" data-iv-k="category">@foreach (var c in HospitalInterventionCategory.All) { <option value="@c">@T["ivc:" + c]</option> }</select></div>
                                    <div class="col-md-5"><label class="fs-6 fw-semibold mb-2 required">@T["How serious"]</label>
                                        <select class="form-select form-select-solid" data-iv-k="severity" data-hide-search="true">@foreach (var sv in HospitalInterventionSeverity.All) { <option value="@sv" selected="@(sv == HospitalInterventionSeverity.Moderate)">@T["ivs:" + sv]</option> }</select></div>
                                    <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["The problem"]</label><textarea class="form-control form-control-solid" rows="2" maxlength="400" dir="auto" data-iv-k="problem"></textarea></div>
                                    <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["What you recommend"]</label><textarea class="form-control form-control-solid" rows="2" maxlength="400" dir="auto" data-iv-k="recommendation"></textarea></div>
                                    <div class="col-md-5"><label class="fs-6 fw-semibold mb-2">@T["Minutes spent"]</label><input type="number" min="0" max="600" step="1" class="form-control form-control-solid hp-num" data-iv-k="minutes" /></div>
                                </div>
                                <div class="text-center pt-10"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-iv-save="@d.ID"><i class="ki-outline ki-check fs-4"></i>@T["Save"]</button></div>
                            </div>
                        </div></div></div>
                    }
                    @* what dispensing does — demo39 dashboards/logistics list widget *@
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["On dispensing"]</span></h3></div>
                        <div class="card-body pt-2">
                            @{ var effects = new[] {
                                ("ki-minus-square", T["A stock issue from the pharmacy store"].Value, true),
                                ("ki-bill", T["A line on the visit's bill"].Value, true),
                                ("ki-printer", T["A dose label from Report Studio"].Value, false),
                                ("ki-message-text", T["A text message to the patient with the directions"].Value, false) }; }
                            @for (int i = 0; i < effects.Length; i++)
                            {
                                var (icon, text, live) = effects[i];
                                <div class="d-flex flex-stack">
                                    <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@(live ? "primary" : "secondary")"><i class="ki-outline @icon fs-3 text-@(live ? "primary" : "gray-500")"></i></span></div>
                                    <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                        <span class="@(live ? "text-gray-800" : "text-gray-500") fw-bold fs-6">@text</span>
                                        @if (live) {<span class="badge badge-light-primary fs-8 fw-bold"><i class="ki-outline ki-check fs-8 text-primary"></i></span>} else {<span class="badge badge-light fs-8">@T["Not connected yet"]</span>}
                                    </div>
                                </div>
                                if (i < effects.Length - 1) { <div class="separator separator-dashed my-3"></div> }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (canManage)
{
    <div class="modal fade" id="pharmacySettings" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
            <div class="mb-13 text-center"><h1 class="mb-3">@T["Pharmacy settings"]</h1>
                <div class="text-muted fw-semibold fs-5">@T["Medicines are dispensed from one warehouse of the inventory. Choose it in the pharmacy settings before dispensing."]</div></div>
            <div class="d-flex flex-column mb-8 fv-row">
                <label class="d-flex align-items-center fs-6 fw-semibold mb-2"><span class="required">@T["Pharmacy store (warehouse)"]</span></label>
                <select class="form-select form-select-solid" data-k="warehouseId" data-control="select2" data-dropdown-parent="#pharmacySettings">
                    <option value="">—</option>
                    @foreach (var w in warehouses) { <option value="@w.Id" selected="@(settings.WarehouseId == w.Id)">@w.Code · @DisplayName.Of(w.Name, w.NameEn)</option> }
                </select>
            </div>
            <div class="d-flex flex-column mb-8 fv-row">
                <label class="fs-6 fw-semibold mb-2">@T["A batch is near expiry within (days)"]</label>
                <input type="number" min="1" max="365" class="form-control form-control-solid hp-num" data-k="nearExpiryDays" value="@settings.NearExpiryDays" />
            </div>
            <div class="d-flex flex-column mb-8 fv-row">
                <label class="fs-6 fw-semibold mb-2">@T["Quarantine store (recalled or suspect batches)"]</label>
                <select class="form-select form-select-solid" data-k="quarantineWarehouseId" data-control="select2" data-dropdown-parent="#pharmacySettings">
                    <option value="">—</option>
                    @foreach (var w in warehouses) { <option value="@w.Id" selected="@(settings.QuarantineWarehouseId == w.Id)">@w.Code · @DisplayName.Of(w.Name, w.NameEn)</option> }
                </select>
                <div class="text-muted fs-7 mt-2">@T["A recalled batch is moved here from every store, out of reach of dispensing."]</div>
            </div>
            <div class="text-center pt-5"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-settings>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var base = @Json.Serialize(Url.Action("Pharmacy"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), dispensed: @Json.Serialize(T["Dispensed — the stock left the store and the bill was charged"].Value),
                retQty: @Json.Serialize(T["How much of {0} did the patient bring back? (up to {1})"].Value), retWhy: @Json.Serialize(T["Why did it come back? It goes back on the shelf only if it can be sold again."].Value),
                retAsk: @Json.Serialize(T["Put {0} of {1} back on the shelf and take it off the patient's bill?"].Value), returned: @Json.Serialize(T["Returned: back on the shelf and off the bill"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (fresh) { document.getElementById('kt_app_content').innerHTML = fresh.innerHTML; wire(); }
                });
            }
            // H136: content swapped in carries plain selects. The layout's enhancer ran at page load, so the theme's
            // dropdowns are set up here, and the interventions modal moves to the body so no card clips its backdrop.
            function s2(el, parent) {
                if (!window.jQuery || !jQuery.fn.select2 || jQuery(el).hasClass('select2-hidden-accessible')) return;
                jQuery(el).select2({ width: '100%', dir: document.documentElement.dir || 'rtl', minimumResultsForSearch: el.hasAttribute('data-hide-search') ? Infinity : 0, dropdownParent: parent ? jQuery(parent) : jQuery(document.body) });
            }
            function wire() {
                var fresh = document.querySelector('#kt_app_content #ivModal');
                if (fresh) { document.querySelectorAll('body > #ivModal').forEach(function (m) { m.remove(); }); document.body.appendChild(fresh); }
                var iv = document.getElementById('ivModal');
                if (iv) iv.querySelectorAll('select').forEach(function (el) { s2(el, iv); });
                var pri = document.querySelector('[data-priority]');
                if (pri && !pri.__wired) {
                    pri.__wired = true; s2(pri, null);
                    var onPri = function () { post(base + '/' + pri.getAttribute('data-id') + '/Priority', { priority: pri.value }).then(function (r) { if (!r.ok) { toast('error', r.error || W.failed); return; } toast('success', W.saved); swap(); }); };
                    if (window.CB && CB.onSelectChange) CB.onSelectChange(pri, onPri); else pri.addEventListener('change', onPri);
                }
            }
            wire();
            document.addEventListener('click', function (e) {
                var row = e.target.closest('tr[data-href]');
                if (row && !e.target.closest('a,button')) { location.href = row.getAttribute('data-href'); return; }
                // H136: refuse with the reason; the prescriber's answer to an intervention; a new intervention
                var rj = e.target.closest('[data-reject]');
                if (rj) { cbPrompt(rj.getAttribute('data-ask'), { kind: 'danger' }).then(function (why) { if (!why) return; rj.disabled = true;
                    post(base + '/' + rj.getAttribute('data-reject') + '/Reject', { reason: why }).then(function (r) { rj.disabled = false; if (!r.ok) { toast('error', r.error || W.failed); return; } toast('success', W.saved); swap(); }); }); return; }
                var oc = e.target.closest('[data-outcome]');
                if (oc) { oc.disabled = true; post(base + '/Interventions/' + oc.getAttribute('data-iv') + '/Outcome', { outcome: oc.getAttribute('data-outcome') })
                    .then(function (r) { oc.disabled = false; if (!r.ok) { toast('error', r.error || W.failed); return; } toast('success', W.saved); swap(); }); return; }
                var sv = e.target.closest('[data-iv-save]');
                if (sv) {
                    var m2 = document.getElementById('ivModal'), body = {};
                    m2.querySelectorAll('[data-iv-k]').forEach(function (i) { var k = i.getAttribute('data-iv-k'), v = i.value.trim();
                        body[k] = (k === 'lineId' || k === 'minutes') ? (v === '' ? null : Number(v)) : (v || null); });
                    sv.disabled = true;
                    post(base + '/' + sv.getAttribute('data-iv-save') + '/Interventions', body).then(function (r) { sv.disabled = false; if (!r.ok) { toast('error', r.error || W.failed); return; }
                        bootstrap.Modal.getOrCreateInstance(m2).hide(); toast('success', W.saved); swap(); });
                    return;
                }
                var rb = e.target.closest('[data-return-line]');
                if (rb) {
                    e.preventDefault(); var max = rb.getAttribute('data-max');
                    cbPrompt(W.retQty.replace('{0}', rb.getAttribute('data-drug')).replace('{1}', max), { number: true, value: max }).then(function (q) {
                        if (q == null) return; var qty = Number(String(q).replace(',', '.'));
                        cbPrompt(W.retWhy, { textarea: true }).then(function (why) {
                            if (why == null) return;
                            cbConfirm(W.retAsk.replace('{0}', qty).replace('{1}', rb.getAttribute('data-drug')), { kind: 'primary' }).then(function (ok) {
                                if (!ok) return;
                                post(base + '/' + rb.getAttribute('data-id') + '/Lines/' + rb.getAttribute('data-return-line') + '/Return', { quantity: qty, reason: why }).then(function (r) {
                                    if (!r.ok) { toast('error', r.error || W.failed); return; } toast('success', W.returned); swap(); });
                            });
                        });
                    });
                    return;
                }
                var t = e.target.closest('[data-step],[data-save-settings]'); if (!t) return;
                var msg = t.getAttribute('data-confirm');
                if (msg && !t.hasAttribute('data-confirmed')) { cbConfirm(msg).then(function (ok) { if (ok) { t.setAttribute('data-confirmed', ''); t.click(); } }); return; }
                t.removeAttribute('data-confirmed');
                t.disabled = true;
                if (t.hasAttribute('data-save-settings')) {
                    var m = document.getElementById('pharmacySettings'), w = m.querySelector('[data-k="warehouseId"]').value, qw = m.querySelector('[data-k="quarantineWarehouseId"]').value;
                    post(base + '/Settings', { warehouseId: w ? +w : null, nearExpiryDays: +m.querySelector('[data-k="nearExpiryDays"]').value || 60, quarantineWarehouseId: qw ? +qw : null }).then(function (r) {
                        t.disabled = false; if (!r.ok) { toast('error', r.error || W.failed); return; }
                        bootstrap.Modal.getOrCreateInstance(m).hide(); toast('success', W.saved); swap();
                    });
                    return;
                }
                var step = t.getAttribute('data-step'), note = document.querySelector('[data-note]');
                var give = null;
                if (step === 'Dispense') { give = {}; document.querySelectorAll('[data-give]').forEach(function (i) { give[i.getAttribute('data-give')] = Number(i.value || 0); }); }
                post(base + '/' + t.getAttribute('data-id') + '/' + step, step === 'Verify' ? { note: note ? note.value : null } : step === 'Dispense' ? { quantities: give } : null).then(function (r) {
                    t.disabled = false; if (!r.ok) { toast('error', r.error || W.failed); return; }
                    toast('success', step === 'Dispense' ? W.dispensed : W.saved); swap();
                });
            });
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-filter]')) return;
                var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row]').forEach(function (tr) { tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none'; });
            });
        })();
    </script>
}
