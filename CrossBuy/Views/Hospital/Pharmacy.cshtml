@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalRxRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Pharmacy (module)"].Value;
    var stats = (HospitalPharmacyStats)ViewBag.Stats;
    var sel = ViewBag.Selected as HospitalRxView;
    var settings = (HospitalPharmacySettings)ViewBag.Settings;
    var warehouses = (ViewBag.Warehouses as IReadOnlyList<(int Id, string Code, string Name, string? NameEn)>) ?? Array.Empty<(int, string, string, string?)>();
    string? status = ViewBag.Status as string;
    bool canPharmacy = ViewBag.CanPharmacy == true, canManage = ViewBag.CanManage == true;
    string Src(string s) => s == HospitalDispenseSource.Inpatient ? T["Inpatient"].Value : s == HospitalDispenseSource.Emergency ? T["Emergency"].Value
        : s == HospitalDispenseSource.Oncology ? T["Oncology"].Value : T["Outpatient"].Value;   // H120: a chemotherapy cycle's drugs
    string St(string s) => s switch { "New" => "<span class=\"badge badge-light fs-8\">" + T["rx:New"].Value + "</span>", "Verified" => "<span class=\"badge badge-light-primary fs-8\">" + T["rx:Verified"].Value + "</span>", _ => "<span class=\"badge badge-light-success fs-8\">" + T["rx:Dispensed"].Value + "</span>" };
    string Money(decimal v) => v.ToString("N3", System.Globalization.CultureInfo.InvariantCulture);
    string WarnText(string w, HospitalRxLineView l) => w switch
    {
        HospitalPharmacyService.WarnAllergy => string.Format(T["{0} — the file records an allergy it mentions: {1}"].Value, l.Line.Drug, string.Join(", ", HospitalPharmacyService.AllergiesIn(l.Line.Drug, sel?.Patient.Allergies))),
        HospitalPharmacyService.WarnDuplicate => string.Format(T["{0} is prescribed twice"].Value, l.Line.Drug),
        HospitalPharmacyService.WarnInteraction => string.Format(T["{0} interacts with another medicine of this patient — see the drug-safety list"].Value, l.Line.Drug),
        HospitalPharmacyService.WarnNotStocked => string.Format(T["{0} is not stocked — the patient buys it outside; it is not charged"].Value, l.Line.Drug),
        HospitalPharmacyService.WarnShort => string.Format(T["{0}: the store holds {1}, the prescription asks {2}"].Value, l.Line.Drug, HospitalUi.LabNum(l.OnHand ?? 0, 0), HospitalUi.LabNum(l.Line.Quantity, 0)),
        _ => string.Format(T["{0}: the batch that leaves first expires soon"].Value, l.Line.Drug),
    };
    string Who(int? id) => id != null && sel != null && sel.People.TryGetValue(id.Value, out var n) ? n : "—";
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Pharmacy (module)"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@T["Pharmacy (module)"]</li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3 d-print-none">
            <a href="@Url.Action("PharmacyStock")" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-package fs-4"></i>@T["Pharmacy stock"]</a>
            @if (canManage) { <button type="button" class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#pharmacySettings"><i class="ki-outline ki-setting-3 fs-4"></i>@T["Pharmacy settings"]</button> }
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (settings.WarehouseId == null)
        {
            <div class="notice d-flex rounded border border-dashed border-primary bg-light-primary p-6 mb-5">
                <i class="ki-outline ki-setting-3 fs-2tx text-primary me-4"></i>
                <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Choose the pharmacy store"]</h4>
                    <div class="fs-6 text-gray-700">@T["Medicines are dispensed from one warehouse of the inventory. Choose it in the pharmacy settings before dispensing."]</div></div>
            </div>
        }

        @* H125: the day's figures — demo39 dashboards/logistics card widget *@
        <div class="row g-5 g-xl-8 mb-5">
            @foreach (var s in new[] {
                (T["Prescriptions waiting"].Value, stats.Waiting.ToString(), "", "ki-capsule", "primary"),
                (T["Average dispense time"].Value, stats.AvgDispenseMinutes?.ToString() ?? "—", T["minutes, today"].Value, "ki-time", "info"),
                (T["Near-expiry batches"].Value, stats.NearExpiry.ToString(), string.Format(T["within {0} days"].Value, stats.NearExpiryDays), "ki-calendar-remove", stats.NearExpiry > 0 ? "danger" : "success"),
                (T["Below reorder point"].Value, stats.BelowReorder.ToString(), T["in the pharmacy store"].Value, "ki-chart-simple-3", stats.BelowReorder > 0 ? "danger" : "success") })
            {
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                    <div class="card-header pt-5 flex-nowrap gap-3">
                        <div class="card-title d-flex flex-column">
                            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2 hp-num">@s.Item2</span>
                            <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                        </div>
                        <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item5"><i class="ki-outline @s.Item4 fs-2x text-@s.Item5"></i></span></div></div>
                    </div>
                    <div class="card-body d-flex align-items-end pt-0">
                        <div class="d-flex fs-7 fw-semibold align-items-center text-gray-500">@if (!string.IsNullOrEmpty(s.Item3)) {<div class="bullet w-8px h-6px rounded-2 bg-@s.Item5 me-3"></div>@s.Item3} else {<span>&nbsp;</span>}</div>
                    </div>
                </div></div>
            }
        </div>

        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Dispensing queue"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["Every prescription a doctor signs arrives here"] · <span class="hp-num">@Model.Count</span></span>
                </h3>
                <div class="card-toolbar d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Pharmacy")" class="btn btn-sm @(status == null ? "btn-primary" : "btn-light")">@T["Open work"]</a>
                    @foreach (var st in HospitalDispenseStatus.All) { <a href="@Url.Action("Pharmacy", new { status = st })" class="btn btn-sm @(status == st ? "btn-primary" : "btn-light")">@T["rx:" + st]</a> }
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" data-filter class="form-control form-control-solid w-200px ps-12" placeholder="@T["Search..."]" /></div>
                </div>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0) { <div class="text-center py-15"><i class="ki-outline ki-capsule fs-3x text-gray-300 d-block mb-4"></i><div class="fs-6 fw-semibold text-gray-600">@T["No prescriptions here."]</div></div> }
                else
                {
                    <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 w-125px rounded-start">@T["Prescription"]</th><th class="min-w-200px">@T["Patient"]</th><th>@T["Source"]</th><th>@T["Items (count)"]</th><th>@T["Doctor"]</th><th class="pe-4 rounded-end">@T["State"]</th>
                        </tr></thead>
                        <tbody class="fw-semibold text-gray-700">
                            @foreach (var r in Model)
                            {
                                <tr data-row class="cursor-pointer @(sel?.Dispense.ID == r.Id ? "bg-light-primary" : "")" data-href="@Url.Action("Pharmacy", new { rx = r.Id, status })">
                                    <td class="ps-4"><a href="@Url.Action("Pharmacy", new { rx = r.Id, status })" class="text-gray-900 fw-bold text-hover-primary fs-6 hp-num">@r.RxNo</a></td>
                                    <td><div class="d-flex align-items-center gap-3">
                                        <div class="symbol symbol-35px symbol-circle flex-shrink-0">@if (r.PatientPhoto != null) {<img src="@r.PatientPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-8 hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                        <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6">@DisplayName.Of(r.PatientName, r.PatientNameEn)</span><span class="text-muted fw-semibold d-block fs-7 hp-num">@r.Mrn</span></div></div></td>
                                    <td><span class="badge badge-light-@(r.Source == HospitalDispenseSource.Oncology ? "info" : r.Source == HospitalDispenseSource.Inpatient ? "primary" : r.Source == HospitalDispenseSource.Emergency ? "danger" : "success") fs-7 fw-bold">@Src(r.Source)</span></td>
                                    <td><span class="text-gray-800 fw-bold hp-num">@r.Items</span></td>
                                    <td>@if (r.Doctor != null) {<div class="d-flex align-items-center gap-2">
                                        <div class="symbol symbol-30px symbol-circle flex-shrink-0">@if (r.DoctorPhoto != null) {<img src="@r.DoctorPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.DoctorEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(r.DoctorEn)</span>}</div>
                                        <span class="fs-7 text-gray-800">@DisplayName.Of(r.Doctor, r.DoctorEn)</span></div>} else {<span class="text-muted">—</span>}</td>
                                    <td class="pe-4">@Html.Raw(St(r.Status))@if (r.HasWarning) {<span class="badge badge-light-danger fs-8 fw-bold ms-1"><i class="ki-outline ki-shield-cross fs-8 text-danger me-1"></i>@T["Check"]</span>}</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        @if (sel != null)
        {
            var d = sel.Dispense; var p = sel.Patient;
            var warnings = sel.Lines.SelectMany(l => l.Warnings.Select(w => (w, l))).ToList();
            <div class="row g-5 g-xl-8">
                <div class="col-xl-8">
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column">
                                <span class="card-label fw-bold text-gray-800">@T["Dispense"] <bdi class="text-primary hp-num ms-1">@d.RxNo</bdi></span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7"><a href="@Url.Action("Patient", new { id = p.ID })" class="text-gray-700 text-hover-primary">@DisplayName.Of(p.Name, p.NameEn)</a> · <span class="hp-num">@p.Mrn</span> · @(sel.PriceListName ?? T["Main price list"].Value)@if (sel.BillNo != null) {<text> · </text><span class="text-nowrap"><i class="ki-outline ki-bill fs-7"></i> @(sel.OnStay ? T["The stay's bill"] : T["Bill"]) <bdi class="hp-num">@sel.BillNo</bdi></span>}</span>
                            </h3>
                            <div class="card-toolbar gap-2"><span class="badge badge-light fs-7 fw-bold">@Src(d.Source)</span>@Html.Raw(St(d.Status))</div>
                        </div>
                        <div class="card-body pt-2">
                            @if (warnings.Count > 0 && d.Status != HospitalDispenseStatus.Dispensed)
                            {
                                <div class="notice d-flex rounded border border-dashed border-danger bg-light-danger p-5 mb-5">
                                    <i class="ki-outline ki-shield-cross fs-2tx text-danger me-4"></i>
                                    <div class="fw-semibold flex-grow-1">
                                        <h4 class="text-gray-900 fw-bold mb-2">@T["Check before dispensing"]</h4>
                                        @foreach (var (w, l) in warnings)
                                        {
                                            <div class="d-flex align-items-center fs-7 text-gray-800 mb-2">
                                                <span class="bullet bullet-dot bg-danger h-6px w-6px me-3 flex-shrink-0"></span><span>@WarnText(w, l)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light">
                                    <th class="ps-4 min-w-200px rounded-start">@T["Item"]</th><th>@T["Batch"]</th><th>@T["Expiry"]</th><th class="text-end">@T["Qty"]</th><th class="text-end">@T["On hand"]</th><th class="text-end pe-4 rounded-end">@T["Amount"]</th>
                                </tr></thead>
                                <tbody class="fw-semibold text-gray-700">
                                    @foreach (var l in sel.Lines)
                                    {
                                        var dispensed = d.Status == HospitalDispenseStatus.Dispensed;
                                        var batch = dispensed ? l.Line.Batches : l.NextBatch;
                                        var exp = dispensed ? l.Line.NearestExpiry : l.NextExpiry;
                                        <tr>
                                            <td class="ps-4"><div class="d-flex align-items-center">
                                                <div class="symbol symbol-40px me-3 flex-shrink-0"><span class="symbol-label bg-light-@(l.Line.ItemId == null ? "danger" : l.Warnings.Count > 0 ? "danger" : "primary")"><i class="ki-outline ki-capsule fs-2 text-@(l.Line.ItemId == null || l.Warnings.Count > 0 ? "danger" : "primary")"></i></span></div>
                                                <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi>@l.Line.Drug</bdi> @if (l.Line.ItemId == null) {<span class="badge badge-light-danger fs-8 fw-bold ms-1">@T["Not stocked"]</span>}</span>
                                                    @if (!string.IsNullOrEmpty(l.Line.Instructions)) {<span class="text-muted fw-semibold d-block fs-7"><bdi>@l.Line.Instructions</bdi></span>}</div></div></td>
                                            <td>@if (batch != null) {<span class="badge badge-light fs-7 fw-bold hp-num">@batch</span>} else {<span class="text-muted">—</span>}</td>
                                            <td class="hp-num fs-7 @(l.Warnings.Contains(HospitalPharmacyService.WarnNearExpiry) ? "text-danger fw-bold" : "")">@(exp?.ToString("yyyy-MM") ?? "—")</td>
                                            <td class="text-end"><span class="text-gray-900 fw-bold hp-num">@HospitalUi.LabNum(l.Line.DispensedQty ?? l.Line.Quantity, 0)</span></td>
                                            <td class="text-end hp-num text-gray-600 @(l.Warnings.Contains(HospitalPharmacyService.WarnShort) ? "text-danger fw-bold" : "")">@(l.OnHand == null ? "—" : HospitalUi.LabNum(l.OnHand, 0))</td>
                                            <td class="text-end pe-4"><span class="text-gray-900 fw-bold hp-num">@(l.Line.ItemId == null || l.Price == null ? "—" : Money(l.Price.Value * (l.Line.DispensedQty ?? l.Line.Quantity)))</span></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot><tr class="border-top border-dashed"><td colspan="5" class="ps-4 pt-5"><span class="text-gray-800 fw-bold fs-5">@T["Patient pays"]</span> @if (sel.CurrencyLabel != null) {<span class="text-muted fw-semibold fs-7">(@sel.CurrencyLabel)</span>}</td>
                                    <td class="text-end pe-4 pt-5"><span class="fs-2 fw-bold text-primary hp-num">@Money(sel.Total)</span></td></tr></tfoot>
                            </table></div>
                            <div class="d-flex flex-wrap gap-2 align-items-center mt-5">
                                <span class="badge badge-light-primary fs-7 fw-semibold py-2 px-3"><i class="ki-outline ki-arrows-loop fs-6 text-primary me-2"></i>@T["Inventory — nearest-expiry batch first (FEFO)"]</span>
                                @if (sel.WarehouseName != null) { <span class="badge badge-light fs-7 fw-semibold py-2 px-3"><i class="ki-outline ki-shop fs-6 me-2"></i><bdi>@sel.WarehouseName</bdi></span> }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5">
                            <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Pharmacist's review"]</span>
                                <span class="text-gray-500 mt-1 fw-semibold fs-7">@Html.Raw(St(d.Status))</span></h3>
                        </div>
                        <div class="card-body pt-2">
                            @if (d.Status == HospitalDispenseStatus.New && canPharmacy)
                            {
                                <label class="fs-6 fw-semibold mb-2">@T["Pharmacist's note (optional)"]</label>
                                <textarea class="form-control form-control-solid mb-5" rows="3" maxlength="400" data-note placeholder="@T["Pharmacist's note (optional)"]"></textarea>
                                <button type="button" class="btn btn-light-primary w-100" data-step="Verify" data-id="@d.ID" data-confirm="@string.Format(T["Mark prescription {0} as reviewed?"].Value, d.RxNo)"><i class="ki-outline ki-shield-tick fs-4"></i>@T["Reviewed by the pharmacist"]</button>
                            }
                            else if (d.Status == HospitalDispenseStatus.Verified && canPharmacy)
                            {
                                @if (d.PharmacistNote != null) { <div class="d-flex align-items-start bg-light rounded p-4 mb-5"><i class="ki-outline ki-message-text fs-3 text-gray-500 me-3"></i><div class="fs-7 text-gray-700"><div class="fw-bold text-gray-800 mb-1">@Who(d.VerifiedByEmployeeId)</div><bdi>@d.PharmacistNote</bdi></div></div> }
                                <button type="button" class="btn btn-primary w-100" data-step="Dispense" data-id="@d.ID" data-confirm="@string.Format(T["Dispense {0} to {1}? The stock leaves the pharmacy store and the items are charged on the bill."].Value, d.RxNo, DisplayName.Of(p.Name, p.NameEn))"><i class="ki-outline ki-check fs-4"></i>@T["Confirm dispensing"]</button>
                            }
                            else if (d.Status == HospitalDispenseStatus.Dispensed)
                            {
                                <div class="notice d-flex rounded border border-dashed border-success bg-light-success p-5">
                                    <i class="ki-outline ki-check-circle fs-2tx text-success me-4"></i>
                                    <div class="fw-semibold"><h4 class="text-gray-900 fw-bold mb-1">@T["Dispensed"]</h4>
                                        <div class="fs-7 text-gray-700">@Who(d.DispensedByEmployeeId) · <span class="hp-num" data-fmt data-utc="@d.DispensedAt?.ToString("o")">@d.DispensedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div>
                                        @if (d.BillId != null) { <a href="@Url.Action("Bill", new { id = d.BillId })" class="fw-bold fs-7">@T["Open the bill"]</a> }</div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-6"><i class="ki-outline ki-lock fs-3x text-gray-300 d-block mb-3"></i><div class="fs-7 fw-semibold text-gray-600">@T["Waiting for the pharmacist"]</div></div>
                            }
                        </div>
                    </div>
                    @* what dispensing does — demo39 dashboards/logistics list widget *@
                    <div class="card card-flush mb-5">
                        <div class="card-header pt-5"><h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["On dispensing"]</span></h3></div>
                        <div class="card-body pt-2">
                            @{ var effects = new[] {
                                ("ki-minus-square", T["A stock issue from the pharmacy store"].Value, true),
                                ("ki-bill", T["A line on the visit's bill"].Value, true),
                                ("ki-printer", T["A dose label from Report Studio"].Value, false),
                                ("ki-message-text", T["A text message to the patient with the directions"].Value, false) }; }
                            @for (int i = 0; i < effects.Length; i++)
                            {
                                var (icon, text, live) = effects[i];
                                <div class="d-flex flex-stack">
                                    <div class="symbol symbol-35px me-4"><span class="symbol-label bg-light-@(live ? "primary" : "secondary")"><i class="ki-outline @icon fs-3 text-@(live ? "primary" : "gray-500")"></i></span></div>
                                    <div class="d-flex flex-stack flex-row-fluid d-grid gap-2">
                                        <span class="@(live ? "text-gray-800" : "text-gray-500") fw-bold fs-6">@text</span>
                                        @if (live) {<span class="badge badge-light-success fs-8 fw-bold"><i class="ki-outline ki-check fs-8 text-success"></i></span>} else {<span class="badge badge-light fs-8">@T["Not connected yet"]</span>}
                                    </div>
                                </div>
                                if (i < effects.Length - 1) { <div class="separator separator-dashed my-3"></div> }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (canManage)
{
    <div class="modal fade" id="pharmacySettings" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
            <div class="mb-13 text-center"><h1 class="mb-3">@T["Pharmacy settings"]</h1>
                <div class="text-muted fw-semibold fs-5">@T["Medicines are dispensed from one warehouse of the inventory. Choose it in the pharmacy settings before dispensing."]</div></div>
            <div class="d-flex flex-column mb-8 fv-row">
                <label class="d-flex align-items-center fs-6 fw-semibold mb-2"><span class="required">@T["Pharmacy store (warehouse)"]</span></label>
                <select class="form-select form-select-solid" data-k="warehouseId" data-control="select2" data-dropdown-parent="#pharmacySettings">
                    <option value="">—</option>
                    @foreach (var w in warehouses) { <option value="@w.Id" selected="@(settings.WarehouseId == w.Id)">@w.Code · @DisplayName.Of(w.Name, w.NameEn)</option> }
                </select>
            </div>
            <div class="d-flex flex-column mb-8 fv-row">
                <label class="fs-6 fw-semibold mb-2">@T["A batch is near expiry within (days)"]</label>
                <input type="number" min="1" max="365" class="form-control form-control-solid hp-num" data-k="nearExpiryDays" value="@settings.NearExpiryDays" />
            </div>
            <div class="text-center pt-5"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-save-settings>@T["Save"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var base = @Json.Serialize(Url.Action("Pharmacy"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), dispensed: @Json.Serialize(T["Dispensed — the stock left the store and the bill was charged"].Value) };
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('kt_app_content');
                    if (fresh) document.getElementById('kt_app_content').innerHTML = fresh.innerHTML;
                });
            }
            document.addEventListener('click', function (e) {
                var row = e.target.closest('tr[data-href]');
                if (row && !e.target.closest('a,button')) { location.href = row.getAttribute('data-href'); return; }
                var t = e.target.closest('[data-step],[data-save-settings]'); if (!t) return;
                var msg = t.getAttribute('data-confirm');
                if (msg && !t.hasAttribute('data-confirmed')) { cbConfirm(msg).then(function (ok) { if (ok) { t.setAttribute('data-confirmed', ''); t.click(); } }); return; }
                t.removeAttribute('data-confirmed');
                t.disabled = true;
                if (t.hasAttribute('data-save-settings')) {
                    var m = document.getElementById('pharmacySettings'), w = m.querySelector('[data-k="warehouseId"]').value;
                    post(base + '/Settings', { warehouseId: w ? +w : null, nearExpiryDays: +m.querySelector('[data-k="nearExpiryDays"]').value || 60 }).then(function (r) {
                        t.disabled = false; if (!r.ok) { toast('error', r.error || W.failed); return; }
                        bootstrap.Modal.getOrCreateInstance(m).hide(); toast('success', W.saved); swap();
                    });
                    return;
                }
                var step = t.getAttribute('data-step'), note = document.querySelector('[data-note]');
                post(base + '/' + t.getAttribute('data-id') + '/' + step, step === 'Verify' ? { note: note ? note.value : null } : null).then(function (r) {
                    t.disabled = false; if (!r.ok) { toast('error', r.error || W.failed); return; }
                    toast('success', step === 'Dispense' ? W.dispensed : W.saved); swap();
                });
            });
            document.addEventListener('input', function (e) {
                if (!e.target.matches('[data-filter]')) return;
                var q = e.target.value.trim().toLowerCase();
                document.querySelectorAll('[data-row]').forEach(function (tr) { tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none'; });
            });
        })();
    </script>
}
