@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalFeeStatementView?
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Doctor fee statement"].Value;
    var doctors = (ViewBag.Doctors as IReadOnlyList<HospitalDentist>) ?? Array.Empty<HospitalDentist>();
    var periods = (ViewBag.Periods as List<string>) ?? new();
    var accounts = (ViewBag.Accounts as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    bool canBill = ViewBag.CanBill == true, canManage = ViewBag.CanManage == true;
    var m = Model; var st = m?.Statement;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string N(decimal v) => v.ToString("N" + (m?.Decimals ?? 3), inv);
    string PeriodName(string p) { var d = DateTime.ParseExact(p + "-01", "yyyy-MM-dd", inv); return d.ToString("MMMM yyyy", DisplayName.IsArabic ? new System.Globalization.CultureInfo("ar-EG") : inv); }
    bool vendor = m?.Doctor.PayChannel == HospitalPayChannels.Vendor;
    var steps = new[] {
        (T["Generated"].Value, st?.GeneratedAt, st != null),
        (T["Medical director approval"].Value, st?.DirectorApprovedAt, st?.DirectorApprovedAt != null),
        (T["Finance approval"].Value, st?.FinanceApprovedAt, st?.FinanceApprovedAt != null),
        (vendor ? T["Vendor bill & payment"].Value : T["Payroll run"].Value, (DateTime?)null, false) };
    string? next = st == null ? null : HospitalFeeRules.Next(st.Status);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Doctor fee statement"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Practitioners")" class="text-muted text-hover-primary">@T["Practitioners"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Fee statements"]</li>
            </ul>
        </div>
        @if (m != null)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-light-primary" data-print><i class="ki-outline ki-printer fs-4"></i>@T["Print"]</button>
                @if (canBill && (st == null || st.Status == HospitalFeeStatus.Generated)) { <button type="button" class="btn btn-sm btn-light-primary" data-generate><i class="ki-outline ki-arrows-circle fs-4"></i>@(st == null ? T["Generate the statement"] : T["Rebuild"])</button> }
                @if (st != null && next == HospitalFeeStatus.DirectorApproved && canManage) { <button type="button" class="btn btn-sm btn-primary" data-approve="@st.ID" data-what="@T["Medical director approval"]"><i class="ki-outline ki-check-circle fs-4"></i>@T["Medical director approval"]</button> }
                @if (st != null && next == HospitalFeeStatus.FinanceApproved && canBill) { <button type="button" class="btn btn-sm btn-primary" data-approve="@st.ID" data-what="@T["Finance approval"]"><i class="ki-outline ki-check-circle fs-4"></i>@T["Finance approval"]</button> }
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (m == null)
        {
            <div class="card"><div class="card-body text-center text-muted py-15"><i class="ki-outline ki-wallet fs-3x text-gray-300 d-block mb-4"></i>@T["No doctor has fee rules yet: set them on the practitioner's page."]</div></div>
        }
        else
        {
            var d = m.Doctor;
            <div class="card mb-5"><div class="card-body d-flex flex-wrap align-items-center gap-5 py-6">
                <div class="d-flex align-items-center gap-4">
                    <div class="symbol symbol-60px symbol-circle flex-shrink-0">@if (m.DoctorPhoto != null) {<img src="@m.DoctorPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(d.NameEn)" />} else {<span class="symbol-label fw-bold hp-initials">@HospitalUi.Initials(d.NameEn)</span>}</div>
                    <div><a href="@Url.Action("Practitioner", new { id = d.ID })" class="fw-bold fs-5 text-gray-900 text-hover-primary">@DisplayName.Of(d.Name, d.NameEn)</a>
                        <div class="text-muted fs-7">@(DisplayName.Of(d.Title ?? "", d.TitleEn ?? d.Title ?? "")) <span class="badge badge-light-secondary fs-9 ms-1">@T["eng:" + d.Engagement]</span> <span class="badge badge-light-primary fs-9">@(vendor ? T["Paid as a vendor"] : T["Paid through payroll"])</span></div></div>
                </div>
                <form method="get" class="ms-auto d-flex flex-wrap gap-3">
                    <select name="practitioner" class="form-select form-select-sm form-select-solid w-225px" data-pick data-person-select>
                        @foreach (var x in doctors) { <option value="@x.Id" data-photo="@x.Photo" data-initials="@HospitalUi.Initials(x.NameEn)" selected="@(x.Id == d.ID)">@DisplayName.Of(x.Name, x.NameEn)</option> }
                    </select>
                    <select name="period" class="form-select form-select-sm form-select-solid w-175px" data-pick>
                        @foreach (var p in periods) { <option value="@p" selected="@(p == m.Period)">@PeriodName(p)</option> }
                    </select>
                </form>
            </div></div>

            <div class="row g-5 g-xl-8 mb-5">
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@T["Total billed"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@N(st?.Billed ?? 0)</div>
                    <div class="text-muted fs-8 mt-1"><span class="hp-num">@m.Lines.Count</span> @T["parts of services"]</div></div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@T["Actually collected"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@N(st?.Collected ?? 0)</div>
                    <div class="text-muted fs-8 mt-1">@T["the calculation basis"]</div></div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@T["Doctor share"]</div><div class="fs-2hx fw-bold hp-num text-gray-900">@N(st?.Share ?? 0)</div></div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100"><div class="card-body py-5">
                    <div class="text-muted fw-semibold fs-7 mb-1">@T["Net due"]</div><div class="fs-2hx fw-bold hp-num text-primary">@N(st?.Share ?? 0)</div>
                    <div class="text-muted fs-8 mt-1 hp-num">@m.Currency</div></div></div></div>
            </div>

            <div class="notice d-flex rounded border border-dashed p-5 mb-5 hp-notice">
                <span class="symbol symbol-40px me-4 flex-shrink-0"><span class="symbol-label"><i class="ki-outline ki-wallet fs-2 text-white"></i></span></span>
                <div class="flex-grow-1"><h4 class="text-gray-900 fw-bold mb-1">@T["Calculated on what was collected"]</h4>
                    <div class="fs-7 text-gray-700">@T["The patient's part counts when the patient has paid the bill in full; the payer's part when its claim line is accepted. An uncollected service moves to the month it is collected, and nothing is counted twice."]</div></div>
                <span class="badge hp-badge fs-7 fw-bold px-4 py-2 align-self-center">@PeriodName(m.Period)</span>
            </div>

            <div class="card mb-5">
                <div class="card-header border-0 pt-6"><div class="card-title align-items-start flex-column m-0">
                    <span class="card-label fw-bold text-gray-900 fs-4">@T["Statement lines"]</span>
                    @if (st != null) { <span class="text-muted mt-1 fw-semibold fs-7"><span class="hp-num">@st.StatementNo</span> · @T["Generated"] <span class="hp-num">@st.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></span> }
                </div></div>
                <div class="card-body pt-2">
                    @if (st == null) { <div class="text-center text-muted py-10">@T["No statement for this month yet."]@if (canBill) {<text> </text>@T["Generate it from the button above."]}</div> }
                    else if (m.Lines.Count == 0) { <div class="text-center text-muted py-10">@T["Nothing of this doctor's work was collected in this month."]</div> }
                    else
                    {
                        <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                            <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                                <th>@T["Date"]</th><th>@T["Patient"]</th><th>@T["Service"]</th><th>@T["Payer"]</th><th class="text-end">@T["Billed"]</th><th class="text-end">@T["Collected"]</th><th class="text-end">@T["Rate"]</th><th class="text-end">@T["Share"]</th>
                            </tr></thead>
                            <tbody class="fw-semibold text-gray-700">
                                @foreach (var r in m.Lines)
                                {
                                    var l = r.Line;
                                    <tr>
                                        <td class="text-nowrap"><span class="hp-num">@l.CollectedOn.ToString("yyyy-MM-dd")</span></td>
                                        <td><a href="@Url.Action("Patient", new { id = l.PatientId })" class="d-flex align-items-center gap-2 text-hover-primary">
                                            <div class="symbol symbol-30px symbol-circle flex-shrink-0">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label fw-bold fs-9 hp-initials">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                            <span class="fw-bold text-gray-900 fs-7">@DisplayName.Of(r.PatientName, r.PatientNameEn)</span></a></td>
                                        <td class="fs-7">@DisplayName.Of(l.Description, l.DescriptionEn)</td>
                                        <td class="fs-7">@(l.Part != HospitalFeePart.Patient ? DisplayName.Of(r.Payer ?? "", r.PayerEn ?? r.Payer ?? "") : T["The patient"].Value)@if (l.Part == HospitalFeePart.Recoup) {<span class="badge badge-light-danger fs-9 ms-1">@T["Recouped"]</span>}</td>
                                        <td class="text-end hp-num">@N(l.Billed)</td>
                                        <td class="text-end hp-num">@N(l.Collected)</td>
                                        <td class="text-end">@if (l.Basis == HospitalFeeBasis.Percent) {<span class="hp-num">@l.Rate.ToString("0.##", inv)%</span>} else {<span class="text-gray-600 fs-8"><span class="hp-num">@N(l.Rate)</span> @T["per unit"]</span>}</td>
                                        <td class="text-end hp-num fw-bold">@(l.Share == 0 ? "—" : N(l.Share))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot><tr class="fw-bolder fs-5"><td class="ps-4" colspan="7" style="color:#145DBF">@T["Net due"] (<span class="hp-num">@m.Currency</span>)</td><td class="text-end pe-4 hp-num">@N(st.Share)</td></tr></tfoot>
                        </table></div>
                    }
                </div>
            </div>

            <div class="row g-5">
                <div class="col-xl-6"><div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Approval path"]</span></div></div>
                    <div class="card-body pt-2">
                        @for (int i = 0; i < steps.Length; i++)
                        {
                            var (label, at, ok) = steps[i];
                            <div class="d-flex align-items-center py-3 border-bottom border-gray-200 border-bottom-dashed">
                                <span class="symbol symbol-35px me-4"><span class="symbol-label fw-bold" style="@(ok ? "background:var(--cb-brand,#3A5795);color:#fff" : "background:#E7F0FF;color:var(--cb-brand,#3A5795)")">@(i + 1)</span></span>
                                <span class="fw-semibold text-gray-800 flex-grow-1">@label</span>
                                @if (at != null) { <span class="hp-num fs-7">@at.Value.ToLocalTime().ToString("yyyy-MM-dd")</span> } else { <span class="badge badge-light-secondary fs-8">@T["Pending"]</span> }
                            </div>
                        }
                    </div>
                </div></div>
                <div class="col-xl-6"><div class="card mb-5">
                    <div class="card-header border-0 pt-6"><div class="card-title m-0"><span class="card-label fw-bold text-gray-900 fs-4">@T["Journal on approval"]</span></div></div>
                    <div class="card-body pt-2">
                        @if (!vendor) { <div class="text-muted fs-7 py-4">@T["Paid through payroll: no journal here. The approved share goes to the payroll run as a variable line (HR)."]</div> }
                        else
                        {
                            var acc = (int? id) => accounts.FirstOrDefault(a => a.Id == id);
                            var exp = acc(m.Settings?.ExpenseAccountId); var pay = acc(m.Settings?.PayableAccountId);
                            <table class="table align-middle table-row-dashed fs-6 gy-3 mb-0">
                                <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0"><th>@T["Account"]</th><th class="text-end">@T["Debit"]</th><th class="text-end">@T["Credit"]</th></tr></thead>
                                <tbody class="fw-semibold text-gray-700">
                                    <tr><td>@T["Accrued doctor fees"] @if (exp != null) {<span class="text-muted fs-8"> · <span class="hp-num">@exp.Label</span> @DisplayName.Of(exp.Name, exp.NameEn ?? exp.Name)</span>}</td><td class="text-end hp-num">@N(st?.Share ?? 0)</td><td class="text-end text-muted">—</td></tr>
                                    <tr><td>@T["Payable:"] @DisplayName.Of(d.Name, d.NameEn) @if (pay != null) {<span class="text-muted fs-8"> · <span class="hp-num">@pay.Label</span> @DisplayName.Of(pay.Name, pay.NameEn ?? pay.Name)</span>}</td><td class="text-end text-muted">—</td><td class="text-end hp-num">@N(st?.Share ?? 0)</td></tr>
                                </tbody>
                            </table>
                            @if (st?.JournalEntryId != null) { <div class="text-success fs-8 mt-3"><i class="ki-outline ki-check-circle fs-7 text-success"></i> @T["Posted"]</div> }
                            @if (canManage)
                            {
                                <div class="row g-3 mt-3">
                                    <div class="col-md-6"><label class="form-label fs-8">@T["Accrued doctor fees"]</label><select class="form-select form-select-sm form-select-solid" data-fa="expense"><option value="">—</option>@foreach (var a in accounts) { <option value="@a.Id" selected="@(a.Id == m.Settings?.ExpenseAccountId)">@a.Label · @DisplayName.Of(a.Name, a.NameEn ?? a.Name)</option> }</select></div>
                                    <div class="col-md-6"><label class="form-label fs-8">@T["Doctors payable"]</label><select class="form-select form-select-sm form-select-solid" data-fa="payable"><option value="">—</option>@foreach (var a in accounts) { <option value="@a.Id" selected="@(a.Id == m.Settings?.PayableAccountId)">@a.Label · @DisplayName.Of(a.Name, a.NameEn ?? a.Name)</option> }</select></div>
                                    <div class="col-12"><button type="button" class="btn btn-sm btn-light-primary" data-fa-save>@T["Save the accounts"]</button></div>
                                </div>
                            }
                            <div class="text-muted fs-8 mt-3">@T["Withholding tax is deducted at payment if enabled on the vendor, per the country settings."]</div>
                        }
                    </div>
                </div></div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <partial name="_PersonSelect" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Fees"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), gen: @Json.Serialize(T["Build this month's statement from what was collected?"].Value),
                approve: @Json.Serialize(T["{0} for this statement?"].Value), print: @Json.Serialize(T["The statement prints through Report Studio once its dataset is registered."].Value), accounts: @Json.Serialize(T["Save the doctor fee accounts?"].Value) };
            var practitioner = @(Model?.Doctor.ID ?? 0), period = @Json.Serialize(Model?.Period);
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content (and toolbar) swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.getElementById('kt_app_content'), tb = d.getElementById('kt_app_toolbar');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                    if (tb) document.getElementById('kt_app_toolbar').innerHTML = tb.innerHTML;
                    if (window.hpPersonSelect) hpPersonSelect(); wirePick();
                });
            }
            function done(btn) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); }; }
            // choosing another doctor or month is a GET (a filter, never a write)
            function wirePick() { document.querySelectorAll('[data-pick]').forEach(function (s) { if (window.CB && CB.onSelectChange) CB.onSelectChange(s, function () { s.form.submit(); }); else s.addEventListener('change', function () { s.form.submit(); }); }); }
            wirePick();
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-generate],[data-approve],[data-print],[data-fa-save]'); if (!t) return;
                if (t.hasAttribute('data-print')) { toast('info', W.print); return; }
                if (t.hasAttribute('data-generate')) { cbConfirm(W.gen).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Generate', { practitionerId: practitioner, period: period }).then(done(t)); }); return; }
                if (t.hasAttribute('data-approve')) { cbConfirm(W.approve.replace('{0}', t.getAttribute('data-what'))).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/' + t.getAttribute('data-approve') + '/Approve').then(done(t)); }); return; }
                var g = function (k) { var v = document.querySelector('[data-fa=' + k + ']').value; return v ? +v : null; };
                cbConfirm(W.accounts).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Settings', { expenseAccountId: g('expense'), payableAccountId: g('payable') }).then(done(t)); });
            });
        })();
    </script>
}
