@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalFeeStatementView?
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H127 — a doctor's fee statement: a profile header (demo39 apps/user-management/users/view), stat tiles
    (dashboards/logistics), the lines as the table widget (widgets/tables), the approval path as a timeline
    (widgets/feeds) and the journal as the table widget.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Doctor fee statement"].Value;
    var doctors = (ViewBag.Doctors as IReadOnlyList<HospitalDentist>) ?? Array.Empty<HospitalDentist>();
    var periods = (ViewBag.Periods as List<string>) ?? new();
    var accounts = (ViewBag.Accounts as List<CrossBuy.Controllers.HospitalController.HospitalChoice>) ?? new();
    bool canBill = ViewBag.CanBill == true, canManage = ViewBag.CanManage == true;
    var m = Model; var st = m?.Statement;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string N(decimal v) => v.ToString("N" + (m?.Decimals ?? 3), inv);
    string PeriodName(string p) { var d = DateTime.ParseExact(p + "-01", "yyyy-MM-dd", inv); return d.ToString("MMMM yyyy", DisplayName.IsArabic ? new System.Globalization.CultureInfo("ar-EG") : inv); }
    bool vendor = m?.Doctor.PayChannel == HospitalPayChannels.Vendor;
    var steps = new[] {
        (T["Generated"].Value, st?.GeneratedAt, st != null),
        (T["Medical director approval"].Value, st?.DirectorApprovedAt, st?.DirectorApprovedAt != null),
        (T["Finance approval"].Value, st?.FinanceApprovedAt, st?.FinanceApprovedAt != null),
        (vendor ? T["Vendor bill & payment"].Value : T["Payroll run"].Value, (DateTime?)null, false) };
    string? next = st == null ? null : HospitalFeeRules.Next(st.Status);
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Doctor fee statement"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted"><a href="@Url.Action("Practitioners")" class="text-muted text-hover-primary">@T["Practitioners"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Fee statements"]</li>
            </ul>
        </div>
        @if (m != null)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-light-primary" data-print><i class="ki-outline ki-printer fs-4"></i>@T["Print"]</button>
                @if (canBill && (st == null || st.Status == HospitalFeeStatus.Generated)) { <button type="button" class="btn btn-sm btn-light-primary" data-generate><i class="ki-outline ki-arrows-circle fs-4"></i>@(st == null ? T["Generate the statement"] : T["Rebuild"])</button> }
                @if (st != null && next == HospitalFeeStatus.DirectorApproved && canManage) { <button type="button" class="btn btn-sm btn-primary" data-approve="@st.ID" data-what="@T["Medical director approval"]"><i class="ki-outline ki-check-circle fs-4"></i>@T["Medical director approval"]</button> }
                @if (st != null && next == HospitalFeeStatus.FinanceApproved && canBill) { <button type="button" class="btn btn-sm btn-primary" data-approve="@st.ID" data-what="@T["Finance approval"]"><i class="ki-outline ki-check-circle fs-4"></i>@T["Finance approval"]</button> }
            </div>
        }
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (m == null)
        {
            <div class="card card-flush"><div class="card-body">
                <div class="text-center py-10"><i class="ki-outline ki-wallet fs-3x text-gray-300 mb-4 d-block"></i>
                    <div class="fs-6 fw-bold text-gray-700">@T["No doctor has fee rules yet: set them on the practitioner's page."]</div>
                    <a href="@Url.Action("Practitioners")" class="fs-7 fw-bold">@T["Practitioners"]</a></div>
            </div></div>
        }
        else
        {
            var d = m.Doctor;
            @* profile header — demo39 apps/user-management/users/view *@
            <div class="card card-flush mb-5"><div class="card-body d-flex flex-wrap align-items-center gap-6 py-7">
                <div class="d-flex align-items-center gap-5 flex-grow-1">
                    <div class="symbol symbol-65px symbol-circle flex-shrink-0">@if (m.DoctorPhoto != null) {<img src="@m.DoctorPhoto" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(d.NameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold fs-3">@HospitalUi.Initials(d.NameEn)</span>}</div>
                    <div><a href="@Url.Action("Practitioner", new { id = d.ID })" class="fw-bold fs-3 text-gray-900 text-hover-primary"><bdi>@DisplayName.Of(d.Name, d.NameEn)</bdi></a>
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-1"><span class="text-gray-500 fw-semibold fs-6">@(DisplayName.Of(d.Title ?? "", d.TitleEn ?? d.Title ?? ""))</span>
                            <span class="badge badge-light fs-7 fw-bold">@T["eng:" + d.Engagement]</span> <span class="badge badge-light-primary fs-7 fw-bold">@(vendor ? T["Paid as a vendor"] : T["Paid through payroll"])</span></div></div>
                </div>
                <form method="get" class="d-flex flex-wrap gap-3">
                    <div class="w-225px"><select name="practitioner" class="form-select form-select-sm form-select-solid" data-pick data-person-select>
                        @foreach (var x in doctors) { <option value="@x.Id" data-photo="@x.Photo" data-initials="@HospitalUi.Initials(x.NameEn)" selected="@(x.Id == d.ID)">@DisplayName.Of(x.Name, x.NameEn)</option> }
                    </select></div>
                    <div class="w-175px"><select name="period" class="form-select form-select-sm form-select-solid" data-pick>
                        @foreach (var p in periods) { <option value="@p" selected="@(p == m.Period)">@PeriodName(p)</option> }
                    </select></div>
                </form>
            </div></div>

            @* stat tiles — demo39 dashboards/logistics *@
            <div class="row g-5 g-xl-8 mb-5">
                @foreach (var s in new[] {
                    (T["Total billed"].Value, N(st?.Billed ?? 0), (string?)null, "info", "bill", m.Lines.Count),
                    (T["Actually collected"].Value, N(st?.Collected ?? 0), T["the calculation basis"].Value, "success", "wallet", -1),
                    (T["Doctor share"].Value, N(st?.Share ?? 0), (string?)null, "primary", "percentage", -1),
                    (T["Net due"].Value, N(st?.Share ?? 0), m.Currency, "primary", "dollar", -1) })
                {
                    <div class="col-sm-6 col-xl-3"><div class="card card-flush h-100">
                        <div class="card-header pt-5 flex-nowrap gap-3">
                            <div class="card-title d-flex flex-column">
                                <span class="fs-2hx fw-bold @(s.Item1 == T["Net due"].Value ? "text-primary" : "text-gray-900") lh-1 hp-num" dir="ltr">@s.Item2</span>
                                <span class="text-gray-500 pt-1 fw-semibold fs-6">@s.Item1</span>
                            </div>
                            <div class="card-toolbar"><div class="symbol symbol-45px"><span class="symbol-label bg-light-@s.Item4"><i class="ki-outline ki-@s.Item5 fs-2 text-@s.Item4"></i></span></div></div>
                        </div>
                        @if (s.Item6 >= 0 || s.Item3 != null)
                        {
                            <div class="card-body d-flex align-items-end pt-0"><span class="d-flex align-items-center fs-7 fw-semibold text-gray-500"><span class="bullet bullet-dot bg-@s.Item4 me-2"></span>@if (s.Item6 >= 0) {<span class="hp-num">@s.Item6</span><text>&nbsp;@T["parts of services"]</text>} else {<bdi>@s.Item3</bdi>}</span></div>
                        }
                    </div></div>
                }
            </div>

            <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5 mb-5">
                <i class="ki-outline ki-information fs-2tx text-primary me-4"></i>
                <div class="d-flex flex-stack flex-grow-1 flex-wrap flex-md-nowrap gap-3"><div class="fw-semibold">
                    <h4 class="text-gray-900 fw-bold mb-1">@T["Calculated on what was collected"]</h4>
                    <div class="fs-6 text-gray-700">@T["The patient's part counts when the patient has paid the bill in full; the payer's part when its claim line is accepted. An uncollected service moves to the month it is collected, and nothing is counted twice."]</div>
                </div>
                <span class="badge badge-primary fs-7 fw-bold px-4 py-2 flex-shrink-0">@PeriodName(m.Period)</span></div>
            </div>

            <div class="card card-flush mb-5">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Statement lines"]</span>
                        @if (st != null) { <span class="text-gray-500 mt-1 fw-semibold fs-7"><bdi class="hp-num">@st.StatementNo</bdi> · @T["Generated"] <span class="hp-num" dir="ltr">@st.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></span> }</h3>
                </div>
                <div class="card-body pt-2">
                    @if (st == null)
                    {
                        <div class="text-center py-10"><i class="ki-outline ki-document fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No statement for this month yet."]</div>
                            @if (canBill) {<div class="fs-7 text-gray-500">@T["Generate it from the button above."]</div>}</div>
                    }
                    else if (m.Lines.Count == 0)
                    {
                        <div class="text-center py-10"><i class="ki-outline ki-document fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["Nothing of this doctor's work was collected in this month."]</div></div>
                    }
                    else
                    {
                        @* table widget — demo39 widgets/tables *@
                        <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                            <thead><tr class="fw-bold text-muted bg-light">
                                <th class="ps-4 rounded-start">@T["Patient"]</th><th>@T["Service"]</th><th>@T["Payer"]</th><th class="text-end">@T["Billed"]</th><th class="text-end">@T["Collected"]</th><th class="text-end">@T["Rate"]</th><th class="text-end pe-4 rounded-end">@T["Share"]</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var r in m.Lines)
                                {
                                    var l = r.Line;
                                    <tr>
                                        <td class="ps-4"><a href="@Url.Action("Patient", new { id = l.PatientId })" class="d-flex align-items-center text-hover-primary">
                                            <div class="symbol symbol-35px symbol-circle flex-shrink-0 me-3">@if (r.Photo != null) {<img src="@r.Photo" alt="" style="object-fit:cover" data-initials="@HospitalUi.Initials(r.PatientNameEn)" />} else {<span class="symbol-label bg-light-primary text-primary fw-bold fs-8">@HospitalUi.Initials(r.PatientNameEn)</span>}</div>
                                            <div class="d-flex flex-column"><span class="text-gray-900 fw-bold fs-6"><bdi>@DisplayName.Of(r.PatientName, r.PatientNameEn)</bdi></span><span class="text-muted fw-semibold fs-7 hp-num" dir="ltr">@l.CollectedOn.ToString("yyyy-MM-dd")</span></div></a></td>
                                        <td><span class="text-gray-800 fw-semibold fs-7">@DisplayName.Of(l.Description, l.DescriptionEn)</span></td>
                                        <td><span class="text-gray-800 fw-semibold fs-7">@(l.Part != HospitalFeePart.Patient ? DisplayName.Of(r.Payer ?? "", r.PayerEn ?? r.Payer ?? "") : T["The patient"].Value)</span>@if (l.Part == HospitalFeePart.Recoup) {<span class="badge badge-light-danger fs-8 fw-bold ms-1">@T["Recouped"]</span>}</td>
                                        <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@N(l.Billed)</span></td>
                                        <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@N(l.Collected)</span></td>
                                        <td class="text-end">@if (l.Basis == HospitalFeeBasis.Percent) {<span class="badge badge-light-info fs-7 fw-bold hp-num" dir="ltr">@l.Rate.ToString("0.##", inv)%</span>} else {<span class="text-gray-600 fs-8"><span class="hp-num" dir="ltr">@N(l.Rate)</span> @T["per unit"]</span>}</td>
                                        <td class="text-end pe-4"><span class="text-gray-900 fw-bolder fs-6 hp-num" dir="ltr">@(l.Share == 0 ? "—" : N(l.Share))</span></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot><tr class="border-top border-gray-200"><td class="ps-4" colspan="6"><span class="text-primary fw-bolder fs-5">@T["Net due"]</span> <bdi class="text-muted fs-8 hp-num">@m.Currency</bdi></td><td class="text-end pe-4"><span class="text-gray-900 fw-bolder fs-4 hp-num" dir="ltr">@N(st.Share)</span></td></tr></tfoot>
                        </table></div>
                    }
                </div>
            </div>

            <div class="row g-5 g-xl-8">
                <div class="col-xl-6"><div class="card card-flush mb-5 h-xl-100">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Approval path"]</span>
                            <span class="text-gray-500 mt-1 fw-semibold fs-7">@PeriodName(m.Period)</span></h3>
                    </div>
                    <div class="card-body pt-2">
                        @* timeline — demo39 widgets/feeds *@
                        <div>
                        @for (int i = 0; i < steps.Length; i++)
                        {
                            var (label, at, ok) = steps[i];
                            <div class="d-flex align-items-center mb-5">
                                <div class="symbol symbol-35px me-4 flex-shrink-0"><span class="symbol-label @(ok ? "bg-primary text-inverse-primary" : "bg-light-primary text-primary") fw-bold fs-6"><span class="hp-num">@(i + 1)</span></span></div>
                                <div class="flex-grow-1"><span class="text-gray-800 fw-bold fs-6 d-block">@label</span>
                                    @if (at != null) {<span class="text-gray-500 fw-semibold fs-7 hp-num" dir="ltr">@at.Value.ToLocalTime().ToString("yyyy-MM-dd")</span>}</div>
                                @if (ok) {<span class="badge badge-light-success fs-7 fw-bold"><i class="ki-outline ki-check fs-5 text-success"></i></span>} else {<span class="badge badge-light fs-7 fw-bold">@T["Pending"]</span>}
                            </div>
                        }
                        </div>
                    </div>
                </div></div>
                <div class="col-xl-6"><div class="card card-flush mb-5 h-xl-100">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column"><span class="card-label fw-bold text-gray-800">@T["Journal on approval"]</span>
                            @if (st?.JournalEntryId != null) {<span class="text-success mt-1 fw-semibold fs-7"><i class="ki-outline ki-check-circle fs-6 text-success"></i> @T["Posted"]</span>}</h3>
                    </div>
                    <div class="card-body pt-2">
                        @if (!vendor)
                        {
                            <div class="notice d-flex bg-light-info rounded border-info border border-dashed p-5">
                                <i class="ki-outline ki-information fs-2tx text-info me-4"></i>
                                <div class="d-flex flex-stack flex-grow-1"><div class="fw-semibold">
                                    <h4 class="text-gray-900 fw-bold mb-1">@T["Paid through payroll"]</h4>
                                    <div class="fs-6 text-gray-700">@T["Paid through payroll: no journal here. The approved share goes to the payroll run as a variable line (HR)."]</div>
                                </div></div>
                            </div>
                        }
                        else
                        {
                            var acc = (int? id) => accounts.FirstOrDefault(a => a.Id == id);
                            var exp = acc(m.Settings?.ExpenseAccountId); var pay = acc(m.Settings?.PayableAccountId);
                            <div class="table-responsive"><table class="table align-middle gs-0 gy-4 mb-0">
                                <thead><tr class="fw-bold text-muted bg-light"><th class="ps-4 rounded-start">@T["Account"]</th><th class="text-end">@T["Debit"]</th><th class="text-end pe-4 rounded-end">@T["Credit"]</th></tr></thead>
                                <tbody>
                                    <tr><td class="ps-4"><span class="text-gray-800 fw-bold fs-6 d-block">@T["Accrued doctor fees"]</span>@if (exp != null) {<span class="text-muted fw-semibold fs-7"><bdi class="hp-num">@exp.Label</bdi> · <bdi>@DisplayName.Of(exp.Name, exp.NameEn ?? exp.Name)</bdi></span>}</td>
                                        <td class="text-end"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@N(st?.Share ?? 0)</span></td><td class="text-end pe-4 text-muted">—</td></tr>
                                    <tr><td class="ps-4"><span class="text-gray-800 fw-bold fs-6 d-block">@T["Payable:"] <bdi>@DisplayName.Of(d.Name, d.NameEn)</bdi></span>@if (pay != null) {<span class="text-muted fw-semibold fs-7"><bdi class="hp-num">@pay.Label</bdi> · <bdi>@DisplayName.Of(pay.Name, pay.NameEn ?? pay.Name)</bdi></span>}</td>
                                        <td class="text-end text-muted">—</td><td class="text-end pe-4"><span class="text-gray-800 fw-bold hp-num" dir="ltr">@N(st?.Share ?? 0)</span></td></tr>
                                </tbody>
                            </table></div>
                            @if (canManage)
                            {
                                <div class="separator separator-dashed my-5"></div>
                                <div class="row g-4">
                                    <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Accrued doctor fees"]</label><select class="form-select form-select-sm form-select-solid" data-fa="expense"><option value="">—</option>@foreach (var a in accounts) { <option value="@a.Id" selected="@(a.Id == m.Settings?.ExpenseAccountId)">@a.Label · @DisplayName.Of(a.Name, a.NameEn ?? a.Name)</option> }</select></div>
                                    <div class="col-md-6"><label class="fs-6 fw-semibold mb-2">@T["Doctors payable"]</label><select class="form-select form-select-sm form-select-solid" data-fa="payable"><option value="">—</option>@foreach (var a in accounts) { <option value="@a.Id" selected="@(a.Id == m.Settings?.PayableAccountId)">@a.Label · @DisplayName.Of(a.Name, a.NameEn ?? a.Name)</option> }</select></div>
                                    <div class="col-12"><button type="button" class="btn btn-sm btn-light-primary" data-fa-save><i class="ki-outline ki-check fs-4"></i>@T["Save the accounts"]</button></div>
                                </div>
                            }
                            <div class="text-gray-500 fw-semibold fs-7 mt-4">@T["Withholding tax is deducted at payment if enabled on the vendor, per the country settings."]</div>
                        }
                    </div>
                </div></div>
            </div>
        }
    </div></div>
</div>

@section Scripts {
    <partial name="_PersonSelect" />
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value, root = @Json.Serialize(Url.Content("~/Hospital/Fees"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), gen: @Json.Serialize(T["Build this month's statement from what was collected?"].Value),
                approve: @Json.Serialize(T["{0} for this statement?"].Value), print: @Json.Serialize(T["The statement prints through Report Studio once its dataset is registered."].Value), accounts: @Json.Serialize(T["Save the doctor fee accounts?"].Value) };
            var practitioner = @(Model?.Doctor.ID ?? 0), period = @Json.Serialize(Model?.Period);
            function toast(k, m) { if (window.toastr) toastr[k](m); }
            function post(url, body) {
                return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(body || {}) })
                    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
            }
            // In place, never a reload: the page is rendered again and its content (and toolbar) swapped.
            function swap() {
                return fetch(location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.text(); }).then(function (html) {
                    var d = new DOMParser().parseFromString(html, 'text/html'), f = d.getElementById('kt_app_content'), tb = d.getElementById('kt_app_toolbar');
                    if (f) document.getElementById('kt_app_content').innerHTML = f.innerHTML;
                    if (tb) document.getElementById('kt_app_toolbar').innerHTML = tb.innerHTML;
                    if (window.hpPersonSelect) hpPersonSelect();
                    // the swapped month and account dropdowns are plain selects again: give them the theme's select2
                    var $ = window.jQuery;
                    if ($ && $.fn.select2) $('#kt_app_content select.form-select').not('.select2-hidden-accessible').each(function () { $(this).select2({ width: '100%', dir: document.documentElement.dir === 'rtl' ? 'rtl' : 'ltr', minimumResultsForSearch: this.options.length > 7 ? 0 : Infinity }); });
                    wirePick();
                });
            }
            function done(btn) { return function (res) { if (btn) btn.disabled = false; if (!res.ok) { toast('error', res.error || W.failed); return; } toast('success', W.saved); swap(); }; }
            // choosing another doctor or month is a GET (a filter, never a write)
            function wirePick() { document.querySelectorAll('[data-pick]').forEach(function (s) { if (window.CB && CB.onSelectChange) CB.onSelectChange(s, function () { s.form.submit(); }); else s.addEventListener('change', function () { s.form.submit(); }); }); }
            wirePick();
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-generate],[data-approve],[data-print],[data-fa-save]'); if (!t) return;
                if (t.hasAttribute('data-print')) { toast('info', W.print); return; }
                if (t.hasAttribute('data-generate')) { cbConfirm(W.gen).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Generate', { practitionerId: practitioner, period: period }).then(done(t)); }); return; }
                if (t.hasAttribute('data-approve')) { cbConfirm(W.approve.replace('{0}', t.getAttribute('data-what'))).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/' + t.getAttribute('data-approve') + '/Approve').then(done(t)); }); return; }
                var g = function (k) { var v = document.querySelector('[data-fa=' + k + ']').value; return v ? +v : null; };
                cbConfirm(W.accounts).then(function (ok) { if (!ok) return; t.disabled = true; post(root + '/Settings', { expenseAccountId: g('expense'), payableAccountId: g('payable') }).then(done(t)); });
            });
        })();
    </script>
}
