@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model HospitalAccessPage
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H264 — the audit viewer: who opened, created or changed which patient file, and when — searchable by person,
    patient, day range (at most 92 days) and action. Read-only. Theme controls only.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Access log"].Value;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string who = ViewBag.Who as string ?? "", pq = ViewBag.PatientQ as string ?? "", act = ViewBag.Action as string ?? "";
    DateTime fd = (DateTime)ViewBag.FromDate, td = (DateTime)ViewBag.ToDate; int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages;
    string Link(int p) => Url.Action("AccessLog", new { who, patient = pq, fromDate = fd.ToString("yyyy-MM-dd", inv), toDate = td.ToString("yyyy-MM-dd", inv), action = act, page = p })!;
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@T["Access log"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Privacy")" class="text-muted text-hover-primary">@T["Privacy monitoring"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Access log"]</li>
            </ul>
        </div>
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        <div class="card card-flush mb-5"><div class="card-body py-6">
            <form class="row g-4 align-items-end" method="get" action="@Url.Action("AccessLog")">
                <div class="col-md-3"><label class="fs-7 fw-semibold mb-2">@T["Member of staff"]</label><input type="text" name="who" value="@who" class="form-control form-control-sm form-control-solid" placeholder="@T["Name"]" /></div>
                <div class="col-md-3"><label class="fs-7 fw-semibold mb-2">@T["Patient"]</label><input type="text" name="patient" value="@pq" class="form-control form-control-sm form-control-solid" placeholder="@T["Name or MRN"]" /></div>
                <div class="col-md-2"><label class="fs-7 fw-semibold mb-2">@T["From"]</label><input type="date" name="fromDate" value="@fd.ToString("yyyy-MM-dd", inv)" class="form-control form-control-sm form-control-solid" /></div>
                <div class="col-md-2"><label class="fs-7 fw-semibold mb-2">@T["To"]</label><input type="date" name="toDate" value="@td.ToString("yyyy-MM-dd", inv)" class="form-control form-control-sm form-control-solid" /></div>
                <div class="col-md-1"><label class="fs-7 fw-semibold mb-2">@T["Action"]</label>
                    <select name="action" class="form-select form-select-sm form-select-solid"><option value="">@T["All"]</option>@foreach (var a in new[] { HospitalPatientAccessActions.Open, HospitalPatientAccessActions.Create, HospitalPatientAccessActions.Update }) {<option value="@a" selected="@(act == a)">@T["pal:" + a]</option>}</select></div>
                <div class="col-md-1"><button type="submit" class="btn btn-sm btn-primary w-100">@T["Search"]</button></div>
            </form>
            <div class="d-flex flex-wrap gap-8 mt-6 fs-7 text-gray-600">
                <span><span class="fw-bold fs-4 text-gray-900 hp-num">@Model.Total</span> @T["entries"]</span>
                <span><span class="fw-bold fs-4 text-gray-900 hp-num">@Model.People</span> @T["members of staff"]</span>
                <span><span class="fw-bold fs-4 text-gray-900 hp-num">@Model.Files</span> @T["files"]</span>
                <span class="text-muted fs-8 align-self-center">@T["At most 92 days at a time"]</span>
            </div>
        </div></div>
        <div class="card card-flush"><div class="card-body pt-6">
            @if (Model.Rows.Count == 0)
            {
                <div class="text-center py-15"><i class="ki-outline ki-eye fs-3tx text-gray-300 mb-4"></i><div class="text-gray-600 fw-semibold fs-6">@T["Nothing in this range."]</div></div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-3 mb-0">
                    <thead><tr class="fw-bold text-muted fs-7"><th class="min-w-125px">@T["When"]</th><th class="min-w-200px">@T["Member of staff"]</th><th>@T["Action"]</th><th class="min-w-200px">@T["Patient"]</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var en = r.Employee == null ? (r.EmployeeId == null ? T["System"].Value : "#" + r.EmployeeId) : DisplayName.Of(r.Employee.Name ?? "", r.Employee.NameEn ?? r.Employee.Name ?? "");
                        <tr>
                            <td><span class="fs-7 fw-semibold text-gray-800 hp-num" dir="ltr" data-fmt data-utc="@DateTime.SpecifyKind(r.At, DateTimeKind.Utc).ToString("o")">@r.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm", inv)</span></td>
                            <td><div class="d-flex align-items-center gap-2">@HospitalUi.Avatar(r.Employee?.Photo, en, 30)<a href="@Url.Action("AccessLog", new { who = r.Employee?.Name, fromDate = fd.ToString("yyyy-MM-dd", inv), toDate = td.ToString("yyyy-MM-dd", inv) })" class="fs-7 fw-bold text-gray-800 text-hover-primary">@en</a></div></td>
                            <td><span class="badge badge-light-@(r.Action == HospitalPatientAccessActions.Open ? "primary" : "info") fs-8">@T["pal:" + r.Action]</span></td>
                            <td><div class="d-flex align-items-center gap-2">@HospitalUi.Avatar(r.PatientPhoto, DisplayName.Of(r.PatientName, r.PatientNameEn), 30)<div><a href="@Url.Action("AccessLog", new { patient = r.Mrn, fromDate = fd.ToString("yyyy-MM-dd", inv), toDate = td.ToString("yyyy-MM-dd", inv) })" class="fs-7 fw-bold text-gray-800 text-hover-primary">@DisplayName.Of(r.PatientName, r.PatientNameEn)</a><div class="text-muted fs-8 hp-num" dir="ltr">@r.Mrn</div></div></div></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
                @if (pages > 1)
                {
                    <ul class="pagination mt-6">
                        <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                        @for (int n = Math.Max(1, page - 3); n <= Math.Min(pages, page + 3); n++) {<li class="page-item @(n == page ? "active" : "")"><a class="page-link" href="@Link(n)">@n</a></li>}
                        <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                    </ul>
                }
            }
        </div></div>
    </div></div>
</div>
