@using CrossBuy.BL
@using CrossBuy.BL.Hospital
@using CrossBuy.Models.Context.Hospital
@model IReadOnlyList<HospitalReferralRow>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.HospitalResources> T
@*
    H203 — referrals, composed from the theme (demo39): two stat badges, a filter bar, the table widget with each referral's
    question, where it goes, its urgency, its due time (overdue in red) and its answer; a new referral in a modal.
*@
@{
    Layout = "~/Views/Shared/_LayoutHospital.cshtml";
    ViewData["Title"] = T["Referrals"].Value;
    string q = ViewBag.Q as string ?? "", status = ViewBag.Status as string ?? "", kind = ViewBag.Kind as string ?? "";
    int? dept = ViewBag.Dept as int?; bool overdue = ViewBag.Overdue == true; int? patient = ViewBag.Patient as int?;
    int page = (int)ViewBag.Page, pages = (int)ViewBag.Pages, total = (int)ViewBag.Total, open = (int)ViewBag.Open, late = (int)ViewBag.Late;
    bool ready = ViewBag.Ready == true, canConsult = ViewBag.CanConsult == true;
    var depts = (ViewBag.Departments as IReadOnlyList<(int Id, string Name, string? NameEn)>) ?? Array.Empty<(int, string, string?)>();
    var doctors = (ViewBag.Doctors as IReadOnlyList<(int Id, string Name, string NameEn, int? DepartmentId)>) ?? Array.Empty<(int, string, string, int?)>();
    string Link(int p, bool? od = null) => Url.Action("Referrals", new { q, status, kind, dept, overdue = od ?? overdue, patient, page = p })!;
    string StatusTone(string s) => s switch { HospitalReferralStatus.Sent => "info", HospitalReferralStatus.Accepted => "primary", HospitalReferralStatus.Completed => "primary", HospitalReferralStatus.Declined => "danger", _ => "secondary" };
    string UrgTone(string u) => u switch { HospitalReferralUrgency.Emergency => "danger", HospitalReferralUrgency.Urgent => "info", _ => "light" };
}
<link href="~/css/hospital.css" rel="stylesheet" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0 d-flex align-items-center gap-3">@T["Referrals"]
                <span class="badge badge-light-primary fs-7 fw-bold">@T["{0} open", open]</span>
                @if (late > 0) {<a href="@Link(1, true)" class="badge badge-danger fs-7 fw-bold">@T["{0} overdue", late]</a>}</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Worklist")" class="text-muted text-hover-primary">@T["Doctor worklist"]</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@T["Referrals"]</li>
            </ul>
        </div>
        @if (ready && canConsult) {<button type="button" class="btn btn-sm btn-primary" data-ref-new><i class="ki-outline ki-plus fs-4"></i>@T["New referral"]</button>}
    </div></div>

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">
        @if (!ready)
        {
            <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mb-5"><div class="fs-6 text-gray-700 fw-semibold">@T["The referrals table is not created yet (hospital_h203_referrals.sql)."]</div></div>
        }
        <div class="card card-flush mb-5">
            <div class="card-header pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">@T["Referrals"]</span>
                    <span class="text-gray-500 mt-1 fw-semibold fs-7">@T["{0} referrals", total] · @T["Emergency 2 h · urgent 24 h · routine 14 days"]</span>
                </h3>
                <form class="card-toolbar gap-2 flex-wrap" method="get" action="@Url.Action("Referrals")">
                    @if (patient != null) {<input type="hidden" name="patient" value="@patient" />}
                    @if (overdue) {<input type="hidden" name="overdue" value="true" />}
                    <div class="d-flex align-items-center position-relative"><i class="ki-outline ki-magnifier fs-3 position-absolute ms-4"></i><input type="text" name="q" value="@q" class="form-control form-control-solid w-200px ps-12" placeholder="@T["Patient, number, facility"]" /></div>
                    <div class="w-150px"><select name="dept" class="form-select form-select-solid" data-control="select2" data-placeholder="@T["Every department"]" onchange="this.form.submit()"><option value="">@T["Every department"]</option>@foreach (var d in depts) {<option value="@d.Id" selected="@(d.Id == dept)">@DisplayName.Of(d.Name, d.NameEn)</option>}</select></div>
                    <div class="w-125px"><select name="kind" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="@T["All"]" onchange="this.form.submit()"><option value="">@T["All"]</option>@foreach (var k in HospitalReferralKind.All) {<option value="@k" selected="@(k == kind)">@T["refk:" + k]</option>}</select></div>
                    <div class="w-125px"><select name="status" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="@T["All"]" onchange="this.form.submit()"><option value="">@T["All"]</option>@foreach (var s in HospitalReferralStatus.All) {<option value="@s" selected="@(s == status)">@T["refs:" + s]</option>}</select></div>
                    <button type="submit" class="btn btn-sm btn-light-primary">@T["Search"]</button>
                    @if (overdue || patient != null) {<a href="@Url.Action("Referrals")" class="btn btn-sm btn-light">@T["Show all"]</a>}
                </form>
            </div>
            <div class="card-body pt-2">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-10"><i class="ki-outline ki-arrows-loop fs-3x text-gray-300 mb-4 d-block"></i><div class="fs-6 fw-bold text-gray-700">@T["No referral here."]</div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-row-dashed align-top gs-0 gy-4 my-0">
                        <thead><tr class="fw-bold text-muted bg-light">
                            <th class="ps-4 min-w-150px rounded-start">@T["Patient"]</th><th class="min-w-150px">@T["Referred to"]</th><th class="min-w-200px">@T["Question"]</th><th class="min-w-100px">@T["Answer due by"]</th><th class="min-w-100px">@T["Status"]</th><th class="text-end pe-4 rounded-end min-w-100px"></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var r = row.Referral; bool internalRef = r.Kind == HospitalReferralKind.Internal;
                                <tr>
                                    <td class="ps-4"><a href="@Url.Action("Patient", new { id = r.PatientId })" class="text-gray-900 fw-bold text-hover-primary d-block fs-7">@DisplayName.Of(row.Patient, row.PatientEn)</a>
                                        <span class="text-muted fs-8"><bdi class="hp-num text-nowrap" dir="ltr">@row.Mrn</bdi> · <bdi class="hp-num text-nowrap" dir="ltr">@r.ReferralNo</bdi></span>
                                        @if (row.From != null) {<div class="text-muted fs-8">@T["From"] @DisplayName.Of(row.From, row.FromEn)</div>}</td>
                                    <td class="fs-7"><span class="badge badge-light fw-semibold mb-1">@T["refk:" + r.Kind]</span>
                                        @if (internalRef) {<div class="text-gray-800 fw-semibold">@DisplayName.Of(row.ToDepartment ?? "", row.ToDepartmentEn)</div>@if (row.ToDoctor != null) {<div class="text-muted fs-8">@DisplayName.Of(row.ToDoctor, row.ToDoctorEn)</div>}}
                                        else {<div class="text-gray-800 fw-semibold"><bdi>@r.ToFacility</bdi></div>@if (r.ToSpecialty != null) {<div class="text-muted fs-8"><bdi>@r.ToSpecialty</bdi></div>}}</td>
                                    <td class="fs-7"><span class="badge badge-@UrgTone(r.Urgency) fw-semibold mb-1">@T["refu:" + r.Urgency]</span>
                                        <div class="text-gray-800"><bdi>@r.Reason</bdi></div>
                                        @if (r.Summary != null) {<div class="text-muted fs-8 mt-1"><bdi>@r.Summary</bdi></div>}
                                        @if (r.Reply != null) {<div class="notice bg-light-primary rounded border-primary border border-dashed p-3 mt-2 fs-8"><span class="fw-bold text-gray-800 d-block mb-1">@T["Reply"]</span><bdi>@r.Reply</bdi></div>}
                                        @if (r.CloseReason != null) {<div class="notice bg-light-danger rounded border-danger border border-dashed p-3 mt-2 fs-8"><bdi>@r.CloseReason</bdi></div>}</td>
                                    <td class="fs-7 text-nowrap"><span class="hp-num @(row.Overdue ? "text-danger fw-bold" : "text-gray-700")" dir="ltr">@HospitalNursingService.UtcToWard(r.DueAt).ToString("MM-dd HH:mm")</span>@if (row.Overdue) {<div class="text-danger fs-8 fw-bold">@T["Overdue"]</div>}</td>
                                    <td><span class="badge badge-light-@StatusTone(r.Status) fs-7 fw-bold">@T["refs:" + r.Status]</span></td>
                                    <td class="text-end pe-4 text-nowrap">
                                        @* H204: the referral letter is a Report Studio layout of this referral — see _ReportPrintMenu *@
                                        @await Html.PartialAsync("_ReportPrintMenu", new CrossBuy.BL.Reporting.ReportPrintMenuModel { ScreenKey = CrossBuy.BL.Reporting.ReportScreenKeys.HospitalReferral, DocumentId = r.ID.ToString(), DocumentTitle = r.ReferralNo })
                                        @if (canConsult && internalRef && r.Status == HospitalReferralStatus.Sent)
                                        {
                                            <button type="button" class="btn btn-sm btn-icon btn-primary" title="@T["Accept"]" data-bs-toggle="tooltip" data-ref-move="Accepted" data-id="@r.ID"><i class="ki-outline ki-check fs-3"></i></button>
                                            <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger ms-1" title="@T["Decline"]" data-bs-toggle="tooltip" data-ref-move="Declined" data-id="@r.ID"><i class="ki-outline ki-cross-circle fs-3"></i></button>
                                        }
                                        @if (canConsult && ((internalRef && r.Status == HospitalReferralStatus.Accepted) || (!internalRef && r.Status == HospitalReferralStatus.Sent)))
                                        {<button type="button" class="btn btn-sm btn-icon btn-primary ms-1" title="@(internalRef ? T["Reply"] : T["Record the facility's reply"])" data-bs-toggle="tooltip" data-ref-move="Completed" data-internal="@(internalRef ? "1" : "0")" data-id="@r.ID"><i class="ki-outline ki-message-text-2 fs-3"></i></button>}
                                        @if (canConsult && HospitalReferralStatus.Open(r.Status))
                                        {<button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger ms-1" title="@T["Cancel the referral"]" data-bs-toggle="tooltip" data-ref-move="Cancelled" data-id="@r.ID"><i class="ki-outline ki-trash fs-3"></i></button>}
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    @if (pages > 1)
                    {
                        <ul class="pagination pt-6 justify-content-end">
                            <li class="page-item previous @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(page - 1)"><i class="previous"></i></a></li>
                            @for (int p = Math.Max(1, page - 3); p <= Math.Min(pages, page + 3); p++) {<li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>}
                            <li class="page-item next @(page >= pages ? "disabled" : "")"><a class="page-link" href="@Link(page + 1)"><i class="next"></i></a></li>
                        </ul>
                    }
                }
            </div>
        </div>
    </div></div>
</div>

@if (ready && canConsult)
{
    <div class="modal fade" id="refModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered mw-650px"><div class="modal-content rounded">
        <div class="modal-header pb-0 border-0 justify-content-end"><div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-1"></i></div></div>
        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
            <div class="mb-8 text-center"><h1 class="mb-3">@T["New referral"]</h1><div class="text-muted fw-semibold fs-6">@T["What is asked stays as it was sent; the answer comes back on the referral."]</div></div>
            <div class="row g-4">
                <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Patient"]</label><select class="form-select form-select-solid" data-rf="patient" data-placeholder="@T["Name, file number or phone"]"></select></div>
                <div class="col-12"><div class="btn-group w-100" data-rf-kind>
                    @foreach (var k in HospitalReferralKind.All) {<button type="button" class="btn btn-sm @(k == HospitalReferralKind.Internal ? "btn-primary" : "btn-light")" data-kind="@k">@T["refk:" + k]</button>}
                </div></div>
                <div class="col-md-6" data-for="Internal"><label class="fs-6 fw-semibold mb-2 required">@T["Department"]</label>
                    <select class="form-select form-select-solid" data-control="select2" data-dropdown-parent="#refModal" data-placeholder="@T["Choose"]" data-rf="dept"><option></option>@foreach (var d in depts) {<option value="@d.Id">@DisplayName.Of(d.Name, d.NameEn)</option>}</select></div>
                <div class="col-md-6" data-for="Internal"><label class="fs-6 fw-semibold mb-2">@T["Doctor (optional)"]</label>
                    <select class="form-select form-select-solid" data-rf="doctor"><option value="">—</option>@foreach (var d in doctors) {<option value="@d.Id" data-dept="@d.DepartmentId">@DisplayName.Of(d.Name, d.NameEn)</option>}</select></div>
                <div class="col-md-6 d-none" data-for="External"><label class="fs-6 fw-semibold mb-2 required">@T["Facility"]</label><input class="form-control form-control-solid" maxlength="200" data-rf="facility" /></div>
                <div class="col-md-6 d-none" data-for="External"><label class="fs-6 fw-semibold mb-2">@T["Specialty"]</label><input class="form-control form-control-solid" maxlength="100" data-rf="specialty" /></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Urgency"]</label><div class="btn-group w-100" data-rf-urg>
                    @foreach (var u in HospitalReferralUrgency.All) {<button type="button" class="btn btn-sm @(u == HospitalReferralUrgency.Routine ? "btn-primary" : "btn-light")" data-urg="@u">@T["refu:" + u]</button>}
                </div></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2 required">@T["Question"]</label><textarea class="form-control form-control-solid" rows="3" maxlength="1000" data-rf="reason"></textarea></div>
                <div class="col-12"><label class="fs-6 fw-semibold mb-2">@T["Clinical summary"]</label><textarea class="form-control form-control-solid" rows="4" maxlength="2000" data-rf="summary"></textarea></div>
            </div>
            <div class="text-center pt-8"><button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">@T["Cancel"]</button><button type="button" class="btn btn-primary" data-rf-send><i class="ki-outline ki-send fs-4"></i>@T["Send the referral"]</button></div>
        </div>
    </div></div></div>
}

@section Scripts {
    <partial name="_HospitalPrompt" />
    <script>
        (function () {
            var tk = document.querySelector('input[name="__RequestVerificationToken"]'); if (!tk) return;
            var token = tk.value, root = @Json.Serialize(Url.Content("~/Hospital/Referrals"));
            var W = { failed: @Json.Serialize(T["The change could not be saved"].Value), saved: @Json.Serialize(T["Saved"].Value), sent: @Json.Serialize(T["The referral was sent"].Value),
                ask: { Accepted: @Json.Serialize(T["Accept this referral for your department?"].Value), Declined: @Json.Serialize(T["Why is the referral declined?"].Value),
                       Cancelled: @Json.Serialize(T["Why is the referral cancelled?"].Value), reply: @Json.Serialize(T["Your reply to the referring doctor:"].Value), facility: @Json.Serialize(T["What did the facility write back?"].Value) } };
            function post(u, b) { return fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }, body: JSON.stringify(b || {}) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); }); }
            function done(t, msg) { return function (res) { if (t) t.disabled = false; if (!res.ok) { toastr.error(res.error || W.failed); return; } toastr.success(msg || W.saved); setTimeout(function () { location.reload(); }, 500); }; }
            var m = document.getElementById('refModal'), kind = 'Internal', urg = 'Routine';
            if (m && window.jQuery) {
                jQuery(m.querySelector('[data-rf=patient]')).select2({ width: '100%', dropdownParent: jQuery(m), placeholder: m.querySelector('[data-rf=patient]').getAttribute('data-placeholder'),
                    ajax: { url: @Json.Serialize(Url.Content("~/Hospital/Patients/Search")), delay: 250, data: function (p) { return { q: p.term || '' }; }, processResults: function (d) { return { results: (d.results || d || []).map(function (x) { return { id: x.id, text: x.text || x.name }; }) }; } } });
                jQuery(m.querySelector('[data-rf=doctor]')).select2({ width: '100%', dropdownParent: jQuery(m) });
                jQuery(m.querySelector('[data-rf=dept]')).on('select2:select', function () {
                    var dep = this.value, doc = m.querySelector('[data-rf=doctor]');
                    Array.prototype.forEach.call(doc.options, function (o) { if (o.value) o.disabled = o.getAttribute('data-dept') !== dep; });
                    jQuery(doc).val('').trigger('change');
                });
            }
            document.addEventListener('click', function (e) {
                var t = e.target.closest('[data-ref-new],[data-kind],[data-urg],[data-rf-send],[data-ref-move]'); if (!t) return;
                if (t.hasAttribute('data-ref-new')) { bootstrap.Modal.getOrCreateInstance(m).show(); return; }
                if (t.hasAttribute('data-kind') || t.hasAttribute('data-urg')) {
                    var isKind = t.hasAttribute('data-kind'), group = t.parentElement;
                    group.querySelectorAll('button').forEach(function (b) { var on = b === t; b.classList.toggle('btn-primary', on); b.classList.toggle('btn-light', !on); });
                    if (isKind) { kind = t.getAttribute('data-kind'); m.querySelectorAll('[data-for]').forEach(function (d) { d.classList.toggle('d-none', d.getAttribute('data-for') !== kind); }); }
                    else urg = t.getAttribute('data-urg');
                    return;
                }
                if (t.hasAttribute('data-rf-send')) {
                    var v = function (k) { return m.querySelector('[data-rf="' + k + '"]').value; };
                    t.disabled = true;
                    post(root, { patientId: Number(v('patient')) || 0, kind: kind, urgency: urg, toDepartmentId: kind === 'Internal' && v('dept') ? Number(v('dept')) : null,
                        toPractitionerId: kind === 'Internal' && v('doctor') ? Number(v('doctor')) : null, toFacility: v('facility'), toSpecialty: v('specialty'), reason: v('reason'), summary: v('summary') })
                        .then(function (res) { if (res.ok) bootstrap.Modal.getOrCreateInstance(m).hide(); done(t, W.sent)(res); });
                    return;
                }
                var to = t.getAttribute('data-ref-move'), url = root + '/' + t.getAttribute('data-id') + '/Move';
                if (to === 'Accepted') { cbConfirm(W.ask.Accepted).then(function (ok) { if (!ok) return; t.disabled = true; post(url, { to: to }).then(done(t)); }); return; }
                var text = to === 'Completed' ? (t.getAttribute('data-internal') === '1' ? W.ask.reply : W.ask.facility) : W.ask[to];
                cbPrompt(text, { textarea: true, kind: to === 'Completed' ? 'primary' : 'danger' }).then(function (val) { if (val == null) return; t.disabled = true; post(url, { to: to, text: val }).then(done(t)); });
            });
        })();
    </script>
}
