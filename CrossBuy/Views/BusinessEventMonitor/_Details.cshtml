@using CrossBuy.Models.Platform
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model BusinessEventDetailsViewModel
@{
    var h = Model.Header;
    string statusBadge(string? s) => s switch { "Done" => "success", "Failed" => "danger", "Claimed" => "warning", "Pending" => "secondary", _ => "secondary" };
}
@functions {
    // localized display for a coded value via SharedResources (SR); falls back to the raw code when unmapped
    string Disp(string prefix, string? val)
    {
        if (string.IsNullOrEmpty(val)) return "";
        var t = SR[prefix + val];
        return t.IsResourceNotFound ? val! : t.Value;
    }
}
<div class="modal-header py-5 px-9" class="bg-primary">
    <div>
        <h3 class="modal-title fw-bold mb-1 text-white">@Disp("evt_type_", h.EventType)</h3>
        <div class="fs-8" class="font-monospace text-white opacity-75">@h.EventUid.ToString("D")</div>
    </div>
    <button type="button" class="btn btn-icon btn-sm ms-2" data-bs-dismiss="modal"><i class="ki-outline ki-cross fs-2x text-white"></i></button>
</div>
<div class="modal-body py-7 px-9">
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="d-flex flex-stack border-bottom border-dashed py-3 px-3"><span class="text-muted fs-7">@Localizer["Entity"]</span>
                <span class="fw-semibold fs-7">
                    @h.EntityLabel #@h.EntityId
                    @if (!string.IsNullOrEmpty(h.EntityUrl))
                    {
                        <a href="@h.EntityUrl" class="ms-2 btn btn-sm btn-light-primary py-1 px-3 fs-8"><i class="ki-outline ki-eye fs-6 me-1"></i>@Localizer["Open"]</a>
                    }
                </span>
            </div>
            <div class="d-flex flex-stack border-bottom border-dashed py-3 px-3"><span class="text-muted fs-7">@Localizer["Company"] / @Localizer["Branch"]</span>
                <span class="fw-semibold fs-7">@h.CompanyId @(h.BranchId.HasValue ? " / " + h.BranchId : "")</span></div>
            <div class="d-flex flex-stack border-bottom border-dashed py-3 px-3"><span class="text-muted fs-7">@Localizer["Actor"]</span>
                <span class="fw-semibold fs-7">@(h.ActorName ?? Localizer["System"].Value)</span></div>
            <div class="d-flex flex-stack py-3 px-3"><span class="text-muted fs-7">@Localizer["Visibility"]</span>
                <span class="badge badge-light-warning fs-8">@Disp("evt_vis_", h.Visibility)</span></div>
        </div>
        <div class="col-md-6">
            <div class="d-flex flex-stack border-bottom border-dashed py-3 px-3"><span class="text-muted fs-7">@Localizer["Created"]</span>
                <span class="fw-semibold fs-7">@h.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
            <div class="d-flex flex-stack border-bottom border-dashed py-3 px-3"><span class="text-muted fs-7">@Localizer["Event completed (all consumers)"]</span>
                <span class="fw-semibold fs-7">@(h.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</span></div>
            <div class="d-flex flex-stack py-3 px-3"><span class="text-muted fs-7">@Localizer["Payload size"]</span>
                <span class="fw-semibold fs-7">@Model.PayloadBytes @Localizer["bytes"]</span></div>
        </div>
    </div>

    <div class="fw-bold fs-6 mb-2">@Localizer["Consumers"]</div>
    <div class="table-responsive mb-5">
        <table class="table table-row-bordered align-middle gy-3 mb-0">
            <thead><tr class="fw-bold fs-8 text-uppercase text-muted" class="border-bottom border-2 border-primary" style="border-bottom:2px solid #0E4A9E;">
                <th class="ps-2">@Localizer["Consumer"]</th><th>@Localizer["Status"]</th><th class="text-center">@Localizer["Attempts"]</th>
                <th>@Localizer["Updated"]</th><th>@Localizer["Error"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Consumers)
            {
                <tr>
                    <td class="ps-2 fw-semibold fs-7">@Disp("evt_consumer_", c.Consumer)</td>
                    <td>
                        @if (c.DispatchStatus == "Done") { <span class="badge badge-light-primary fw-bold fs-8">@Disp("evt_status_", c.DispatchStatus)</span> }
                        else { <span class="badge badge-light-@statusBadge(c.DispatchStatus) fs-8">@Disp("evt_status_", c.DispatchStatus)</span> }
                    </td>
                    <td class="text-center fw-bold fs-7">@c.Attempts</td>
                    <td class="text-muted fs-8 font-monospace">@(c.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td>
                    <td class="text-danger fs-8 cb-platform-detail-error">@c.ErrorSummary</td>
                    <td class="text-end">
                        @if (c.CanRetry && c.DispatchId.HasValue)
                        {
                            <button type="button" class="btn btn-sm @(c.RetryNeedsOverride ? "btn-light-danger" : "btn-light-warning") py-1 px-2 cb-evt-retry"
                                    data-dispatch-id="@c.DispatchId" data-consumer="@c.Consumer"
                                    data-needs-override="@(c.RetryNeedsOverride ? "1" : "0")">
                                @(c.RetryNeedsOverride ? Localizer["Retry (override)"] : Localizer["Retry"])
                            </button>
                        }
                        else
                        {
                            <span class="text-muted fs-9">@(c.RetryBlockedCode != null ? Disp("evt_block_", c.RetryBlockedCode) : c.RetryBlockedReason)</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="fw-bold fs-6 mb-2">@Localizer["Payload"]</div>
    @if (Model.PayloadMasked)
    {
        @* Opening the monitor does not grant sight of every payload. Restricted/System stay masked. *@
        <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-4 mb-3">
            <i class="ki-outline ki-lock-2 fs-2x text-danger me-3"></i>
            <div class="fw-semibold fs-7">@(Model.PayloadMaskVisibility != null ? Disp("evt_mask_", Model.PayloadMaskVisibility) : Model.PayloadMaskReason)</div>
        </div>
    }
    else if (string.IsNullOrEmpty(Model.Payload))
    {
        <div class="text-muted fs-7 mb-3">@Localizer["This event carries no payload."]</div>
    }
    else
    {
        @if (Model.PayloadTruncated)
        {
            <div class="text-warning fs-8 mb-2"><i class="ki-outline ki-information-2 fs-7"></i> @Localizer["Payload truncated for display."]</div>
        }
        <div class="position-relative">
            <pre class="bg-light-dark rounded p-4 mb-0 cb-platform-payload" id="cbEvtPayload" dir="ltr">@Model.Payload</pre>
            <button type="button" class="btn btn-sm btn-light position-absolute top-0 end-0 m-2 cb-payload-toggle"
                    data-expanded="0">@Localizer["Expand"]</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.FullError))
    {
        <div class="fw-bold fs-6 mt-5 mb-2">@Localizer["Last error (full)"]</div>
        <pre class="bg-light-danger rounded p-4 mb-0 cb-platform-full-error" dir="ltr">@Model.FullError</pre>
    }

    @* ---- THE RESOLUTION RECORD -------------------------------------------------------------------
       How this failure was diagnosed and fixed, who wrote it and when, with the screenshots pasted in
       as evidence. It is a separate record POINTING AT the event — the event row itself is never
       edited, which is the promise the controller's header makes.
       The panel is the platform's, and the endpoints are ours to name: a caller that names neither
       renders disabled rather than posting its notes at another module's permission gate. *@
    <div class="separator my-6"></div>
    @{
        ViewBag.ConversationEntityCode = CrossBuy.BL.Platform.EntityRegistry.PlatformEvent;
        ViewBag.ConversationEntityId   = (int)h.EventId;
        ViewBag.ConversationListUrl    = Url.Action("Notes", "BusinessEventMonitor");
        ViewBag.ConversationAddUrl     = Url.Action("NotesAdd", "BusinessEventMonitor");
        ViewBag.ConversationReactUrl   = null;
    }
    @await Html.PartialAsync("~/Views/Shared/_EntityConversation.cshtml")
</div>
<div class="modal-footer py-4 px-9">
    <a href="#" class="btn btn-sm btn-light cb-copy" data-copy="@h.EventUid.ToString("D")">@Localizer["Copy EventUid"]</a>
    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">@SR["Close"]</button>
</div>
