@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<ApprovalInboxRow>
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    int leaveCount = ViewBag.LeaveCount; int requestCount = ViewBag.RequestCount; int invCount = ViewBag.InventoryCount;
    int billingCount = ViewBag.ProjectBillingCount ?? 0;
    bool isBillingApprover = ViewBag.IsBillingApprover ?? false;
    string billingLabel = ViewBag.ProjectBillingLabel as string ?? "";
    string billingIcon = ViewBag.ProjectBillingIcon as string ?? "ki-document";
    bool isInvMgr = ViewBag.IsInvMgr;
    var total = Model.Count;
}
@functions {
    // THE SAME PALETTE AND THE SAME HASH AS _DocEventTimeline, restated rather than referenced because
    // that one lives in JavaScript and this column is rendered on the server. The values are copied
    // deliberately and must stay in step: each ink measured >= 4.5 on white, and none sits in the hue
    // band crossbuy-brand.css reserves for semantic success - a person must never read as a status.
    public static class ApprovalAvatar
    {
        private static readonly string[] Inks =
            { "#0E4A9E", "#3730A3", "#155E75", "#5B21B6", "#334155", "#7E22CE", "#0F766E", "#9D174D" };

        // Hashing the NAME, not the row index: the same person keeps the same colour everywhere they
        // appear, which is the whole point - a colour that changed per page would be decoration.
        private static int Index(string? name)
        {
            unchecked
            {
                uint h = 0;
                foreach (var c in name ?? "") { h = h * 31 + c; }
                return (int)(h % (uint)Inks.Length);
            }
        }

        public static string Ink(string? name) => Inks[Index(name)];

        // The tile is the ink at 12% so the letters keep their contrast against it.
        public static string Tint(string? name) => Ink(name) + "1F";

        public static string Initials(string? name)
        {
            var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0) return "?";
            var first = parts[0][0];
            var last = parts.Length > 1 ? parts[^1][0] : '\0';
            return last == '\0' ? char.ToUpperInvariant(first).ToString()
                                : $"{char.ToUpperInvariant(first)}{char.ToUpperInvariant(last)}";
        }
    }
}
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["My approvals"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@Localizer["Home"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Communications"]</li>
            </ul>
        </div>
        <span class="badge badge-light-danger fs-6 fw-bold">@total @Localizer["pending"]</span>
    </div></div>
    <!--end::Toolbar-->

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Summary tiles-->
        <div class="row g-5 g-xl-8 mb-5 mb-xl-8">
            @{
                @* A SILO IS A CATEGORY, NOT A STATE. These three rotated primary / info / warning, so
                   "Inventory" was painted in the caution colour - and Inventory showing ZERO is the
                   BEST case on this screen, not a warning about anything. The rotation also said
                   nothing the tiles do not already say in words: each one is labelled underneath.

                   One tint for all three. The number carries the information; the colour is chrome. *@
                var tiles = new List<(string label, int count, string icon)> {
                    (Localizer["Leave"].Value, leaveCount, "ki-calendar-tick"),
                    (Localizer["Employee requests"].Value, requestCount, "ki-file-added"),
                    (Localizer["Inventory"].Value, invCount, "ki-check-square"),
                };

                @* Project billing joins the strip only for someone who can actually act on one — its
                   entitlement is per project, so a permanent zero would tell a non-approver nothing.
                   Label and icon come from the entity registry via the controller, so this screen holds
                   no second copy of "مستخلص" / "Progress billing". *@
                if (isBillingApprover || billingCount > 0)
                {
                    tiles.Add((billingLabel, billingCount, billingIcon));
                }

                @* Four tiles share a row at xl; three keep the original thirds. *@
                var tileCol = tiles.Count >= 4 ? "col-6 col-xl-3" : "col-6 col-xl-4";
            }
            @foreach (var t in tiles)
            {
                <div class="@tileCol">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center p-5">
                            <span class="symbol symbol-50px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline @t.icon fs-2x text-primary"></i></span></span>
                            <div>
                                <div class="fs-2x fw-bold text-gray-900 lh-1" data-kt-countup="true" data-kt-countup-value="@t.count">@t.count</div>
                                <div class="fs-7 text-muted fw-semibold mt-1">@t.label</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!--end::Summary tiles-->

        <div class="card card-flush">
            <div class="card-header pt-6"><h3 class="card-title fw-bold text-gray-900">@Localizer["Pending on me"]</h3></div>
            <div class="card-body pt-2">
                @if (total == 0)
                {
                    <div class="text-center text-muted py-15"><i class="ki-outline ki-check-circle fs-3x text-success mb-3 d-block"></i>@Localizer["Nothing awaiting your approval."]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-row-dashed align-middle fs-6 gy-4 my-0">
                            <thead>
                                <tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                                    <th>@SR["Type"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Requester"]</th>
                                    <th>@Localizer["Details"]</th><th>@SR["Date"]</th><th class="text-end">@SR["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td><span class="badge badge-light-@r.Color"><i class="ki-outline @r.Icon fs-7 me-1"></i>@r.SiloLabel</span></td>
                                        <td class="fw-bold text-gray-900">@r.Title</td>
                                        @* THE REQUESTER, SHOWN AS A PERSON. The column named nine people and
                                           drew none of them. Same treatment as the conversation panel and the
                                           activity timeline: the photograph when there is one, initials on that
                                           person's own colour when there is not - never one grey silhouette for
                                           everybody, which is what makes a list of people read as a list of rows. *@
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="symbol symbol-35px me-3">
                                                    @if (!string.IsNullOrWhiteSpace(r.RequesterPhoto))
                                                    {
                                                        @* onerror: a stored path whose FILE is gone must not leave a
                                                           broken-image glyph where a face belongs. *@
                                                        <img src="@Url.Content("~" + r.RequesterPhoto)" alt="@r.Requester"
                                                             style="width:35px;height:35px;object-fit:cover;border-radius:50%;display:block;"
                                                             onerror="cbAvatarFallback(this)" />
                                                    }
                                                    else
                                                    {
                                                        <span class="symbol-label fw-bold fs-8"
                                                              style="background:@ApprovalAvatar.Tint(r.Requester);color:@ApprovalAvatar.Ink(r.Requester);">@ApprovalAvatar.Initials(r.Requester)</span>
                                                    }
                                                </div>
                                                <span class="text-gray-700 fw-semibold">@(r.Requester ?? "—")</span>
                                            </div>
                                        </td>
                                        <td class="text-muted fw-semibold">@(r.Meta ?? "—")</td>
                                        <td class="text-muted fw-semibold">@(r.Date?.ToString("yyyy-MM-dd") ?? "—")</td>
                                        <td class="text-end"><a href="@r.Url" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-eye fs-5"></i>@Localizer["Review"]</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (!isInvMgr)
                {
                    <div class="text-muted fs-8 mt-4"><i class="ki-outline ki-information-5 fs-7 me-1"></i>@Localizer["Inventory approvals appear here only for Inventory Managers."]</div>
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
<script>
(function () {
    var Ctor = (window.countUp && window.countUp.CountUp) ? window.countUp.CountUp : (window.CountUp || null);
    if (!Ctor) return;
    document.querySelectorAll('#kt_app_content [data-kt-countup="true"]').forEach(function (el) {
        if (el.getAttribute('data-kt-initialized') === '1') return;
        var val = parseFloat(el.getAttribute('data-kt-countup-value')) || 0;
        var c = new Ctor(el, val, { duration: 1.2 });
        if (!c.error) { c.start(); el.setAttribute('data-kt-initialized', '1'); }
    });
})();

// A stored photo path whose FILE is gone would otherwise leave the browser's torn-page glyph exactly
// where a face belongs. Swap it for the neutral silhouette the rest of the product already ships.
function cbAvatarFallback(img) {
    img.onerror = null;
    img.src = '/Backend-assets/media/svg/avatars/blank.svg';
}
</script>
}