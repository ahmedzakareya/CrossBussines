@using CrossBuy.BL
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<CrossBuy.SharedResources> SR
@model List<ApprovalInboxRow>
@{
    Layout = "~/Views/Shared/_LayoutBackend.cshtml";
    int leaveCount = ViewBag.LeaveCount; int requestCount = ViewBag.RequestCount; int invCount = ViewBag.InventoryCount;
    bool isInvMgr = ViewBag.IsInvMgr;
    var total = Model.Count;
}
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2"><div class="app-container container-fluid d-flex flex-stack flex-wrap gap-3">
        <div class="page-title d-flex flex-column justify-content-center gap-1">
            <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">@Localizer["My approvals"]</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                <li class="breadcrumb-item text-muted">@Localizer["Home"]</li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted">@Localizer["Communications"]</li>
            </ul>
        </div>
        <span class="badge badge-light-danger fs-6 fw-bold">@total @Localizer["pending"]</span>
    </div></div>
    <!--end::Toolbar-->

    <div id="kt_app_content" class="app-content flex-column-fluid"><div class="app-container container-fluid">

        <!--begin::Summary tiles-->
        <div class="row g-5 g-xl-8 mb-5 mb-xl-8">
            @{
                @* A SILO IS A CATEGORY, NOT A STATE. These three rotated primary / info / warning, so
                   "Inventory" was painted in the caution colour - and Inventory showing ZERO is the
                   BEST case on this screen, not a warning about anything. The rotation also said
                   nothing the tiles do not already say in words: each one is labelled underneath.

                   One tint for all three. The number carries the information; the colour is chrome. *@
                var tiles = new (string label, int count, string icon)[] {
                    (Localizer["Leave"].Value, leaveCount, "ki-calendar-tick"),
                    (Localizer["Employee requests"].Value, requestCount, "ki-file-added"),
                    (Localizer["Inventory"].Value, invCount, "ki-check-square"),
                };
            }
            @foreach (var t in tiles)
            {
                <div class="col-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center p-5">
                            <span class="symbol symbol-50px me-4"><span class="symbol-label bg-light-primary"><i class="ki-outline @t.icon fs-2x text-primary"></i></span></span>
                            <div>
                                <div class="fs-2x fw-bold text-gray-900 lh-1" data-kt-countup="true" data-kt-countup-value="@t.count">@t.count</div>
                                <div class="fs-7 text-muted fw-semibold mt-1">@t.label</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!--end::Summary tiles-->

        <div class="card card-flush">
            <div class="card-header pt-6"><h3 class="card-title fw-bold text-gray-900">@Localizer["Pending on me"]</h3></div>
            <div class="card-body pt-2">
                @if (total == 0)
                {
                    <div class="text-center text-muted py-15"><i class="ki-outline ki-check-circle fs-3x text-success mb-3 d-block"></i>@Localizer["Nothing awaiting your approval."]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-row-dashed align-middle fs-6 gy-4 my-0">
                            <thead>
                                <tr class="text-start text-muted fw-bold fs-8 text-uppercase gs-0" style="border-bottom:2px solid #0E4A9E;">
                                    <th>@SR["Type"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Requester"]</th>
                                    <th>@Localizer["Details"]</th><th>@SR["Date"]</th><th class="text-end">@SR["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td><span class="badge badge-light-@r.Color"><i class="ki-outline @r.Icon fs-7 me-1"></i>@r.SiloLabel</span></td>
                                        <td class="fw-bold text-gray-900">@r.Title</td>
                                        <td class="text-gray-700 fw-semibold">@(r.Requester ?? "—")</td>
                                        <td class="text-muted fw-semibold">@(r.Meta ?? "—")</td>
                                        <td class="text-muted fw-semibold">@(r.Date?.ToString("yyyy-MM-dd") ?? "—")</td>
                                        <td class="text-end"><a href="@r.Url" class="btn btn-sm btn-light-primary"><i class="ki-outline ki-eye fs-5"></i>@Localizer["Review"]</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (!isInvMgr)
                {
                    <div class="text-muted fs-8 mt-4"><i class="ki-outline ki-information-5 fs-7 me-1"></i>@Localizer["Inventory approvals appear here only for Inventory Managers."]</div>
                }
            </div>
        </div>
    </div></div>
</div>

@section Scripts {
<script>
(function () {
    var Ctor = (window.countUp && window.countUp.CountUp) ? window.countUp.CountUp : (window.CountUp || null);
    if (!Ctor) return;
    document.querySelectorAll('#kt_app_content [data-kt-countup="true"]').forEach(function (el) {
        if (el.getAttribute('data-kt-initialized') === '1') return;
        var val = parseFloat(el.getAttribute('data-kt-countup-value')) || 0;
        var c = new Ctor(el, val, { duration: 1.2 });
        if (!c.error) { c.start(); el.setAttribute('data-kt-initialized', '1'); }
    });
})();
</script>
}