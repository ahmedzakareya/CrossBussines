    },
    "financial": {
      "900": { "$type": "color", "$value": "#13433A" },
      "700": { "$type": "color", "$value": "#1F6253" },
      "100": { "$type": "color", "$value": "#E9F1EE" },
      "gold": { "$type": "color", "$value": "#D4A017" }
