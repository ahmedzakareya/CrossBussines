    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "color": "#0B1F3D0F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
    "md": { "$type": "shadow", "$value": [
      { "color": "#0B1F3D0F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      { "color": "#0B1F3D0F", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" }
    ] },
    "lg": { "$type": "shadow", "$value": { "color": "#0B1F3D24", "offsetX": "0px", "offsetY": "8px", "blur": "32px", "spread": "0px" } }
  },
  "font": {
    "family": {
      "arabic": { "$type": "fontFamily", "$value": ["Cairo", "system-ui", "sans-serif"] },
      "latin": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "12px" },
      "compact": { "$type": "dimension", "$value": "13px" },
