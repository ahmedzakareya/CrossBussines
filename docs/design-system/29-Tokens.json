      "warningSoft": { "$type": "color", "$value": "#FEF3E2" },
      "danger": { "$type": "color", "$value": "#C22A4D" },
      "dangerSoft": { "$type": "color", "$value": "#FDEBED" },
      "info": { "$type": "color", "$value": "{color.brand.600}" },
      "infoSoft": { "$type": "color", "$value": "{color.brand.50}" }
    },
    "light": {
      "text": { "$type": "color", "$value": "#131A26" },
      "textSecondary": { "$type": "color", "$value": "#566173" },
      "textTertiary": { "$type": "color", "$value": "#8A94A6" },
      "border": { "$type": "color", "$value": "#DFE4EC" },
      "borderSoft": { "$type": "color", "$value": "#EEF1F6" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "canvas": { "$type": "color", "$value": "#F5F7FB" }
