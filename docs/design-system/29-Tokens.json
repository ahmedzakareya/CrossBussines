      "borderSoft": { "$type": "color", "$value": "#1A2338" },
      "surface": { "$type": "color", "$value": "#151F33" },
      "canvas": { "$type": "color", "$value": "#0D1523" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
