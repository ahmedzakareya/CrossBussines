      "section": { "$type": "dimension", "$value": "18px" },
      "page": { "$type": "dimension", "$value": "24px" },
      "display": { "$type": "dimension", "$value": "32px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "80ms" },
      "fast": { "$type": "duration", "$value": "120ms" },
      "medium": { "$type": "duration", "$value": "180ms" },
      "slow": { "$type": "duration", "$value": "240ms" }
    },
    "easing": { "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] } }
  },
  "control": {
    "heightCompact": { "$type": "dimension", "$value": "36px" },
    "heightStandard": { "$type": "dimension", "$value": "40px" },
    "heightTouch": { "$type": "dimension", "$value": "44px" }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "576px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "992px" },
    "xl": { "$type": "dimension", "$value": "1200px" },
    "xxl": { "$type": "dimension", "$value": "1400px" }
  }
